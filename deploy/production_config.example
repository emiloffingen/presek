# Presek Production Configuration Example
# Copy this to /etc/presek/environment and customize

# ============================================================================
# Core Configuration
# ============================================================================
ENV=production
LOG_LEVEL=INFO
APP_VERSION=5.0.0

# ============================================================================
# Security
# ============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secure_secret_key_here_minimum_32_chars

# Generate with: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_chars

# Generate with: openssl rand -hex 32
CSRF_TOKEN_SECRET=your_secure_csrf_secret_here_minimum_32_chars

# JWT token expiration in minutes
JWT_EXPIRE_MINUTES=60

# Keep false unless you need a short emergency static-token maintenance window.
ALLOW_STATIC_ADMIN_TOKEN=false

# ============================================================================
# Database
# ============================================================================
# Primary database
DATABASE_URL=postgresql://presek:your_db_password@localhost/presek

# Read replica (optional)
DATABASE_READ_REPLICA_URL=postgresql://presek:your_db_password@replica-host/presek
USE_READ_REPLICA=true

# Split Python venvs (optional — see deploy/setup_split_venvs.sh)
# PRESEK_API_VENV=/home/emiloffingen/presek-runtime/venv-api
# PRESEK_WORKER_VENV=/home/emiloffingen/presek-runtime/venv-worker

# FastAPI process count (uvicorn prefork). Use 2+ with the slim API venv.
UVICORN_WORKERS=2

# Connection pool settings
DB_POOL_MINCONN=2
DB_POOL_MAXCONN=5
DB_POOL_TIMEOUT=60
DB_POOL_MAX_LIFETIME=1800

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://:your_redis_password@localhost:6379/0

# ============================================================================
# Performance
# ============================================================================
# Enable GPU acceleration for embeddings (requires CUDA)
ENABLE_GPU_ACCELERATION=false

# Offsite backup sync via rclone (optional — see deploy/sync_backups_offsite.sh)
# BACKUP_OFFSITE_RCLONE_TARGET=r2:presek-backups/presek

# Local translation settings
LOCAL_TRANSLATION_ENABLED=true
ENABLE_EXPENSIVE_STYLE_TASKS=false

# ============================================================================
# AI Providers
# ============================================================================
# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# ============================================================================
# Monitoring & Error Tracking
# ============================================================================
# Sentry DSN for error tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456

# ============================================================================
# Web & URLs
# ============================================================================
PUBLIC_SITE_URL=https://presek.live
CORS_ORIGINS=https://presek.live,https://www.presek.live

# TinyAdz configurations have been removed from this project.

# Post-deploy smoke checks against public URLs (recommended in production).
ENABLE_PUBLIC_CHECK=1
ENABLE_MK_PUBLIC_CHECK=1
ENABLE_PUBLIC_SECURITY_HEADER_CHECK=1

# Optional: gate /admin HTML shell behind a shared secret (query ?token= or X-Admin-Page-Token header).
# ADMIN_PAGE_TOKEN=

# Shared static uploads path (defaults to /home/emiloffingen/presek-runtime/shared/static).
# STATIC_ROOT=/home/emiloffingen/presek-runtime/shared/static

# Reader sync token max age in days (default 365).
# SYNC_TOKEN_MAX_AGE_DAYS=365

# Cloudflare API (optional — DNS automation). Replace placeholder; rotate if leaked.
# CLOUDFLARE_API_TOKEN=

# ============================================================================
# Notifications
# ============================================================================
NTFY_TOPIC=presek-prod-alerts
NTFY_TOKEN=your_ntfy_token_here

# ============================================================================
# Web Push
# ============================================================================

# ============================================================================
# Email (SMTP)
# ============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="Presek <noreply@presek.live>"

# ============================================================================
# Clustering & Processing
# ============================================================================
CLUSTERING_THRESHOLDS={
    "SIMILARITY_THRESHOLD": 0.45,
    "VECTOR_THRESHOLD": 0.28,
    "MAX_CLUSTER_SIZE": 35
}

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================================
# Audio
# ============================================================================
# auto = Serbian and Macedonian use Edge neural TTS.
AUDIO_TTS_ENGINE=auto
AUDIO_TTS_ENGINE_SR=edge
AUDIO_TTS_ENGINE_MK=edge
OMNIVOICE_NUM_STEP=8
AUDIO_PRIORITY_GENERATION_LIMIT=2

# ============================================================================
# Maintenance
# ============================================================================
DB_RETAIN_DAYS=180
DB_RETAIN_FAILED_TASKS_DAYS=360

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_USER_PROFILES=true
ENABLE_NEWSLETTERS=true
