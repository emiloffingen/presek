# Presek production crontab
# Install with: crontab deploy/crontab
# Or merge entries into the server user's crontab with: crontab -e
#
# Default paths: APP_ROOT=/home/emiloffingen/presek-runtime, DEPLOY_GIT_DIR=/home/emiloffingen/presek

# ============================================================================
# PostgreSQL Backups
# ============================================================================
# Daily backup at 2:00 AM
0 2 * * * APP_ROOT=/home/emiloffingen/presek-runtime REQUIRE_BACKUP_ENCRYPTION=1 /bin/bash /home/emiloffingen/presek/deploy/backup_postgres.sh >> /home/emiloffingen/presek-runtime/shared/logs/backup.log 2>&1

# Offsite backup sync 30 minutes after local backup (no-op until BACKUP_OFFSITE_RCLONE_TARGET is set)
30 2 * * * APP_ROOT=/home/emiloffingen/presek-runtime /bin/bash /home/emiloffingen/presek/deploy/sync_backups_offsite.sh >> /home/emiloffingen/presek-runtime/shared/logs/backup_sync.log 2>&1

# Monthly backup integrity check (first Sunday, 3:30 AM)
30 3 1-7 * 0 APP_ROOT=/home/emiloffingen/presek-runtime /bin/bash /home/emiloffingen/presek/deploy/verify_backup.sh >> /home/emiloffingen/presek-runtime/shared/logs/backup_verify.log 2>&1 || APP_ROOT=/home/emiloffingen/presek-runtime /bin/bash -c 'curl -s -d "Backup verification failed at $(date)" https://ntfy.sh/presek-ops 2>/dev/null || true'

# ============================================================================
# Log Rotation
# ============================================================================
# Rotate backup logs weekly
0 3 * * 0 find /home/emiloffingen/presek-runtime/shared/logs/backup*.log -mtime +30 -delete

# Vacuum system journals daily to prevent disk space exhaustion (keep 3 days)
0 4 * * * sudo journalctl --vacuum-time=3d >> /home/emiloffingen/presek-runtime/shared/logs/cron_vacuum.log 2>&1

# ============================================================================
# Database Maintenance
# ============================================================================
# Weekly PostgreSQL optimization
0 5 * * 0 /usr/bin/psql -d presek -c "VACUUM ANALYZE;" >> /home/emiloffingen/presek-runtime/shared/logs/cron_optimize.log 2>&1

# ============================================================================
# Health Checks
# ============================================================================
# Daily health check at 3:00 AM (FastAPI unified service)
0 3 * * * curl -sSf http://127.0.0.1:5001/api/health || echo "Health check failed at $(date)" >> /home/emiloffingen/presek-runtime/shared/logs/health_check.log 2>&1

# ============================================================================
# Release Retention
# ============================================================================
# Weekly release pruning dry-run (review log before enabling destructive prune)
0 6 * * 0 APP_ROOT=/home/emiloffingen/presek-runtime KEEP_EXTRA=2 DRY_RUN=1 /bin/bash /home/emiloffingen/presek/deploy/prune_releases.sh >> /home/emiloffingen/presek-runtime/shared/logs/prune_releases.log 2>&1

# Monthly release pruning (sudo fallback handles legacy root-owned web/dist artifacts)
0 7 1 * * APP_ROOT=/home/emiloffingen/presek-runtime KEEP_EXTRA=2 DRY_RUN=0 /bin/bash /home/emiloffingen/presek/deploy/prune_releases.sh >> /home/emiloffingen/presek-runtime/shared/logs/prune_releases.log 2>&1

# ============================================================================
# Synthesis Quality Monitoring
# ============================================================================
# Hourly synthesis quality snapshot (Redis + log)
0 * * * * cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && /home/emiloffingen/presek-runtime/venv/bin/python3 scripts/monitor_synthesis_quality.py --write-redis --notify >> /home/emiloffingen/presek-runtime/shared/logs/synthesis_quality.log 2>&1

# Synthesis + queue alert pass every 15 minutes (ntfy when configured)
*/15 * * * * cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && /home/emiloffingen/presek-runtime/venv/bin/python3 scripts/monitor_synthesis_quality.py --write-redis --notify >> /home/emiloffingen/presek-runtime/shared/logs/synthesis_quality.log 2>&1

# Editorial ops cockpit alerts (ntfy when configured)
*/15 * * * * cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && /home/emiloffingen/presek-runtime/venv/bin/python3 scripts/monitor_ops_snapshot.py --write-redis --notify >> /home/emiloffingen/presek-runtime/shared/logs/ops_snapshot.log 2>&1

# Weekly ops quality report (Mondays 06:15 UTC)
15 6 * * 1 cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && APP_ROOT=/home/emiloffingen/presek-runtime /home/emiloffingen/presek-runtime/venv/bin/python3 scripts/weekly_ops_report.py >> /home/emiloffingen/presek-runtime/shared/logs/ops_snapshot.log 2>&1
