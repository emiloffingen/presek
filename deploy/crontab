# Presek Backup Crontab
# Install with: crontab /path/to/this/file
# Or add to root crontab with: crontab -e

# ============================================================================
# PostgreSQL Backups
# ============================================================================
# Daily backup at 2:00 AM
0 2 * * * /bin/bash /home/emiloffingen/presek/deploy/backup_postgres.sh >> /home/emiloffingen/presek/logs/backup.log 2>&1

# ============================================================================
# Log Rotation
# ============================================================================
# Rotate backup logs weekly
0 3 * * 0 find /home/emiloffingen/presek/logs/backup*.log -mtime +30 -delete

# Vacuum system journals daily to prevent disk space exhaustion (keep 3 days)
0 4 * * * sudo journalctl --vacuum-time=3d >> /home/emiloffingen/presek/logs/cron_vacuum.log 2>&1

# ============================================================================
# Database Maintenance
# ============================================================================
# Weekly PostgreSQL optimization
0 5 * * 0 /usr/bin/psql -d presek -c "VACUUM ANALYZE;" >> /home/emiloffingen/presek/logs/cron_optimize.log 2>&1

# ============================================================================
# Health Checks
# ============================================================================
# Daily health check at 3:00 AM
0 3 * * * curl -sSf http://localhost:8000/api/health || echo "Health check failed at $(date)" >> /home/emiloffingen/presek/logs/health_check.log 2>&1

