[Unit]
Description=Presek Flask web service
After=network-online.target
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek
ExecStartPre=/bin/bash -lc 'cd /home/emiloffingen/presek && set -a && source ./.env && set +a && /home/emiloffingen/presek/venv/bin/python3 -c "from config import validate_required_env; from database import init_db; validate_required_env(); init_db()"'
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek && set -a && source ./.env && set +a && exec /home/emiloffingen/presek/venv/bin/gunicorn app:app --bind 127.0.0.1:5000 --workers 2 --threads 4 --worker-class gthread --timeout 60 --keep-alive 5 --access-logfile - --error-logfile - --log-level info'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-web

[Install]
WantedBy=presek.target
