[Unit]
Description=Presek MK Frontend
After=network.target

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek-runtime/current/web-mk
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
Environment=PORT=3001
Environment=HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
