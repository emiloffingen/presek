[Unit]
Description=Presek Celery worker
After=network-online.target presek-web.service
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek && set -a && source ./.env && set +a && exec /home/emiloffingen/presek/venv/bin/celery -A celery_app worker --loglevel=info --concurrency=4'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-worker

[Install]
WantedBy=presek.target
