[Unit]
Description=Presek Celery worker
After=network-online.target presek-fastapi.service
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
Environment=PYTHONPATH=/home/emiloffingen/presek
WorkingDirectory=/home/emiloffingen/presek
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek && set -a && source ./.env && set +a && exec /home/emiloffingen/presek/venv/bin/celery -A celery_app worker --loglevel=info --concurrency=2'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-worker
MemoryHigh=768M
MemoryMax=1G
CPUWeight=100

[Install]
WantedBy=presek.target
