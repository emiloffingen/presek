[Unit]
Description=Presek Celery worker (delivery)
After=network-online.target presek-fastapi.service postgresql.service redis.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
Environment=PYTHONPATH=/home/emiloffingen/presek-runtime/current
Environment=HF_HOME=/home/emiloffingen/presek-runtime/shared/huggingface
Environment=HF_HUB_CACHE=/home/emiloffingen/presek-runtime/shared/huggingface/hub
Environment=SENTENCE_TRANSFORMERS_HOME=/home/emiloffingen/presek-runtime/shared/huggingface/sentence_transformers
WorkingDirectory=/home/emiloffingen/presek-runtime/current
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && exec /home/emiloffingen/presek-runtime/venv/bin/celery -A celery_app worker --loglevel=info -n delivery@%%h --concurrency=1 --queues=delivery --max-memory-per-child=250000'
Restart=always
RestartSec=5
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-worker-delivery
Nice=5
CPUWeight=40
MemoryHigh=1400M
MemoryMax=1800M
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/emiloffingen/presek-runtime/shared/logs /home/emiloffingen/presek-runtime/shared/backups /home/emiloffingen/presek-runtime/shared/static/generated /home/emiloffingen/presek-runtime/shared/static/uploads /home/emiloffingen/presek-runtime/shared/huggingface

[Install]
WantedBy=presek.target
