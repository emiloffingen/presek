[Unit]
Description=Presek Celery beat scheduler
After=network-online.target presek-worker.service postgresql.service redis.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
Environment=PYTHONPATH=/home/emiloffingen/presek-runtime/current
Environment=HF_HOME=/home/emiloffingen/presek-runtime/shared/huggingface
Environment=HF_HUB_CACHE=/home/emiloffingen/presek-runtime/shared/huggingface/hub
Environment=SENTENCE_TRANSFORMERS_HOME=/home/emiloffingen/presek-runtime/shared/huggingface/sentence_transformers
WorkingDirectory=/home/emiloffingen/presek-runtime/current
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && exec "${PRESEK_WORKER_VENV:-${PRESEK_VENV:-/home/emiloffingen/presek-runtime/venv}}/bin/celery" -A core.celery_app beat --loglevel=info --schedule /home/emiloffingen/presek-runtime/shared/celerybeat-schedule'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-beat
MemoryHigh=256M
MemoryMax=384M
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/emiloffingen/presek-runtime/shared

[Install]
WantedBy=presek.target
