[Unit]
Description=Presek Celery beat scheduler
After=network-online.target presek-worker.service
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
Environment=PYTHONPATH=/home/emiloffingen/presek
WorkingDirectory=/home/emiloffingen/presek
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek && set -a && source ./.env && set +a && exec /home/emiloffingen/presek/venv/bin/celery -A celery_app beat --loglevel=info'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-beat

[Install]
WantedBy=presek.target
