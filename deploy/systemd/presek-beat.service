[Unit]
Description=Presek Celery beat scheduler
After=network-online.target presek-worker.service
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
Environment=PYTHONPATH=/home/emiloffingen/presek/current
WorkingDirectory=/home/emiloffingen/presek/current
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek/current && set -a && source /home/emiloffingen/presek/shared/.env && set +a && exec /home/emiloffingen/presek/venv/bin/celery -A celery_app beat --loglevel=info --schedule /home/emiloffingen/presek/shared/celerybeat-schedule'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-beat
MemoryHigh=256M
MemoryMax=384M
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/emiloffingen/presek/shared

[Install]
WantedBy=presek.target
