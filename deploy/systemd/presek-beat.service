[Unit]
Description=Presek periodic task scheduler
After=network-online.target redis.service postgresql.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek-runtime/current
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && exec /home/emiloffingen/presek-runtime/venv/bin/python -m celery -A core.celery_app beat --loglevel=info'
Restart=always
RestartSec=10
MemoryHigh=256M
MemoryMax=384M
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/emiloffingen/presek-runtime/shared/logs /home/emiloffingen/presek-runtime/shared/backups

[Install]
WantedBy=presek.target
