[Unit]
Description=Presek Astro frontend
After=network-online.target presek-fastapi.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek-runtime/current/web
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStartPre=/bin/bash -lc "cd .. && APP_ROOT=. WEB_DIR=./web bash deploy/ensure_astro_build.sh"
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current/web && exec node ./dist/server/entry.mjs'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-astro
MemoryHigh=768M
MemoryMax=1G
CPUWeight=200
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/home/emiloffingen/presek-runtime/shared/logs

[Install]
WantedBy=presek.target
