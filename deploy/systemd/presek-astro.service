[Unit]
Description=Presek Astro frontend
After=network-online.target presek-fastapi-unified.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek-runtime/current/web
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStartPre=/bin/bash -lc 'test -f ./dist/server/entry.mjs'
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current/web && set -a && source /home/emiloffingen/presek/.env && set +a && exec node ./dist/server/entry.mjs'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-astro
MemoryHigh=768M
MemoryMax=1G
CPUWeight=200
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/home/emiloffingen/presek-runtime/shared/logs

[Install]
WantedBy=presek.target
