[Unit]
Description=Presek Astro frontend
After=network-online.target
Wants=network-online.target
PartOf=presek.target

[Service]
Type=simple
User=emiloffingen
WorkingDirectory=/home/emiloffingen/presek/current/web
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStartPre=/bin/bash -lc 'cd /home/emiloffingen/presek/current && APP_ROOT=/home/emiloffingen/presek/current WEB_DIR=/home/emiloffingen/presek/current/web bash deploy/ensure_astro_build.sh'
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek/current/web && exec node ./dist/server/entry.mjs'
Restart=always
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-astro
MemoryHigh=768M
MemoryMax=1G
CPUWeight=100

[Install]
WantedBy=presek.target
