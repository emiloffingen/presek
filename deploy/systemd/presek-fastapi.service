[Unit]
Description=Presek FastAPI service
After=network-online.target postgresql.service redis.service
Wants=network-online.target
PartOf=presek.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=emiloffingen
Environment=HF_HOME=/home/emiloffingen/presek-runtime/shared/huggingface
Environment=HF_HUB_CACHE=/home/emiloffingen/presek-runtime/shared/huggingface/hub
Environment=SENTENCE_TRANSFORMERS_HOME=/home/emiloffingen/presek-runtime/shared/huggingface/sentence_transformers
WorkingDirectory=/home/emiloffingen/presek-runtime/current
ExecStart=/bin/bash -lc 'cd /home/emiloffingen/presek-runtime/current && set -a && source /home/emiloffingen/presek-runtime/shared/.env && set +a && exec /home/emiloffingen/presek-runtime/venv/bin/uvicorn core.api_fast:app --host 127.0.0.1 --port 5001 --workers 1'
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=presek-fastapi
MemoryHigh=1600M
MemoryMax=2000M
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/emiloffingen/presek-runtime/shared/logs /home/emiloffingen/presek-runtime/shared/static/generated /home/emiloffingen/presek-runtime/shared/static/uploads /home/emiloffingen/presek-runtime/shared/huggingface

[Install]
WantedBy=presek.target
