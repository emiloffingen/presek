# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Notification
NTFY_TOPIC=presek-mk-vesti

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_KV_NAMESPACE_ID=your_namespace_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id

# Cloudflare R2 (S3-compatible)
R2_BUCKET_NAME=presek-cache
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key

# AI Provider Keys
GROQ_API_KEY=your_groq_key
CEREBRAS_API_KEY=your_cerebras_key
MISTRAL_API_KEY=your_mistral_key
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_API_KEY=your_openai_key

# Database
DATABASE_URL=postgresql://user:password@localhost/presek
REDIS_URL=redis://localhost:6379/0

# Email (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password
EMAIL_FROM=Пресек <briefing@presek.live>

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/account_id/default
POLLINATIONS_API_KEY=your_pollinations_key

# Security
SECRET_KEY=your_secret_key_here
