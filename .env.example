# Presek Configuration - Example File
# Copy this to .env and fill in your actual values.
# Never commit a real .env file.

# ============================================================================
# APPLICATION
# ============================================================================
ENV=production
LOG_LEVEL=INFO
SECRET_KEY=generate_a_long_random_string_here_minimum_32_chars
JWT_SECRET=generate_a_secure_jwt_secret_here_minimum_32_chars
CSRF_TOKEN_SECRET=generate_a_secure_csrf_secret_here_minimum_32_chars
JWT_EXPIRE_MINUTES=60
PRESEK_ADMIN_TOKEN=your_secure_admin_token_here
# Static admin tokens are disabled by default in production unless this is true.
ALLOW_STATIC_ADMIN_TOKEN=false
PUBLIC_SITE_URL=https://presek.mk

# Stripe is required for public advertising checkout.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false
MOCK_PAYMENTS_ENABLED=false
ENABLE_AI_SCHEDULES=false
PUBLIC_API_URL=https://presek.mk/api
INTERNAL_API_URL=http://127.0.0.1:5001/api
CORS_ORIGINS=https://presek.mk,https://www.presek.mk
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://presek:CHANGE_ME@localhost/presek
# Read replica for SELECT routing only — never duplicate DATABASE_URL with this value.
DATABASE_READ_REPLICA_URL=
DB_POOL_MINCONN=1
DB_POOL_MAXCONN=5
DB_POOL_TIMEOUT=60
DB_POOL_MAX_LIFETIME=1800

# Audio generation: auto = Serbian and Macedonian use Edge neural TTS.
AUDIO_TTS_ENGINE=auto
AUDIO_TTS_ENGINE_SR=edge
AUDIO_TTS_ENGINE_MK=edge
OMNIVOICE_NUM_STEP=8
SR_TTS_SPEED_FACTOR=1.0  # Only used if Serbian is explicitly configured to gTTS.
AUDIO_PRIORITY_GENERATION_LIMIT=2

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ============================================================================
# AI PROVIDERS
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your_account/default
CF_AI_GATEWAY_TOKEN=your_cf_ai_token

# ============================================================================
# LOCAL MODEL
# ============================================================================
LOCAL_MODEL_PATH=models/gemma-4-E2B-it-Q4_K_M.gguf
MODEL_THREADS=2

# ============================================================================
# FEATURE FLAGS
# ============================================================================
LOCAL_TRANSLATION_ENABLED=true
ENABLE_EXPENSIVE_STYLE_TASKS=false
ENABLE_GPU_ACCELERATION=false

# ============================================================================
# NOTIFICATIONS
# ============================================================================
NTFY_TOPIC=presek-mk-vesti
NTFY_TOKEN=your_ntfy_token_here

# ============================================================================
# WEB PUSH
# ============================================================================
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ============================================================================
# SMTP / EMAIL
# ============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="Presek <briefing@presek.live>"

# ============================================================================
# CLOUDFLARE
# ============================================================================
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_KV_NAMESPACE_ID=your_namespace_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id

# ============================================================================
# CLOUD STORAGE (R2 / S3)
# ============================================================================
R2_BUCKET_NAME=presek-cache
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key

# ============================================================================
# WEB RESEARCH
# ============================================================================
ENABLE_PUBLIC_WEB_RESEARCH=true

# ============================================================================
# AD PLACEMENTS
# ============================================================================
PUBLIC_ENABLE_ADS=0
PUBLIC_TOP_AD_KEY=your_top_ad_key
PUBLIC_RAIL_AD_KEY=your_rail_ad_key
PUBLIC_NATIVE_AD_KEY=your_native_ad_key
PUBLIC_NATIVE_AD_HOST=your_native_ad_host

# ============================================================================
# OBSERVABILITY
# ============================================================================
SENTRY_DSN=

# ============================================================================
# AI ROUTING & OPTIMIZATION
# ============================================================================
# Profiles: balanced (default), quality (all-remote), cost (Gemma-first)
SYNTHESIS_PROFILE=balanced

# When true, remote APIs are preferred for medium+ clusters (3+ articles).
# Low-complexity stories still route to local Gemma in balanced mode.
FREE_API_KEYS_ENABLED=false

# A/B testing for router (10% of requests will be randomly assigned)
ROUTER_AB_TESTING=false

# Prefer local Gemma for synthesis when complexity allows.
LOCAL_SYNTHESIS_PREFER_LOCAL=true
LOCAL_SYNTHESIS_HIGH_COMPLEXITY_REMOTE=true
# Force Gemma-only synthesis (no remote LLMs); Edge TTS unchanged.
SYNTHESIS_LOCAL_ONLY=true
# Daily briefing LLM: nvidia (remote first, local fallback), local (Gemma only), or unset (default cascade).
BRIEFING_REMOTE_PROVIDER=nvidia
# NVIDIA read timeout for daily briefings (long-form, up to 4000 tokens).
NVIDIA_DAILY_BRIEF_TIMEOUT_SECONDS=600
SYNTHESIS_GEMMA_BEFORE_DETERMINISTIC=false
LOCAL_LLM_SYNTHESIS_LOCK_TIMEOUT_SECONDS=120
LOCAL_SYNTHESIS_MAX_TOKENS=2500
INTEL_HEAVY_CONCURRENCY=6

# Bilingual clusters: generate Serbian once, translate structured output to Macedonian.
SYNTHESIS_MK_TRANSLATE_FROM_SR=true
# Macedonian publish gate: reject MK synthesis with too much Latin / Serbian leakage.
MK_COPY_MIN_CYRILLIC_LETTERS=24
MK_COPY_MAX_LATIN_SHARE=0.28
MK_COPY_MAX_SERBIAN_LEAKS=0
# Serbian publish gate: reject SR synthesis with too much Cyrillic leakage.
SR_COPY_MIN_LATIN_LETTERS=24
SR_COPY_MAX_CYRILLIC_SHARE=0.22
SR_COPY_MAX_CYRILLIC_LEAKS=1
# Re-queue synthesis when copy-purity publish gate blocks output.
COPY_PURITY_RETRY_ENABLED=true
COPY_PURITY_RETRY_DELAY_SECONDS=300
COPY_PURITY_RETRY_LOCK_TTL=7200
# Personalized news ranking: semantic vs explicit profile signal blend.
PERSONALIZATION_BLEND_SEMANTIC=0.7
# Try Gemma explicitly before deterministic enhanced_fallback.
SYNTHESIS_GEMMA_BEFORE_DETERMINISTIC=false

# Tiered synthesis quality floors (0.0-1.0). Fast mode skips quality gates.
SYNTHESIS_QUALITY_MIN_LOCAL=0.65
SYNTHESIS_QUALITY_MIN_NVIDIA=0.70

# Fast synthesis publishes quickly, then upgrades to full quality after a delay.
FAST_SYNTHESIS_UPGRADE_ENABLED=true
FAST_SYNTHESIS_UPGRADE_DELAY_SECONDS=1200
FAST_SYNTHESIS_UPGRADE_LOCK_TTL_SECONDS=7200
FAST_SYNTHESIS_UPGRADE_MAX_DEFERS=6
FAST_SYNTHESIS_UPGRADE_FORCE_AFTER_DEFERS=true
FAST_SYNTHESIS_STUCK_HOURS=24
FAST_SYNTHESIS_PENDING_TTL_SECONDS=172800
FAST_SYNTHESIS_UPGRADE_QUEUE=maintenance
FAST_SYNTHESIS_UPGRADE_SWEEP_LIMIT=25
FALLBACK_SYNTHESIS_REFRESH_LIMIT=30
LOW_SCORE_SYNTHESIS_MIN=0.75
LOW_SCORE_SYNTHESIS_REFRESH_LIMIT=20
ROUTER_FALLBACK_PRESSURE_LOCAL=false
SYNTHESIS_PROFILE=balanced
FREE_API_KEYS_ENABLED=false
LOCAL_LLM_LOCK_TIMEOUT_SECONDS=300
SYNTHESIS_REFRESH_HOURLY_CAP=120
SYNTHESIS_REFRESH_HOURLY_CAP_BURST=240
SYNTHESIS_QUEUE_DEFER_LIMIT=60
SYNTHESIS_QUEUE_BURST_INTEL_MAX=200
ROUTER_BALANCED_LOCAL_MAX_ARTICLES=5
SYNTHESIS_PERSIST_GAP_WARN=5
SYNTHESIS_PERSIST_GAP_CRITICAL=20

# Shorter JSON schema for local Gemma synthesis (3 paragraphs vs 5).
LOCAL_SYNTHESIS_SIMPLIFIED_SCHEMA=true

# Quality-aware routing thresholds (rolling window uses recorded synthesis scores).
ROUTER_QUALITY_MIN_SAMPLES=5
ROUTER_QUALITY_WINDOW_HOURS=168
ROUTER_LOCAL_MIN_QUALITY=0.80
ROUTER_SMALL_UPGRADE_QUALITY=0.85

# Auto-synthesis scheduler tuning
AUTO_SUMMARIZE_TOP_N=20
AUTO_SUMMARIZE_MIN_SRC=2
AUTO_SUMMARIZE_DELAY=1.5
AUTO_SUMMARIZE_FRESH_HOURS=6
# Limit scheduled synthesis to homepage layout clusters; cluster pages still JIT on view.
HOMEPAGE_SYNTHESIS_ONLY=true
# Homepage synthesis catch-up: batch size, beat interval (seconds), and max in-flight queue headroom.
HOMEPAGE_SYNTHESIS_PRIORITIZE_LIMIT=24
HOMEPAGE_SYNTHESIS_PRIORITIZE_INTERVAL_SECONDS=300
HOMEPAGE_SYNTHESIS_QUEUE_HEADROOM=60

# ============================================================================
# SECURITY & LOCAL MODELS (Added from .env)
# ============================================================================
SSRF_DNS_TIMEOUT=5
SSRF_BLOCKED_HOSTNAMES=localhost,127.0.0.1,0.0.0.0
BACKUP_PASSPHRASE=
LOCAL_MODEL_CONTEXT=2048
LOCAL_MODEL_MAX_PROMPT_CHARS=4000
