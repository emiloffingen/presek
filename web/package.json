{
  "name": "presek-mk-web",
  "description": "Macedonian frontend for Presek (presek.mk)",
  "type": "module",
  "version": "8.3.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/preview-server.mjs && astro preview",
    "astro": "astro",
    "test": "node --test src/lib/**/*.test.mjs src/utils/**/*.test.mjs",
    "analyze": "astro build && node scripts/analyze-bundle.mjs",
    "analyze:ci": "astro build && node scripts/analyze-bundle.mjs --enforce",
    "test:e2e": "cypress run --e2e",
    "test:e2e:ui": "cypress open --e2e",
    "test:component": "cypress run --component",
    "test:component:ui": "cypress open --component",
    "eval:recommendations": "node src/lib/recommendationEval.mjs",
    "lint": "astro check --minimumSeverity warning",
    "perf:lighthouse": "node scripts/lighthouse-homepage.mjs --preview",
    "perf:lighthouse:ci": "node scripts/lighthouse-homepage.mjs --preview --enforce",
    "perf:lighthouse:ci:mk": "node scripts/lighthouse-homepage.mjs --preview --enforce --path /mk/ --label mk",
    "perf:lighthouse:live": "node scripts/lighthouse-homepage.mjs https://presek.mk/ --enforce",
    "perf:lighthouse:live:mk": "node scripts/lighthouse-homepage.mjs https://presek.mk/ --enforce --label mk",
    "a11y:ci": "node scripts/a11y-homepage.mjs --preview --enforce",
    "a11y:ci:mk": "node scripts/a11y-homepage.mjs --preview --enforce --path /mk/ --label mk"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.2",
    "@base-ui/react": "^1.4.1",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-serif": "^5.2.9",
    "@fontsource/noto-serif-display": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@nanostores/react": "^1.1.0",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "he": "^1.2.0",
    "isomorphic-dompurify": "^3.12.0",
    "lucide-react": "^1.14.0",
    "nanostores": "^1.3.0",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.10.2",
    "@types/he": "^1.2.3",
    "cypress": "^15.14.2",
    "puppeteer-core": "^25.12.0"
  },
  "overrides": {
    "vite": "^8.3.0",
    "yaml-language-server": "1.22.0",
    "fast-uri": "^3.1.2",
    "file-type": "^21.3.1",
    "qs": "^6.15.2",
    "tar": "^7.5.11",
    "tmp": "^0.2.6",
    "uuid": "^11.0.0",
    "puppeteer": "25.12.0"
  }
}
