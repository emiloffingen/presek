---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Mail, MessageSquare, Info } from 'lucide-react';
---

<Layout 
    title="Контакт — Пресек" 
    description="Контактирајте го тимот на Пресек за соработка, предлози или техничка поддршка."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">КОРЕСПОНДЕНЦИЈА & ПОДДРШКА</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Контакт <span>Информации</span></h1>
            </div>
            <p class="masthead-intro">
                Отворени сме за вашите предлози, прашања и нови идеи за соработка. Комуникацијата со нашите читатели и партнери е клучна за развојот на платформата.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Пресек 5.48 е динамичен проект во постојана еволуција. Вашата соработка е клучна за да ги усовршиме нашите системи за обработка, да ја изостриме уредничката синтеза и да го направиме корисничкото искуство уште потранспарентно и покорисно за јавноста.
                    </p>

                    <div class="contact-channels space-y-8 my-10">
                        <div class="channel-item p-8 border border-border bg-secondary/10">
                            <h3 class="font-serif text-2xl font-black mb-4">Редакциска кореспонденција</h3>
                            <p class="mb-6">За сите општи прашања, медиумски барања или институционална соработка, контактирајте нѐ преку нашата официјална адреса:</p>
                            <a href="mailto:contact@presek.live" class="text-2xl font-black text-nyt-accent underline">contact@presek.live</a>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="channel-item p-6 border border-border">
                                <h4 class="font-sans font-black text-[10px] uppercase tracking-widest mb-3">Соработка со медиуми</h4>
                                <p class="text-sm leading-relaxed">Доколку вашата редакција сака да биде дел од нашиот систем за мапирање на плурализмот, ве молиме испратете информации за вашите официјални канали за дистрибуција.</p>
                            </div>
                            <div class="channel-item p-6 border border-border">
                                <h4 class="font-sans font-black text-[10px] uppercase tracking-widest mb-3">Оперативни забелешки</h4>
                                <p class="text-sm leading-relaxed">Забележавте технички пропуст или неточност во системското групирање? Испратете ни детален опис за побрза корекција од нашиот тим.</p>
                            </div>
                        </div>
                    </div>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Одговор</p>
                    <h3 class="rail-title">ВРЕМЕНСКА РАМКА</h3>
                    <p class="rail-text">Настојуваме да одговориме на сите легитимни барања во рок од 24 до 48 часа.</p>
                </section>

                <div class="rail-meta-box">
                    <p class="text-[10px] font-black uppercase tracking-widest mb-4 opacity-50">КОМУНИКАЦИЈА</p>
                    <p class="text-xs leading-relaxed italic">Пресек.мк ги цени конструктивните критики и сугестии од заедницата.</p>
                </div>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }

    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 4px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }
    .rail-meta-box { padding: 1.5rem; border: 1px solid var(--border); }
</style>
