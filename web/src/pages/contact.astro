---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const brand = lang === 'mk' ? 'Presek.live' : 'Presek.rs';
---

<Layout title={t('contact.title')} description={t('contact.description')}>
    <NYTHeader />
    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker ui-label">{t('contact.kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">{t('contact.heading')} <span>{t('contact.heading_span')}</span></h1>
            </div>
            <p class="masthead-intro">{t('contact.intro')}</p>
        </header>

        <div class="editorial-broadsheet-grid">
            <div class="editorial-broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">{t('contact.lead')}</p>

                    <div class="contact-channels space-y-8 my-10">
                        <div class="channel-item p-8 border border-border bg-secondary/10">
                            <h3 class="font-serif text-2xl font-black mb-4">{t('contact.editorial_title')}</h3>
                            <p class="mb-6">{t('contact.editorial_body')}</p>
                            <a href="mailto:contact@presek.live" class="text-2xl font-black text-nyt-accent underline">contact@presek.live</a>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--grid-gap)]">
                            <div class="channel-item p-6 border border-border">
                                <h4 class="ui-label mb-3">{t('contact.media_title')}</h4>
                                <p class="text-sm leading-relaxed">{t('contact.media_body')}</p>
                            </div>
                            <div class="channel-item p-6 border border-border">
                                <h4 class="ui-label mb-3">{t('contact.ops_title')}</h4>
                                <p class="text-sm leading-relaxed">{t('contact.ops_body')}</p>
                            </div>
                        </div>
                    </div>
                </article>
            </div>

            <aside class="editorial-broadsheet-rail">
                <details class="editorial-rail-context">
                    <summary class="editorial-rail-context-summary">
                        <span class="ui-label">{t('editorial.rail_context')}</span>
                        <span class="editorial-rail-context-hint ui-label-min text-muted-foreground">{t('editorial.rail_open')}</span>
                    </summary>
                    <div class="editorial-rail-context-body">
                        <section class="editorial-rail-block editorial-rail-block-alt">
                            <p class="editorial-rail-kicker">{t('contact.rail_kicker')}</p>
                            <h3 class="editorial-rail-title">{t('contact.rail_title')}</h3>
                            <p class="editorial-rail-text">{t('contact.rail_text')}</p>
                        </section>

                        <div class="editorial-rail-meta">
                            <p class="ui-label-min text-muted-foreground mb-4 opacity-70">{t('contact.rail_meta_label')}</p>
                            <p class="text-xs leading-relaxed italic">{t('contact.rail_meta_text').replace('{brand}', brand)}</p>
                        </div>
                    </div>
                </details>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    @media (max-width: 639.98px) {
        .contact-channels {
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
            gap: 0.85rem !important;
        }

        .channel-item.p-8 { padding: 1rem !important; }
        .channel-item.p-6 { padding: 0.9rem !important; }
        .channel-item h3 { font-size: 1.35rem !important; margin-bottom: 0.75rem !important; }
        .channel-item a { font-size: 1.15rem !important; line-height: 1.2; }
    }
</style>
