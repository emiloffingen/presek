---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Mail, Info } from 'lucide-react';
---

<Layout 
    title="Контакт"
    description="Контактирајте го тимот на Пресек за прашања, предлози или соработка."
>
    <NYTHeader />
    <main class="site-layout py-[var(--page-py)]">
        <Breadcrumbs items={[{ label: "Контакт" }]} />
        <article class="editorial-shell">
            <header class="editorial-header">
                <span class="page-kicker">Комуникација</span>
                <h1 class="editorial-headline">Контакт</h1>
                <p class="editorial-intro">
                    Имате прашање, предлог или сакате да го вклучите вашиот медиум во нашата мрежа? Тука сме за соработка и повратни информации.
                </p>
            </header>

            <div class="editorial-page-grid">
                <div class="editorial-main">
                    <section class="editorial-panel">
                        <h2 class="editorial-panel-title">Електронска пошта</h2>
                        <div class="flex items-center gap-4 mb-4">
                            <div class="p-3 bg-nyt-accent/10 text-nyt-accent rounded-full">
                                <Mail size={24} />
                            </div>
                            <div>
                                <p class="font-serif text-2xl font-black text-nyt-accent">contact@presek.mk</p>
                                <p class="text-sm text-muted-foreground mt-1">Одговараме на сите легитимни барања во рок од 24 часа.</p>
                                <a href="mailto:contact@presek.mk" class="contact-action-link">Испрати е-пошта</a>
                            </div>
                        </div>
                    </section>

                    <section class="editorial-panel">
                        <h2 class="editorial-panel-title">За медиумите</h2>
                        <div class="prose-nyt">
                            <p>
                                Доколку претставувате медиум и сакате да бидете вклучени во Пресек, ве молиме испратете го вашиот официјален RSS линк. Нашата мисија е да промовираме квалитетно и објективно новинарство преку правилно групирање и транспарентно цитирање.
                            </p>
                        </div>
                    </section>

                    <section class="editorial-panel">
                        <h2 class="editorial-panel-title">Техничка поддршка</h2>
                        <div class="prose-nyt">
                            <p>
                                За пријавување на технички грешки, ве молиме наведете го вашиот уред и прелистувачот кој го користите. Ова ни помага побрзо да го идентификуваме и решиме проблемот.
                            </p>
                        </div>
                    </section>
                </div>

                <aside class="editorial-rail">
                    <div class="rail-card rail-card-accent">
                        <h2 class="rail-card-title">Најбрз пат</h2>
                        <p class="rail-copy">
                            За прашања, технички проблеми или барања за вклучување медиум, најбрзо е директно да ни пишете на е-пошта со краток опис и линк каде што е потребно.
                        </p>
                    </div>

                    <div class="rail-card">
                        <h2 class="rail-card-title">Пред да пишете</h2>
                        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-nyt-accent mb-4">
                            <Info size={14} /> Корисно за побрз одговор
                        </div>
                        <ul class="contact-checklist">
                            <li>испратете линк до конкретната страница или кластер;</li>
                            <li>наведете дали се работи за содржина, технички проблем или нов извор;</li>
                            <li>ако е баг, наведете уред и прелистувач.</li>
                        </ul>
                    </div>
                </aside>
            </div>
        </article>
    </main>

    <Footer />
</Layout>

<style>
    .contact-action-link {
        display: inline-flex;
        margin-top: 0.9rem;
        padding: 0.65rem 0.9rem;
        border: 1px solid var(--foreground);
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--foreground);
    }

    .contact-action-link:hover {
        background: var(--foreground);
        color: var(--background);
    }

    .contact-checklist {
        margin: 0;
        padding-left: 1.1rem;
        font-family: var(--font-nyt-body);
        font-size: 0.98rem;
        line-height: 1.7;
        color: var(--secondary-foreground);
    }

    .contact-checklist li + li {
        margin-top: 0.45rem;
    }
</style>
