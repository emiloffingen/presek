---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';
import PresekRailAd from '../components/PresekRailAd.astro';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
---

<Layout
    title={`${t('nav.methodology')} — Presek`}
    description={t('methodology.meta_description')}
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)] methodology-page-scope">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">{t('methodology.masthead_kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">{t('methodology.masthead_title')} <span>{t('methodology.masthead_title_span')}</span></h1>
            </div>
            <p class="masthead-intro">
                {t('methodology.masthead_intro')}
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Пресек функционира како сметачки опсерваториум што применува строги математички и лингвистички модели за анализа на медиумските текстови. Нашата методологија е целосно транспарентна, автоматизирана и изградена така што ја исклучува човечката субјективност при проценката на медиумскиот пејзаж.
                    </p>

                    <h2 class="section-title-italic">1. Векторско групирање (Semantic Clustering)</h2>
                    <p>
                        Првиот чекор во нашата обработка е извлекување и групирање на вестите. Секој медиумски напис се чисти од метаподатоци и се претвора во повеќедимензионален нумерички вектор со помош на модел за вгнездување (embedding), оптимизиран за јужнословенските јазици.
                    </p>
                    <p>
                        Сличноста меѓу написите се утврдува со пресметување на <strong>косинусната сличност</strong> (Cosine Similarity) меѓу векторите. Кога една група написи ќе го надмине прагот на сличност од 0.78, тие автоматски се групираат во единствена приказна или „кластер“. Овој процес ни овозможува да следиме како различни редакции го покриваат истиот настан.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">2. Индекс на медиумски плурализам (Pluralism Score)</h2>
                    <p>
                        <strong>Индексот на плурализам</strong> е нашата основна метричка вредност изразена во проценти (од 0% до 100%). Тој ја мери разновидноста на перспективите и наративниот диверзитет во рамките на еден кластер:
                    </p>
                    <ul class="editorial-list">
                        <li><strong>Број на независни извори (тежински коефициент):</strong> Поголем број единствени извештаи од различни медиумски групации го зголемува индексот.</li>
                        <li><strong>Семантичка дисперзија:</strong> Анализираме варијација во изборот на зборови и во синтаксата меѓу написите. Ако сите медиуми користат идентични агенциски фрази (на пр. директно копирање на соопштенија), индексот опаѓа, што укажува на низок плурализам.</li>
                        <li><strong>Тонална ентропија:</strong> Ја мери распределбата на позитивни, неутрални и негативни тонови. Избалансираниот сентимент низ целиот политички и медиумски спектар води кон поголема наративна разновидност.</li>
                    </ul>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">3. Анализа на сентимент и тоналитет (Sentiment Pulse)</h2>
                    <p>
                        Секој новинарски напис поминува низ синтаксичка анализа при што се оценува емоционалниот набој и тоналитетот. На секоја реченица ѝ се доделува вредност од -1 (изразито негативен/сензационалистички тон) до +1 (изразито позитивен/промотивен тон).
                    </p>
                    <p>
                        Збирниот <strong>Sentiment Pulse</strong> го прикажува општиот емотивен профил на вестите. Избалансираниот и неутрален тоналитет укажува на висококвалитетно агенциско известување, додека екстремите укажуваат на можна сензационалистичка пристрасност.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">4. Автоматска синтеза (Editorial Synthesis)</h2>
                    <p>
                        За да им заштедиме време на читателите и да понудиме објективен преглед, нашите генеративни NLP модели ја анализираат целата група написи во кластерот, ги издвојуваат вкрстено потврдените клучни факти и создаваат неутрална синтеза. Овој процес ги синтетизира информациите без преземање на субјективното мислење на поединечните автори, создавајќи единствен придонес кон медиумската анализа.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">{t('methodology.trust_section_title')}</h2>
                    <p>
                        {t('methodology.trust_section_intro')}
                    </p>
                    <ul class="editorial-list">
                        <li><strong>{t('methodology.trust_early_signal_label')}</strong> — {t('methodology.trust_early_signal_body')}</li>
                        <li><strong>{t('methodology.trust_provisional_label')}</strong> — {t('methodology.trust_provisional_body')}</li>
                        <li><strong>{t('methodology.trust_consensus_label')}</strong> — {t('methodology.trust_consensus_body')}</li>
                        <li><strong>{t('methodology.trust_pluralism_label')}</strong> — {t('methodology.trust_pluralism_body')}</li>
                        <li><strong>{t('methodology.trust_verified_label')}</strong> — {t('methodology.trust_verified_body')}</li>
                    </ul>
                    <p>
                        {t('methodology.trust_fasttrack_note')}
                    </p>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <PresekRailAd />

                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">{t('methodology.rail_formula_kicker')}</p>
                    <h3 class="rail-title">{t('methodology.rail_formula_title')}</h3>
                    <p class="rail-text">
                        {t('methodology.rail_formula_body')}
                    </p>
                </section>

                <section class="rail-block">
                    <p class="rail-kicker">{t('methodology.rail_nav_kicker')}</p>
                    <div class="rail-directory">
                        <a href={l('/about')} class="dir-link"><span class="name">{t('nav.about')}</span></a>
                        <a href={l('/editorial')} class="dir-link"><span class="name">{t('nav.standards')}</span></a>
                        <a href={l('/izvori')} class="dir-link"><span class="name">{t('nav.sources')}</span></a>
                    </div>
                </section>
            </aside>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--presek-mark); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    /* ── Broadstreet Layout ───────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { align-self: start; }
    }

    /* ── Prose ───────────────────────────────────────── */
    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }
    .prose-editorial p { margin-bottom: 1.5rem; text-wrap: pretty; }

    .section-title-italic { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 900; font-style: italic; margin-bottom: 1.5rem; }
    .editorial-divider { height: 1px; background: var(--border); margin: 3rem 0; }

    .editorial-list { list-style: none; padding: 0; margin-bottom: 2rem; }
    .editorial-list li { margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
    .editorial-list li::before { content: "—"; position: absolute; left: 0; color: var(--presek-mark); font-weight: 900; }

    .two-col-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem; }
    @media (min-width: 640px) { .two-col-grid { grid-template-columns: 1fr 1fr; } }
    .grid-item h3 { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem; }
    .grid-item p { font-size: 0.95rem; line-height: 1.6; }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 0px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--presek-mark); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }

    .rail-directory { display: flex; flex-direction: column; }
    .dir-link { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; }
    .dir-link .name { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; }
    .dir-link:hover .name { color: var(--presek-mark); text-decoration: underline; }
</style>
