---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';
import TinyAdzRailAd from '../components/TinyAdzRailAd.astro';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
---

<Layout
    title={`${t('nav.methodology') || 'Metodologija'} — Presek`}
    description="Detaljno objašnjenje naučne metodologije, NLP algoritama i matematičkih formula koje Presek koristi za izračunavanje medijskog pluralizma i sentimenta."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">NAUČNI OKVIR I INDEKSIRANJE</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Metodologija <span>i metrika</span></h1>
            </div>
            <p class="masthead-intro">
                Kako naši NLP algoritmi analiziraju, grupišu i ocenjuju medijski sadržaj na bazi empirijskih jezičkih modela.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Presek funkcioniše kao računarski opservatorijum koji primenjuje stroge matematičke i lingvističke modele na analizu medijskih tekstova. Naša metodologija je u potpunosti transparentna, automatizovana i izgrađena da isključi ljudsku subjektivnost pri proceni medijskog pejzaža.
                    </p>

                    <h2 class="section-title-italic">1. Vektorsko grupisanje (Semantic Clustering)</h2>
                    <p>
                        Prvi korak u našoj obradi je ekstrakcija i grupisanje vesti. Svaki medijski članak se čisti od metapodataka i pretvara u višedimenzionalni numerički vektor korišćenjem embedding modela optimizovanih za južnoslovenske jezike.
                    </p>
                    <p>
                        Sličnost između članaka se utvrđuje računanjem <strong>kosinusne sličnosti</strong> (Cosine Similarity) između vektora. Kada skup članaka pređe prag sličnosti od 0.78, oni se automatski grupišu u jedinstvenu priču ili "klaster". Ovaj proces nam omogućava da pratimo kako različite redakcije pokrivaju potpuno isti događaj.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">2. Indeks Medijskog Pluralizma (Pluralism Score)</h2>
                    <p>
                        <strong>Indeks Pluralizma</strong> je naša primarna metrička vrednost izražena u procentima (0% do 100%). On meri raznolikost perspektiva i narativni diverzitet unutar jednog klastera:
                    </p>
                    <ul class="editorial-list">
                        <li><strong>Broj nezavisnih izvora (Težinski koeficijent):</strong> Veći broj jedinstvenih izveštaja iz različitih medijskih grupacija povećava indeks.</li>
                        <li><strong>Semantička disperzija:</strong> Analiziramo varijaciju u izboru reči i sintaksi između članaka. Ako svi mediji koriste identične agencijske fraze (npr. direktan copy-paste saopštenja), indeks opada, ukazujući na nizak pluralizam.</li>
                        <li><strong>Tonalna entropija:</strong> Meri distribuciju pozitivnih, neutralnih i negativnih tonova. Ujednačen sentiment širom celog političkog i medijskog spektra vodi ka većoj narativnoj raznolikosti.</li>
                    </ul>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">3. Analiza Sentimenta i Tonaliteta (Sentiment Pulse)</h2>
                    <p>
                        Svaki novinski članak prolazi kroz sintaksičku raščlanjenost gde se evaluira emotivni naboj i tonalitet. Svakoj rečenici se dodeljuje vrednost od -1 (izrazito negativan/senzacionalistički ton) do +1 (izrazito pozitivan/promotivni ton).
                    </p>
                    <p>
                        Zbirni <strong>Sentiment Pulse</strong> prikazuje opšti emotivni profil vesti. Izbalansiran i neutralan tonalitet ukazuje na visokokvalitetno agencijsko izveštavanje, dok ekstremi ukazuju na potencijalnu senzacionalističku pristrasnost.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">4. Automatska Sinteza (Editorial Synthesis)</h2>
                    <p>
                        Kako bismo uštedeli vreme čitaocima i ponudili objektivan pregled, naši generativni NLP modeli analiziraju čitavu grupu članaka u klasteru, izdvajaju unakrsno potvrđene ključne činjenice (fakte) i stvaraju neutralnu sintezu. Ovaj proces sintetiše informacije bez preuzimanja subjektivnog mišljenja pojedinačnih autora, stvarajući jedinstveni doprinos medijskoj analizi.
                    </p>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <TinyAdzRailAd />

                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Metrika</p>
                    <h3 class="rail-title">FORMULA PLURALIZMA</h3>
                    <p class="rail-text">
                        Indeks Pluralizma = f(Nezavisni Izvori) * Semantički Diverzitet * Tonalna Entropija. Cilj je matematičko mapiranje informativnih praznina.
                    </p>
                </section>

                <section class="rail-block">
                    <p class="rail-kicker">Navigacija</p>
                    <div class="rail-directory">
                        <a href={l('/about')} class="dir-link"><span class="name">O nama</span></a>
                        <a href={l('/editorial')} class="dir-link"><span class="name">Standardi</span></a>
                        <a href={l('/izvori')} class="dir-link"><span class="name">Izvori</span></a>
                        <a href={l('/analize')} class="dir-link"><span class="name">Analize</span></a>
                    </div>
                </section>
            </aside>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    /* ── Broadstreet Layout ───────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { align-self: start; }
    }

    /* ── Prose ───────────────────────────────────────── */
    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }
    .prose-editorial p { margin-bottom: 1.5rem; text-wrap: pretty; }

    .section-title-italic { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 900; font-style: italic; margin-bottom: 1.5rem; }
    .editorial-divider { height: 1px; background: var(--border); margin: 3rem 0; }

    .editorial-list { list-style: none; padding: 0; margin-bottom: 2rem; }
    .editorial-list li { margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
    .editorial-list li::before { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); font-weight: 900; }

    .two-col-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem; }
    @media (min-width: 640px) { .two-col-grid { grid-template-columns: 1fr 1fr; } }
    .grid-item h3 { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem; }
    .grid-item p { font-size: 0.95rem; line-height: 1.6; }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 0px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }

    .rail-directory { display: flex; flex-direction: column; }
    .dir-link { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; }
    .dir-link .name { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; }
    .dir-link:hover .name { color: var(--nyt-accent); text-decoration: underline; }
</style>
