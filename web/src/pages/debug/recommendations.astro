---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import { getRecommendationEvaluation } from '../../lib/recommendationEval.mjs';

const debugToken = String(import.meta.env.DEBUG_PAGE_TOKEN || '').trim();
const requestToken =
  Astro.request.headers.get('x-debug-token') ||
  '';
const isAuthorized = Boolean(debugToken) && requestToken === debugToken;

if (!isAuthorized) {
  Astro.response.status = 404;
}

let evaluation = null;
let error = '';

try {
  if (isAuthorized) {
  evaluation = await getRecommendationEvaluation();
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Не успеа вчитувањето на евалуацијата.';
}
---

<Layout title="Debug Recommendations" robots="noindex, nofollow">
  <NYTHeader />

  <main class="site-layout debug-shell">
    {!isAuthorized ? (
      <section class="debug-panel debug-error">
        <h1>Not Found</h1>
        <p>Оваа страница не е јавно достапна.</p>
      </section>
    ) : error ? (
      <section class="debug-panel debug-error">
        <h2>Грешка</h2>
        <p>{error}</p>
      </section>
    ) : evaluation && (
      <>
        <header class="debug-header">
          <span class="page-kicker">Internal Debug</span>
          <h1 class="debug-title">Recommendation Evaluation</h1>
          <p class="debug-copy">
            Внатрешен преглед на пример-профили, активни препораки и рангирање врз основа на тековните локални податоци.
          </p>
        </header>

        <section class="debug-summary-grid">
          <article class="debug-panel">
            <span class="debug-label">API</span>
            <strong>{evaluation.api_url}</strong>
          </article>
          <article class="debug-panel">
            <span class="debug-label">Clusters</span>
            <strong>{evaluation.cluster_count}</strong>
          </article>
          <article class="debug-panel">
            <span class="debug-label">Profiles</span>
            <strong>{evaluation.results.length}</strong>
          </article>
        </section>

        <section class="debug-results">
          {evaluation.results.map((entry) => (
            <article class="debug-panel profile-panel">
              <div class="profile-head">
                <h2>{entry.profile}</h2>
                <span>{entry.personalized.length} персонализирани кластери</span>
              </div>

              <div class="debug-grid">
                <section>
                  <h3>Personalized</h3>
                  {entry.personalized.length > 0 ? (
                    <ul class="debug-list">
                      {entry.personalized.map((item) => (
                        <li>
                          <strong>{item.title}</strong>
                          <span>{item.reason}</span>
                          <code>{item.score}</code>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="debug-empty">Нема препораки.</p>
                  )}
                </section>

                <section>
                  <h3>Home Rail</h3>
                  <pre>{JSON.stringify(entry.home_rail, null, 2)}</pre>
                </section>

                <section>
                  <h3>For You</h3>
                  <pre>{JSON.stringify(entry.for_you, null, 2)}</pre>
                </section>

                <section>
                  <h3>Topic</h3>
                  <pre>{JSON.stringify(entry.topic, null, 2)}</pre>
                </section>
              </div>
            </article>
          ))}
        </section>
      </>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .debug-shell {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .debug-header {
    max-width: 52rem;
    margin-bottom: 2rem;
  }

  .debug-title {
    margin: 0.45rem 0 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.7rem + 1vw, 3rem);
    line-height: 0.96;
  }

  .debug-copy {
    margin: 0;
    max-width: 46rem;
    color: var(--secondary-foreground);
    font-size: 1rem;
    line-height: 1.6;
  }

  .debug-summary-grid,
  .debug-grid {
    display: grid;
    gap: 1rem;
  }

  .debug-summary-grid {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-bottom: 1.5rem;
  }

  .debug-panel {
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 94%, var(--secondary) 6%);
    padding: 1rem 1.05rem;
  }

  .debug-panel strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.02rem;
    word-break: break-word;
  }

  .debug-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .debug-results {
    display: grid;
    gap: 1.25rem;
  }

  .profile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .profile-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6rem;
  }

  .profile-head span {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .debug-grid {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .debug-grid section h3 {
    margin: 0 0 0.7rem;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .debug-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .debug-list li {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .debug-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .debug-list strong {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.2;
  }

  .debug-list span {
    color: var(--secondary-foreground);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .debug-list code,
  pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }

  .debug-list code {
    display: inline-flex;
    width: fit-content;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--nyt-accent) 10%, var(--background) 90%);
  }

  pre {
    margin: 0;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
    color: var(--secondary-foreground);
  }

  .debug-empty {
    margin: 0;
    color: var(--muted-foreground);
  }

  .debug-error p {
    margin: 0.5rem 0 0;
    color: var(--secondary-foreground);
  }
</style>
