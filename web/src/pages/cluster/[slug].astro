---
import '../../styles/cluster-page.css';
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import ClusterSidebarTabs from '../../components/Cluster/ClusterSidebarTabs.tsx';
import ClusterMobileFocusIsland from '../../components/Cluster/ClusterMobileFocusIsland.tsx';
import { apiBaseUrl } from '../../lib/apiBase';
import { cleanAndDecode, isMostlyCyrillic, getEditionStr, stripCitationMarkers, deShout, slugify, normalizeAndDeduplicateTags, transliterate } from '../../utils/textUtils';
import { chooseClusterImage } from '../../utils/imageSelection';

import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { buildCanonicalUrl, localePath, homePath, siteOrigin } from '../../lib/localePaths';
import TinyAdzInlinedAd from '../../components/TinyAdzInlinedAd.astro';
import TinyAdzRailAd from '../../components/TinyAdzRailAd.astro';
import {
	getConsensusNote,
	resolveHasCitationSources,
	shouldShowConsensusNote,
	shouldShowCredibilitySection,
	shouldShowExecutiveSummary,
	shouldShowHeroVisual,
	shouldShowKeyFactsBand,
	shouldShowPerspectives,
} from '../../lib/clusterPageLayout';
import { getClockTimeStr as formatClockTime, getRelativeTimeStr as formatRelativeTime } from '../../lib/newsTimeFormat';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const translate = (key: string) => t(key as any);

const timeLabels = {
    just_now: t('news.just_now'),
    ago: t('news.ago'),
    min_short: t('news.min_short'),
    hour: t('news.hour'),
    hours: t('news.hours'),
    day: t('news.day'),
    days: t('news.days'),
};

function getRelativeTimeStr(dateStr: string) {
    return formatRelativeTime(dateStr, lang as 'sr' | 'mk', timeLabels);
}

function getTimeStr(dateStr: string) {
    return formatClockTime(dateStr, lang as 'sr' | 'mk', timeLabels);
}


import HeroVisual from '../../components/Cluster/HeroVisual.astro';
import ZenReadingContext from '../../components/Cluster/ZenReadingContext.tsx';

import CitationSources from '../../components/Cluster/CitationSources.astro';
import CredibilityAnalysis from '../../components/Cluster/CredibilityAnalysis.astro';
import ClusterSynthesisSection from '../../components/Cluster/ClusterSynthesisSection.astro';
import ClusterKeyFactsBand from '../../components/Cluster/ClusterKeyFactsBand.astro';
import TrustBlock from '../../components/Cluster/TrustBlock.astro';
import CrossLingualStrip from '../../components/Cluster/CrossLingualStrip.astro';
import { buildTrustChip } from '../../lib/trustSignals';
import ClusterAnalysisSection from '../../components/Cluster/ClusterAnalysisSection.astro';
import ClusterEditorialHeader from '../../components/Cluster/ClusterEditorialHeader.astro';
import ClusterExecutiveSummary from '../../components/Cluster/ClusterExecutiveSummary.astro';
import ClusterSourcesSection from '../../components/Cluster/ClusterSourcesSection.astro';
import ClusterRelatedSection from '../../components/Cluster/ClusterRelatedSection.astro';
import ClusterDeepTools from '../../components/Cluster/ClusterDeepTools.astro';
import type { Article, ClusterDetail } from '../../types';

const { slug } = Astro.params;
const API_URL = apiBaseUrl();
const SITE_URL = siteOrigin(lang);

// Extract ID from slug (handles both legacy 8-char and new 12-char dashed IDs)
const idMatch = slug?.match(/^([0-9a-f]{8}-[0-9a-f]{3,4}|[0-9a-f]{8,12})/);
const id = idMatch ? idMatch[0] : slug?.split('-')[0];

let cluster: ClusterDetail | null = null;
let pipeline: { busy?: boolean } | null = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/cluster/${id}?lang=${lang}`);
    if (!res.ok) {
        if (res.status === 404) {
            error = lang === 'sr' ? 'Klaster nije pronađen.' : 'Кластер не е пронајден.';
            Astro.response.status = 404;
        } else {
            error = lang === 'sr' ? 'Greška pri učitavanju podataka.' : 'Грешка при вчитување на податоците.';
            Astro.response.status = 500;
        }
    } else {
      const payload = await res.json();
      cluster = payload.data;
      pipeline = payload.pipeline && typeof payload.pipeline === 'object' ? payload.pipeline : null;
    }
    } catch (e) {
    Astro.response.status = 500;
    error = lang === 'sr' ? 'Neuspešno povezivanje sa serverom.' : 'Неуспешно поврзување со серверот.';
}

const mainArticle = cluster?.articles?.[0];
const cleanSourceDocumentText = (text: unknown) => cleanAndDecode(String(text || '')
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/^\s*(?:(?:IZVORNI|IZVOREN)\s+ZAPIS|(?:ИЗВОРНИ|ИЗВОРЕН)\s+ЗАПИС)\s*(?:\([^)]+\))?/i, '')
    .replace(/\b(?:Podeli\s+vest|Spodeli\s+vest|Подели\s+вест|Сподели\s+вест|Сподели\s+ја\s+веста)\s*:?\s*/gi, ' ')
    .replace(/\b(?:Oglas|Оглас)\b/gi, ' ')
    .replace(/\b(?:Pročitajte\s+još|Прочитајте\s+још|Procitajte\s+povece|Прочитајте\s+повеќе|Прочитајте\s+уште)\b.*$/i, ' ')
    .replace(/\s+/g, ' ')
    .trim());
const sourceDocArticle = cluster?.articles?.find((article) => {
    const text = cleanSourceDocumentText(article.full_content);
    return text.length > 0;
});
const sourceDocText = sourceDocArticle ? cleanSourceDocumentText(sourceDocArticle.full_content) : '';
const displayHeadline = cluster?.synthetic_headline || (mainArticle ? cleanAndDecode(mainArticle.title) : (lang === 'sr' ? 'Detalji vesti' : 'Детали за веста'));

// --- SEO Slug Enforcement ---
// If the current slug is just the ID or doesn't match the headline slug,
// we perform a 301 redirect to the "Correct" SEO URL.
const currentHeadlineSlug = slugify(displayHeadline);
const canonicalSlug = `${id}-${currentHeadlineSlug}`;
const canonicalPathSlug = id && cluster && currentHeadlineSlug ? canonicalSlug : (id || 'cluster');

if (slug !== canonicalSlug && !error && cluster) {
    const targetPath = `${localePath(`/cluster/${canonicalSlug}`, lang, hostHeader)}${Astro.url.search}`;
    return Astro.redirect(targetPath, 301);
}

const headlineIsCyrillic = isMostlyCyrillic(displayHeadline);

const allSourcesNames: string[] = Array.from(new Set((cluster?.articles || []).map((a: Article) => a.source)));
const sourcePreview = allSourcesNames.slice(0, 5);
const uniqueSourcesCount = allSourcesNames.length;
const newsroomCountLabel = (count: number) => {
    if (lang === 'mk') return count === 1 ? 'РЕДАКЦИЈА' : 'РЕДАКЦИИ';
    return count === 1 ? 'REDAKCIJA' : 'REDAKCIJE';
};
const newsroomOverviewLabel = (count: number) => {
    if (lang === 'mk') return count === 1 ? 'редакција во прегледот' : 'редакции во прегледот';
    return count === 1 ? 'redakcija u pregledu' : 'redakcije u pregledu';
};
const hasCitationSources = resolveHasCitationSources(cluster?.citation_sources);
const citationSources = cluster?.citation_sources || [];

const synthesisUpdatedAt = cluster?.synthesis_updated_at;
const synthesisFreshness = (cluster?.synthesis_freshness || { is_stale: false }) as any;
const synthesisMeta = (cluster?.synthesis_meta || {}) as {
    is_provisional?: boolean;
    needs_upgrade?: boolean;
};
const isProvisionalSynthesis = Boolean(synthesisMeta.is_provisional || synthesisMeta.needs_upgrade);
const isMissingSynthesis = (synthesisFreshness.reasons || []).includes('missing_synthesis');
const isSynthesisRefreshStale = Boolean(synthesisFreshness.is_stale) && !isMissingSynthesis;
const pipelineBusy = Boolean(pipeline?.busy);

const perspectives = cluster?.perspectives || [];
const verificationReport = cluster?.verification_report || null;
const generatedArticle = cluster?.generated_article || null;

type SynthesisItem = { source: string | null; content: string };

const synthesisItems: SynthesisItem[] = (cluster?.ai_summary_bullets?.length ? cluster.ai_summary_bullets : (cluster?.synthesis || '').split('\n'))
    .filter((line: string) => line.trim().length > 10)
    .map((line: string) => {
        const match = line.match(/^\[(.*?)\]\s*(.*)/);
        if (match) {
            return { source: match[1], content: cleanAndDecode(match[2]) };
        }
        return { source: null, content: cleanAndDecode(line) };
    });

const articleRows = (cluster?.articles || []).map((a: Article, idx: number, arr: Article[]) => {
    const d = new Date(a.created_at);
    const signal = a.source_signal || {};
    const timelineEntry = (cluster?.timeline || []).find((item) => item.article_id === a.id);

    // 1. Dynamic Journalistic Role (Timeline)
    let relLabel: string = lang === 'sr' ? 'POVEZANA PRIČA' : 'ПОВРЗАН ИЗВОР';
    let relTone = 'neutral';

    if (timelineEntry?.is_first) {
        relLabel = lang === 'sr' ? 'PRVI IZVOR' : 'ПРВ ИЗВОР';
        relTone = 'origin';
    } else if (idx === 0 && !synthesisFreshness.is_stale) {
        relLabel = lang === 'sr' ? 'NAJNOVIJE' : 'НАЈНОВО';
        relTone = 'latest';
    } else if (timelineEntry?.milestone?.toLowerCase() === 'konsenzus') {
        relLabel = lang === 'sr' ? 'KONSENZUS' : 'КОНСЕНЗУС';
        relTone = 'deep';
    } else if (timelineEntry?.is_major) {
        relLabel = lang === 'sr' ? 'POTVRDA IZVORA' : 'ПОТВРДА ОД ИЗВОР';
        relTone = 'deep';
    } else if (signal.role_label) {
        relLabel = signal.role_label.toUpperCase();
        relTone = signal.role_tone || 'deep';
    } else if ((a.credibility || 0) > 1.2) {
        relLabel = lang === 'sr' ? 'ŠIRI KONTEKST' : 'ПОШИРОК КОНТЕКСТ';
        relTone = 'deep';
    }

    // 2. Individual Quality Signals
    const isObjective = (a.credibility || 0) >= 1.4 || signal.trust_label === 'Visoko poverenje';
    const isSensational = (a.credibility || 0) < 0.8 && !isObjective;

    return {
        ...a,
        title: deShout(cleanAndDecode(a.title)),
        description: cleanAndDecode(a.description || a.summary || ''),
        exactTime: d.toLocaleTimeString('mk-RS', { hour: '2-digit', minute: '2-digit' }),
        relativeTime: getRelativeTimeStr(a.created_at),
        relationship: { tone: relTone, label: relLabel },
        quality: { isObjective, isSensational }
    };
});

const relatedClusters = cluster?.related || [];
const filteredRelated = relatedClusters.filter((c: { cluster_id: string }) => c.cluster_id !== id).slice(0, 5);

const adjacentTopic = cluster?.topics?.find((t: string) => t !== 'Srbija') || cluster?.topics?.[0] || '';

const canonicalUrl = buildCanonicalUrl(`/cluster/${canonicalPathSlug}`, lang);
const shareDescription = synthesisItems[0]?.content || mainArticle?.description || '';

function getLeadVisual(c: ClusterDetail | null) {
    if (!c) return null;
    const selected = chooseClusterImage(c, 'hero', lang as 'sr' | 'mk');
    return {
        src: selected.proxiedUrl || selected.fallbackUrl,
        rawUrl: selected.rawUrl || null,
        isWeak: selected.isWeak,
        fallbackUrl: selected.fallbackUrl,
    };
}
const leadVisual = getLeadVisual(cluster);
const imageUrl = leadVisual && !leadVisual.isWeak
    ? leadVisual.src
    : (leadVisual?.fallbackUrl || '/img/presek_emblem.png');

const headerBriefItems = synthesisItems.length > 0 
    ? synthesisItems.map((item: SynthesisItem) => item.content).filter((line: string) => line.trim().length > 4).slice(0, 4)
    : (mainArticle?.description ? [mainArticle.description] : []);

function normalizeBriefItem(item: string, previousItems: string[]) {
    let text = String(item || '')
        .replace(/^\s*[•\-]\s*/, '')
        .replace(/\bPrati\s+([2-9]|\d{2,})\s+izvori\b/i, 'Prati $1 izvora')
        .trim();
    const labelMatch = text.match(/^([^:]{2,40}):\s*(.+)$/);
    const label = labelMatch ? labelMatch[1].trim().toLocaleLowerCase() : '';
    const body = labelMatch ? labelMatch[2].trim() : text;
    const normalizedBody = body
        .toLocaleLowerCase()
        .replace(/[^\p{L}\p{N}\s]/gu, '')
        .replace(/\s+/g, ' ')
        .trim();
    if (
        label.includes('detalj') &&
        previousItems.some((prev) => {
            const normalizedPrev = prev
                .toLocaleLowerCase()
                .replace(/^[^:]{2,40}:\s*/, '')
                .replace(/[^\p{L}\p{N}\s]/gu, '')
                .replace(/\s+/g, ' ')
                .trim();
            return normalizedPrev === normalizedBody || normalizedPrev.includes(normalizedBody) || normalizedBody.includes(normalizedPrev);
        })
    ) {
        return '';
    }
    if (
        label.includes('otvoreno') &&
        /detalji oko ovog razvoja ostaju nepotvr/i.test(body)
    ) {
        return 'Otvoreno: nije izdvojena konkretna sporna činjenica; treba pratiti sledeće dopune izvora, ne tretirati ovu stavku kao potvrđen sukob.';
    }
    return text;
}

const displayHeaderBriefItems = headerBriefItems.reduce((items: string[], item: string) => {
    const normalized = normalizeBriefItem(item, items);
    if (normalized) items.push(normalized);
    return items;
}, []).slice(0, 4);

const hasGeneratedNarrative = Boolean(generatedArticle && generatedArticle.trim());
const hasSublimat = synthesisItems.length > 0;
const hasFactcheck = Boolean(verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0));
const hasStrongLeadNarrative = hasGeneratedNarrative && (cluster?.articles?.length || 0) >= 3;
const primaryNarrativeLabel = t('cluster.editorial_review');
const primaryNarrativeEyebrow = t('cluster.daily_context');
const primaryNarrativeNavLabel = t('cluster.nav_review');
const conflictsCount = verificationReport?.conflicts?.length || 0;
const agreementsCount = verificationReport?.agreements?.length || 0;
const trustSummary = cluster?.trust_summary || buildTrustChip({
    sourcesCount: uniqueSourcesCount,
    pluralismScore: cluster?.pluralism_score ?? null,
    isStale: isSynthesisRefreshStale,
    hasVerification: hasFactcheck,
    quietFreshness: isMissingSynthesis,
    isPendingSynthesis: isMissingSynthesis,
    isProvisional: isProvisionalSynthesis,
    needsUpgrade: isProvisionalSynthesis,
}, lang as 'sr' | 'mk');
const crossLingualCounterparts = cluster?.cross_lingual_counterparts || [];

const isFiniteMetric = (value: unknown) => Number.isFinite(typeof value === 'number' ? value : Number(value));
const rawToneAnalysis = cluster?.tone_analysis || cluster?.sentiment?.tone_analysis || null;
const hasToneAnalysis = Boolean(
    rawToneAnalysis &&
    (isFiniteMetric(rawToneAnalysis.objectivity) || isFiniteMetric(rawToneAnalysis.sensationalism) || isFiniteMetric(rawToneAnalysis.emotional_charge))
);
const sentimentData = hasToneAnalysis ? {
    sentiment: (cluster?.sentiment && 'sentiment' in cluster.sentiment ? cluster.sentiment.sentiment : cluster?.sentiment) || { score: 0, tone: 'neutralno' },
    tone_analysis: rawToneAnalysis
} : null;
const showCompareTab = allSourcesNames.length >= 2;
const showPulseTab = Boolean(
    sentimentData &&
    isFiniteMetric(sentimentData.tone_analysis?.objectivity) &&
    isFiniteMetric(sentimentData.tone_analysis?.sensationalism) &&
    isFiniteMetric(sentimentData.tone_analysis?.emotional_charge),
);

const firstArticle = cluster?.articles?.length
    ? [...cluster.articles].sort((left: Article, right: Article) => new Date(left.created_at).getTime() - new Date(right.created_at).getTime())[0]
    : null;
const latestArticle = cluster?.articles?.[0] || null;
const allRawEntities = [
    ...(cluster?.analyst_entities || []),
    ...(cluster?.entities || []),
    ...(cluster?.tags || []),
];
const sharedEntities = normalizeAndDeduplicateTags(allRawEntities, lang).slice(0, 4);

const keyEntities = normalizeAndDeduplicateTags(allRawEntities, lang)
    .filter((name: string) => name && name.trim().length >= 2)
    .slice(0, 5);
const primaryTopics = Array.from(new Set([
    ...(cluster?.topics || []),
    ...(cluster?.articles || []).map((article: Article) => article.topic).filter(Boolean),
])).slice(0, 3);
const primaryCategory = cluster?.articles?.[0]?.category || '';
const foldedClusterText = [
    displayHeadline,
    primaryCategory,
    ...primaryTopics,
    ...(cluster?.tags || []),
].join(' ').toLowerCase();
const isWeatherStory = /vreme|vrijeme|време|сончев|дожд|грмеж|температур|prognoz|прогноз|oblac|облач|sunčan|сунчан|kiš|киш/.test(foldedClusterText);
const isSportsStory = /sport|спорт|utakmic|натпревар|liga|лига|fudbal|фудбал|košark|кошарк|tenis|тенис/.test(foldedClusterText);
const topicLabelMap: Record<string, { sr: string; mk: string }> = {
    ekonomija: { sr: 'Ekonomija', mk: 'Економија' },
    kultura: { sr: 'Kultura', mk: 'Култура' },
    makedonija: { sr: 'Makedonija', mk: 'Македонија' },
    politika: { sr: 'Politika', mk: 'Политика' },
    region: { sr: 'Region', mk: 'Регион' },
    srbija: { sr: 'Srbija', mk: 'Србија' },
    sport: { sr: 'Sport', mk: 'Спорт' },
    svet: { sr: 'Svet', mk: 'Свет' },
    tehnologija: { sr: 'Tehnologija', mk: 'Технологија' },
    vesti: { sr: 'Vesti', mk: 'Вести' },
    zabava: { sr: 'Zabava', mk: 'Забава' },
    zdravje: { sr: 'Zdravlje', mk: 'Здравје' },
    zivot: { sr: 'Život', mk: 'Живот' },
    život: { sr: 'Život', mk: 'Живот' },
};
function cleanTopicLabel(value?: string) {
    const clean = cleanAndDecode(value || '').trim();
    if (!clean) return '';
    const mapped = topicLabelMap[clean.toLowerCase()];
    if (mapped) return lang === 'sr' ? mapped.sr : mapped.mk;
    return clean;
}
const storyKindLabel = (() => {
    if (isWeatherStory) return lang === 'sr' ? 'VREMENSKA PROGNOZA' : 'ВРЕМЕНСКА ПРОГНОЗА';
    if (isSportsStory) return lang === 'sr' ? 'SPORTSKI SIGNAL' : 'СПОРТСКИ СИГНАЛ';
    if (primaryCategory) return cleanTopicLabel(primaryCategory).toUpperCase();
    return lang === 'sr' ? 'TEMATSKI SIGNAL' : 'ТЕМАТСКИ СИГНАЛ';
})();
const displayTopicSignals = Array.from(new Set([
    ...(isWeatherStory ? [lang === 'sr' ? 'Vreme' : 'Време'] : []),
    ...primaryTopics
        .map((topic: string) => cleanTopicLabel(topic))
        .filter((topic: string) => topic && !['Vesti', 'Вести'].includes(topic)),
    cleanTopicLabel(primaryCategory),
])).filter(Boolean).slice(0, 3);
const hasConflicts = conflictsCount > 0;
const isSingleSource = uniqueSourcesCount <= 1;
const clusterLayoutInput = {
	hasGeneratedNarrative,
	synthesisFreshness,
	hasFactcheck,
	conflictsCount,
	pluralismScore: cluster?.pluralism_score ?? null,
	uniqueSourcesCount,
	leadVisualIsWeak: Boolean(leadVisual?.isWeak),
};
const showExecutiveSummary = shouldShowExecutiveSummary({
	...clusterLayoutInput,
	hasBriefItems: displayHeaderBriefItems.length > 0,
	hasKeyFacts: Boolean(cluster?.key_facts?.length),
});
const showKeyFactsBand = shouldShowKeyFactsBand({
	hasGeneratedNarrative,
	hasKeyFacts: Boolean(cluster?.key_facts?.length),
	showExecutiveSummary,
});
const showHeroVisual = shouldShowHeroVisual(clusterLayoutInput);
const showPerspectivesBlock = shouldShowPerspectives(clusterLayoutInput);
const showCredibilitySection = shouldShowCredibilitySection(clusterLayoutInput);
const consensusNote = shouldShowConsensusNote(clusterLayoutInput)
	? getConsensusNote(lang as 'sr' | 'mk')
	: null;
const clusterStatus = (() => {
    if (isMissingSynthesis) {
        return {
            label: lang === 'sr' ? 'SINTEZA U PRIPREMI' : 'СИНТЕЗАТА СЕ ПОДГОТВУВА',
            description: lang === 'sr'
                ? 'Izvori su povezani; urednički pregled se trenutno generiše.'
                : 'Изворите се поврзани; уредничкиот преглед моментално се генерира.',
            tone: 'pending',
        };
    }
    if (isSynthesisRefreshStale) {
        return {
            label: lang === 'sr' ? 'SINTEZA ZASTARELA' : 'СИНТЕЗАТА Е ЗАСТАРЕНА',
            description: lang === 'sr'
                ? 'Stigli su noviji izvori; pregled treba čitati uz izvorni zapis.'
                : 'Пристигнале понови извори; прегледот треба да се чита со изворниот запис.',
            tone: 'stale',
        };
    }
    if (isSingleSource) {
        return {
            label: lang === 'sr' ? 'JEDAN IZVOR' : 'ЕДЕН ИЗВОР',
            description: lang === 'sr'
                ? 'Klaster trenutno ima jednu redakciju; čitajte ga kao rani signal, ne kao potvrđen konsenzus.'
                : 'Кластерот моментално има една редакција; третирајте го како ран сигнал.',
            tone: 'early',
        };
    }
    if (hasConflicts) {
        return {
            label: lang === 'sr' ? 'VIŠE IZVORA, RAZLIKE' : 'ПОВЕЌЕ ИЗВОРИ, РАЗЛИКИ',
            description: lang === 'sr'
                ? 'Izvori pokrivaju istu priču, ali se razlikuju u detaljima ili naglasku.'
                : 'Изворите ја покриваат истата приказна, но се разликуваат во детали или нагласок.',
            tone: 'mixed',
        };
    }
    return {
        label: lang === 'sr' ? 'VIŠE IZVORA' : 'ПОВЕЌЕ ИЗВОРИ',
        description: isWeatherStory
            ? (lang === 'sr'
                ? 'Grupisano prema istoj prognozi, području i bliskom vremenu objave.'
                : 'Групирано според иста прогноза, подрачје и блиско време на објава.')
            : (lang === 'sr'
                ? 'Grupisano po zajedničkoj temi, akterima i bliskom vremenu objave.'
                : 'Групирано според заедничка тема, актери и блиско време на објава.'),
        tone: 'verified',
    };
})();

const evidenceItems = [
    {
        label: lang === 'sr' ? 'Redakcije' : 'Редакции',
        value: String(uniqueSourcesCount),
        detail: sourcePreview.join(' · '),
    },
    ...(cluster?.pluralism_score != null ? [{
        label: lang === 'sr' ? 'Indeks Pluralizma' : 'Индекс на Плурализам',
        value: `${cluster.pluralism_score}%`,
        detail: cluster.narrative_diversity?.verdict
            ? `“${(lang === 'mk' && !isMostlyCyrillic(cluster.narrative_diversity.verdict)
                ? transliterate(cluster.narrative_diversity.verdict)
                : cluster.narrative_diversity.verdict).slice(0, 60)}...”`
            : (lang === 'sr' ? 'Raznolikost perspektiva' : 'Разновидност на перспективи'),
    }] : []),
    {
        label: lang === 'sr' ? 'Prva objava' : 'Прва објава',
        value: firstArticle?.source || '—',
        detail: firstArticle?.created_at ? getRelativeTimeStr(firstArticle.created_at) : '',
    },
    {
        label: lang === 'sr' ? 'Poslednji razvoj' : 'Последен развој',
        value: latestArticle?.source || '—',
        detail: latestArticle?.created_at ? getRelativeTimeStr(latestArticle.created_at) : '',
    },
    {
        label: lang === 'sr' ? 'Ključne oznake' : 'Клучни ознаки',
        value: sharedEntities.length && !isWeatherStory ? sharedEntities.slice(0, 2).join(', ') : (displayTopicSignals[0] || '—'),
        detail: displayTopicSignals.slice(sharedEntities.length && !isWeatherStory ? 0 : 1).join(' · '),
    },
].filter((item) => item.value && item.value !== '—');

const describeRelatedEvidence = (rel: any) => {
    const pieces = [
        ...(rel.shared_entities || []).slice(0, 2),
        ...(rel.shared_topics || []).slice(0, 2),
        ...(rel.shared_tags || []).slice(0, 2),
    ].filter(Boolean);
    if (pieces.length) return pieces.join(' · ');
    return rel.relationship_note || '';
};

// --- Momentum Kicker Logic ---
const totalSourcesCount = cluster?.articles?.length || 0;
const isBreakingFlag = cluster?.articles?.some((a: Article) => a.is_breaking) || false;

let momentumKicker = { label: lang === 'sr' ? 'REDAKCIJSKI UVID' : 'УРЕДНИЧКИ УВИД', color: 'text-muted-foreground' };
if (isBreakingFlag && totalSourcesCount >= 4) {
    momentumKicker = { label: lang === 'sr' ? 'UDAREN NARATIV' : 'УДАРЕН НАРАТИВ', color: 'text-nyt-red' };
} else if (conflictsCount >= 3) {
    momentumKicker = { label: lang === 'sr' ? 'KONTRADIKTOREN RAZVOJ' : 'КОНТРАДИКТОРЕН РАЗВОЈ', color: 'cluster-tone-watch' };
} else if (totalSourcesCount >= 6) {
    momentumKicker = { label: lang === 'sr' ? 'ŠIROK INTERES' : 'ШИРОК ИНТЕРЕС', color: 'cluster-tone-positive' };
} else if (totalSourcesCount >= 2 && !isSynthesisRefreshStale && !isMissingSynthesis) {
    momentumKicker = { label: lang === 'sr' ? 'KONSOLIDOVAN PREGLED' : 'КОНСОЛИДИРАН ПРЕГЛЕД', color: 'text-nyt-accent' };
}

// --- SEO & Schema ---
// Prefer a high-res representative image or the lead article visual for social sharing.
// Generated SVG is used only as a last resort fallback.
const socialImageUrl = cluster?.representative_image || (leadVisual && !leadVisual.isWeak ? leadVisual.rawUrl : imageUrl);
const schemaArticleBody = stripCitationMarkers(
	cluster?.generated_article || cluster?.synthesis || displayHeadline || ''
);

const articleSchema = cluster ? {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": displayHeadline,
	"description": cluster.generated_article?.slice(0, 200) || cluster.synthesis?.slice(0, 200) || displayHeadline,
	"image": [
		cluster.representative_image || (leadVisual?.rawUrl?.startsWith('http') ? leadVisual.rawUrl : imageUrl)
	],
	"datePublished": cluster.articles?.[cluster.articles.length - 1]?.created_at,
	"dateModified": cluster.synthesis_updated_at || cluster.articles?.[0]?.created_at,
	"author": {
		"@type": "Organization",
		"name": lang === 'sr' ? "PRESEK.rs" : "PRESEK.mk",
		"url": SITE_URL
	},
	"publisher": {
		"@type": "Organization",
		"name": lang === 'sr' ? "PRESEK.rs" : "PRESEK.mk",
		"logo": {
			"@type": "ImageObject",
			"url": `${SITE_URL}/img/presek_emblem.svg`,
			"width": 512,
			"height": 512
		}
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": canonicalUrl
	},
	"articleSection": cluster.articles?.[0]?.category || t('news.section_default'),
	"articleBody": schemaArticleBody,
	"speakable": {
		"@type": "SpeakableSpecification",
		"xpath": [
			"/html/head/title",
			"/html/head/meta[@name='description']/@content"
		]
	},
	"isAccessibleForFree": true,
	"copyrightYear": new Date().getFullYear(),
	"copyrightHolder": {
		"@type": "Organization",
		"name": lang === 'sr' ? "PRESEK.rs" : "PRESEK.mk"
	}
} : null;
---

<Layout
	title={displayHeadline}
	description={cluster?.generated_article?.slice(0, 160) || cluster?.synthesis?.slice(0, 160) || shareDescription}
	image={socialImageUrl || undefined}
	type="article"
	canonical={canonicalUrl}
	schema={articleSchema || undefined}
>
	<NYTHeader topic={cluster?.topics?.[0]} />

	<ReaderTracker
        clusterId={id || ''}
        title={displayHeadline}
        category={cluster?.articles?.[0]?.category}
        topic={cluster?.topics?.[0]}
        primarySource={cluster?.articles?.[0]?.source}
        sources={allSourcesNames}
        tags={cluster?.tags}
        client:idle
    />

	<ZenReadingContext headline={displayHeadline} lang={lang} client:idle />
	<ClusterMobileFocusIsland lang={lang} client:idle />

	<main class="site-layout py-0">
		<div class="scroll-progress-container">
			<div class="scroll-progress-bar" id="reading-progress"></div>
		</div>

		<div class="editorial-container max-w-[1440px] mx-auto px-2 sm:px-4 md:px-10">
		<Breadcrumbs items={[
			{ label: cleanTopicLabel(cluster?.articles?.[0]?.category) || t('home.feed_title'), href: cluster?.articles?.[0]?.category ? `/?category=${cluster.articles[0].category}` : '/' },
			{ label: cleanTopicLabel(adjacentTopic) || t('cluster.details') }
		]} />

		{error ? (
			<div class="py-20 text-center">
				<h1 class="text-2xl font-serif mb-4">{error}</h1>
                <a href="/" class="text-nyt-accent hover:underline">{lang === 'sr' ? 'Nazad na početnu' : 'Назад на почетна'}</a>
			</div>
		) : cluster && (
			<article class="cluster-article-container" style={cluster.dominant_color ? `--cluster-accent: ${cluster.dominant_color};` : ''}>
				<ClusterEditorialHeader
					lang={lang as 'sr' | 'mk'}
					cluster={cluster}
					displayHeadline={displayHeadline}
					headlineIsCyrillic={headlineIsCyrillic}
					clusterStatus={clusterStatus}
					uniqueSourcesCount={uniqueSourcesCount}
					newsroomCountLabel={newsroomCountLabel}
					newsroomOverviewLabel={newsroomOverviewLabel}
					evidenceItems={evidenceItems}
					synthesisUpdatedAt={synthesisUpdatedAt}
					synthesisFreshness={synthesisFreshness}
					latestArticle={latestArticle}
					isSynthesisRefreshStale={isSynthesisRefreshStale}
					isMissingSynthesis={isMissingSynthesis}
					pipelineBusy={pipelineBusy}
					primaryNarrativeLabel={primaryNarrativeLabel}
					primaryNarrativeNavLabel={primaryNarrativeNavLabel}
					showKeyFactsBand={showKeyFactsBand}
					showCredibilitySection={showCredibilitySection}
					cleanTopicLabel={cleanTopicLabel}
					canonicalUrl={canonicalUrl}
					t={translate}
				/>

					{showHeroVisual && (
					<div class="hero-full mb-24" id="cluster-visual">
						<HeroVisual
							leadVisual={leadVisual}
							dominantColor={cluster.dominant_color || undefined}
							displayHeadline={displayHeadline}
							id={id || ''}
							category={cleanTopicLabel(cluster.articles?.[0].category)}
							sourcePreview={sourcePreview}
							articlesCount={cluster.articles?.length || 0}
						/>
					</div>
					)}

						{/* EXECUTIVE SUMMARY / BRIFING - only when synthesis is missing or stale */}
						{showExecutiveSummary && (
							<ClusterExecutiveSummary
								lang={lang as 'sr' | 'mk'}
								displayHeaderBriefItems={displayHeaderBriefItems}
								keyFacts={cluster.key_facts}
								t={translate}
							/>
						)}

						<p class="compare-mode-banner" role="status">{t('reading.compare_hint')}</p>

						<div class="editorial-grid">
						{/* 3. MAIN COLUMN */}
						<div class="editorial-main-col">

							{showKeyFactsBand && cluster.key_facts && (
								<ClusterKeyFactsBand facts={cluster.key_facts} lang={lang as 'sr' | 'mk'} />
							)}

							<TrustBlock
								lang={lang as 'sr' | 'mk'}
								trustLabel={trustSummary.label}
								trustDetail={trustSummary.detail}
								trustScore={trustSummary.score}
								evidenceItems={evidenceItems}
								conflictsCount={conflictsCount}
								agreementsCount={agreementsCount}
							/>

							<ClusterSynthesisSection
								lang={lang as 'sr' | 'mk'}
								clusterId={id || ''}
								primaryNarrativeLabel={primaryNarrativeLabel}
								primaryNarrativeEyebrow={primaryNarrativeEyebrow}
								hasGeneratedNarrative={hasGeneratedNarrative}
								hasStrongLeadNarrative={hasStrongLeadNarrative}
								generatedArticle={generatedArticle ?? ''}
								synthesisItems={synthesisItems}
								hasCitationSources={hasCitationSources}
								entities={cluster.entities}
								uniqueSourcesCount={uniqueSourcesCount}
								synthesisFreshness={synthesisFreshness}
								isProvisional={isProvisionalSynthesis}
								isPageLead={!showHeroVisual}
							/>

							{hasCitationSources && (
								<CitationSources citationSources={citationSources} lang={lang} />
							)}

						<ClusterSourcesSection
							lang={lang as 'sr' | 'mk'}
							sourceDocArticle={sourceDocArticle}
							sourceDocText={sourceDocText}
							articleRows={articleRows}
							t={translate}
						/>

						{showCredibilitySection && (
							<ClusterAnalysisSection lang={lang as 'sr' | 'mk'}>
								<CredibilityAnalysis
									hasFactcheck={hasFactcheck}
									verificationReport={verificationReport}
									perspectives={perspectives}
									hasCitationSources={hasCitationSources}
									showPerspectives={showPerspectivesBlock}
									consensusNote={consensusNote}
									pluralismScore={cluster?.pluralism_score}
									toneAnalysis={sentimentData?.tone_analysis}
								/>
							</ClusterAnalysisSection>
						)}

						<TinyAdzInlinedAd class="cluster-inlined-ad mb-12" />

						{/* RELATED SECTION */}
						{crossLingualCounterparts.length > 0 && (
							<CrossLingualStrip
								counterparts={crossLingualCounterparts}
								lang={lang as 'sr' | 'mk'}
								hostHeader={hostHeader}
							/>
						)}

						{filteredRelated.length > 0 && (
							<ClusterRelatedSection
								lang={lang as 'sr' | 'mk'}
								filteredRelated={filteredRelated}
								getRelativeTimeStr={getRelativeTimeStr}
								describeRelatedEvidence={describeRelatedEvidence}
								t={translate}
							/>
						)}
                        <ClusterDeepTools
                          clusterId={id || ''}
                          apiUrl={API_URL}
                          lang={lang}
                          t={translate}
                          keyFacts={cluster.key_facts || []}
                          perspectives={perspectives}
                          synthesisBullets={synthesisItems.map((item) => item.content)}
                          generatedArticle={generatedArticle}
                        />

					</div>

					{/* 4. SIDEBAR COLUMN */}
					<aside class="editorial-sidebar-col">
						<div class="sticky-sidebar cluster-sidebar-stack">
							<ClusterSidebarTabs
								client:visible
								lang={lang}
								articles={cluster.articles.map((a: Article) => ({ source: a.source }))}
								allSourcesNames={allSourcesNames}
								sentimentData={sentimentData}
								showCompare={showCompareTab}
								showPulse={showPulseTab}
								topic={cluster.topics?.[0] || ''}
								source={cluster.articles?.[0]?.source || ''}
								adjacentTopic={adjacentTopic}
								keyEntities={keyEntities}
							/>
							<div class="sidebar-module sidebar-ad-slot">
								<TinyAdzRailAd />
							</div>
						</div>
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>


<script is:inline>
	(() => {
		const syncReadingModeEarly = () => {
			try {
				const article = document.querySelector('.cluster-article-container');
				if (!article) return;
				const params = new URLSearchParams(window.location.search);
				const stored = localStorage.getItem('reading-mode');
				const legacy = localStorage.getItem('readerMode');
				const focus =
					stored === 'focus' ||
					stored === 'zen' ||
					(!stored && legacy === 'true') ||
					params.get('reader') === '1';
				const compare = stored === 'compare';
				const sidebarDetails = document.querySelector('.cluster-sidebar-details');
				document.body.classList.remove('zen-mode', 'compare-mode', 'reader-mode-active');
				article.classList.remove('reader-focused');
				if (sidebarDetails instanceof HTMLDetailsElement) {
					sidebarDetails.open = false;
				}
				if (focus) {
					document.body.classList.add('zen-mode', 'reader-mode-active');
					article.classList.add('reader-focused');
				} else if (compare) {
					document.body.classList.add('compare-mode');
					if (sidebarDetails instanceof HTMLDetailsElement) {
						sidebarDetails.open = true;
					}
				}
			} catch (e) {}
		};

		const initReadingProgress = () => {
			syncReadingModeEarly();
			const progress = document.getElementById('reading-progress');
			if (!progress) return;
			if (progress.dataset.bound === 'true') return;
			progress.dataset.bound = 'true';

			const updateProgress = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
				progress.style.width = `${pct}%`;
			};
			window.addEventListener('scroll', updateProgress, { passive: true });
			updateProgress();
		};

		initReadingProgress();
		document.addEventListener('astro:page-load', initReadingProgress);
		setTimeout(initReadingProgress, 500);
	})();
</script>
