---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import AskPresekIsland from '../../components/AskPresekIsland.tsx';
import StoryTimeline from '../../components/StoryTimeline.tsx';
import MediaPulseRadar from '../../components/MediaPulseRadar.tsx';
import ClusterFollowSuggestionsIsland from '../../components/ClusterFollowSuggestionsIsland.tsx';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import ShareIsland from '../../components/ShareIsland.tsx';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { chooseClusterImage } from '../../utils/imageSelection';
import { cleanAndDecode } from '../../utils/textUtils';
import { Clock, ArrowLeft, Newspaper, Sparkles, MessageCircle, Link2, Zap } from 'lucide-react';
import { apiBaseUrl } from '../../lib/apiBase';

const { id } = Astro.params;
const API_URL = apiBaseUrl();
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://presek.live").replace(/\/+$/, "");
const cleanPath = Astro.url?.pathname === "/" ? "" : Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${cleanPath}`;

let cluster = null;
let error = null;

try {
	const res = await fetch(`${API_URL}/cluster/${id}`);
	if (res.ok) {
		const data = await res.json();
		cluster = data.data;
	} else {
		error = "Кластерот не е пронајден.";
	}
} catch (e) {
	console.error(e);
	error = "Грешка при вчитување на податоците.";
}

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function getRelativeTimeStr(dateStr: string) {
	try {
		const date = new Date(dateStr);
		const diffMs = Date.now() - date.getTime();
		const diffMinutes = Math.max(1, Math.round(diffMs / 60000));
		if (diffMinutes < 60) return `пред ${diffMinutes} мин`;
		const diffHours = Math.round(diffMinutes / 60);
		if (diffHours < 24) return `пред ${diffHours} ч`;
		const diffDays = Math.round(diffHours / 24);
		return `пред ${diffDays} д`;
	} catch {
		return '';
	}
}

function topicHref(value: string) {
	const normalized = String(value || '').trim();
	return normalized ? `/tema/${encodeURIComponent(normalized)}` : '/';
}

function looksMacedonianHeadline(text: string) {
	const value = String(text || '').trim();
	if (!value) return false;

	let cyrillic = 0;
	let latin = 0;
	for (const ch of value) {
		if (ch >= '\u0400' && ch <= '\u04FF') cyrillic += 1;
		else if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')) latin += 1;
	}

	if (cyrillic < 8) return false;
	if (latin === 0) return true;
	return cyrillic >= latin * 2;
}

function getPreferredClusterHeadline(articles: any[]) {
	let fallback = '';
	let preferredMacedonian = '';

	for (const article of articles || []) {
		const title = cleanAndDecode(article?.title || '');
		if (!title) continue;
		if (!fallback) fallback = title;

		const originalTitle = cleanAndDecode(article?.original_title || '');
		const isTranslated = Boolean(article?.is_translated) || Boolean(originalTitle && title !== originalTitle);

		if (isTranslated && looksMacedonianHeadline(title)) {
			return title;
		}
		if (!preferredMacedonian && looksMacedonianHeadline(title)) {
			preferredMacedonian = title;
		}
	}

	return preferredMacedonian || fallback;
}

function titleTerms(text: string) {
	return Array.from(
		new Set(
			(text || '')
				.toLowerCase()
				.match(/[a-zа-ш0-9]{3,}/g)?.filter(
					(token) => !['вест', 'вести', 'извор', 'извори', 'денес', 'утре', 'вчера'].includes(token)
				) || []
		)
	);
}

function getRelationshipMeta(title: string, leadTitle: string, index: number) {
	if (index === 0) {
		return {
			label: 'Водечки извор',
			tone: 'lead',
			description: 'Најдиректна и најцелосна верзија на главниот развој.',
		};
	}

	const leadTerms = titleTerms(leadTitle);
	const currentTerms = titleTerms(title);
	const overlapCount = currentTerms.filter((token) => leadTerms.includes(token)).length;
	const overlap = overlapCount / Math.max(Math.min(leadTerms.length, currentTerms.length), 1);

	if (overlap >= 0.5) {
		return {
			label: 'Го потврдува главниот развој',
			tone: 'confirm',
			description: 'Носи слична главна линија како водечкиот извор.',
		};
	}

	if (overlap >= 0.24) {
		return {
			label: 'Додава контекст',
			tone: 'context',
			description: 'Ја проширува приказната со дополнителни детали или реакција.',
		};
	}

	return {
		label: 'Различен агол',
		tone: 'contrast',
		description: 'Го осветлува настанот од друг аспект или со поинаков акцент.',
	};
}

function parseSynthesis(text: string) {
    if (!text) return [];
    const normalized = text
        .replace(/^Статии:\s*/i, '')
        .replace(/\r/g, '')
        .trim();

    const lines = normalized
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean)
        .filter((line) => line.toLowerCase() !== 'статии:');

    const items = [];
    let current = '';

    for (const line of lines) {
        const isBullet = /^[-•]\s+/.test(line) || /^\[[^\]]+\]:/.test(line);
        if (isBullet) {
            if (current) items.push(current.trim());
            current = line.replace(/^[-•]\s+/, '');
        } else if (current) {
            current += ` ${line}`;
        } else {
            current = line;
        }
    }
    if (current) items.push(current.trim());

    return items
        .map((item) => {
            const sourceMatch = item.match(/^\[(.*?)\]:\s*(.*)$/s);
            if (sourceMatch) {
                return {
                    source: sourceMatch[1],
                    content: cleanAndDecode(sourceMatch[2].trim()),
                };
            }
            return { source: null, content: cleanAndDecode(item.trim()) };
        })
        .filter((item) => item.content && item.content.toLowerCase() !== 'статии:');
}

function normalizePerspectives(items: any[]) {
    if (!Array.isArray(items)) return [];

    return items
        .map((item) => {
            if (typeof item === 'string') {
                const content = cleanAndDecode(item.trim());
                return content ? { angle: 'Перспектива', content } : null;
            }

            if (!item || typeof item !== 'object') return null;

            const angle = String(
                item.angle ?? item.label ?? item.title ?? item.name ?? 'Перспектива'
            ).trim();
            const content = cleanAndDecode(String(
                item.content ?? item.text ?? item.description ?? ''
            ).trim());

            if (!content) return null;
            return { angle: angle || 'Перспектива', content };
        })
        .filter(Boolean);
}

const perspectives = cluster ? normalizePerspectives(cluster.perspectives) : [];
function extractSafeText(text?: string) {
	if (!text) return '';
	const trimmed = text.trim();
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) return cleanAndDecode(parsed.summary);
				if (parsed.text) return cleanAndDecode(parsed.text);
			}
		} catch (e) {}
	}
	return cleanAndDecode(text);
}

const synthesisItems = cluster?.synthesis ? parseSynthesis(cluster.synthesis) : [];
const leadArticle = cluster?.articles?.[0];
const articleRows = cluster
	? cluster.articles.map((article: any, index: number) => ({
			...article,
			title: cleanAndDecode(article.title),
			description: cleanAndDecode(article.description),
			relationship: getRelationshipMeta(article.title, leadArticle?.title || article.title, index),
			sourceSignal: article.source_signal || null,
			exactTime: getTimeStr(article.created_at),
			relativeTime: getRelativeTimeStr(article.created_at),
	  }))
	: [];
const confirmRows = articleRows.filter((article: any) => article.relationship?.tone === 'confirm');
const contextRows = articleRows.filter((article: any) => article.relationship?.tone === 'context');
const contrastRows = articleRows.filter((article: any) => article.relationship?.tone === 'contrast');
const comparisonHighlights = [
	{
		label: 'Заедничка линија',
		value: confirmRows.length > 0 ? `${confirmRows.length + 1} извори` : `${articleRows.length} извори`,
		copy:
			confirmRows.length > 0
				? `Главниот развој најјасно се повторува кај ${[leadArticle?.source, ...confirmRows.slice(0, 2).map((item: any) => item.source)].filter(Boolean).join(' · ')}.`
				: 'Изворите во кластерот главно ја следат истата основна линија.',
	},
	{
		label: 'Нов агол',
		value: contrastRows.length > 0 ? `${contrastRows.length} извори` : contextRows.length > 0 ? `${contextRows.length} извори` : 'Слична рамка',
		copy:
			contrastRows.length > 0
				? `${contrastRows.slice(0, 2).map((item: any) => item.source).join(' · ')} носат поинаков акцент или отвораат друг аспект.`
				: contextRows.length > 0
				? `${contextRows.slice(0, 2).map((item: any) => item.source).join(' · ')} додаваат дополнителен контекст и реакција.`
				: 'Во овој кластер засега нема силно издвоен спротивен агол.',
	},
	{
		label: 'Почни со',
		value: articleRows[0]?.source || 'Водечки извор',
		copy: articleRows[0]?.sourceSignal?.role_note || articleRows[0]?.relationship?.description || 'Прво прочитајте го водечкиот извор, па потоа споредете ги другите верзии.',
	},
];
const suggestedQuestions = [
	'Што е најважното ново во оваа вест?',
	'Како се разликуваат изворите во известувањето?',
	'Што останува нејасно или непотврдено?',
];
const leadDescription = extractSafeText(cluster?.articles?.find((article: any) => article?.description?.trim())?.description);
const sourcePreview = cluster?.articles?.slice(0, 3).map((article: any) => article.source).filter(Boolean) || [];

const ai_summary_bullets = cluster?.ai_summary_bullets || [];
const generatedArticle = cluster?.generated_article || '';
const firstReporter = cluster?.first_reporter || null;
const verificationReport = cluster?.verification_report || null;

const synthesisUpdatedAt = cluster?.synthesis_updated_at || '';
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false, new_article_count: 0, reasons: [] };
const adjacentTopic =
	cluster?.related?.find((item: any) => item?.shared_topics?.length)?.shared_topics?.[0] ||
	cluster?.related?.find((item: any) => item?.shared_tags?.length)?.shared_tags?.[0] ||
	'';
const shareDescription = (
	extractSafeText(cluster?.synthesis) ||
	leadDescription ||
	`Овој кластер спојува ${cluster?.articles?.length || 0} извори за да ги покаже заедничките факти, разликите во акцентот и што останува неразјаснето.`
).replace(/\s+/g, ' ').trim().slice(0, 220);
const shareImage = cluster ? `/og/cluster/${cluster.cluster_id}.svg?v=1` : '/og-image.svg';
const imageUrl = /^https?:\/\//i.test(shareImage) ? shareImage : `${siteUrl}${shareImage.startsWith("/") ? shareImage : `/${shareImage}`}`;

const GENERIC_TAGS = ['ВИДЕО', 'ВЕСТИ', 'ФОТО', 'МАКЕДОНИЈА', 'СВЕТ', 'СПОРТ'];

const filteredRelated = (cluster?.related || []).filter((rel: any) => {
	// If it shares entities, it's likely relevant
	if (rel.shared_entities && rel.shared_entities.length > 0) return true;
	
	// If it only shares tags, ensure they aren't all generic
	if (rel.shared_tags && rel.shared_tags.length > 0) {
		const nonGenericTags = rel.shared_tags.filter((tag: string) => !GENERIC_TAGS.includes(tag.toUpperCase()));
		return nonGenericTags.length > 0;
	}
	
	return true; // Keep if no shared info provided (fallback)
});

function getLeadVisual(clusterData: any) {
	const selected = chooseClusterImage(clusterData, 'hero');
	if (!selected.proxiedUrl) return null;

	return {
		src: selected.proxiedUrl,
		rawUrl: selected.rawUrl,
		isWeak: selected.isWeak,
	};
}

const leadVisual = cluster ? getLeadVisual(cluster) : null;
const displayHeadline = cluster ? getPreferredClusterHeadline(cluster.articles) : '';

// JSON-LD Schema for Google News / AdSense
const schema = cluster ? {
	"@context": "https://schema.org",
	"@type": "AnalysisNewsArticle",
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": canonicalUrl
	},
	"headline": displayHeadline,
	"description": cleanAndDecode(shareDescription),
	"image": imageUrl,
	"datePublished": cluster.articles[0].created_at,
	"dateModified": synthesisUpdatedAt || cluster.articles[0].created_at,
	"author": {
		"@type": "Organization",
		"name": "Пресек",
		"url": siteUrl
	},
	"publisher": {
		"@type": "Organization",
		"name": "Пресек",
		"logo": {
			"@type": "ImageObject",
			"url": `${siteUrl}/static/img/presek_emblem.png`
		}
	},
	"articleBody": generatedArticle || extractSafeText(cluster.synthesis),
	"about": cluster.tags?.map((tag: string) => ({
		"@type": "Thing",
		"name": tag
	})) || [],
	"mentions": cluster.articles.map((a: any) => ({
		"@type": "NewsArticle",
		"headline": cleanAndDecode(a.title),
		"publisher": {
			"@type": "Organization",
			"name": a.source
		},
		"url": a.link
	}))
} : null;
---

<Layout
	title={cluster ? displayHeadline : "Детали за вест"}
	description={cluster ? cleanAndDecode(shareDescription) : "Детали за вест од Пресек"}
	image={shareImage}
	type={cluster ? "article" : "website"}
	schema={schema}
>
    <NYTHeader />

	<main class="site-layout py-12">
		{error && (
			<div class="py-20 text-center">
				<h2 class="font-serif text-2xl font-black text-nyt-red mb-4">{error}</h2>
				<a href="/" class="nyt-section-label hover:underline">← Назад кон почетна</a>
			</div>
		)}

		{cluster && (
			<article class="cluster-shell">
				<ReaderTracker
					client:load
					clusterId={cluster.cluster_id}
					title={displayHeadline}
					category={cluster.articles[0].category || ''}
					topic={cluster.topics?.[0] || cluster.articles[0].topic || ''}
					primarySource={cluster.articles[0].source || ''}
					sources={cluster.articles.map((article: any) => article.source).filter(Boolean)}
					tags={cluster.tags || []}
				/>
				<header class="cluster-header motion-rise">
					<div class="cluster-header-grid">
						<div class="cluster-header-copy">
							<Breadcrumbs items={[
								{ label: cluster.articles[0].category || "Вести", href: topicHref(cluster.articles[0].category || "Вести") },
								{ label: "Детали за вест" }
							]} />

							<h1 class="cluster-headline" set:html={displayHeadline}>
							</h1>

							{leadDescription && <p class="cluster-dek" set:html={cleanAndDecode(leadDescription)}></p>}

							<div class="cluster-header-meta">
								<span class="flex items-center gap-1"><Clock size={12}/> {getTimeStr(cluster.articles[0].created_at)}</span>
								{firstReporter && (
									<>
										<span>·</span>
										<span class="flex items-center gap-1">
											<Zap size={12} className="text-nyt-red fill-nyt-red" /> 
											<span class="text-nyt-red font-black">ПРВ ОБЈАВИ:</span> {firstReporter.source} 
											<span class="opacity-60">({getTimeStr(firstReporter.created_at)})</span>
										</span>
									</>
								)}
								<span>·</span>
								<span class="flex items-center gap-1"><Newspaper size={12}/> {cluster.articles.length} извори</span>
								<span>·</span>
								<span class="flex items-center gap-1"><Sparkles size={12}/> {cluster.total_reading_time} мин. за преглед</span>
								<span>·</span>
								<ShareIsland
									client:load
									title={displayHeadline}
									url={canonicalUrl}
								/>
								{synthesisUpdatedAt && (
									<>
										<span>·</span>
										<span class:list={["cluster-refresh-badge", synthesisFreshness.is_stale ? "is-stale" : "is-fresh"]}>
											{synthesisFreshness.is_stale
												? "Ново известување по синтезата"
												: `Синтеза ажурирана ${getRelativeTimeStr(synthesisUpdatedAt)}`}
										</span>
									</>
								)}
							</div>
							<div class="cluster-preference-actions">
								<PreferenceToggle client:load kind="topic" value={cluster.topics?.[0] || cluster.articles[0].topic || cluster.articles[0].category || ''} label="ја темата" />
							</div>
						</div>

						<div class="cluster-header-side">
							{leadVisual && leadVisual.rawUrl && (
								<div class:list={["cluster-visual-card", leadVisual.isWeak ? "is-weak" : ""]}>
									{leadVisual.isWeak ? (
										<div class="cluster-visual-fallback">
											<p class="cluster-visual-kicker">Пресек Преглед</p>
											<h2>{cluster.articles[0].category || 'Главна Приказна'}</h2>
											<p>{cluster.articles.length} извори · {sourcePreview.slice(0, 2).join(' · ')}</p>
										</div>
									) : (
										<img
											src={leadVisual.src}
											alt={cleanAndDecode(cluster.articles[0].title)}
											class="cluster-visual-image"
											loading="eager"
											onload="this.classList.add('is-loaded')"
										/>
									)}
								</div>
							)}
							{ai_summary_bullets.length > 0 && !cluster.synthesis && (
								<div class="cluster-summary-card">
									<p class="cluster-summary-label">Во кратки црти</p>
									<div class="cluster-summary-copy">
										{ai_summary_bullets.map((line: string) => (
											<p class="mb-2 last:mb-0" set:html={cleanAndDecode(line)}></p>
										))}
									</div>
									{sourcePreview.length > 0 && (
										<p class="cluster-summary-sources">
											<span>Извори:</span> {sourcePreview.join(' · ')}
										</p>
									)}
									{synthesisUpdatedAt && (
										<p class:list={["cluster-summary-update", synthesisFreshness.is_stale ? "is-stale" : ""]}>
											{synthesisFreshness.is_stale
												? `${synthesisFreshness.new_article_count || 1} нови извештаи се појавиле по последната синтеза.`
												: `Последна синтеза: ${getRelativeTimeStr(synthesisUpdatedAt)}.`}
										</p>
									)}
								</div>
							)}
						</div>
					</div>
				</header>

				<div class="cluster-grid">
					<div class="cluster-main motion-rise motion-delay-1">
						{/* Lead Article Section */}
						{generatedArticle ? (
							<section class="cluster-article-hero">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ВОДЕЧКА СТОРИЈА</h2>
								</div>
								<div class="prose-nyt text-xl leading-relaxed text-foreground font-serif">
									{generatedArticle.split('\n').filter(p => p.trim()).map((paragraph, idx) => (
										<p class:list={["mb-6 last:mb-0", idx === 0 ? "drop-cap" : ""]}>
											{paragraph}
										</p>
									))}
								</div>
								<div class="h-px bg-nyt-gray-300 my-10" />
							</section>
						) : cluster.synthesis && (
							<section class="cluster-synthesis">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ПРЕСЕК СУБЛИМАТ</h2>
								</div>
								<div class="prose-nyt text-lg leading-relaxed text-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-4">
										{synthesisItems.map(item => (
											<li class="flex gap-3 items-start">
												<span class="text-nyt-accent font-black mt-1">●</span>
												<span>
													{item.source && <strong class="nyt-section-label text-[10px] mr-2 text-nyt-accent">[{item.source}]</strong>}
													<span set:html={item.content}></span>
												</span>
											</li>
										))}
									</ul>
								</div>
								<div class="h-px bg-nyt-gray-300 my-10" />
							</section>
						)}

						{/* Secondary Synthesis (Bullets if article exists) */}
						{generatedArticle && cluster.synthesis && synthesisItems.length > 0 && (
							<section class="cluster-synthesis mb-12">
								<div class="cluster-module-head">
									<h2 class="nyt-section-label tracking-[0.2em]">КЛУЧНИ ТОЧКИ</h2>
								</div>
								<div class="prose-nyt text-base leading-relaxed text-secondary-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-3">
										{synthesisItems.map(item => (
											<li class="flex gap-3 items-start border-b border-border/50 pb-3 last:border-0">
												<span class="text-nyt-accent font-black mt-0.5">●</span>
												<span set:html={item.content}></span>
											</li>
										))}
									</ul>
								</div>
							</section>
						)}
						{/* Perspectives */}
						{perspectives.length > 0 && (
							<section class="cluster-synthesis cluster-perspectives">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">РАЗЛИЧНИ ПЕРСПЕКТИВИ</h2>
								</div>
								<div class="perspective-grid">
									{perspectives.map((p: any) => (
										<div class="perspective-card">
											<h3 set:html={p.angle}></h3>
											<p set:html={p.content}></p>
										</div>
									))}
								</div>
							</section>
						)}

						{/* Media Comparison / Fact Check */}
						{verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0) && (
							<section class="cluster-module cluster-factcheck">
								<div class="cluster-module-head">
									<Newspaper size={18} className="text-foreground" />
									<h2 class="nyt-section-label tracking-[0.2em]">МЕДИУМСКА СПОРЕДБА</h2>
								</div>
								
								<div class="factcheck-grid">
									{verificationReport.agreements?.length > 0 && (
										<div class="factcheck-box factcheck-agreements">
											<h3>Потврдени факти</h3>
											<ul>
												{verificationReport.agreements.map((item: string) => (
													<li set:html={cleanAndDecode(item)}></li>
												))}
											</ul>
										</div>
									)}
									
									{verificationReport.conflicts?.length > 0 && (
										<div class="factcheck-box factcheck-conflicts">
											<h3>Разлики во известувањето</h3>
											<ul>
												{verificationReport.conflicts.map((item: string) => (
													<li set:html={cleanAndDecode(item)}></li>
												))}
											</ul>
										</div>
									)}
								</div>

								{verificationReport.context && typeof verificationReport.context === 'string' && (
									<div class="factcheck-footer">
										<p><strong>Контекст:</strong> <span set:html={cleanAndDecode(verificationReport.context)}></span></p>
									</div>
								)}
							</section>
						)}

						{/* Timeline */}
						{cluster.timeline && cluster.timeline.length > 1 && (
							<StoryTimeline timeline={cluster.timeline} />
						)}

						{/* Media Pulse / Sentiment */}
						{cluster.sentiment && (
							<MediaPulseRadar data={cluster.sentiment} />
						)}


												{/* Articles List */}

						<section class="cluster-module">
							<div class="cluster-module-head">
								<Newspaper size={18} className="text-foreground" />
								<h2 class="nyt-section-label tracking-[0.2em]">КАКО ДА ГО ЧИТАТЕ КЛАСТЕРОТ</h2>
							</div>
							<div class="comparison-digest">
								{comparisonHighlights.map((item) => (
									<div class="comparison-digest-card">
										<p class="comparison-digest-label">{item.label}</p>
										<p class="comparison-digest-value">{item.value}</p>
										<p class="comparison-digest-copy">{item.copy}</p>
									</div>
								))}
							</div>
							<h2 class="cluster-section-title">Сите Извори</h2>
							<div class="article-list">
								{articleRows.map((a: any) => (
									<div class={`article-row article-row-${a.relationship.tone} group`}>
										<div class="article-row-top">
											<div class="article-row-source">
												<span class="nyt-section-label text-nyt-red">{a.source}</span>
												<span class={`article-row-badge article-row-badge-${a.relationship.tone}`}>{a.relationship.label}</span>
												{a.sourceSignal?.trust_label && (
													<span class={`article-row-badge article-row-badge-trust article-row-badge-trust-${a.sourceSignal.trust_label === 'Висока доверба' ? 'high' : a.sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>
														{a.sourceSignal.trust_label}
													</span>
												)}
											</div>
											<div class="article-row-time">
												<span class="nyt-section-label text-muted-foreground lowercase first-letter:uppercase">{a.relativeTime}</span>
												<span class="text-muted-foreground opacity-40">·</span>
												<span class="article-row-time-exact">{a.exactTime}</span>
											</div>
										</div>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="block group">
											<h3 class="article-row-title">
												{a.title}
											</h3>
										</a>
										<p class="article-row-note">
											<strong>{a.sourceSignal?.role_label || a.relationship.label}</strong>
											{a.sourceSignal?.source_category ? ` · ${a.sourceSignal.source_category}` : ''}
											{' · '}
											{a.sourceSignal?.role_note || a.relationship.description}
										</p>
										<p class="article-row-summary">{a.description}</p>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="nyt-section-label flex items-center gap-1 text-nyt-accent hover:underline">
											<Link2 size={12} /> Отвори го оригиналот
										</a>
									</div>
								))}
							</div>
						</section>
					</div>

					{/* Sidebar */}
					<aside class="cluster-rail motion-rise motion-delay-2">
						{cluster.topics && cluster.topics.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Тема</h3>
								<div class="rail-tags">
									{cluster.topics.map((item: string) => (
										<a href={topicHref(item)} class="rail-chip rail-chip-topic">
											{item}
										</a>
									))}
								</div>
							</div>
						)}

						{/* Tags */}
						{cluster.tags && cluster.tags.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Теми Во Фокус</h3>
								<div class="rail-tags">
									{cluster.tags.map((tag: string) => (
										<a href={`/subjekt/${encodeURIComponent(tag)}`} class="rail-chip">
											{tag}
										</a>
									))}
								</div>
							</div>
						)}

						{/* AI Chat Island (Coming Soon Style) */}
						<div class="rail-card rail-card-accent">
							<h3 class="rail-card-title flex items-center gap-2 text-foreground">
								<MessageCircle size={14} /> ПРАШАЈ ГО ПРЕСЕК
							</h3>
							<AskPresekIsland client:load clusterId={cluster.cluster_id} suggestedQuestions={suggestedQuestions} />
						</div>

						<div class="rail-card">
							<ClusterFollowSuggestionsIsland
								client:load
								topic={cluster.topics?.[0] || cluster.articles[0].topic || cluster.articles[0].category || ''}
								source={cluster.articles[0].source || ''}
								adjacentTopic={adjacentTopic}
							/>
						</div>

						{/* Related */}
						{filteredRelated && filteredRelated.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Поврзани Вести</h3>
								<div class="related-list">
								{filteredRelated.map((rel: any) => (
									<a href={`/cluster/${rel.cluster_id}`} class="related-link group no-underline">
										{rel.relationship_label && <p class="related-kicker">{rel.relationship_label}</p>}
										<h4>
											{cleanAndDecode(rel.title)}
										</h4>
										{(rel.shared_entities?.length || rel.shared_tags?.length) > 0 && (
											<p class="related-meta">
												{rel.shared_entities?.length > 0 ? `Имиња: ${rel.shared_entities.join(' · ')}` : ''}
												{rel.shared_entities?.length > 0 && rel.shared_tags?.length > 0 ? ' · ' : ''}
												{rel.shared_tags?.length > 0 ? `Теми: ${rel.shared_tags.join(' · ')}` : ''}
											</p>
										)}
									</a>
								))}
								</div>
							</div>
						)}
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

