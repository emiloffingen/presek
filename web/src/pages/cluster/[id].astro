---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareIsland from '../../components/ShareIsland.tsx';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import { MediaPulseRadar } from '../../components/MediaPulseRadar.tsx';
import ResearchIsland from '../../components/ResearchIsland.tsx';
import StorylineHistoryIsland from '../../components/StorylineHistoryIsland.tsx';
import ClusterHistoryIsland from '../../components/ClusterHistoryIsland.tsx';
import { SourceSpectrum } from '../../components/SourceSpectrum.tsx';
import SourceComparisonIsland from '../../components/SourceComparisonIsland.tsx';
import ClusterFollowSuggestionsIsland from '../../components/ClusterFollowSuggestionsIsland.tsx';
import NewsletterIsland from '../../components/NewsletterIsland.tsx';
import AdUnit from '../../components/AdUnit.astro';
import { apiBaseUrl } from '../../lib/apiBase';
import { cleanAndDecode, isMostlyCyrillic, getEditionStr, parseFootnotes } from '../../utils/textUtils';

function getRelativeTimeStr(dateStr: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'ШТОТУКУ';
        if (diffMins < 60) return `ПРЕД ${diffMins} МИН`;
        
        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) return `ПРЕД ${diffHours} ${diffHours === 1 ? 'ЧАС' : 'ЧАСА'}`;

        const diffDays = Math.floor(diffHours / 24);
        return `ПРЕД ${diffDays} ${diffDays === 1 ? 'ДЕН' : 'ДЕНА'}`;
    } catch (e) {
        return '';
    }
}

import { sanitizeHtml } from '../../lib/sanitize';
import { Newspaper, Clock, Link2, Zap, Sparkles, ShieldCheck, TriangleAlert, BarChart3, Radio, Search } from 'lucide-react';
import type { ClusterDetail } from '../../types';

const { id } = Astro.params;
const API_URL = apiBaseUrl();

let cluster: ClusterDetail | null = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/cluster/${id}`);
    if (!res.ok) {
        if (res.status === 404) {
            error = 'Кластерот не е пронајден.';
            Astro.response.status = 404;
        } else {
            error = 'Грешка при вчитување на податоците.';
            Astro.response.status = 500;
        }
    } else {
      const payload = await res.json();
      cluster = payload.data;
    }
    } catch (e) {
    Astro.response.status = 500;
    error = 'Неуспешно поврзување со серверот.';
}

const mainArticle = cluster?.articles?.[0];
const displayHeadline = cluster?.synthetic_headline || (mainArticle ? cleanAndDecode(mainArticle.title) : 'Детали за веста');
const headlineIsCyrillic = isMostlyCyrillic(displayHeadline);

const allSourcesNames = Array.from(new Set(cluster?.articles?.map(a => a.source) || []));
const sourcePreview = allSourcesNames.slice(0, 5);
const citationSources = cluster?.citation_sources || [];
const hasCitationSources = citationSources.length > 0;
const synthesisUpdatedAt = cluster?.synthesis_updated_at;
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false };

const perspectives = cluster?.perspectives || [];
const verificationReport = cluster?.verification_report || null;
const generatedArticle = cluster?.generated_article || null;

const synthesisItems = (cluster?.ai_summary_bullets?.length ? cluster.ai_summary_bullets : (cluster?.synthesis || '').split('\n'))
    .filter((line: string) => line.trim().length > 10)
    .map((line: string) => {
        const match = line.match(/^\[(.*?)\]\s*(.*)/);
        if (match) {
            return { source: match[1], content: cleanAndDecode(match[2]) };
        }
        return { source: null, content: cleanAndDecode(line) };
    });

const articleRows = (cluster?.articles || []).map(a => {
    const d = new Date(a.created_at);
    return {
        ...a,
        exactTime: d.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' }),
        relativeTime: getRelativeTimeStr(a.created_at),
        relationship: (a as any).relationship_to_lead || { tone: 'neutral', label: 'ПОВРЗАНА ПРИКАЗНА' }
    };
});

function renderSynthesisHtml(text: string) {
	if (!text) return '';
	const clean = cleanAndDecode(text);
	if (!clean) return '';
	if (hasCitationSources) return sanitizeHtml(parseFootnotes(clean));
	return sanitizeHtml(clean.replace(/\[(\d+)\]/g, '').replace(/\s{2,}/g, ' ').trim());
}

const relatedClusters = cluster?.related || [];
const filteredRelated = relatedClusters.filter(c => c.cluster_id !== id).slice(0, 5);

const adjacentTopic = cluster?.topics?.find(t => t !== 'Македонија') || cluster?.topics?.[0];

const canonicalUrl = `https://presek.live/cluster/${id}`;
const shareDescription = synthesisItems[0]?.content || mainArticle?.description || '';

function getLeadVisual(c: ClusterDetail | null) {
    if (!c) return null;
    const res = { src: '/img/placeholder.svg', rawUrl: '', isWeak: true };
    const main = c.articles?.[0];
    if (main?.image_url && main.image_url.startsWith('http')) {
        res.src = `/proxy?url=${encodeURIComponent(main.image_url)}&w=1200`;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    } else if (main?.image_url && main.image_url.startsWith('/static/generated/')) {
        res.src = main.image_url;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    }
    return res;
}
const leadVisual = getLeadVisual(cluster);
const imageUrl = leadVisual && !leadVisual.isWeak ? leadVisual.src : '/img/presek_emblem.png';

const headerBriefItems = synthesisItems.map(item => item.content).filter((line: string) => line.trim().length > 4).slice(0, 4);
const hasGeneratedNarrative = Boolean(generatedArticle && generatedArticle.trim());
const hasSublimat = synthesisItems.length > 0;
const hasFactcheck = Boolean(verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0));
const hasStrongLeadNarrative = hasGeneratedNarrative && cluster.articles.length >= 3;
const primaryNarrativeLabel = 'СУБЛИМАТ';
const primaryNarrativeEyebrow = 'РЕДАКЦИСКА СИНТЕЗА';

const sentimentData = cluster?.sentiment ? {
    sentiment: cluster.sentiment.sentiment || { score: 0, tone: 'неутрално' },
    tone_analysis: cluster.sentiment.tone_analysis || { sensationalism: 0, objectivity: 0, emotional_charge: 0 }
} : null;

// --- Momentum Kicker Logic ---
const conflictsCount = verificationReport?.conflicts?.length || 0;
const totalSourcesCount = cluster?.articles?.length || 0;
const isBreakingFlag = cluster?.articles?.some(a => a.is_breaking) || false;

let momentumKicker = { label: 'РЕДАКЦИСКИ УВИД', color: 'text-muted-foreground' };
if (isBreakingFlag && totalSourcesCount >= 4) {
    momentumKicker = { label: 'УДАРЕН НАРАТИВ', color: 'text-nyt-red' };
} else if (conflictsCount >= 3) {
    momentumKicker = { label: 'КОНТРАДИКТОРЕН РАЗВОЈ', color: 'text-amber-600' };
} else if (totalSourcesCount >= 6) {
    momentumKicker = { label: 'СЕОПФАТЕН ИНТЕРЕС', color: 'text-emerald-700 dark:text-emerald-500' };
} else if (totalSourcesCount >= 2 && !synthesisFreshness.is_stale) {
    momentumKicker = { label: 'КОНСОЛИДИРАН ПРЕГЛЕД', color: 'text-blue-700 dark:text-blue-500' };
}

// --- SEO & Schema ---
const ogImageUrl = id ? `/og/cluster/${id}.svg` : null;
const articleSchema = cluster ? {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": displayHeadline,
	"description": cluster.generated_article?.slice(0, 200) || cluster.synthesis?.slice(0, 200) || displayHeadline,
	"image": cluster.representative_image || (leadVisual?.rawUrl?.startsWith('http') ? leadVisual.rawUrl : "https://presek.live/static/img/presek_emblem.png"),
	"datePublished": cluster.articles?.[cluster.articles.length - 1]?.created_at,
	"dateModified": cluster.synthesis_updated_at || cluster.articles?.[0]?.created_at,
	"author": {
		"@type": "Organization",
		"name": "ПРЕСЕК.мк",
		"url": "https://presek.live"
	},
	"publisher": {
		"@type": "Organization",
		"name": "ПРЕСЕК.мк",
		"logo": {
			"@type": "ImageObject",
			"url": "https://presek.live/static/img/presek_emblem.png"
		}
	}
} : null;
---

<Layout 
	title={displayHeadline} 
	description={cluster?.generated_article?.slice(0, 160) || cluster?.synthesis?.slice(0, 160) || shareDescription}
	image={ogImageUrl || imageUrl}
	type="article"
	canonical={canonicalUrl}
	schema={articleSchema || undefined}
>
	<NYTHeader topic={cluster?.topics?.[0]} />

	<ReaderTracker 
        clusterId={id || ''} 
        title={displayHeadline}
        category={cluster?.articles?.[0]?.category}
        topic={cluster?.topics?.[0]}
        primarySource={cluster?.articles?.[0]?.source}
        sources={Array.from(new Set(cluster?.articles?.map(a => a.source) || []))}
        tags={cluster?.tags}
        client:idle 
    />

	<main class="site-layout py-[var(--page-py)]">
		<Breadcrumbs items={[
			{ label: cluster?.articles?.[0]?.category || 'Вести', href: cluster?.articles?.[0]?.category ? `/?category=${cluster.articles[0].category}` : '/' },
			{ label: adjacentTopic || 'Детали' }
		]} />

		{error ? (
			<div class="py-20 text-center">
				<h1 class="text-2xl font-serif mb-4">{error}</h1>
				<a href="/" class="text-nyt-accent hover:underline">Назад на почетна</a>
			</div>
		) : cluster && (
			<article class="cluster-article-container">
				{/* 1. THE LEDE */}
				<header class="editorial-lede mb-10">
					<div class="lede-meta mb-6">
						<span class:list={["font-black uppercase tracking-[0.25em] text-[11px] mr-5", momentumKicker.color]}>{momentumKicker.label}</span>
						<span class="nyt-section-label text-foreground/50 mr-5">{cluster.articles?.[0].category || 'ВЕСТИ'}</span>
						<span class="lede-time-meta inline-flex items-center gap-1.5 text-muted-foreground">
							<Clock size={12} />
							<span class="text-[11px] font-bold uppercase tracking-wide">{getRelativeTimeStr(cluster.articles?.[0].created_at)}</span>
							<span class="mx-1.5 opacity-30">·</span>
							<span class="font-black uppercase tracking-widest text-[10px] text-nyt-accent/80">
								{getEditionStr(cluster.articles?.[0].created_at)}
							</span>
						</span>
					</div>

					<h1 class:list={["editorial-headline mb-8", { "is-cyrillic": headlineIsCyrillic }]}>
						{displayHeadline}
					</h1>

					{cluster.synthetic_standfirst && (
						<p class="editorial-standfirst font-serif text-2xl leading-tight text-muted-foreground italic max-w-3xl border-l-2 border-border/60 pl-6 mb-10">
							{cluster.synthetic_standfirst}
						</p>
					)}

					<div class="flex flex-wrap gap-4 items-center mb-12 border-y border-border/40 py-5">
						<ShareIsland
							title={displayHeadline}
							url={canonicalUrl}
							client:idle
						/>
						<div class="h-5 w-px bg-border/60 mx-2"></div>
						<PreferenceToggle
							kind="topic"
							value={cluster.topics?.[0] || cluster.articles?.[0].category}
							client:idle
						/>
					</div>
				</header>

				{/* 2. HERO GRID (Visual + Executive Summary) */}
				<div class="hero-grid mb-16">
					<div class="hero-visual-area">
						{leadVisual && leadVisual.rawUrl ? (
							<div class:list={["hero-visual-card shadow-editorial", leadVisual.isWeak ? "is-weak" : ""]}>
								{cluster?.dominant_color && !leadVisual.isWeak && (
									<div class="hero-visual-aura" style={`background-color: ${cluster.dominant_color};`}></div>
								)}
								
								{leadVisual.isWeak ? (
									<div class="hero-fallback">
										<p class="hero-fallback-kicker">ПРЕСЕК.мк Преглед</p>
										<h2 class="font-serif font-black">{cluster.articles?.[0].category || 'Главна Приказна'}</h2>
										<p class="hero-fallback-meta">{cluster.articles.length} извора · {sourcePreview.slice(0, 2).join(' · ')}</p>
									</div>
								) : (
									<img
										src={leadVisual.src}
										alt={displayHeadline}
										class="hero-main-image"
										transition:name={`cluster-image-${id}`}
										loading="eager"
										onload="this.classList.add('is-loaded')"
									/>
								)}
								<div class="hero-caption py-3 px-4 bg-background/80 backdrop-blur-sm border-t border-border/40 text-[10px] uppercase font-bold tracking-widest text-muted-foreground">
									Илустрација од водечките извештаи · {cluster.articles.length} редакции анализирани
								</div>
							</div>
						) : (
							<div class="hero-fallback-plain p-12 bg-secondary/20 border border-border/40 text-center">
								<Newspaper size={48} className="mx-auto mb-4 opacity-20" />
								<p class="font-serif italic text-muted-foreground">Нема достапна илустрација за овој развој.</p>
							</div>
						)}
					</div>

					<aside class="hero-summary-sidebar">
						{headerBriefItems.length > 0 && (
						<div class="briefing-box">
							<div class="briefing-header mb-5">
								<span class="briefing-kicker">КРАТОК БРИФИНГ</span>
								<h3 class="briefing-title">Што треба да знаете</h3>
							</div>
							
							<div class="briefing-content space-y-4 mb-6">
								{headerBriefItems.map((line: string) => (
									<p class="briefing-point" set:html={sanitizeHtml(cleanAndDecode(line))}></p>
								))}
							</div>

							<div class="briefing-footer border-t border-border/40 pt-4">
								<div class="flex flex-wrap gap-2 mb-4">
									{sourcePreview.map(s => (
										<span class="text-[9px] font-black uppercase tracking-tighter bg-secondary/50 px-1.5 py-0.5 rounded text-muted-foreground">{s}</span>
									))}
								</div>
								{synthesisUpdatedAt && (
									<p class:list={["text-[10px] font-bold uppercase tracking-tight", synthesisFreshness.is_stale ? "text-nyt-red" : "text-muted-foreground/60"]}>
										{synthesisFreshness.is_stale
											? `${synthesisFreshness.new_article_count || 1} нови извештаи од последната синтеза`
											: `Последен уреднички преглед: ${getRelativeTimeStr(synthesisUpdatedAt)}`}
									</p>
								)}
							</div>
						</div>
						)}
					</aside>
				</div>

				<div class="editorial-grid">
					{/* 3. MAIN COLUMN */}
					<div class="editorial-main-col">
						{/* NARRATIVE SECTION */}
						{(hasStrongLeadNarrative || synthesisItems.length > 0) && (
						<section class="editorial-section narrative-section mb-16">
							<div class="section-eyebrow mb-8">
								<Sparkles size={16} className="text-nyt-accent" />
								<h2 class="section-label">{primaryNarrativeLabel}</h2>
								<div class="section-divider"></div>
							</div>

							<div class="editorial-narrative prose-editorial">
								{hasStrongLeadNarrative ? (
									<div class="narrative-body font-serif">
										{generatedArticle.split('\n').filter((p: string) => p.trim()).map((paragraph: string, idx: number) => (
											<p class:list={["narrative-p", idx === 0 ? "drop-cap" : ""]} set:html={renderSynthesisHtml(paragraph)}></p>
										))}
									</div>
								) : (
									<div class="synthesis-list">
										{synthesisItems.map(item => (
											<div class="synthesis-item">
												{item.source && <span class="source-tag">[{item.source}]</span>}
												<span class="synthesis-text" set:html={renderSynthesisHtml(item.content)}></span>
											</div>
										))}
									</div>
								)}
							</div>

							{hasCitationSources && (
								<footer class="narrative-citations mt-12 p-8 bg-secondary/10 border border-border/40 rounded-lg">
									<h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground mb-6">РЕФЕРЕНТНИ ИЗВОРИ</h4>
									<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
										{citationSources.map((art: any) => (
											<div class="citation-card group">
												<span class="citation-idx">[{art.index}]</span>
												<div class="citation-body">
													<p class="citation-source">{art.source}</p>
													<a href={art.link} target="_blank" rel="noopener noreferrer" class="citation-link">
														{cleanAndDecode(art.title)}
													</a>
												</div>
											</div>
										))}
									</div>
								</footer>
							)}
						</section>
						)}

						{/* ANALYSIS SECTION: Fact Check & Comparison */}
						{(hasFactcheck || perspectives.length > 0) && (
							<section class="editorial-section analysis-section mb-16 border-t-4 border-foreground pt-12">
								<div class="section-eyebrow mb-10">
									<ShieldCheck size={18} className="text-foreground" />
									<h2 class="section-label">АНАЛИЗА НА КРЕДИБИЛНОСТ</h2>
									<div class="section-divider"></div>
								</div>

								{hasFactcheck && (
									<div class="factcheck-container mb-12">
										<div class="factcheck-grid-v2">
											<div class="factcheck-col agreements">
												<header class="col-header">
													<ShieldCheck size={18} className="text-emerald-600" />
													<h3>Потврдени факти</h3>
												</header>
												<ul class="fact-list">
													{verificationReport.agreements.map((item: string) => (
														<li class="fact-item green" set:html={sanitizeHtml(cleanAndDecode(item))}></li>
													))}
												</ul>
											</div>
											
											<div class="factcheck-col conflicts">
												<header class="col-header">
													<TriangleAlert size={18} className="text-nyt-red" />
													<h3>Разлики во известувањето</h3>
												</header>
												<ul class="fact-list">
													{verificationReport.conflicts.map((item: string) => (
														<li class="fact-item red" set:html={sanitizeHtml(cleanAndDecode(item))}></li>
													))}
												</ul>
											</div>

											{verificationReport.missing_info && verificationReport.missing_info.length > 0 && (
												<div class="factcheck-col missing-info mt-6 col-span-full border-t border-border pt-4">
													<header class="col-header">
														<Search size={18} className="text-amber-500" />
														<h3>Информативни Празнини</h3>
													</header>
													<p class="text-xs text-muted-foreground mb-3 font-sans uppercase font-bold tracking-wider">Што изоставуваат одредени извори:</p>
													<ul class="fact-list">
														{verificationReport.missing_info.map((item: string) => (
															<li class="fact-item amber" set:html={sanitizeHtml(cleanAndDecode(item))}></li>
														))}
													</ul>
												</div>
											)}
										</div>
										
										{verificationReport.context && (
											<div class="factcheck-context p-6 bg-muted/30 border border-border/40 mt-8 italic text-sm text-muted-foreground">
												<p set:html={sanitizeHtml(cleanAndDecode(verificationReport.context))}></p>
											</div>
										)}
									</div>
								)}

								{perspectives.length > 0 && (
									<div class="perspectives-area">
										<h4 class="text-[11px] font-black uppercase tracking-widest text-center mb-8 text-muted-foreground/60">Уреднички Диверзитет</h4>
										<div class="perspective-grid-v2">
											{perspectives.map((p: any) => (
												<div class="editorial-angle-card">
													<h5 class="angle-title" set:html={sanitizeHtml(p.angle)}></h5>
													<p class="angle-content" set:html={sanitizeHtml(p.content)}></p>
												</div>
											))}
										</div>
									</div>
								)}
							</section>
						)}

						{/* ANALYTICAL TOOLS SECTION */}
						<section class="editorial-section data-section mb-16 border-t border-border/40 pt-12">
							<div class="section-eyebrow mb-12">
								<BarChart3 size={18} className="text-muted-foreground" />
								<h2 class="section-label">МЕДИУМСКИ ПУЛС</h2>
								<div class="section-divider"></div>
							</div>

							<div class="data-tools-grid">
								{sentimentData && (
									<div class="data-card radar-card">
										<header class="card-header">
											<h4>Тоналитет на известувањето</h4>
											<p>Сентимент и емотивен набој низ сите извори.</p>
										</header>
										<MediaPulseRadar data={sentimentData} client:visible />
									</div>
								)}

								<div class="data-card spectrum-card">
									<header class="card-header">
										<h4>Спектар на извори</h4>
										<p>Распределба на медиумите во овој кластер.</p>
									</header>
									<div class="py-6">
										<SourceSpectrum articles={cluster.articles.map(a => ({ source: a.source })) as any} client:visible />
									</div>
								</div>
							</div>

							{allSourcesNames.length >= 2 && (
								<div class="mt-12">
									<SourceComparisonIsland allSources={allSourcesNames} client:visible />
								</div>
							)}
						</section>

						{/* ALL SOURCES LIST */}
						<section class="editorial-section sources-section mb-16 border-t border-border/40 pt-12">
							<div class="section-eyebrow mb-8">
								<Newspaper size={18} className="text-muted-foreground" />
								<h2 class="section-label">ЦЕЛОСНА АРХИВА НА ИЗВОРИ</h2>
								<div class="section-divider"></div>
							</div>

							<div class="editorial-article-list">
								{articleRows.map((a: any) => (
									<div class={`article-editorial-row tone-${a.relationship.tone}`} data-article-link={encodeURIComponent(a.link || '')}>
										<div class="row-header">
											<div class="row-source-info">
												<span class="source-name">{a.source}</span>
												<span class={`tone-badge tone-${a.relationship.tone}`}>{a.relationship.label}</span>
												{a.sourceSignal?.trust_label && (
													<span class={`trust-badge trust-${a.sourceSignal.trust_label === 'Висока доверба' ? 'high' : a.sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>
														{a.sourceSignal.trust_label}
													</span>
												)}
											</div>
											<div class="row-time">
												<span class="exact">{a.exactTime}</span>
												<span class="relative">{a.relativeTime}</span>
											</div>
										</div>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="row-title-link">
											<h3 class="row-title" set:html={sanitizeHtml(a.title)}></h3>
										</a>
										<p class="row-snippet" set:html={sanitizeHtml(a.description)}></p>
										<div class="row-footer">
											<a href={a.link} target="_blank" rel="noopener noreferrer" class="read-original">
												Оригинална објава <Link2 size={12} />
											</a>
										</div>
									</div>
								))}
							</div>
						</section>

						{/* RELATED SECTION */}
						{filteredRelated.length > 0 && (
							<section class="editorial-section related-section mb-16 border-t border-border/40 pt-12">
								<div class="section-eyebrow mb-10">
									<Zap size={18} className="text-nyt-red" />
									<h2 class="section-label">ПОВРЗАНО</h2>
									<div class="section-divider"></div>
								</div>
								<div class="related-editorial-grid">
									{filteredRelated.map((rel: any) => (
										<a href={`/cluster/${rel.cluster_id}`} class="related-editorial-card group">
											{rel.image_url && (
												<div class="card-thumb">
													<img src={`/proxy?url=${encodeURIComponent(rel.image_url)}&w=480`} alt="" loading="lazy" />
												</div>
											)}
											<div class="card-body">
												<span class="card-kicker">{rel.relationship_label || 'Сродна тема'}</span>
												<h3 class="card-title">{cleanAndDecode(rel.title)}</h3>
											</div>
										</a>
									))}
								</div>
							</section>
						)}

						{/* ADVANCED ANALYTICS */}
						<section class="editorial-section advanced-tools mb-16 bg-secondary/5 p-10 border-y border-border/40">
							<div class="section-eyebrow mb-10">
								<Radio size={18} className="text-muted-foreground" />
								<h2 class="section-label">ДОПОЛНИТЕЛНА АНАЛИТИКА</h2>
								<div class="section-divider"></div>
							</div>
							<div class="space-y-12">
								<ResearchIsland client:load clusterId={id || ''} initialHeadline={displayHeadline || ''} sources={allSourcesNames} />
								<StorylineHistoryIsland client:load clusterId={id || ''} apiUrl={API_URL} />
								<ClusterHistoryIsland client:visible clusterId={id || ''} />
							</div>
						</section>
					</div>

					{/* 4. SIDEBAR COLUMN */}
					<aside class="editorial-sidebar-col">
						<div class="sticky-sidebar space-y-12">
							<div class="sidebar-module">
								<AdUnit slot="cluster_sidebar" />
							</div>

							<NewsletterIsland client:visible />

							<ClusterFollowSuggestionsIsland 
								topic={cluster.topics?.[0] || ''} 
								source={cluster.articles?.[0]?.source || ''}
								adjacentTopic={adjacentTopic}
								client:visible 
							/>

							{cluster.tags && cluster.tags.length > 0 && (
								<div class="sidebar-module">
									<h4 class="sidebar-label">КЛУЧНИ ПОИМИ</h4>
									<div class="flex flex-wrap gap-2 mt-4">
										{cluster.tags.map(tag => (
											<a href={`/?q=${encodeURIComponent(tag)}`} class="tag-chip">
                                                {tag}
                                            </a>
										))}
									</div>
								</div>
							)}
						</div>
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

