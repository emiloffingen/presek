---
import Layout from '../../layouts/Layout.astro';
import SearchIsland from '../../components/SearchIsland';
import ThemeIsland from '../../components/ThemeIsland';
import { Clock, ArrowLeft, Newspaper, Sparkles, MessageCircle, Link2 } from 'lucide-react';

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5001/api";

let cluster = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/cluster/${id}`);
    if (!res.ok) throw new Error("Cluster not found");
    const data = await res.json();
    cluster = data.data;
} catch (e) {
    console.error(e);
    error = "Кластерот не е пронајден.";
}

if (error) {
    return Astro.redirect('/404');
}

const article = cluster.articles[0];
---

<Layout title={article.title} description={cluster.synthesis?.substring(0, 160)}>
	<header class="site-layout py-6 border-b border-nyt flex items-center justify-between">
		<a href="/" class="flex items-center gap-2 text-xs font-black uppercase tracking-widest text-muted hover:text-accent transition">
			<ArrowLeft size={14} /> Назад
		</a>
		
		<a href="/" class="absolute left-1/2 -translate-x-1/2">
			<img src="/logo.svg" alt="Presek" class="h-10 grayscale opacity-50" />
		</a>

		<div class="flex items-center gap-2">
			<SearchIsland client:load />
			<ThemeIsland client:load />
		</div>
	</header>

	<main class="site-layout py-12">
		<article class="max-w-4xl mx-auto">
			<header class="mb-12 border-b-2 border-primary pb-10">
				<div class="flex flex-wrap gap-2 mb-6">
					{(cluster.is_breaking || cluster.articles.length > 5) && (
						<span class="text-[10px] font-black uppercase tracking-widest text-accent border border-accent px-2 py-0.5">BREAKING</span>
					)}
					{cluster.has_synthesis && (
						<span class="text-[10px] font-black uppercase tracking-widest text-white bg-accent px-2 py-0.5">СИНТЕЗА</span>
					)}
				</div>
				
				<h1 class="text-4xl md:text-6xl font-serif font-bold leading-tight text-primary mb-6">
					{article.title}
				</h1>

				<div class="flex items-center gap-4 text-xs font-bold uppercase text-muted">
					<span class="flex items-center gap-1"><Clock size={12}/> {new Date(article.created_at).toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' })}</span>
					<span>·</span>
					<span>{cluster.total_reading_time || 1} мин читање</span>
					<span>·</span>
					<span>{cluster.articles.length} извори</span>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
				<!-- Content Column -->
				<div class="lg:col-span-8">
					{cluster.has_synthesis && cluster.synthesis && (
						<section class="mb-16">
							<h2 class="rail-label mb-8 flex items-center gap-2"><Sparkles size={14}/> АИ РЕЗИМЕ</h2>
							<div class="prose-nyt italic border-l-4 border-accent pl-8 py-2 text-secondary text-xl leading-relaxed">
								{cluster.synthesis}
							</div>
							
							{cluster.perspectives && cluster.perspectives.length > 0 && (
								<div class="mt-12 space-y-8">
									<p class="section-heading text-xs font-black uppercase tracking-tighter text-muted">РАЗЛИЧНИ ПЕРСПЕКТИВИ</p>
									{cluster.perspectives.map((p: any) => (
										<div class="bg-secondary p-6 border-t border-nyt">
											<p class="font-bold text-sm mb-3 uppercase tracking-tight text-primary">{p.angle}</p>
											<p class="text-base text-secondary leading-relaxed">{p.content}</p>
										</div>
									))}
								</div>
							)}
						</section>
					)}

					<section>
						<h2 class="rail-label mb-8 flex items-center gap-2"><Newspaper size={14}/> СИТЕ ИЗВОРИ</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							{cluster.articles.map((art: any) => (
								<div class="border-b border-nyt pb-6">
									<div class="flex justify-between items-start gap-3 mb-3">
										<span class="text-[10px] font-black uppercase text-accent">{art.source}</span>
										<span class="text-[10px] text-muted">
											{new Date(art.created_at).toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' })}
										</span>
									</div>
									<a href={art.link} target="_blank" rel="noopener noreferrer" class="font-serif font-bold text-lg text-primary no-underline hover:text-accent transition-colors block leading-snug">
										{art.title}
									</a>
								</div>
							))}
						</div>
					</section>
				</div>

				<!-- Sidebar Column -->
				<aside class="lg:col-span-4 space-y-12">
					<div class="rail-widget border-t-2 border-primary pt-4">
						<h3 class="rail-label flex items-center gap-2"><MessageCircle size={14}/> ПРАШАЈ АИ</h3>
						<div class="bg-secondary p-6 text-center">
							<p class="text-xs text-muted mb-4 italic">Интерактивниот АИ чет доаѓа наскоро во Presek 6.0</p>
							<button disabled class="w-full bg-primary/10 border border-nyt py-3 text-[10px] font-black uppercase tracking-widest opacity-50">
								Наскоро
							</button>
						</div>
					</div>

					{cluster.related && cluster.related.length > 0 && (
						<div class="rail-widget border-t-2 border-primary pt-4">
							<h3 class="rail-label flex items-center gap-2"><Link2 size={14}/> ПОВРЗАНИ ТЕМИ</h3>
							<div class="space-y-8">
								{cluster.related.map((rel: any) => (
									<a href={`/cluster/${rel.cluster_id}`} class="group block no-underline">
										<p class="font-serif font-bold text-base text-primary group-hover:text-accent transition-colors leading-snug mb-2">
											{rel.title}
										</p>
										<div class="flex flex-wrap gap-2">
											{(rel.tags || []).slice(0, 3).map((tag: string) => (
												<span class="text-[9px] font-bold uppercase text-muted">#{tag}</span>
											))}
										</div>
									</a>
								))}
							</div>
						</div>
					)}
				</aside>
			</div>
		</article>
	</main>
</Layout>

<style>
	.prose-nyt {
		font-family: var(--nyt-font-serif);
	}
</style>
