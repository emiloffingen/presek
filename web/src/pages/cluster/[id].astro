---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import StoryTimeline from '../../components/StoryTimeline.tsx';
import { MediaPulseRadar } from '../../components/MediaPulseRadar.tsx';
import ClusterFollowSuggestionsIsland from '../../components/ClusterFollowSuggestionsIsland.tsx';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import ShareIsland from '../../components/ShareIsland.tsx';
import { SourceSpectrum } from '../../components/SourceSpectrum.tsx';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { chooseClusterImage } from '../../utils/imageSelection';
import { cleanAndDecode, isMostlyCyrillic } from '../../utils/textUtils';
import { sanitizeHtml } from '../../lib/sanitize';
import { Clock, ArrowLeft, Newspaper, Sparkles, Link2, Zap, ShieldCheck, TriangleAlert } from 'lucide-react';
import { apiBaseUrl } from '../../lib/apiBase';

import type { ClusterDetail, NewsCluster, Article, ClusterSummary } from '../../types';

const { id } = Astro.params;
const API_URL = apiBaseUrl();
const siteUrl = (Astro.site?.origin || import.meta.env.PUBLIC_SITE_URL || "https://presek.live").replace(/\/+$/, "");
// Canonical: use Astro.site + pathname, strip trailing slash (trailingSlash: 'never')
const canonicalUrl = (() => {
	const base = Astro.site || new URL("https://presek.live");
	const url = new URL(Astro.url.pathname, base);
	let clean = url.origin + url.pathname.replace(/\/+$/, "");
	if (clean === url.origin) return url.origin;
	return clean;
})();

let cluster: ClusterDetail | null = null;
let error = null;

try {
	const res = await fetch(`${API_URL}/cluster/${id}`);
	if (res.ok) {
		const json = await res.json();
		cluster = json.data;
	} else {
		error = 'Не можеме да го вчитаме овој кластер.';
	}
} catch (e) {
	error = 'Грешка при поврзување со серверот.';
}

// Helpers
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function getRelativeTimeStr(dateStr: string) {
	try {
		const date = new Date(dateStr);
		const now = new Date();
		const diffMs = now.getTime() - date.getTime();
		const diffMin = Math.round(diffMs / 60000);

		if (diffMin < 1) return 'Штотуку';
		if (diffMin < 60) return `${diffMin}м`;
		const diffHrs = Math.round(diffMin / 60);
		if (diffHrs < 24) return `${diffHrs}ч`;
		return date.toLocaleDateString('mk-MK', { day: 'numeric', month: 'short' });
	} catch {
		return '';
	}
}

function parseSynthesis(text: string) {
	if (!text) return [];
	return text
		.split('\n')
		.filter((line) => line.trim())
		.map((line) => {
			const cleaned = line.replace(/^[-•*]\s*/, '').trim();
			const match = cleaned.match(/^\[(.*?)\]\s*(.*)$/);
			if (match) {
				return { source: match[1], content: match[2] };
			}
			return { source: null, content: cleaned };
		});
}

function looksMacedonianHeadline(text: string) {
    const value = String(text || "").trim();
    if (!value) return false;
    
    let cyrillicCount = 0;
    let latinCount = 0;
    
    for (let i = 0; i < value.length; i++) {
        const char = value[i];
        if (char >= "\u0400" && char <= "\u04FF") {
            cyrillicCount++;
        } else if ((char >= "A" && char <= "Z") || (char >= "a" && char <= "z")) {
            latinCount++;
        }
    }
    
    if (cyrillicCount < 8) return false;
    if (latinCount === 0) return true;
    return cyrillicCount >= latinCount * 2;
}

function getPreferredClusterHeadline(articles: Article[]) {
	let fallback = '';
	let preferredMacedonian = '';

	for (const article of articles || []) {
		const title = cleanAndDecode(article?.title || '');
		if (!title) continue;
		if (!fallback) fallback = title;

		const originalTitle = cleanAndDecode(article?.original_title || '');
		const isTranslated = Boolean(article?.is_translated) || Boolean(originalTitle && title !== originalTitle);

		if (isTranslated && looksMacedonianHeadline(title)) {
			return title;
		}
		if (!preferredMacedonian && looksMacedonianHeadline(title)) {
			preferredMacedonian = title;
		}
	}

	return preferredMacedonian || fallback;
}

function getRelationshipMeta(title: string, leadTitle: string, index: number) {
	if (index === 0) {
		return {
			label: 'Водечки извор',
			tone: 'lead',
			description: 'Овој извор ја носи главната линија што ја потврдуваат и повеќе други редакции.',
		};
	}

	const normalize = (t: string) =>
		t
			.toLowerCase()
			.replace(/[^\w\sа-я]/gi, '')
			.split(' ')
			.filter((w) => w.length > 3);
	const leadTerms = normalize(leadTitle);
	const currentTerms = normalize(title);
	const intersection = leadTerms.filter((t) => currentTerms.includes(t));
	const overlap = intersection.length / Math.max(1, Math.min(leadTerms.length, currentTerms.length), 1);

	if (overlap >= 0.5) {
		return {
			label: 'Го потврдува главниот развој',
			tone: 'confirm',
			description: 'Носи слична главна линија како водечкиот извор.',
		};
	}

	if (overlap >= 0.24) {
		return {
			label: 'Дополнува контекст',
			tone: 'context',
			description: 'Ја потврдува главната приказна, но додава и свој контекст или детали.',
		};
	}

	return {
		label: 'Следење / реакција',
		tone: 'context',
		description: 'Доаѓа подоцна и повеќе носи реакција, последица или follow-up.',
	};
}

function normalizePerspectives(items: ClusterSummary[]): ClusterSummary[] {
    if (!Array.isArray(items)) return [];

    return items
        .map((item) => {
            if (typeof item === 'string') {
                const content = cleanAndDecode((item as string).trim());
                return content ? { angle: 'Перспектива', content } : null;
            }

            if (!item || typeof item !== 'object') return null;

            const angle = String(
                item.angle ?? item.label ?? item.title ?? item.name ?? 'Перспектива'
            ).trim();
            const content = cleanAndDecode(String(
                item.content ?? item.text ?? item.description ?? ''
            ).trim());

            if (!content) return null;
            return { angle: angle || 'Перспектива', content };
        })
        .filter(Boolean) as ClusterSummary[];
}

function extractSafeText(text?: string) {
	if (!text) return '';
	return cleanAndDecode(text).replace(/<\/?[^>]+(>|$)/g, "");
}

const displayHeadline = cluster ? getPreferredClusterHeadline(cluster.articles) : 'Вест';
const headlineIsCyrillic = isMostlyCyrillic(displayHeadline);

const synthesisItems = cluster?.synthesis ? parseSynthesis(cluster.synthesis) : [];
const headerBriefItems = synthesisItems.length > 0
	? synthesisItems.slice(0, 3).map((item) => item.content)
	: (cluster?.ai_summary_bullets || []).slice(0, 3).map((line: string) => cleanAndDecode(line));
const leadArticle = cluster?.articles?.[0];
const articleRows = cluster
	? cluster.articles.map((article: any, index: number) => ({
			...article,
			title: cleanAndDecode(article.title),
			description: cleanAndDecode(article.description),
			relationship: getRelationshipMeta(article.title, leadArticle?.title || article.title, index),
			sourceSignal: article.source_signal || null,
			exactTime: getTimeStr(article.created_at),
			relativeTime: getRelativeTimeStr(article.created_at),
	  }))
	: [];
const confirmRows = articleRows.filter((article: any) => article.relationship?.tone === 'confirm');
const contextRows = articleRows.filter((article: any) => article.relationship?.tone === 'context');
const contrastRows = articleRows.filter((article: any) => article.relationship?.tone === 'contrast');
const comparisonHighlights = [
	{
		label: 'Заедничка линија',
		value: confirmRows.length > 0 ? `${confirmRows.length + 1} извора` : `${articleRows.length} извора`,
		copy:
			confirmRows.length > 0
				? `Главниот развој најјасно се повторува кај ${[leadArticle?.source, ...confirmRows.slice(0, 2).map((item: any) => item.source)].filter(Boolean).join(' · ')}.`
				: 'Изворите во кластерот главно ја следат истата основна линија.',
	},
	{
		label: 'Нов агол',
		value: contrastRows.length > 0 ? `${contrastRows.length} извора` : contextRows.length > 0 ? `${contextRows.length} извора` : 'Слична рамка',
		copy:
			contrastRows.length > 0
				? `${contrastRows.slice(0, 2).map((item: any) => item.source).join(' · ')} носат поинаков акцент или отвораат друг аспект.`
				: contextRows.length > 0
				? `${contextRows.slice(0, 2).map((item: any) => item.source).join(' · ')} додаваат дополнителен контекст и реакција.`
				: 'Во овој кластер засега нема силно издвоен спротивен агол.',
	},
	{
		label: 'Почни со',
		value: articleRows[0]?.source || 'Водечки извор',
		copy: articleRows[0]?.sourceSignal?.role_note || articleRows[0]?.relationship?.description || 'Прво прочитајте го водечкиот извор, па потоа споредете ги другите верзии.',
	},
];

const sentimentData = cluster?.sentiment ? {
	sentiment: cluster.sentiment.sentiment || { score: 0, tone: 'неутрално' },
	tone_analysis: cluster.sentiment.tone_analysis || { sensationalism: 0, objectivity: 0, emotional_charge: 0 }
} : null;

const leadDescription = extractSafeText(cluster?.articles?.find((article: any) => article?.description?.trim())?.description);
const sourcePreview = cluster?.articles?.slice(0, 3).map((article: any) => article.source).filter(Boolean) || [];

const ai_summary_bullets = cluster?.ai_summary_bullets || [];
const generatedArticle = cluster?.generated_article || '';
const perspectives = cluster ? normalizePerspectives(cluster.perspectives) : [];
const verificationReport = cluster?.verification_report || null;

const synthesisUpdatedAt = cluster?.synthesis_updated_at || '';
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false, new_article_count: 0, reasons: [] };
const adjacentTopic =
	cluster?.related?.find((item: any) => item?.shared_topics?.length)?.shared_topics?.[0] ||
	cluster?.related?.find((item: any) => item?.shared_tags?.length)?.shared_tags?.[0] ||
	'';
const shareDescription = (
	extractSafeText(cluster?.synthesis) ||
	leadDescription ||
	`Овој кластер спојува ${cluster?.articles?.length || 0} извори за да ги покаже заедничките факти, разликите во акцентот и што останува неразјаснето.`
).replace(/\s+/g, ' ').trim().slice(0, 220);
const shareImage = cluster ? `/og/cluster/${cluster.cluster_id}.svg?v=1` : '/og-image.svg';
const imageUrl = /^https?:\/\//i.test(shareImage) ? shareImage : `${siteUrl}${shareImage.startsWith("/") ? shareImage : `/${shareImage}`}`;

const GENERIC_TAGS = ['ВИДЕО', 'ВЕСТИ', 'ФОТО', 'МАКЕДОНИЈА', 'СВЕТ', 'СПОРТ'];

const filteredRelated = (cluster?.related || []).filter((rel: any) => {
	if (rel.shared_entities && rel.shared_entities.length > 0) return true;
	if (rel.shared_tags && rel.shared_tags.length > 0) {
		const nonGenericTags = rel.shared_tags.filter((tag: string) => !GENERIC_TAGS.includes(tag.toUpperCase()));
		return nonGenericTags.length > 0;
	}
	return true; 
});

function getLeadVisual(clusterData: any) {
    if (!clusterData) return null;
    const res = chooseClusterImage(clusterData, 'hero');
    return {
        src: res.proxiedUrl,
        rawUrl: res.rawUrl,
        isWeak: res.isWeak
    };
}
const leadVisual = getLeadVisual(cluster);
---

<Layout 
	title={displayHeadline} 
	description={shareDescription}
	image={imageUrl}
	type="article"
	canonical={canonicalUrl}
>
	<NYTHeader topic={cluster?.topics?.[0]} />

	<ReaderTracker clusterId={id} client:idle />

	<main class="site-layout py-12">
		<Breadcrumbs items={[
			{ label: cluster?.articles?.[0]?.category || 'Вести', href: cluster?.articles?.[0]?.category ? `/?category=${cluster.articles[0].category}` : '/' },
			{ label: adjacentTopic || 'Детали' }
		]} />

		{error ? (
			<div class="py-20 text-center">
				<h1 class="text-2xl font-serif mb-4">{error}</h1>
				<a href="/" class="text-nyt-accent hover:underline">Назад на почетна</a>
			</div>
		) : cluster && (
			<article class="cluster-detail-shell">
				<header class="cluster-header-main mb-12">
					<div class="cluster-header-grid">
						<div class="cluster-header-content">
							<div class="cluster-header-meta mb-6">
								<span class="nyt-section-label text-nyt-red mr-4">{cluster.articles?.[0].category || 'ВЕСТИ'}</span>
								<span class="cluster-time-meta inline-flex items-center gap-1">
									<Clock size={12} />
									{getRelativeTimeStr(cluster.articles?.[0].created_at)}
								</span>
							</div>

							<h1 class:list={["cluster-headline", { "cluster-headline-cyrillic": headlineIsCyrillic }]}>
								{displayHeadline}
							</h1>

							<div class="flex flex-wrap gap-4 items-center my-8 border-y border-border py-4">
								<ShareIsland
									title={displayHeadline}
									url={canonicalUrl}
									client:idle
								/>
								<div class="h-4 w-px bg-border mx-2"></div>
								<PreferenceToggle
									kind="topic"
									value={cluster.topics?.[0] || cluster.articles?.[0].category}
									client:idle
								/>
							</div>

							<div class="cluster-comparison-brief">
								{comparisonHighlights.map((item) => (
									<div class="cluster-brief-item">
										<p class="cluster-brief-label">{item.label}</p>
										<p class="cluster-brief-value">{item.value}</p>
										<p class="cluster-brief-copy">{item.copy}</p>
									</div>
								))}
							</div>
						</div>

						<div class="cluster-header-side">
							{leadVisual && leadVisual.rawUrl && (
								<div class:list={["cluster-visual-card", leadVisual.isWeak ? "is-weak" : ""]}>
									{cluster?.dominant_color && !leadVisual.isWeak && (
										<div 
											class="cluster-visual-aura" 
											style={`background-color: ${cluster.dominant_color};`}
										></div>
									)}
									{leadVisual.isWeak ? (
										<div class="cluster-visual-fallback">
											<p class="cluster-visual-kicker">Пресек Преглед</p>
											<h2>{cluster.articles?.[0].category || 'Главна Приказна'}</h2>
											<p class="cluster-visual-meta">{cluster.articles.length} извора · {sourcePreview.slice(0, 2).join(' · ')}</p>
											<p class:list={["cluster-visual-title", { "cluster-visual-title-cyrillic": headlineIsCyrillic }]}>{displayHeadline}</p>
										</div>
									) : (
										<>
											<img
												src={leadVisual.src}
												alt={cleanAndDecode(cluster.articles?.[0].title)}
												class="cluster-visual-image"
												transition:name={`cluster-image-${id}`}
												loading="eager"
												onload="this.classList.add('is-loaded')"
												onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
											/>
											<div class="cluster-visual-fallback cluster-visual-fallback-error" style="display: none;">
												<p class="cluster-visual-kicker">Пресек Преглед</p>
												<h2>{cluster.articles?.[0].category || 'Главна Приказна'}</h2>
												<p class="cluster-visual-meta">{cluster.articles.length} извора · {sourcePreview.slice(0, 2).join(' · ')}</p>
												<p class:list={["cluster-visual-title", { "cluster-visual-title-cyrillic": headlineIsCyrillic }]}>{displayHeadline}</p>
											</div>
										</>
									)}
								</div>
							)}
							{headerBriefItems.length > 0 && (
								<div class="cluster-summary-card">
									<p class="cluster-summary-label">Што носи кластерот</p>
									<div class="cluster-summary-copy">
										{headerBriefItems.map((line: string) => (
											<p class="mb-2 last:mb-0" set:html={sanitizeHtml(cleanAndDecode(line))}></p>
										))}
									</div>
									{sourcePreview.length > 0 && (
										<p class="cluster-summary-sources">
											<span>Извори:</span> {sourcePreview.join(' · ')}
										</p>
									)}
									{synthesisUpdatedAt && (
										<p class:list={["cluster-summary-update", synthesisFreshness.is_stale ? "is-stale" : ""]}>
											{synthesisFreshness.is_stale
												? `${synthesisFreshness.new_article_count || 1} ${ (synthesisFreshness.new_article_count || 1) === 1 ? 'нов извештај се појавил' : 'нови извештаи се појавиле' } по последната синтеза.`
												: `Последна синтеза: ${getRelativeTimeStr(synthesisUpdatedAt)}.`}
										</p>
									)}
								</div>
							)}
						</div>
					</div>
				</header>

				<div class="cluster-grid">
					<div class="cluster-main motion-rise motion-delay-1">
						{sentimentData && (
							<div class="mb-4">
								<MediaPulseRadar data={sentimentData} client:visible />
							</div>
						)}

						{cluster.articles && cluster.articles.length > 1 && (
							<SourceSpectrum articles={cluster.articles} client:visible />
						)}

						{/* Lead Article Section */}
						{generatedArticle ? (
							<section class="cluster-article-hero">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ВОДЕЧКА СТОРИЈА</h2>
								</div>
								<div class="prose-nyt text-xl leading-relaxed text-foreground font-serif">
										{generatedArticle.split('\n').filter((p: string) => p.trim()).map((paragraph: string, idx: number) => (
										<p class:list={["mb-6 last:mb-0", idx === 0 ? "drop-cap" : ""]}>
											{paragraph}
										</p>
									))}
								</div>
								<div class="h-px bg-nyt-gray-300 my-10" />
							</section>
						) : cluster.synthesis && (
							<section class="cluster-synthesis">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ПРЕСЕК СУБЛИМАТ</h2>
								</div>
								<div class="prose-nyt text-lg leading-relaxed text-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-4">
										{synthesisItems.map(item => (
											<li class="flex gap-3 items-start">
												<span class="text-nyt-accent font-black mt-1">●</span>
												<span>
													{item.source && <strong class="nyt-section-label text-[10px] mr-2 text-nyt-accent">[{item.source}]</strong>}
													<span set:html={sanitizeHtml(item.content)}></span>
												</span>
											</li>
										))}
									</ul>
								</div>
								<div class="h-px bg-nyt-gray-300 my-10" />
							</section>
						)}

						{/* Secondary Synthesis (Bullets if article exists) */}
						{generatedArticle && cluster.synthesis && synthesisItems.length > 0 && (
							<section class="cluster-synthesis mb-12">
								<div class="cluster-module-head">
									<h2 class="nyt-section-label tracking-[0.2em]">КЛУЧНИ ТОЧКИ</h2>
								</div>
								<div class="prose-nyt text-base leading-relaxed text-secondary-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-3">
										{synthesisItems.map(item => (
											<li class="flex gap-3 items-start border-b border-border/50 pb-3 last:border-0">
												<span class="text-nyt-accent font-black mt-0.5">●</span>
												<span set:html={sanitizeHtml(item.content)}></span>
											</li>
										))}
									</ul>
								</div>
							</section>
						)}

						{/* Perspectives */}
						{perspectives.length > 0 && (
							<section class="cluster-synthesis cluster-perspectives">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">РАЗЛИЧНИ ПЕРСПЕКТИВИ</h2>
								</div>
								<div class="perspective-grid">
									{perspectives.map((p: any) => (
										<div class="perspective-card">
											<h3 set:html={sanitizeHtml(p.angle)}></h3>
											<p set:html={sanitizeHtml(p.content)}></p>
										</div>
									))}
								</div>
							</section>
						)}

						{/* Media Comparison / Fact Check */}
						{verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0) && (
							<section class="cluster-module cluster-factcheck">
								<div class="cluster-module-head">
									<Newspaper size={18} className="text-foreground" />
									<h2 class="nyt-section-label tracking-[0.2em]">МЕДИУМСКА СПОРЕДБА</h2>
								</div>
								
								<div class="factcheck-grid">
									{verificationReport.agreements?.length > 0 && (
										<div class="factcheck-box factcheck-agreements">
											<div class="flex items-center gap-2 mb-4 text-green-600 dark:text-green-500">
												<ShieldCheck size={16} />
												<h3 class="m-0 text-xs font-black uppercase tracking-widest">Потврдени факти</h3>
											</div>
											<ul class="space-y-3">
												{verificationReport.agreements.map((item: string) => (
													<li class="text-sm leading-relaxed border-l-2 border-green-600/30 pl-3" set:html={sanitizeHtml(cleanAndDecode(item))}></li>
												))}
											</ul>
										</div>
									)}
									
									{verificationReport.conflicts?.length > 0 && (
										<div class="factcheck-box factcheck-conflicts">
											<div class="flex items-center gap-2 mb-4 text-nyt-red">
												<TriangleAlert size={16} />
												<h3 class="m-0 text-xs font-black uppercase tracking-widest">Разлики и нејаснотии</h3>
											</div>
											<ul class="space-y-3">
												{verificationReport.conflicts.map((item: string) => (
													<li class="text-sm leading-relaxed border-l-2 border-nyt-red/30 pl-3" set:html={sanitizeHtml(cleanAndDecode(item))}></li>
												))}
											</ul>
										</div>
									)}
								</div>

								{verificationReport.context && (
									<div class="factcheck-context-note border-t border-border mt-6 pt-6 italic text-muted-foreground text-sm">
										<p set:html={sanitizeHtml(cleanAndDecode(verificationReport.context))}></p>
									</div>
								)}
							</section>
						)}

						{/* Timeline */}
						{cluster.timeline && cluster.timeline.length > 1 && (
							<StoryTimeline timeline={cluster.timeline} client:visible />
						)}

						{/* Articles List */}

						<section class="cluster-module">
							<div class="cluster-module-head">
								<Newspaper size={18} className="text-foreground" />
								<h2 class="nyt-section-label tracking-[0.2em]">КАКО ДА ГО ЧИТАТЕ КЛАСТЕРОТ</h2>
							</div>
							<h2 class="cluster-section-title">Сите Извори</h2>
							<div class="article-list">
								{articleRows.map((a: any) => (
									<div class={`article-row article-row-${a.relationship.tone} group`} data-article-link={encodeURIComponent(a.link || '')}>
										<div class="article-row-top">
											<div class="article-row-source">
												<span class="nyt-section-label text-nyt-red">{a.source}</span>
												<span class={`article-row-badge article-row-badge-${a.relationship.tone}`}>{a.relationship.label}</span>
												{a.sourceSignal?.trust_label && (
													<span class={`article-row-badge article-row-badge-trust article-row-badge-trust-${a.sourceSignal.trust_label === 'Висока доверба' ? 'high' : a.sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>
														{a.sourceSignal.trust_label}
													</span>
												)}
											</div>
											<div class="article-row-time">
												<span class="text-xs text-muted-foreground mr-3">{a.exactTime}</span>
												<span class="text-xs font-bold text-foreground">{a.relativeTime}</span>
											</div>
										</div>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="article-row-link">
											<h3 class="article-row-title" set:html={sanitizeHtml(a.title)}></h3>
										</a>
										<p class="article-row-snippet" set:html={sanitizeHtml(a.description)}></p>
										<div class="article-row-footer">
											<a href={a.link} target="_blank" rel="noopener noreferrer" class="article-row-action">
												Прочитај ја оригиналната објава
												<Link2 size={12} />
											</a>
										</div>
									</div>
								))}
							</div>
						</section>
					</div>

					<aside class="cluster-sidebar">
						<div class="sticky top-24 space-y-8">
							{filteredRelated.length > 0 && (
								<section class="sidebar-module">
									<div class="cluster-module-head">
										<Zap size={18} className="text-nyt-red" />
										<h2 class="nyt-section-label tracking-[0.2em]">ПОВРЗАНО</h2>
									</div>
									<div class="space-y-4">
										{filteredRelated.map((rel: any) => (
											<a href={`/cluster/${rel.cluster_id}`} class="sidebar-related-link group">
												<div class="flex gap-3">
													{rel.image_url && (
														<div class="w-16 h-16 flex-shrink-0">
															<img 
																src={`/proxy?url=${encodeURIComponent(rel.image_url)}&w=120`} 
																alt="" 
																class="w-full h-full object-cover rounded border border-border group-hover:border-nyt-accent transition-colors"
															/>
														</div>
													)}
													<div class="flex-1 min-width-0">
														<p class="text-[10px] font-black uppercase text-nyt-red mb-1">
															{rel.relationship_label || 'Сродна тема'}
														</p>
														<h4 class="font-serif text-sm font-bold leading-tight group-hover:text-nyt-accent transition-colors line-clamp-3">
															{cleanAndDecode(rel.title)}
														</h4>
													</div>
												</div>
											</a>
										))}
									</div>
								</section>
							)}

							<ClusterFollowSuggestionsIsland 
								topic={cluster.topics?.[0] || ''} 
								source={cluster.articles?.[0]?.source || ''}
								adjacentTopic={adjacentTopic}
								client:visible 
							/>
						</div>
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

