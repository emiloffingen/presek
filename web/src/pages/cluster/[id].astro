---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import { Clock, ArrowLeft, Newspaper, Sparkles, MessageCircle, Link2 } from 'lucide-react';

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5001/api";

let cluster = null;
let error = null;

try {
	const res = await fetch(`${API_URL}/cluster/${id}`);
	if (res.ok) {
		const data = await res.json();
		cluster = data.data;
	} else {
		error = "Кластерот не е пронајден.";
	}
} catch (e) {
	console.error(e);
	error = "Грешка при вчитување на податоците.";
}

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function parseSynthesis(text: string) {
    if (!text) return [];
    // Split by lines starting with - [ or just -
    const items = text.split(/\n- /).filter(i => i.trim());
    return items.map(item => {
        const clean = item.startsWith('- ') ? item.substring(2) : item;
        const sourceMatch = clean.match(/^\[(.*?)\]: (.*)/s);
        if (sourceMatch) {
            return { source: sourceMatch[1], content: sourceMatch[2].trim() };
        }
        return { source: null, content: clean.trim() };
    });
}
---

<Layout title={cluster ? cluster.articles[0].title : "Детали за вест"}>
    <NYTHeader />

	<main class="site-layout py-12">
		{error && (
			<div class="py-20 text-center">
				<h2 class="font-serif text-2xl font-black text-nyt-red mb-4">{error}</h2>
				<a href="/" class="nyt-section-label hover:underline">← Назад кон почетна</a>
			</div>
		)}

		{cluster && (
			<article class="max-w-5xl mx-auto">
				<header class="mb-12 border-b border-nyt-gray-300 pb-8">
					<div class="flex items-center gap-4 mb-6">
						<a href="/" class="nyt-section-label flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">
							<ArrowLeft size={12} /> Назад
						</a>
						<span class="nyt-section-label text-nyt-red tracking-widest border-l pl-4 border-nyt-gray-300">
							{cluster.articles[0].category || "Вести"}
						</span>
					</div>

					<h1 class="text-4xl md:text-6xl font-serif font-black leading-none mb-8 text-foreground">
						{cluster.articles[0].title}
					</h1>

					<div class="flex flex-wrap items-center gap-6 nyt-section-label text-muted-foreground border-y border-nyt-gray-200 py-4">
						<span class="flex items-center gap-1"><Clock size={12}/> {getTimeStr(cluster.articles[0].created_at)}</span>
						<span>·</span>
						<span class="flex items-center gap-1"><Newspaper size={12}/> {cluster.articles.length} извори</span>
						<span>·</span>
						<span class="flex items-center gap-1"><Sparkles size={12}/> {cluster.total_reading_time} мин. читање</span>
					</div>
				</header>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<div class="lg:col-span-8 space-y-12">
						{/* AI Synthesis Section */}
						{cluster.synthesis && (
							<section class="bg-nyt-gray-100 dark:bg-secondary p-8 border border-nyt-gray-200 dark:border-nyt-gray-300/20">
								<div class="flex items-center gap-2 mb-6">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ПРЕСЕК СУБЛИМАТ</h2>
								</div>
								<div class="prose-nyt text-lg leading-relaxed text-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-4">
                                        {parseSynthesis(cluster.synthesis).map(item => (
                                            <li class="flex gap-3 items-start">
                                                <span class="text-nyt-accent font-black mt-1">●</span>
                                                <span>
                                                    {item.source && <strong class="nyt-section-label text-[10px] mr-2 text-nyt-accent">[{item.source}]</strong>}
                                                    {item.content}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
								</div>
							</section>
						)}

						{/* Perspectives */}
						{cluster.perspectives && cluster.perspectives.length > 0 && (
							<section class="space-y-10">
								<h2 class="nyt-section-label border-b border-nyt-black dark:border-nyt-gray-300 pb-2 mb-8">РАЗЛИЧНИ ПЕРСПЕКТИВИ</h2>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
									{cluster.perspectives.map((p: any) => (
										<div class="space-y-3">
											<h3 class="font-serif font-black text-lg text-foreground">{p.angle}</h3>
											<p class="text-sm text-muted-foreground leading-relaxed font-serif">{p.content}</p>
										</div>
									))}
								</div>
							</section>
						)}

						{/* Articles List */}
						<section>
							<h2 class="nyt-section-label border-b border-nyt-black dark:border-nyt-gray-300 pb-2 mb-8">СИТЕ ИЗВОРИ</h2>
							<div class="divide-y border-nyt-gray-200">
								{cluster.articles.map((a: any) => (
									<div class="py-6 group">
										<div class="flex justify-between items-start mb-2">
											<span class="nyt-section-label text-nyt-red">{a.source}</span>
											<span class="nyt-section-label text-muted-foreground">{getTimeStr(a.created_at)}</span>
										</div>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="block group">
											<h3 class="font-serif font-black text-xl mb-3 text-foreground group-hover:text-nyt-accent transition-colors leading-tight">
												{a.title}
											</h3>
										</a>
										<p class="text-sm text-muted-foreground line-clamp-2 font-serif mb-4">{a.description}</p>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="nyt-section-label flex items-center gap-1 text-nyt-accent hover:underline">
											<Link2 size={12} /> Прочитај ја целата вест
										</a>
									</div>
								))}
							</div>
						</section>
					</div>

					{/* Sidebar */}
					<aside class="lg:col-span-4 space-y-12">
						{/* Tags */}
						{cluster.tags && cluster.tags.length > 0 && (
							<div class="border-t-2 border-primary dark:border-nyt-gray-300 pt-4">
								<h3 class="nyt-section-label mb-6">ТЕМИ ВО ФОКУС</h3>
								<div class="flex flex-wrap gap-3">
									{cluster.tags.map((tag: string) => (
										<a href={`/?q=${encodeURIComponent(tag)}`} class="nyt-section-label text-[9px] border border-nyt-gray-300 px-2 py-1 hover:bg-nyt-black hover:text-white transition">
											{tag}
										</a>
									))}
								</div>
							</div>
						)}

						{/* AI Chat Island (Coming Soon Style) */}
						<div class="bg-nyt-gray-100 dark:bg-secondary p-6 border border-nyt-gray-200 dark:border-nyt-gray-300/20">
							<h3 class="nyt-section-label flex items-center gap-2 mb-4 text-foreground">
								<MessageCircle size={14} /> ПРАШАЈ ГО ПРЕСЕК
							</h3>
							<p class="font-serif italic text-xs text-muted-foreground leading-relaxed mb-6">
								Имате прашање за оваа вест? Нашиот систем ги спореди сите извори и може да ви одговори на дополнителни прашања.
							</p>
							<div class="bg-background border border-nyt-gray-300 p-4 text-center">
								<span class="nyt-section-label text-muted-foreground text-[10px]">НАСКОРО</span>
							</div>
						</div>

						{/* Related */}
						{cluster.related && cluster.related.length > 0 && (
							<div class="space-y-8">
								<h3 class="nyt-section-label border-b border-nyt-black pb-2">ПОВРЗАНИ ВЕСТИ</h3>
								{cluster.related.map((rel: any) => (
									<a href={`/cluster/${rel.cluster_id}`} class="block group no-underline">
										<h4 class="font-serif font-black text-sm text-foreground group-hover:text-nyt-accent transition-colors leading-tight">
											{rel.title}
										</h4>
									</a>
								))}
							</div>
						)}
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

<style>
	.prose-nyt {
		font-family: var(--font-nyt-body);
        max-width: 65ch; /* Rule 5: Limit line length */
        margin-left: auto;
        margin-right: auto;
	}
    .prose-nyt ul li {
        margin-bottom: 1.5em; /* Rule 4: Paragraph spacing */
    }
    .divide-y > * + * {
		border-top-width: 1px;
	}
</style>
