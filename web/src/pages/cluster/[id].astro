---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import AskPresekIsland from '../../components/AskPresekIsland.tsx';
import ClusterFollowSuggestionsIsland from '../../components/ClusterFollowSuggestionsIsland.tsx';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import { chooseClusterImage } from '../../utils/imageSelection';
import { cleanAndDecode } from '../../utils/textUtils';
import { Clock, ArrowLeft, Newspaper, Sparkles, MessageCircle, Link2 } from 'lucide-react';
import { apiBaseUrl } from '../../lib/apiBase';

const { id } = Astro.params;
const API_URL = apiBaseUrl();

let cluster = null;
let error = null;

try {
	const res = await fetch(`${API_URL}/cluster/${id}`);
	if (res.ok) {
		const data = await res.json();
		cluster = data.data;
	} else {
		error = "Кластерот не е пронајден.";
	}
} catch (e) {
	console.error(e);
	error = "Грешка при вчитување на податоците.";
}

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function getRelativeTimeStr(dateStr: string) {
	try {
		const date = new Date(dateStr);
		const diffMs = Date.now() - date.getTime();
		const diffMinutes = Math.max(1, Math.round(diffMs / 60000));
		if (diffMinutes < 60) return `пред ${diffMinutes} мин`;
		const diffHours = Math.round(diffMinutes / 60);
		if (diffHours < 24) return `пред ${diffHours} ч`;
		const diffDays = Math.round(diffHours / 24);
		return `пред ${diffDays} д`;
	} catch {
		return '';
	}
}

function topicHref(value: string) {
	const normalized = String(value || '').trim();
	return normalized ? `/tema/${encodeURIComponent(normalized)}` : '/';
}

function titleTerms(text: string) {
	return Array.from(
		new Set(
			(text || '')
				.toLowerCase()
				.match(/[a-zа-ш0-9]{3,}/g)?.filter(
					(token) => !['вест', 'вести', 'извор', 'извори', 'денес', 'утре', 'вчера'].includes(token)
				) || []
		)
	);
}

function getRelationshipMeta(title: string, leadTitle: string, index: number) {
	if (index === 0) {
		return {
			label: 'Водечки извор',
			tone: 'lead',
			description: 'Најдиректна и најцелосна верзија на главниот развој.',
		};
	}

	const leadTerms = titleTerms(leadTitle);
	const currentTerms = titleTerms(title);
	const overlapCount = currentTerms.filter((token) => leadTerms.includes(token)).length;
	const overlap = overlapCount / Math.max(Math.min(leadTerms.length, currentTerms.length), 1);

	if (overlap >= 0.5) {
		return {
			label: 'Го потврдува главниот развој',
			tone: 'confirm',
			description: 'Носи слична главна линија како водечкиот извор.',
		};
	}

	if (overlap >= 0.24) {
		return {
			label: 'Додава контекст',
			tone: 'context',
			description: 'Ја проширува приказната со дополнителни детали или реакција.',
		};
	}

	return {
		label: 'Различен агол',
		tone: 'contrast',
		description: 'Го осветлува настанот од друг аспект или со поинаков акцент.',
	};
}

function parseSynthesis(text: string) {
    if (!text) return [];
    const normalized = text
        .replace(/^Статии:\s*/i, '')
        .replace(/\r/g, '')
        .trim();

    const lines = normalized
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean)
        .filter((line) => line.toLowerCase() !== 'статии:');

    const items = [];
    let current = '';

    for (const line of lines) {
        const isBullet = /^[-•]\s+/.test(line) || /^\[[^\]]+\]:/.test(line);
        if (isBullet) {
            if (current) items.push(current.trim());
            current = line.replace(/^[-•]\s+/, '');
        } else if (current) {
            current += ` ${line}`;
        } else {
            current = line;
        }
    }
    if (current) items.push(current.trim());

    return items
        .map((item) => {
            const sourceMatch = item.match(/^\[(.*?)\]:\s*(.*)$/s);
            if (sourceMatch) {
                return {
                    source: sourceMatch[1],
                    content: cleanAndDecode(sourceMatch[2].trim()),
                };
            }
            return { source: null, content: cleanAndDecode(item.trim()) };
        })
        .filter((item) => item.content && item.content.toLowerCase() !== 'статии:');
}

function normalizePerspectives(items: any[]) {
    if (!Array.isArray(items)) return [];

    return items
        .map((item) => {
            if (typeof item === 'string') {
                const content = cleanAndDecode(item.trim());
                return content ? { angle: 'Перспектива', content } : null;
            }

            if (!item || typeof item !== 'object') return null;

            const angle = String(
                item.angle ?? item.label ?? item.title ?? item.name ?? 'Перспектива'
            ).trim();
            const content = cleanAndDecode(String(
                item.content ?? item.text ?? item.description ?? ''
            ).trim());

            if (!content) return null;
            return { angle: angle || 'Перспектива', content };
        })
        .filter(Boolean);
}

const perspectives = cluster ? normalizePerspectives(cluster.perspectives) : [];
const synthesisItems = cluster?.synthesis ? parseSynthesis(cluster.synthesis) : [];
const leadArticle = cluster?.articles?.[0];
const articleRows = cluster
	? cluster.articles.map((article: any, index: number) => ({
			...article,
			title: cleanAndDecode(article.title),
			description: cleanAndDecode(article.description),
			relationship: getRelationshipMeta(article.title, leadArticle?.title || article.title, index),
			sourceSignal: article.source_signal || null,
			exactTime: getTimeStr(article.created_at),
			relativeTime: getRelativeTimeStr(article.created_at),
	  }))
	: [];
const suggestedQuestions = [
	'Што е најважното ново во оваа вест?',
	'Како се разликуваат изворите во известувањето?',
	'Што останува нејасно или непотврдено?',
];
const leadDescription =
	cluster?.articles?.find((article: any) => article?.description?.trim())?.description?.trim() || '';
const sourcePreview = cluster?.articles?.slice(0, 3).map((article: any) => article.source).filter(Boolean) || [];

const summaryCardText =
	cluster?.summary ||
	leadDescription ||
	`Овој кластер спојува ${cluster?.articles?.length || 0} извори за да ги покаже заедничките факти, разликите во акцентот и што останува неразјаснето.`;

const synthesisUpdatedAt = cluster?.synthesis_updated_at || '';
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false, new_article_count: 0, reasons: [] };
const adjacentTopic =
	cluster?.related?.find((item: any) => item?.shared_topics?.length)?.shared_topics?.[0] ||
	cluster?.related?.find((item: any) => item?.shared_tags?.length)?.shared_tags?.[0] ||
	'';
const shareDescription = (
	cluster?.summary ||
	leadDescription ||
	summaryCardText
).replace(/\s+/g, ' ').trim().slice(0, 220);
const shareImage = cluster ? `/og/cluster/${cluster.cluster_id}.svg?v=1` : '/og-image.svg';

function getLeadVisual(clusterData: any) {
	const selected = chooseClusterImage(clusterData, 'hero');
	if (!selected.proxiedUrl) return null;

	return {
		src: selected.proxiedUrl,
		rawUrl: selected.rawUrl,
		isWeak: selected.isWeak,
	};
}

const leadVisual = cluster ? getLeadVisual(cluster) : null;
---

<Layout
	title={cluster ? cleanAndDecode(cluster.articles[0].title) : "Детали за вест"}
	description={cluster ? cleanAndDecode(shareDescription) : "Детали за вест од Пресек"}
	image={shareImage}
	type={cluster ? "article" : "website"}
>
    <NYTHeader />

	<main class="site-layout py-12">
		{error && (
			<div class="py-20 text-center">
				<h2 class="font-serif text-2xl font-black text-nyt-red mb-4">{error}</h2>
				<a href="/" class="nyt-section-label hover:underline">← Назад кон почетна</a>
			</div>
		)}

		{cluster && (
			<article class="cluster-shell">
				<ReaderTracker
					client:load
					clusterId={cluster.cluster_id}
					title={cluster.articles[0].title}
					category={cluster.articles[0].category || ''}
					topic={cluster.topics?.[0] || cluster.articles[0].topic || ''}
					primarySource={cluster.articles[0].source || ''}
					sources={cluster.articles.map((article: any) => article.source).filter(Boolean)}
					tags={cluster.tags || []}
				/>
				<header class="cluster-header motion-rise">
					<div class="cluster-header-grid">
						<div class="cluster-header-copy">
							<div class="cluster-header-top">
								<a href="/" class="nyt-section-label flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">
									<ArrowLeft size={12} /> Назад
								</a>
								<a href={topicHref(cluster.articles[0].category || "Вести")} class="nyt-section-label text-nyt-red tracking-widest border-l pl-4 border-nyt-gray-300 hover:text-foreground transition-colors">
									{cluster.articles[0].category || "Вести"}
								</a>
							</div>

							<h1 class="cluster-headline">
								{cleanAndDecode(cluster.articles[0].title)}
							</h1>

							{leadDescription && <p class="cluster-dek">{cleanAndDecode(leadDescription)}</p>}

							<div class="cluster-header-meta">
								<span class="flex items-center gap-1"><Clock size={12}/> {getTimeStr(cluster.articles[0].created_at)}</span>
								<span>·</span>
								<span class="flex items-center gap-1"><Newspaper size={12}/> {cluster.articles.length} извори</span>
								<span>·</span>
								<span class="flex items-center gap-1"><Sparkles size={12}/> {cluster.total_reading_time} мин. за преглед</span>
								{synthesisUpdatedAt && (
									<>
										<span>·</span>
										<span class:list={["cluster-refresh-badge", synthesisFreshness.is_stale ? "is-stale" : "is-fresh"]}>
											{synthesisFreshness.is_stale
												? "Ново известување по синтезата"
												: `Синтеза ажурирана ${getRelativeTimeStr(synthesisUpdatedAt)}`}
										</span>
									</>
								)}
							</div>
							<div class="cluster-preference-actions">
								<PreferenceToggle client:load kind="topic" value={cluster.topics?.[0] || cluster.articles[0].topic || cluster.articles[0].category || ''} label="ја темата" />
							</div>
						</div>

						<div class="cluster-header-side">
							{leadVisual && leadVisual.rawUrl && (
								<div class:list={["cluster-visual-card", leadVisual.isWeak ? "is-weak" : ""]}>
									{leadVisual.isWeak ? (
										<div class="cluster-visual-fallback">
											<p class="cluster-visual-kicker">Пресек Преглед</p>
											<h2>{cluster.articles[0].category || 'Главна Приказна'}</h2>
											<p>{cluster.articles.length} извори · {sourcePreview.slice(0, 2).join(' · ')}</p>
										</div>
									) : (
										<img
											src={leadVisual.src}
											alt={cluster.articles[0].title}
											class="cluster-visual-image"
											loading="eager"
										/>
									)}
								</div>
							)}
							<div class="cluster-summary-card">
								<p class="cluster-summary-label">Во кратки црти</p>
								<div class="cluster-summary-copy">
									{cleanAndDecode(summaryCardText).split('\n').map((line: string) => (
										<p class="mb-2 last:mb-0">{line}</p>
									))}
								</div>
								{sourcePreview.length > 0 && (
									<p class="cluster-summary-sources">
										<span>Извори:</span> {sourcePreview.join(' · ')}
									</p>
								)}
								{synthesisUpdatedAt && (
									<p class:list={["cluster-summary-update", synthesisFreshness.is_stale ? "is-stale" : ""]}>
										{synthesisFreshness.is_stale
											? `${synthesisFreshness.new_article_count || 1} нови извештаи се појавиле по последната синтеза.`
											: `Последна синтеза: ${getRelativeTimeStr(synthesisUpdatedAt)}.`}
									</p>
								)}
							</div>
						</div>
					</div>
				</header>

				<div class="cluster-grid">
					<div class="cluster-main motion-rise motion-delay-1">
						{/* AI Synthesis Section */}
						{cluster.synthesis && synthesisItems.length > 0 && (
							<section class="cluster-synthesis">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">ПРЕСЕК СУБЛИМАТ</h2>
								</div>
								<div class="prose-nyt text-lg leading-relaxed text-foreground font-serif">
									<ul class="list-none p-0 m-0 space-y-4">
                                        {synthesisItems.map(item => (
                                            <li class="flex gap-3 items-start">
                                                <span class="text-nyt-accent font-black mt-1">●</span>
                                                <span>
                                                    {item.source && <strong class="nyt-section-label text-[10px] mr-2 text-nyt-accent">[{item.source}]</strong>}
                                                    {item.content}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
								</div>
							</section>
						)}

						{/* Perspectives */}
						{perspectives.length > 0 && (
							<section class="cluster-synthesis cluster-perspectives">
								<div class="cluster-module-head">
									<Sparkles size={18} className="text-nyt-accent" />
									<h2 class="nyt-section-label text-nyt-accent tracking-[0.2em]">РАЗЛИЧНИ ПЕРСПЕКТИВИ</h2>
								</div>
								<div class="perspective-grid">
									{perspectives.map((p: any) => (
										<div class="perspective-card">
											<h3>{p.angle}</h3>
											<p>{p.content}</p>
										</div>
									))}
								</div>
							</section>
						)}

						{/* Articles List */}
						<section class="cluster-module">
							<h2 class="cluster-section-title">Сите Извори</h2>
							<div class="article-list">
								{articleRows.map((a: any) => (
									<div class={`article-row article-row-${a.relationship.tone} group`}>
										<div class="article-row-top">
											<div class="article-row-source">
												<span class="nyt-section-label text-nyt-red">{a.source}</span>
												<span class={`article-row-badge article-row-badge-${a.relationship.tone}`}>{a.relationship.label}</span>
												{a.sourceSignal?.trust_label && (
													<span class={`article-row-badge article-row-badge-trust article-row-badge-trust-${a.sourceSignal.trust_label === 'Висока доверба' ? 'high' : a.sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>
														{a.sourceSignal.trust_label}
													</span>
												)}
											</div>
											<div class="article-row-time">
												<span class="nyt-section-label text-muted-foreground lowercase first-letter:uppercase">{a.relativeTime}</span>
												<span class="text-muted-foreground opacity-40">·</span>
												<span class="article-row-time-exact">{a.exactTime}</span>
											</div>
										</div>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="block group">
											<h3 class="article-row-title">
												{a.title}
											</h3>
										</a>
										{a.sourceSignal?.role_label && (
											<p class="article-row-trust">
												<strong>{a.sourceSignal.role_label}</strong>{a.sourceSignal.source_category ? ` · ${a.sourceSignal.source_category}` : ''}
											</p>
										)}
										<p class="article-row-note">{a.relationship.description}</p>
										{a.sourceSignal?.role_note && (
											<p class="article-row-note article-row-note-trust">{a.sourceSignal.role_note}</p>
										)}
										<p class="article-row-summary">{a.description}</p>
										<a href={a.link} target="_blank" rel="noopener noreferrer" class="nyt-section-label flex items-center gap-1 text-nyt-accent hover:underline">
											<Link2 size={12} /> Отвори го оригиналот
										</a>
									</div>
								))}
							</div>
						</section>
					</div>

					{/* Sidebar */}
					<aside class="cluster-rail motion-rise motion-delay-2">
						{cluster.topics && cluster.topics.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Тема</h3>
								<div class="rail-tags">
									{cluster.topics.map((item: string) => (
										<a href={topicHref(item)} class="rail-chip rail-chip-topic">
											{item}
										</a>
									))}
								</div>
							</div>
						)}

						{/* Tags */}
						{cluster.tags && cluster.tags.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Теми Во Фокус</h3>
								<div class="rail-tags">
									{cluster.tags.map((tag: string) => (
										<a href={`/?q=${encodeURIComponent(tag)}`} class="rail-chip">
											{tag}
										</a>
									))}
								</div>
							</div>
						)}

						{/* AI Chat Island (Coming Soon Style) */}
						<div class="rail-card rail-card-accent">
							<h3 class="rail-card-title flex items-center gap-2 text-foreground">
								<MessageCircle size={14} /> ПРАШАЈ ГО ПРЕСЕК
							</h3>
							<AskPresekIsland client:load clusterId={cluster.cluster_id} suggestedQuestions={suggestedQuestions} />
						</div>

						<div class="rail-card">
							<ClusterFollowSuggestionsIsland
								client:load
								topic={cluster.topics?.[0] || cluster.articles[0].topic || cluster.articles[0].category || ''}
								source={cluster.articles[0].source || ''}
								adjacentTopic={adjacentTopic}
							/>
						</div>

						{/* Related */}
						{cluster.related && cluster.related.length > 0 && (
							<div class="rail-card">
								<h3 class="rail-card-title">Поврзани Вести</h3>
								<div class="related-list">
								{cluster.related.map((rel: any) => (
									<a href={`/cluster/${rel.cluster_id}`} class="related-link group no-underline">
										{rel.relationship_label && <p class="related-kicker">{rel.relationship_label}</p>}
										<h4>
											{cleanAndDecode(rel.title)}
										</h4>
										{(rel.shared_entities?.length || rel.shared_tags?.length) > 0 && (
											<p class="related-meta">
												{rel.shared_entities?.length > 0 ? `Имиња: ${rel.shared_entities.join(' · ')}` : ''}
												{rel.shared_entities?.length > 0 && rel.shared_tags?.length > 0 ? ' · ' : ''}
												{rel.shared_tags?.length > 0 ? `Теми: ${rel.shared_tags.join(' · ')}` : ''}
											</p>
										)}
									</a>
								))}
								</div>
							</div>
						)}
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

<style>
	.cluster-shell {
		max-width: 76rem;
		margin: 0 auto;
	}

	.cluster-header {
		padding-bottom: 0.9rem;
		margin-bottom: 1.1rem;
		border-bottom: 1px solid var(--border);
	}

	.cluster-header-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.cluster-header-top {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.9rem;
	}

	.cluster-headline {
		font-size: clamp(1.76rem, 1.3rem + 1vw, 3.35rem);
		line-height: 1.12;
		letter-spacing: -0.028em;
		margin: 0 0 0.55rem;
		max-width: 15ch;
		text-wrap: balance;
	}

	.cluster-dek {
		margin: 0;
		max-width: 58ch;
		font-family: var(--font-nyt-body);
		font-size: 1rem;
		line-height: 1.58;
		color: var(--secondary-foreground);
		text-wrap: pretty;
	}

	.cluster-header-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		padding-top: 0.7rem;
		margin-top: 0.7rem;
		border-top: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.cluster-preference-actions {
		margin-top: 0.8rem;
	}

	.cluster-refresh-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.45rem;
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cluster-refresh-badge.is-fresh {
		color: var(--nyt-accent);
		border-color: color-mix(in srgb, var(--nyt-accent) 38%, var(--border) 62%);
	}

	.cluster-refresh-badge.is-stale {
		color: var(--nyt-red);
		border-color: color-mix(in srgb, var(--nyt-red) 38%, var(--border) 62%);
	}

	.cluster-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.cluster-main,
	.cluster-rail {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.cluster-module,
	.cluster-synthesis,
	.rail-card {
		padding: 1rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 84%, var(--surface-soft) 16%);
	}

	.cluster-rail .rail-card {
		padding: 0.9rem;
	}

	.cluster-summary-card {
		padding: 0.95rem 1rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 80%, var(--surface-soft) 20%);
	}

	.cluster-visual-card {
		margin-bottom: 0.9rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 84%, var(--surface-soft) 16%);
