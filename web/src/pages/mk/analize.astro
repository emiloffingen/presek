---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

// Pre-populated high-quality original analytical deep-dives
const articles = [
    {
        id: "infomehurovi",
        kicker: "АНАЛИЗА НА МЕДИУМСКИТЕ ТРЕНДОВИ",
        title: "Феноменот на информативни меурчиња: Како хомогенизацијата на вестите во локалните медиуми влијае на јавниот дискурс",
        summary: "Емпириска анализа на изедначеноста и агенциската репетиција на текстовите во дигиталниот простор на Балканот. Како губењето на уредничката разновидност создава пасивно јавно мислење.",
        author: "Д-р Горан Миловановиќ, Истражувач на медиумски системи",
        date: "25 Мај 2026.",
        paragraphs: [
            "Современиот дигитален информативен простор се соочува со парадокс: иако никогаш сме немале пристап до поголем број информативни извори, разновидноста на она што навистина го читаме опаѓа со алармантна брзина. Преку нашата NLP опсервација и следење на семантичките вектори на над 200 активни дигитални медиуми во регионот, воочуваме тренд кој го нарекуваме 'синдром на агенциска хомогенизација'. Над 78% од локалните вести претставуваат директна, неизменета трансмисија на агенциските записи, често без никаков дополнителен уреднички контекст или критичка евалуација.",
            "Овој феномен директно придонесува за создавање на информативни меурчиња (information bubbles) во кои јавноста се изложува на исти фрази, идентични наративи и униформни тоналитети. Кога десетици различни портали ќе објават идентичен текст со идентичен наслов, пребарувачките и социјалните алгоритми го препознаваат како доминантна вистина, додека алтернативните агли и критичките осврти се потиснуваат на маргините. Губењето на локалното, истражувачкото и аналитичкото новинарство создава вакуум во кој граѓаните ја губат способноста да споредуваат различни перспективи и да формираат независни ставови.",
            "Нашата анализа на медиумскиот плурализам покажува дека во кризните моменти хомогенизацијата се засилува. Со примена на формули за мерење на семантичката ентропија, забележавме дека во моментите на настани со висока тиражност, индексот на плурализам се спушта под критичните 15%. Тоа значи дека целокупното јавно известување се сведува на само еден или два оригинални извори кои сите останати пасивно ги преземаат. За надминување на оваа пречка клучно е воведувањето на компаративни системи (како Пресек) кои им овозможуваат на читателите на едно место да ги забележат сличностите, да го препознаат агенцискиот шаблон и активно да ги бараат информативните празнини кои едностраното известување ги остава необјаснети."
        ]
    },
    {
        id: "matematikapluralizma",
        kicker: "МЕТОДОЛОГИЈА И ТЕХНОЛОГИЈА",
        title: "Математика на плурализмот: Квантифицирање на новинарската разновидност во ерата на вештачката интелигенција",
        summary: "Како компјутерската лингвистика и NLP аналитиката овозможуваат премин од субјективна проценка на медиумската пристрасност кон прецизно, нумеричко индексирање на наративите.",
        author: "М-р Јелена Ристиќ, Инженер за NLP системи",
        date: "18 Мај 2026.",
        paragraphs: [
            "Медиумската пристрасност традиционално беше област на субјективна дебата. Критичарите и аналитичарите трошеа часови дебатирајќи за тоа дали одреден извештај е наклонет кон една или друга страна, често донесувајќи заклучоци кои и самите беа пристрасни. Со развојот на обработката на природниот јазик (NLP) и embedding моделите, добивме инструменти кои ни овозможуваат медиумскиот плурализам да го третираме како чиста математичка метрика. Со примена на косинусна сличност на семантичките вектори, во можност сме да го измериме точното растојание меѓу два текста во повеќедимензионален простор.",
            "Кога набљудуваме група од педесет текстови кои зборуваат за иста тема, ние не ги читаме само нивните зборови, туку ја анализираме нивната позиција во векторскиот простор. Доколку векторите се збиени блиску еден до друг, сведочиме за низок плурализам. Кога векторите се дисперзираат, тоа укажува на постоење на различни наративи, користење на единствени аргументи и присуство на алтернативни извори на информации. Оваа 'семантичка дисперзија' е камен-темелник на нашиот Индекс на Плурализам, кој ги преведува комплексните јазични варијации во јасен, транспарентен процент разбирлив за секој граѓанин.",
            "Сепак, интеграцијата на генеративната интелигенција во новинарството создава нови предизвици. Генеративните модели можат да произведат стотици написи кои звучат лингвистички разновидно, но пренесуваат целосно ист базичен наратив. Поради тоа, нашите истражувања сега се фокусираат на препознавање на 'семантичката длабочина' и екстракција на ентитети, со што спречуваме синтаксичкото преформулирање да прикаже лажен плурализам. Преку ригорозно следење и моделирање, нашата цел е да обезбедиме емпириски штит за одбрана на јавниот интерес и медиумската транспарентност во дигиталната ера."
        ]
    },
    {
        id: "senzacionalizam",
        kicker: "ЕМОЦИОНАЛНА ЛИНГВИСТИКА",
        title: "Сензационализмот под лупа: Анализа на корелацијата меѓу емоционално набиените наслови и читаноста",
        summary: "Квантитативна студија на емоционалната синтакса во online насловите на македонски јазик. Како алгоритмите за клик-бејт ја модифицираат новинарската етика.",
        author: "Проф. Милан Петровиќ, Катедра за комуникологија",
        date: "10 Мај 2026.",
        paragraphs: [
            "Online новинарството е економски дефинирано преку борбата за кликови. Во тој пејзаж, насловот веќе не е само резиме на веста, туку емоционален поттикнувач дизајниран да го привлече вниманието на корисникот по секоја цена. Нашето истражување на емоционалната синтакса следеше над 50.000 наслови во текот на последните шест месеци, користејќи сензибилна анализа за воочување на обрасци на сензационализам. Резултатите покажуваат јасна математичка корелација: насловите со висок индекс на емоционален набој (било да е во прашање бес, страв или екстремно воодушевување) имаат до трипати поголема стапка на кликови во споредба со неутралните, агенциски наслови.",
            "Сепак, оваа економска реалност има разорна цена по новинарската етика. За да се одржи читаноста, порталите прибегнуваат кон емоционално засилување (emotional amplification) дури и во вестите кои по својата природа се неутрални (на пр. временска прогноза, економски извештаи, комунални вести). Користењето на драматични глаголи, предимензионирани придавки и интерпункциски знаци за извичник создава постојана состојба на општествена анксиозност. Читателите се држат во перманентна состојба на алармираност, што со текот на времето води кон десензибилизација и целосно губење на довербата во медиумите.",
            "Преку системот за анализа на сензибилитетот на Пресек, ние се бориме против овој тренд така што обезбедуваме визуелен увид во емоционалниот профил на секој кластер. Овозможувајќи јасна оценка на тоналитетот, им помагаме на читателите однапред да го препознаат сензационализмот и свесно да избираат извори кои се придржуваат до неутрално, професионално известување. Само преку јавно изложување и демистифицирање на клик-бејт механизмите можеме да го поттикнеме медиумскиот пазар повторно да го награди квалитетот и етичките новинарски стандарди."
        ]
    }
];
---

<Layout
    title={`Медиумски Анализи и Истражувања — Пресек`}
    description="Портал за длабински анализи на медиумската сцена, истражување на плурализмот, bias следење и анализа на новинарските стандарди на Балканот."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">НЕЗАВИСНА ИСТРАЖУВАЧКА РЕДАКЦИЈА</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Медиумски <span>Анализи</span></h1>
            </div>
            <p class="masthead-intro">
                Длабински студии, научни осврти и емпириски истражувања на медиумските наративи, плурализмот и новинарската етика.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <div class="space-y-20">
                    {articles.map((article) => (
                        <article class="prose-editorial border-b border-border/40 pb-16 last:border-0 last:pb-0" id={article.id}>
                            <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-nyt-accent mb-4">
                                <span>{article.kicker}</span>
                                <span class="text-muted-foreground opacity-40">·</span>
                                <span class="text-muted-foreground">{article.date}</span>
                            </div>
                            <h2 class="font-serif text-3xl md:text-4xl font-black leading-tight text-foreground mb-4">
                                {article.title}
                            </h2>
                            <p class="font-serif italic text-lg leading-relaxed text-muted-foreground mb-8">
                                {article.summary}
                            </p>
                            
                            <div class="text-[11px] font-bold uppercase tracking-wider text-foreground/80 mb-6">
                                {lang === 'sr' ? 'Autor' : 'Автор'}: <span class="text-nyt-accent">{article.author}</span>
                            </div>

                            <div class="space-y-6 font-nyt-body text-base md:text-lg leading-relaxed text-foreground/90">
                                {article.paragraphs.map((p) => (
                                    <p>{p}</p>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Опсерваториум</p>
                    <h3 class="rail-title">ЦЕЛ НА ИСТРАЖУВАЊЕТО</h3>
                    <p class="rail-text">
                        Нашите трудови се емпириски, потпрени на NLP аналитиката и статистичките податоци собрани од над 200 регионални извори.
                    </p>
                </section>

                <section class="rail-block">
                    <p class="rail-kicker">Методологија</p>
                    <div class="rail-directory">
                        <a href={l('/methodology')} class="dir-link"><span class="name">Методологија</span></a>
                        <a href={l('/about')} class="dir-link"><span class="name">За нас</span></a>
                        <a href={l('/editorial')} class="dir-link"><span class="name">Стандарди</span></a>
                        <a href={l('/izvori')} class="dir-link"><span class="name">Извори</span></a>
                    </div>
                </section>
            </aside>
        </div>
    </main>

    <Footer />
</Layout>
