const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

function getRelativeTimeStr(dateStr: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) {
            const label = diffHours === 1 ? t('news.hour') : t('news.hours');
            return `${t('news.ago')} ${diffHours} ${label}`;
        }

        const diffDays = Math.floor(diffHours / 24);
        const label = diffDays === 1 ? t('news.day') : t('news.days');
        return `${t('news.ago')} ${diffDays} ${label}`;
    } catch (e) {
        return '';
    }
}

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        return date.toLocaleTimeString(lang === 'sr' ? 'sr-RS' : 'mk-MK', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Belgrade'
        });
    } catch {
        return '';
    }
}

const parseBriefItem = (item: string, lang: string) => {
    const clean = item.trim();
    // Match prefix up to colon (only allow alphabetic/Cyrillic characters, spaces, and hyphens of length 3-20 to prevent splitting on timestamps like "06:00")
    const match = clean.match(/^([A-Za-z\u0400-\u04FF\s\-]{3,20}):\s*(.*)$/);
    if (match) {
        const prefix = match[1].trim();
        const content = match[2].trim();
        
        // Determine category and badge styling
        let badgeText = prefix;
        let badgeClass = "bg-muted text-muted-foreground";
        
        const lowerPrefix = prefix.toLowerCase();
        if (lowerPrefix.includes("настан") || lowerPrefix.includes("фокус") || lowerPrefix.includes("развој") || lowerPrefix.includes("nadan") || lowerPrefix.includes("događaj") || lowerPrefix.includes("fokus") || lowerPrefix.includes("razvoj")) {
            badgeText = lang === "sr" ? "Fokus" : "Фокус";
            badgeClass = "bg-nyt-accent/15 text-nyt-accent border border-nyt-accent/25";
        } else if (lowerPrefix.includes("детали") || lowerPrefix.includes("детал") || lowerPrefix.includes("detalji") || lowerPrefix.includes("detalj")) {
            badgeText = lang === "sr" ? "Detalji" : "Детали";
            badgeClass = "bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/25";
        } else if (lowerPrefix.includes("медиум") || lowerPrefix.includes("покриеност") || lowerPrefix.includes("medij") || lowerPrefix.includes("pokrivenost") || lowerPrefix.includes("izvori") || lowerPrefix.includes("извори")) {
            badgeText = lang === "sr" ? "Izvori" : "Извори";
            badgeClass = "bg-green-500/15 text-green-600 dark:text-green-400 border border-green-500/25";
        } else if (lowerPrefix.includes("отворено") || lowerPrefix.includes("нејасно") || lowerPrefix.includes("otvoreno") || lowerPrefix.includes("nejasno")) {
            badgeText = lang === "sr" ? "Otvoreno" : "Отворено";
            badgeClass = "bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/25";
        }
        
        return { hasBadge: true, badgeText, badgeClass, content };
    }
    return { hasBadge: false, badgeText: "", badgeClass: "", content: clean };
};

const highlightFactText = (text: string) => {
    let html = text;
    // Highlight money amounts (e.g. 500.000 евра, 500.000 evra, половина милион евра, пола милион)
    const moneyRegex = /(\d+[\beta\s\.]*(?:евра|evra|денари|denara|динара|dinara|EUR|€)|половина милион евра|polovina milion evra|пола милион евра|pola miliona evra)/gi;
    html = html.replace(moneyRegex, '<strong class="text-nyt-accent font-black">$1</strong>');

    // Highlight locations or borders (e.g. ГП Табановце, Tabanovce, Германија, Germanija, Албанија, Albanija)
    const locationRegex = /(ГП\s+Табановце|Табановце|Tabanovce|Германија|Germanija|Албанија|Albanija)/gi;
    html = html.replace(locationRegex, '<strong class="text-foreground font-semibold">$1</strong>');
    
    return html;
};

import { sanitizeHtml } from '../../../lib/sanitize';
import { Newspaper, Clock, Link2, Zap, Sparkles, ShieldCheck, TriangleAlert, BarChart3, Radio, Search, ExternalLink, BookOpen, ListChecks } from 'lucide-react';
import EntityContextCard from '../../../components/EntityContextCard.tsx';
import ClusterHeader from '../../../components/Cluster/ClusterHeader.astro';
import HeroVisual from '../../../components/Cluster/HeroVisual.astro';

import CitationSources from '../../../components/Cluster/CitationSources.astro';
import CredibilityAnalysis from '../../../components/Cluster/CredibilityAnalysis.astro';
import ArticleItem from '../../../components/Cluster/ArticleItem.astro';
import EditorialNarrative from '../../../components/Cluster/EditorialNarrative.astro';
import type { Article, ClusterDetail } from '../../../types';

const { slug } = Astro.params;
const API_URL = apiBaseUrl();
const SITE_URL = 'https://presek.mk';

// Extract ID from slug (handles both legacy 8-char and new 12-char dashed IDs)
const idMatch = slug?.match(/^([0-9a-f]{8}-[0-9a-f]{3,4}|[0-9a-f]{8,12})/);
const id = idMatch ? idMatch[0] : slug?.split('-')[0];

let cluster: ClusterDetail | null = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/cluster/${id}?lang=${lang}`);
    if (!res.ok) {
        if (res.status === 404) {
            error = lang === 'sr' ? 'Klaster nije pronađen.' : 'Кластер не е пронајден.';
            Astro.response.status = 404;
        } else {
            error = lang === 'sr' ? 'Greška pri učitavanju podataka.' : 'Грешка при вчитување на податоците.';
            Astro.response.status = 500;
        }
    } else {
      const payload = await res.json();
      cluster = payload.data;
    }
    } catch (e) {
    Astro.response.status = 500;
    error = lang === 'sr' ? 'Neuspešno povezivanje sa serverom.' : 'Неуспешно поврзување со серверот.';
}

const mainArticle = cluster?.articles?.[0];
const cleanSourceDocumentText = (text: unknown) => cleanAndDecode(String(text || '')
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/^\s*(?:(?:IZVORNI|IZVOREN)\s+ZAPIS|(?:ИЗВОРНИ|ИЗВОРЕН)\s+ЗАПИС)\s*(?:\([^)]+\))?/i, '')
    .replace(/\b(?:Podeli\s+vest|Spodeli\s+vest|Подели\s+вест|Сподели\s+вест|Сподели\s+ја\s+веста)\s*:?\s*/gi, ' ')
    .replace(/\b(?:Oglas|Оглас)\b/gi, ' ')
    .replace(/\b(?:Pročitajte\s+još|Прочитајте\s+још|Procitajte\s+povece|Прочитајте\s+повеќе|Прочитајте\s+уште)\b.*$/i, ' ')
    .replace(/\s+/g, ' ')
    .trim());
const sourceDocArticle = cluster?.articles?.find((article) => {
    const text = cleanSourceDocumentText(article.full_content);
    return text.length > 0;
});
const sourceDocText = sourceDocArticle ? cleanSourceDocumentText(sourceDocArticle.full_content) : '';
const displayHeadline = cluster?.synthetic_headline || (mainArticle ? cleanAndDecode(mainArticle.title) : (lang === 'sr' ? 'Detalji vesti' : 'Детали за веста'));

// --- SEO Slug Enforcement ---
// If the current slug is just the ID or doesn't match the headline slug,
// we perform a 301 redirect to the "Correct" SEO URL.
const currentHeadlineSlug = slugify(displayHeadline);
const canonicalSlug = `${id}-${currentHeadlineSlug}`;
const canonicalPathSlug = id && cluster && currentHeadlineSlug ? canonicalSlug : (id || 'cluster');

if (slug !== canonicalSlug && !error && cluster) {
    const targetPath = `${lang === 'sr' ? `/cluster/${canonicalSlug}` : `/mk/cluster/${canonicalSlug}`}${Astro.url.search}`;
    return Astro.redirect(targetPath, 301);
}

const headlineIsCyrillic = isMostlyCyrillic(displayHeadline);

const allSourcesNames: string[] = Array.from(new Set((cluster?.articles || []).map((a: Article) => a.source)));
const sourcePreview = allSourcesNames.slice(0, 5);
const uniqueSourcesCount = allSourcesNames.length;
const hasCitationSources = false; // Feature disabled as per user request

const synthesisUpdatedAt = cluster?.synthesis_updated_at;
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false };

const perspectives = cluster?.perspectives || [];
const verificationReport = cluster?.verification_report || null;
const generatedArticle = cluster?.generated_article || null;

type SynthesisItem = { source: string | null; content: string };

const synthesisItems: SynthesisItem[] = (cluster?.ai_summary_bullets?.length ? cluster.ai_summary_bullets : (cluster?.synthesis || '').split('\n'))
    .filter((line: string) => line.trim().length > 10)
    .map((line: string) => {
        const match = line.match(/^\[(.*?)\]\s*(.*)/);
        if (match) {
            return { source: match[1], content: cleanAndDecode(match[2]) };
        }
        return { source: null, content: cleanAndDecode(line) };
    });

const articleRows = (cluster?.articles || []).map((a: Article, idx: number, arr: Article[]) => {
    const d = new Date(a.created_at);
    const signal = a.source_signal || {};
    const timelineEntry = (cluster?.timeline || []).find((item) => item.article_id === a.id);

    // 1. Dynamic Journalistic Role (Timeline)
    let relLabel: string = t('cluster.rel_related');
    let relTone = 'neutral';

    if (timelineEntry?.is_first) {
        relLabel = t('cluster.rel_initial');
        relTone = 'origin';
    } else if (idx === 0 && !synthesisFreshness.is_stale) {
        relLabel = t('cluster.rel_latest');
        relTone = 'latest';
    } else if (timelineEntry?.milestone?.toLowerCase() === 'konsenzus') {
        relLabel = lang === 'sr' ? 'KONSENZUS' : 'КОНСЕНЗУС';
        relTone = 'deep';
    } else if (timelineEntry?.is_major) {
        relLabel = lang === 'sr' ? 'GLAVNA POTVRDA' : 'ГЛАВНА ПОТВРДА';
        relTone = 'deep';
    } else if (signal.role_label) {
        relLabel = signal.role_label.toUpperCase();
        relTone = signal.role_tone || 'deep';
    } else if ((a.credibility || 0) > 1.2) {
        relLabel = t('cluster.rel_deep');
        relTone = 'deep';
    }

    // 2. Individual Quality Signals
    const isObjective = (a.credibility || 0) >= 1.4 || signal.trust_label === 'Visoko poverenje';
    const isSensational = (a.credibility || 0) < 0.8 && !isObjective;

    return {
        ...a,
        title: deShout(cleanAndDecode(a.title)),
        description: cleanAndDecode(a.description || a.summary || ''),
        exactTime: d.toLocaleTimeString('mk-RS', { hour: '2-digit', minute: '2-digit' }),
        relativeTime: getRelativeTimeStr(a.created_at),
        relationship: { tone: relTone, label: relLabel },
        quality: { isObjective, isSensational }
    };
});

const relatedClusters = cluster?.related || [];
const filteredRelated = relatedClusters.filter((c: { cluster_id: string }) => c.cluster_id !== id).slice(0, 5);

const adjacentTopic = cluster?.topics?.find((t: string) => t !== 'Srbija') || cluster?.topics?.[0];

const canonicalUrl = `https://presek.mk/cluster/${canonicalPathSlug}`;
const shareDescription = synthesisItems[0]?.content || mainArticle?.description || '';

function getLeadVisual(c: ClusterDetail | null) {
    if (!c) return null;
    const res = { src: '/img/placeholder.svg', rawUrl: '', isWeak: true };
    const main = c.articles?.[0];
    if (main?.image_url && main.image_url.startsWith('http')) {
        res.src = `/proxy?url=${encodeURIComponent(main.image_url)}&w=1200`;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    } else if (main?.image_url && main.image_url.startsWith('/static/generated/')) {
        res.src = main.image_url;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    }
    return res;
}
const leadVisual = getLeadVisual(cluster);
const imageUrl = leadVisual && !leadVisual.isWeak ? leadVisual.src : '/img/presek_emblem.png';

const headerBriefItems = synthesisItems.length > 0 
    ? synthesisItems.map((item: SynthesisItem) => item.content).filter((line: string) => line.trim().length > 4).slice(0, 4)
    : (mainArticle?.description ? [mainArticle.description] : []);

function normalizeBriefItem(item: string, previousItems: string[]) {
    let text = String(item || '')
        .replace(/^\s*[•\-]\s*/, '')
        .replace(/\bPrati\s+([2-9]|\d{2,})\s+izvori\b/i, 'Prati $1 izvora')
        .trim();
    const labelMatch = text.match(/^([^:]{2,40}):\s*(.+)$/);
    const label = labelMatch ? labelMatch[1].trim().toLocaleLowerCase() : '';
    const body = labelMatch ? labelMatch[2].trim() : text;
    const normalizedBody = body
        .toLocaleLowerCase()
        .replace(/[^\p{L}\p{N}\s]/gu, '')
        .replace(/\s+/g, ' ')
        .trim();
    if (
        (label.includes('detalj') || label.includes('детал')) &&
        previousItems.some((prev) => {
            const normalizedPrev = prev
                .toLocaleLowerCase()
                .replace(/^[^:]{2,40}:\s*/, '')
                .replace(/[^\p{L}\p{N}\s]/gu, '')
                .replace(/\s+/g, ' ')
                .trim();
            return normalizedPrev === normalizedBody || normalizedPrev.includes(normalizedBody) || normalizedBody.includes(normalizedPrev);
        })
    ) {
        return '';
    }
    if (
        (label.includes('otvoreno') || label.includes('отворено')) &&
        (/detalji oko ovog razvoja ostaju nepotvr/i.test(body) || /деталите околу овој развој остануваат непотв/i.test(body))
    ) {
        return lang === 'sr'
            ? 'Otvoreno: nije izdvojena konkretna sporna činjenica; treba pratiti sledeće dopune izvora, ne tretirati ovu stavku kao potvrđen sukob.'
            : 'Отворено: не е издвоен конкретен спорен факт; треба да се следат следните дополнувања од изворите, а не ова да се чита како потврден судир.';
    }
    return text;
}

const displayHeaderBriefItems = headerBriefItems.reduce((items: string[], item: string) => {
    const normalized = normalizeBriefItem(item, items);
    if (normalized) items.push(normalized);
    return items;
}, []).slice(0, 4);

const hasGeneratedNarrative = Boolean(generatedArticle && generatedArticle.trim());
const hasSublimat = synthesisItems.length > 0;
const hasFactcheck = Boolean(verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0));
const hasStrongLeadNarrative = hasGeneratedNarrative && (cluster?.articles?.length || 0) >= 3;
const primaryNarrativeLabel = lang === 'sr' ? 'PREGLED PRIČE' : 'ПРЕСЕК НА ПРИКАЗНАТА';
const primaryNarrativeEyebrow = lang === 'sr' ? 'Šta je potvrđeno, šta nedostaje' : 'Што е потврдено, што недостига';
const conflictsCount = verificationReport?.conflicts?.length || 0;

const isFiniteMetric = (value: unknown) => Number.isFinite(typeof value === 'number' ? value : Number(value));
const rawToneAnalysis = cluster?.tone_analysis || cluster?.sentiment?.tone_analysis || null;
const hasToneAnalysis = Boolean(
    rawToneAnalysis &&
    (isFiniteMetric(rawToneAnalysis.objectivity) || isFiniteMetric(rawToneAnalysis.sensationalism) || isFiniteMetric(rawToneAnalysis.emotional_charge))
);
const sentimentData = hasToneAnalysis ? {
    sentiment: (cluster?.sentiment && 'sentiment' in cluster.sentiment ? cluster.sentiment.sentiment : cluster?.sentiment) || { score: 0, tone: 'neutralno' },
    tone_analysis: rawToneAnalysis
} : null;

const firstArticle = cluster?.articles?.length
    ? [...cluster.articles].sort((left: Article, right: Article) => new Date(left.created_at).getTime() - new Date(right.created_at).getTime())[0]
    : null;
const latestArticle = cluster?.articles?.[0] || null;
const allRawEntities = [
    ...(cluster?.analyst_entities || []),
    ...(cluster?.entities || []),
    ...(cluster?.tags || []),
];
const sharedEntities = normalizeAndDeduplicateTags(allRawEntities, lang).slice(0, 4);

const keyEntities = normalizeAndDeduplicateTags(allRawEntities, lang)
    .filter((name: string) => name && name.trim().length >= 2)
    .slice(0, 5);
const primaryTopics = Array.from(new Set([
    ...(cluster?.topics || []),
    ...(cluster?.articles || []).map((article: Article) => article.topic).filter(Boolean),
])).slice(0, 3);
const primaryCategory = cluster?.articles?.[0]?.category || '';
const foldedClusterText = [
    displayHeadline,
    primaryCategory,
    ...primaryTopics,
    ...(cluster?.tags || []),
].join(' ').toLowerCase();
const isWeatherStory = /vreme|vrijeme|време|сончев|дожд|грмеж|температур|prognoz|прогноз|oblac|облач|sunčan|сунчан|kiš|киш/.test(foldedClusterText);
const isSportsStory = /sport|спорт|utakmic|натпревар|liga|лига|fudbal|фудбал|košark|кошарк|tenis|тенис/.test(foldedClusterText);
const storyKindLabel = (() => {
    if (isWeatherStory) return lang === 'sr' ? 'VREMENSKA PROGNOZA' : 'ВРЕМЕНСКА ПРОГНОЗА';
    if (isSportsStory) return lang === 'sr' ? 'SPORTSKI SIGNAL' : 'СПОРТСКИ СИГНАЛ';
    if (primaryCategory) return cleanAndDecode(primaryCategory).toUpperCase();
    return lang === 'sr' ? 'TEMATSKI SIGNAL' : 'ТЕМАТСКИ СИГНАЛ';
})();
const topicLabelMap: Record<string, { sr: string; mk: string }> = {
    vesti: { sr: 'Vesti', mk: 'Вести' },
    zivot: { sr: 'Život', mk: 'Живот' },
    život: { sr: 'Život', mk: 'Живот' },
    politika: { sr: 'Politika', mk: 'Политика' },
    ekonomija: { sr: 'Ekonomija', mk: 'Економија' },
    sport: { sr: 'Sport', mk: 'Спорт' },
    tehnologija: { sr: 'Tehnologija', mk: 'Технологија' },
    kultura: { sr: 'Kultura', mk: 'Култура' },
};
function cleanTopicLabel(value?: string) {
    const clean = cleanAndDecode(value || '').trim();
    if (!clean) return '';
    const mapped = topicLabelMap[clean.toLowerCase()];
    if (mapped) return lang === 'sr' ? mapped.sr : mapped.mk;
    return clean;
}
const displayTopicSignals = Array.from(new Set([
    ...(isWeatherStory ? [lang === 'sr' ? 'Vreme' : 'Време'] : []),
    ...primaryTopics
        .map((topic: string) => cleanTopicLabel(topic))
        .filter((topic: string) => topic && !['Vesti', 'Вести'].includes(topic)),
    cleanTopicLabel(primaryCategory),
])).filter(Boolean).slice(0, 3);
const hasConflicts = conflictsCount > 0;
const isSingleSource = uniqueSourcesCount <= 1;
const clusterStatus = (() => {
    if (synthesisFreshness.is_stale) {
        return {
            label: lang === 'sr' ? 'SINTEZA ZASTARELA' : 'СИНТЕЗАТА Е ЗАСТАРЕНА',
            description: lang === 'sr'
                ? 'Stigli su noviji izvori; pregled treba čitati uz izvorni zapis.'
                : 'Пристигнале понови извори; прегледот треба да се чита со изворниот запис.',
            tone: 'stale',
        };
    }
    if (isSingleSource) {
        return {
            label: lang === 'sr' ? 'JEDAN IZVOR' : 'ЕДЕН ИЗВОР',
            description: lang === 'sr'
                ? 'Klaster trenutno ima jednu redakciju; tretirajte ga kao rani signal.'
                : 'Кластерот моментално има една редакција; третирајте го како ран сигнал.',
            tone: 'early',
        };
    }
    if (hasConflicts) {
        return {
            label: lang === 'sr' ? 'VIŠE IZVORA, RAZLIKE' : 'ПОВЕЌЕ ИЗВОРИ, РАЗЛИКИ',
            description: lang === 'sr'
                ? 'Izvori pokrivaju istu priču, ali se razlikuju u detaljima ili naglasku.'
                : 'Изворите ја покриваат истата приказна, но се разликуваат во детали или нагласок.',
            tone: 'mixed',
        };
    }
    return {
        label: lang === 'sr' ? 'VIŠE IZVORA' : 'ПОВЕЌЕ ИЗВОРИ',
        description: isWeatherStory
            ? (lang === 'sr'
                ? 'Grupisano prema istoj prognozi, području i bliskom vremenu objave.'
                : 'Групирано според иста прогноза, подрачје и блиско време на објава.')
            : (lang === 'sr'
                ? 'Grupisano po zajedničkoj temi, akterima i bliskom vremenu objave.'
                : 'Групирано според заедничка тема, актери и блиско време на објава.'),
        tone: 'verified',
    };
})();

const evidenceItems = [
    {
        label: lang === 'sr' ? 'Redakcije' : 'Редакции',
        value: String(uniqueSourcesCount),
        detail: sourcePreview.join(' · '),
    },
    ...(cluster?.pluralism_score != null ? [{
        label: lang === 'sr' ? 'Indeks Pluralizma' : 'Индекс на Плурализам',
        value: `${cluster.pluralism_score}%`,
        detail: cluster.narrative_diversity?.verdict ? `“${cluster.narrative_diversity.verdict.slice(0, 60)}...”` : (lang === 'sr' ? 'Raznolikost perspektiva' : 'Разновидност на перспективи'),
    }] : []),
    {
        label: lang === 'sr' ? 'Prva objava' : 'Прва објава',
        value: firstArticle?.source || '—',
        detail: firstArticle?.created_at ? getRelativeTimeStr(firstArticle.created_at) : '',
    },
    {
        label: lang === 'sr' ? 'Poslednji razvoj' : 'Последен развој',
        value: latestArticle?.source || '—',
        detail: latestArticle?.created_at ? getRelativeTimeStr(latestArticle.created_at) : '',
    },
    {
        label: lang === 'sr' ? 'Ključne oznake' : 'Клучни ознаки',
        value: sharedEntities.length && !isWeatherStory ? sharedEntities.slice(0, 2).join(', ') : (displayTopicSignals[0] || '—'),
        detail: displayTopicSignals.slice(sharedEntities.length && !isWeatherStory ? 0 : 1).join(' · '),
    },
].filter((item) => item.value && item.value !== '—');

const describeRelatedEvidence = (rel: any) => {
    const pieces = [
        ...(rel.shared_entities || []).slice(0, 2),
        ...(rel.shared_topics || []).slice(0, 2),
        ...(rel.shared_tags || []).slice(0, 2),
    ].filter(Boolean);
    if (pieces.length) return pieces.join(' · ');
    return rel.relationship_note || '';
};

// --- Momentum Kicker Logic ---
const totalSourcesCount = cluster?.articles?.length || 0;
const isBreakingFlag = cluster?.articles?.some((a: Article) => a.is_breaking) || false;

let momentumKicker = { label: 'REDAKCISKI UVID', color: 'text-muted-foreground' };
if (isBreakingFlag && totalSourcesCount >= 4) {
    momentumKicker = { label: 'UDAREN NARATIV', color: 'text-nyt-red' };
} else if (conflictsCount >= 3) {
    momentumKicker = { label: 'KONTRADIKTOREN razvoj', color: 'text-amber-600' };
} else if (totalSourcesCount >= 6) {
    momentumKicker = { label: 'SEOPFATEN INTERES', color: 'text-emerald-700 dark:text-emerald-500' };
} else if (totalSourcesCount >= 2 && !synthesisFreshness.is_stale) {
    momentumKicker = { label: 'KONSOLIDIRAN PREGLED', color: 'text-blue-700 dark:text-blue-500' };
}

// --- SEO & Schema ---
// Prefer a high-res representative image or the lead article visual for social sharing.
// Generated SVG is used only as a last resort fallback.
const socialImageUrl = cluster?.representative_image || (leadVisual && !leadVisual.isWeak ? leadVisual.rawUrl : imageUrl);

const articleSchema = cluster ? {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": displayHeadline,
	"description": cluster.generated_article?.slice(0, 200) || cluster.synthesis?.slice(0, 200) || displayHeadline,
	"image": cluster.representative_image || (leadVisual?.rawUrl?.startsWith('http') ? leadVisual.rawUrl : "https://presek.live/static/img/presek_emblem.png"),
	"datePublished": cluster.articles?.[cluster.articles.length - 1]?.created_at,
	"dateModified": cluster.synthesis_updated_at || cluster.articles?.[0]?.created_at,
	"author": {
		"@type": "Organization",
		"name": "PRESEK.mk",
		"url": "https://presek.mk"
	},
	"publisher": {
		"@type": "Organization",
		"name": "PRESEK.mk",
		"logo": {
			"@type": "ImageObject",
			"url": "https://presek.mk/static/img/presek_emblem.png"
		}
	}
} : null;
---

<Layout
	title={displayHeadline}
	description={cluster?.generated_article?.slice(0, 160) || cluster?.synthesis?.slice(0, 160) || shareDescription}
	image={socialImageUrl}
	type="article"
	canonical={canonicalUrl}
	schema={articleSchema || undefined}
>
	<NYTHeader topic={cluster?.topics?.[0]} />

	<ReaderTracker
        clusterId={id || ''}
        title={displayHeadline}
        category={cluster?.articles?.[0]?.category}
        topic={cluster?.topics?.[0]}
        primarySource={cluster?.articles?.[0]?.source}
        sources={allSourcesNames}
        tags={cluster?.tags}
        client:idle
    />

	<main class="site-layout py-0">
		<div class="scroll-progress-container">
			<div class="scroll-progress-bar" id="reading-progress"></div>
		</div>

		<div class="editorial-container max-w-[1440px] mx-auto px-2 sm:px-4 md:px-10">
		<Breadcrumbs items={[
			{ label: cluster?.articles?.[0]?.category || 'vesti', href: cluster?.articles?.[0]?.category ? `/mk/?category=${cluster.articles[0].category}` : '/mk' },
			{ label: adjacentTopic || 'Detali' }
		]} />

		{error ? (
			<div class="py-20 text-center">
				<h1 class="text-2xl font-serif mb-4">{error}</h1>
				<a href="/mk" class="text-nyt-accent hover:underline">Nazad na pocetna</a>
			</div>
		) : cluster && (
			<article class="cluster-article-container" style={cluster.dominant_color ? `--cluster-accent: ${cluster.dominant_color};` : ''}>
				{/* 1. THE LEDE */}
			<header class="editorial-header-v2 py-10 md:py-12 mb-16 md:mb-20">
				<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-[var(--grid-gap)]">
					<div class="header-main-info flex-grow min-w-0">
						<div class="edition-kicker flex items-center gap-[var(--grid-gap)] mb-6">
							<span class="edition-badge bg-foreground text-background px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em]">
								{t(getEditionStr(cluster.articles?.[0].created_at) as any)}
							</span>
							<span class="header-date text-[10px] font-bold uppercase tracking-[0.2em] text-muted-foreground border-l border-border pl-4">
								{new Date(cluster.articles?.[0].created_at || '').toLocaleDateString(lang === 'sr' ? 'sr-RS' : 'mk-MK', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
							</span>
						</div>
						<h1 class="headline is-visible font-serif text-5xl md:text-7xl font-black leading-[1.05] tracking-tight text-foreground mb-6">
							{displayHeadline}
						</h1>
						<div class="header-meta flex flex-wrap items-center gap-x-8 gap-y-3 text-[11px] font-black uppercase tracking-widest text-muted-foreground">
							<div class="flex items-center gap-[var(--grid-gap)]">
								<div class="w-3 h-3 rounded-full bg-nyt-accent"></div>
								<span class="text-foreground">{cluster.articles?.[0].category || (lang === 'sr' ? 'GENERALNO' : 'ГЕНЕРАЛНО')}</span>
							</div>
							<span class="border-l border-border pl-8">{uniqueSourcesCount} {lang === 'sr' ? 'REDAKCIJA' : 'РЕДАКЦИИ'}</span>
							<span class:list={["hidden md:inline border-l border-border pl-8 cluster-status-text", `tone-${clusterStatus.tone}`]}>{storyKindLabel}</span>
						</div>
					</div>
					<div class="header-actions shrink-0 flex gap-[var(--grid-gap)] pb-1">
						<ShareIsland client:load title={displayHeadline} url={canonicalUrl} />
					</div>
				</div>
				<div class:list={["cluster-evidence-strip mt-10", `tone-${clusterStatus.tone}`]}>
					<div class="cluster-evidence-status">
						<span>{clusterStatus.label}</span>
						<p>{clusterStatus.description}</p>
					</div>
					<div class="cluster-evidence-grid">
						{evidenceItems.map((item) => (
							<div class="cluster-evidence-item">
								<span>{item.label}</span>
								<strong>{item.value}</strong>
								{item.detail && <p>{item.detail}</p>}
							</div>
						))}
					</div>
				</div>
				<div class="reader-command-bar" aria-label={lang === 'sr' ? 'Kontrole čitanja' : 'Контроли за читање'}>
					<div class="reader-source-strip">
						<span>{lang === 'sr' ? 'Izvori' : 'Извори'}</span>
						<strong>{uniqueSourcesCount} {lang === 'sr' ? 'redakcija u pregledu' : 'редакции во прегледот'}</strong>
					</div>
					<div class="reader-actions">
						<a href="#cluster-synthesis"><BookOpen size={14} /> {primaryNarrativeLabel}</a>
						<a href="#cluster-sources"><ListChecks size={14} /> {lang === 'sr' ? 'Izvori' : 'Извори'}</a>
						<button type="button" data-reader-toggle aria-pressed="false">
							<BookOpen size={14} />
							<span data-reader-label>{lang === 'sr' ? 'Fokus' : 'Фокус'}</span>
						</button>
					</div>
				</div>
			</header>

					{/* 2. HERO GRID (Visual) */}
					<div class="hero-full mb-24" id="cluster-visual">
						<HeroVisual
							leadVisual={leadVisual}
							dominantColor={cluster.dominant_color || undefined}
							displayHeadline={displayHeadline}
							id={id || ''}
							category={cluster.articles?.[0].category || ''}
							sourcePreview={sourcePreview}
							articlesCount={cluster.articles?.length || 0}
						/>
						</div>
							{/* EXECUTIVE SUMMARY / BRIFING - Compact Horizontal Layout */}
							{(displayHeaderBriefItems.length > 0 || (cluster.key_facts && cluster.key_facts.length > 0)) && (
								<div class="executive-summary mb-12 p-6 bg-secondary/5 border border-border/60 hover:border-nyt-accent/30 transition-all shadow-sm">
								<div class="flex items-center gap-[var(--grid-gap)] mb-6 border-b border-border/20 pb-3">
									<Sparkles size={16} className="text-nyt-accent" />
									<span class="text-[11px] font-black uppercase tracking-[0.25em] text-nyt-accent">{t('cluster.brief_overview')}</span>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
									{displayHeaderBriefItems.length > 0 && (
										<div>
											<h4 class="text-[9px] font-black uppercase tracking-[0.12em] text-muted-foreground mb-4">{t('cluster.key_points')}</h4>
											<ul class="space-y-3">
												{displayHeaderBriefItems.map(item => {
													const { hasBadge, badgeText, badgeClass, content } = parseBriefItem(item, lang);
													return (
														<li class="flex items-start gap-3 font-sans text-[13px] md:text-[14px] leading-relaxed text-foreground/85 not-italic">
															{hasBadge ? (
																<span class={`flex-shrink-0 text-[8px] font-black uppercase tracking-wider px-2 py-0.5 rounded-sm mt-0.5 ${badgeClass}`}>
																	{badgeText}
																</span>
															) : (
																<span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-nyt-accent/60"></span>
															)}
															<span class="flex-1">{content}</span>
														</li>
													);
												})}
											</ul>
										</div>
									)}
									{cluster.key_facts && cluster.key_facts.length > 0 && (
										<div class="border-t md:border-t-0 md:border-l border-border/40 pt-6 md:pt-0 md:pl-8">
											<h4 class="text-[9px] font-black uppercase tracking-[0.12em] text-muted-foreground mb-4">{t('cluster.system_data')}</h4>
											<ul class="space-y-3">
												{cluster.key_facts.map((fact: string) => (
													<li class="font-sans text-[13px] md:text-[14px] font-medium leading-relaxed text-foreground/75 flex items-start gap-2">
														<span class="text-nyt-accent text-lg mt-[-2px] flex-shrink-0">›</span>
														<span class="flex-1" set:html={highlightFactText(fact)}></span>
													</li>
												))}
											</ul>
										</div>
									)}
								</div>
								</div>
							)}

						<div class="editorial-grid">
						{/* 3. MAIN COLUMN */}
						<div class="editorial-main-col">

							{/* NARRATIVE SECTION */}
						{(hasGeneratedNarrative || synthesisItems.length > 0) && (
						<section class="editorial-section narrative-section mb-24" id="cluster-synthesis">
							<div class="section-eyebrow narrative-eyebrow mb-16">
                                <div class="section-title-lockup">
                                    <Newspaper size={16} className="section-title-icon text-muted-foreground" />
                                    <div class="section-title-copy">
                                        <h2 class="section-label">{primaryNarrativeLabel}</h2>
                                        <span class="section-sub-label">{primaryNarrativeEyebrow}</span>
                                    </div>
                                </div>

                                <!-- Premium TTS Play Button -->
                                {cluster && (
                                    <div class="narrative-audio-wrap">
                                        <AudioPlayer 
                                            type="cluster"
                                            clusterId={id}
                                            lang={lang}
                                            title={lang === 'sr' ? 'Audio sinteza' : 'Аудио синтеза'}
                                        />
                                    </div>
                                )}

								<div class="section-divider"></div>
							</div>

							<EditorialNarrative
								hasStrongLeadNarrative={hasStrongLeadNarrative}
								generatedArticle={generatedArticle}
								synthesisItems={synthesisItems}
								hasCitationSources={hasCitationSources}
							entities={cluster.entities}
							/>
						</section>
						)}

						{/* ANALYSIS SECTION: Fact Check & Comparison */}
						{(hasFactcheck || perspectives.length > 0) && (
							<CredibilityAnalysis
								hasFactcheck={hasFactcheck}
								verificationReport={verificationReport}
								perspectives={perspectives}
								hasCitationSources={hasCitationSources}
                                pluralismScore={cluster?.pluralism_score}
                                toneAnalysis={sentimentData?.tone_analysis}
							/>
						)}

						{/* ALL SOURCES LIST */}
						<section class="editorial-section sources-section mb-24 border-t border-border/40 pt-12" id="cluster-sources">
							<div class="section-eyebrow mb-16">
								<Newspaper size={18} className="text-muted-foreground" />
								<h2 class="section-label">{t('cluster.source_docs')}</h2>
								<span class="section-sub-label">{lang === 'sr' ? 'Hronološki pregled medijskih izveštaja' : 'Хронолошки преглед на медиумските извештаи'}</span>
								<div class="section-divider"></div>
							</div>

							{sourceDocArticle && sourceDocText && (
								<div class="mb-10 source-doc-wrapper" id="cluster-source-document">
									<details class="group source-details">
										<summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer hover:bg-secondary/10 transition-colors list-none">
											<div class="flex items-center gap-[var(--grid-gap)]">
												<div class="w-2 h-8 bg-nyt-accent"></div>
												<h4 class="text-[11px] font-black uppercase tracking-[0.2em] text-foreground">
													{lang === 'sr' ? 'Pun izvorni zapis' : 'Целосен изворен запис'} ({sourceDocArticle.source})
												</h4>
											</div>
											<div class="text-muted-foreground group-open:rotate-180 transition-transform duration-300">
												<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
											</div>
										</summary>
										<div class="px-6 md:px-8 pb-8">
											<div class="prose-editorial max-w-none pt-6 border-t border-border/20 max-h-[400px] overflow-y-auto custom-editorial-scrollbar">
												<div class="font-nyt-body text-lg md:text-xl text-foreground/80 leading-[1.8] whitespace-pre-wrap">
													{sourceDocText}
												</div>
											</div>
											<div class="mt-8 flex justify-end">
												<a href={sourceDocArticle.link} target="_blank" rel="noopener noreferrer" class="text-[11px] font-black uppercase tracking-[0.2em] text-nyt-accent hover:underline flex items-center gap-[var(--grid-gap)] bg-background px-6 py-3 rounded-full border border-nyt-accent/20 shadow-sm transition-all hover:shadow-md">
													{lang === 'sr' ? 'Pročitaj ceo zapis na' : 'Прочитај го целиот запис на'} {sourceDocArticle.source} <ExternalLink size={14} />
												</a>
											</div>
										</div>
									</details>
								</div>
							)}

							<div class="editorial-article-list editorial-timeline">
								<div class="timeline-v-line"></div>
								{articleRows.map((a: any) => (
									<ArticleItem article={a} />
								))}
							</div>
						</section>

						{/* RELATED SECTION */}
						{filteredRelated.length > 0 && (
							<section class="editorial-section related-section mb-24 border-t border-border/40 pt-16">
								<div class="section-eyebrow mb-16">
									<Zap size={20} className="text-nyt-red" />
									<h2 class="section-label">{t('cluster.related_content')}</h2>
									<div class="section-divider"></div>
								</div>
								<div class="related-editorial-grid">
									{filteredRelated.map((rel: any) => {
						const relSlug = slugify(rel.title);
						const relUrl = `/mk/cluster/${rel.cluster_id}-${relSlug}`;
						const evidence = describeRelatedEvidence(rel);
						return (
											<a href={relUrl} class="related-card group">
												<div class="related-card-content">
													<div class="flex justify-between items-center mb-4">
														<span class="related-source text-[9px] font-black uppercase tracking-[0.15em] text-nyt-red">
															{rel.relationship_label || t('cluster.related_topic')}
														</span>
														{rel.created_at && <span class="text-[9px] font-bold text-muted-foreground uppercase">{getRelativeTimeStr(rel.created_at)}</span>}
													</div>
													<h3 class="related-title font-serif text-lg md:text-xl font-bold leading-tight group-hover:text-nyt-red transition-colors">
														{deShout(cleanAndDecode(rel.title))}
													</h3>
													{evidence && (
														<p class="related-evidence mt-4 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">
															{evidence}
														</p>
													)}
												</div>
											</a>
										);
									})}
								</div>
							</section>
						)}
                        {/* ADVANCED ANALYTICS */}
                        <section class="editorial-section advanced-tools mb-24">
                            <details class="advanced-tools-details">
                                <summary class="advanced-tools-summary">
                                    <div class="section-eyebrow">
                                        <Radio size={20} className="text-muted-foreground" />
                                        <h2 class="section-label">{t('cluster.deep_synthesis')}</h2>
                                        <span class="section-sub-label">{lang === 'sr' ? 'Dodatni alati za kontekst' : 'Дополнителни алатки за контекст'}</span>
                                        <div class="section-divider"></div>
                                    </div>
                                    <span class="advanced-toggle-label">{lang === 'sr' ? 'Otvori' : 'Отвори'}</span>
                                </summary>
                                <div class="deep-dive-tabs">
                                    <input type="radio" name="deep-dive-tabs" id="deep-tab-history" checked />
                                    {allSourcesNames.length >= 2 && <input type="radio" name="deep-dive-tabs" id="deep-tab-sources" />}

                                    <div class="deep-tab-list" role="tablist" aria-label={t('cluster.deep_synthesis')}>
                                        <label for="deep-tab-history" class="deep-tab-trigger">{lang === 'sr' ? 'Razvoj priče' : 'Развој на приказната'}</label>
                                        {allSourcesNames.length >= 2 && <label for="deep-tab-sources" class="deep-tab-trigger">{lang === 'sr' ? 'Izvori' : 'Извори'}</label>}
                                    </div>

                                    <div class="deep-tab-panel deep-tab-history">
                                        <StorylineHistoryIsland client:visible clusterId={id || ''} apiUrl={API_URL} lang={lang} />
                                        <ClusterHistoryIsland client:visible clusterId={id || ''} lang={lang} />
                                    </div>
                                    {allSourcesNames.length >= 2 && (
                                        <div class="deep-tab-panel deep-tab-sources">
                                            <SourceComparisonIsland allSources={allSourcesNames} lang={lang} client:visible />
                                        </div>
                                    )}
                                </div>
                            </details>
                        </section>

					</div>

					{/* 4. SIDEBAR COLUMN */}
					<aside class="editorial-sidebar-col">
						<div class="sticky-sidebar space-y-12">
                            {/* NEW: Data Anchors in Sidebar */}
                            {sentimentData && isFiniteMetric(sentimentData.tone_analysis?.objectivity) && isFiniteMetric(sentimentData.tone_analysis?.sensationalism) && isFiniteMetric(sentimentData.tone_analysis?.emotional_charge) && (
                                <div class="sidebar-module">
                                    <h4 class="sidebar-label">{t('cluster.media_pulse')}</h4>
                                    <div class="mt-4">
                                        <MediaPulseRadar data={sentimentData} lang={lang} client:visible />
                                    </div>
                                </div>
                            )}

                            <div class="sidebar-module">
                                <h4 class="sidebar-label">{t('cluster.source_spectrum')}</h4>
                                <div class="mt-6">
                                    <SourceSpectrum articles={cluster.articles.map((a: Article) => ({ source: a.source })) as any} client:visible />
                                </div>
                            </div>

							<NewsletterIsland lang={lang} client:visible />

							<ClusterFollowSuggestionsIsland
								topic={cluster.topics?.[0] || ''}
								source={cluster.articles?.[0]?.source || ''}
								adjacentTopic={adjacentTopic}
                                lang={lang}
								client:visible
							/>

							{keyEntities && keyEntities.length > 0 && (
								<div class="sidebar-module">
									<h4 class="sidebar-label">{t('cluster.key_entities')}</h4>
									<div class="flex flex-col gap-[var(--grid-gap)] mt-4">
											{keyEntities.map((name: string) => (
											<EntityContextCard name={name} lang="mk" client:visible />
										))}
									</div>
								</div>
							)}
						</div>
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

<style>
	.page-container {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

    .scroll-progress-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: transparent;
        z-index: 10001;
        pointer-events: none;
    }

    .scroll-progress-bar {
        height: 100%;
        background: var(--cluster-accent, var(--nyt-accent));
        width: 0%;
        transition: width 0.1s ease-out;
        box-shadow: 0 0 15px var(--cluster-accent, var(--nyt-accent));
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

	.cluster-article-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem;
        width: 100%;
        box-sizing: border-box;
        animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	/* --- 1. EDITORIAL HEADER V2 --- */
    .editorial-header-v2 {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    }

	.editorial-header-v2 .headline {
		letter-spacing: -0.04em;
        text-wrap: balance;
	}

    .edition-badge {
        border-radius: var(--radius-sm, 0px);
        letter-spacing: 0.14em;
    }

    .header-date,
    .header-meta {
        letter-spacing: 0.08em;
    }

    .header-meta {
        font-weight: 850;
    }

    .cluster-status-text.tone-verified { color: #047857; }
    .cluster-status-text.tone-mixed { color: #b45309; }
    .cluster-status-text.tone-early,
    .cluster-status-text.tone-stale { color: var(--nyt-red); }

    .cluster-evidence-strip {
        display: grid;
        grid-template-columns: minmax(0, 0.82fr) minmax(0, 2.4fr);
        gap: 0;
        background: color-mix(in srgb, var(--secondary) 32%, var(--background));
        border: 1px solid var(--border);
        border-radius: var(--radius-md, 0px);
        overflow: hidden;
        box-shadow: none;
    }

    .cluster-evidence-status,
    .cluster-evidence-item {
        background: transparent;
