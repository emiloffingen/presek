---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import PulseClientContainer from '../../components/PulseClientContainer';

import { apiBaseUrl } from '../../lib/apiBase';
import { Activity, Timer, Zap } from 'lucide-react';

const API_URL = apiBaseUrl();
let initialPulseData = null;
let globalPulse: any = null;
let categories: string[] = [];
let ssrFailed = false;

try {
    const [pulseRes, globalRes, catRes] = await Promise.all([
        fetch(`${API_URL}/intelligence/source-pulse?lang=mk`),
        fetch(`${API_URL}/intelligence/global-pulse?lang=mk`),
        fetch(`${API_URL}/categories`)
    ]);
    
    if (pulseRes.ok) {
        const json = await pulseRes.json();
        initialPulseData = json.data || [];
    } else {
        ssrFailed = true;
    }

    if (globalRes.ok) {
        globalPulse = await globalRes.json();
    } else {
        ssrFailed = true;
    }

    if (catRes.ok) {
        const json = await catRes.json();
        categories = (json.categories || []).map((c: any) => c.name);
    }
} catch (e) {
    console.error("Pulse SSR error:", e);
    ssrFailed = true;
}

const safePulseVolume = Math.max(1, Number(globalPulse?.last_24h || 0));

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});
---

<Layout 
    title="Медиумски Пулс — Пресек"
    description="Следење на медиумската активност и интензитетот на известување во реално време."
>
    <NYTHeader />

    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="pulse-masthead mb-12 border-b-4 border-foreground pb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
                <div class="max-w-3xl">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="relative flex h-3 w-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                        </div>
                        <span class="font-sans text-[11px] font-black uppercase tracking-[0.3em] text-nyt-accent">СИСТЕМСКИ СИГНАЛ ВО ЖИВО</span>
                    </div>
                    <h1 class="font-serif text-5xl md:text-7xl font-black leading-[0.85] tracking-tighter mb-4">Медиумски <span class="italic font-light">Пулс</span></h1>
                    <p class="font-serif text-xl italic text-muted-foreground">{currentDate}</p>
                </div>

                <div class="pulse-summary-deck grid grid-cols-2 gap-4 w-full md:w-auto">
                    <div class="stat-card p-6 bg-secondary/10 border border-border rounded-sm">
                        <span class="block text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-2">24Ч ВОЛУМЕН</span>
                        <div class="flex items-baseline gap-2">
                            <span class="text-3xl font-black tabular-nums">{safePulseVolume.toLocaleString('mk-MK')}</span>
                            <Zap size={14} className="text-nyt-accent" />
                        </div>
                    </div>
                    <div class="stat-card p-6 bg-secondary/10 border border-border rounded-sm">
                        <span class="block text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-2">ИНТЕНЗИТЕТ</span>
                        <div class="flex items-baseline gap-2">
                            <span class="text-3xl font-black tabular-nums">{globalPulse?.intensity_score || '0.0'}</span>
                            <Activity size={14} className="text-nyt-accent" />
                        </div>
                    </div>
                </div>
            </div>
        </header>

        {ssrFailed ? (
            <div class="pulse-error py-24 text-center">
                <p class="font-serif text-2xl italic text-muted-foreground">Системот за анализа на пулсот моментално е недостапен. Ве молиме обидете се подоцна.</p>
            </div>
        ) : (
            <PulseClientContainer 
                client:load 
                initialData={initialPulseData} 
                globalPulse={globalPulse}
                categories={categories}
            />
        )}
    </main>

    <Footer />
</Layout>

<style>
    .pulse-masthead h1 span { color: var(--nyt-accent); }
    
    @media (max-width: 768px) {
        .pulse-masthead h1 { font-size: 3.5rem; }
    }
</style>
