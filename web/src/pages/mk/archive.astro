---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import NewsCard from '../../components/NewsCard.astro';
import ArchiveFeedIsland from '../../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../../components/ArchiveHeatmapIsland.tsx';

import { apiBaseUrl } from '../../lib/apiBase';
import { sanitizeHtml } from '../../lib/sanitize';
import { CalendarDays, ChevronRight, Hash, Building2, Sparkles, Search, Activity } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const q = Astro.url.searchParams.get('q') || '';
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive = { clusters: [], total: 0, sources: 0, date, page, page_size: 50, has_more: false, total_clusters: 0, top_sources: [], top_topics: [] };
let briefingData = { briefing: null };
let onThisDay = { on_this_day: null };
let error = null;

try {
  const archiveUrl = new URL(`${API_URL}/api/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('lang', lang);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (q) archiveUrl.searchParams.set('q', q);
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);
  
  const [res, briefRes, otdRes] = await Promise.all([
    fetch(archiveUrl),
    fetch(`${API_URL}/api/archive/daily-briefing?date=${date}&lang=${lang}`),
    fetch(`${API_URL}/api/archive/on-this-day?date=${date}&lang=${lang}`)
  ]);

  if (res.ok) archive = await res.json();
  if (briefRes.ok) briefingData = await briefRes.json();
  if (otdRes.ok) onThisDay = await otdRes.json();

  if (!res.ok) {
    error = 'Архивата моментално не е достапна.';
    Astro.response.status = 500;
  }
  } catch (err) {
  error = 'Грешка при вчитување на архивата.';
  Astro.response.status = 500;
  }

const buildFilterHref = (kind: 'source' | 'topic' | 'q', value: string) => {
  const params = new URLSearchParams({ date });
  if (kind === 'source') { if (value) params.set('source', value); if (topic) params.set('topic', topic); if (q) params.set('q', q); }
  else if (kind === 'topic') { if (source) params.set('source', source); if (value) params.set('topic', value); if (q) params.set('q', q); }
  else { if (source) params.set('source', source); if (topic) params.set('topic', topic); if (value) params.set('q', value); }
  return `/mk/archive?${params.toString()}`;
};

const formattedDisplayDate = new Date(archive.date).toLocaleDateString(lang === 'sr' ? 'sr-RS' : 'mk-MK', { day: 'numeric', month: 'long', year: 'numeric' });

// More robust splitting to handle different bullet characters or spacing
const briefingItems = briefingData.briefing ? briefingData.briefing.split(/\s*[•·]\s*/) : [];

function formatBriefingItem(item: string) {
    if (!item) return '';
    // 1. First, handle markdown bolding
    const bolded = item.replace(/\*\*(.*?)\*\*/g, '<strong class="font-black text-foreground not-italic">$1</strong>');
    // 2. Sanitize resulting HTML (allows strong, b, etc.)
    return sanitizeHtml(bolded);
}
---

<Layout title="Архива — Пресек" description="Пребарувајте низ историјата на македонските медиуми.">
  <NYTHeader />
  
  <main class="site-layout broadsheet-layout pt-32 pb-[var(--page-py)]">
    <header class="editorial-masthead mb-16 border-t border-foreground pt-4">
        <div class="masthead-top mb-8 flex justify-between items-center">
            <span class="masthead-kicker font-sans text-[10px] font-black uppercase tracking-[0.25em] text-nyt-accent">МЕДИУМСКА МЕМОРИЈА</span>
            <div class="masthead-meta-compact hidden md:flex items-center gap-6 font-sans text-[10px] font-black uppercase tracking-widest text-muted-foreground opacity-60">
                <span class="flex items-center gap-2"><CalendarDays size={12} /> {formattedDisplayDate}</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.total_clusters} теми</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.sources} медиуми</span>
            </div>
        </div>

        <div class="masthead-main flex flex-col md:flex-row justify-between items-start md:items-end gap-12 mb-12">
            <div class="max-w-3xl">
                <h1 class="masthead-title font-serif text-5xl md:text-7xl font-black leading-[0.9] tracking-tighter mb-4">Архива на <span class="text-nyt-accent italic font-light">Изданија</span></h1>
                <p class="font-serif text-xl italic text-muted-foreground leading-snug max-w-2xl">Преглед на медиумскиот циклус и историскиот наратив преку консолидираните извештаи на Пресек.</p>
            </div>
            <div class="masthead-data-deck grid grid-cols-3 gap-0 border border-border/60 bg-secondary/10 overflow-hidden rounded-sm w-full md:w-auto min-w-[320px]">
                <div class="deck-stat p-6 border-r border-border/60 text-center">
                    <span class="block text-2xl font-black tabular-nums">{archive.total.toLocaleString(lang === 'sr' ? 'sr-RS' : 'mk-MK')}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">Објави</span>
                </div>
                <div class="deck-stat p-6 border-r border-border/60 text-center">
                    <span class="block text-2xl font-black tabular-nums">{archive.sources}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">Извори</span>
                </div>
                <div class="deck-stat p-6 text-center">
                    <span class="block text-2xl font-black tabular-nums">{archive.total_clusters}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">Теми</span>
                </div>
            </div>
        </div>
    </header>

    <div class="broadsheet-grid">
      <div class="broadsheet-main">
        {error && <div class="bg-destructive/10 text-destructive p-4 rounded-sm border border-destructive/20 mb-8 font-black uppercase text-[10px] tracking-widest">{error}</div>}
        
        <div class="feed-controls mb-12 flex flex-wrap gap-4 items-center justify-between py-6 border-y border-border/60">
            <div class="flex items-center gap-6">
                <div class="control-group">
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground block mb-2">ДАТУМ НА ИЗДАНИЕ</span>
                    <input 
                        type="date" 
                        value={date} 
                        class="bg-transparent font-serif text-xl font-bold border-none p-0 focus:ring-0 cursor-pointer"
                        onchange="window.location.href = `/mk/archive?date=${this.value}${q ? '&q='+q : ''}${source ? '&source='+source : ''}${topic ? '&topic='+topic : ''}`"
                    />
                </div>
            </div>
            
            <div class="flex-1 max-w-md">
                <form action="/mk/archive" method="GET" class="relative group">
                    <input type="hidden" name="date" value={date} />
                    {source && <input type="hidden" name="source" value={source} />}
                    {topic && <input type="hidden" name="topic" value={topic} />}
                    <input 
                        type="text" 
                        name="q" 
                        value={q} 
                        placeholder="Пребарај ја архивата..." 
                        class="w-full bg-secondary/5 border-b-2 border-border focus:border-nyt-accent py-3 pl-0 pr-10 font-serif text-lg italic transition-all focus:ring-0"
                    />
                    <button type="submit" class="absolute right-0 top-1/2 -translate-y-1/2 p-2 opacity-40 group-focus-within:opacity-100 group-focus-within:text-nyt-accent transition-all">
                        <Search size={20} />
                    </button>
                </form>
            </div>
        </div>

        {archive.clusters && archive.clusters.length > 0 ? (
          <div class="archive-feed-list space-y-12">
            {archive.clusters.map((cluster) => (
              <div class="archive-cluster-entry border-b border-border/40 pb-12 last:border-0">
                <NewsCard cluster={cluster} variant="standard" />
              </div>
            ))}
            
            {archive.has_more && (
              <div class="pagination-footer pt-12 text-center">
                <a 
                    href={`/mk/archive?date=${date}&page=${page + 1}${q ? '&q='+q : ''}${source ? '&source='+source : ''}${topic ? '&topic='+topic : ''}`}
                    class="inline-flex items-center gap-4 bg-foreground text-background px-10 py-5 font-black uppercase text-[11px] tracking-[0.2em] hover:bg-nyt-accent transition-colors"
                >
                    ВЧИТАЈ ПОВЕЌЕ ТЕМИ <ChevronRight size={16} />
                </a>
              </div>
            )}
          </div>
        ) : (
          <div class="empty-archive-state py-24 text-center border-2 border-dashed border-border/60">
            <Activity size={48} className="mx-auto mb-6 text-muted-foreground/30" />
            <p class="font-serif text-2xl italic text-muted-foreground">Нема пронајдено архивирани теми за избраните филтри.</p>
            <button onclick="window.location.href='/mk/archive'" class="mt-8 text-[10px] font-black uppercase tracking-widest text-nyt-accent underline underline-offset-8">РЕСЕТИРАЈ ГИ СИТЕ ФИЛТРИ</button>
          </div>
        )}
      </div>

      <aside class="broadsheet-rail">
        {/* BRIEFING SNIPPET */}
        {briefingData.briefing && (
            <section class="rail-block mb-12 bg-secondary/10 p-8 border border-border/40">
                <div class="flex items-center gap-3 mb-6">
                    <Sparkles size={16} className="text-nyt-accent" />
                    <h3 class="font-sans text-[10px] font-black uppercase tracking-[0.25em]">СУБЛИМАТ НА ДЕНОТ</h3>
                </div>
                <div class="briefing-content space-y-6">
                    {briefingItems.map(item => (
                        <p class="font-serif text-base italic leading-relaxed text-foreground/80 border-l-2 border-nyt-accent/30 pl-4" set:html={formatBriefingItem(item)}></p>
                    ))}
                </div>
                <a href={`/mk/briefing?date=${date}`} class="mt-8 flex items-center gap-2 font-black text-[9px] uppercase tracking-widest text-nyt-accent hover:translate-x-1 transition-transform">
                    ЦЕЛОСЕН БРИФИНГ <ChevronRight size={14} />
                </a>
            </section>
        )}

        {/* ON THIS DAY */}
        {onThisDay.on_this_day && (
            <section class="rail-block mb-12">
                <div class="flex items-center gap-3 mb-6">
                    <Activity size={16} className="text-nyt-accent" />
                    <h3 class="font-sans text-[10px] font-black uppercase tracking-[0.25em]">НА ОВОЈ ДЕН</h3>
                </div>
                <div class="otd-box p-6 bg-foreground text-background">
                    <p class="font-serif text-lg leading-snug italic" set:html={onThisDay.on_this_day}></p>
                </div>
            </section>
        )}

        {/* TOP TOPICS */}
        {archive.top_topics && archive.top_topics.length > 0 && (
            <section class="rail-block mb-12">
                <div class="flex items-center gap-3 mb-6">
                    <Hash size={16} className="text-nyt-accent" />
                    <h3 class="font-sans text-[10px] font-black uppercase tracking-[0.25em]">ГЛАВНИ ТЕМИ</h3>
                </div>
                <div class="flex flex-wrap gap-2">
                    {archive.top_topics.map((t) => (
                        <a 
                            href={buildFilterHref('topic', t.topic)}
                            class:list={["px-3 py-1.5 font-sans text-[10px] font-black uppercase tracking-widest border transition-colors", t.topic === topic ? "bg-foreground text-background border-foreground" : "border-border hover:border-foreground"]}
                        >
                            {t.topic} <span class="opacity-40 ml-1">({t.count})</span>
                        </a>
                    ))}
                </div>
            </section>
        )}

        {/* TOP SOURCES */}
        {archive.top_sources && archive.top_sources.length > 0 && (
            <section class="rail-block">
                <div class="flex items-center gap-3 mb-6">
                    <Building2 size={16} className="text-nyt-accent" />
                    <h3 class="font-sans text-[10px] font-black uppercase tracking-[0.25em]">АКТИВНИ ИЗВОРИ</h3>
                </div>
                <div class="space-y-3">
                    {archive.top_sources.map((s) => (
                        <a 
                            href={buildFilterHref('source', s.source)}
                            class:list={["flex justify-between items-center py-2 border-b border-border/40 group", s.source === source ? "text-nyt-accent" : "text-muted-foreground hover:text-foreground"]}
                        >
                            <span class="font-sans text-[11px] font-extrabold uppercase tracking-widest">{s.source}</span>
                            <span class="font-serif italic text-xs opacity-40 group-hover:opacity-100">{s.count}</span>
                        </a>
                    ))}
                </div>
            </section>
        )}
      </aside>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
    .broadsheet-layout { background: var(--background); }
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 4rem; }
    
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 4rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    .masthead-title span { font-style: italic; font-weight: 300; }
    
    .archive-feed-list { position: relative; }
    .archive-feed-list::before {
        content: '';
        position: absolute;
        left: -4rem;
        top: 0;
        bottom: 0;
        width: 1px;
        background: linear-gradient(to bottom, var(--border), transparent);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        opacity: 0;
        position: absolute;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }
</style>
