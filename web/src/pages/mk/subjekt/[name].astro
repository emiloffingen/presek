---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import NewsCard from '../../components/NewsCard.astro';
import EntityIsland from '../../components/EntityIsland';

import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { apiBaseUrl } from '../../lib/apiBase';
import { cleanAndDecode, isMostlyCyrillic } from '../../utils/textUtils';
import { sanitizeHtml } from '../../lib/sanitize';

import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { name } = Astro.params;
const decodedName = decodeURIComponent(name || "");
const API_URL = apiBaseUrl();

let entityData = null;
let error = null;

try {
    const entityRes = await fetch(`${API_URL}/intelligence/entity/${encodeURIComponent(decodedName)}?lang=${lang}`);
    if (entityRes.ok) {
        entityData = await entityRes.json();
    } else {
        error = lang === 'sr' ? "Profil nije pronađen." : "Профилот не е пронајден.";
        Astro.response.status = entityRes.status === 404 ? 404 : 500;
    }
} catch (e) {
    console.error(e);
    error = lang === 'sr' ? "Greška pri povezivanju." : "Грешка при поврзување.";
    Astro.response.status = 500;
}

const clusters = entityData?.clusters || [];
const featuredClusters = clusters.slice(0, 4);
const compactClusters = clusters.slice(4, 10);
const nameIsCyrillic = isMostlyCyrillic(decodedName);
---

<Layout
    title={`${decodedName} | ${lang === 'sr' ? 'Profil' : 'Профил'}`}
    description={lang === 'sr' 
        ? `Medijska analiza, ton izveštavanja i najnovije vesti za ${decodedName} na Preseku.`
        : `Mediumska analiza, ton na izvestuvanje i najnovi vesti za ${decodedName} na Presek.`}
>
	<NYTHeader />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">{lang === 'sr' ? 'INTELEKTUALNI PROFIL' : 'ИНТЕЛЕКТУАЛЕН ПРОФИЛ'}</span>
            </div>
            <div class="masthead-main">
                <h1 class:list={["masthead-title", { "headline-cyrillic": nameIsCyrillic }]}>{decodedName}</h1>
            </div>
        </header>

        {error ? (
            <div class="empty-state">
                <p class="empty-kicker">{lang === 'sr' ? 'GREŠKA' : 'ГРЕШКА'}</p>
                <h2>{error}</h2>
                <a href={lang === 'sr' ? '/' : '/mk'} class="clear-filter mt-4">{lang === 'sr' ? 'Vrati se na početnu' : 'Врати се на почетна'}</a>
            </div>
        ) : (
            <div class="broadsheet-grid">
                <div class="broadsheet-main">
                    <div class="motion-rise">
                        <EntityIsland client:visible name={decodedName} initialData={entityData} lang={lang} />
                    </div>


                    <section class="mt-16">
                        <h2 class="section-title-italic mb-8">{lang === 'sr' ? 'Povezani događaji' : 'Поврзани настани'}</h2>
                        
                        <div class="broadsheet-feed">
                            {featuredClusters.map((cluster: any) => (
                                <div class="feed-item-wrap">
                                    <NewsCard cluster={cluster} variant="featured" />
                                </div>
                            ))}
                        </div>

                        {compactClusters.length > 0 && (
                            <div class="broadsheet-feed mt-8">
                                {compactClusters.map((cluster: any) => (
                                    <div class="feed-item-wrap">
                                        <NewsCard cluster={cluster} variant="compact" />
                                    </div>
                                ))}
                            </div>
                        )}

                        {clusters.length === 0 && (
                            <div class="empty-state">
                                <p>{lang === 'sr' ? 'Nema pronađenih vesti za ovaj subjekt.' : 'Нема пронајдени вести за овој субјект.'}</p>
                            </div>
                        )}
                    </section>
                </div>

                <aside class="broadsheet-rail">
                    <section class="rail-block rail-block-alt">
                        <p class="rail-kicker">{lang === 'sr' ? 'Za profil' : 'За профилот'}</p>
                        <h3 class="rail-title">{lang === 'sr' ? 'POVEZANOST' : 'ПОВРЗАНОСТ'}</h3>
                        <p class="rail-text">
                            {lang === 'sr' 
                                ? `Ovaj profil je automatski generisan kroz analizu medijskog intenziteta. Prikazujemo samo događaje gde je ${decodedName} ključni akter ili značajan deo konteksta.`
                                : `Овој профил е автоматски генериран преку анализа на медиумскиот интензитет. Ги прикажуваме само настаните каде ${decodedName} е клучен актер или значаен дел од контекстот.`}
                        </p>
                    </section>
                    
                </aside>
            </div>
        )}
	</main>

    <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }

    /* ── Broadsheet Layout ───────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    .section-title-italic { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 900; italic: true; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }

    /* ── Feed Styling ────────────────────────────────── */
    .broadsheet-feed { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
    @media (min-width: 768px) { .broadsheet-feed { grid-template-columns: repeat(2, 1fr); } }
    .feed-item-wrap { border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
    .feed-item-wrap:last-child { border-bottom: none; }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 4px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }

    /* ── States ──────────────────────────────────────── */
    .empty-state { text-align: center; padding: 4rem 1rem; border: 1px dashed var(--border); }
    .empty-kicker { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; color: var(--nyt-accent); margin-bottom: 1rem; }
    .clear-filter { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; text-decoration: underline; color: var(--foreground); }
</style>
