---
import EntitySubjectView from '../../../components/entity/EntitySubjectView.astro';
import { loadEntitySubject } from '../../../lib/loadEntitySubject';

const hostHeader = Astro.request?.headers.get('host');
const subject = await loadEntitySubject(Astro.params, Astro.url, hostHeader);
if (subject.httpStatus) Astro.response.status = subject.httpStatus;
---

<EntitySubjectView {...subject} />
