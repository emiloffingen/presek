---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IntelligenceGraph from '../../components/IntelligenceGraph';
import Footer from '../../components/Footer.astro';
import TinyAdzInlinedAd from '../../components/TinyAdzInlinedAd.astro';
---

<Layout 
    title="Медиумска Мрежа | Интерактивен Граф" 
    description="Истражете ја интерактивната мрежа на врски, сентимент и споменувања на политички актери и институции во македонските медиуми."
>
    <NYTHeader />

	<main class="site-layout broadsheet-layout py-[var(--page-py)] animate-rise">
		<Breadcrumbs items={[{ label: "граф" }]} />
		<TinyAdzInlinedAd class="page-inline-ad mb-10" />
		<IntelligenceGraph lang="mk" client:load />
	</main>
	<Footer />
</Layout>
