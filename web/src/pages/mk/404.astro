---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { homePath, localePath } from '../../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');

Astro.response.status = 404;
---

<Layout title="404 — Страница није пронађена" robots="noindex, nofollow">
	<NYTHeader />
	<main class="site-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: "Страница није пронађена" }]} />

		<section class="not-found-shell">
			<div class="not-found-main">
				<span class="page-kicker">404</span>
				<h1 class="not-found-headline">Страница није пронађена</h1>
				<p class="not-found-intro">
					Линк који сте отворили не постоји, премештен је или више није доступан. Најчешће се ово дешава када је кластер стар, адреса непотпуна или линк погрешно копиран.
				</p>

				<div class="not-found-actions">
					<a href={homePath('mk', hostHeader)} class="not-found-link not-found-link-primary">Почетна</a>
					<a href={localePath('/archive', 'mk', hostHeader)} class="not-found-link">Архива</a>
					<a href={localePath('/briefing', 'mk', hostHeader)} class="not-found-link">Брифинг</a>
				</div>
			</div>

			<aside class="not-found-rail">
				<div class="rail-card rail-card-accent">
					<h2 class="rail-card-title">Где даље</h2>
					<p class="rail-copy">
						Ако сте тражили конкретну вест или кластер, најбоље је да почнете од архиве. Ако само желите брз преглед дана, вратите се на почетну или отворите брифинг.
					</p>
				</div>

				<div class="rail-card">
					<h2 class="rail-card-title">Брзе путање</h2>
					<div class="not-found-list">
						<a href={localePath('/archive', 'mk', hostHeader)}>Прелистај дан по дан</a>
						<a href={localePath('/izvori', 'mk', hostHeader)}>Погледај изворе</a>
						<a href={localePath('/pulse', 'mk', hostHeader)}>Упореди медије</a>
						<a href={localePath('/contact', 'mk', hostHeader)}>Пријави неисправан линк</a>
					</div>
				</div>
			</aside>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.not-found-grid { display: grid; grid-template-columns: 1fr; gap: 4rem; }
	@media (min-width: 1024px) {
		.not-found-grid { grid-template-columns: 1fr 300px; }
		.not-found-main { border-right: 1px solid var(--border); padding-right: 4rem; }
	}

	.not-found-links { display: flex; flex-direction: column; gap: 0.75rem; }
	.not-found-link { display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 0.5rem 0; border-bottom: 1px solid var(--border); transition: all 0.2s; }
	.not-found-link:hover { padding-left: 0.5rem; border-color: var(--foreground); }
</style>
