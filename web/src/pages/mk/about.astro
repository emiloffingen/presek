---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<Layout
    title="За проектот — Пресек"
    description="Пресек е македонски информативен агрегатор кој ви овозможува да ја видите целосната слика."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">МИСИЈА И ВИЗИЈА</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Појасен преглед на <span>денот</span></h1>
            </div>
            <p class="masthead-intro">
                Пресек е дигитален сервис за медиумска транспарентност и јавен увид. Нашата мисија е да ја вратиме јасноста во информативниот простор преку мапирање на плурализмот.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Пресек е независен, непрофитен дигитален опсерваториум посветен на аналитичко истражување на медиумскиот плурализам, објективноста и наративната разновидност во дигиталниот информативен простор. Во ерата на преоптовареност со информации, нашиот научен пристап кон NLP анализата служи за структурирање на јавните дебати и анализа на медиумското известување.
                    </p>

                    <p>
                        Наместо да ги заменува традиционалните медиумски редакции, нашиот портал врши функција на надзорен механизам кој овозможува компаративна анализа на различни новинарски извори, нудејќи ѝ на јавноста транспарентна методологија за независна анализа на пристрасноста, сензибилноста и плурализмот.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">Клучни столбови на опсерваториумот</h2>
                    <ul class="editorial-list">
                        <li><strong>Компаративна синтеза:</strong> Автоматизирани научни прегледи кои ги обединуваат фактите од сите достапни медиумски извори со цел на аналитички контраст.</li>
                        <li><strong>Индексирање на плурализмот:</strong> Прецизно математичко мапирање на различни агли на известување, идентификување на информативни празнини и тонални разлики меѓу редакциите.</li>
                        <li><strong>Анализа на сензибилноста:</strong> Статистичка обработка на речениците со цел откривање на прикриен тонален сензационализам и еднострано известување.</li>
                    </ul>

                    <p>
                        Нашата намера е научно-истражувачка: помалку шум, повеќе контекст. Пресек не сугерира заклучоци; ние нудиме емпириски податоци и визуелни метрики кои им помагаат на истражувачите, новинарите и граѓаните критички да го набљудуваат медиумскиот пејзаж.
                    </p>

                    <div class="editorial-divider"></div>

                    <h2 class="section-title-italic">Научна методологија и Мисија</h2>
                    <div class="two-col-grid">
                        <div class="grid-item">
                            <h3>NLP Архитектура</h3>
                            <p>Пресек користи напредна компјутерска лингвистика и системи за обработка на природниот јазик (NLP) оптимизирани за јужнословенските јазици. Системот спроведува автоматско групирање со примена на косинусна сличност на повеќедимензионални семантички вектори.</p>
                        </div>
                        <div class="grid-item">
                            <h3>Истражувачка визија</h3>
                            <p>Нашата цел е промовирање на медиумската писменост и транспарентност. Сакаме да обезбедиме емпириски увид во тоа како се формулираат вестите, олеснувајќи го воочувањето на медиумскиот монопол и едностраниот наратив.</p>
                        </div>
                    </div>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Накратко</p>
                    <h3 class="rail-title">ГЛАВНА НАМЕРА</h3>
                    <p class="rail-text">Помалку шум, повеќе контекст. Помалку распрснати наслови, повеќе јасност за она што навистина го обликува денот.</p>
                </section>

                <section class="rail-block">
                    <p class="rail-kicker">понатаму</p>
                    <div class="rail-directory">
                        <a href="/mk/editorial" class="dir-link"><span class="name">Стандарди</span></a>
                        <a href="/mk/briefing" class="dir-link"><span class="name">Брифинг</span></a>
                        <a href="/mk/for-you" class="dir-link"><span class="name">За Вас</span></a>
                        <a href="/mk/izvori" class="dir-link"><span class="name">Извори</span></a>
                    </div>
                </section>
            </aside>
        </div>
    </main>

	<Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    /* ── Broadstreet Layout ───────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: 1fr; }
        .broadsheet-main { border-right: none; padding-right: 0; }
        .broadsheet-rail {   align-self: start; }
    }

    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }

    .editorial-divider { height: 1px; background: var(--border); margin: 3rem 0; }
    .section-title-italic { font-family: var(--font-serif); font-size: 1.75rem; font-weight: 900; font-style: italic; margin-bottom: 1.5rem; }

    .editorial-list { list-style: none; padding: 0; margin-bottom: 2.5rem; }
    .editorial-list li { margin-bottom: 1rem; position: relative; padding-left: 1.5rem; }
    .editorial-list li::before { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); }

    .two-col-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.5rem; margin-top: 2rem; }
    .grid-item h3 { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; color: var(--foreground); }
    .grid-item p { font-size: 0.95rem; line-height: 1.6; }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 0px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }

    .rail-directory { display: flex; flex-direction: column; gap: 0.75rem; }
    .dir-link { display: flex; align-items: center; justify-content: space-between; text-decoration: none; padding: 0.5rem 0; border-bottom: 1px solid var(--border); transition: all 0.2s; }
    .dir-link .name { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 700; color: var(--foreground); }
    .dir-link:hover { padding-left: 0.5rem; border-color: var(--foreground); }
</style>
