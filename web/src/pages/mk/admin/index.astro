---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import AdminDashboard from '../../../components/AdminDashboard.tsx';
import { ErrorBoundary } from '../../../components/ui/ErrorBoundary.tsx';
import { APP_VERSION } from '../../../lib/version';
import { homePath } from '../../../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');
const versionLabel = APP_VERSION;
---

<Layout
    title="Administrativen Panel"
    description="Presek Operativen Centar"
    robots="noindex, nofollow"
>
    <div class="bg-zinc-950 min-h-screen text-zinc-100">
        <header class="border-b border-zinc-800 py-6 bg-zinc-900/50 backdrop-blur-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
                <div class="flex items-center gap-[var(--grid-gap)]">
                    <div class="w-10 h-10 bg-nyt-accent rounded-lg flex items-center justify-center text-black font-black">P</div>
                    <div>
                        <h1 class="text-xl font-bold tracking-tight">OPERATIONAL COCKPIT</h1>
                        <p class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Presek Intelligence v{versionLabel}</p>
                    </div>
                </div>
                <div class="flex items-center gap-[var(--grid-gap)] text-[11px] font-mono">
                    <div class="flex items-center gap-[var(--grid-gap)]">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                        <span class="text-zinc-400">SYSTEM LIVE</span>
                    </div>
                    <a href={homePath('mk', hostHeader)} class="text-zinc-500 hover:text-white transition-colors">BACK TO SITE →</a>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-6 py-12">
            <ErrorBoundary client:idle lang="mk">
                <AdminDashboard client:idle />
            </ErrorBoundary>
        </main>

        <Footer />
    </div>
</Layout>

<style is:global>
    /* Dark mode override for admin dashboard */
    body {
        background-color: #09090b;
    }
</style>
