---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<Layout title={t('legal.terms.title')} description={t('legal.terms.description')}>
    <NYTHeader />
    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker ui-label">{t('legal.terms.kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">{t('legal.terms.heading_prefix')} <span>{t('legal.terms.heading_span')}</span></h1>
            </div>
            <p class="masthead-intro">{t('legal.terms.intro')}</p>
        </header>

        <div class="editorial-broadsheet-grid">
            <div class="editorial-broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">{t('legal.terms.lead')}</p>

                    <h2 class="section-title-italic">{t('legal.terms.section1_title')}</h2>
                    <p>{t('legal.terms.section1_body')}</p>

                    <h2 class="section-title-italic">{t('legal.terms.section2_title')}</h2>
                    <p>{t('legal.terms.section2_body')}</p>

                    <h2 class="section-title-italic">{t('legal.terms.section3_title')}</h2>
                    <p>{t('legal.terms.section3_body')}</p>

                    <h2 class="section-title-italic">{t('legal.terms.section4_title')}</h2>
                    <p>{t('legal.terms.section4_body')}</p>
                </article>
            </div>

            <aside class="editorial-broadsheet-rail">
                <details class="editorial-rail-context">
                    <summary class="editorial-rail-context-summary">
                        <span class="ui-label">{t('legal.terms.rail_context')}</span>
                        <span class="editorial-rail-context-hint ui-label-min text-muted-foreground">{t('editorial.rail_open')}</span>
                    </summary>
                    <div class="editorial-rail-context-body">
                        <section class="editorial-rail-block editorial-rail-block-alt">
                            <p class="editorial-rail-kicker">{t('legal.terms.rail_note_kicker')}</p>
                            <h3 class="editorial-rail-title">{t('legal.terms.rail_note_title')}</h3>
                            <p class="editorial-rail-text">{t('legal.terms.rail_note_text')}</p>
                        </section>

                        <div class="editorial-rail-meta">
                            <p class="ui-label-min text-muted-foreground mb-4 opacity-70">{t('legal.terms.rail_updated_label')}</p>
                            <p class="text-xs">{t('legal.terms.rail_updated_date')}</p>
                        </div>
                    </div>
                </details>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>
