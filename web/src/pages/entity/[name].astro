---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import NewsCard from '../../components/NewsCard.astro';
import EntityIsland from '../../components/EntityIsland';
import Footer from '../../components/Footer.astro';

const { name } = Astro.params;
const decodedName = decodeURIComponent(name || "");
const API_URL = import.meta.env.PUBLIC_API_URL || (typeof window !== 'undefined' ? "/api" : "http://127.0.0.1:5000/api");

let clusters = [];
let entityData = null;
let error = null;

try {
    const [entityRes, newsRes] = await Promise.all([
        fetch(`${API_URL}/intelligence/entity/${encodeURIComponent(decodedName)}`),
        fetch(`${API_URL}/news?entity=${encodeURIComponent(decodedName)}&page_size=10`)
    ]);

    if (entityRes.ok) {
        entityData = await entityRes.json();
    }

    const data = await newsRes.json();
    clusters = data.clusters || [];
} catch (e) {
    console.error(e);
}
---

<Layout title={decodedName} description={`Најнови вести и анализи за ${decodedName} на Пресек.`}>
	<NYTHeader />

	<main class="site-layout py-12">
        <div class="entity-shell">
            <EntityIsland name={decodedName} initialClusters={clusters} initialData={entityData} />

            <section class="entity-news">
                <div class="entity-news-head">
                    <h2>Сите Неодамнешни Кластери</h2>
                    <p>Подолу се сите свежи стории каде {decodedName} влегува како дел од развојот, контекстот или поврзаната мрежа.</p>
                </div>
                <div class="news-feed-grid">
                    {clusters.map((cluster: any) => (
                        <NewsCard cluster={cluster} />
                    ))}
                </div>
                {clusters.length === 0 && (
                    <div class="entity-empty">
                        <p class="text-muted font-bold uppercase tracking-widest text-sm">Нема пронајдени вести за овој ентитет.</p>
                    </div>
                )}
            </section>
        </div>
	</main>

    <Footer />
</Layout>

<style>
    .entity-shell {
        max-width: 76rem;
        margin: 0 auto;
    }

    .entity-news {
        margin-top: 2rem;
    }

    .entity-news-head {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
    }

    .entity-news-head h2 {
        margin: 0;
        font-size: clamp(1.4rem, 1.05rem + 0.8vw, 2rem);
        line-height: 1;
    }

    .entity-news-head p {
        margin: 0;
        font-family: var(--font-sans);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }

    .entity-empty {
        padding: 2rem;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%);
        text-align: center;
    }
</style>
