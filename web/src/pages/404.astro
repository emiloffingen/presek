---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

Astro.response.status = 404;
---

<Layout title={t('not_found.title')} robots="noindex, nofollow">
	<NYTHeader />
	<main class="site-layout page-content-top pb-[var(--page-py)]">
		<Breadcrumbs items={[{ label: t('not_found.breadcrumb') }]} />

		<section class="not-found-shell">
			<div class="not-found-main">
				<span class="page-kicker ui-label-min text-nyt-accent">{t('not_found.kicker')}</span>
				<h1 class="not-found-headline">{t('not_found.headline')}</h1>
				<p class="not-found-intro">
					{t('not_found.intro')}
				</p>

				<div class="not-found-actions">
					<a href={homePath(lang, hostHeader)} class="not-found-link not-found-link-primary">{t('not_found.home')}</a>
					<a href={localePath('/archive', lang, hostHeader)} class="not-found-link">{t('not_found.archive')}</a>
					<a href={localePath('/briefing', lang, hostHeader)} class="not-found-link">{t('not_found.briefing')}</a>
				</div>
			</div>

			<aside class="not-found-rail">
				<details class="not-found-rail-context">
					<summary class="not-found-rail-context-summary">
						<span class="ui-label">{t('not_found.rail_context')}</span>
						<span class="not-found-rail-context-hint ui-label-min text-muted-foreground">{lang === 'mk' ? 'ОТВОРИ' : 'OTVORI'}</span>
					</summary>
					<div class="not-found-rail-context-body">
						<div class="rail-card rail-card-accent">
							<h2 class="rail-card-title">{t('not_found.rail_where_title')}</h2>
							<p class="rail-copy">
								{t('not_found.rail_where_copy')}
							</p>
						</div>

						<div class="rail-card">
							<h2 class="rail-card-title">{t('not_found.rail_paths_title')}</h2>
							<div class="not-found-list">
								<a href={localePath('/archive', lang, hostHeader)}>{t('not_found.path_archive')}</a>
								<a href={localePath('/izvori', lang, hostHeader)}>{t('not_found.path_sources')}</a>
								<a href={localePath('/pulse', lang, hostHeader)}>{t('not_found.path_pulse')}</a>
								<a href={localePath('/contact', lang, hostHeader)}>{t('not_found.path_contact')}</a>
							</div>
						</div>
					</div>
				</details>
			</aside>
		</section>
	</main>
	<Footer />
</Layout>
