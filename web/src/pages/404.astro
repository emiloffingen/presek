---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="404 — Страницата не е пронајдена" robots="noindex, nofollow">
	<div class="min-h-screen flex items-center justify-center px-4">
		<div class="text-center max-w-md">
			<p class="text-6xl font-black text-foreground mb-4">404</p>
			<h1 class="font-serif text-2xl font-bold text-foreground mb-3">Страницата не е пронајдена</h1>
			<p class="text-muted-foreground mb-8 text-sm leading-relaxed">
				Линкот што го отворивте не постои или е преместен.
			</p>
			<a href="/" class="inline-block px-6 py-2.5 text-sm font-semibold bg-foreground text-background rounded hover:opacity-90 transition-opacity">
				Назад на почетна
			</a>
		</div>
	</div>
</Layout>
