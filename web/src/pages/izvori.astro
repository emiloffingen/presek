---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IzvoriPage from '../components/IzvoriPage';
import Footer from '../components/Footer.astro';
import TinyAdzInlinedAd from '../components/TinyAdzInlinedAd.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<Layout title={`${t('sources.title')} — Presek`} description={t('sources.page_description')}>
    <NYTHeader />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: t('sources.breadcrumb') }]} />
		<TinyAdzInlinedAd class="page-inline-ad mb-10" />
		<IzvoriPage lang={lang} client:load />
	</main>
	<Footer />
</Layout>
