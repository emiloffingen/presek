---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IzvoriPage from '../components/IzvoriPage';
import Footer from '../components/Footer.astro';
---

<Layout title="izvori" description="Kompleten pregled na site mediumski izvori sto Presek im sledi — rangirani po aktivnost i doverlivost.">
    <NYTHeader />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: "izvori" }]} />
		<IzvoriPage client:load />
	</main>
	<Footer />
</Layout>
