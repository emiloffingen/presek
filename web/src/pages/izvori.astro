---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IzvoriPage from '../components/IzvoriPage';
import Footer from '../components/Footer.astro';
---

<Layout title="Medijski izvori" description="Kompletan pregled svih medijskih izvora koje Presek prati — rangirani po aktivnosti i pouzdanosti.">
    <NYTHeader />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: "izvori" }]} />
		<IzvoriPage lang="sr" client:load />
	</main>
	<Footer />
</Layout>
