---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ReaderSuggestionAnalyticsIsland from '../components/ReaderSuggestionAnalyticsIsland.tsx';
import { BarChart3, Activity, Zap, Layers } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';

const API_URL = apiBaseUrl();

let stats = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/stats/full`);
    if (res.ok) {
        stats = await res.json();
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на статистиките.";
}

const topSource = stats?.by_source?.[0] ?? null;
const topCategory = stats?.by_category?.[0] ?? null;
const editorAnalytics = stats?.editor_analytics ?? {};
const hasEditorSignals = Boolean(
	(editorAnalytics.synced_profiles ?? 0) ||
	(editorAnalytics.active_profiles_7d ?? 0) ||
	(editorAnalytics.delivery_active ?? 0) ||
	(editorAnalytics.delivery_targets ?? 0) ||
	(editorAnalytics.opens_7d ?? 0) ||
	(editorAnalytics.clicks_7d ?? 0)
);
const hasFollowData = Boolean(
	(editorAnalytics.top_followed_topics ?? []).length ||
	(editorAnalytics.top_followed_sources ?? []).length
);
const hasSurfacePerformance = Boolean((editorAnalytics.suggestion_surface_performance ?? []).length);
const hasKindPerformance = Boolean((editorAnalytics.suggestion_kind_performance ?? []).length);
const hasDeliveryPerformance = Boolean((editorAnalytics.delivery_kind_performance ?? []).length);
---

<Layout title="Статистика" description="Дневната слика на медиумската сцена: обем, ритам, доминантни извори и редакциски сигнали.">
    <NYTHeader />

	<main class="site-layout py-12">
		<div class="stats-shell editorial-shell">
			<header class="stats-header editorial-header motion-rise">
				<span class="page-kicker">Аналитика</span>
				<h1 class="stats-headline editorial-headline">
					Медиумски пулс
				</h1>
				<p class="stats-subtitle editorial-intro">
					Дневната слика на медиумската сцена: обем, ритам и доминантни извори.
				</p>
			</header>

			{stats ? (
				<div class="stats-flow">
					<section class="stats-overview motion-rise motion-delay-1">
						<div class="overview-primary editorial-panel editorial-panel-strong">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Activity size={10}/> Главна слика</p>
							<p class="overview-value">{stats.last_24h.toLocaleString()}</p>
							<p class="overview-copy">
								објави во последните 24 часа низ {stats.total_feeds} извори. Денот најсилно го турка {topSource ? topSource.source : 'водечката редакциска група'}.
							</p>
							<div class="overview-meta">
								<span>Сублимат: {stats.summarized_pct}%</span>
								<span>Вкупно статии: {stats.total_articles.toLocaleString()}</span>
							</div>
						</div>
						<div class="overview-secondary">
							<div class="metric-card editorial-panel metric-card-accent">
								<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><BarChart3 size={10}/> Најгласен извор</p>
								<p class="metric-value metric-value-label">{topSource?.source ?? 'Нема податок'}</p>
								<p class="metric-caption">{topSource ? `${topSource.n} статии денес.` : 'Се уште нема доволно податоци.'}</p>
							</div>
							<div class="metric-card editorial-panel">
								<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Layers size={10}/> Водечка категорија</p>
								<p class="metric-value metric-value-label">{topCategory?.cat ?? 'Нема податок'}</p>
								<p class="metric-caption">{topCategory ? `${topCategory.n} објави во оваа категорија.` : 'Се уште нема доволно податоци.'}</p>
							</div>
						</div>
					</section>

					<div class="stats-metrics motion-rise motion-delay-1">
						<div class="metric-card editorial-panel">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Layers size={10}/> Вкупно статии</p>
							<p class="metric-value">{stats.total_articles.toLocaleString()}</p>
						</div>
						<div class="metric-card editorial-panel">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Activity size={10}/> Последни 24ч</p>
							<p class="metric-value text-nyt-red">{stats.last_24h.toLocaleString()}</p>
						</div>
						<div class="metric-card editorial-panel">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Zap size={10}/> Пресек сублимат 24ч</p>
							<p class="metric-value">{stats.summarized_pct}%</p>
							<p class="metric-caption">{stats.summarized_24h} од {stats.last_24h.toLocaleString()} статии во последните 24 часа.</p>
						</div>
						<div class="metric-card editorial-panel">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><BarChart3 size={10}/> Извори</p>
							<p class="metric-value">{stats.total_feeds}</p>
						</div>
					</div>

					<div class="stats-grid motion-rise motion-delay-2">
						<div class="stats-main">
							<section class="stats-module stats-module-priority editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Најактивни медиуми</h2>
								<div class="source-bars">
									{stats.by_source.slice(0, 10).map((src: any) => (
										<div class="source-row">
											<div class="source-row-top">
												<span>{src.source}</span>
												<span>{src.n} статии</span>
											</div>
											<div class="source-bar-track">
												<div 
													class="source-bar-fill" 
													style={`width: ${Math.min(100, (src.n / stats.last_24h) * 100 * 5)}%`}
												></div>
											</div>
										</div>
									))}
								</div>
							</section>

							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Распределба по категории</h2>
								<div class="category-grid">
									{stats.by_category.map((cat: any) => (
										<div class="category-card">
											<p class="nyt-section-label text-muted-foreground mb-1">{cat.cat}</p>
											<p class="category-value">{cat.n}</p>
										</div>
									))}
								</div>
							</section>

							{hasFollowData && (
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Што следат луѓето</h2>
								<div class="follow-grid">
									<div class="follow-card">
										<h3 class="follow-title">Најследени Теми</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_topics ?? []).slice(0, 6).map((item: any, idx: number) => (
												<div class="follow-row">
													<span class="follow-rank">{idx + 1}.</span>
													<span class="follow-label">{item.topic}</span>
													<span class="follow-count">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
									<div class="follow-card">
										<h3 class="follow-title">Најследени Извори</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_sources ?? []).slice(0, 6).map((item: any, idx: number) => (
												<div class="follow-row">
													<span class="follow-rank">{idx + 1}.</span>
													<span class="follow-label">{item.source}</span>
													<span class="follow-count">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
								</div>
							</section>
							)}

							{hasEditorSignals && (
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Редакциски сигнали</h2>
								<div class="editor-metrics">
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Синхронизирани профили</p>
										<p class="editor-value">{stats.editor_analytics?.synced_profiles ?? 0}</p>
										<p class="editor-copy">Профили што зачувуваат теми, извори или историја на читање.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Активни во 7 дена</p>
										<p class="editor-value">{stats.editor_analytics?.active_profiles_7d ?? 0}</p>
										<p class="editor-copy">Профили што се ажурирале во последната недела.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Активна достава</p>
										<p class="editor-value">{stats.editor_analytics?.delivery_active ?? 0}</p>
										<p class="editor-copy">Синхронизирани профили со вклучена достава.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Ntfy дестинации</p>
										<p class="editor-value">{stats.editor_analytics?.delivery_targets ?? 0}</p>
										<p class="editor-copy">Профили со успешно поврзан канал за испорака.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Отворања во 7 дена</p>
										<p class="editor-value">{stats.editor_analytics?.opens_7d ?? 0}</p>
										<p class="editor-copy">Отворања на доставени брифинзи преку испратените известувања.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Кликови во 7 дена</p>
										<p class="editor-value">{stats.editor_analytics?.clicks_7d ?? 0}</p>
										<p class="editor-copy">Кликови кон брифинг, кластер или поврзана страница.</p>
									</div>
								</div>
							</section>
							)}

							{hasSurfacePerformance && (
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Конверзија На Површини За Следење</h2>
								<div class="follow-grid">
									{(stats.editor_analytics?.suggestion_surface_performance ?? []).slice(0, 6).map((item: any) => (
										<div class="follow-card">
											<h3 class="follow-title">{item.label}</h3>
											<div class="system-list">
												<div class="system-row">
													<span>Тренд 7 дена:</span>
													<span class="text-foreground font-black">{item.trend_label} ({item.trend_delta > 0 ? '+' : ''}{item.trend_delta} пп)</span>
												</div>
												<div class="system-row">
													<span>Сега / претходно:</span>
													<span class="text-foreground font-black">{item.current_7d_rate}% / {item.previous_7d_rate}%</span>
												</div>
												<div class="system-row">
													<span>Импресии:</span>
													<span class="text-foreground font-black">{item.impressions}</span>
												</div>
												<div class="system-row">
													<span>Следења:</span>
													<span class="text-foreground font-black">{item.follows}</span>
												</div>
												<div class="system-row">
													<span>Конверзија:</span>
													<span class="text-foreground font-black">{item.conversion_rate}%</span>
												</div>
												<div class="system-row">
													<span>Теми / извори:</span>
													<span class="text-foreground font-black">{item.topic_follows} / {item.source_follows}</span>
												</div>
											</div>
										</div>
									))}
								</div>
							</section>
							)}

							{hasKindPerformance && (
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Конверзија По Вид На Предлог</h2>
								<div class="follow-grid">
									{(stats.editor_analytics?.suggestion_kind_performance ?? []).slice(0, 2).map((item: any) => (
										<div class="follow-card">
											<h3 class="follow-title">{item.label}</h3>
											<div class="system-list">
												<div class="system-row">
													<span>Импресии:</span>
													<span class="text-foreground font-black">{item.impressions}</span>
												</div>
												<div class="system-row">
													<span>Следења:</span>
													<span class="text-foreground font-black">{item.follows}</span>
												</div>
												<div class="system-row">
													<span>Конверзија:</span>
													<span class="text-foreground font-black">{item.conversion_rate}%</span>
												</div>
												<div class="system-row">
													<span>Отфрлања:</span>
													<span class="text-foreground font-black">{item.dismissals}</span>
												</div>
											</div>
										</div>
									))}
								</div>
							</section>
							)}

							<ReaderSuggestionAnalyticsIsland client:load />

							{hasDeliveryPerformance && (
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Најуспешни Типови На Достава</h2>
								<div class="follow-grid">
									{(stats.editor_analytics?.delivery_kind_performance ?? []).slice(0, 3).map((item: any) => (
										<div class="follow-card">
											<h3 class="follow-title">{item.label}</h3>
											<div class="system-list">
												<div class="system-row">
													<span>Испраќања:</span>
													<span class="text-foreground font-black">{item.sends}</span>
												</div>
												<div class="system-row">
													<span>Отворања:</span>
													<span class="text-foreground font-black">{item.opens}</span>
												</div>
												<div class="system-row">
													<span>Кликови:</span>
													<span class="text-foreground font-black">{item.clicks}</span>
												</div>
												<div class="system-row">
													<span>Стапка на отворање:</span>
													<span class="text-foreground font-black">{item.open_rate}%</span>
												</div>
												<div class="system-row">
													<span>Стапка на клик:</span>
													<span class="text-foreground font-black">{item.click_rate}%</span>
												</div>
											</div>
										</div>
									))}
								</div>
							</section>
							)}
						</div>

						<aside class="stats-rail">
								<div class="rail-card editorial-panel">
									<h3 class="rail-card-title editorial-panel-title">Оперативна Слика</h3>
									<div class="system-list">
										<div class="system-row">
											<span>Статус:</span>
											<span class="text-green-600 font-black">Активно</span>
										</div>
									<div class="system-row">
										<span>База на податоци:</span>
										<span class="text-foreground font-black">{stats.db_size_mb} MB</span>
									</div>
									<div class="system-row">
										<span>Најстара објава:</span>
										<span class="text-foreground font-black">{new Date(stats.oldest_article).toLocaleDateString('mk-MK')}</span>
									</div>
									<div class="system-row">
										<span>Најнова објава:</span>
										<span class="text-foreground font-black">{new Date(stats.new_article).toLocaleTimeString('mk-MK')}</span>
									</div>
								</div>
							</div>

								<div class="rail-card rail-card-dark editorial-panel-strong">
									<h4 class="rail-card-title speed-title editorial-panel-title">Прв На Приказната</h4>
									<p class="speed-copy">
										Кои извори најчесто први влегуваат во нова приказна? Преглед на раните објави во последните 7 дена.
									</p>
								<div class="speed-list">
									{stats.speed_leaderboard.slice(0, 5).map((src: any, idx: number) => (
										<div class="speed-row">
											<span class="speed-source">
												<span class="speed-rank">{idx + 1}.</span>
												{src.source}
											</span>
											<span class="speed-count">{src.first_count}</span>
										</div>
									))}
								</div>
							</div>

							<div class="rail-card editorial-panel">
								<h4 class="rail-card-title editorial-panel-title">Достава И Следење</h4>
								<div class="system-list">
									<div class="system-row">
										<span>Утрински брифинзи:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.morning_briefings ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Неделни дигести:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.weekly_digests ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Известувања за теми:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.breaking_topic_alerts ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Известувања за извори:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.breaking_source_alerts ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Историја на читање:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.profiles_with_recent_reads ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Испраќања / 7 дена:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.sends_7d ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Стапка на отворање:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.open_rate_7d ?? 0}%</span>
									</div>
									<div class="system-row">
										<span>Стапка на клик:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.click_rate_7d ?? 0}%</span>
									</div>
								</div>
							</div>
						</aside>
					</div>
				</div>
			) : (
				<div class="space-y-16 animate-pulse">
					<div class="stats-metrics">
						{[1,2,3,4].map(() => (
							<div class="metric-card">
								<div class="h-3 w-24 bg-nyt-gray-100 mb-4"></div>
								<div class="h-10 w-32 bg-nyt-gray-200"></div>
							</div>
						))}
					</div>
					<div class="stats-grid">
						<div class="stats-main space-y-16">
							<section>
								<div class="h-6 w-48 bg-nyt-gray-200 mb-8"></div>
								<div class="space-y-6">
									{[1,2,3,4,5].map(() => (
										<div class="h-4 w-full bg-nyt-gray-100"></div>
									))}
								</div>
							</section>
							<section>
								<div class="h-6 w-48 bg-nyt-gray-200 mb-8"></div>
								<div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
									{[1,2,3,4,5,6,7,8].map(() => (
										<div class="h-24 bg-nyt-gray-100 border border-nyt-gray-200"></div>
									))}
								</div>
							</section>
						</div>
					</div>
				</div>
			)}
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.stats-headline {
		font-size: clamp(2.5rem, 1.8rem + 2vw, 4.6rem);
	}

	.stats-subtitle {
		max-width: 44rem;
	}

	.stats-flow,
	.stats-main,
	.stats-rail {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.stats-overview {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.overview-primary,
	.overview-secondary {
		display: grid;
		gap: 1rem;
	}

	.overview-primary {
		padding: 1.2rem;
	}

	.overview-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3rem, 2.2rem + 2vw, 5rem);
		line-height: 0.92;
	}

	.overview-copy {
		margin: 0;
		max-width: 42rem;
		font-family: var(--font-nyt-body);
		font-size: 1rem;
		line-height: 1.55;
		color: var(--secondary-foreground);
	}

	.overview-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.metric-card-accent {
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--background) 97%, var(--secondary) 3%), color-mix(in srgb, var(--background) 90%, #efe6da 10%));
	}

	.stats-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.metric-value {
		font-family: var(--font-serif);
		font-size: clamp(2rem, 1.45rem + 1vw, 3rem);
		line-height: 1;
		margin: 0;
	}

	.metric-value-label {
		font-size: clamp(1.3rem, 1rem + 0.7vw, 1.9rem);
		line-height: 1.08;
	}

	.metric-caption {
		margin: 0.45rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
