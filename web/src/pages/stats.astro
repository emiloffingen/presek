---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { SourceSpectrum } from '../components/SourceSpectrum.tsx';
import ReaderSuggestionAnalyticsIsland from '../components/ReaderSuggestionAnalyticsIsland.tsx';
import { BarChart3, Activity, Zap, Layers, Globe, ShieldCheck, Cpu } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';

const API_URL = apiBaseUrl();

let stats = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/stats/full`);
    if (res.ok) {
        stats = await res.json();
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на статистиките.";
}

const topSource = stats?.by_source?.[0] ?? null;
const topCategory = stats?.by_category?.[0] ?? null;
const intelligence = stats?.intelligence ?? {};
---

<Layout title="Медиумски Пулс" description="Детална аналитика за македонскиот медиумски простор: обем, баланс и вештачка интелигенција.">
    <NYTHeader />

	<main class="site-layout py-12">
		<div class="stats-shell editorial-shell">
			<header class="stats-header editorial-header motion-rise">
				<span class="page-kicker">Интелигенција</span>
				<h1 class="stats-headline editorial-headline">
					Медиумски пулс
				</h1>
				<p class="stats-subtitle editorial-intro">
					Дневната слика на медиумската сцена: обем, ритам, диверзитет и AI транспарентност.
				</p>
			</header>

			{stats ? (
				<div class="stats-flow">
					<section class="stats-hero-grid motion-rise motion-delay-1">
						<div class="hero-primary editorial-panel editorial-panel-strong">
							<p class="nyt-section-label flex items-center gap-1"><Activity size={10}/> ОБЕМ (24ч)</p>
							<p class="hero-value">{stats.last_24h.toLocaleString()}</p>
							<p class="hero-copy">
								нови објави низ {stats.total_feeds} извори. Во просек, по една вест на секои {Math.round(86400 / stats.last_24h)} секунди.
							</p>
						</div>

						<div class="hero-secondary grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="metric-card editorial-panel">
								<p class="nyt-section-label flex items-center gap-1"><ShieldCheck size={10}/> Плурализам (24ч)</p>
								<p class="metric-value">{intelligence.pluralism?.high_consensus_pct}%</p>
								<p class="metric-caption">Сторири со широк консензус од сите медиумски сфери.</p>
							</div>
							<div class="metric-card editorial-panel">
								<p class="nyt-section-label flex items-center gap-1"><Globe size={10}/> Светот кај нас</p>
								<p class="metric-value">{intelligence.international_share_pct}%</p>
								<p class="metric-caption">Удел на вестите од светот во вкупниот дневен волумен.</p>
							</div>
						</div>
					</section>

                    <section class="intelligence-overview motion-rise motion-delay-2">
                        <div class="editorial-panel">
                            <h2 class="stats-section-title flex items-center gap-2"><Cpu size={16} className="text-nyt-accent" /> Транспарентност на Вештачка Интелигенција</h2>
                            <div class="ai-transparency-grid mt-6">
                                <div class="ai-stat-row">
                                    <div class="ai-stat-main">
                                        <span class="text-3xl font-serif font-black">{intelligence.ai_transparency?.ai_ratio}%</span>
                                        <span class="nyt-section-label">AI Синтеза</span>
                                    </div>
                                    <div class="ai-stat-bar-wrap">
                                        <div class="ai-stat-bar-fill" style={`width: ${intelligence.ai_transparency?.ai_ratio}%`}></div>
                                    </div>
                                    <p class="text-xs text-muted-foreground mt-2">
                                        Удел на вестите синтетизирани преку Mistral/Gemini модели. Останатите се обработени локално.
                                    </p>
                                </div>
                                <div class="ai-breakdown-mini grid grid-cols-2 gap-6 pt-4 border-t border-border mt-4">
                                    <div>
                                        <span class="block text-xs font-black uppercase text-muted-foreground">AI Модели</span>
                                        <span class="block text-lg font-serif font-bold">{intelligence.ai_transparency?.ai_summaries}</span>
                                    </div>
                                    <div>
                                        <span class="block text-xs font-black uppercase text-muted-foreground">Локален NLP</span>
                                        <span class="block text-lg font-serif font-bold">{intelligence.ai_transparency?.local_summaries}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

					{stats.by_source && stats.by_source.length > 0 && (
						<section class="stats-landscape motion-rise motion-delay-2">
							<div class="editorial-panel">
								<h2 class="stats-section-title editorial-panel-title">Медиумски Спектар</h2>
								<p class="text-sm text-muted-foreground mb-6">Дистрибуција на активните објави според уредувачкиот профил на медиумите во последните 24 часа.</p>
								<SourceSpectrum 
									articles={stats.by_source.flatMap((s: any) => 
										Array(s.n).fill({ source: s.source })
									)} 
									client:visible 
								/>
							</div>
						</section>
					)}

					<div class="stats-grid motion-rise motion-delay-3">
						<div class="stats-main">
							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title">Најактивни извори (24ч)</h2>
								<div class="source-bars mt-6">
									{stats.by_source.slice(0, 10).map((src: any) => (
										<div class="source-row">
											<div class="source-row-top">
												<span class="font-bold">{src.source}</span>
												<span class="text-muted-foreground">{src.n}</span>
											</div>
											<div class="source-bar-track">
												<div 
													class="source-bar-fill" 
													style={`width: ${Math.min(100, (src.n / stats.last_24h) * 100 * 5)}%`}
												></div>
											</div>
										</div>
									))}
								</div>
							</section>

							<section class="stats-module editorial-panel">
								<h2 class="stats-section-title">Најследени од читателите</h2>
								<div class="follow-grid mt-6">
									<div class="follow-card p-4 bg-secondary/20 border border-border">
										<h3 class="text-xs font-black uppercase mb-4 text-nyt-accent tracking-widest">Топ Теми</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_topics ?? []).slice(0, 5).map((item: any, idx: number) => (
												<div class="flex justify-between py-2 border-b border-border last:border-0">
													<span class="font-serif font-bold italic">{item.topic}</span>
													<span class="font-black text-xs opacity-60">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
									<div class="follow-card p-4 bg-secondary/20 border border-border">
										<h3 class="text-xs font-black uppercase mb-4 text-nyt-accent tracking-widest">Топ Извори</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_sources ?? []).slice(0, 5).map((item: any, idx: number) => (
												<div class="flex justify-between py-2 border-b border-border last:border-0">
													<span class="font-serif font-bold italic">{item.source}</span>
													<span class="font-black text-xs opacity-60">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
								</div>
							</section>

							<ReaderSuggestionAnalyticsIsland client:load />
						</div>

						<aside class="stats-rail">
								<div class="rail-card editorial-panel-strong">
									<h3 class="rail-card-title flex items-center gap-2"><Zap size={14} /> Оперативен Статус</h3>
									<div class="system-list mt-4">
										<div class="system-row">
											<span>Систем:</span>
											<span class="text-emerald-500 font-black">Оптимално</span>
										</div>
                                        <div class="system-row">
                                            <span>База:</span>
                                            <span class="font-bold">{stats.db_size_mb} MB</span>
                                        </div>
                                        <div class="system-row">
                                            <span>Архива:</span>
                                            <span class="font-bold">{stats.total_articles.toLocaleString()}</span>
                                        </div>
                                    </div>
                                </div>

								<div class="rail-card editorial-panel">
									<h4 class="rail-card-title text-xs font-black uppercase tracking-widest border-b border-border pb-3 mb-4">Прв на приказната</h4>
								    <div class="speed-list">
									{stats.speed_leaderboard.slice(0, 8).map((src: any, idx: number) => (
										<div class="flex justify-between items-center py-2 border-b border-border last:border-0 text-sm">
											<span class="font-bold">{src.source}</span>
											<span class="text-nyt-accent font-black">{src.first_count}</span>
										</div>
									))}
								    </div>
                                    <p class="text-[10px] text-muted-foreground mt-4 leading-snug">
                                        Број на стории каде овој медиум бил првиот што известил во последните 7 дена.
                                    </p>
							    </div>
						</aside>
					</div>
				</div>
			) : (
				<div class="p-24 text-center">
                    <Activity className="animate-spin mx-auto mb-4 opacity-20" size={48} />
                    <p class="font-serif italic text-muted-foreground">Се вчитува пулсот на медиумите...</p>
                </div>
			)}
		</div>
	</main>

	<Footer />
</Layout>

<style>
    .editorial-shell {
        max-width: 1100px;
        margin: 0 auto;
    }

	.stats-headline {
		font-size: clamp(3rem, 2.5rem + 3vw, 5.5rem);
        line-height: 0.88;
        letter-spacing: -0.04em;
        margin: 0.5rem 0 1.5rem;
	}

	.stats-subtitle {
		max-width: 44rem;
        font-size: 1.25rem;
        color: var(--secondary-foreground);
	}

	.stats-flow,
	.stats-main,
	.stats-rail {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.stats-hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.hero-primary {
		padding: 2rem;
	}

	.hero-value {
		margin: 0.5rem 0;
		font-family: var(--font-serif);
		font-size: clamp(4rem, 3.5rem + 4vw, 8rem);
		line-height: 0.85;
        font-weight: 900;
        letter-spacing: -0.05em;
	}

	.hero-copy {
		margin: 0;
		max-width: 32rem;
		font-family: var(--font-nyt-body);
		font-size: 1.15rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
	}

	.metric-value {
		font-family: var(--font-serif);
		font-size: 2.5rem;
		line-height: 1;
		margin: 0.35rem 0;
        font-weight: 900;
	}

	.metric-caption {
		font-size: 0.75rem;
		color: var(--muted-foreground);
		line-height: 1.4;
	}

    .ai-stat-bar-wrap {
        height: 8px;
        background: var(--muted);
        border: 1px solid var(--border);
        margin: 1rem 0;
    }

    .ai-stat-bar-fill {
        height: 100%;
        background: var(--nyt-accent);
    }

    .ai-stat-main {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }

	.stats-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.source-row {
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.source-row:first-child {
		border-top: 0;
	}

	.source-row-top {
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.source-bar-track {
		height: 4px;
		margin-top: 0.75rem;
		background: var(--muted);
	}

	.source-bar-fill {
		height: 100%;
		background: var(--foreground);
	}

    .system-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .system-row:last-child {
        border-bottom: 0;
    }

	@media (min-width: 960px) {
		.stats-hero-grid {
			grid-template-columns: 1.4fr 1fr;
		}

		.stats-grid {
			grid-template-columns: 1.8fr 1fr;
			gap: 3rem;
		}

        .follow-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .stats-rail {
            position: sticky;
            top: 2rem;
        }
	}
</style>
