---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { BarChart3, Activity, Zap, Layers } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || (typeof window !== 'undefined' ? "/api" : "http://127.0.0.1:5000/api");

let stats = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/stats/full`);
    if (res.ok) {
        stats = await res.json();
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на статистиките.";
}
---

<Layout title="Статистика">
    <NYTHeader />

	<main class="site-layout py-12">
		<div class="stats-shell">
			<header class="stats-header">
				<span class="page-kicker">Аналитика</span>
				<h1 class="stats-headline">
					Медиумски Пулс
				</h1>
				<p class="stats-subtitle">
					Дневната слика на медиумската сцена: обем, ритам и доминантни извори.
				</p>
			</header>

			{stats ? (
				<div class="stats-flow">
					<div class="stats-metrics">
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Layers size={10}/> Вкупно статии</p>
							<p class="metric-value">{stats.total_articles.toLocaleString()}</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Activity size={10}/> Последни 24ч</p>
							<p class="metric-value text-nyt-red">{stats.last_24h.toLocaleString()}</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Zap size={10}/> Пресек Сублимат</p>
							<p class="metric-value">{stats.summarized_pct}%</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><BarChart3 size={10}/> Извори</p>
							<p class="metric-value">{stats.total_feeds}</p>
						</div>
					</div>

					<div class="stats-grid">
						<div class="stats-main">
							<section class="stats-module">
								<h2 class="stats-section-title">Редакциски Сигнали</h2>
								<div class="editor-metrics">
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Синхронизирани профили</p>
										<p class="editor-value">{stats.editor_analytics?.synced_profiles ?? 0}</p>
										<p class="editor-copy">Профили што зачувуваат теми, извори или историја на читање.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Активни во 7 дена</p>
										<p class="editor-value">{stats.editor_analytics?.active_profiles_7d ?? 0}</p>
										<p class="editor-copy">Профили што се ажурирале во последната недела.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Активна достава</p>
										<p class="editor-value">{stats.editor_analytics?.delivery_active ?? 0}</p>
										<p class="editor-copy">Синхронизирани профили со вклучена достава.</p>
									</div>
									<div class="editor-card">
										<p class="nyt-section-label text-muted-foreground mb-1">Ntfy цели</p>
										<p class="editor-value">{stats.editor_analytics?.delivery_targets ?? 0}</p>
										<p class="editor-copy">Профили со реално внесен канал за испорака.</p>
									</div>
								</div>
							</section>

							<section class="stats-module">
								<h2 class="stats-section-title">Најактивни Медиуми</h2>
								<div class="source-bars">
									{stats.by_source.slice(0, 10).map((src: any) => (
										<div class="source-row">
											<div class="source-row-top">
												<span>{src.source}</span>
												<span>{src.n} статии</span>
											</div>
											<div class="source-bar-track">
												<div 
													class="source-bar-fill" 
													style={`width: ${Math.min(100, (src.n / stats.last_24h) * 100 * 5)}%`}
												></div>
											</div>
										</div>
									))}
								</div>
							</section>

							<section class="stats-module">
								<h2 class="stats-section-title">Распределба По Категории</h2>
								<div class="category-grid">
									{stats.by_category.map((cat: any) => (
										<div class="category-card">
											<p class="nyt-section-label text-muted-foreground mb-1">{cat.cat}</p>
											<p class="category-value">{cat.n}</p>
										</div>
									))}
								</div>
							</section>

							<section class="stats-module">
								<h2 class="stats-section-title">Што Луѓето Го Следат</h2>
								<div class="follow-grid">
									<div class="follow-card">
										<h3 class="follow-title">Најследени Теми</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_topics ?? []).slice(0, 6).map((item: any, idx: number) => (
												<div class="follow-row">
													<span class="follow-rank">{idx + 1}.</span>
													<span class="follow-label">{item.topic}</span>
													<span class="follow-count">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
									<div class="follow-card">
										<h3 class="follow-title">Најследени Извори</h3>
										<div class="follow-list">
											{(stats.editor_analytics?.top_followed_sources ?? []).slice(0, 6).map((item: any, idx: number) => (
												<div class="follow-row">
													<span class="follow-rank">{idx + 1}.</span>
													<span class="follow-label">{item.source}</span>
													<span class="follow-count">{item.followers}</span>
												</div>
											))}
										</div>
									</div>
								</div>
							</section>
						</div>

						<aside class="stats-rail">
								<div class="rail-card">
									<h3 class="rail-card-title">Оперативна Слика</h3>
									<div class="system-list">
										<div class="system-row">
											<span>Статус:</span>
											<span class="text-green-600 font-black">Активно</span>
										</div>
									<div class="system-row">
										<span>База на податоци:</span>
										<span class="text-foreground font-black">{stats.db_size_mb} MB</span>
									</div>
									<div class="system-row">
										<span>Најстара објава:</span>
										<span class="text-foreground font-black">{new Date(stats.oldest_article).toLocaleDateString('mk-MK')}</span>
									</div>
									<div class="system-row">
										<span>Најнова објава:</span>
										<span class="text-foreground font-black">{new Date(stats.new_article).toLocaleTimeString('mk-MK')}</span>
									</div>
								</div>
							</div>

								<div class="rail-card rail-card-dark">
									<h4 class="rail-card-title speed-title">Прв На Приказната</h4>
									<p class="speed-copy">
										Кои извори најчесто први влегуваат во нова приказна? Преглед на раните објави во последните 7 дена.
									</p>
								<div class="speed-list">
									{stats.speed_leaderboard.slice(0, 5).map((src: any, idx: number) => (
										<div class="speed-row">
											<span class="speed-source">
												<span class="speed-rank">{idx + 1}.</span>
												{src.source}
											</span>
											<span class="speed-count">{src.first_count}</span>
										</div>
									))}
								</div>
							</div>

							<div class="rail-card">
								<h4 class="rail-card-title">Достава И Следење</h4>
								<div class="system-list">
									<div class="system-row">
										<span>Утрински брифинзи:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.morning_briefings ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Неделни дигести:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.weekly_digests ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Известувања за теми:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.breaking_topic_alerts ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Известувања за извори:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.breaking_source_alerts ?? 0}</span>
									</div>
									<div class="system-row">
										<span>Историја на читање:</span>
										<span class="text-foreground font-black">{stats.editor_analytics?.profiles_with_recent_reads ?? 0}</span>
									</div>
								</div>
							</div>
						</aside>
					</div>
				</div>
			) : (
				<div class="space-y-16 animate-pulse">
					<div class="stats-metrics">
						{[1,2,3,4].map(() => (
							<div class="metric-card">
								<div class="h-3 w-24 bg-nyt-gray-100 mb-4"></div>
								<div class="h-10 w-32 bg-nyt-gray-200"></div>
							</div>
						))}
					</div>
					<div class="stats-grid">
						<div class="stats-main space-y-16">
							<section>
								<div class="h-6 w-48 bg-nyt-gray-200 mb-8"></div>
								<div class="space-y-6">
									{[1,2,3,4,5].map(() => (
										<div class="h-4 w-full bg-nyt-gray-100"></div>
									))}
								</div>
							</section>
							<section>
								<div class="h-6 w-48 bg-nyt-gray-200 mb-8"></div>
								<div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
									{[1,2,3,4,5,6,7,8].map(() => (
										<div class="h-24 bg-nyt-gray-100 border border-nyt-gray-200"></div>
									))}
								</div>
							</section>
						</div>
					</div>
				</div>
			)}
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.stats-shell {
		max-width: 76rem;
		margin: 0 auto;
	}

	.stats-header {
		padding-bottom: 2rem;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}
	.stats-headline {
		font-size: clamp(2.5rem, 1.8rem + 2vw, 4.6rem);
		line-height: 0.96;
		margin: 0 0 1rem;
	}

	.stats-subtitle {
		margin: 0;
		max-width: 44rem;
		font-family: var(--font-nyt-body);
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--secondary-foreground);
	}

	.stats-flow,
	.stats-main,
	.stats-rail {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.stats-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.metric-card,
	.stats-module,
	.rail-card {
		padding: 1.35rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%);
	}

	.metric-value {
		font-family: var(--font-serif);
		font-size: clamp(2rem, 1.45rem + 1vw, 3rem);
		line-height: 1;
		margin: 0;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.stats-section-title,
	.rail-card-title {
		margin: 0 0 1rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.source-bars,
	.speed-list,
	.system-list {
		display: flex;
		flex-direction: column;
	}

	.source-row,
	.system-row,
	.speed-row {
		padding: 0.85rem 0;
		border-top: 1px solid var(--border);
	}

	.source-row:first-child,
	.system-row:first-child,
	.speed-row:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.source-row-top,
	.system-row,
	.speed-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.source-bar-track {
		height: 0.3rem;
		margin-top: 0.55rem;
		background: var(--nyt-gray-200);
		overflow: hidden;
	}

	.source-bar-fill {
		height: 100%;
		background: var(--foreground);
		transition: width 400ms ease;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.editor-metrics,
	.follow-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 1rem;
	}

	.editor-card,
	.follow-card {
		padding: 1rem;
		border: 1px solid var(--border);
		background: var(--background);
	}

	.editor-value {
		margin: 0 0 0.4rem;
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 1.15rem + 0.8vw, 2.15rem);
		line-height: 1;
	}

	.editor-copy {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--secondary-foreground);
	}

	.follow-title {
		margin: 0 0 0.8rem;
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.follow-list {
		display: flex;
		flex-direction: column;
	}

	.follow-row {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.75rem;
		align-items: center;
		padding: 0.75rem 0;
		border-top: 1px solid var(--border);
	}

	.follow-row:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.follow-rank,
	.follow-count {
		font-size: 0.82rem;
		font-weight: 900;
	}

	.follow-label {
		font-size: 0.98rem;
	}

	.category-card {
		padding: 1rem;
		border: 1px solid var(--border);
		background: var(--background);
	}

	.category-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.9rem;
		line-height: 1;
	}

	.rail-card-dark {
		background: #172033;
		color: #f8fafc;
		border-color: #25324a;
	}

	.rail-card-dark .rail-card-title,
	.speed-title {
		color: #f8fafc;
		border-bottom-color: rgba(248, 250, 252, 0.16);
	}

	.speed-copy {
		margin: 0 0 1rem;
		font-family: var(--font-nyt-body);
		font-size: 0.96rem;
		line-height: 1.55;
		color: rgba(248, 250, 252, 0.76);
	}

	.speed-row {
		color: #f8fafc;
		border-top-color: rgba(248, 250, 252, 0.12);
	}

	.speed-source {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: rgba(248, 250, 252, 0.9);
	}

	.speed-rank {
		color: rgba(248, 250, 252, 0.42);
	}

	.speed-count {
		font-weight: 900;
		color: #f5c26b;
	}

	@media (min-width: 960px) {
		.stats-metrics {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.stats-grid {
			grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.8fr);
			gap: 2rem;
		}

		.editor-metrics,
		.follow-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.category-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
