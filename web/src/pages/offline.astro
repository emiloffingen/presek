---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { WifiOff, Archive, Clock } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
---

<Layout title={t('offline.title')} robots="noindex">
    <NYTHeader />

    <main class="site-layout broadsheet-layout py-[var(--page-py)] min-h-[60vh] flex flex-col items-center justify-center text-center">
        <div class="offline-hero mb-12">
            <div class="relative inline-block">
                <WifiOff size={80} className="text-muted-foreground/20" strokeWidth={1} />
                <div class="absolute inset-0 flex items-center justify-center animate-pulse">
                     <WifiOff size={80} className="text-nyt-accent/40" strokeWidth={1} />
                </div>
            </div>
        </div>

        <h1 class="font-serif text-3xl md:text-5xl font-black mb-6 tracking-tight">{t('offline.heading')}</h1>
        <p class="max-w-xl font-nyt-body text-xl text-secondary-foreground leading-relaxed mb-10">
            {t('offline.description')}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--grid-gap)] w-full max-w-2xl">
            <a href={l('/')} class="offline-action-card">
                <Clock size={24} className="text-nyt-accent" />
                <div class="text-left">
                    <h3 class="font-black text-xs uppercase tracking-widest mb-1">{t('offline.action_home_title')}</h3>
                    <p class="text-[11px] text-muted-foreground">{t('offline.action_home_desc')}</p>
                </div>
            </a>
            <a href={l('/archive')} class="offline-action-card">
                <Archive size={24} className="text-nyt-accent" />
                <div class="text-left">
                    <h3 class="font-black text-xs uppercase tracking-widest mb-1">{t('offline.action_briefing_title')}</h3>
                    <p class="text-[11px] text-muted-foreground">{t('offline.action_briefing_desc')}</p>
                </div>
            </a>
        </div>

        <button onclick="window.location.reload()" class="mt-12 px-8 py-3 bg-foreground text-background font-black uppercase text-[10px] tracking-[0.2em] hover:bg-nyt-accent transition-colors">
            {t('offline.button_retry')}
        </button>
    </main>

    <Footer />
</Layout>

<style>
    .offline-action-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        background: var(--secondary);
        border: 1px solid var(--border);
        border-radius: 0px;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s;
    }

    .offline-action-card:hover {
        transform: translateY(-4px);
        border-color: var(--nyt-accent);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
</style>
