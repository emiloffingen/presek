---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IntelligenceGraph from '../components/IntelligenceGraph';
import { ErrorBoundary } from '../components/ui/ErrorBoundary.tsx';
import Footer from '../components/Footer.astro';
import TinyAdzInlinedAd from '../components/TinyAdzInlinedAd.astro';
import TinyAdzRailAd from '../components/TinyAdzRailAd.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { shouldShowTinyAdzInlinedAds } from '../lib/tinyadz';
import '../styles/graph-premium.css';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const showRailAd = shouldShowTinyAdzInlinedAds(lang, hostHeader || Astro.url.hostname);
---

<Layout
    title={t('graph.page_title')}
    description={t('graph.page_description')}
>
    <NYTHeader />

	<main class="site-layout broadsheet-layout graph-page graph-page-scope py-[var(--page-py)] animate-rise">
		<Breadcrumbs items={[{ label: t('graph.breadcrumb') }]} />
		<div class="broadsheet-grid">
			<div class="broadsheet-main">
				<TinyAdzInlinedAd class="page-inline-ad mb-10" />
				<ErrorBoundary client:idle lang={lang}>
					<IntelligenceGraph lang={lang} client:idle />
				</ErrorBoundary>
			</div>
			{showRailAd && (
				<aside class="broadsheet-rail ad-only-rail pl-4">
					<TinyAdzRailAd />
				</aside>
			)}
		</div>
	</main>
	<Footer />
</Layout>
