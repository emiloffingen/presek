---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { Activity, Database, RefreshCw, ServerCog, AlertTriangle } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || (typeof window !== 'undefined' ? "/api" : "http://127.0.0.1:5000/api");

let health = null;
let sourceCatalog = [];
let error = null;

try {
	const [healthRes, sourceRes] = await Promise.all([
		fetch(`${API_URL}/health`),
		fetch(`${API_URL}/sources?include_inactive=1`),
	]);
	if (healthRes.ok) {
		health = await healthRes.json();
	} else {
		error = "Страницата за статус не е достапна во моментов.";
	}
	sourceCatalog = sourceRes.ok ? await sourceRes.json() : [];
} catch (e) {
	console.error(e);
	error = "Грешка при вчитување на статусот.";
}

const taskEntries = health?.tasks ? Object.values(health.tasks) : [];
const orderedTasks = taskEntries.sort((a: any, b: any) => String(b.time || '').localeCompare(String(a.time || '')));
const sourceEntries = sourceCatalog.map((source: any) => ({
	...source,
	...(source.source_status || {}),
}));
const orderedSources = sourceEntries.sort((a: any, b: any) => {
	const degradedA = a.degraded ? 1 : 0;
	const degradedB = b.degraded ? 1 : 0;
	if (degradedA !== degradedB) return degradedB - degradedA;
	return String(b.time || '').localeCompare(String(a.time || ''));
});

function formatTime(value: string) {
	if (!value) return 'Нема податок';
	try {
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return 'Нема податок';
		return date.toLocaleString('mk-MK', {
			day: '2-digit',
			month: '2-digit',
			hour: '2-digit',
			minute: '2-digit',
		});
	} catch {
		return 'Нема податок';
	}
}

function statusLabel(status: string) {
	switch (status) {
		case 'ok':
		case 'fresh':
			return 'Стабилно';
		case 'aging':
		case 'warning':
			return 'Има доцнење';
		case 'stale':
		case 'fallback':
			return 'Работи со ограничувања';
		case 'error':
			return 'Потребна проверка';
		default:
			return status || 'Непознато';
	}
}

function statusTone(status: string) {
	switch (status) {
		case 'ok':
		case 'fresh':
			return 'fresh';
		case 'aging':
		case 'warning':
			return 'aging';
		case 'stale':
		case 'fallback':
		case 'error':
			return 'stale';
		default:
			return 'neutral';
	}
}

function qualityLabel(score: number) {
	if (score >= 0.85) return 'Силен';
	if (score >= 0.6) return 'Намален';
	return 'Ризичен';
}

function pauseLabel(source: any) {
	if (source.is_active) return 'Активен';
	if (source.pause_mode === 'auto') return 'Авто-пауза';
	return 'Рачна пауза';
}

function sourceLabel(source: any) {
	return source.source || source.name || 'Непознат извор';
}
---

<Layout title="Системски статус">
	<NYTHeader />

	<main class="site-layout py-12">
		<div class="status-shell">
			<header class="status-header">
				<span class="page-kicker">Систем</span>
				<h1 class="status-headline">Состојба На Пресек</h1>
				<p class="status-subtitle">
					Краток оперативен преглед: свежина на податоците, здравје на сервисите и последни pipeline задачи.
				</p>
			</header>

			{error && (
				<div class="status-alert status-alert-error">
					<AlertTriangle size={16} />
					<p>{error}</p>
				</div>
			)}

			{health && (
				<div class="status-flow">
					<div class="status-metrics">
						<div class={`metric-card freshness-${health.freshness?.status || 'stale'}`}>
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><RefreshCw size={10}/> Свежина</p>
							<p class="metric-value">{statusLabel(health.freshness?.status)}</p>
							<p class="metric-note">
								{health.freshness?.label}
								{typeof health.freshness?.age_minutes === 'number' ? ` · ${health.freshness.age_minutes} мин` : ''}
							</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Activity size={10}/> Последно освежување</p>
							<p class="metric-value metric-value-compact">{formatTime(health.last_refresh?.time)}</p>
							<p class="metric-note">{health.last_refresh?.new_articles || 0} нови статии</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><Database size={10}/> База / Redis</p>
							<p class="metric-value metric-value-compact">
								{health.database?.ok ? 'DB OK' : 'DB Down'} · {health.redis?.ok ? 'Redis OK' : 'Redis Down'}
							</p>
							<p class="metric-note">{health.database?.article_count?.toLocaleString?.('mk-MK') || 0} статии</p>
						</div>
						<div class="metric-card">
							<p class="nyt-section-label text-muted-foreground mb-2 flex items-center gap-1"><ServerCog size={10}/> Uptime</p>
							<p class="metric-value metric-value-compact">{health.uptime}</p>
							<p class="metric-note">{health.status === 'ok' ? 'Сервисите одговараат нормално' : 'Има деградација'}</p>
						</div>
					</div>

					<div class="status-grid">
						<div class="status-main">
							<section class="status-module">
								<h2 class="status-section-title">Pipeline задачи</h2>
								<div class="task-list">
									{orderedTasks.length > 0 ? (
										orderedTasks.map((task: any) => (
											<div class="task-row">
												<div>
													<p class="task-name">{task.task}</p>
													<p class="task-detail">{task.detail || 'Нема дополнителни детали'}</p>
												</div>
												<div class="task-meta">
													<span class={`task-badge task-${task.status}`}>{statusLabel(task.status)}</span>
													<span class="task-time">{formatTime(task.time)}</span>
												</div>
											</div>
										))
									) : (
										<p class="status-copy">Сè уште нема забележани task настани.</p>
									)}
								</div>
							</section>
						</div>

						<aside class="status-rail">
							<div class="rail-card">
								<h3 class="rail-card-title">Состојба по извор</h3>
								<div class="source-list">
									{orderedSources.length > 0 ? (
										orderedSources.slice(0, 8).map((source: any) => (
											<div class={`source-row ${source.degraded ? 'source-row-degraded' : ''}`} data-source-row={source.name}>
												<div>
													<p class="task-name">{sourceLabel(source)}</p>
													<p class="task-detail">
														Преземени: {source.fetched || 0} · Прифатени: {source.accepted || 0}
													</p>
													<p class="task-detail">
														Квалитет: {qualityLabel(source.quality_score || 0)} · {Math.round((source.acceptance_ratio || 0) * 100)}%
													</p>
													<p class="task-detail">
														Статус: {pauseLabel(source)} · Cred {Number(source.credibility || 0).toFixed(1)}
													</p>
													{source.auto_flagged && <p class="task-detail">Авто-означен поради слаб принос.</p>}
													{source.pause_reason && <p class="task-detail">{source.pause_reason}</p>}
													{source.error && <p class="task-detail">{source.error}</p>}
												</div>
												<div class="task-meta">
													<span class={`task-badge task-${statusTone(source.status)}`}>{statusLabel(source.status)}</span>
													<span class="task-time">{formatTime(source.time)}</span>
													<div class="source-actions" data-source={source.name}>
														<button class="source-action-btn" data-action={source.is_active ? 'pause' : 'resume'} type="button">
															{source.is_active ? 'Пауза' : 'Продолжи'}
														</button>
														<button class="source-action-btn" data-action="downrank" type="button">Намали</button>
														<button class="source-action-btn" data-action="uprank" type="button">Зголеми</button>
														<button class="source-action-btn" data-action="reset" type="button">Ресет</button>
													</div>
												</div>
											</div>
										))
									) : (
										<p class="status-copy">Сè уште нема per-source ingestion статуси.</p>
									)}
								</div>
							</div>

							<div class="rail-card">
								<h3 class="rail-card-title">Source controls</h3>
								<p class="status-copy">
									Внесете admin token за паузирање, продолжување или менување на тежината на изворите.
								</p>
								<input id="source-admin-token" class="source-token-input" type="password" placeholder="Admin token" />
								<p id="source-control-feedback" class="task-detail"></p>
							</div>

							<div class="rail-card">
								<h3 class="rail-card-title">Последен ingestion циклус</h3>
								<div class="system-list">
									<div class="system-row">
										<span>Време:</span>
										<span>{formatTime(health.last_refresh?.time)}</span>
									</div>
									<div class="system-row">
										<span>Нови статии:</span>
										<span>{health.last_refresh?.new_articles || 0}</span>
									</div>
									<div class="system-row">
										<span>Грешки:</span>
										<span>{health.last_refresh?.errors?.length || 0}</span>
									</div>
								</div>
							</div>

							<div class="rail-card">
								<h3 class="rail-card-title">Ако нешто доцни</h3>
								<p class="status-copy">
									Проверете ги последните task статуси подолу. Ако свежината е означена како „Работи со ограничувања“
									или „Потребна проверка“, најчесто ingestion или synthesis работи во fallback режим.
								</p>
							</div>
						</aside>
					</div>
				</div>
			)}
		</div>
	</main>

	<Footer />
</Layout>

<script>
	const feedbackEl = document.getElementById('source-control-feedback');
	const tokenEl = document.getElementById('source-admin-token');

	function setFeedback(message, isError = false) {
		if (!feedbackEl) return;
		feedbackEl.textContent = message;
		feedbackEl.style.color = isError ? 'var(--nyt-red)' : 'var(--secondary-foreground)';
	}

	document.querySelectorAll('.source-actions').forEach((group) => {
		group.addEventListener('click', async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLButtonElement)) return;
			const action = target.dataset.action;
			const source = group.dataset.source;
			const token = tokenEl instanceof HTMLInputElement ? tokenEl.value.trim() : '';
			if (!action || !source) return;
			if (!token) {
				setFeedback('Внесете admin token за да продолжите.', true);
				return;
			}

			target.disabled = true;
			setFeedback(`Се извршува: ${action} за ${source}...`);
			try {
				const res = await fetch(`/api/sources/${encodeURIComponent(source)}/control`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'X-Admin-Token': token,
					},
					body: JSON.stringify({ action }),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) {
					throw new Error(data.message || 'Контролата не успеа.');
				}
				setFeedback(`Успешно: ${source} → ${action}. Освежете ја страницата за новиот преглед.`);
			} catch (error) {
				setFeedback(error instanceof Error ? error.message : 'Контролата не успеа.', true);
			} finally {
				target.disabled = false;
			}
		});
	});
</script>

<style>
	.status-shell {
		max-width: 76rem;
		margin: 0 auto;
	}

	.status-header {
		padding-bottom: 2rem;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}

	.status-headline {
		font-size: clamp(2.4rem, 1.8rem + 2vw, 4.5rem);
		line-height: 0.96;
		margin: 0 0 1rem;
	}

	.status-subtitle,
	.status-copy,
	.metric-note,
	.task-detail {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 1rem;
		line-height: 1.65;
		color: var(--secondary-foreground);
	}

	.status-alert {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 1rem 1.1rem;
		margin-bottom: 1.5rem;
		border: 1px solid var(--border);
	}

	.status-alert-error {
		color: var(--nyt-red);
		border-color: color-mix(in srgb, var(--nyt-red) 36%, var(--border) 64%);
	}

	.status-flow,
	.status-main,
	.status-rail {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.status-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.metric-card,
	.status-module,
	.rail-card {
		padding: 1.35rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%);
	}

	.metric-value {
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 1.35rem + 1vw, 2.8rem);
		line-height: 1;
		margin: 0 0 0.55rem;
	}

	.metric-value-compact {
		font-size: clamp(1.15rem, 1rem + 0.65vw, 1.75rem);
		line-height: 1.2;
	}

	.freshness-fresh .metric-value {
		color: #2f855a;
	}

	.freshness-aging .metric-value {
		color: #9a6700;
	}

	.freshness-stale .metric-value {
		color: var(--nyt-red);
	}

	.status-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.status-section-title,
	.rail-card-title {
		margin: 0 0 1rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.task-list,
	.source-list,
	.system-list {
		display: flex;
		flex-direction: column;
	}

	.task-row,
	.source-row,
	.system-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 0;
		border-top: 1px solid var(--border);
	}

	.task-row:first-child,
	.source-row:first-child,
	.system-row:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.task-name,
	.system-row span:first-child {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 0.3rem;
	}

	.task-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
		flex: 0 0 auto;
	}

	.task-badge {
		display: inline-flex;
		padding: 0.18rem 0.45rem;
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.task-ok,
	.task-fresh {
		color: #2f855a;
		border-color: color-mix(in srgb, #2f855a 36%, var(--border) 64%);
	}

	.task-warning,
	.task-aging {
		color: #9a6700;
		border-color: color-mix(in srgb, #9a6700 36%, var(--border) 64%);
	}

	.task-fallback,
	.task-stale,
	.task-error {
		color: var(--nyt-red);
		border-color: color-mix(in srgb, var(--nyt-red) 36%, var(--border) 64%);
	}

	.task-time,
	.system-row span:last-child {
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.source-row-degraded {
		background: color-mix(in srgb, var(--nyt-red) 4%, transparent 96%);
	}

	.source-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.35rem;
		margin-top: 0.35rem;
	}

	.source-action-btn,
	.source-token-input {
		border: 1px solid var(--border);
		background: var(--background);
		font-family: var(--font-sans);
	}

	.source-action-btn {
		padding: 0.32rem 0.48rem;
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.source-action-btn:disabled {
		opacity: 0.6;
	}

	.source-token-input {
		width: 100%;
		padding: 0.7rem 0.8rem;
		margin-top: 0.85rem;
		font-size: 0.92rem;
	}

	@media (min-width: 960px) {
		.status-grid {
			grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.85fr);
		}
	}

	@media (max-width: 640px) {
		.status-metrics {
			grid-template-columns: 1fr;
		}

		.task-row,
		.system-row {
			flex-direction: column;
		}

		.task-meta {
			align-items: flex-start;
		}
	}
</style>
