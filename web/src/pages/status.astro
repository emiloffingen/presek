---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { apiBaseUrl } from '../lib/apiBase';
import { isHealthyStatus } from '../lib/localePaths';
import { APP_VERSION } from '../lib/version';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const API_URL = apiBaseUrl();
let healthData = {
    status: "degraded",
    uptime_seconds: 0,
    database: { ok: false, article_count: 0, size_mb: 0 },
    redis: { ok: false },
    version: APP_VERSION,
    freshness: { status: "stale", age_minutes: null, label: "" },
    celery_queue: {
        celery_depth: 0,
        total_depth: 0,
        warn_depth: 150,
        critical_depth: 500,
        degraded: false,
        queues: {},
    },
    synthesis_quality: {},
    ai: { enabled: true, providers: {} as Record<string, { limit: number; used: number }> },
};

try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 10000);
    const res = await fetch(`${API_URL}/health`, { signal: controller.signal });
    clearTimeout(timer);
    if (res.ok) {
        healthData = { ...healthData, ...(await res.json()) };
    }
} catch (e) {
    console.error("[Status Page] Fetch error:", e);
}

const isHealthy = isHealthyStatus(healthData.status);
const isBusy = healthData.status === 'busy';
const statusLabel = isHealthy
    ? t('status.status_healthy')
    : isBusy
        ? t('status.status_busy')
        : t('status.degraded');
const statusClass = isHealthy ? 'ok' : isBusy ? 'busy' : 'degraded';
const celeryQueue = (healthData.celery_queue || {}) as any;
const readerQueueNames = ['ingestion', 'ingestion-crawl', 'fast-track', 'synthesis', 'intel-heavy', 'delivery'];
const readerQueueDepths = readerQueueNames.map((name) => Number(celeryQueue?.queues?.[name]?.depth ?? 0));
const readerMaxDepth = readerQueueDepths.length ? Math.max(...readerQueueDepths) : 0;
const readerTotalDepth = readerQueueDepths.reduce((sum, depth) => sum + depth, 0);
const pipelineBusy = Boolean(celeryQueue?.degraded) || readerMaxDepth >= Number(celeryQueue?.warn_depth || 150);
const freshness = healthData.freshness || {};
const synthesisQuality = (healthData.synthesis_quality || {}) as any;
const synthesisStatus = String(synthesisQuality?.status || 'unknown');
const synthesisPrimary = (synthesisQuality?.primary || {}) as any;
const stuckFastCount = Number(synthesisQuality?.stuck_fast_synthesis_count || 0);
const fallbackRatio = Number(synthesisPrimary?.fallback_ratio || 0);
const synthesisDetail = stuckFastCount > 0
    ? `${t('status.pipeline_synthesis_sub')} · ${stuckFastCount} provisional`
    : fallbackRatio > 0
        ? `${t('status.pipeline_synthesis_sub')} · ${Math.round(fallbackRatio * 100)}% fallback`
        : t('status.pipeline_synthesis_sub');

const aiQuota = ((healthData as any).ai || {}) as { enabled: boolean | null; providers: Record<string, { limit: number; used: number }> };
const activeAiProviders = Object.entries(aiQuota.providers || {})
    .filter(([, v]) => v && Number(v.limit) > 0)
    .sort((a, b) => Number(b[1].limit) - Number(a[1].limit));
const quotaPct = (used: number, limit: number) => Math.min(100, Math.round((Number(used) / Math.max(1, Number(limit))) * 100));

const formattedUptime = (seconds: number) => {
    if (!seconds) return "0s";
    const d = Math.floor(seconds / (3600 * 24));
    const h = Math.floor((seconds % (3600 * 24)) / 3600);
    const m = Math.floor((seconds % 3600) / 60);

    const parts = [];
    if (d > 0) parts.push(`${d}${t('status.uptime_day')}`);
    if (h > 0) parts.push(`${h}${t('status.uptime_hour')}`);
    if (m > 0) parts.push(`${m}${t('status.uptime_min')}`);
    return parts.join(' ') || `${seconds}s`;
};
---

<Layout
    title={t('status.title')}
    description={t('status.description')}
>
    <NYTHeader />
    <main class="site-layout py-[var(--page-py)]" id="system-status-main">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">{t('status.kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">
                    {t('status.heading')} <span>{t('status.heading_span')}</span>
                </h1>
            </div>
            <p class="masthead-intro">
                {t('status.intro')}
            </p>
        </header>

        <div class="status-grid">
            <div class="status-overview-card" id="status-card-root">
                <div class="status-header">
                    <span class="status-title">{t('status.system_status')}</span>
                    <span class={`status-badge-pill ${statusClass}`}>
                        <span class="relative flex h-2.5 w-2.5 pulse-container">
                            <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${isHealthy ? 'bg-emerald-400' : isBusy ? 'bg-amber-400' : 'bg-red-400'}`}></span>
                            <span class={`relative inline-flex rounded-full h-2.5 w-2.5 ${isHealthy ? 'bg-emerald-500' : isBusy ? 'bg-amber-500' : 'bg-red-500'}`}></span>
                        </span>
                        {statusLabel}
                    </span>
                </div>
                
                <div class="metrics-grid">
                    <div class="metric-card" id="metric-db">
                        <div class="metric-label">{t('status.database')}</div>
                        <div class="metric-value">{healthData.database.ok ? "OK" : "ERROR"}</div>
                        <div class="metric-sub">{healthData.database.article_count.toLocaleString()} {t('status.articles')} | {healthData.database.size_mb.toFixed(1)} MB</div>
                    </div>
                    <div class="metric-card" id="metric-redis">
                        <div class="metric-label">{t('status.redis')}</div>
                        <div class="metric-value">{healthData.redis.ok ? "OK" : "ERROR"}</div>
                        <div class="metric-sub">{t('status.redis_active')}</div>
                    </div>
                    <div class="metric-card" id="metric-uptime">
                        <div class="metric-label">{t('status.uptime')}</div>
                        <div class="metric-value">{formattedUptime(healthData.uptime_seconds)}</div>
                        <div class="metric-sub">{t('status.uptime_sub')}</div>
                    </div>
                    <div class="metric-card" id="metric-version">
                        <div class="metric-label">{t('status.version')}</div>
                        <div class="metric-value">v{healthData.version || APP_VERSION}</div>
                        <div class="metric-sub">{t('status.version_sub')}</div>
                    </div>
                </div>
            </div>

            <section class="pipeline-status-card">
                <div class="pipeline-status-header">
                    <div>
                        <h2 class="status-title">{t('status.pipeline_title')}</h2>
                        <p class="pipeline-status-intro">{t('status.pipeline_intro')}</p>
                    </div>
                    <span class={`pipeline-pill ${pipelineBusy ? 'busy' : 'ok'}`}>
                        {pipelineBusy ? t('status.pipeline_busy') : t('status.pipeline_ok')}
                    </span>
                </div>
                <div class="metrics-grid">
                    <div class="metric-card">
                        <div class="metric-label">{t('status.pipeline_queue')}</div>
                        <div class="metric-value">{readerMaxDepth.toLocaleString()}</div>
                        <div class="metric-sub">{t('status.pipeline_queue_sub')}</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">{t('status.pipeline_freshness')}</div>
                        <div class="metric-value">{freshness.label || freshness.status || '—'}</div>
                        <div class="metric-sub">
                            {freshness.age_minutes != null
                                ? `${freshness.age_minutes} min`
                                : t('status.uptime_sub')}
                        </div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">{t('status.pipeline_synthesis')}</div>
                        <div class="metric-value">{synthesisStatus.toUpperCase()}</div>
                        <div class="metric-sub">{synthesisDetail}</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">{t('status.pipeline_total')}</div>
                        <div class="metric-value">{readerTotalDepth.toLocaleString()}</div>
                        <div class="metric-sub">{t('status.pipeline_total_sub')}</div>
                    </div>
                </div>
            </section>

            {aiQuota.enabled && activeAiProviders.length > 0 && (
                <section class="pipeline-status-card">
                    <div class="pipeline-status-header">
                        <div>
                            <h2 class="status-title">{t('status.ai_title')}</h2>
                            <p class="pipeline-status-intro">{t('status.ai_intro')}</p>
                        </div>
                    </div>
                    <div class="ai-quota-list">
                        {activeAiProviders.map(([name, quota]) => (
                            <div class="ai-quota-row">
                                <span class="ai-quota-name">{name}</span>
                                <div class="ai-quota-track">
                                    <div class="ai-quota-fill" style={`width: ${quotaPct(quota.used, quota.limit)}%`} />
                                </div>
                                <span class="ai-quota-count">{quota.used}/{quota.limit}</span>
                            </div>
                        ))}
                    </div>
                </section>
            )}
        </div>
    </main>
    <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px double var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    /* ── Status Grid ────────────────────────────────── */
    .status-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--grid-gap);
    }

    .status-overview-card {
        border: 1px solid var(--border);
        background: var(--card);
        padding: 2.5rem;
        border-radius: 0px;
        box-shadow: var(--shadow-sm);
    }

    .status-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
    }

    .status-title {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        color: var(--foreground);
    }

    .status-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        border-radius: 0px;
        border: 1px solid transparent;
    }

    .status-badge-pill.ok {
        background: color-mix(in srgb, #10b981 8%, transparent);
        color: #059669;
        border-color: color-mix(in srgb, #10b981 20%, transparent);
    }

    .status-badge-pill.degraded {
        background: color-mix(in srgb, var(--nyt-red) 8%, transparent);
        color: var(--nyt-red);
        border-color: color-mix(in srgb, var(--nyt-red) 20%, transparent);
    }

    .status-badge-pill.busy {
        background: color-mix(in srgb, #f59e0b 8%, transparent);
        color: #b45309;
        border-color: color-mix(in srgb, #f59e0b 20%, transparent);
    }

    .pipeline-status-card {
        margin-top: 1.5rem;
        border: 1px solid var(--border);
        background: var(--card);
        padding: 2rem;
        box-shadow: var(--shadow-sm);
    }

    .pipeline-status-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .pipeline-status-intro {
        margin: 0.65rem 0 0;
        max-width: 42rem;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        line-height: 1.5;
        color: var(--muted-foreground);
    }

    .pipeline-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .ai-quota-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .ai-quota-row {
        display: grid;
        grid-template-columns: 6.5rem 1fr 5rem;
        align-items: center;
        gap: 0.85rem;
    }

    .ai-quota-name {
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--foreground);
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ai-quota-track {
        height: 0.55rem;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--secondary) 40%, var(--background));
        overflow: hidden;
    }

    .ai-quota-fill {
        height: 100%;
        background: var(--presek-mark);
    }

    .ai-quota-count {
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        text-align: right;
        color: var(--muted-foreground);
    }

    .pipeline-pill.ok {
        background: color-mix(in srgb, #10b981 8%, transparent);
        color: #059669;
        border-color: color-mix(in srgb, #10b981 20%, transparent);
    }

    .pipeline-pill.busy {
        background: color-mix(in srgb, #f59e0b 8%, transparent);
        color: #b45309;
        border-color: color-mix(in srgb, #f59e0b 20%, transparent);
    }

    /* ── Metrics Grid ───────────────────────────────── */
    .metrics-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 640px) {
        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .metrics-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .metric-card {
        border: 1px solid var(--border);
        background: var(--secondary);
        padding: 1.5rem;
        border-radius: 0px;
        transition: transform 0.3s var(--ease-editorial), border-color 0.3s;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--nyt-accent) 40%, transparent);
    }

    .metric-label {
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.1em;
        color: var(--muted-foreground);
        margin-bottom: 0.75rem;
    }

    .metric-value {
        font-family: var(--font-serif);
        font-size: 1.85rem;
        font-weight: 900;
        color: var(--foreground);
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .metric-sub {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--muted-foreground);
    }
</style>
