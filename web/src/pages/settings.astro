---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import SettingsProfileIsland from '../components/SettingsProfileIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import { KeyRound, Radio, Sparkles } from 'lucide-react';
---

<Layout title="Поставки">
  <NYTHeader />

  <main class="site-layout py-[var(--page-py)]">
    <div class="settings-shell editorial-shell">
      <header class="settings-header editorial-header motion-rise">
        <span class="page-kicker">Синхронизиран профил</span>
        <h1 class="settings-headline editorial-headline">Поставки</h1>
        <p class="settings-lede editorial-intro">
          Управувајте со вашиот клуч за синхронизација, следените теми и извори, и каналите за достава што го претвораат Пресек во услуга меѓу уреди.
        </p>
      </header>

      <div class="settings-page-grid editorial-page-grid">
        <div class="settings-main editorial-main motion-rise motion-delay-1">
          <div class="settings-card editorial-panel">
            <OnboardingIsland client:load />
          </div>
          <div class="settings-card editorial-panel">
            <SettingsProfileIsland client:load />
          </div>
        </div>

        <aside class="settings-rail editorial-rail motion-rise motion-delay-2">
          <div class="settings-card editorial-panel">
            <h3 class="settings-rail-title editorial-panel-title"><Radio size={14} /> Достава и известувања</h3>
            <BriefingDeliveryIsland client:load variant="full" />
          </div>

          <div class="settings-card settings-card-accent editorial-panel-strong">
            <h3 class="settings-rail-title editorial-panel-title"><KeyRound size={14} /> Зошто синхронизацијата е важна</h3>
            <p class="settings-rail-copy">
              Синхронизацијата ги носи вашите следења, изборите за достава и историјата на читање меѓу уреди. Така „За Вас“, итните известувања и неделните дигести остануваат конзистентни наместо да почнуваат одново во секој прелистувач.
            </p>
          </div>

          <div class="settings-card editorial-panel">
            <h3 class="settings-rail-title editorial-panel-title"><Sparkles size={14} /> Што контролира ова</h3>
            <p class="settings-rail-copy">
              Оваа страница ги управува деловите од Пресек што треба да се приспособат на вас: рангирање, препораки, достава за следени теми, достава за следени извори и поспориот неделен преглед.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .settings-card-accent {
    color: var(--foreground);
  }

  .settings-rail-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .settings-rail-copy {
    margin: 0;
    font-family: var(--font-nyt-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--secondary-foreground);
  }
</style>
