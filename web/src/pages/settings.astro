---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import SettingsProfileIsland from '../components/SettingsProfileIsland.tsx';
import AccountSyncIsland from '../components/AccountSyncIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import { KeyRound, Radio, ShieldCheck, UserCircle2, Sparkles, ArrowUpRight } from 'lucide-react';
import '../styles/settings-premium.css';
---

<Layout title="Podešavanja — Presek" description="Upravljajte sinhronizacijom, praćenjem i dostavom brifinga u Preseku.">
  <NYTHeader />

  <main class="site-layout py-[var(--page-py)]">
    <Breadcrumbs items={[{ label: "Podešavanja" }]} />

    <div class="max-w-[1200px] mx-auto mt-12">
      <header class="settings-header editorial-header mb-[clamp(2rem, 4vw, 3.5rem)] motion-rise">
        <div class="flex items-center gap-[var(--grid-gap)] mb-4">
            <div class="w-10 h-[1px] bg-nyt-accent"></div>
            <span class="page-kicker !mb-0 text-[var(--text-xs)]">KONTROLNI CENTAR</span>
        </div>
        <h1 class="settings-headline editorial-headline italic text-[clamp(2rem, 4vw, 3.5rem)] font-serif">Vaš <span>Digitalni</span> Profil</h1>
        <p class="settings-lede editorial-intro max-w-3xl mt-6 text-[var(--text-lg)] text-muted-foreground">
          Presek radi bez lozinki. Vaš profil je anoniman, ali sinhronizovan. Ovde kontrolišete teme koje pratite i način na koji dobijate vesti.
        </p>
      </header>

      <div class="settings-shell mt-8 motion-rise">
        <!-- Left sidebar: Tab navigation and Status widget -->
        <aside class="settings-nav-sidebar">
          <button class="settings-tab-btn active" data-tab="profil">
            <UserCircle2 size={16} />
            <span>Profil & Teme</span>
          </button>
          <button class="settings-tab-btn" data-tab="dostava">
            <Radio size={16} />
            <span>Dostava</span>
          </button>
          <button class="settings-tab-btn" data-tab="sinhronizacija">
            <KeyRound size={16} />
            <span>Sinhronizacija</span>
            <span class="ml-auto text-[9px] px-1.5 py-0.5 rounded-full font-black uppercase tracking-wider bg-amber-500/10 text-amber-500 border border-amber-500/20" id="sync-tab-badge">Lokalno</span>
          </button>
          <button class="settings-tab-btn" data-tab="vodic">
            <Sparkles size={16} />
            <span>Vodič</span>
            <span class="ml-auto text-[9px] px-1.5 py-0.5 rounded-full font-black uppercase tracking-wider bg-nyt-accent/10 text-nyt-accent border border-nyt-accent/20" id="guide-tab-badge">0/4</span>
          </button>

          <!-- Status Indicator Card -->
          <div class="sidebar-identity-status hidden lg:block">
            <div class="flex items-center gap-2">
              <span class="status-dot inactive" id="sync-status-dot"></span>
              <span class="text-xs font-black uppercase tracking-wider text-muted-foreground" id="sync-status-text">LOKALNI PROFIL</span>
            </div>
            <p class="text-[10px] text-muted-foreground mt-2 leading-relaxed" id="sync-status-desc">
              Vaš profil se čuva u ovom pretraživaču. Povežite digitalni pasoš da biste ga sinhronizovali.
            </p>
          </div>

          <!-- Desktop Quick Support links -->
          <div class="sidebar-help-links hidden lg:block mt-8 pt-6 border-t border-border/40">
            <h4 class="text-[10px] font-black uppercase tracking-wider text-muted-foreground mb-4">Pomoć i Podrška</h4>
            <div class="flex flex-col gap-2.5 text-xs font-semibold text-muted-foreground">
              <a href="/briefing" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Otvorite brifing <ArrowUpRight size={12} /></a>
              <a href="/izvori" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Uredite izvore <ArrowUpRight size={12} /></a>
              <a href="/contact" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Korespondencija <ArrowUpRight size={12} /></a>
            </div>
          </div>
        </aside>

        <!-- Right Content Wrapper -->
        <div class="settings-content-wrapper space-y-8">
          <!-- 1. PROFILE & INTERESTS -->
          <div id="tab-profil" class="settings-tab-content active">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <ShieldCheck size={18} className="text-nyt-accent" />
              <h2 class="section-label font-sans text-xs font-black uppercase tracking-widest text-foreground">PROFIL & INTERESOVANJA</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <SettingsProfileIsland lang="sr" client:visible />
          </div>

          <!-- 2. DELIVERY -->
          <div id="tab-dostava" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <Radio size={18} className="text-nyt-accent" />
              <h2 class="section-label font-sans text-xs font-black uppercase tracking-widest text-foreground">PODEŠAVANJA DOSTAVE</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <div class="premium-card">
              <BriefingDeliveryIsland lang="sr" client:visible variant="full" />
            </div>
          </div>

          <!-- 3. SYNC & DIGITAL PASSPORT -->
          <div id="tab-sinhronizacija" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <KeyRound size={18} className="text-nyt-accent" />
              <h2 class="section-label font-sans text-xs font-black uppercase tracking-widest text-foreground">DIGITALNI PASOŠ</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <AccountSyncIsland lang="sr" client:visible />
          </div>

          <!-- 4. ONBOARDING GUIDE -->
          <div id="tab-vodic" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <Sparkles size={18} className="text-nyt-accent" />
              <h2 class="section-label font-sans text-xs font-black uppercase tracking-widest text-foreground">VODIČ ZA UPOZNAVANJE</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <div class="premium-card">
              <OnboardingIsland lang="sr" client:visible />
            </div>
          </div>

          <!-- Mobile Help Links Footer (fallback) -->
          <div class="block lg:hidden mt-12 pt-6 border-t border-border/40">
            <h4 class="text-[10px] font-black uppercase tracking-wider text-muted-foreground mb-4">Pomoć i Podrška</h4>
            <div class="grid grid-cols-3 gap-4 text-xs font-semibold text-muted-foreground">
              <a href="/briefing" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Brifing <ArrowUpRight size={12} /></a>
              <a href="/izvori" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Izvori <ArrowUpRight size={12} /></a>
              <a href="/contact" class="flex justify-between items-center hover:text-nyt-accent transition-colors">Kontakt <ArrowUpRight size={12} /></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { $syncToken, $profile, $onboarding, getStoredOnboardingProgress } from '../lib/store.ts';

  // Tabs Controller
  const tabButtons = document.querySelectorAll('.settings-tab-btn');
  const tabContents = document.querySelectorAll('.settings-tab-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      if (!targetTab) return;

      // Update buttons
      tabButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Update contents
      tabContents.forEach(content => {
        if (content.id === `tab-${targetTab}`) {
          content.classList.add('active');
        } else {
          content.classList.remove('active');
        }
      });
    });
  });

  // Sync token status dynamic updates
  $syncToken.subscribe(token => {
    const dot = document.getElementById('sync-status-dot');
    const text = document.getElementById('sync-status-text');
    const desc = document.getElementById('sync-status-desc');
    const badge = document.getElementById('sync-tab-badge');
    
    const isMK = window.location.pathname.includes('/mk/');

    if (token) {
      if (dot) dot.className = 'status-dot active';
      if (text) text.innerText = isMK ? 'СИНХРОНИЗИРАН ПРОФИЛ' : 'SINHRONIZOVAN PROFIL';
      if (desc) desc.innerText = isMK 
        ? 'Вашиот профил е поврзан со дигитален пасош и се синхронизира со серверот.' 
        : 'Vaš profil je povezan sa digitalnim pasošem i sinhronizuje se sa serverom.';
      
      if (badge) {
        badge.innerText = isMK ? 'Активен' : 'Aktivan';
        badge.className = 'ml-auto text-[9px] px-1.5 py-0.5 rounded-full font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
      }
    } else {
      if (dot) dot.className = 'status-dot inactive';
      if (text) text.innerText = isMK ? 'ЛОКАЛЕН ПРОФИЛ' : 'LOKALNI PROFIL';
      if (desc) desc.innerText = isMK 
        ? 'Вашиот профил се чува во овој прелистувач. Поврзете дигитален пасош за да го синхронизирате.' 
        : 'Vaš profil se čuva u ovom pretraživaču. Povežite digitalni pasoš da biste ga sinhronizovali.';
      
      if (badge) {
        badge.innerText = isMK ? 'Локално' : 'Lokalno';
        badge.className = 'ml-auto text-[9px] px-1.5 py-0.5 rounded-full font-black uppercase tracking-wider bg-amber-500/10 text-amber-500 border border-amber-500/20';
      }
    }
  });

  // Guide badge dynamic updates
  function updateGuideBadge() {
    const badge = document.getElementById('guide-tab-badge');
    if (!badge) return;
    const progress = getStoredOnboardingProgress();
    badge.innerText = `${progress.doneCount}/${progress.total}`;
  }
  $profile.subscribe(updateGuideBadge);
  $onboarding.subscribe(updateGuideBadge);
</script>

<style>
    .page-kicker { font-family: var(--font-sans); font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 1rem; display: block; }
    .editorial-headline span { font-weight: 400; }

    .motion-rise {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes rise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 639.98px) {
        .page-kicker {
            font-size: 0.58rem !important;
            letter-spacing: 0.12em;
        }

        .settings-headline {
            font-size: 2.2rem !important;
            line-height: 0.95 !important;
        }

        .settings-lede {
            margin-top: 0.9rem !important;
            font-size: 1rem !important;
            line-height: 1.45 !important;
        }
    }
</style>
