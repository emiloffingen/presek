---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import SettingsProfileIsland from '../components/SettingsProfileIsland.tsx';
import AccountSyncIsland from '../components/AccountSyncIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import { KeyRound, Radio, ShieldCheck, UserCircle2, Sparkles, ArrowUpRight } from 'lucide-react';
---

<Layout title="Поставки" description="Управувајте со синхронизацијата, следењата и доставата на брифингот во Пресек.">
  <NYTHeader />

  <main class="site-layout py-[var(--page-py)]">
    <Breadcrumbs items={[{ label: "Поставки" }]} />
    
    <div class="settings-shell editorial-shell mt-12">
      <header class="settings-header editorial-header mb-16 motion-rise">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-[1px] bg-nyt-accent"></div>
            <span class="page-kicker !mb-0">КОНТРОЛЕН ЦЕНТАР</span>
        </div>
        <h1 class="settings-headline editorial-headline italic">Вашиот <span>Дигитален</span> Профил</h1>
        <p class="settings-lede editorial-intro max-w-3xl mt-6">
          Пресек работи без лозинки. Вашиот профил е анонимен, но синхронизиран. Овде ги контролирате темите што ги следите и начинот на кој ги добивате вестите.
        </p>
      </header>

      <div class="settings-page-grid grid grid-cols-1 lg:grid-cols-3 gap-16">
        <div class="lg:col-span-2 space-y-16 motion-rise">
            {/* 1. INTERESTS SECTION */}
            <section class="settings-section">
                <div class="section-eyebrow mb-8">
                    <ShieldCheck size={18} className="text-nyt-accent" />
                    <h2 class="section-label">ВАШИ ИНТЕРЕСИ</h2>
                    <div class="section-divider"></div>
                </div>
                <SettingsProfileIsland client:load />
            </section>

            {/* 2. ONBOARDING / DISCOVERY */}
            <section class="settings-section border-t border-border pt-16">
                <div class="section-eyebrow mb-8">
                    <Sparkles size={18} className="text-nyt-accent" />
                    <h2 class="section-label">ОТКРИЈТЕ ПОВЕЌЕ</h2>
                    <div class="section-divider"></div>
                </div>
                <div class="bg-secondary/5 p-8 rounded-2xl border border-border/40">
                    <OnboardingIsland client:load />
                </div>
            </section>
        </div>

        <aside class="settings-rail space-y-12 motion-rise">
          {/* DIGITAL PASSPORT - SYNC */}
          <div class="sidebar-module">
            <h3 class="sidebar-label flex items-center gap-2"><KeyRound size={14} /> ДИГИТАЛЕН ПАСОШ</h3>
            <div class="mt-6">
                <AccountSyncIsland client:load />
            </div>
          </div>

          {/* SUBSCRIPTIONS */}
          <div class="sidebar-module border-t border-border pt-12">
            <h3 class="sidebar-label flex items-center gap-2"><Radio size={14} /> ДОСТАВА</h3>
            <div class="mt-6 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-6 rounded-xl">
                <BriefingDeliveryIsland client:load variant="full" />
            </div>
          </div>

          <div class="sidebar-module border-t border-border pt-12">
            <h4 class="sidebar-label">ПОМОШ И ПОДДРШКА</h4>
            <div class="settings-rail-links mt-6">
              <a href="/briefing" class="flex justify-between items-center group">Отвори брифинг <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
              <a href="/izvori" class="flex justify-between items-center group">Уреди извори <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
              <a href="/contact" class="flex justify-between items-center group">Кореспонденција <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .settings-headline {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .settings-headline span {
    font-weight: 300;
  }

  .settings-lede {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    max-width: 46rem;
  }

  .settings-page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .settings-page-grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr);
      gap: 4rem;
    }
  }

  .settings-rail {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .settings-rail-links {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .settings-rail-links a {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--foreground);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    transition: all 0.2s;
  }

  .settings-rail-links a:hover {
    color: var(--nyt-accent);
    border-bottom-color: var(--nyt-accent);
  }

  .sidebar-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--foreground);
    display: inline;
    margin: 0;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-divider {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
