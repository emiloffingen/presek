---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import SettingsProfileIsland from '../components/SettingsProfileIsland.tsx';
import SettingsOverviewIsland from '../components/SettingsOverviewIsland.tsx';
import AccountSyncIsland from '../components/AccountSyncIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import { ErrorBoundary } from '../components/ui/ErrorBoundary.tsx';
import { KeyRound, Radio, ShieldCheck, UserCircle2, Sparkles, ArrowUpRight, LayoutDashboard } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath } from '../lib/localePaths';
import '../styles/settings-premium.css';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<Layout title={t('settings.title')} description={t('settings.description')} robots="noindex, follow">
  <NYTHeader />

  <main class="site-layout page-content-top pb-[var(--page-py)]">
    <Breadcrumbs items={[{ label: t('settings.breadcrumb') }]} />

    <div class="max-w-[1200px] mx-auto mt-8 md:mt-12">
      <header class="settings-header editorial-header mb-[clamp(2rem, 4vw, 3.5rem)] motion-rise">
        <div class="flex items-center gap-[var(--grid-gap)] mb-4">
            <div class="w-10 h-[1px] bg-nyt-accent"></div>
            <span class="page-kicker ui-label !mb-0">{t('settings.kicker')}</span>
        </div>
        <h1 class="settings-headline editorial-headline italic text-[clamp(2rem, 4vw, 3.5rem)] font-serif">{t('settings.headline')} <span>{t('settings.headline_span')}</span></h1>
        <p class="settings-lede editorial-intro max-w-3xl mt-6 text-[var(--text-lg)] text-muted-foreground">
          {t('settings.lede')}
        </p>
      </header>

      <div
        class="settings-shell mt-8 motion-rise"
        data-settings-lang={lang}
        data-status-local={t('settings.status_local')}
        data-status-synced={t('settings.status_synced')}
        data-status-local-desc={t('settings.status_local_desc')}
        data-status-synced-desc={t('settings.status_synced_desc')}
        data-badge-local={t('settings.badge_local')}
        data-badge-active={t('settings.badge_active')}
      >
        <aside class="settings-nav-sidebar">
          <button class="settings-tab-btn active" data-tab="pregled">
            <LayoutDashboard size={16} />
            <span>{t('settings.tab_overview')}</span>
          </button>
          <button class="settings-tab-btn" data-tab="profil">
            <UserCircle2 size={16} />
            <span>{t('settings.tab_profil')}</span>
          </button>
          <button class="settings-tab-btn" data-tab="dostava">
            <Radio size={16} />
            <span>{t('settings.tab_dostava')}</span>
          </button>
          <button class="settings-tab-btn" data-tab="sinhronizacija">
            <KeyRound size={16} />
            <span>{t('settings.tab_sync')}</span>
            <span class="ml-auto ui-label-min px-1.5 py-0.5 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20" id="sync-tab-badge">{t('settings.badge_local')}</span>
          </button>
          <button class="settings-tab-btn" data-tab="vodic">
            <Sparkles size={16} />
            <span>{t('settings.tab_guide')}</span>
            <span class="ml-auto ui-label-min px-1.5 py-0.5 rounded-full bg-nyt-accent/10 text-nyt-accent border border-nyt-accent/20" id="guide-tab-badge">0/4</span>
          </button>

          <div class="sidebar-identity-status hidden lg:block">
            <div class="flex items-center gap-2">
              <span class="status-dot inactive" id="sync-status-dot"></span>
              <span class="ui-label-min text-muted-foreground" id="sync-status-text">{t('settings.status_local')}</span>
            </div>
            <p class="text-[11px] text-muted-foreground mt-2 leading-relaxed" id="sync-status-desc">
              {t('settings.status_local_desc')}
            </p>
          </div>

          <div class="sidebar-help-links hidden lg:block mt-8 pt-6 border-t border-border/40">
            <h4 class="ui-label-min text-muted-foreground mb-4">{t('settings.help_title')}</h4>
            <div class="flex flex-col gap-2.5 text-xs font-semibold text-muted-foreground">
              <a href={localePath('/for-you', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.help_for_you')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/pregled', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.help_analiza')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/briefing', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.help_briefing')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/izvori', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.help_sources')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/contact', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.help_contact')} <ArrowUpRight size={12} /></a>
            </div>
          </div>
        </aside>

        <div class="settings-content-wrapper space-y-8">
          <div id="tab-pregled" class="settings-tab-content active">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <LayoutDashboard size={18} className="text-nyt-accent" />
              <h2 class="section-label ui-label text-foreground">{t('settings.section_overview')}</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <ErrorBoundary client:idle lang={lang}>
              <SettingsOverviewIsland lang={lang} client:visible />
            </ErrorBoundary>
          </div>

          <div id="tab-profil" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <ShieldCheck size={18} className="text-nyt-accent" />
              <h2 class="section-label ui-label text-foreground">{t('settings.section_profil')}</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <ErrorBoundary client:idle lang={lang}>
              <SettingsProfileIsland lang={lang} client:visible />
            </ErrorBoundary>
          </div>

          <div id="tab-dostava" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <Radio size={18} className="text-nyt-accent" />
              <h2 class="section-label ui-label text-foreground">{t('settings.section_dostava')}</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <div class="premium-card">
              <ErrorBoundary client:idle lang={lang}>
                <BriefingDeliveryIsland lang={lang} client:visible variant="full" />
              </ErrorBoundary>
            </div>
          </div>

          <div id="tab-sinhronizacija" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <KeyRound size={18} className="text-nyt-accent" />
              <h2 class="section-label ui-label text-foreground">{t('settings.section_sync')}</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <ErrorBoundary client:idle lang={lang}>
              <AccountSyncIsland lang={lang} client:visible />
            </ErrorBoundary>
          </div>

          <div id="tab-vodic" class="settings-tab-content">
            <div class="section-eyebrow mb-6 flex items-center gap-4">
              <Sparkles size={18} className="text-nyt-accent" />
              <h2 class="section-label ui-label text-foreground">{t('settings.section_guide')}</h2>
              <div class="section-divider flex-1 h-[1px] bg-border/40 ml-4"></div>
            </div>
            <div class="premium-card">
              <ErrorBoundary client:idle lang={lang}>
                <OnboardingIsland lang={lang} client:visible />
              </ErrorBoundary>
            </div>
          </div>

          <div class="block lg:hidden mt-12 pt-6 border-t border-border/40">
            <h4 class="ui-label-min text-muted-foreground mb-4">{t('settings.help_title')}</h4>
            <div class="grid grid-cols-3 gap-4 text-xs font-semibold text-muted-foreground">
              <a href={localePath('/briefing', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.mobile_briefing')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/izvori', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.mobile_sources')} <ArrowUpRight size={12} /></a>
              <a href={localePath('/contact', lang, hostHeader)} class="flex justify-between items-center hover:text-nyt-accent transition-colors">{t('settings.mobile_contact')} <ArrowUpRight size={12} /></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { $syncToken, $profile, $onboarding, getStoredOnboardingProgress } from '../lib/store.ts';

  const VALID_TABS = new Set(['pregled', 'profil', 'dostava', 'sinhronizacija', 'vodic']);
  const GLOBAL_KEY = '__presekSettingsTabs';

  type SettingsCopy = {
    statusLocal: string;
    statusSynced: string;
    statusLocalDesc: string;
    statusSyncedDesc: string;
    badgeLocal: string;
    badgeActive: string;
  };

  function readSettingsCopy(shell: HTMLElement): SettingsCopy {
    return {
      statusLocal: shell.dataset.statusLocal || '',
      statusSynced: shell.dataset.statusSynced || '',
      statusLocalDesc: shell.dataset.statusLocalDesc || '',
      statusSyncedDesc: shell.dataset.statusSyncedDesc || '',
      badgeLocal: shell.dataset.badgeLocal || '',
      badgeActive: shell.dataset.badgeActive || '',
    };
  }

  function activateTab(targetTab: string) {
    if (!VALID_TABS.has(targetTab)) return;
    document.querySelectorAll('.settings-tab-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === targetTab);
    });
    document.querySelectorAll('.settings-tab-content').forEach((content) => {
      content.classList.toggle('active', content.id === `tab-${targetTab}`);
    });
  }

  function updateSyncStatusUI(token: string | null, copy: SettingsCopy) {
    const dot = document.getElementById('sync-status-dot');
    const text = document.getElementById('sync-status-text');
    const desc = document.getElementById('sync-status-desc');
    const badge = document.getElementById('sync-tab-badge');

    if (token) {
      if (dot) dot.className = 'status-dot active';
      if (text) text.innerText = copy.statusSynced;
      if (desc) desc.innerText = copy.statusSyncedDesc;
      if (badge) {
        badge.innerText = copy.badgeActive;
        badge.className = 'ml-auto ui-label-min px-1.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
      }
    } else {
      if (dot) dot.className = 'status-dot inactive';
      if (text) text.innerText = copy.statusLocal;
      if (desc) desc.innerText = copy.statusLocalDesc;
      if (badge) {
        badge.innerText = copy.badgeLocal;
        badge.className = 'ml-auto ui-label-min px-1.5 py-0.5 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20';
      }
    }
  }

  function updateGuideBadge() {
    const shell = document.querySelector<HTMLElement>('.settings-shell');
    if (!shell) return;
    const badge = document.getElementById('guide-tab-badge');
    if (!badge) return;
    const progress = getStoredOnboardingProgress();
    badge.innerText = `${progress.doneCount}/${progress.total}`;
  }

  function initSettingsTabs() {
    const shell = document.querySelector<HTMLElement>('.settings-shell');
    if (!shell) return;

    document.querySelectorAll<HTMLButtonElement>('.settings-tab-btn').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        if (!targetTab) return;
        activateTab(targetTab);
        window.history.replaceState(null, '', `#${targetTab}`);
      });
    });

    const initialTab = window.location.hash.replace('#', '');
    activateTab(VALID_TABS.has(initialTab) ? initialTab : 'pregled');
    updateSyncStatusUI($syncToken.get(), readSettingsCopy(shell));
    updateGuideBadge();
  }

  const root = window as typeof window & { [GLOBAL_KEY]?: boolean };
  if (!root[GLOBAL_KEY]) {
    root[GLOBAL_KEY] = true;

    window.addEventListener('hashchange', () => {
      const nextTab = window.location.hash.replace('#', '');
      if (VALID_TABS.has(nextTab)) {
        activateTab(nextTab);
      }
    });

    $syncToken.subscribe((token) => {
      const shell = document.querySelector<HTMLElement>('.settings-shell');
      if (!shell) return;
      updateSyncStatusUI(token, readSettingsCopy(shell));
    });

    $profile.subscribe(updateGuideBadge);
    $onboarding.subscribe(updateGuideBadge);
  }

  initSettingsTabs();
  document.addEventListener('astro:page-load', initSettingsTabs);
</script>

<style>
    .editorial-headline span { font-weight: 400; }

    .motion-rise {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes rise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 639.98px) {
        .settings-headline {
            font-size: 2.2rem !important;
            line-height: 0.95 !important;
        }

        .settings-lede {
            margin-top: 0.9rem !important;
            font-size: 1rem !important;
            line-height: 1.45 !important;
        }
    }
</style>
