---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import SettingsProfileIsland from '../components/SettingsProfileIsland.tsx';
import AccountSyncIsland from '../components/AccountSyncIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import { KeyRound, Radio, ShieldCheck, UserCircle2, Sparkles, ArrowUpRight } from 'lucide-react';
---

<Layout title="Podešavanja — Presek" description="Upravljajte sinhronizacijom, praćenjem i dostavom brifinga u Preseku.">
  <NYTHeader />

  <main class="site-layout py-[var(--page-py)]">
    <Breadcrumbs items={[{ label: "Podešavanja" }]} />

    <div class="settings-shell editorial-shell mt-12">
      <header class="settings-header editorial-header mb-[clamp(2rem, 5vw, 4rem)] motion-rise">
        <div class="flex items-center gap-[var(--grid-gap)] mb-4">
            <div class="w-10 h-[1px] bg-nyt-accent"></div>
            <span class="page-kicker !mb-0 text-[var(--text-xs)]">KONTROLNI CENTAR</span>
        </div>
        <h1 class="settings-headline editorial-headline italic text-[clamp(2rem, 4vw, 3.5rem)] font-serif">Vaš <span>Digitalni</span> Profil</h1>
        <p class="settings-lede editorial-intro max-w-3xl mt-6 text-[var(--text-lg)] text-muted-foreground">
          Presek radi bez lozinki. Vaš profil je anoniman, ali sinhronizovan. Ovde kontrolišete teme koje pratite i način na koji dobijate vesti.
        </p>
      </header>

      <div class="settings-page-grid grid grid-cols-1 lg:grid-cols-3 gap-[var(--grid-gap)]">
        <div class="lg:col-span-2 space-y-[clamp(2rem, 4vw, 4rem)] motion-rise">
            {/* 1. INTERESTS SECTION */}
            <section class="settings-section">
                <div class="section-eyebrow mb-8 flex items-center gap-[var(--grid-gap)]">
                    <ShieldCheck size={18} className="text-nyt-accent" />
                    <h2 class="section-label font-sans text-[var(--text-sm)] font-black uppercase tracking-widest text-foreground">VAŠA INTERESOVANJA</h2>
                    <div class="section-divider flex-1 h-[1px] bg-border ml-4"></div>
                </div>
                <SettingsProfileIsland lang="sr" client:visible />
            </section>

            {/* 2. ONBOARDING / DISCOVERY */}
            <section class="settings-section border-t border-border pt-16">
                <div class="section-eyebrow mb-8 flex items-center gap-[var(--grid-gap)]">
                    <Sparkles size={18} className="text-nyt-accent" />
                    <h2 class="section-label font-sans text-[var(--text-sm)] font-black uppercase tracking-widest text-foreground">OTKRIJTE VIŠE</h2>
                    <div class="section-divider flex-1 h-[1px] bg-border ml-4"></div>
                </div>
                <div class="bg-secondary/20 p-8 rounded-sm border border-border">
                    <OnboardingIsland lang="sr" client:visible />
                </div>
            </section>
        </div>

        <aside class="settings-rail space-y-12 motion-rise">
          {/* DIGITAL PASSPORT - SYNC */}
          <div class="sidebar-module">
            <h3 class="sidebar-label flex items-center gap-[var(--grid-gap)] font-sans text-[var(--text-xs)] font-black uppercase tracking-widest text-muted-foreground"><KeyRound size={14} /> DIGITALNI PASOŠ</h3>
            <div class="mt-6">
                <AccountSyncIsland lang="sr" client:visible />
            </div>
          </div>

          {/* SUBSCRIPTIONS */}
          <div class="sidebar-module border-t border-border pt-12">
            <h3 class="sidebar-label flex items-center gap-[var(--grid-gap)] font-sans text-[var(--text-xs)] font-black uppercase tracking-widest text-muted-foreground"><Radio size={14} /> DOSTAVA</h3>
            <div class="mt-6 bg-secondary/20 border border-border p-6 rounded-sm">
                <BriefingDeliveryIsland lang="sr" client:visible variant="full" />
            </div>
          </div>

          <div class="sidebar-module border-t border-border pt-12">
            <h4 class="sidebar-label font-sans text-[var(--text-xs)] font-black uppercase tracking-widest text-muted-foreground">POMOĆ I PODRŠKA</h4>
            <div class="settings-rail-links mt-6 flex flex-col gap-[var(--grid-gap)] text-[var(--text-sm)] font-medium text-foreground">
              <a href="/briefing" class="flex justify-between items-center group">Otvorite brifing <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
              <a href="/izvori" class="flex justify-between items-center group">Uredite izvore <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
              <a href="/contact" class="flex justify-between items-center group">Korespondencija <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-all" /></a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
    .editorial-shell { max-width: 1200px; margin-left: auto; margin-right: auto; }
    .page-kicker { font-family: var(--font-sans); font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 1rem; display: block; }
    .editorial-headline span { font-weight: 400; }

    .sidebar-label { letter-spacing: 0.15em; }

    .settings-rail-links a {
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
    }

    .settings-rail-links a:hover {
        color: var(--nyt-accent);
        border-color: var(--nyt-accent);
        padding-left: 4px;
    }

    .motion-rise {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes rise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
