---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { Clock, Sparkles, BookOpen } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || (typeof window !== 'undefined' ? "/api" : "http://127.0.0.1:5000/api");

let briefing = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/briefing`);
    if (res.ok) {
        briefing = await res.json();
        if (briefing.error) {
            briefing = null;
        }
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на брифингот.";
}

const currentDate = briefing?.date ? new Date(briefing.date).toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
}) : new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

function formatBriefing(content: string) {
    if (!content) return "";
    
    // Simple markdown-ish to HTML conversion
    return content.split('\n').map(line => {
        const stripped = line.trim();
        if (!stripped) return '<div class="my-4"></div>';
        
        if (line.startsWith('### ')) {
            return `<h3 class="font-serif font-black text-2xl mt-8 mb-4 text-foreground border-b border-border pb-2">${line.substring(4)}</h3>`;
        } else if (line.startsWith('## ')) {
            return `<h2 class="font-serif font-black text-3xl mt-10 mb-6 text-foreground border-b-2 border-foreground pb-2">${line.substring(3)}</h2>`;
        } else if (line.startsWith('**') && line.endsWith('**')) {
            return `<p class="font-black mt-6 mb-2 text-foreground uppercase text-xs tracking-widest">${line.substring(2, line.length - 2)}</p>`;
        } else if (line.startsWith('- ') || line.startsWith('• ')) {
            return `<li class="ml-6 mb-2 text-lg leading-relaxed text-foreground/90">${line.substring(2)}</li>`;
        } else {
            return `<p class="mb-4 text-lg leading-relaxed text-foreground/90">${line}</p>`;
        }
    }).join('\n');
}
---

<Layout title="Дневен Брифинг">
    <NYTHeader />

	<main class="site-layout py-12">
		<div class="briefing-shell">
			<header class="briefing-header">
					<span class="page-kicker">Дневен Преглед</span>
				<h1 class="briefing-headline">
					Дневен Брифинг
				</h1>

				<div class="briefing-meta">
					<span class="flex items-center gap-1"><Clock size={12}/> {currentDate}</span>
					<span>·</span>
					<span class="flex items-center gap-1"><Sparkles size={12}/> ПРЕСЕК СУБЛИМАТ</span>
				</div>
			</header>

			<div class="briefing-grid">
				<div class="briefing-main">
					{briefing ? (
						<article class="briefing-content prose-nyt briefing-card" set:html={formatBriefing(briefing.content)} />
					) : (
						<div class="briefing-empty">
							<p class="text-4xl mb-4">📋</p>
							<h3 class="font-black text-foreground mb-2 uppercase tracking-widest text-sm">Брифингот сè уште не е подготвен</h3>
							<p class="text-muted-foreground text-xs leading-relaxed font-serif italic">
								Обидете се подоцна за денешниот преглед на вестите. <br/>
								Нашиот систем ја финализира анализата на утринските објави.
							</p>
						</div>
					)}
				</div>

				<aside class="briefing-rail">
					<div class="rail-card">
						<h3 class="rail-card-title flex items-center gap-2"><BookOpen size={14}/> Зошто Брифинг?</h3>
						<p class="rail-copy">
							Секое утро, нашиот систем ги анализира најважните настани од стотици извори за да ви овозможи брз и објективен преглед на денот.
						</p>
					</div>

					<div class="rail-card rail-card-accent">
						<h4 class="rail-card-title">Како Се Генерира?</h4>
						<p class="rail-copy">
							Системот ги групира вестите во кластери, ги споредува фактите од различни медиуми и генерира неутрално резиме без уредувачка пристрасност.
						</p>
					</div>
				</aside>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.briefing-shell {
		max-width: 76rem;
		margin: 0 auto;
	}

	.briefing-header {
		padding-bottom: 2rem;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}
	.briefing-headline {
		font-size: clamp(2.4rem, 1.8rem + 1.8vw, 4.6rem);
		line-height: 0.96;
		margin: 0 0 1rem;
	}

	.briefing-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.briefing-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.briefing-card,
	.briefing-empty,
	.rail-card {
		padding: 1.4rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%);
	}

	.briefing-empty {
		text-align: center;
	}

	.briefing-main,
	.briefing-rail {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.rail-card-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.9rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.rail-copy {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--secondary-foreground);
	}

	.rail-card-accent {
		background: color-mix(in srgb, var(--background) 78%, var(--secondary) 22%);
	}

	.briefing-content :global(li) {
		list-style-type: disc;
        margin-bottom: 1.5rem; /* Rule 4: Paragraph spacing */
	}
    .briefing-content :global(p) {
        margin-bottom: 1.5rem; /* Rule 4: Paragraph spacing */
    }
	.prose-nyt {
		font-family: var(--font-nyt-body);
        max-width: 65ch; /* Rule 5: Limit line length */
	}

	@media (min-width: 960px) {
		.briefing-grid {
			grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.8fr);
			gap: 2rem;
		}
	}
</style>
