---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import BriefingHeader from '../components/briefing/BriefingHeader.astro';
import BriefingContent from '../components/briefing/BriefingContent.astro';
import BriefingSidebar from '../components/briefing/BriefingSidebar.astro';
import { Sparkles, Coffee, Moon, Sun, Timer, Activity, Zap } from 'lucide-react';
import { sanitizeHtml } from '../lib/sanitize';
import { apiBaseUrl } from '../lib/apiBase';
import { cleanAndDecode, parseFootnotes } from '../utils/textUtils';

const API_URL = apiBaseUrl();

const dateParam = Astro.url.searchParams.get('date') || null;

let briefing: any = null;
let stats: any = null;
let health: any = null;
let leadCluster: any = null;
let historicalDates: any[] = [];
let error = null;

try {
    const briefUrl = dateParam ? `${API_URL}/briefing?date=${dateParam}` : `${API_URL}/briefing`;
    const [briefRes, statsRes, healthRes, leadRes, archiveRes] = await Promise.all([
        fetch(briefUrl),
        fetch(`${API_URL}/stats/summary`),
        fetch(`${API_URL}/health`),
        fetch(`${API_URL}/news?page_size=1`),
        fetch(`${API_URL}/archive/heatmap?limit=10`) // Reusing heatmap for dates or similar
    ]);
    
    if (briefRes.ok) {
        briefing = await briefRes.json();
        if (briefing.detail || briefing.error || !briefing.content) {
            briefing = null;
            error = "Брифингот за овој датум моментално не е достапен.";
            Astro.response.status = 500;
        }
    } else {
        error = "Брифингот моментално не е достапен.";
        Astro.response.status = 500;
    }
    
    // Fetch specifically for briefing history
    const historyRes = await fetch(`${API_URL}/archive/heatmap`); // Adjust if there is a better endpoint
    if (historyRes.ok) {
        const historyData = await historyRes.json();
        historicalDates = (historyData.data || [])
            .filter((d: any) => d.total_clusters > 5) // Dates that likely have briefings
            .slice(0, 10);
    }

    if (statsRes.ok) stats = await statsRes.json();
    if (healthRes.ok) health = await healthRes.json();
    if (leadRes.ok) {
        const json = await leadRes.json();
        leadCluster = json.clusters?.[0];
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на брифингот.";
    Astro.response.status = 500;
}

const briefingReadingTime = briefing?.content ? Math.max(1, Math.ceil(briefing.content.split(/\s+/).length / 200)) : 0;

const currentDate = briefing?.date ? new Date(briefing.date).toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}) : new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
});

const nowSkopje = new Date(new Date().toLocaleString("en-US", {timeZone: "Europe/Skopje"}));
const hour = nowSkopje.getHours();
let dispatchIcon = Sun;
if (hour >= 5 && hour < 12) dispatchIcon = Coffee;
else if (hour >= 18 || hour < 5) dispatchIcon = Moon;

function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function slugifyHeading(value: string) {
    return value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\u0400-\u04ff\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
}

function processFormatting(text: string) {
    let html = esc(text);
    
    // 1. Handle Bold: **text**
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    
    // 2. Handle Italic: *text*
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
    
    // 3. Handle Cluster IDs: [[id]] -> Surgical inline badge
    html = html.replace(/\[\[([\w-]+)\]\]/g, (match, id) => {
        return `<a href="/cluster/${id}" class="briefing-inline-badge">ДЕТАЛИ →</a>`;
    });
    
    return html;
}

function renderBriefingLine(line: string) {
    const stripped = line.trim();
    if (stripped === '---') {
        return `<div class="briefing-divider"></div>`;
    }

    if (line.startsWith('# ')) {
        return `<h1 class="briefing-masthead-title">${processFormatting(line.substring(2))}</h1>`;
    }
    
    if (line.startsWith('### ')) {
        return `<h3 class="briefing-item-title">${processFormatting(line.substring(4))}</h3>`;
    }
    
    if (line.startsWith('## ')) {
        const text = line.substring(3).trim();
        const slug = slugifyHeading(text);
        return `<h2 id="${esc(slug)}" class="briefing-section-title">${processFormatting(text)}</h2>`;
    }

    // Detect Kicker-style start: **Text**: Description
    if (line.startsWith('**') && line.includes('**:')) {
        const parts = line.split('**:', 2);
        const kicker = parts[0].replace(/\*\*/g, '').trim();
        const content = parts[1].trim();
        return `<p class="briefing-paragraph">
            <span class="briefing-kicker">${esc(kicker)}</span>
            ${processFormatting(content)}
        </p>`;
    }

    return `<p class="briefing-paragraph">${processFormatting(line)}</p>`;
}

function renderBriefingListItem(line: string) {
    const item = line.substring(2);
    return `<li class="briefing-li">${processFormatting(item)}</li>`;
}

function formatBriefing(content: string) {
    if (!content) return "";
    const out: string[] = [];
    let buffer: string[] = [];
    let firstParagraphFound = false;

    const flushList = () => {
        if (buffer.length === 0) return;
        out.push(`<ul class="briefing-ul">${buffer.join('')}</ul>`);
        buffer = [];
    };

    const lines = content.split('\n');
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const stripped = line.trim();
        if (!stripped) { flushList(); continue; }

        if (line.startsWith('- ') || line.startsWith('• ')) {
            buffer.push(renderBriefingListItem(line));
            continue;
        }
        flushList();
        let rendered = renderBriefingLine(line);
        if (!firstParagraphFound && !line.startsWith('#') && !line.startsWith('**') && stripped.length > 50) {
            rendered = rendered.replace('briefing-paragraph', 'briefing-paragraph drop-cap');
            rendered = `<span class="editorial-byline">Од уредничкиот тим на Пресек</span>\n${rendered}`;
            firstParagraphFound = true;
        }
        out.push(rendered);
    }
    flushList();
    return out.join('\n');
}

const formattedBriefingContent = briefing?.content ? formatBriefing(briefing.content) : '';
---

<Layout title="Дневен Брифинг — Пресек" description="Синтетизиран преглед на најважните вести и трендови во Македонија.">
    <NYTHeader stats={stats} />

    <div id="read-progress" class="fixed top-0 left-0 h-1 bg-nyt-accent z-[102] transition-all duration-100 opacity-0 w-0"></div>

	<main class="site-layout broadsheet-layout pt-28 pb-[var(--page-py)]">
        {error ? (
            <div class="py-24 text-center">
                <h1 class="font-serif text-3xl mb-4">{error}</h1>
                <a href="/briefing" class="text-nyt-accent hover:underline font-bold uppercase tracking-widest text-xs">Види го денешниот брифинг</a>
            </div>
        ) : briefing && (
            <div class="briefing-container">
                <BriefingHeader 
                    currentDate={currentDate} 
                    dispatchIcon={dispatchIcon} 
                    stats={stats} 
                    readingTime={briefingReadingTime} 
                />

                {leadCluster && (
                    <div class="briefing-hero-wrapper mt-0 mb-12 motion-rise">
                        <div class="hero-image-card shadow-editorial">
                            {leadCluster.articles?.[0]?.image_url && (
                                <img 
                                    src={`/proxy?url=${encodeURIComponent(leadCluster.articles[0].image_url)}&w=1200`} 
                                    alt={leadCluster.synthetic_headline || leadCluster.articles[0].title}
                                    class="hero-main-img animate-ken-burns"
                                    loading="lazy"
                                />
                            )}
                            <div class="hero-text-overlay">
                                <div class="hero-meta-info">
                                    <span class="hero-kicker-label">ТЕМА НА ДЕНОТ</span>
                                    <h2 class="hero-title-text">{leadCluster.synthetic_headline || leadCluster.articles[0].title}</h2>
                                    <div class="hero-footer-info">
                                        <span>{leadCluster.articles.length} {leadCluster.articles.length === 1 ? 'редакција' : 'редакции'} анализирани</span>
                                        <span class="mx-2 opacity-30">|</span>
                                        <a href={`/cluster/${leadCluster.cluster_id}`} class="hero-cta-link">ЦЕЛОСНА СТОРИЈА →</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                )}

    // Fetch home data to populate visual clusters
    const homeRes = await fetch(`${API_URL}/home`);
    let homeData = null;
    if (homeRes.ok) homeData = await homeRes.json();

    if (briefRes.ok) {
        briefing = await briefRes.json();
        // ... (rest of the check)
    }

// ... inside the main block

                <div class="briefing-grid">
                    <div class="briefing-main-col">
                        <BriefingContent formattedBriefing={formattedBriefingContent} />
                        
                        {/* New Visual Digest Section */}
                        {homeData && (
                            <section class="mt-16 pt-12 border-t border-border">
                                <h3 class="font-sans font-black uppercase tracking-widest text-xs mb-8 text-nyt-accent">Дневен Дигест</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    {homeData.trending?.slice(0, 4).map((c: any) => (
                                        <a href={`/cluster/${c.cluster_id}`} class="block p-4 border border-border hover:border-nyt-accent transition-all">
                                            <p class="font-sans text-[10px] font-black uppercase text-muted-foreground mb-1">Во тренд</p>
                                            <h4 class="font-serif font-bold text-sm leading-tight">{c.synthetic_headline || c.articles?.[0]?.title}</h4>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        <div class="briefing-signature mt-16 pt-12 border-t border-border/40 text-center">
                            {/* ... (signature code) ... */}
                        </div>
                    </div>

                    <BriefingSidebar 
                        stats={stats} 
                        health={health} 
                        leadCluster={leadCluster} 
                        briefing={briefing} 
                        historicalDates={historicalDates}
                    />
                </div>
            </div>
        )}
	</main>

    <script is:inline>
        (function() {
            const bar = document.getElementById('read-progress');
            if (!bar) return;

            const updateProgress = () => {
                const winScroll = document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = (winScroll / height) * 100;
                
                if (winScroll > 150) {
                    bar.style.opacity = '1';
                } else {
                    bar.style.opacity = '0';
                }
                
                bar.style.width = scrolled + "%";
            };

            window.addEventListener('scroll', updateProgress, { passive: true });
        })();
    </script>

	<Footer />
</Layout>

<style>
    .briefing-container { max-width: 900px; margin: 0 auto; padding: 0 1.5rem; }
    
    .briefing-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .briefing-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 4rem; }
    }

    .hero-image-card { 
        position: relative; 
        width: 100%; 
        height: 450px; 
        overflow: hidden; 
        background: var(--secondary); 
        border: 1px solid var(--border); 
    }
    @media (max-width: 768px) {
        .hero-image-card { height: 300px; }
    }
    @media (max-width: 480px) {
        .hero-image-card { height: 220px; }
    }
    
    .hero-main-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.8) contrast(1.05); }
    .animate-ken-burns { animation: ken-burns 20s linear infinite alternate; }
    @keyframes ken-burns {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }
    .hero-text-overlay { 
        position: absolute; 
        inset: 0; 
        background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 50%, transparent 100%); 
        display: flex; 
        align-items: flex-end; 
        padding: clamp(1.5rem, 5vw, 3rem); 
    }
    .hero-meta-info { color: white; max-width: 800px; }
    .hero-kicker-label { 
        font-family: var(--font-sans); 
        font-size: 0.75rem; 
        font-weight: 950; 
        letter-spacing: 0.25em; 
        color: var(--nyt-accent); 
    }
    .hero-title-text { 
        font-family: var(--font-serif); 
        font-size: clamp(1.5rem, 4vw, 2.5rem); 
        font-weight: 950; 
        line-height: 1.1; 
        margin: 1rem 0 1.5rem; 
        text-wrap: balance; 
    }
    .hero-footer-info { 
        font-family: var(--font-sans); 
        font-size: 0.7rem; 
        font-weight: 900; 
        letter-spacing: 0.05em; 
        opacity: 0.9; 
        display: flex; 
        align-items: center; 
        flex-wrap: wrap;
        gap: 0.25rem;
    }
    .hero-cta-link { 
        color: var(--nyt-accent); 
        text-decoration: none; 
        border-bottom: 1px solid transparent; 
        margin-left: 0.5rem; 
        white-space: nowrap;
    }
    .hero-cta-link:hover { border-bottom-color: var(--nyt-accent); }

    .editorial-byline { 
        display: block; 
        font-family: var(--font-sans); 
        font-size: 0.65rem; 
        font-weight: 950; 
        text-transform: uppercase; 
        letter-spacing: 0.1em; 
        color: var(--muted-foreground); 
        margin-bottom: 2rem; 
        border-bottom: 1px solid var(--border); 
        padding-bottom: 1rem; 
    }

    :global(.briefing-paragraph.drop-cap::first-letter) {
        float: left;
        font-family: var(--font-serif);
        font-size: 4.5rem;
        line-height: 0.8;
        padding-top: 8px;
        padding-right: 12px;
        padding-left: 0;
        font-weight: 900;
        color: var(--nyt-accent);
    }
    
    :global(.briefing-signature) {
        margin-top: 3rem;
    }
    
    :global(.briefing-main-col) {
        max-width: 100%;
    }
</style>
