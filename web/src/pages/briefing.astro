---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import BriefingHeader from '../components/briefing/BriefingHeader.astro';
import BriefingContent from '../components/briefing/BriefingContent.astro';
import BriefingSidebar from '../components/briefing/BriefingSidebar.astro';
import BriefingDigest from '../components/briefing/BriefingDigest.astro';
import { apiBaseUrl } from '../lib/apiBase';

const API_URL = apiBaseUrl();
const briefRes = await fetch(`${API_URL}/briefing`);
const briefing = briefRes.ok ? await briefRes.json() : null;
const homeRes = await fetch(`${API_URL}/home`);
const homeData = homeRes.ok ? await homeRes.json() : null;
const statsRes = await fetch(`${API_URL}/stats/summary`);
const stats = statsRes.ok ? await statsRes.json() : null;
---

<Layout title="Дневен Брифинг — Пресек">
    <NYTHeader stats={stats} />
    <main class="site-layout broadsheet-layout pt-28 pb-10">
        <div class="briefing-container">
            {briefing ? (
                <>
                    <BriefingContent formattedBriefing={briefing.content} />
                    <BriefingDigest homeData={homeData} />
                </>
            ) : (
                <div class="py-20 text-center">Брифингот е моментално недостапен.</div>
            )}
        </div>
    </main>
    <Footer />
</Layout>
