---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import BriefingHeader from '../components/briefing/BriefingHeader.astro';
import BriefingContent from '../components/briefing/BriefingContent.astro';
import BriefingSidebar from '../components/briefing/BriefingSidebar.astro';
import BriefingDigest from '../components/briefing/BriefingDigest.astro';
import BriefingDateNav from '../components/briefing/BriefingDateNav.astro';
import BriefingQuickRead from '../components/briefing/BriefingQuickRead';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import MorningEmailSignup from '../components/MorningEmailSignup.tsx';
import AudioPlayer from '../components/audio/AudioPlayer.astro';
import '../styles/briefing-premium.css';

import { apiBaseUrl } from '../lib/apiBase';
import BriefingStatsStrip from '../components/briefing/BriefingStatsStrip.astro';
import BriefingSectionsToc from '../components/briefing/BriefingSectionsToc.astro';
import BriefingSectionsRail from '../components/briefing/BriefingSectionsRail';
import { formatBriefing, extractBriefingSections } from '../utils/briefingFormatter';
import { normalizeBriefingPayload } from '../utils/briefingCopy';
import { chooseClusterImage } from '../utils/imageSelection';
import { Newspaper, ChevronRight } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { dateLocaleForLang, localePath, homePath } from '../lib/localePaths';

const API_URL = apiBaseUrl();
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const url = new URL(Astro.request.url);
const dateParam = url.searchParams.get('date');
const modeParam = url.searchParams.get('mode');
const quickMode = modeParam !== 'full';

let briefingData: any = null;
let homeData: any = null;
let stats: any = null;
let briefingAudioUrl: string | null = null;
let error = null;

try {
    const briefingUrl = dateParam
            ? `${API_URL}/intelligence/briefing?date=${dateParam}&lang=${lang}`
            : `${API_URL}/intelligence/briefing?lang=${lang}`;
    const [briefRes, homeRes, statsRes] = await Promise.all([
        fetch(briefingUrl),
        fetch(`${API_URL}/home?lang=${lang}`),
        fetch(`${API_URL}/stats/summary?lang=${lang}`)
    ]);

    if (briefRes.ok) briefingData = normalizeBriefingPayload(await briefRes.json(), lang);
    if (homeRes.ok) homeData = await homeRes.json();
    if (statsRes.ok) stats = await statsRes.json();

    if (briefingData?.date) {
        const audioParams = new URLSearchParams({ lang, date: briefingData.date });
        const audioRes = await fetch(`${API_URL}/intelligence/briefing/audio?${audioParams.toString()}`);
        if (audioRes.ok) {
            const audioData = await audioRes.json();
            if (audioData?.status === 'success' && audioData.audio_url) {
                briefingAudioUrl = audioData.audio_url;
            }
        }
    }

    if (!briefingData || briefingData.status === 'error') {
        error = briefingData?.message || t('briefing.error_unavailable');
    }
} catch (e) {
    error = t('briefing.error_load');
}

const formattedBriefing = briefingData?.content ? formatBriefing(briefingData.content, lang, hostHeader) : "";
const briefingSections = briefingData?.content ? extractBriefingSections(briefingData.content) : [];

const displayDate = briefingData?.date
    ? new Date(briefingData.date).toLocaleDateString(dateLocaleForLang(lang), {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric'
    })
    : t('briefing.today_edition');

const pageTitle = t('briefing.page_title');
const pageDescription = t('briefing.page_description');
const leadVisual = briefingData?.lead_cluster ? chooseClusterImage(briefingData.lead_cluster, 'hero', lang as 'sr' | 'mk') : null;
const leadVisualTitle = briefingData?.lead_cluster?.synthetic_headline || briefingData?.lead_cluster?.articles?.[0]?.title || pageTitle;
---

<Layout title={`${pageTitle} — Presek`} description={pageDescription}>
    <NYTHeader stats={stats} />

    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)] overflow-x-hidden" data-briefing-mode={quickMode ? 'quick' : 'full'}>
        <div class="scroll-progress-container briefing-scroll-progress">
            <div class="scroll-progress-bar" id="briefing-reading-progress"></div>
        </div>
        <div class="briefing-page-container">
            {error ? (
                <div class="py-20 text-center animate-rise">
                    <h2 class="font-serif text-3xl mb-6 font-black italic">{error}</h2>
                    <a href={localePath('/briefing', lang, hostHeader)} class="inline-flex items-center gap-[var(--grid-gap)] px-6 py-3 bg-foreground text-background font-sans ui-status hover:bg-nyt-accent transition-colors">
                        {t('briefing.back_latest')}
                    </a>
                </div>
            ) : briefingData ? (
                <div class="briefing-layout-grid relative">
                    <div class="briefing-main-col">
                        <BriefingDateNav
                            historicalDates={briefingData.historical_dates}
                            currentDate={briefingData.date}
                        />

                        <div class="briefing-hero-stack mb-8 flex flex-col gap-6">
                            <BriefingHeader
                                currentDate={displayDate}
                                dispatchIcon={Newspaper}
                                lang={lang}
                                date={briefingData.date}
                            />
                            {leadVisual?.proxiedUrl && (
                                <figure class="briefing-lead-visual">
                                    <img
                                        src={leadVisual.proxiedUrl}
                                        alt={leadVisualTitle}
                                        loading="eager"
                                        decoding="async"
                                    />
                                    <figcaption>
                                        {t('briefing.lead_visual_caption')}
                                    </figcaption>
                                </figure>
                            )}
                        </div>

                        {briefingData.quick_read && (
                            <BriefingQuickRead
                                lang={lang as 'sr' | 'mk'}
                                quickRead={briefingData.quick_read}
                                narratives={briefingData.metadata?.key_narratives || []}
                                initialMode={quickMode ? 'quick' : 'full'}
                                client:idle
                            />
                        )}

                        <div class="briefing-audio-row">
                            <AudioPlayer
                                type="briefing"
                                briefingDate={briefingData.date}
                                lang={lang}
                                title={t('briefing.audio_title')}
                                initialAudioUrl={briefingAudioUrl || undefined}
                                compact
                            />
                        </div>

                        <BriefingStatsStrip
                            stats={{
                                total_feeds: briefingData.day_stats?.total_sources || stats?.total_feeds || 0,
                                last_24h: briefingData.day_stats?.total_articles || stats?.last_24h || 0,
                                intelligence: stats?.intelligence
                            }}
                            metadata={briefingData.metadata}
                            lang={lang}
                        />

                        {briefingSections.length > 0 && (
                            <BriefingSectionsToc sections={briefingSections} lang={lang} />
                        )}

                        <div class="briefing-full-section">
                        <div class="briefing-editorial-layout">
                            {briefingSections.length > 0 && (
                                <BriefingSectionsRail sections={briefingSections} lang={lang} client:visible />
                            )}

                            <div class="briefing-editorial-main">
                                <div id="briefing-article-start" class="briefing-article-sentinel" aria-hidden="true"></div>
                                <div class="briefing-divider"></div>

                                <div class="briefing-editorial-wrapper max-w-[800px] mx-auto">
                                    <BriefingContent formattedBriefing={formattedBriefing} lang={lang} />
                                </div>

                                <section class="briefing-email-cta mt-16 pt-10 border-t border-border/60 max-w-[800px] mx-auto">
                                    <MorningEmailSignup lang={lang} variant="editorial" client:visible />
                                </section>
                            </div>
                        </div>
                        </div>


                        {homeData && (
                            <div class="mt-40 pt-16 border-t-4 border-foreground">
                                <div class="flex items-center justify-between mb-12">
                                    <h2 class="font-serif text-4xl font-black italic">{t('briefing.continue_reading')}</h2>
                                    <a href={homePath(lang, hostHeader)} class="ui-label-min flex items-center gap-[var(--grid-gap)] text-foreground hover:underline">
                                        {t('briefing.home_link')} <ChevronRight size={14} />
                                    </a>
                                </div>
                                <BriefingDigest homeData={homeData} />
                            </div>
                        )}
                    </div>

                    <div class="briefing-sidebar-col">
                        <div class="sidebar-inner sticky briefing-sidebar-sticky">
                            <section class="sidebar-module p-5 bg-secondary/10 border border-border rounded-xl mb-6">
                                <BriefingDeliveryIsland
                                    content={briefingData.content}
                                    dateLabel={displayDate}
                                    variant="summary"
                                    lang={lang}
                                    client:visible
                                />
                            </section>
                            <BriefingSidebar
                                stats={stats}
                                health={{}}
                                leadCluster={briefingData.lead_cluster}
                                briefing={{
                                    date: briefingData.date,
                                    subjects: briefingData.subjects,
                                    locations: briefingData.locations
                                }}
                                historicalDates={briefingData.historical_dates}
                            />
                        </div>
                    </div>
                </div>
            ) : (
                <div class="py-40 text-center flex flex-col items-center gap-[var(--grid-gap)]">
                    <div class="w-12 h-12 border-4 border-nyt-accent border-t-transparent rounded-full animate-spin"></div>
                    <p class="font-serif text-xl italic text-muted-foreground">{t('briefing.loading')}</p>
                </div>
            )}
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .briefing-page-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 1.5rem;
        border-left: 3px solid var(--presek-mark);
        padding-left: calc(1.5rem + 0.35rem);
    }

    .briefing-scroll-progress .scroll-progress-bar {
        background: var(--presek-mark);
        box-shadow: 0 0 15px color-mix(in srgb, var(--presek-mark) 55%, transparent);
    }

    .briefing-layout-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 6rem;
    }

    @media (min-width: 1100px) {
        .briefing-layout-grid {
            grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
            gap: 4rem;
        }
    }

    .briefing-main-col {
        min-width: 0;
    }

    .editorial-divider {
        height: 1px;
        background: var(--border);
        position: relative;
        overflow: visible;
    }

    .editorial-divider::after {
        content: "✦ ✦ ✦";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: var(--background);
        padding: 0 2rem;
        font-family: serif;
        font-size: 0.8rem;
        color: var(--muted-foreground);
        letter-spacing: 0.5em;
    }

    /* Fix potential overlay collisions */
    :global(#main-header) {
        z-index: 1000 !important;
    }

    .sidebar-inner {
        z-index: 10;
    }

    .briefing-sidebar-sticky {
        top: calc(var(--header-height) + 1rem);
    }

    @media (max-width: 1099.98px) {
        .briefing-sidebar-col {
            border-top: 1px solid var(--border);
            padding-top: 4rem;
        }
        .sidebar-inner {
            position: static;
        }
    }

    @media (max-width: 639.98px) {
        .briefing-page-container {
            padding: 0 0.85rem;
        }

        .briefing-layout-grid {
            gap: 2.25rem;
        }

        .editorial-divider {
            margin-bottom: 2.5rem !important;
        }

        .editorial-divider::after {
            padding: 0 1rem;
            font-size: 0.65rem;
            letter-spacing: 0.32em;
        }

        .briefing-sidebar-col {
            padding-top: 1.5rem;
        }
    }
</style>

<script is:inline>
    (() => {
        const initBriefingProgress = () => {
            const progress = document.getElementById('briefing-reading-progress');
            if (!progress || progress.dataset.bound === 'true') return;
            progress.dataset.bound = 'true';

            const updateProgress = () => {
                const max = document.documentElement.scrollHeight - window.innerHeight;
                const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
                progress.style.width = `${pct}%`;
            };
            window.addEventListener('scroll', updateProgress, { passive: true });
            updateProgress();
        };

        initBriefingProgress();
        document.addEventListener('astro:page-load', initBriefingProgress);
    })();
</script>
