---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import BriefingDeliveryIsland from '../components/BriefingDeliveryIsland.tsx';
import { Sparkles, Coffee, Moon, Sun, Timer, Activity } from 'lucide-react';
import { sanitizeHtml } from '../lib/sanitize';
import { apiBaseUrl } from '../lib/apiBase';

const API_URL = apiBaseUrl();

let briefing = null;
let stats: any = null;
let error = null;

try {
    const [briefRes, statsRes] = await Promise.all([
        fetch(`${API_URL}/briefing`),
        fetch(`${API_URL}/stats/summary`)
    ]);
    
    if (briefRes.ok) {
        briefing = await briefRes.json();
        if (briefing.detail || briefing.error || !briefing.content) briefing = null;
    } else {
        error = "Брифингот моментално не е достапен.";
    }
    if (statsRes.ok) {
        stats = await statsRes.json();
    }
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на брифингот.";
}

const currentDate = briefing?.date ? new Date(briefing.date).toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}) : new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
});

const nowSkopje = new Date(new Date().toLocaleString("en-US", {timeZone: "Europe/Skopje"}));
const hour = nowSkopje.getHours();
let dispatchIcon = Sun;
if (hour >= 5 && hour < 12) dispatchIcon = Coffee;
else if (hour >= 18 || hour < 5) dispatchIcon = Moon;

function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function slugifyHeading(value: string) {
    return value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\u0400-\u04ff\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
}

function renderBriefingLine(line: string) {
    const stripped = line.trim();
    if (stripped === '---') {
        return `<div class="briefing-divider"></div>`;
    }
    if (line.startsWith('# ')) {
        return `<h1 class="briefing-masthead-title">${esc(line.substring(2))}</h1>`;
    }
    if (line.startsWith('### ')) {
        let text = line.substring(4);
        const match = text.match(/\[\[([\w-]+)\]\]\s*$/);
        if (match) {
            const id = match[1];
            text = text.replace(`[[${id}]]`, '').trim();
            return `<h3 class="briefing-item-title">
                <a href="/cluster/${id}">${esc(text)} <span>Истражи приказна →</span></a>
            </h3>`;
        }
        return `<h3 class="briefing-item-title">${esc(text)}</h3>`;
    }
    if (line.startsWith('## ')) {
        const text = line.substring(3).trim();
        const slug = slugifyHeading(text);
        return `<h2 id="${esc(slug)}" class="briefing-section-title">${esc(text)}</h2>`;
    }
    if (line.startsWith('**') && line.endsWith('**')) {
        return `<p class="briefing-kicker">${esc(line.substring(2, line.length - 2))}</p>`;
    }
    return `<p class="briefing-paragraph">${esc(line)}</p>`;
}

function renderBriefingListItem(line: string) {
    const item = line.substring(2);
    const parts = item.split(':');
    if (parts.length > 1) {
        const label = parts.shift()!;
        return `<li class="briefing-li"><strong>${esc(label)}:</strong>${esc(parts.join(':'))}</li>`;
    }
    return `<li class="briefing-li">${esc(item)}</li>`;
}

function formatBriefing(content: string) {
    if (!content) return "";
    const out: string[] = [];
    let buffer: string[] = [];
    let firstParagraphFound = false;

    const flushList = () => {
        if (buffer.length === 0) return;
        out.push(`<ul class="briefing-list">${buffer.join('')}</ul>`);
        buffer = [];
    };

    const lines = content.split('\n');
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const stripped = line.trim();
        if (!stripped) { flushList(); continue; }
        if (line.startsWith('- ') || line.startsWith('• ')) {
            buffer.push(renderBriefingListItem(line));
            continue;
        }
        flushList();
        let rendered = renderBriefingLine(line);
        if (!firstParagraphFound && !line.startsWith('#') && !line.startsWith('**') && stripped.length > 50) {
            rendered = rendered.replace('briefing-paragraph', 'briefing-paragraph drop-cap');
            rendered = `<span class="editorial-byline">Од уредничкиот тим на Пресек</span>\n${rendered}`;
            firstParagraphFound = true;
        }
        out.push(rendered);
    }
    flushList();
    return out.join('\n');
}

const sectionHighlights = (briefing?.content || '').split('\n')
    .filter(l => l.startsWith('## '))
    .map((l, index) => {
        const title = l.substring(3).trim();
        return {
            index: index + 1,
            title,
            slug: slugifyHeading(title)
        };
    });

const readingTime = briefing ? Math.max(2, Math.ceil(briefing.content.split(' ').length / 180)) : 0;
const DispatchIcon = dispatchIcon;
const subjectPreview = (briefing?.subjects || []).slice(0, 4);
const sectionPreview = sectionHighlights.slice(0, 3);
const totalSubjects = briefing?.subjects?.length || 0;
const articleCount = stats?.total_articles || 0;
const editionLabel = hour >= 5 && hour < 12 ? 'Утринско издание' : hour >= 12 && hour < 18 ? 'Пладневно издание' : 'Вечерно издание';
const editionStandfirst = hour >= 5 && hour < 12
    ? 'Кондензиран утрински преглед на денот: што навистина се придвижи, кои актери ја носат тежината на приказната и каде вреди да се задржи вниманието пред остатокот од вестите да ве оттуркаат во шум.'
    : hour >= 12 && hour < 18
        ? 'Кондензиран пладневен преглед: што се зацврсти, кои линии на известување се издвојуваат и каде вреди да се остане внимателен до крајот на денот.'
        : 'Кондензиран вечерен преглед: што навистина се помести денес, кои актери ја носеа тежината на приказната и што останува важно по првиот бран на шум.';
const coverageTone = sectionHighlights.length >= 7 ? 'Широк распон на теми' : sectionHighlights.length >= 4 ? 'Фокусиран дневен избор' : 'Покондензирано издание';
---

<Layout title="Дневен Брифинг — Пресек" description="Синтетизиран преглед на најважните вести и трендови во Македонија.">
    <NYTHeader stats={stats} />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
	    <header class="editorial-masthead motion-rise masthead-double-rule">
	        <div class="masthead-top">                <span class="masthead-kicker">ЕДИТОРИЈАЛНО ИЗДАНИЕ</span>
                <div class="masthead-meta">
                    <span class="meta-item"><Timer size={11} /> {readingTime} МИН. ЧИТАЊЕ</span>
                    <span class="meta-item"><Activity size={11} /> ВЕРЗИЈА 4.2</span>
                </div>
            </div>

            <div class="masthead-main">
                <div class="masthead-branding">
                    <DispatchIcon size={32} className="text-nyt-accent" />
                    <h1 class="masthead-title">Дневен <span>Брифинг</span></h1>
                </div>
                <div class="masthead-date">
                    <p>{currentDate}</p>
                </div>
            </div>

            <div class="masthead-standfirst">
                <p>{editionStandfirst}</p>
            </div>

            <div class="masthead-deck">
                <span>{coverageTone}</span>
                <span>{totalSubjects} издвоени актери</span>
                <span>{articleCount.toLocaleString('mk-MK')} следени објави</span>
            </div>

            {sectionHighlights.length > 0 && (
                <nav class="masthead-nav hide-scrollbar">
                    <span class="nav-label">ВО ФОКУС:</span>
                    {sectionHighlights.map((section) => (
                        <a class="nav-link" href={`#${section.slug}`}>
                            <span>{String(section.index).padStart(2, '0')}</span>
                            {section.title}
                        </a>
                    ))}
                </nav>
            )}
        </header>

        <div class="broadsheet-grid mt-12">
            <div class="broadsheet-main">
                {briefing ? (
                    <article class="briefing-container">
                        <div class="briefing-intro">
                            <div class="intro-lede">
                                <p class="intro-kicker">{editionLabel}</p>
                                <h2 class="intro-greeting">{hour >= 5 && hour < 12 ? 'Добро утро.' : hour >= 12 && hour < 18 ? 'Добар ден.' : 'Добра вечер.'}</h2>
                                <p class="intro-copy">
                                    Денешната синтеза ги собира <span class="font-bold">{articleCount.toLocaleString('mk-MK')} објави</span> во јасна редакциска линија:
                                    што е водечко, што е споредно и кои теми заслужуваат второ читање наместо брзо скролање.
                                </p>
                            </div>

                            <div class="intro-ledger">
                                <div class="ledger-card">
                                    <span class="ledger-label">Издание</span>
                                    <strong>{readingTime} минути</strong>
                                    <p>Доволно кратко за едно кафе, доволно густо за да не пропуштите ништо суштинско.</p>
                                </div>
                                <div class="ledger-card">
                                    <span class="ledger-label">Редакциски темпо</span>
                                    <strong>{sectionHighlights.length || 6} главни линии</strong>
                                    <p>Поделени според агенда, а не според суров редослед на објавување.</p>
                                </div>
                            </div>
                        </div>

                        <div class="intro-notes">
                            <span class="intro-note">Уреднички избор</span>
                            <span class="intro-note">{coverageTone}</span>
                            <span class="intro-note">{totalSubjects} активни актери</span>
                        </div>

                        <div class="briefing-content" set:html={sanitizeHtml(formatBriefing(briefing.content))} />
                        
                        <div class="briefing-signature">
                            <div class="sig-mark">
                                <Sparkles size={24} className="text-nyt-accent" />
                            </div>
                            <p class="sig-quote">„Ние ги наоѓаме фактите, вие го градите мислењето.“</p>
                            <p class="sig-label">ПРЕСЕК СИСТЕМСКИ УРЕДНИК</p>
                        </div>
                    </article>
                ) : error ? (
                    <div class="briefing-empty">
                        <Activity className="opacity-30 text-nyt-accent" size={48} />
                        <h3>Брифингот не е достапен</h3>
                        <p>{error}</p>
                    </div>
                ) : (
                    <div class="briefing-empty">
                        <Activity className="animate-pulse opacity-30 text-nyt-accent" size={48} />
                        <h3>Синтетизирање во тек</h3>
                        <p>Нашиот дигитален уредник ги обработува утринските вести за да ви понуди најпрецизен диспач.</p>
                    </div>
                )}
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block rail-block-featured">
                    <p class="rail-kicker">Редакциски индекс</p>
                    <h3 class="rail-title">АКТЕРИ НА ДЕНОТ</h3>
                    <p class="rail-text rail-text-tight">
                        Лицата, институциите и групите што најмногу ја туркаат дневната рамка на приказната.
                    </p>
                    {subjectPreview.length > 0 ? (
                        <div class="rail-subject-list">
                            {subjectPreview.map((s: any) => (
                                <div class="subject-row">
                                    <div class="subject-info">
                                        <span class="subject-name">{s.name}</span>
                                        <span class="subject-count">{s.total_mentions} споменувања</span>
                                    </div>
                                    <span class="subject-sentiment">{s.sentiment_score > 0.2 ? '😊' : s.sentiment_score < -0.2 ? '😤' : '😐'}</span>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="rail-text">Актерите ќе се појават тука кога системот ќе издвои доволно јасен дневен сигнал.</p>
                    )}
                </section>

                <section class="rail-block rail-metrics">
                    <p class="rail-kicker">Во бројки</p>
                    <h3 class="rail-title">ДНЕВЕН ОПСЕГ</h3>
                    <div class="rail-metric-grid">
                        <div class="rail-metric-card">
                            <span class="rail-metric-value">{articleCount.toLocaleString('mk-MK')}</span>
                            <span class="rail-metric-label">објави</span>
                        </div>
                        <div class="rail-metric-card">
                            <span class="rail-metric-value">{sectionHighlights.length || 6}</span>
                            <span class="rail-metric-label">линии</span>
                        </div>
                        <div class="rail-metric-card">
                            <span class="rail-metric-value">{totalSubjects}</span>
                            <span class="rail-metric-label">актери</span>
                        </div>
                    </div>
                    <p class="rail-text">{coverageTone}. Изборот е подреден според уредничка тежина, не според гласност.</p>
                </section>


                <section class="rail-block">
                    <p class="rail-kicker">Издание</p>
                    <h3 class="rail-title">ДОСТАВА И СПОДЕЛУВАЊЕ</h3>
                    <p class="rail-text">
                        Оваа верзија може да ја понесете надвор од страницата како краток редакциски преглед за читање, копирање или утринска достава.
                    </p>
                    <div class="mt-6">
                        <BriefingDeliveryIsland client:load variant="summary" content={briefing?.content || ''} dateLabel={currentDate} />
                    </div>
                </section>

                <div class="rail-support-card">
                    <p class="rail-kicker mb-2">Независно издание</p>
                    <h4 class="font-serif font-bold text-lg mb-2">Поддржи го Пресек</h4>
                    <p class="text-xs opacity-80 mb-4">Поддршката помага овој дневен брифинг да остане бесплатен, јасен и уреднички самостоен.</p>
                    <a href="https://ko-fi.com/presek" target="_blank" class="support-btn">
                        <Coffee size={14} /> Ko-fi
                    </a>
                </div>
            </aside>
        </div>
	</main>

	<Footer />
</Layout>

<style>
    /* ── Editorial Masthead ──────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 1rem; }
    .masthead-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-meta { display: flex; gap: 1.25rem; }
    .meta-item { display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; color: var(--muted-foreground); letter-spacing: 0.05em; }

    .masthead-main { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.9rem; }
    .masthead-branding { display: flex; align-items: center; gap: 1rem; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.35rem, 5.5vw, 4rem); font-weight: 900; line-height: 0.92; letter-spacing: -0.02em; }
    .masthead-title span { italic: true; font-weight: 400; font-family: var(--font-serif); }
    .masthead-date { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 850; text-transform: uppercase; color: var(--foreground); text-align: right; }
    .masthead-standfirst { max-width: 46rem; margin-bottom: 1rem; }
    .masthead-standfirst p { font-family: var(--font-nyt-body); font-size: 1rem; line-height: 1.58; color: var(--secondary-foreground); text-wrap: pretty; }
    .masthead-deck { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 1rem; }
    .masthead-deck span { display: inline-flex; align-items: center; min-height: 1.8rem; padding: 0.2rem 0.6rem; border: 1px solid color-mix(in srgb, var(--border) 88%, transparent); background: color-mix(in srgb, var(--background) 92%, #efe5d6 8%); font-family: var(--font-sans); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--foreground); }

    .masthead-nav { display: flex; align-items: center; gap: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--border); overflow-x: auto; }
    .nav-label { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; color: var(--muted-foreground); white-space: nowrap; }
    .nav-link { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-sans); font-size: 0.62rem; font-weight: 800; white-space: nowrap; text-decoration: none; color: var(--foreground); padding: 0.35rem 0; border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s; }
    .nav-link span { font-size: 0.54rem; font-weight: 950; letter-spacing: 0.08em; color: var(--muted-foreground); }
    .nav-link:hover { color: var(--nyt-accent); border-color: color-mix(in srgb, var(--nyt-accent) 35%, transparent); }

    /* ── Broadsheet Grid ────────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    /* ── Briefing Content ────────────────────────────── */
    .briefing-intro { display: grid; grid-template-columns: 1fr; gap: 1.35rem; margin-bottom: 2rem; }
    .intro-kicker { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; text-transform: uppercase; letter-spacing: 0.14em; color: var(--nyt-accent); margin-bottom: 0.75rem; }
    .intro-greeting { font-family: var(--font-serif); font-size: clamp(2.1rem, 3.6vw, 3.1rem); font-weight: 900; italic: true; margin-bottom: 0.75rem; line-height: 0.95; }
    .intro-copy { font-family: var(--font-nyt-body); font-size: 1.04rem; line-height: 1.62; color: var(--secondary-foreground); max-width: 39rem; text-wrap: pretty; }
    .intro-ledger { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .ledger-card { padding: 0.85rem 0.95rem; border: 1px solid var(--border); background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%); }
    .ledger-label { display: block; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 950; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted-foreground); margin-bottom: 0.55rem; }
    .ledger-card strong { display: block; font-family: var(--font-serif); font-size: 1.18rem; font-weight: 900; margin-bottom: 0.35rem; }
    .ledger-card p { font-family: var(--font-nyt-body); font-size: 0.84rem; line-height: 1.45; color: var(--secondary-foreground); }
    .intro-notes { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 1.35rem; }
    .intro-note { display: inline-flex; align-items: center; padding: 0.3rem 0.65rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--border) 86%, transparent); background: color-mix(in srgb, var(--background) 94%, var(--secondary) 6%); font-family: var(--font-sans); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--secondary-foreground); }

    .briefing-content { border-top: 3px solid var(--foreground); border-bottom: 1px solid var(--border); padding-top: 2rem; padding-bottom: 1.5rem; column-gap: 2.25rem; counter-reset: briefing-sections; }
    :global(.briefing-masthead-title) { font-family: var(--font-serif); font-size: 3rem; font-weight: 900; margin-bottom: 2rem; line-height: 1; }
    :global(.briefing-section-title) { counter-increment: briefing-sections; display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: end; font-family: var(--font-serif); font-size: 2rem; font-weight: 900; italic: true; margin: 4rem 0 1.35rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
    :global(.briefing-section-title::before) { content: counter(briefing-sections, decimal-leading-zero); font-family: var(--font-sans); font-size: 0.62rem; font-style: normal; font-weight: 950; letter-spacing: 0.12em; color: var(--nyt-accent); transform: translateY(-0.2rem); }
    :global(.briefing-item-title) { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 850; margin: 2.5rem 0 1rem; line-height: 1.2; }
    :global(.briefing-item-title a) { text-decoration: none; color: inherit; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
    :global(.briefing-item-title a span) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; color: var(--nyt-accent); opacity: 0; transition: opacity 0.2s; }
    :global(.briefing-item-title a:hover span) { opacity: 1; }
    
    :global(.briefing-paragraph) { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.82; color: var(--secondary-foreground); margin-bottom: 1.5rem; text-wrap: pretty; }
    
    :global(.briefing-list) { list-style: none; padding: 0; margin-bottom: 2rem; }
    :global(.briefing-li) { font-family: var(--font-nyt-body); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
    :global(.briefing-li::before) { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); font-weight: 900; }
    :global(.briefing-divider) { height: 1px; background: var(--border); margin: 3rem 0; }
    :global(.briefing-kicker) { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; text-transform: uppercase; color: var(--nyt-accent); letter-spacing: 0.1em; margin-bottom: 0.5rem; }

    /* ── Signature ───────────────────────────────────── */
    .briefing-signature { margin-top: 5rem; padding: 4rem 0; border-top: 1px solid var(--border); text-align: center; }
    .sig-mark { margin-bottom: 1.5rem; display: flex; justify-content: center; }
