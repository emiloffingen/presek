---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IntelligenceGraph from '../components/IntelligenceGraph';
import Footer from '../components/Footer.astro';
import TinyAdzInlinedAd from '../components/TinyAdzInlinedAd.astro';
import TinyAdzRailAd from '../components/TinyAdzRailAd.astro';
import { shouldShowTinyAdzInlinedAds } from '../lib/tinyadz';

const hostHeader = Astro.request?.headers.get('host');
const showRailAd = shouldShowTinyAdzInlinedAds('sr', hostHeader || Astro.url.hostname);
---

<Layout 
    title="Medijska Mreža | Interaktivni Graf" 
    description="Istražite interaktivnu mrežu veza, sentimenta i pominjanja političkih aktera i institucija u srpskim medijima."
>
    <NYTHeader />

	<main class="site-layout broadsheet-layout graph-page py-[var(--page-py)] animate-rise">
		<Breadcrumbs items={[{ label: "grafik" }]} />
		<div class="broadsheet-grid">
			<div class="broadsheet-main">
				<TinyAdzInlinedAd class="page-inline-ad mb-10" />
				<IntelligenceGraph lang="sr" client:load />
			</div>
			{showRailAd && (
				<aside class="broadsheet-rail ad-only-rail pl-4">
					<TinyAdzRailAd />
				</aside>
			)}
		</div>
	</main>
	<Footer />
</Layout>
