---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Cookie, ShieldCheck, Lock } from 'lucide-react';
---

<Layout 
    title="Политика за колачиња — Пресек" 
    description="Информации за тоа како користиме колачиња за да го подобриме вашето корисничко искуство."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">ПРАВНО & ПРИВАТНОСТ</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Политика за <span>Колачиња</span></h1>
            </div>
            <p class="masthead-intro">
                Транспарентност во дигиталната обработка: Објаснување за тоа како Пресек.мк користи колачиња за функционалност и перформанси.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Колачињата се мали текстуални датотеки кои се зачувуваат на вашиот уред при посета на веб-страници. Пресек користи минимален број на колачиња исклучиво за да овозможи техничка функционалност и заштита на сервисот.
                    </p>

                    <h2>Што користиме?</h2>
                    <p>Нашиот систем користи колачиња за следните цели:</p>
                    
                    <div class="cookie-types space-y-8 my-10">
                        <div class="type-item flex gap-6 p-6 border border-border bg-secondary/10">
                            <ShieldCheck className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="font-sans font-black text-[10px] uppercase tracking-widest mb-2">Неопходни Колачиња</h4>
                                <p class="text-sm leading-relaxed">Овие колачиња се критични за безбедноста и основните функции на сајтот (на пр. заштита од CSRF напади). Без нив, сервисот не може да функционира правилно.</p>
                            </div>
                        </div>

                        <div class="type-item flex gap-6 p-6 border border-border">
                            <Cookie className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="font-sans font-black text-[10px] uppercase tracking-widest mb-2">Преференции на корисникот</h4>
                                <p class="text-sm leading-relaxed">Ги зачувуваме вашите избори за темна/светла тема или јазични поставки на локално ниво за да не морате повторно да ги избирате при секоја посета.</p>
                            </div>
                        </div>

                        <div class="type-item flex gap-6 p-6 border border-border">
                            <Lock className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="font-sans font-black text-[10px] uppercase tracking-widest mb-2">Аналитика на сесии</h4>
                                <p class="text-sm leading-relaxed">Користиме анонимни податоци за да разбереме како се движат корисниците низ категориите, со цел да ја подобриме брзината на вчитување на најпосетуваните теми.</p>
                            </div>
                        </div>
                    </div>

                    <h2>Вашиот избор</h2>
                    <p>
                        Повеќето прелистувачи ви дозволуваат да ги контролирате или избришете колачињата преку нивните поставки. Имајте предвид дека оневозможувањето на одредени колачиња може да влијае на корисничкото искуство на Пресек.
                    </p>
                    <p>
                        Доколку имате прашања во врска со нашата употреба на колачиња, ве молиме контактирајте нѐ на <a href="mailto:contact@presek.live" class="text-nyt-accent underline">contact@presek.live</a>.
                    </p>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block">
                    <p class="rail-kicker">Поврзано</p>
                    <h3 class="rail-title">ПРИВАТНОСТ</h3>
                    <a href="/privacy" class="block p-4 border border-border hover:bg-secondary transition-colors text-sm font-bold uppercase tracking-tight">Политика за приватност →</a>
                </section>

                <div class="rail-meta-box">
                    <p class="text-[10px] font-black uppercase tracking-widest mb-4 opacity-50">АЖУРИРАНО</p>
                    <p class="text-xs">Последна измена: 24 април, 2026</p>
                </div>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .prose-editorial h2 { font-family: var(--font-serif); font-size: 2rem; font-weight: 900; margin: 3rem 0 1.5rem; color: var(--foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }

    .rail-block { margin-bottom: 2.5rem; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-meta-box { padding: 1.5rem; border: 1px solid var(--border); }
</style>
