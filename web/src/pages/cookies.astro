---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { Cookie, ShieldCheck, Lock } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath } from '../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const site = lang === 'mk' ? 'Presek.mk' : 'Presek.live';
const privacyHref = localePath('/privacy', lang, hostHeader);
---

<Layout
    title={t('legal.cookies.title')}
    description={t('legal.cookies.description')}
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker ui-label">{t('legal.cookies.kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">{t('legal.cookies.heading_prefix')} <span>{t('legal.cookies.heading_span')}</span></h1>
            </div>
            <p class="masthead-intro">
                {t('legal.cookies.intro').replace('{site}', site)}
            </p>
        </header>

        <div class="editorial-broadsheet-grid">
            <div class="editorial-broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        {t('legal.cookies.lead')}
                    </p>

                    <h2>{t('legal.cookies.section_what')}</h2>
                    <p>{t('legal.cookies.section_what_body')}</p>

                    <div class="cookie-types space-y-8 my-10">
                        <div class="type-item flex gap-[var(--grid-gap)] p-6 border border-border bg-secondary/10">
                            <ShieldCheck className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="ui-label mb-2">{t('legal.cookies.essential_title')}</h4>
                                <p class="text-sm leading-relaxed">{t('legal.cookies.essential_body')}</p>
                            </div>
                        </div>

                        <div class="type-item flex gap-[var(--grid-gap)] p-6 border border-border">
                            <Cookie className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="ui-label mb-2">{t('legal.cookies.prefs_title')}</h4>
                                <p class="text-sm leading-relaxed">{t('legal.cookies.prefs_body')}</p>
                            </div>
                        </div>

                        <div class="type-item flex gap-[var(--grid-gap)] p-6 border border-border">
                            <Lock className="text-nyt-accent shrink-0" size={24} />
                            <div>
                                <h4 class="ui-label mb-2">{t('legal.cookies.analytics_title')}</h4>
                                <p class="text-sm leading-relaxed">{t('legal.cookies.analytics_body')}</p>
                            </div>
                        </div>
                    </div>

                    <h2>{t('legal.cookies.section_choice')}</h2>
                    <p>
                        {t('legal.cookies.choice_body')}
                    </p>
                    <p>
                        {t('legal.cookies.contact_prefix')} <a href="mailto:contact@presek.mk" class="text-nyt-accent underline">contact@presek.mk</a>.
                    </p>
                </article>
            </div>

            <aside class="editorial-broadsheet-rail">
                <details class="editorial-rail-context">
                    <summary class="editorial-rail-context-summary">
                        <span class="ui-label">{t('editorial.rail_context')}</span>
                        <span class="editorial-rail-context-hint ui-label-min text-muted-foreground">{t('editorial.rail_open')}</span>
                    </summary>
                    <div class="editorial-rail-context-body">
                        <section class="editorial-rail-block">
                            <p class="editorial-rail-kicker">{t('legal.cookies.rail_related_kicker')}</p>
                            <h3 class="editorial-rail-title">{t('legal.cookies.rail_privacy_title')}</h3>
                            <a href={privacyHref} class="block p-4 border border-border hover:bg-secondary transition-colors text-sm font-bold uppercase tracking-tight">{t('legal.cookies.rail_privacy_link')}</a>
                        </section>

                        <div class="editorial-rail-meta">
                            <p class="ui-label-min text-muted-foreground mb-4 opacity-70">{t('legal.cookies.rail_updated_label')}</p>
                            <p class="text-xs">{t('legal.cookies.rail_updated_date')}</p>
                        </div>
                    </div>
                </details>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .prose-editorial h2 { font-family: var(--font-serif); font-size: 2rem; font-weight: 900; margin: 3rem 0 1.5rem; color: var(--foreground); }
</style>
