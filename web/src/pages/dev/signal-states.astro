---
import Layout from '../../layouts/Layout.astro';
import TrustChip from '../../components/TrustChip.astro';
import StoryFreshnessBadge from '../../components/StoryFreshnessBadge.astro';
import { trustChipFixtures, freshnessFixtures } from '../../lib/trustFreshnessFixtures';

const lang = 'sr';
---

<Layout title="Signal states (dev)" robots="noindex,nofollow">
  <main class="dev-signal-states mx-auto max-w-5xl px-6 py-12">
    <header class="mb-10">
      <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground">Dev only</p>
      <h1 class="mt-2 font-serif text-4xl font-black">Trust & freshness states</h1>
      <p class="mt-3 max-w-2xl text-sm text-muted-foreground">
        Visual QA for trust chips and synthesis freshness badges. Available at <code>/dev/signal-states</code> in development only.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="mb-4 font-serif text-2xl font-black">Trust chips</h2>
      <div class="grid gap-4">
        {trustChipFixtures.map((fixture) => (
          <div class="dev-signal-row">
            <div class="dev-signal-label">
              <strong>{fixture.label}</strong>
              <span>{fixture.id}</span>
            </div>
            <TrustChip lang={lang} {...fixture.props} />
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="mb-4 font-serif text-2xl font-black">Freshness badges</h2>
      <div class="grid gap-4">
        {freshnessFixtures.map((fixture) => (
          <div class="dev-signal-row">
            <div class="dev-signal-label">
              <strong>{fixture.label}</strong>
              <span>{fixture.id}</span>
            </div>
            <StoryFreshnessBadge
              lang={lang}
              synthesisUpdatedAt={fixture.input.synthesisUpdatedAt}
              latestArticleAt={fixture.input.latestArticleAt}
              isStale={fixture.input.isStale}
              newArticleCount={fixture.input.newArticleCount}
              pipelineBusy={fixture.input.pipelineBusy}
              missingSynthesis={fixture.input.missingSynthesis}
            />
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .dev-signal-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    background: color-mix(in srgb, var(--secondary) 20%, var(--background));
  }

  .dev-signal-label {
    display: grid;
    gap: 0.2rem;
    min-width: 12rem;
  }

  .dev-signal-label strong {
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  .dev-signal-label span {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--muted-foreground);
  }
</style>
