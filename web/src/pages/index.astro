---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ForYouIsland from '../components/ForYouIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import HomeRailSuggestionsIsland from '../components/HomeRailSuggestionsIsland.tsx';
import { chooseClusterImage } from '../utils/imageSelection';
import { TrendingUp, BarChart3 } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || (typeof window !== 'undefined' ? "/api" : "http://127.0.0.1:5001/api");

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const q = searchParams.get('q');

let clusters = [];
let trending = [];
let topEntities = [];
let stats = null;
let health = null;
let error = null;
let internationalClusters = [];

async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Request failed: ${response.status} ${url}`);
    }
    return response.json();
}

// Build the fetch URL with params
const newsUrl = new URL(`${API_URL}/news`);
newsUrl.searchParams.set('page_size', '40');
if (category) newsUrl.searchParams.set('topic', category);
if (topic) newsUrl.searchParams.set('topic', topic);
if (q) newsUrl.searchParams.set('q', q);

try {
    const newsData = await fetchJson(newsUrl.toString());
    clusters = newsData?.clusters || [];

    const [trendResult, entityResult, statsResult, healthResult, internationalResult] = await Promise.allSettled([
        fetchJson(`${API_URL}/trending`),
        fetchJson(`${API_URL}/intelligence/top-entities?limit=12`),
        fetchJson(`${API_URL}/stats/full`),
        fetchJson(`${API_URL}/health`),
        fetchJson(`${API_URL}/intelligence/international-curated?limit=4`)
    ]);

    trending = trendResult.status === 'fulfilled' && Array.isArray(trendResult.value)
        ? trendResult.value
        : [];
    topEntities = entityResult.status === 'fulfilled' && Array.isArray(entityResult.value)
        ? entityResult.value
        : [];
    stats = statsResult.status === 'fulfilled' ? statsResult.value : null;
    health = healthResult.status === 'fulfilled' ? healthResult.value : null;
    internationalClusters =
        internationalResult.status === 'fulfilled' && Array.isArray(internationalResult.value?.clusters)
            ? internationalResult.value.clusters
            : [];
} catch (e) {
    console.error("News fetch error:", e);
    error = "Грешка при вчитување на вестите.";
}

function normalizeFocusName(name: string) {
    const clean = (name || '').replace(/\s+/g, ' ').trim().replace(/^[-–—,.;:!?()[\]{}"' ]+|[-–—,.;:!?()[\]{}"' ]+$/g, '');
    if (!clean) return '';
    if (/^[A-Za-zА-Яа-яЀ-ӿ\s-]+$/.test(clean) && clean === clean.toLowerCase()) {
        return clean
            .split(' ')
            .map((part) => part ? part[0].toUpperCase() + part.slice(1) : part)
            .join(' ');
    }
    return clean;
}

const focusEntities = topEntities
    .map((ent: any) => ({ ...ent, name: normalizeFocusName(ent?.name || '') }))
    .filter((ent: any) => ent.name && ent.name.length >= 3)
    .slice(0, 10);

const leadCluster = clusters[0] ?? null;
const supportingClusters = clusters.slice(1, 5);
const feedClusters = clusters.slice(5);

function getLeadSignal(cluster: any) {
	const count = cluster?.articles?.length || 0;
	if (cluster?.is_breaking) return 'Најбрз развој во денот';
	if (count >= 6) return 'Приказна што ја движи домашната агенда';
	if (count >= 4) return 'Тема што брзо се шири низ редакциите';
	return 'Развој што вреди да се следи';
}

function cleanLeadSummary(text?: string) {
	if (!text) return '';
	return String(text)
		.replace(/^[⚪🟢🔴]\s*/u, '')
		.replace(/#[^\s#]+/g, '')
		.replace(/\s+/g, ' ')
		.trim();
}

function getLeadSummary(cluster: any) {
	const article = cluster?.articles?.[0];
	const preferred = cleanLeadSummary(article?.summary);
	const fallback = cleanLeadSummary(article?.description);
	return preferred || fallback;
}

const leadSignal = leadCluster ? getLeadSignal(leadCluster) : '';
const leadSummary = leadCluster ? getLeadSummary(leadCluster) : '';
const freshness = health?.freshness || null;
const showInternationalRail = !q && !category && !topic && internationalClusters.length > 0;

function getTimeStr(dateStr: string) {
    try {
        return new Date(dateStr).toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function getThumb(cluster: any) {
    return chooseClusterImage(cluster).proxiedUrl || '/img/placeholder.svg';
}
---

<Layout
	title={q || category || topic || "Пресек | Македонски информативен агрегатор"}
	description={q || category || topic
		? "Пресек ги групира поврзаните вести, ги споредува изворите и ви дава побрз преглед на темата."
		: "Пресек е македонски информативен агрегатор што ги собира главните вести, ги групира по тема и покажува како различни извори известуваат за истиот настан."}
>
    <NYTHeader q={q} category={category} topic={topic} />

	<main class="site-layout">
		{/* Filtering Status */}
		{(q || category || topic) && (
			<div class="mb-10 py-4 border-y border-nyt-gray-300 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<h2 class="font-serif text-2xl font-black italic">
					{q ? `Резултати за: "${q}"` : `${category || topic}`}
				</h2>
				<a href="/" class="nyt-section-label text-muted hover:text-nyt-red">Прикажи ги сите вести</a>
			</div>
		)}

		<div class="front-page-grid">
			<div class="front-main">
					{error && (
						<div class="p-12 text-center bg-nyt-gray-100 border border-nyt-gray-300">
							<p class="font-serif italic text-nyt-red font-black uppercase tracking-widest">{error}</p>
						</div>
					)}

				{leadCluster && (
					<section class="lead-hero motion-rise">
						<div class="lead-copy">
							<div class="lead-kicker">
								<span class="source-label">{leadCluster.articles[0].source}</span>
								{leadCluster.is_breaking && <span class="live-pill">Во живо</span>}
							</div>
							<a href={`/cluster/${leadCluster.cluster_id}`} class="no-underline">
								<h1 class="lead-headline">{leadCluster.articles[0].title}</h1>
							</a>
							<p class="lead-signal">{leadSignal}</p>
							{leadSummary && (
								<p class="lead-summary">{leadSummary}</p>
							)}
							<div class="lead-meta">
								<span>{getTimeStr(leadCluster.articles[0].created_at)}</span>
								<span>·</span>
								<span>{leadCluster.articles.length} извори</span>
							</div>

							{leadCluster.articles.length > 1 && (
								<ul class="lead-related">
									{leadCluster.articles.slice(1, 4).map((article: any) => (
										<li>
											<a href={`/cluster/${leadCluster.cluster_id}`}>{article.title}</a>
										</li>
									))}
								</ul>
							)}
						</div>

						<a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media">
							<img src={getThumb(leadCluster)} alt={leadCluster.articles[0].title} loading="eager" />
						</a>
					</section>
				)}

					{supportingClusters.length > 0 && (
						<section class="supporting-grid motion-rise motion-delay-1">
							{supportingClusters.map((cluster) => (
								<NewsCard cluster={cluster} />
							))}
						</section>
					)}

					{clusters.length > 4 && (
						<ForYouIsland client:load clusters={clusters.slice(0, 18)} />
					)}

					<OnboardingIsland client:load compact />

					{showInternationalRail && (
						<section class="international-section motion-rise motion-delay-2">
							<div class="section-heading-row">
								<h2 class="section-title">Од Регионот И Светот</h2>
								<p class="section-note">Куриран избор од странски извори со веќе преведени наслови на македонски.</p>
							</div>
							<div class="news-feed-grid">
								{internationalClusters.map((cluster) => (
									<NewsCard cluster={cluster} />
								))}
							</div>
						</section>
					)}

					{feedClusters.length > 0 && (
						<section class="feed-section motion-rise motion-delay-3">
						<div class="section-heading-row">
							<h2 class="section-title">Понатаму Во Денот</h2>
							<p class="section-note">Развојни и придружни приказни што вреди да останат во видното поле.</p>
						</div>
						<div class="news-feed-grid">
							{feedClusters.map((cluster) => (
								<NewsCard cluster={cluster} />
							))}
						</div>
					</section>
				)}
			</div>

			<aside class="front-rail">
				<section class="rail-module rail-pulse motion-rise-fast motion-delay-1">
					<h3 class="rail-title">
						<BarChart3 size={14} /> МЕДИУМСКИ ПУЛС
					</h3>
					<div class="pulse-grid">
						<div>
							<span class="micro-label">Статии денес</span>
							<strong>{stats ? stats.last_24h.toLocaleString('mk-MK') : '...'}</strong>
						</div>
						<div>
							<span class="micro-label">Извори</span>
							<strong>{stats ? stats.total_feeds.toLocaleString('mk-MK') : '...'}</strong>
						</div>
					</div>
					{freshness && (
						<div class={`freshness-chip freshness-${freshness.status}`}>
							<span>{freshness.label}</span>
							{typeof freshness.age_minutes === 'number' && <strong>{freshness.age_minutes} мин</strong>}
						</div>
					)}
					<p class="rail-note">Каде се собира најмногу медиумско внимание, не само каде прво се појавила објавата.</p>
				</section>

				<HomeRailSuggestionsIsland client:load />

				<section class="rail-module motion-rise-fast motion-delay-2">
					<h3 class="rail-title">ТЕМИ ВО ФОКУС</h3>
					<div class="focus-cloud">
						{focusEntities.map((ent: any) => (
							<a href={`/?q=${encodeURIComponent(ent.name)}`} class="focus-chip">
								{ent.name}
							</a>
						))}
					</div>
					<p class="rail-note">Имиња и теми што најупорно се повторуваат низ денешната медиумска слика.</p>
				</section>
			</aside>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.front-page-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.35rem;
		padding-bottom: 3.5rem;
	}

	.front-main {
		min-width: 0;
	}

	.editor-note {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 1.5rem 0 2rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}

	.editor-note h2 {
		font-size: clamp(1.6rem, 1.2rem + 1vw, 2.25rem);
		line-height: 1.02;
		max-width: 16ch;
		margin: 0.35rem 0 0;
	}

	.editor-note-meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 24rem;
	}

	.editor-note-meta strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		line-height: 1;
		margin-top: 0.35rem;
	}

	.micro-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.lead-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.95rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--border);
	}

	.lead-kicker,
	.lead-meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.live-pill {
		border: 1px solid var(--nyt-red);
		color: var(--nyt-red);
		padding: 0.1rem 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lead-headline {
		font-size: clamp(2.2rem, 1.7rem + 1.55vw, 4.2rem);
		line-height: 0.94;
		letter-spacing: -0.028em;
		margin: 0.35rem 0 0.65rem;
		max-width: 14ch;
		text-wrap: balance;
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
		font-size: 1.02rem;
		line-height: 1.56;
		color: var(--secondary-foreground);
		max-width: 50ch;
		text-wrap: pretty;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.lead-signal,
	.rail-note {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.freshness-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0.35rem 0.55rem;
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.freshness-chip strong {
		font-family: var(--font-sans);
		font-size: 0.62rem;
	}

	.freshness-fresh {
		color: #2f855a;
		border-color: color-mix(in srgb, #2f855a 36%, var(--border) 64%);
	}

	.freshness-aging {
		color: #9a6700;
		border-color: color-mix(in srgb, #9a6700 36%, var(--border) 64%);
	}

	.freshness-stale {
		color: var(--nyt-red);
		border-color: color-mix(in srgb, var(--nyt-red) 36%, var(--border) 64%);
	}

	.lead-meta {
		margin-top: 0.75rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.lead-related {
		list-style: none;
		padding: 0;
		margin: 0.9rem 0 0;
		border-top: 1px solid var(--border);
	}

	.lead-related li {
		border-bottom: 1px solid var(--border);
	}

	.lead-related a {
		display: block;
		padding: 0.75rem 0;
		font-family: var(--font-serif);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--foreground);
		text-decoration: none;
	}

	.lead-related a:hover {
		color: var(--nyt-accent);
	}

	.lead-media img {
		display: block;
		width: 100%;
		aspect-ratio: 1.18 / 1;
		object-fit: cover;
		object-position: center top;
		border: 1px solid var(--border);
	}

	.supporting-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--border);
	}

	.feed-section {
		padding-top: 1.4rem;
	}

	.international-section {
		padding-top: 1.4rem;
		border-top: 1px solid var(--border);
	}

	@media (max-width: 640px) {
		.front-page-grid {
			gap: 1.6rem;
			padding-bottom: 2.5rem;
		}

		.lead-hero {
			gap: 0.8rem;
		}

		.lead-copy {
			display: grid;
			gap: 0.55rem;
		}

		.lead-media {
			order: -1;
		}

		.lead-headline {
			font-size: clamp(1.52rem, 1.2rem + 0.78vw, 2.05rem);
			line-height: 0.98;
			margin: 0.15rem 0 0.35rem;
			max-width: none;
		}

		.lead-media img {
			aspect-ratio: 16 / 10;
			max-height: 13.5rem;
			object-fit: cover;
			object-position: center;
		}

		.lead-summary {
			font-size: 0.88rem;
			line-height: 1.42;
			-webkit-line-clamp: 2;
		}

		.lead-signal {
			font-size: 0.62rem;
		}

		.lead-meta {
			margin-top: 0.2rem;
			font-size: 0.63rem;
		}

		.lead-related {
			margin-top: 0.35rem;
		}

		.lead-related a {
			padding: 0.46rem 0;
			font-size: 0.84rem;
		}

		.section-heading-row {
			margin-bottom: 1rem;
		}

		.section-note {
			font-size: 0.68rem;
		}
	}

	.section-heading-row {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-bottom: 1.5rem;
	}

	.section-title {
		font-size: clamp(1.32rem, 1.08rem + 0.72vw, 1.82rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.section-note {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		margin: 0;
	}

	.front-rail {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
		align-content: start;
	}

	.rail-module {
		padding: 0.9rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 86%, var(--secondary) 14%);
	}

	.rail-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding-bottom: 0.8rem;
		margin: 0 0 0.9rem;
		border-bottom: 1px solid var(--border);
	}

	.rail-list {
		display: flex;
		flex-direction: column;
	}

	.rail-item {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.75rem;
		padding: 0.8rem 0;
		text-decoration: none;
		border-top: 1px solid var(--border);
	}

	.rail-item:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.rail-item p {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.1;
		color: var(--foreground);
		margin: 0 0 0.3rem;
	}

	.rail-rank {
		font-family: var(--font-serif);
		font-size: 2rem;
		line-height: 1;
		font-weight: 900;
		color: var(--nyt-gray-500);
		text-align: center;
	}

	.rail-state {
		font-family: var(--font-sans);
		font-size: 0.64rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--nyt-gray-500);
	}

	.rail-state.is-up {
		color: var(--nyt-accent);
	}

	.pulse-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.pulse-grid strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.85rem;
		line-height: 1;
		margin-top: 0.45rem;
	}

	.focus-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		overflow: hidden;
	}

	.focus-chip {
		padding: 0.42rem 0.58rem;
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--foreground);
		text-decoration: none;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.focus-chip:hover {
		background: var(--foreground);
		color: var(--background);
	}

	@media (min-width: 720px) {
		.supporting-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 960px) {
		.front-page-grid {
			grid-template-columns: minmax(0, 1.56fr) minmax(16.5rem, 0.62fr);
			gap: 1.85rem;
		}

		.lead-hero {
			grid-template-columns: minmax(0, 1.16fr) minmax(0, 1.04fr);
			align-items: start;
			gap: 1.15rem;
		}

		.lead-headline {
			font-size: clamp(2.35rem, 1.9rem + 1vw, 3.3rem);
			max-width: 12.75ch;
		}

		.lead-media img {
			aspect-ratio: 1.08 / 1;
		}

		.front-rail {
			position: sticky;
			top: 1.5rem;
		}
	}

	@media (min-width: 1280px) {
		.front-page-grid {
			grid-template-columns: minmax(0, 1.74fr) minmax(17.5rem, 0.7fr);
			gap: 2.2rem;
