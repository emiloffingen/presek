---
/* Cache-bust marker for homepage stylesheet hashing. */
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ForYouIsland from '../components/ForYouIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import HomeRailSuggestionsIsland from '../components/HomeRailSuggestionsIsland.tsx';
import SourceMapIsland from '../components/SourceMapIsland.tsx';
import NewsletterIsland from '../components/NewsletterIsland.tsx';
import { chooseClusterImage } from '../utils/imageSelection';
import { cleanAndDecode } from '../utils/textUtils';
import { apiBaseUrl } from '../lib/apiBase';
import { TrendingUp, BarChart3, Quote, Sparkles } from 'lucide-react';

const API_URL = apiBaseUrl();

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const q = searchParams.get('q');

let clusters = [];
let trending = [];
let topEntities = [];
let stats = null;
let health = null;
let error = null;
async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Request failed: ${response.status} ${url}`);
    }
    return response.json();
}

// Build the fetch URL with params
const newsUrl = new URL(`${API_URL}/news`);
newsUrl.searchParams.set('page_size', '40');
if (category) newsUrl.searchParams.set('category', category);
if (topic) newsUrl.searchParams.set('topic', topic);
if (q) newsUrl.searchParams.set('q', q);

// Fan out every SSR request in parallel — the news call is the only one
// the page can't usefully render without, so we still surface its failure.
const [newsResult, trendResult, entityResult, statsResult, healthResult] = await Promise.allSettled([
    fetchJson(newsUrl.toString()),
    fetchJson(`${API_URL}/trending`),
    fetchJson(`${API_URL}/intelligence/top-entities?limit=12`),
    fetchJson(`${API_URL}/stats/summary`),
    fetchJson(`${API_URL}/health`),
]);

if (newsResult.status === 'fulfilled') {
    clusters = newsResult.value?.clusters || [];
} else {
    console.error('News fetch error:', newsResult.reason);
    error = 'Грешка при вчитување на вестите.';
}

trending = trendResult.status === 'fulfilled' && Array.isArray(trendResult.value)
    ? trendResult.value
    : [];
topEntities = entityResult.status === 'fulfilled' && Array.isArray(entityResult.value)
    ? entityResult.value
    : [];
stats = statsResult.status === 'fulfilled' ? statsResult.value : null;
health = healthResult.status === 'fulfilled' ? healthResult.value : null;

function normalizeFocusName(name: string) {
    const clean = (name || '').replace(/\s+/g, ' ').trim().replace(/^[-–—,.;:!?()[\]{}"' ]+|[-–—,.;:!?()[\]{}"' ]+$/g, '');
    if (!clean) return '';
    if (/^[A-Za-zА-Яа-яЀ-ӿ\s-]+$/.test(clean) && clean === clean.toLowerCase()) {
        return clean
            .split(' ')
            .map((part) => part ? part[0].toUpperCase() + part.slice(1) : part)
            .join(' ');
    }
    return clean;
}

const focusEntities = topEntities
    .map((ent: any) => ({ ...ent, name: normalizeFocusName(ent?.name || '') }))
    .filter((ent: any) => ent.name && ent.name.length >= 3)
    .slice(0, 10);

const leadCluster = clusters[0] ?? null;
const supportingClusters = clusters.slice(1, 5);
const feedClusters = clusters.slice(5);
const continuingClusters = feedClusters.filter((cluster: any) => (cluster?.articles?.length || 0) >= 2);
const wireClusters = feedClusters.filter((cluster: any) => (cluster?.articles?.length || 0) < 2).slice(0, 8);
const supportingFeatured = supportingClusters.slice(0, 2);
const supportingCompact = supportingClusters.slice(2);
const developmentsFeatured = continuingClusters.slice(0, 4);
const developmentsCompact = continuingClusters.slice(4);

function getLeadSignal(cluster: any) {
	const count = cluster?.articles?.length || 0;
	if (cluster?.is_breaking) return 'Најбрз развој во денот';
	if (count >= 6) return 'Приказна што ја движи домашната агенда';
	if (count >= 4) return 'Тема што брзо се шири низ редакциите';
	return 'Развој што вреди да се следи';
}

function cleanLeadSummary(text?: string) {
	return cleanAndDecode(text);
}

function getLeadSummary(cluster: any) {
	const article = cluster?.articles?.[0];
	let text = article?.summary || article?.description || '';
	
	// Safety check for JSON leakage - can be raw or double-escaped from DB
	const trimmed = typeof text === 'string' ? text.trim() : '';
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			// If it contains &quot;, it's already been through an escaping cycle
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) text = parsed.summary;
				else if (parsed.text) text = parsed.text;
			}
		} catch (e) {
			// Not valid JSON
		}
	}
	
	return cleanAndDecode(text);
}

const leadSignal = leadCluster ? getLeadSignal(leadCluster) : '';
const leadSummary = leadCluster ? getLeadSummary(leadCluster) : '';
const leadTitle = leadCluster ? cleanAndDecode(leadCluster.articles[0].title) : '';
const leadVisual = leadCluster ? chooseClusterImage(leadCluster, 'hero') : null;
const freshness = health?.freshness || null;

function getTimeStr(dateStr: string) {
    try {
        return new Date(dateStr).toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}

function getThumb(cluster: any, variant: 'hero' | 'card' | 'thumb' = 'card') {
    return chooseClusterImage(cluster, variant).proxiedUrl || '/img/placeholder.svg';
}
---

<Layout
	title={q || category || topic || "Пресек | Повеќе од вести"}
	description={q || category || topic
		? "Пресек ги групира поврзаните вести, ги споредува изворите и ви овозможува побрз преглед на контекстот."
		: "Пресек е македонски информативен агрегатор што ги собира вестите од сите медиуми, ги групира по тема и покажува како различните извори известуваат за ист настан."}
>
    <NYTHeader q={q} category={category} topic={topic} />

	<main class="site-layout">
		{/* Filtering Status */}
		{(q || category || topic) && (
			<div class="mb-10 py-4 border-y border-nyt-gray-300 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<div class="flex flex-col gap-1">
					<h2 class="font-serif text-2xl font-black italic">
						{q ? `Резултати за: "${q}"` : `${category || topic}`}
					</h2>
					{q && (
						<div class="flex items-center gap-1.5 text-nyt-accent">
							<Sparkles size={12} />
							<span class="font-sans text-[10px] font-black uppercase tracking-widest">Семантичко пребарување активно</span>
						</div>
					)}
				</div>
				<a href="/" class="nyt-section-label text-muted hover:text-nyt-red transition-colors">Сите вести</a>
			</div>
		)}

		<div class="front-page-grid">
			<div class="front-main">
					{error && (
						<div class="p-12 text-center bg-nyt-gray-100 border border-nyt-gray-300">
							<p class="font-serif italic text-nyt-red font-black uppercase tracking-widest">{error}</p>
						</div>
					)}

					{!error && clusters.length === 0 && (
						<div class="empty-feed">
							<p class="empty-feed-kicker">Тивко на лентата</p>
							<h2 class="empty-feed-title">Моментално нема нови вести што се истакнуваат.</h2>
							<p class="empty-feed-copy">
								Сè уште ги собираме објавите од сите медиуми. Освежете ја страницата за неколку минути или прелистајте ја <a href="/archive">архивата</a> за претходните денови.
							</p>
						</div>
					)}

				{leadCluster && (
					<section class="lead-hero motion-rise">
						<div class="lead-copy">
							<div class="lead-kicker">
								<span class="source-label">{leadCluster.articles[0].source}</span>
								{leadCluster.is_breaking && <span class="live-pill">Во живо</span>}
							</div>
							<a href={`/cluster/${leadCluster.cluster_id}`} class="no-underline">
								<h1 class="lead-headline" set:html={leadTitle}></h1>
							</a>
							<p class="lead-signal">{leadSignal}</p>
							{leadSummary && (
								<p class="lead-summary" set:html={leadSummary}></p>
							)}
							<div class="lead-meta">
								<span>{getTimeStr(leadCluster.articles[0].created_at)}</span>
								<span>·</span>
								<span>{leadCluster.articles.length} извори</span>
							</div>

							{leadCluster.articles.length > 1 && (
								<ul class="lead-related">
									{leadCluster.articles.slice(1, 4).map((article: any) => (
										<li>
											<a href={`/cluster/${leadCluster.cluster_id}`}>{cleanAndDecode(article.title)}</a>
										</li>
									))}
								</ul>
							)}
						</div>

							<a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media" aria-hidden="true" tabindex="-1">
								<div class:list={["lead-media-frame", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
									{leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
										<>
											<img
												src={leadVisual.proxiedUrl}
												alt=""
												width="1200"
												height="1000"
												loading="eager"
												fetchpriority="high"
												decoding="async"
												class="lead-media-image"
												onload="this.classList.add('is-loaded')"
												onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
											/>
											<div class="lead-media-placeholder lead-media-placeholder-error" style="display: none;">
												<p class="lead-media-kicker">Сликата не е достапна</p>
												<h2>{leadCluster.articles[0].category || 'Водечка тема'}</h2>
											</div>
										</>
									) : (
										<div class="lead-media-placeholder">
											<p class="lead-media-kicker">Пресек Преглед</p>
											<h2>{leadCluster.articles[0].category || 'Водечка тема'}</h2>
											<p class="lead-media-fallback-source">{leadCluster.articles[0].source}</p>
											<p class="lead-media-fallback-title">{leadTitle}</p>
										</div>
									)}
								</div>
							</a>
						</section>
					)}

					{leadCluster && (
						<section class="editor-brief motion-rise motion-delay-1">
							<div class="editor-brief-intro">
								<p class="micro-label">Што да гледате прво</p>
								<h2>Брз редакциски ориентир пред да влезете во целата лента.</h2>
							</div>
							<div class="editor-brief-grid">
								<div class="editor-brief-card">
									<span class="micro-label">Водечка тема</span>
									<strong>{leadCluster.articles.length}</strong>
									<p>извори веќе ја развиваат главната приказна на денот.</p>
								</div>
								<div class="editor-brief-card">
									<span class="micro-label">Следуваат</span>
									<strong>{supportingClusters.length}</strong>
									<p>теми веднаш подолу што додаваат реакција, контекст или втор агол.</p>
								</div>
								<div class="editor-brief-card">
									<span class="micro-label">Ритам 24ч</span>
									<strong>{stats ? stats.last_24h.toLocaleString('mk-MK') : '...'}</strong>
									<p>објави ја обликуваат денешната медиумска густина.</p>
								</div>
							</div>
						</section>
					)}

					{supportingClusters.length > 0 && (
						<section class="supporting-band motion-rise motion-delay-2">
							<div class="section-heading-row">
								<h2 class="section-title">Веднаш потоа</h2>
								<p class="section-note">Следниот слој на приказни што го шири дневниот контекст.</p>
							</div>
							<div class="supporting-featured-grid">
								{supportingFeatured.map((cluster) => (
									<NewsCard cluster={cluster} variant="featured" />
								))}
							</div>
							{supportingCompact.length > 0 && (
								<div class="supporting-compact-grid">
									{supportingCompact.map((cluster) => (
										<NewsCard cluster={cluster} variant="compact" />
									))}
								</div>
							)}
						</section>
					)}

					{clusters.length > 4 && (
						<ForYouIsland client:load clusters={clusters.slice(0, 18)} />
					)}

					<OnboardingIsland client:load compact />

					{feedClusters.length > 0 && (
						<section class="feed-section motion-rise motion-delay-3">
						<div class="section-heading-row">
							<h2 class="section-title">Теми во развој</h2>
							<p class="section-note">Приказни за кои веќе известуваат повеќе медиуми и кои вреди да се следат.</p>
						</div>
						{developmentsFeatured.length > 0 && (
							<div class="news-feed-grid news-feed-grid-featured">
								{developmentsFeatured.map((cluster) => (
									<NewsCard cluster={cluster} variant="featured" />
								))}
							</div>
						)}
						{developmentsCompact.length > 0 && (
							<div class="news-feed-grid news-feed-grid-compact">
								{developmentsCompact.map((cluster) => (
									<NewsCard cluster={cluster} variant="compact" />
								))}
							</div>
						)}
					</section>
				)}

					{wireClusters.length > 0 && (
						<section class="feed-section feed-section-wire motion-rise motion-delay-3">
							<div class="section-heading-row">
								<h2 class="section-title">Најнови вести</h2>
								<p class="section-note">Свежи поединечни објави што сè уште чекаат пошироко покривање од други извори.</p>
							</div>
							<div class="wire-stack">
								{wireClusters.map((cluster) => (
									<NewsCard cluster={cluster} variant="wire" />
								))}
							</div>
						</section>
					)}
			</div>

			<aside class="front-rail">
				<section class="rail-module rail-module-featured rail-pulse motion-rise-fast motion-delay-1">
					<p class="rail-kicker">Редакциски сигнал</p>
					<h3 class="rail-title">
						<BarChart3 size={14} /> МЕДИУМСКИ ПУЛС
					</h3>
					<div class="pulse-grid">
						<div>
							<span class="micro-label">Статии денес</span>
							<strong>{stats ? stats.last_24h.toLocaleString('mk-MK') : '...'}</strong>
						</div>
						<div>
							<span class="micro-label">Извори</span>
							<strong>{stats ? stats.total_feeds.toLocaleString('mk-MK') : '...'}</strong>
						</div>
					</div>
					{freshness && (
						<div class={`freshness-chip freshness-${freshness.status}`}>
							<span>{freshness.label}</span>
							{typeof freshness.age_minutes === 'number' && <strong>{freshness.age_minutes} мин</strong>}
						</div>
					)}
					<p class="rail-note">Брз ориентир за тоа каде денес се натрупува вниманието, а не само каде прво излегла веста.</p>
				</section>

				<HomeRailSuggestionsIsland client:load />

				<NewsletterIsland client:load />

				<SourceMapIsland client:visible />

				{stats?.quote_of_the_day && (
					<section class="rail-module rail-quote motion-rise-fast">
						<p class="rail-kicker">Од денешната слика</p>
						<h3 class="rail-title flex items-center gap-2">
							<Quote size={14} className="text-nyt-accent" /> ЦИТАТ НА ДЕНОТ
						</h3>
						<blockquote class="mt-4">
							<p class="font-serif text-lg leading-snug italic text-foreground mb-3">
								"{stats.quote_of_the_day.quote}"
							</p>
							<cite class="block border-t border-border pt-3">
								<a href={`/cluster/${stats.quote_of_the_day.cluster_id}`} class="group">
									<span class="micro-label block mb-1">Поврзана вест</span>
									<span class="font-serif font-bold text-xs group-hover:text-nyt-accent transition-colors leading-tight block">
										{stats.quote_of_the_day.title}
									</span>
								</a>
							</cite>
						</blockquote>
					</section>
				)}

				<section class="rail-module rail-module-quiet motion-rise-fast motion-delay-2">
					<p class="rail-kicker">Што најчесто се повторува</p>
					<h3 class="rail-title">ТЕМИ ВО ФОКУС</h3>
					<div class="focus-cloud">
						{focusEntities.map((ent: any) => (
							<a href={`/subjekt/${encodeURIComponent(ent.name)}`} class="focus-chip">
								{ent.name}
							</a>
						))}
					</div>
					<p class="rail-note">Имиња и теми што најупорно се враќаат низ денешните објави и реакции.</p>
				</section>
			</aside>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.front-page-grid {
		--front-page-cache-bust-20260409: 1;
	}

	.front-page-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.35rem;
		padding-bottom: 3.5rem;
	}

	.front-main {
		min-width: 0;
	}

	.editor-note {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 1.5rem 0 2rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}

	.editor-note h2 {
		font-size: clamp(1.6rem, 1.2rem + 1vw, 2.25rem);
		line-height: 1.02;
		max-width: 16ch;
		margin: 0.35rem 0 0;
	}

	.editor-note-meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 24rem;
	}

	.editor-note-meta strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		line-height: 1;
		margin-top: 0.35rem;
	}

	.micro-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.editor-brief {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 1.1rem 0 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.editor-brief-intro {
		display: grid;
		gap: 0.35rem;
		max-width: 40rem;
	}

	.editor-brief-intro h2 {
		margin: 0;
		font-size: clamp(1.28rem, 1.05rem + 0.7vw, 1.7rem);
		line-height: 1.06;
	}

	.editor-brief-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.editor-brief-card {
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 96%, var(--secondary) 4%);
	}

	.editor-brief-card strong {
		display: block;
		margin: 0.25rem 0 0.45rem;
		font-family: var(--font-serif);
		font-size: clamp(1.75rem, 1.45rem + 0.7vw, 2.3rem);
		line-height: 1;
	}

	.editor-brief-card p {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 0.94rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
	}

	.lead-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.95rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--border);
	}

	.empty-feed {
		padding: 3rem 1.5rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--surface-soft) 12%);
		text-align: center;
		display: grid;
		gap: 0.75rem;
		justify-items: center;
	}

	.empty-feed-kicker {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--nyt-accent);
	}

	.empty-feed-title {
		margin: 0;
		font-size: clamp(1.4rem, 1.1rem + 1vw, 1.85rem);
		max-width: 28ch;
		line-height: 1.1;
	}

	.empty-feed-copy {
		margin: 0;
		max-width: 48ch;
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.55;
		color: var(--secondary-foreground);
	}

	.empty-feed-copy a {
		color: var(--nyt-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.lead-kicker,
	.lead-meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.live-pill {
		border: 1px solid var(--nyt-red);
		color: var(--nyt-red);
		padding: 0.1rem 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lead-headline {
		font-size: clamp(2.2rem, 1.7rem + 1.55vw, 4.2rem);
		line-height: 0.94;
		letter-spacing: -0.028em;
		margin: 0.35rem 0 0.65rem;
		max-width: 14ch;
		text-wrap: balance;
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
