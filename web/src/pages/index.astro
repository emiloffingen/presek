---
/* Cache-bust marker for homepage stylesheet hashing. */
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ForYouIsland from '../components/ForYouIsland.tsx';
import OnboardingIsland from '../components/OnboardingIsland.tsx';
import HomeRailSuggestionsIsland from '../components/HomeRailSuggestionsIsland.tsx';
import SourceMapIsland from '../components/SourceMapIsland.tsx';
import NewsletterIsland from '../components/NewsletterIsland.tsx';
import HomeLiveUpdatesIsland from '../components/HomeLiveUpdatesIsland.tsx';
import LeadHero from '../components/home/LeadHero.astro';
import SupportingBand from '../components/home/SupportingBand.astro';
import DevelopmentsSection from '../components/home/DevelopmentsSection.astro';
import { chooseClusterImage } from '../utils/imageSelection';
import { cleanAndDecode, isMostlyCyrillic } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { apiBaseUrl } from '../lib/apiBase';
import { TrendingUp, Quote, Sparkles } from 'lucide-react';
import type { NewsCluster } from '../types';

const API_URL = apiBaseUrl();

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const q = searchParams.get('q');

let clusters: NewsCluster[] = [];
let trending = [];
let topEntities = [];
let stats = null;
let error = null;
async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Request failed: ${response.status} ${url}`);
    }
    return response.json();
}

// Build the fetch URL with params
const newsUrl = new URL(`${API_URL}/news`);
newsUrl.searchParams.set('page_size', '48');
if (category) newsUrl.searchParams.set('category', category);
if (topic) newsUrl.searchParams.set('topic', topic);
if (q) newsUrl.searchParams.set('q', q);

// Fan out every SSR request in parallel — the news call is the only one
// the page can't usefully render without, so we still surface its failure.
const [newsResult, trendResult, entityResult, statsResult] = await Promise.allSettled([
    fetchJson(newsUrl.toString()),
    fetchJson(`${API_URL}/trending`),
    fetchJson(`${API_URL}/intelligence/top-entities?limit=12`),
    fetchJson(`${API_URL}/stats/summary`),
]);

if (newsResult.status === 'fulfilled') {
    clusters = newsResult.value?.clusters || [];
} else {
    console.error('News fetch error:', newsResult.reason);
    error = 'Грешка при вчитување на вестите.';
}

trending = trendResult.status === 'fulfilled' && Array.isArray(trendResult.value)
    ? trendResult.value
    : [];
topEntities = entityResult.status === 'fulfilled' && Array.isArray(entityResult.value)
    ? entityResult.value
    : [];
stats = statsResult.status === 'fulfilled' ? statsResult.value : null;

function normalizeFocusName(name: string) {
    const clean = (name || '').replace(/\s+/g, ' ').trim().replace(/^[-–—,.;:!?()[\]{}"' ]+|[-–—,.;:!?()[\]{}"' ]+$/g, '');
    if (!clean) return '';
    if (/^[A-Za-zА-Яа-яЀ-ӿ\s-]+$/.test(clean) && clean === clean.toLowerCase()) {
        return clean
            .split(' ')
            .map((part) => part ? part[0].toUpperCase() + part.slice(1) : part)
            .join(' ');
    }
    return clean;
}

const focusEntities = topEntities
    .map((ent: { name: string; total_mentions: number }) => ({ ...ent, name: normalizeFocusName(ent?.name || '') }))
    .filter((ent: { name: string }) => ent.name && ent.name.length >= 3)
    .slice(0, 10);

const leadCluster = clusters[0] ?? null;
const supportingClusters = clusters.slice(1, 5);

function getLeadSignal(cluster: NewsCluster) {
	const count = cluster?.articles?.length || 0;
	if (cluster?.is_breaking) return 'Најбрз развој во денот';
	if (count >= 6) return 'Приказна што ја движи домашната агенда';
	if (count >= 4) return 'Тема што брзо се шири низ редакциите';
	return 'Развој што вреди да се следи';
}

function cleanLeadSummary(text?: string) {
	return cleanAndDecode(text);
}

function getLeadSummary(cluster: NewsCluster) {
	const article = cluster?.articles?.[0];
	let text = article?.summary || article?.description || '';
	
	// Safety check for JSON leakage - can be raw or double-escaped from DB
	const trimmed = typeof text === 'string' ? text.trim() : '';
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			// If it contains &quot;, it's already been through an escaping cycle
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) text = parsed.summary;
				else if (parsed.text) text = parsed.text;
			}
		} catch (e) {
			// Not valid JSON
		}
	}
	
	return cleanAndDecode(text);
}

const leadSignal = leadCluster ? getLeadSignal(leadCluster) : '';
const leadSummary = leadCluster ? getLeadSummary(leadCluster) : '';
const leadTitle = leadCluster?.articles?.[0] ? cleanAndDecode(leadCluster.articles[0].title) : '';
const leadTitleIsCyrillic = isMostlyCyrillic(leadTitle);
const leadSummaryIsCyrillic = isMostlyCyrillic(leadSummary);
const leadVisual = leadCluster ? chooseClusterImage(leadCluster, 'hero') : null;

// Reserve a smaller personalization pool so the homepage can surface more live
// backend activity in the visible editorial feed instead of hiding it behind
// recommendation logic.
const FOR_YOU_START = 5;
const FOR_YOU_END = 11;
const forYouClusters = clusters.slice(FOR_YOU_START, FOR_YOU_END).map((c: any) => {
    const a = c.articles?.[0] || {};
    return {
        cluster_id: c.cluster_id,
        is_breaking: c.is_breaking,
        topics: c.topics,
        tags: c.tags,
        homepage_score: c.homepage_score,
        articles: [{
            title: a.title,
            source: a.source,
            summary: a.summary,
            description: a.description,
            category: a.category,
        }],
        sources_count: c.articles?.length || 0,
    };
});

// Start the main feed immediately after the reserved personalization pool so
// more fresh clusters remain visible on the homepage by default.
const feedClusters = clusters.slice(FOR_YOU_END);
const continuingClusters = feedClusters.filter((cluster: NewsCluster) => (cluster?.articles?.length || 0) >= 2);
const wireClusters = feedClusters.filter((cluster: NewsCluster) => (cluster?.articles?.length || 0) < 2).slice(0, 12);
const supportingFeatured = supportingClusters.slice(0, 2);
const supportingCompact = supportingClusters.slice(2);
const developmentsFeatured = continuingClusters.slice(0, 6);
const developmentsCompact = continuingClusters.slice(6, 18);

// Extract cluster IDs to exclude from ForYou personalization to prevent duplication
const excludedClusterIds = [
  leadCluster?.cluster_id,
  ...supportingClusters.map((c: any) => c.cluster_id)
].filter(Boolean);

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}
---

<Layout
	title={q || category || topic || "Пресек | Повеќе од вести"}
	description={q || category || topic
		? "Пресек ги групира поврзаните вести, ги споредува изворите и ви овозможува побрз преглед на контекстот."
		: "Пресек е македонски информативен агрегатор што ги собира вестите од сите медиуми, ги групира по тема и покажува како различните извори известуваат за ист настан."}
>
    <NYTHeader q={q} category={category} topic={topic} stats={stats} />

	<main class="site-layout py-[var(--page-py)]">
		{/* Filtering Status */}
		{(q || category || topic) && (
			<div class="mb-10 py-6 border-y border-nyt-gray-300 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between bg-secondary/30 px-4 -mx-4 sm:mx-0 sm:px-0">
				<div class="flex flex-col gap-1.5">
					<p class="font-sans text-[9px] font-black uppercase tracking-[0.2em] text-muted-foreground">Резултати од пребарување</p>
					<h2 class="font-serif text-3xl font-black italic leading-none">
						{q ? `"${q}"` : `${category || topic}`}
					</h2>
					{q && (
						<div class="flex items-center gap-2 text-nyt-accent mt-1">
							<Sparkles size={12} strokeWidth={2.5} />
							<span class="font-sans text-[10px] font-black uppercase tracking-widest">Семантичка интелигенција активна</span>
							<span class="text-[9px] text-muted-foreground lowercase opacity-70 italic hidden md:inline">— ги наоѓаме и поврзаните концепти</span>
						</div>
					)}
				</div>
				<a href="/" class="nyt-section-label inline-flex items-center gap-2 px-4 py-2 border border-border rounded-full hover:bg-foreground hover:text-background transition-all">
					Сите главни вести <TrendingUp size={12} />
				</a>
			</div>
		)}

		<div class="front-page-grid">
			<div class="front-main">
					{error && (
						<div class="p-12 text-center bg-nyt-gray-100 border border-nyt-gray-300">
							<p class="font-serif italic text-nyt-red font-black uppercase tracking-widest">{error}</p>
						</div>
					)}

					{!error && clusters.length === 0 && (
						<div class="empty-feed py-16 px-8 rounded-sm bg-gradient-to-b from-secondary/40 to-background border-dashed">
							<p class="empty-feed-kicker">Тивко на лентата</p>
							<h2 class="empty-feed-title mb-4">Нема нови вести за "{q || category || topic}".</h2>
							<p class="empty-feed-copy mb-10 text-balance">
								Нашите алгоритми сè уште не откриле нови групирани објави за оваа специфична тема. Пробајте со поопшт поим или пребарајте нешто што е актуелно:
							</p>
							
							{trending.length > 0 && (
								<div class="flex flex-wrap justify-center gap-3 max-w-2xl">
									{trending.slice(0, 8).map((t: any) => (
										<a href={`/?q=${encodeURIComponent(t.word)}`} class="px-4 py-2 bg-background border border-border hover:border-nyt-accent hover:text-nyt-accent transition-all font-serif font-bold italic text-lg shadow-sm">
											{t.word} {t.trend === '↑' && <span class="text-nyt-red text-xs">↑</span>}
										</a>
									))}
								</div>
							)}
						</div>
					)}

				{leadCluster && (
					<LeadHero
						leadCluster={leadCluster}
						leadTitle={leadTitle}
						leadTitleIsCyrillic={leadTitleIsCyrillic}
						leadSignal={leadSignal}
						leadSummary={leadSummary}
						leadSummaryIsCyrillic={leadSummaryIsCyrillic}
						leadVisual={leadVisual}
						dominantColor={leadCluster.dominant_color}
						getTimeStr={getTimeStr}
					/>
				)}

				{leadCluster && supportingClusters.length > 0 && (
					<SupportingBand 
						supportingFeatured={supportingFeatured}
						supportingCompact={supportingCompact}
					/>
				)}

				{clusters.length > 6 && (
					<HomeLiveUpdatesIsland client:load excludeClusterIds={excludedClusterIds} />
				)}

				{clusters.length > 4 && (
					<ForYouIsland client:visible clusters={forYouClusters} excludeClusterIds={excludedClusterIds} />
				)}

				{feedClusters.length > 0 && (
					<DevelopmentsSection
						title="Теми во развој"
						note="Приказни за кои веќе известуваат повеќе медиуми и кои вреди да се следат."
						developmentsFeatured={developmentsFeatured}
						developmentsCompact={developmentsCompact}
					/>
				)}

				<OnboardingIsland client:idle compact />

				{wireClusters.length > 0 && (
					<DevelopmentsSection
						title="Најнови вести"
						note="Свежи поединечни објави што сè уште чекаат пошироко покривање од други извори."
						developmentsFeatured={wireClusters}
						developmentsCompact={[]}
						variant="wire"
					/>
				)}
			</div>

			<aside class="front-rail">
				<section class="rail-module rail-module-featured motion-rise-fast">
					<p class="rail-kicker">Интелигенција</p>
					<h3 class="rail-title flex items-center gap-2">
						<Sparkles size={14} className="text-nyt-accent" /> МЕДИУМСКИ ПУЛС
					</h3>
					<div class="space-y-4 mt-4">
						<div class="flex justify-between items-end border-b border-border pb-2">
							<span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Плурализам</span>
							<span class="font-serif font-black text-xl leading-none">{(stats?.intelligence?.pluralism?.high_consensus_pct || 0)}%</span>
						</div>
						<div class="flex justify-between items-end border-b border-border pb-2">
							<span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Уредничка Синтеза</span>
							<span class="font-serif font-black text-xl leading-none">{(stats?.intelligence?.ai_transparency?.ai_ratio || 0)}%</span>
						</div>
					</div>
					<a href="/pulse" class="block text-center mt-4 py-2 bg-foreground text-background font-sans text-[10px] font-black uppercase tracking-widest hover:opacity-90 transition-opacity">
						Целосна Аналитика
					</a>
				</section>

				<HomeRailSuggestionsIsland client:visible />

				<NewsletterIsland client:visible />

				<SourceMapIsland client:visible />

				{stats?.quote_of_the_day && (
					<section class="rail-module rail-quote motion-rise-fast">
						<p class="rail-kicker">Од денешната слика</p>
						<h3 class="rail-title flex items-center gap-2">
							<Quote size={14} className="text-nyt-accent" /> ЦИТАТ НА ДЕНОТ
						</h3>
						<blockquote class="mt-4">
							<p class="font-serif text-lg leading-snug italic text-foreground mb-3">
								"{stats.quote_of_the_day.quote}"
							</p>
							<cite class="block border-t border-border pt-3">
								<a href={`/cluster/${stats.quote_of_the_day.cluster_id}`} class="group">
									<span class="micro-label block mb-1">Поврзана вест</span>
									<span class="font-serif font-bold text-xs group-hover:text-nyt-accent transition-colors leading-tight block">
										{stats.quote_of_the_day.title}
									</span>
								</a>
							</cite>
						</blockquote>
					</section>
				)}

				<section class="rail-module rail-module-quiet motion-rise-fast motion-delay-2">
					<p class="rail-kicker">Што најчесто се повторува</p>
					<h3 class="rail-title">ТЕМИ ВО ФОКУС</h3>
					<div class="focus-cloud">
						{focusEntities.map((ent: any) => (
							<a href={`/subjekt/${encodeURIComponent(ent.name)}`} class="focus-chip group">
								<span class="opacity-60 mr-1.5 group-hover:opacity-100 transition-opacity">
									{ent.type === 'ORG' ? '🏢' : ent.type === 'PERSON' ? '👤' : '🏷️'}
								</span>
								{ent.name}
							</a>
						))}
					</div>
					<p class="rail-note">Имиња и теми што најупорно се враќаат низ денешните објави и реакции.</p>
				</section>
			</aside>
		</div>
	</main>

	<Footer />
</Layout>

<script>
	// Personalization 2.0: Implicit "Click-Stream" Re-ranking
	import { scoreClusterForReader, loadReaderProfile, hasPersonalizationSignal } from '../lib/personalization.js';

	document.addEventListener('astro:page-load', () => {
		const profile = loadReaderProfile();
		if (!hasPersonalizationSignal(profile)) return;

		const grids = document.querySelectorAll('.news-feed-grid');
		grids.forEach(grid => {
			const cards = Array.from(grid.querySelectorAll('.news-card'));
			if (cards.length < 2) return;

			const scoredCards = cards.map(card => {
				const clusterDataStr = card.getAttribute('data-cluster');
				if (!clusterDataStr) return { card, score: 0 };
				try {
					const cluster = JSON.parse(clusterDataStr);
					const result = scoreClusterForReader(cluster, profile);
					// Base score + implicit bonus
					const finalScore = (cluster.homepage_score || 0) + (result?.score || 0) * 2;
					
					// Add visual indicator if strongly personalized
					if (result && result.score > 1.5 && !card.querySelector('.personalized-badge')) {
						const metaRow = card.querySelector('.footer-meta');
						if (metaRow) {
							const badge = document.createElement('span');
							badge.className = 'personalized-badge text-[9px] font-black text-nyt-accent uppercase tracking-widest ml-auto opacity-80 flex items-center gap-1';
							const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
							svg.setAttribute('width', '10');
							svg.setAttribute('height', '10');
							svg.setAttribute('viewBox', '0 0 24 24');
							svg.setAttribute('fill', 'none');
							svg.setAttribute('stroke', 'currentColor');
							svg.setAttribute('stroke-width', '2.5');
							svg.setAttribute('stroke-linecap', 'round');
							svg.setAttribute('stroke-linejoin', 'round');
							const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
							path.setAttribute('d', 'm12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z');
							svg.appendChild(path);
							badge.appendChild(svg);
							badge.appendChild(document.createTextNode(` ${result.reason}`));
							metaRow.appendChild(badge);
						}
					}
					
					return { card, score: finalScore };
				} catch (e) {
					return { card, score: 0 };
				}
			});

			scoredCards.sort((a, b) => b.score - a.score);
			
			// Re-append in new order
			scoredCards.forEach(({ card }) => grid.appendChild(card));
		});
	});
</script>

<style>
	.front-page-grid {
		--front-page-cache-bust-20260409: 1;
	}

	.front-page-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--grid-gap);
		padding-bottom: var(--page-py);
	}

	.front-main {
		min-width: 0;
	}

	.editor-note {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 1.5rem 0 2rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}

	.editor-note h2 {
		font-size: clamp(1.6rem, 1.2rem + 1vw, 2.25rem);
		line-height: 1.02;
		max-width: 16ch;
		margin: 0.35rem 0 0;
	}

	.editor-note-meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 24rem;
	}

	.editor-note-meta strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		line-height: 1;
		margin-top: 0.35rem;
	}

	.micro-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.editor-brief {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 1.1rem 0 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.editor-brief-intro {
		display: grid;
		gap: 0.35rem;
		max-width: 40rem;
	}

	.editor-brief-intro h2 {
		margin: 0;
		font-size: clamp(1.28rem, 1.05rem + 0.7vw, 1.7rem);
		line-height: 1.06;
	}

	.editor-brief-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.editor-brief-card {
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 93%, var(--secondary) 7%);
	}

	.editor-brief-card strong {
		display: block;
		margin: 0.25rem 0 0.45rem;
		font-family: var(--font-serif);
		font-size: clamp(1.75rem, 1.45rem + 0.7vw, 2.3rem);
		line-height: 1;
	}

	.editor-brief-card p {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 0.94rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
	}

	.lead-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.8rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
	}

	.lead-hero-tint {
		position: absolute;
		top: -20%;
		right: -10%;
		width: 60%;
		height: 140%;
		background: radial-gradient(circle at center, var(--tint-color), transparent 70%);
		opacity: 0.04;
		filter: blur(80px);
		pointer-events: none;
		z-index: 0;
		transform: rotate(-15deg);
	}

	.dark .lead-hero-tint {
		opacity: 0.12;
		filter: blur(120px);
	}

	.lead-media-mobile {
		display: block;
	}

	.lead-media-desktop {
		display: none;
	}

	.empty-feed {
		padding: 3rem 1.5rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--surface-soft) 12%);
		text-align: center;
		display: grid;
		gap: 0.75rem;
		justify-items: center;
	}

	.empty-feed-kicker {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--nyt-accent);
	}

	.empty-feed-title {
		margin: 0;
		font-size: clamp(1.4rem, 1.1rem + 1vw, 1.85rem);
		max-width: 28ch;
		line-height: 1.1;
	}

	.empty-feed-copy {
		margin: 0;
		max-width: 48ch;
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.55;
		color: var(--secondary-foreground);
	}

	.empty-feed-copy a {
		color: var(--nyt-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.lead-kicker,
	.lead-meta {
		display: flex;
