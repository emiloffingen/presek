---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { TrendingUp, BarChart3 } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5001/api";

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const q = searchParams.get('q');

let clusters = [];
let trending = [];
let topEntities = [];
let error = null;

// Build the fetch URL with params
const newsUrl = new URL(`${API_URL}/news`);
newsUrl.searchParams.set('page_size', '40');
if (category) newsUrl.searchParams.set('category', category);
if (topic) newsUrl.searchParams.set('topic', topic);
if (q) newsUrl.searchParams.set('q', q);

try {
    const [newsRes, trendRes, entityRes] = await Promise.all([
        fetch(newsUrl.toString()),
        fetch(`${API_URL}/trending`),
        fetch(`${API_URL}/intelligence/top-entities?limit=12`)
    ]);
    
    if (newsRes.ok) {
        const newsData = await newsRes.json();
        clusters = newsData.clusters || [];
    } else {
        throw new Error("News fetch failed");
    }
    
    trending = await trendRes.json();
    topEntities = await entityRes.json();
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на вестите.";
}
---

<Layout title={q || category || topic || "Главни Вести"}>
    <NYTHeader q={q} category={category} topic={topic} />

	<main class="site-layout">
        {/* Filtering Status */}
		{(q || category || topic) && (
			<div class="mb-10 py-4 border-y border-nyt-gray-300 flex items-center justify-between">
				<h2 class="font-serif text-2xl font-black italic">
					{q ? `Резултати за: "${q}"` : `${category || topic}`}
				</h2>
				<a href="/" class="nyt-section-label text-muted hover:text-nyt-red">Прикажи ги сите вести</a>
			</div>
		)}

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:divide-x border-nyt-gray-300">
			<!-- Main Column (Col 1-9) -->
			<div class="lg:col-span-9">
				{error && (
					<div class="p-12 text-center bg-nyt-gray-100 border border-nyt-gray-300">
						<p class="font-serif italic text-nyt-red font-black uppercase tracking-widest">{error}</p>
					</div>
				)}

				<div class="news-feed-grid">
					{clusters.map((cluster, idx) => (
						<NewsCard 
							cluster={cluster} 
							isLead={idx === 0 && !q && !category && !topic}
						/>
					))}
				</div>
			</div>

			<!-- NYT Sidebar (Col 10-12) -->
			<aside class="lg:col-span-3 lg:pl-8 space-y-12">
				<section>
					<h3 class="nyt-section-label mb-6 flex items-center gap-2 border-b border-nyt-black pb-2">
						<TrendingUp size={14} /> ПОПУЛАРНО СЕГА
					</h3>
					<div class="divide-y border-nyt-gray-200">
						{trending.slice(0, 10).map((item, idx) => (
							<a href={`/?q=${item.word}`} class="flex items-center gap-4 py-3 group no-underline">
								<span class="font-serif text-3xl font-black text-nyt-gray-500 group-hover:text-nyt-black transition-colors min-w-[1.5rem] text-center">{idx + 1}</span>
								<div>
									<p class="font-serif font-black text-sm text-nyt-black group-hover:text-nyt-gray-600 leading-tight">{item.word}</p>
									<span class={`text-[10px] font-black uppercase ${item.trend === '↑' ? 'text-nyt-accent' : 'text-nyt-gray-500'}`}>
                                        {item.trend === '↑' ? 'Расте' : 'Стабилно'}
                                    </span>
								</div>
							</a>
						))}
					</div>
				</section>

				<section class="bg-nyt-gray-100 p-6 border border-nyt-gray-300">
					<h3 class="nyt-section-label mb-4 flex items-center gap-2">
						<BarChart3 size={14} /> МЕДИУМСКИ ПУЛС
					</h3>
					<div class="space-y-4">
						<div class="flex justify-between border-b pb-2">
							<span class="text-[10px] font-black uppercase text-nyt-gray-600">Статии (24ч)</span>
							<span class="font-serif font-black text-lg">180+</span>
						</div>
						<div class="flex justify-between border-b pb-2">
							<span class="text-[10px] font-black uppercase text-nyt-gray-600">Активни Извори</span>
							<span class="font-serif font-black text-lg">42</span>
						</div>
					</div>
				</section>

                <section>
                    <h3 class="nyt-section-label mb-6 border-b border-nyt-black pb-2">ФОКУС</h3>
                    <div class="flex flex-wrap gap-2">
                        {topEntities.slice(0, 10).map((ent: any) => (
                            <a href={`/?q=${encodeURIComponent(ent.name)}`} class="nyt-section-label text-[9px] border border-nyt-gray-300 px-2 py-1 hover:bg-nyt-black hover:text-white transition">
                                {ent.name}
                            </a>
                        ))}
                    </div>
                </section>
			</aside>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.divide-y > * + * {
		border-top-width: 1px;
	}
</style>
