---
import Layout from '../layouts/Layout.astro';
import { apiBaseUrl } from '../lib/apiBase';
import type { NewsCluster } from '../types';

const API_URL = apiBaseUrl();

let clusters: NewsCluster[] = [];
let wireArticles: any[] = [];

try {
    const homeResult = await fetch(`${API_URL}/home`);
    const home = await homeResult.json();
    clusters = home?.lead ? [home.lead, ...home.supporting] : [];
    wireArticles = Array.isArray(home?.latest_wire) ? home.latest_wire : [];
} catch (e) {
    console.error("Error fetching home data", e);
}

// Combine clusters and wire into a single list
const allNews = [
    ...clusters.map(c => ({
        id: c.cluster_id,
        title: c.synthetic_headline || c.articles[0]?.title || 'Unknown Title',
        link: `/cluster/${c.cluster_id}`,
        source: c.articles[0]?.source || 'presek.mk',
        points: Math.floor(Math.random() * 200) + 10,
        user: 'presek_bot',
        time: c.articles[0]?.created_at || new Date().toISOString(),
        comments: c.articles.length || 0
    })),
    ...wireArticles.map((w, idx) => ({
        id: `wire-${idx}`,
        title: w.title,
        link: w.link,
        source: w.source || 'wire',
        points: Math.floor(Math.random() * 50) + 1,
        user: 'wire_bot',
        time: new Date().toISOString(),
        comments: 0
    }))
].slice(0, 30);

---

<Layout title="Presek News">
    <center>
        <table id="hnmain" border="0" cellpadding="0" cellspacing="0" width="85%" bgcolor="#f6f6ef">
            <tr>
                <td bgcolor="#ff6600">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding:2px">
                        <tr>
                            <td style="width:18px;padding-right:4px">
                                <a href="/"><img src="/img/presek_emblem.svg" width="18" height="18" style="border:1px white solid; display:block" alt="Y" /></a>
                            </td>
                            <td style="line-height:12pt; height:10px;">
                                <span class="pagetop">
                                    <b class="hnname"><a href="/">Presek News</a></b>
                                    <a href="/new">new</a> | 
                                    <a href="/threads">threads</a> | 
                                    <a href="/past">past</a> | 
                                    <a href="/show">show</a> | 
                                    <a href="/ask">ask</a> | 
                                    <a href="/jobs">jobs</a> | 
                                    <a href="/submit">submit</a>
                                </span>
                            </td>
                            <td style="text-align:right;padding-right:4px;">
                                <span class="pagetop">
                                    <a href="/login">login</a>
                                </span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr id="pagespace" title="Presek News" style="height:10px"></tr>
            <tr>
                <td>
                    <table border="0" cellpadding="0" cellspacing="0">
                        {allNews.map((news, index) => (
                            <tr class="athing" id={news.id}>
                                <td align="right" valign="top" class="title"><span class="rank">{index + 1}.</span></td>
                                <td valign="top" class="votelinks">
                                    <center>
                                        <a id={`up_${news.id}`} href={`/vote?id=${news.id}&how=up`}>
                                            <div class="votearrow" title="upvote"></div>
                                        </a>
                                    </center>
                                </td>
                                <td class="title">
                                    <span class="titleline">
                                        <a href={news.link} target={news.link.startsWith('http') ? '_blank' : '_self'}>{news.title}</a>
                                        <span class="sitebit comhead"> (<a href={`/from?site=${news.source}`}><span class="sitestr">{news.source}</span></a>)</span>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                                <td class="subtext">
                                    <span class="score" id={`score_${news.id}`}>{news.points} points</span> by <a href={`/user?id=${news.user}`} class="hnuser">{news.user}</a> 
                                    <span class="age" title={news.time}>
                                        <a href={`/item?id=${news.id}`}>{new Date(news.time).toLocaleTimeString('sr-RS', {hour: '2-digit', minute:'2-digit'})}</a>
                                    </span> <span id={`unv_${news.id}`}></span> | <a href={`/hide?id=${news.id}`}>hide</a> | <a href={`/item?id=${news.id}`}>{news.comments}&nbsp;comments</a>
                                </td>
                            </tr>
                            <tr class="spacer" style="height:5px"></tr>
                        ))}
                        <tr class="morespace" style="height:10px"></tr>
                        <tr>
                            <td colspan="2"></td>
                            <td class="title"><a href="/news?p=2" class="morelink" rel="next">More</a></td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>
                    <img src="/s.gif" height="10" width="0" alt="" />
                    <table width="100%" cellspacing="0" cellpadding="1">
                        <tr><td bgcolor="#ff6600"></td></tr>
                    </table>
                    <br />
                    <center>
                        <span class="yclinks">
                            <a href="/newsguidelines.html">Guidelines</a> | 
                            <a href="/newsfaq.html">FAQ</a> | 
                            <a href="/lists">Lists</a> | 
                            <a href="/api">API</a> | 
                            <a href="/security.html">Security</a> | 
                            <a href="/legal.html">Legal</a> | 
                            <a href="http://www.ycombinator.com/apply/">Apply to YC</a> | 
                            <a href="mailto:hn@ycombinator.com">Contact</a>
                        </span>
                        <br /><br />
                        <form method="get" action="//hn.algolia.com/">Search: <input type="text" name="q" size="17" autocorrect="off" spellcheck="false" autocapitalize="off" autocomplete="false" /></form>
                    </center>
                </td>
            </tr>
        </table>
    </center>
</Layout>
