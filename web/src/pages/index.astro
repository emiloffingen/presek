---
/* Cache-bust marker for homepage stylesheet hashing. */
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ForYouIsland from '../components/ForYouIsland.tsx';
import HomeRailSuggestionsIsland from '../components/HomeRailSuggestionsIsland.tsx';
import NewsletterIsland from '../components/NewsletterIsland.tsx';
import HomeLiveUpdatesIsland from '../components/HomeLiveUpdatesIsland.tsx';
import EditorialBriefing from '../components/home/EditorialBriefing.astro';
import LeadHero from '../components/home/LeadHero.astro';
import SupportingBand from '../components/home/SupportingBand.astro';
import DevelopmentsSection from '../components/home/DevelopmentsSection.astro';
import AdUnit from '../components/AdUnit.astro';
import { chooseClusterImage } from '../utils/imageSelection';
import { cleanAndDecode, isMostlyCyrillic } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { apiBaseUrl } from '../lib/apiBase';
import { TrendingUp, Quote, Sparkles, ChevronRight, Activity } from 'lucide-react';
import type { NewsCluster } from '../types';

const API_URL = apiBaseUrl();

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const entity = searchParams.get('entity');
const q = searchParams.get('q');

let clusters: NewsCluster[] = [];
let globalClusters: NewsCluster[] = [];
let trending = [];
let topEntities = [];
let stats = null;
let briefing = null;
let error = null;
let liveNowClusters: NewsCluster[] = [];
let supportingClusters: NewsCluster[] = [];
let forYouClusters = [];
let feedClusters: NewsCluster[] = [];
let wireClusters: NewsCluster[] = [];
let wireArticles = [];
let excludedClusterIds: string[] = [];

async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Request failed: ${response.status} ${url}`);
    }
    return response.json();
}

const isHomepage = !(category || topic || entity || q);

if (isHomepage) {
    const homeResult = await Promise.allSettled([
        fetchJson(`${API_URL}/home`),
    ]);
    const homePayload = homeResult[0];

    if (homePayload.status === 'fulfilled' && homePayload.value?.status === 'success') {
        const home = homePayload.value;
        const lead = home?.lead ? [home.lead] : [];
        supportingClusters = Array.isArray(home?.supporting) ? home.supporting : [];
        liveNowClusters = Array.isArray(home?.live_now) ? home.live_now : [];
        forYouClusters = Array.isArray(home?.for_you_pool) ? home.for_you_pool.map((c: any) => {
            const a = c.articles?.[0] || {};
            return {
                cluster_id: c.cluster_id,
                is_breaking: c.is_breaking,
                topics: c.topics,
                tags: c.tags,
                homepage_score: c.homepage_score,
                articles: [{
                    title: a.title,
                    source: a.source,
                    summary: a.summary,
                    description: a.description,
                    category: a.category,
                }],
                sources_count: c.articles?.length || 0,
            };
        }) : [];
        const developingClusters = Array.isArray(home?.developing) ? home.developing : [];
        wireClusters = Array.isArray(home?.wire) ? home.wire : [];
        wireArticles = Array.isArray(home?.latest_wire) ? home.latest_wire : [];
        globalClusters = Array.isArray(home?.global) ? home.global : [];
        trending = Array.isArray(home?.trending) ? home.trending : [];
        topEntities = Array.isArray(home?.focus_entities) ? home.focus_entities : [];
        stats = home?.stats || null;
        briefing = home?.briefing || null;
        excludedClusterIds = Array.isArray(home?.excluded_cluster_ids) ? home.excluded_cluster_ids : [];
        feedClusters = [...developingClusters, ...wireClusters];
        clusters = [...lead, ...supportingClusters, ...(Array.isArray(home?.for_you_pool) ? home.for_you_pool : []), ...feedClusters];
    } else {
        console.error('Home fetch error:', homePayload.status === 'rejected' ? homePayload.reason : homePayload.value);
        error = 'Грешка при вчитување на вестите.';
    }
} else {
    const newsUrl = new URL(`${API_URL}/news`);
    newsUrl.searchParams.set('page_size', '48');
    if (category) newsUrl.searchParams.set('category', category);
    if (topic) newsUrl.searchParams.set('topic', topic);
    if (entity) newsUrl.searchParams.set('entity', entity);
    if (q) newsUrl.searchParams.set('q', q);

    const [newsResult, trendResult, entityResult, statsResult, briefingResult, wireResult] = await Promise.allSettled([
        fetchJson(newsUrl.toString()),
        fetchJson(`${API_URL}/trending`),
        fetchJson(`${API_URL}/intelligence/top-entities?limit=12`),
        fetchJson(`${API_URL}/stats/summary`),
        fetchJson(`${API_URL}/briefing`),
        fetchJson(`${API_URL}/home/latest-wire?limit=15`),
    ]);

    if (wireResult.status === 'fulfilled') {
        wireArticles = Array.isArray(wireResult.value?.articles) ? wireResult.value.articles : [];
    }

    if (newsResult.status === 'fulfilled') {
        clusters = newsResult.value?.clusters || [];
        globalClusters = newsResult.value?.global || [];
    } else {
        console.error('News fetch error:', newsResult.reason);
        error = 'Грешка при вчитување на вестите.';
    }

    trending = trendResult.status === 'fulfilled' && Array.isArray(trendResult.value)
        ? trendResult.value
        : [];
    topEntities = entityResult.status === 'fulfilled' && Array.isArray(entityResult.value)
        ? entityResult.value
        : [];
    stats = statsResult.status === 'fulfilled' ? statsResult.value : null;
    briefing = briefingResult.status === 'fulfilled' ? briefingResult.value : null;
}

function normalizeFocusName(name: string) {
    const clean = (name || '').replace(/\s+/g, ' ').trim().replace(/^[-–—,.;:!?()[\]{}"' ]+|[-–—,.;:!?()[\]{}"' ]+$/g, '');
    if (!clean) return '';
    if (/^[A-Za-zА-Яа-яЀ-ӿ\s-]+$/.test(clean) && clean === clean.toLowerCase()) {
        return clean
            .split(' ')
            .map((part) => part ? part[0].toUpperCase() + part.slice(1) : part)
            .join(' ');
    }
    return clean;
}

const focusEntities = topEntities
    .map((ent: { name: string; total_mentions: number }) => ({ ...ent, name: normalizeFocusName(ent?.name || '') }))
    .filter((ent: { name: string }) => ent.name && ent.name.length >= 3)
    .slice(0, 10);

const leadCluster = clusters[0] ?? null;
if (!isHomepage) {
    supportingClusters = clusters.slice(1, 5);
}

function getLeadSignal(cluster: NewsCluster) {
	const count = cluster?.articles?.length || 0;
	if (cluster?.is_breaking) return 'Најбрз развој во денот';
	if (count >= 6) return 'Приказна што ја движи домашната агенда';
	if (count >= 4) return 'Тема што брзо се шири низ редакциите';
	return 'Развој што вреди да се следи';
}

function getLeadSummary(cluster: NewsCluster) {
	const article = cluster?.articles?.[0];
	let text = article?.summary || article?.description || '';
	const trimmed = typeof text === 'string' ? text.trim() : '';
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) text = parsed.summary;
				else if (parsed.text) text = parsed.text;
			}
		} catch (e) {}
	}
	return cleanAndDecode(text);
}

const leadSignal = leadCluster ? getLeadSignal(leadCluster) : '';
const leadSummary = leadCluster ? getLeadSummary(leadCluster) : '';
const leadTitle = leadCluster?.articles?.[0] ? cleanAndDecode(leadCluster.articles[0].title) : '';
const leadTitleIsCyrillic = isMostlyCyrillic(leadTitle);
const leadSummaryIsCyrillic = isMostlyCyrillic(leadSummary);
const leadVisual = leadCluster ? chooseClusterImage(leadCluster, 'hero') : null;

if (!isHomepage) {
    const FOR_YOU_START = 5;
    const FOR_YOU_END = 11;
    forYouClusters = clusters.slice(FOR_YOU_START, FOR_YOU_END).map((c: any) => {
        const a = c.articles?.[0] || {};
        return {
            cluster_id: c.cluster_id,
            is_breaking: c.is_breaking,
            topics: c.topics,
            tags: c.tags,
            homepage_score: c.homepage_score,
            articles: [{
                title: a.title,
                source: a.source,
                summary: a.summary,
                description: a.description,
                category: a.category,
            }],
            sources_count: c.articles?.length || 0,
        };
    });
    feedClusters = clusters.slice(FOR_YOU_END);
    wireClusters = feedClusters.filter((cluster: NewsCluster) => (cluster?.articles?.length || 0) < 2).slice(0, 12);
}
const continuingClusters = feedClusters.filter((cluster: NewsCluster) => (cluster?.articles?.length || 0) >= 2);
const supportingFeatured = supportingClusters.slice(0, 2);
const supportingCompact = supportingClusters.slice(2);
const developmentsFeatured = continuingClusters.slice(0, 6);
const developmentsCompact = continuingClusters.slice(6, 18);

if (!isHomepage) {
    excludedClusterIds = [
      leadCluster?.cluster_id,
      ...supportingClusters.map((c: any) => c.cluster_id)
    ].filter(Boolean);
}

function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'ШТОТУКУ';
        if (diffMins < 60) return `ПРЕД ${diffMins} МИН`;

        return date.toLocaleTimeString('mk-MK', { 
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Skopje'
        });
    } catch {
        return '';
    }
}

function getBriefingSnippet(content: string) {
    if (!content) return '';
    const match = content.match(/## Што го движи денот\n+([^#]+)/) || content.match(/^([^#]+)/);
    if (match && match[1]) {
        const text = match[1].trim().split('\n')[0];
        return text.length > 150 ? text.substring(0, 147) + '...' : text;
    }
    return '';
}
---

<Layout
	title={q || category || topic || "Пресек | Повеќе од вести"}
	description={q || category || topic
		? "Пресек ги групира поврзаните вести, ги споредува изворите и ви овозможува побрз преглед на контекстот."
		: "Пресек е македонски информативен агрегатор што ги собира вестите од сите медиуми, ги групира по тема и покажува како различните извори известуваат за ист настан."}
>
    <NYTHeader q={q} category={category} topic={topic} stats={stats} />

	<main class="site-layout broadsheet-layout py-[var(--page-py)]">
		{/* Filtering Status */}
		{(q || category || topic || entity) && (
			<div class="filter-header mb-12">
				<p class="filter-kicker">Резултати за</p>
				<h1 class="filter-title">{q ? `"${q}"` : `${entity || category || topic}`}</h1>
				<div class="filter-meta-row">
					<div class="filter-chips">
						{q && <span class="filter-chip">Пребарување</span>}
						{entity && <span class="filter-chip">Субјект</span>}
						{category && <span class="filter-chip">Регион</span>}
						{topic && <span class="filter-chip">Тема</span>}
					</div>
					{(q || entity) && (
						<div class="system-status">
							<Sparkles size={10} strokeWidth={3} />
							<span>Семантичка Синтеза</span>
						</div>
					)}
					<a href="/" class="clear-filter">СИТЕ ВЕСТИ <ChevronRight size={10} strokeWidth={3} /></a>
				</div>
			</div>
		)}

		<div class="broadsheet-grid">
			<div class="broadsheet-main">
                {error && (
                    <div class="error-panel">
                        <p>{error}</p>
                    </div>
                )}

                {!error && clusters.length === 0 && (
                    <div class="empty-state">
                        <p class="empty-kicker">ТИВКО НА ЛЕНТАТА</p>
                        <h2>Нема нови вести за оваа тема.</h2>
                        <p class="empty-copy">Пробајте со поопшт поим или пребарајте нешто актуелно:</p>
                        <div class="trend-links">
                            {trending.slice(0, 8).map((t: any) => (
                                <a href={`/?q=${encodeURIComponent(t.word)}`}>{t.word}</a>
                            ))}
                        </div>
                    </div>
                )}

				{leadCluster && (
					<div class="section-wrapper lead-wrapper">
						<LeadHero
							leadCluster={leadCluster}
							leadTitle={leadTitle}
							leadTitleIsCyrillic={leadTitleIsCyrillic}
							leadSignal={leadSignal}
							leadSummary={leadSummary}
							leadSummaryIsCyrillic={leadSummaryIsCyrillic}
							leadVisual={leadVisual}
							dominantColor={leadCluster.dominant_color}
							getTimeStr={getTimeStr}
						/>
					</div>
				)}

				{clusters.length > 6 && (
					<div class="section-wrapper">
						<HomeLiveUpdatesIsland client:load excludeClusterIds={excludedClusterIds} initialClusters={liveNowClusters} />
					</div>
				)}

				<AdUnit slot="home_top" />

				{leadCluster && supportingClusters.length > 0 && (
					<div class="section-wrapper">
						<SupportingBand 
							supportingFeatured={supportingFeatured}
							supportingCompact={supportingCompact}
						/>
					</div>
				)}

				{globalClusters.length > 0 && (
					<div class="section-wrapper">
						<DevelopmentsSection
							title="Глобален Пулс"
							note="Најважните светски вести од Америка и Германија."
							developmentsFeatured={globalClusters.slice(0, 2)}
							developmentsCompact={globalClusters.slice(2)}
						/>
					</div>
				)}

				<div class="pulse-stats-bar">
					<div class="p-stat"><span>Плурализам</span><strong>{(stats?.intelligence?.pluralism?.pluralism_pct || 0)}%</strong></div>
					<div class="p-stat"><span>Синтеза</span><strong>{(stats?.intelligence?.ai_transparency?.ai_ratio || 0)}%</strong></div>
					<div class="p-stat"><span>Извори</span><strong>{stats?.total_feeds || 0}</strong></div>
					<div class="p-stat"><span>Објави/24ч</span><strong>{stats?.last_24h || 0}</strong></div>
				</div>

				{feedClusters.length > 0 && (
					<div class="section-wrapper">
						<DevelopmentsSection
							title="Теми во развој"
							note="Приказни што ја обликуваат јавната дебата."
							developmentsFeatured={developmentsFeatured}
							developmentsCompact={developmentsCompact}
						/>
					</div>
				)}

                {clusters.length > 4 && (
					<div class="section-wrapper">
					    <ForYouIsland client:visible clusters={forYouClusters} excludeClusterIds={excludedClusterIds} />
                    </div>
				)}

				{wireClusters.length > 0 && (
					<div class="section-wrapper">
						<DevelopmentsSection
							title="Најнови вести"
							note="Свежи поединечни објави."
							developmentsFeatured={wireClusters}
							developmentsCompact={[]}
							variant="wire"
						/>
					</div>
				)}
			</div>

			<aside class="broadsheet-rail">
                <section class="rail-block">
                    <div class="rail-head-red">
                        <Activity size={12} strokeWidth={3} />
                        <h3>ПОСЛЕДНО НА ПРЕСЕК</h3>
                    </div>
                    <div class="rail-wire-list">
                        {wireArticles.slice(0, 10).map((art: any) => (
                            <a href={`/cluster/${art.cluster_id}`} class="rail-wire-item">
                                <p>{cleanAndDecode(art.title)}</p>
                                <div class="rail-wire-meta">{art.source} <span>·</span> {getTimeStr(art.created_at)}</div>
                            </a>
                        ))}
                    </div>
                    <a href="/pulse" class="rail-cta-plain">СИТЕ ВЕСТИ</a>
                </section>

				{briefing && briefing.content && (
					<section class="rail-block rail-block-alt">
						<p class="rail-kicker">Брифинг</p>
						<h3 class="rail-title">КЛУЧНО ЗА ДЕНЕС</h3>
						<p class="rail-brief-text">
							{getBriefingSnippet(briefing.content)}
						</p>
						<a href="/briefing" class="rail-cta">ЦЕЛОСЕН ПРЕГЛЕД <TrendingUp size={10} /></a>
					</section>
				)}

				<HomeRailSuggestionsIsland client:visible />

				<NewsletterIsland client:visible />

				{stats?.quote_of_the_day && (
					<section class="rail-block">
						<p class="rail-kicker">Цитат на денот</p>
						<blockquote class="rail-quote-block">
							<p>"{stats.quote_of_the_day.quote}"</p>
							<cite>
                                <span>Поврзана вест</span>
								<a href={`/cluster/${stats.quote_of_the_day.cluster_id}`}>
									{stats.quote_of_the_day.title}
								</a>
							</cite>
						</blockquote>
					</section>
				)}

				<section class="rail-block rail-block-quiet">
					<p class="rail-kicker">Теми во фокус</p>
					<div class="rail-tag-cloud">
						{focusEntities.map((ent: any) => (
							<a href={`/subjekt/${encodeURIComponent(ent.name)}`}>
								{ent.name}
							</a>
						))}
					</div>
				</section>
			</aside>
		</div>
	</main>

	<Footer />
</Layout>

<style>
    /* ── Broadsheet Layout ───────────────────────────── */
    .broadsheet-layout { background: var(--background); }
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
    
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 3rem; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 2rem; }
        .broadsheet-rail { position: sticky; top: 7rem; align-self: start; }
    }

    /* ── Section Dividers ────────────────────────────── */
    .section-wrapper { border-bottom: 1px solid var(--border); padding-bottom: 2rem; margin-bottom: 2rem; }
    .section-wrapper:last-child { border-bottom: none; }
    .lead-wrapper { padding-bottom: 1.5rem; margin-bottom: 1.5rem; }

    /* ── Filtering Status ─────────────────────────────── */
    .filter-header { padding: 2rem 0; border-bottom: 3px solid var(--foreground); }
    .filter-kicker { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.15em; color: var(--muted-foreground); margin-bottom: 0.4rem; }
    .filter-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; italic: true; line-height: 1; margin: 0 0 1.25rem; }
    .filter-meta-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
    .filter-chips { display: flex; gap: 0.5rem; }
    .filter-chip { padding: 0.35rem 0.65rem; border: 1px solid var(--border); font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase; color: var(--muted-foreground); }
    .system-status { display: flex; align-items: center; gap: 0.4rem; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; color: var(--nyt-accent); }
    .clear-filter { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; color: var(--foreground); text-decoration: none; display: flex; align-items: center; gap: 0.3rem; }

    /* ── Broadsheet Rail ──────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 4px; }
    .rail-block-quiet { opacity: 0.85; }
    
    .rail-head-red { display: flex; align-items: center; gap: 0.5rem; color: var(--nyt-red); margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
    .rail-head-red h3 { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; letter-spacing: 0.08em; }
    
    .rail-wire-item { display: block; padding: 0.85rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--foreground); }
    .rail-wire-item:last-child { border-bottom: none; }
    .rail-wire-item p { font-family: var(--font-serif); font-size: 0.86rem; font-weight: 750; line-height: 1.3; margin-bottom: 0.35rem; }
    .rail-wire-meta { font-family: var(--font-sans); font-size: 0.58rem; font-weight: 800; text-transform: uppercase; color: var(--muted-foreground); }
    .rail-wire-meta span { opacity: 0.5; margin: 0 0.3rem; }
    .rail-wire-item:hover p { color: var(--nyt-accent); text-decoration: underline; }

    .rail-kicker { font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; text-transform: uppercase; color: var(--nyt-accent); letter-spacing: 0.1em; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
    .rail-brief-text { font-family: var(--font-serif); font-size: 0.88rem; line-height: 1.5; color: var(--secondary-foreground); font-style: italic; margin-bottom: 1rem; }
    .rail-cta { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; color: var(--nyt-accent); text-decoration: none; border-bottom: 1px solid transparent; }
    .rail-cta:hover { border-bottom-color: var(--nyt-accent); }
    .rail-cta-plain { display: block; text-align: center; padding: 0.5rem; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; color: var(--muted-foreground); text-decoration: none; }

    .rail-quote-block p { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; font-style: italic; line-height: 1.4; margin-bottom: 1rem; }
    .rail-quote-block cite { display: block; border-top: 1px solid var(--border); padding-top: 0.75rem; font-style: normal; }
    .rail-quote-block cite span { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 800; text-transform: uppercase; display: block; color: var(--muted-foreground); margin-bottom: 0.25rem; }
    .rail-quote-block cite a { font-family: var(--font-serif); font-size: 0.72rem; font-weight: 800; color: var(--foreground); text-decoration: none; line-height: 1.2; display: block; }
    .rail-quote-block cite a:hover { color: var(--nyt-accent); }

    .rail-tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }
