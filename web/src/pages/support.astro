---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PresekRailAd from '../components/PresekRailAd.astro';
import { Heart, Coffee, ShieldCheck, Cpu, Globe } from 'lucide-react';
---

<Layout
    title="Подржите пројекат — Пресек"
    description="Пресек је независни сервис за вести. Помозите нам да сачувамо чисту информисаност."
    robots="noindex, follow"
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">ПОДРШКА И ЗАЈЕДНИЦА</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Подржите <span>Пресек</span></h1>
            </div>
            <p class="masthead-intro">
                Ми смо независни пројекат посвећен чистој и објективној информисаности кроз технологију. Ваш допринос директно омогућава опстанак овог сервиса.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">
                        Пресек ради без претплата и без агресивних реклама. Да би платформа остала бесплатна, брза и стално доступна свим грађанима, ослањамо се на заједницу која користи и вреднује наш рад.
                    </p>

                    <div class="support-pillars my-12">
                        <div class="pillar">
                            <Cpu size={24} className="text-nyt-accent" />
                            <h3>СИСТЕМСКА ОБРАДА</h3>
                            <p>Одржавање напредног система за аутономну анализу и синтезу хиљада објава дневно.</p>
                        </div>
                        <div class="pillar">
                            <Globe size={24} className="text-nyt-accent" />
                            <h3>ИНФРАСТРУКТУРА</h3>
                            <p>Одржавање брзих и сигурних сервера за тренутни приступ информацијама.</p>
                        </div>
                        <div class="pillar">
                            <ShieldCheck size={24} className="text-nyt-accent" />
                            <h3>НЕЗАВИСНОСТ</h3>
                            <p>Очување уредничке неутралности и отпорност на спољне притиске.</p>
                        </div>
                    </div>

                    <div class="support-box">
                        <div class="support-box-content">
                            <Coffee size={40} className="text-[#ff5e5b] mb-6" />
                            <h2 class="font-serif text-3xl font-black mb-4">Постаните подржавалац</h2>
                            <p class="text-lg opacity-80 mb-10">Сваки допринос је важан. Подржите нас једним „кафем“ преко Ko-fi платформе.</p>

                            <a href="https://ko-fi.com/presek" target="_blank" rel="noopener noreferrer" class="support-cta">
                                <img src="https://ko-fi.com/img/cup-border.png" alt="" class="h-6" />
                                <span>ЧАСТИТЕ КАФУ НА KO-FI</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>

            <aside class="broadsheet-rail">
                <PresekRailAd />

                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Зашто сада?</p>
                    <h3 class="rail-title">МИСИЈА</h3>
                    <p class="rail-text">Дигиталном јавном простору су потребни алати који уносе ред, а не хаос. Пресек је наш допринос том циљу.</p>
                </section>

                <div class="rail-meta-box">
                    <p class="text-[10px] font-black uppercase tracking-widest mb-4 opacity-50">БЕЗБЕДНОСТ</p>
                    <p class="text-xs leading-relaxed">Донације се обрађују преко Ko-fi (Stripe/PayPal) и 100% су намењене развоју и одржавању Presek.rs.</p>
                </div>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; margin-bottom: 3rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; font-style: italic; }
    .masthead-intro { font-family: var(--font-nyt-body); font-size: 1.15rem; line-height: 1.6; color: var(--secondary-foreground); max-width: 42rem; }

    /* ── Broadstreet Layout ───────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { align-self: start; }
    }

    /* ── Prose & Content ─────────────────────────────── */
    .prose-editorial { font-family: var(--font-nyt-body); font-size: 1.1rem; line-height: 1.75; color: var(--secondary-foreground); }
    .first-paragraph::first-letter { float: left; font-family: var(--font-serif); font-size: 5rem; font-weight: 900; line-height: 0.8; padding-top: 0.5rem; padding-right: 0.75rem; color: var(--foreground); }

    .support-pillars { display: grid; grid-template-columns: 1fr; gap: 2rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 3rem 0; }
    @media (min-width: 640px) { .support-pillars { grid-template-columns: repeat(3, 1fr); } }
    .pillar h3 { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 950; letter-spacing: 0.1em; margin: 1rem 0 0.5rem; color: var(--foreground); }
    .pillar p { font-size: 0.85rem; line-height: 1.5; margin: 0; }

    .support-box { padding: 4rem 2rem; border: 1px solid var(--border); background: var(--secondary); text-align: center; }
    .support-cta { display: inline-flex; align-items: center; gap: 0.75rem; padding: 1.25rem 2.5rem; background: #ff5e5b; color: white; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 950; letter-spacing: 0.1em; text-decoration: none; border-radius: 0px; transition: transform 0.2s, background 0.2s; }
    .support-cta:hover { transform: scale(1.02); background: #e54b48; }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.25rem; background: var(--secondary); border-radius: 0px; }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-text { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }
    .rail-meta-box { padding: 1.5rem; border: 1px solid var(--border); }

    @media (max-width: 639.98px) {
        .editorial-masthead {
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
            border-bottom-width: 3px;
        }

        .masthead-kicker {
            font-size: 0.52rem;
            letter-spacing: 0.12em;
        }

        .masthead-title {
            font-size: clamp(1.95rem, 9vw, 2.7rem);
            line-height: 0.95;
            margin: 0.75rem 0;
        }

        .masthead-intro {
            font-size: 0.96rem;
            line-height: 1.5;
        }

        .broadsheet-grid {
            gap: 1.5rem;
        }

        .prose-editorial {
            font-size: 0.96rem;
            line-height: 1.6;
        }

        .first-paragraph::first-letter {
            font-size: 3.4rem;
            padding-top: 0.2rem;
            padding-right: 0.45rem;
        }

        .support-pillars {
            gap: 1rem;
            padding: 1.5rem 0;
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .pillar h3 {
            font-size: 0.6rem;
            letter-spacing: 0.08em;
            margin: 0.75rem 0 0.35rem;
        }

        .pillar p {
            font-size: 0.86rem;
            line-height: 1.42;
        }

        .support-box {
            padding: 1.5rem 1rem;
        }

        .support-box-content svg {
            width: 1.9rem;
            height: 1.9rem;
            margin-bottom: 0.9rem !important;
        }

        .support-box h2 {
            font-size: 1.5rem !important;
            margin-bottom: 0.6rem !important;
        }

        .support-box p.text-lg {
            font-size: 0.94rem !important;
            line-height: 1.45 !important;
            margin-bottom: 1.25rem !important;
        }

        .support-cta {
            gap: 0.65rem;
            padding: 0.85rem 1rem;
            font-size: 0.62rem;
            letter-spacing: 0.08em;
            border-radius: 0px;
            width: 100%;
            justify-content: center;
        }

        .support-cta img {
            height: 1.1rem;
        }

        .rail-block {
            margin-bottom: 1rem;
        }

        .rail-block-alt,
        .rail-meta-box {
            padding: 1rem;
        }

        .rail-kicker {
            font-size: 0.54rem;
            margin-bottom: 0.35rem;
        }

        .rail-title {
            font-size: 0.68rem;
            padding-bottom: 0.4rem;
            margin-bottom: 0.7rem;
        }

        .rail-text {
            font-size: 0.88rem;
            line-height: 1.42;
        }

        .rail-meta-box p.text-\[10px\] {
            font-size: 0.56rem !important;
            letter-spacing: 0.12em !important;
            margin-bottom: 0.6rem !important;
        }

        .rail-meta-box p.text-xs {
            font-size: 0.82rem !important;
            line-height: 1.42 !important;
        }
    }
</style>
