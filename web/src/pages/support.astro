---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Heart, Coffee, ShieldCheck, Cpu, Globe } from 'lucide-react';
---

<Layout 
    title="Поддржи го проектот" 
    description="Пресек е независен сервис за вести. Помогнете ни да ги покриеме трошоците за AI и серверите."
>
    <NYTHeader />
    <main class="site-layout py-[var(--page-py)]">
        <Breadcrumbs items={[{ label: "Поддршка" }]} />
        
        <article class="max-w-3xl mx-auto py-12">
            <header class="text-center mb-16">
                <div class="inline-flex items-center justify-center p-4 bg-nyt-accent/10 rounded-full mb-6">
                    <Heart className="text-nyt-accent animate-pulse" size={32} />
                </div>
                <h1 class="font-serif text-4xl md:text-5xl font-black mb-4">Поддржи го <span class="italic">Пресек</span></h1>
                <p class="text-xl text-secondary-foreground font-nyt-body leading-relaxed">
                    Ние сме независен проект посветен на чиста и објективна информираност преку технологија.
                </p>
            </header>

            <div class="prose-nyt mb-12">
                <p class="text-lg leading-relaxed">
                    Пресек работи без претплати и без агресивни реклами. За да платформата остане бесплатна, брза и постојано достапна, се потпираме на заедницата која ја користи.
                </p>
                <p class="text-lg leading-relaxed">
                    Вашата донација директно помага во:
                </p>
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-10 not-prose">
                    <div class="p-5 border border-border bg-card rounded-xl">
                        <Cpu className="text-nyt-accent mb-2" size={20} />
                        <h3 class="font-bold mb-1 uppercase text-[10px] tracking-widest">AI Модели</h3>
                        <p class="text-[12px] text-secondary-foreground leading-snug">Обработка на илјадници објави дневно.</p>
                    </div>
                    <div class="p-5 border border-border bg-card rounded-xl">
                        <Globe className="text-nyt-accent mb-2" size={20} />
                        <h3 class="font-bold mb-1 uppercase text-[10px] tracking-widest">Инфраструктура</h3>
                        <p class="text-[12px] text-secondary-foreground leading-snug">Брзи сервери за моментално вчитување.</p>
                    </div>
                    <div class="p-5 border border-border bg-card rounded-xl">
                        <ShieldCheck className="text-nyt-accent mb-2" size={20} />
                        <h3 class="font-bold mb-1 uppercase text-[10px] tracking-widest">Независност</h3>
                        <p class="text-[12px] text-secondary-foreground leading-snug">Отпорност на надворешни притисоци.</p>
                    </div>
                </div>
            </div>

            <div class="relative overflow-hidden p-1 bg-gradient-to-br from-[#ff5e5b] to-[#ff8a71] rounded-3xl shadow-2xl transition-transform hover:scale-[1.01]">
                <div class="bg-card rounded-[calc(1.5rem-1px)] p-8 md:p-12 text-center relative z-10">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-[#ff5e5b]/10 rounded-2xl mb-6">
                        <Coffee className="text-[#ff5e5b]" size={32} />
                    </div>
                    
                    <h2 class="font-serif text-3xl md:text-4xl font-black mb-4">Стани поддржувач на Пресек</h2>
                    <p class="max-w-md mx-auto mb-10 text-secondary-foreground leading-relaxed">
                        Секој придонес е значаен за опстанокот на овој дигитален јавен сервис. Поддржете нѐ со еднократно „кафе“ или месечна претплата.
                    </p>
                    
                    <div class="flex flex-col items-center gap-6">
                        <a 
                            href="https://ko-fi.com/presek" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="group relative inline-flex items-center gap-3 px-10 py-5 bg-[#ff5e5b] text-white font-black text-sm uppercase tracking-widest rounded-full transition-all hover:bg-[#e54b48] hover:shadow-[0_0_30px_rgba(255,94,91,0.4)]"
                        >
                            <img src="https://ko-fi.com/img/cup-border.png" alt="Ko-fi" class="h-6 w-auto brightness-0 invert transition-transform group-hover:rotate-12" />
                            <span>Чести кафе на Ko-fi</span>
                        </a>
                        
                        <div class="flex items-center gap-8 py-4 px-8 border border-border/50 rounded-2xl bg-secondary/5">
                            <div class="text-center">
                                <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-1">Безбедно</p>
                                <p class="text-[11px] font-bold">Stripe / PayPal</p>
                            </div>
                            <div class="w-px h-6 bg-border/50"></div>
                            <div class="text-center">
                                <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-1">Директно</p>
                                <p class="text-[11px] font-bold">100% за проектот</p>
                            </div>
                        </div>
                    </div>
                    
                    <p class="mt-8 text-[10px] text-muted-foreground uppercase font-black tracking-[0.2em] opacity-60">
                        Официјална страница за поддршка • Ko-fi.com/presek
                    </p>
                </div>
                
                {/* Decorative background elements */}
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-[#ff5e5b]/10 rounded-full blur-3xl pointer-events-none"></div>
            </div>
        </article>
    </main>
    <Footer />
</Layout>
