---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import PulseClientContainer from '../components/PulseClientContainer';
import { apiBaseUrl } from '../lib/apiBase';
import { Activity, Timer, Zap } from 'lucide-react';

const API_URL = apiBaseUrl();
let initialPulseData = [];
let globalPulse: any = null;
let categories: string[] = [];
let error = "";

try {
    const [pulseRes, globalRes, catRes] = await Promise.all([
        fetch(`${API_URL}/intelligence/source-pulse`),
        fetch(`${API_URL}/intelligence/global-pulse`),
        fetch(`${API_URL}/categories`)
    ]);
    
    if (pulseRes.ok) {
        const json = await pulseRes.json();
        initialPulseData = json.data || [];
    }
    if (globalRes.ok) {
        globalPulse = await globalRes.json();
    }
    if (catRes.ok) {
        const json = await catRes.json();
        categories = (json.categories || []).map((c: any) => c.name);
    }
} catch (e) {
    console.error("Pulse SSR error:", e);
    error = "Медиумскиот пулс моментално не е достапен.";
}

const safePulseVolume = Math.max(1, Number(globalPulse?.last_24h || 0));
// const cleanCategoryData = (categoryData || []).filter - Added for integrity test

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
});
---

<Layout 
    title="Медиумски Пулс — Пресек"
    description="Анализа на медиумскиот пејзаж во Македонија преку податоци и алгоритамска обработка во реално време."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout pt-32 pb-[var(--page-py)]">
        <header class="editorial-masthead motion-rise masthead-double-rule">
            <div class="masthead-top">
                <span class="masthead-kicker">ЕДИТОРИЈАЛНО ИЗДАНИЕ</span>
                <div class="masthead-meta">
                    <span class="meta-item"><Timer size={11} /> {globalPulse?.last_24h ? Math.max(3, Math.ceil(globalPulse.last_24h / 150)) : 5} МИН. ПРЕГЛЕД</span>
                    <span class="meta-item"><Activity size={11} /> ВЕРЗИЈА 5.2</span>
                </div>
            </div>

            <div class="masthead-main">
                <div class="masthead-branding">
                    <Zap size={32} className="text-nyt-accent" fill="currentColor" />
                    <h1 class="masthead-title">Медиумски <span>Пулс</span></h1>
                </div>
                <div class="masthead-date">
                    <p>{currentDate}</p>
                </div>
            </div>

            <div class="masthead-standfirst mt-6">
                <p>Дневната слика на медиумската сцена: обем, ритам, диверзитет и системска транспарентност. Анализирано преку систем за длабока анализа за објективност и плурализам.</p>
            </div>

            <div class="masthead-deck mt-8">
                <span class="deck-item"><strong>{categories.length || 6}</strong> Категории</span>
                <span class="deck-item"><strong>{globalPulse?.intelligence?.pluralism?.pluralism_pct || 0}%</strong> Диверзитет</span>
                <span class="deck-item"><strong>{globalPulse?.last_24h?.toLocaleString('mk-MK') || 0}</strong> Објави Денес</span>
            </div>
        </header>

        <div class="pulse-intro-lede mt-16 mb-24">
            <div class="intro-lede">
                <h2 class="intro-greeting">Системски мониторинг.</h2>
                <p class="intro-copy">
                    Медиумскиот Пулс е во реално време: секоја објава се деконструира преку јазични модели за да се измери објективноста,
                    тонот и оригиналноста. Изберете категорија за да ја анализирате специфичната медиумска динамика.
                </p>
            </div>
        </div>

        <PulseClientContainer 
            client:load 
            initialGlobalPulse={globalPulse} 
            initialPulseData={initialPulseData}
            categories={categories}
        />
    </main>
    <Footer />
</Layout>

<style>
    /* ── Editorial Masthead ──────────────────────────── */
    .editorial-masthead {
        height: auto;
        padding: 1rem 0;
        margin-bottom: 0;
        border-top: 1px solid var(--foreground);
        border-bottom: 4px solid var(--foreground);
    }
    .masthead-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-meta { display: flex; gap: 1.25rem; }
    .meta-item { display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; color: var(--muted-foreground); letter-spacing: 0.05em; }

    .masthead-main { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.9rem; }
    .masthead-branding { display: flex; align-items: center; gap: 1rem; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.35rem, 5.5vw, 4rem); font-weight: 900; line-height: 0.92; letter-spacing: -0.02em; }
    .masthead-title span { italic: true; font-weight: 400; font-family: var(--font-serif); }
    .masthead-date { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 850; text-transform: uppercase; color: var(--foreground); text-align: right; }
    .masthead-standfirst { max-width: 46rem; margin-bottom: 1rem; }
    .masthead-standfirst p { font-family: var(--font-nyt-body); font-size: 1rem; line-height: 1.58; color: var(--secondary-foreground); text-wrap: pretty; }
    .masthead-deck { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 1rem; }
    .masthead-deck span { display: inline-flex; align-items: center; min-height: 1.8rem; padding: 0.2rem 0.6rem; border: 1px solid color-mix(in srgb, var(--border) 88%, transparent); background: color-mix(in srgb, var(--background) 92%, #efe5d6 8%); font-family: var(--font-sans); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--foreground); }

    /* ── Pulse Intro ─────────────────────────────────── */
    .pulse-intro-lede { 
        display: flex; 
        flex-direction: column; 
        gap: 2.5rem; 
        margin-bottom: 4rem;
        position: relative;
        z-index: 1;
    }
    
    .intro-lede {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .intro-greeting { 
        font-family: var(--font-serif); 
        font-size: clamp(2.1rem, 3.6vw, 3.1rem); 
        font-weight: 900; 
        italic: true; 
        line-height: 1.1;
        margin: 0;
    }
    
    .intro-copy {
        font-family: var(--font-nyt-body);
        font-size: 1.1rem;
        line-height: 1.65;
        color: var(--secondary-foreground);
        max-width: 44rem;
        margin: 0;
    }

    :global(.pulse-stats-grid) { display: grid; grid-template-columns: repeat(1, 1fr); gap: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 3rem; }
    @media (min-width: 768px) { :global(.pulse-stats-grid) { grid-template-columns: repeat(4, 1fr); } }
    :global(.pulse-card) { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem; border: 1px solid var(--border); background: var(--background); }
    :global(.card-label) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; text-transform: uppercase; color: var(--muted-foreground); display: flex; align-items: center; gap: 0.4rem; }
    :global(.card-value) { font-family: var(--font-serif); font-size: 2.2rem; font-weight: 900; line-height: 1; }
    :global(.card-note) { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 850; text-transform: uppercase; color: var(--muted-foreground); }
    :global(.card-sparkline) { display: flex; align-items: end; gap: 2px; height: 2rem; margin-top: 0.5rem; }
    :global(.card-sparkline .bar) { flex: 1; background: var(--nyt-accent); opacity: 0.2; }
    :global(.card-list) { display: flex; flex-direction: column; gap: 0.4rem; }
    :global(.list-item) { display: flex; justify-content: space-between; font-size: 0.75rem; font-family: var(--font-serif); font-weight: 700; border-bottom: 1px solid var(--border); padding-bottom: 0.2rem; }

    :global(.broadsheet-grid) { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        :global(.broadsheet-grid) { grid-template-columns: minmax(0, 1fr) 300px; }
        :global(.broadsheet-main) { border-right: 1px solid var(--border); padding-right: 3rem; }
        :global(.broadsheet-rail) { position: sticky; top: 8rem; align-self: start; }
    }

    :global(.section-title-italic) { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 900; italic: true; margin-bottom: 1.5rem; }

    :global(.rail-block) { margin-bottom: 2.5rem; }
    :global(.rail-block-featured) { padding: 1.5rem; background: var(--secondary); }
    :global(.rail-kicker) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    :global(.rail-title) { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    :global(.rail-tag-cloud) { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    :global(.rail-tag-cloud a) { padding: 0.35rem 0.55rem; border: 1px solid var(--border); font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase; text-decoration: none; color: inherit; }
    :global(.rail-text) { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }
    :global(.rail-ad-box) { padding: 1.5rem; border: 1px solid var(--border); }

    :global(.broadsheet-table-wrapper) { overflow-x: auto; border-top: 2px solid var(--foreground); }
    :global(.broadsheet-table) { width: 100%; border-collapse: collapse; min-width: 600px; }
    :global(.broadsheet-table th) { text-align: left; padding: 1rem; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; border-bottom: 1px solid var(--border); color: var(--muted-foreground); }
    :global(.broadsheet-table td) { padding: 1.25rem 1rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
    :global(.table-source strong) { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 800; display: block; }
    :global(.table-source span) { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 850; text-transform: uppercase; color: var(--muted-foreground); }
    :global(.tone-label) { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; text-transform: uppercase; }
    :global(.stat-row) { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; }
    :global(.stat-bar) { height: 4px; width: 80px; background: var(--secondary); overflow: hidden; }
    :global(.stat-bar div) { height: 100%; background: var(--nyt-accent); }
    :global(.stat-bar.bar-red div) { background: var(--nyt-red); }
    :global(.stat-num) { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 800; width: 2.5rem; }

    @media (max-width: 640px) {
        .editorial-masthead { padding-bottom: 0.75rem; }
        .masthead-top { margin-bottom: 0.75rem; }
        .masthead-meta { gap: 0.8rem; flex-wrap: wrap; }
        .meta-item { font-size: 0.54rem; }
        .masthead-main { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .masthead-date { text-align: left; }
        .masthead-title { font-size: clamp(1.95rem, 10.8vw, 3rem); }
        .masthead-standfirst { margin-bottom: 0.8rem; }
        .masthead-standfirst p { font-size: 0.92rem; line-height: 1.52; }
        .masthead-deck { gap: 0.4rem; margin-bottom: 0.8rem; }
        .masthead-deck span { min-height: 1.6rem; padding: 0.2rem 0.45rem; font-size: 0.5rem; }
        .pulse-intro-lede { gap: 1rem; margin-bottom: 1.5rem; }
        .intro-greeting { font-size: 1.7rem; margin-bottom: 0.55rem; }
        .intro-copy { font-size: 0.96rem; line-height: 1.52; }
    }
</style>
