---
// This is the Serbian (default) Pulse page.
// The Macedonian version is at /mk/pulse.astro
// We keep this here for presek.live and root-level /pulse access.

import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import PulseClientContainer from '../components/PulseClientContainer';

import { apiBaseUrl } from '../lib/apiBase';
import { getLangFromUrl } from '../i18n/utils';
import { Activity, Timer, Zap, Cpu } from 'lucide-react';

const API_URL = apiBaseUrl();
const lang = getLangFromUrl(Astro.url);
const isMK = lang === 'mk';

// Force redirect presek.mk/pulse to /mk/pulse to ensure consistent localized routing
if ((Astro.url.hostname === 'presek.mk' || Astro.url.hostname === 'www.presek.mk') && !Astro.url.pathname.startsWith('/mk/')) {
    return Astro.redirect('/mk/pulse');
}

let initialPulseData = null;
let globalPulse: any = null;
let categories: string[] = [];
let ssrFailed = false;

try {
    const [pulseRes, globalRes, catRes] = await Promise.all([
        fetch(`${API_URL}/intelligence/source-pulse?lang=${lang}`),
        fetch(`${API_URL}/intelligence/global-pulse?lang=${lang}`),
        fetch(`${API_URL}/categories?lang=${lang}`)
    ]);

    if (pulseRes.ok) {
        const json = await pulseRes.json();
        initialPulseData = json.data || [];
    } else {
        ssrFailed = true;
    }

    if (globalRes.ok) {
        globalPulse = await globalRes.json();
    } else {
        ssrFailed = true;
    }

    if (catRes.ok) {
        const json = await catRes.json();
        categories = (json.categories || []).map((c: any) => c.name);
    }
} catch (e) {
    console.error("Pulse SSR error:", e);
    ssrFailed = true;
}

const currentDate = new Date().toLocaleDateString(lang === 'mk' ? 'mk-MK' : 'sr-RS', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Belgrade'
});

const siteTitle = isMK ? 'Медиумски Пулс' : 'Medijski Puls';
---

<Layout
    title={`${siteTitle} — Presek`}
    description={isMK ? "Анализа на медиумскиот пејзаж преку податоци и алгоритми." : "Analiza medijskog pejzaža kroz podatke i algoritamsku obradu."}
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout pt-24 pb-[var(--page-py)] overflow-x-hidden">

        {/* 1. SYSTEM STATUS BAR (REAL-TIME COMMAND CENTER) */}
        <div class="system-status-bar mb-12">
            <div class="status-inner">
                <div class="status-group group-glow">
                    <div class="pulse-indicator pulse-emerald"></div>
                    <span class="status-label">{isMK ? 'СИСТЕМСКИ СИГНАЛ' : 'SISTEMSKI SIGNAL'}</span>
                    <span class="status-value">{isMK ? 'АКТИВЕН' : 'AKTIVAN'}</span>
                </div>
                <div class="status-group divider-left">
                    <Cpu size={10} className="text-muted-foreground" />
                    <span class="status-label">{isMK ? 'AI МОДЕЛИ' : 'AI MODELI'}</span>
                    <span class="status-value">Gemma 2 / Mistral</span>
                </div>
                <div class="status-group divider-left hide-mobile">
                    <Zap size={10} className="text-nyt-accent" />
                    <span class="status-label">{isMK ? 'ИНГЕСТИЈА' : 'INGESTIJA'}</span>
                    <span class="status-value">{globalPulse?.ingestion_rate || '0.0'} {isMK ? 'арт/мин' : 'art/min'}</span>
                </div>
                <div class="status-group divider-left ml-auto">
                    <Timer size={10} className="text-muted-foreground" />
                    <span class="status-value tabular-nums" id="system-time">00:00:00</span>
                </div>
            </div>
        </div>

        <header class="editorial-masthead motion-rise masthead-double-rule">
            <div class="masthead-top">
                <span class="masthead-kicker">{isMK ? 'ЕДИТОРИЈАЛНО ИЗДАНИЕ' : 'EDITORIJALNO IZDANJE'}</span>
                <div class="masthead-meta">
                    <span class="meta-item">
                        <svg class="live-heartbeat mr-1" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2 12H5L9 4L15 20L19 12H22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <animate attributeName="stroke-dasharray" from="0, 50" to="50, 0" dur="2s" repeatCount="indefinite" />
                            </path>
                        </svg>
                        <Timer size={11} /> <span id="last-updated" data-is-mk={isMK ? "true" : "false"}>{isMK ? 'ВО ЖИВО' : 'UŽIVO'}</span>
                    </span>
                    <span class="meta-item"><Activity size={11} /> V.2.1-CC</span>
                </div>
            </div>

            <script is:inline>
                const lastUpdatedEl = document.getElementById('last-updated');
                const isMK = lastUpdatedEl?.getAttribute('data-is-mk') === 'true';
                const startTime = new Date();

                function updateClock() {
                    const now = new Date();
                    const diffMins = Math.floor((now - startTime) / 60000);
                    if (diffMins === 0) {
                        lastUpdatedEl.textContent = isMK ? 'ВО ЖИВО' : 'UŽIVO';
                    } else {
                        lastUpdatedEl.textContent = isMK ? `ПРЕД ${diffMins} МИН.` : `PRE ${diffMins} MIN.`;
                    }
                }

                updateClock();
                setInterval(updateClock, 60000);
            </script>

            <div class="masthead-main">
                <div class="masthead-branding">
                    <Zap size={32} className="text-nyt-accent pulse-zap-icon" fill="currentColor" />
                    <h1 class="masthead-title">{isMK ? 'Медиумски' : 'Medijski'} <span class="italic-serif">Puls</span></h1>
                </div>
                <div class="masthead-date">
                    <p>{currentDate}</p>
                </div>
            </div>

            <div class="masthead-standfirst mt-6">
                <p>{isMK ? 'Дневна слика на медиумскиот пејзаж: обем, ритам, диверзитет и системска транспарентност. Анализирано преку систем за длабока анализа за објективност и плурализам.' : 'Dnevna slika medijskog pejzaža: obim, ritam, diverzitet i sistemska transparentnost. Analizirano kroz sistem duboke analize za objektivnost i pluralizam.'}</p>
            </div>

            <div class="masthead-deck mt-8">
                <span class="deck-item"><strong class="mr-1.5">{categories.length || '–'}</strong> {isMK ? 'Категории' : 'Kategorije'}</span>
                <span class="deck-item"><strong class="mr-1.5">{globalPulse?.intelligence?.pluralism?.pluralism_pct > 0 ? globalPulse?.intelligence?.pluralism?.pluralism_pct + '%' : '–'}</strong> {isMK ? 'Диверзитет' : 'Diverzitet'}</span>
                <span class="deck-item"><strong class="mr-1.5">{globalPulse?.last_24h?.toLocaleString(isMK ? 'mk-MK' : 'sr-RS') || '–'}</strong> {isMK ? 'Објави денес' : 'Objava danas'}</span>
            </div>
        </header>

        <PulseClientContainer
            client:load
            initialGlobalPulse={globalPulse}
            initialPulseData={initialPulseData || []}
            categories={categories}
            ssrFailed={ssrFailed}
            lang={lang}
        />

    </main>
    <Footer />
</Layout>

<style>
    /* ── System Status Bar ──────────────────────────── */
    .system-status-bar {
        background: var(--foreground);
        color: var(--background);
        padding: 0.5rem 1rem;
        border-radius: 0px;
        font-family: var(--font-sans);
    }
    .status-inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .status-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .divider-left {
        border-left: 1px solid rgba(255,255,255,0.1);
        padding-left: 1.5rem;
    }
    .status-label {
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        opacity: 0.5;
    }
    .status-value {
        font-size: 0.6rem;
        font-weight: 850;
        letter-spacing: 0.05em;
    }
    .pulse-indicator {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .pulse-emerald {
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
        animation: pulse-glow 2s infinite;
    }
    @keyframes pulse-glow {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    @media (max-width: 640px) {
        .system-status-bar {
            margin-bottom: 1.5rem;
            padding: 0.55rem 0.75rem;
        }
        .hide-mobile { display: none; }
        .status-inner {
            flex-wrap: wrap;
            gap: 0.45rem 0.8rem;
        }
        .status-group {
            gap: 0.35rem;
        }
        .divider-left {
            border-left: none;
            padding-left: 0;
        }
        .status-label {
            font-size: 0.46rem;
            letter-spacing: 0.08em;
        }
        .status-value {
            font-size: 0.52rem;
        }
    }

    /* ── Editorial Masthead ──────────────────────────── */
    .editorial-masthead {
        height: auto;
        padding: 1.5rem 0;
        margin-bottom: 3rem;
        border-top: 1px solid var(--border);
        border-bottom: 4px solid var(--foreground);
    }
    .live-heartbeat {
        color: var(--nyt-red);
    }
    .italic-serif {
        font-style: italic;
        font-weight: 400;
        color: var(--nyt-accent);
    }
    .pulse-zap-icon {
        animation: pulse-icon 2.5s infinite;
    }
    @keyframes pulse-icon {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    :global(.animate-rise) {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes rise {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .masthead-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-meta { display: flex; gap: 1.25rem; }
    .meta-item { display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; color: var(--muted-foreground); letter-spacing: 0.05em; }

    .masthead-main { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.9rem; flex-wrap: wrap; gap: 1rem; }
    .masthead-branding { display: flex; align-items: center; gap: 1rem; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 4rem); font-weight: 900; line-height: 0.92; letter-spacing: -0.02em; }
    .masthead-title span { font-style: italic; font-weight: 400; font-family: var(--font-serif); }
    .masthead-date { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 850; text-transform: uppercase; color: var(--foreground); text-align: right; }
    .masthead-standfirst { max-width: 46rem; margin-bottom: 1rem; }
    .masthead-standfirst p { font-family: var(--font-nyt-body); font-size: clamp(0.95rem, 1.5vw, 1.1rem); line-height: 1.58; color: var(--secondary-foreground); text-wrap: pretty; }
    .masthead-deck { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; }
    .masthead-deck span { display: inline-flex; align-items: center; min-height: 1.8rem; padding: 0.25rem 0.75rem; border: 1px solid color-mix(in srgb, var(--border) 88%, transparent); background: color-mix(in srgb, var(--background) 92%, #efe5d6 8%); font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; letter-spacing: 0.08em; text-transform: uppercase; color: var(--foreground); }

    @media (max-width: 640px) {
        .editorial-masthead {
            padding: 1rem 0 0.4rem;
            margin-bottom: 1.75rem;
            border-bottom-width: 3px;
        }
        .masthead-top {
            align-items: flex-start;
            gap: 0.6rem;
            margin-bottom: 0.8rem;
        }
        .masthead-meta {
            flex-direction: column;
            align-items: flex-end;
            gap: 0.35rem;
        }
        .meta-item {
            font-size: 0.5rem;
        }
        .masthead-main {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.65rem;
            margin-bottom: 0.75rem;
        }
        .masthead-branding {
            gap: 0.75rem;
        }
        .pulse-zap-icon {
            width: 1.4rem;
            height: 1.4rem;
        }
        .masthead-title { font-size: clamp(1.75rem, 8vw, 2.35rem); }
        .masthead-date {
            font-size: 0.62rem;
            text-align: left;
        }
        .masthead-standfirst {
            margin-top: 0 !important;
            margin-bottom: 0.8rem;
        }
        .masthead-standfirst p {
            font-size: 0.92rem;
            line-height: 1.5;
        }
        .masthead-deck {
            gap: 0.45rem;
            margin-top: 0 !important;
            margin-bottom: 0.2rem;
        }
        .masthead-deck span {
            min-height: 1.55rem;
            padding: 0.2rem 0.5rem;
            font-size: 0.48rem;
        }
    }
</style>
