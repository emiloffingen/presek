---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import PulseClientContainer from '../components/PulseClientContainer';
import AdsKeeperWidget from '../components/AdsKeeperWidget.astro';
import { apiBaseUrl } from '../lib/apiBase';
import { Activity, Timer, Zap } from 'lucide-react';

const API_URL = apiBaseUrl();
let initialPulseData = null;
let globalPulse: any = null;
let categories: string[] = [];
let ssrFailed = false;

try {
    const [pulseRes, globalRes, catRes] = await Promise.all([
        fetch(`${API_URL}/intelligence/source-pulse`),
        fetch(`${API_URL}/intelligence/global-pulse`),
        fetch(`${API_URL}/categories`)
    ]);
    
    if (pulseRes.ok) {
        const json = await pulseRes.json();
        initialPulseData = json.data || [];
    } else {
        ssrFailed = true;
    }

    if (globalRes.ok) {
        globalPulse = await globalRes.json();
    } else {
        ssrFailed = true;
    }

    if (catRes.ok) {
        const json = await catRes.json();
        categories = (json.categories || []).map((c: any) => c.name);
    }
} catch (e) {
    console.error("Pulse SSR error:", e);
    ssrFailed = true;
}

const safePulseVolume = Math.max(1, Number(globalPulse?.last_24h || 0));
// const cleanCategoryData = (categoryData || []).filter - Added for integrity test

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    timeZone: 'Europe/Skopje'
});
---

<Layout 
    title="Медиумски Пулс — Presek"
    description="Анализа на медиумскиот пејзаж во Македонија преку податоци и алгоритамска обработка во реално време."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout pt-32 pb-[var(--page-py)]">
        <header class="editorial-masthead motion-rise masthead-double-rule">
            <div class="masthead-top">
                <span class="masthead-kicker">ЕДИТОРИЈАЛНО ИЗДАНИЕ</span>
                <div class="masthead-meta">
                    <span class="meta-item">
                        <svg class="live-heartbeat mr-1" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2 12H5L9 4L15 20L19 12H22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <animate attributeName="stroke-dasharray" from="0, 50" to="50, 0" dur="2s" repeatCount="indefinite" />
                            </path>
                        </svg>
                        <Timer size={11} /> <span id="last-updated">ВО ЖИВО</span>
                    </span>
                    <span class="meta-item"><Activity size={11} /> ВЕРЗИЈА 5.48</span>
                </div>
            </div>
            
            <script is:inline>
                const lastUpdatedEl = document.getElementById('last-updated');
                const startTime = new Date();
                
                function updateTicker() {
                    const now = new Date();
                    const diffMins = Math.floor((now - startTime) / 60000);
                    lastUpdatedEl.textContent = diffMins === 0 ? 'ВО ЖИВО (СЕГА)' : `ПРЕД ${diffMins} ${diffMins === 1 ? 'МИН.' : 'МИН.'}`;
                }
                
                updateTicker();
                setInterval(updateTicker, 60000);
            </script>

            <div class="masthead-main">
                <div class="masthead-branding">
                    <Zap size={32} className="text-nyt-accent pulse-zap-icon" fill="currentColor" />
                    <h1 class="masthead-title">Медиумски <span class="italic-serif">Пулс</span></h1>
                </div>
                <div class="masthead-date">
                    <p>{currentDate}</p>
                </div>
            </div>

            <div class="masthead-standfirst mt-6">
                <p>Дневната слика на медиумската сцена: обем, ритам, диверзитет и системска транспарентност. Анализирано преку систем за длабока анализа за објективност и плурализам.</p>
            </div>

            <div class="masthead-deck mt-8">
                <span class="deck-item"><strong class="mr-1.5">{categories.length || '–'}</strong> Категории</span>
                <span class="deck-item"><strong class="mr-1.5">{globalPulse?.intelligence?.pluralism?.pluralism_pct > 0 ? globalPulse?.intelligence?.pluralism?.pluralism_pct + '%' : '–'}</strong> Диверзитет</span>
                <span class="deck-item"><strong class="mr-1.5">{globalPulse?.last_24h?.toLocaleString('mk-MK') || '–'}</strong> Објави Денес</span>
            </div>
        </header>

        <div class="pulse-intro-lede mt-16 mb-24">
            <div class="intro-lede">
                <h2 class="intro-greeting">Системски мониторинг.</h2>
                <p class="intro-copy">
                    Медиумскиот Пулс е во реално време: секоја објава се деконструира преку јазични модели за да се измери објективноста,
                    тонот и оригиналноста. Изберете категорија за да ја анализирате специфичната медиумска динамика.
                </p>
            </div>
        </div>

        <AdsKeeperWidget placement="in-article" class="mb-16" />

        <PulseClientContainer 
            client:load 
            initialGlobalPulse={globalPulse} 
            initialPulseData={initialPulseData || []}
            categories={categories}
            ssrFailed={ssrFailed}
        />

        <AdsKeeperWidget placement="under-article" class="mt-16" />
    </main>
    <Footer />
</Layout>

<style>
    /* ── Editorial Masthead ──────────────────────────── */
    .editorial-masthead {
        height: auto;
        padding: 1rem 0;
        margin-bottom: 0;
        border-top: 1px solid var(--foreground);
        border-bottom: 4px solid var(--foreground);
    }
    .live-heartbeat {
        color: var(--nyt-red);
    }
    .italic-serif {
        font-style: italic;
        font-weight: 400;
        color: var(--nyt-accent);
    }
    .pulse-zap-icon {
        animation: pulse-icon 2.5s infinite;
    }
    @keyframes pulse-icon {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    :global(.animate-rise) {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes rise {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .masthead-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-meta { display: flex; gap: 1.25rem; }
    .meta-item { display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; color: var(--muted-foreground); letter-spacing: 0.05em; }

    .masthead-main { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.9rem; flex-wrap: wrap; gap: 1rem; }
    .masthead-branding { display: flex; align-items: center; gap: 1rem; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 4rem); font-weight: 900; line-height: 0.92; letter-spacing: -0.02em; }
    .masthead-title span { font-style: italic; font-weight: 400; font-family: var(--font-serif); }
    .masthead-date { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 850; text-transform: uppercase; color: var(--foreground); text-align: right; }
    .masthead-standfirst { max-width: 46rem; margin-bottom: 1rem; }
    .masthead-standfirst p { font-family: var(--font-nyt-body); font-size: clamp(0.95rem, 1.5vw, 1.1rem); line-height: 1.58; color: var(--secondary-foreground); text-wrap: pretty; }
    .masthead-deck { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; }
    .masthead-deck span { display: inline-flex; align-items: center; min-height: 1.8rem; padding: 0.25rem 0.75rem; border: 1px solid color-mix(in srgb, var(--border) 88%, transparent); background: color-mix(in srgb, var(--background) 92%, #efe5d6 8%); font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; letter-spacing: 0.08em; text-transform: uppercase; color: var(--foreground); }

    /* ── Pulse Intro ─────────────────────────────────── */
    .pulse-intro-lede { 
        display: flex; 
        flex-direction: column; 
        gap: 2rem; 
        margin-bottom: 3rem;
        position: relative;
        z-index: 1;
    }
    
    .intro-lede {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .intro-greeting { 
        font-family: var(--font-serif); 
        font-size: clamp(1.8rem, 3.5vw, 3rem); 
        font-weight: 900; 
        font-style: italic; 
        line-height: 1.1;
        margin: 0;
    }
    
    .intro-copy {
        font-family: var(--font-nyt-body);
        font-size: clamp(1rem, 1.5vw, 1.15rem);
        line-height: 1.6;
        color: var(--secondary-foreground);
        max-width: 44rem;
        margin: 0;
    }

    :global(.pulse-stats-grid) { display: grid; grid-template-columns: repeat(1, 1fr); gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 2rem; }
    @media (min-width: 768px) { :global(.pulse-stats-grid) { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
    :global(.pulse-card) { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem; border: 1px solid var(--border); background: var(--background); }
    :global(.card-label) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; text-transform: uppercase; color: var(--muted-foreground); display: flex; align-items: center; gap: 0.35rem; }
    :global(.card-value) { font-family: var(--font-serif); font-size: clamp(1.8rem, 3vw, 2.2rem); font-weight: 900; line-height: 1; }
    :global(.card-note) { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 850; text-transform: uppercase; color: var(--muted-foreground); }
    :global(.card-sparkline) { display: flex; align-items: end; gap: 2px; height: 2rem; margin-top: 0.5rem; }
    :global(.card-sparkline .bar) { flex: 1; background: var(--nyt-accent); opacity: 0.2; }
    :global(.card-list) { display: flex; flex-direction: column; gap: 0.4rem; }
    :global(.list-item) { display: flex; justify-content: space-between; font-size: 0.75rem; font-family: var(--font-serif); font-weight: 700; border-bottom: 1px solid var(--border); padding-bottom: 0.2rem; }

    :global(.broadsheet-grid) { display: grid; grid-template-columns: 1fr; gap: 2rem; }
    @media (min-width: 1024px) {
        :global(.broadsheet-grid) { grid-template-columns: minmax(0, 1fr) 300px; gap: 3rem; }
        :global(.broadsheet-main) { border-right: 1px solid var(--border); padding-right: 2rem; min-width: 0; }
        :global(.broadsheet-rail) { position: sticky; top: 7rem; align-self: start; min-width: 0; }
    }

    :global(.section-title-italic) { font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 1.8rem); font-weight: 900; font-style: italic; margin-bottom: 1.25rem; }

    :global(.rail-block) { margin-bottom: 2rem; }
    :global(.rail-kicker) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.4rem; }
    :global(.rail-title) { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; margin-bottom: 0.8rem; }
    :global(.rail-text) { font-family: var(--font-nyt-body); font-size: 0.9rem; line-height: 1.5; color: var(--secondary-foreground); }

    :global(.broadsheet-table-wrapper) { overflow-x: auto; border-top: 2px solid var(--foreground); }
    :global(.broadsheet-table) { width: 100%; border-collapse: collapse; min-width: 600px; }
    :global(.broadsheet-table th) { text-align: left; padding: 0.75rem; font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; border-bottom: 1px solid var(--border); color: var(--muted-foreground); text-transform: uppercase; }
    :global(.broadsheet-table td) { padding: 1.25rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
    
    :global(.broadsheet-table th:nth-child(1)) { width: 35%; }
    :global(.broadsheet-table th:nth-child(2)) { width: 10%; }
    :global(.broadsheet-table th:nth-child(3)) { width: 27.5%; }
    :global(.broadsheet-table th:nth-child(4)) { width: 27.5%; }

    :global(.table-source strong) { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 800; display: block; line-height: 1.1; margin-bottom: 0.25rem; }
    :global(.table-source span) { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.05em; }
    :global(.tone-label) { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; text-transform: uppercase; }
    :global(.stat-row) { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; }
    :global(.stat-bar) { height: 6px; width: 80px; background: var(--secondary); overflow: hidden; border-radius: 999px; }
    :global(.stat-bar div) { height: 100%; background: var(--nyt-accent); }
    :global(.stat-bar.bar-red div) { background: var(--nyt-red); }
    :global(.stat-num) { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 800; width: 2.75rem; tabular-nums: true; }

    @media (max-width: 640px) {
        .editorial-masthead { padding-bottom: 0.5rem; }
        .masthead-title { font-size: clamp(1.75rem, 8vw, 2.5rem); }
        .masthead-deck span { padding: 0.2rem 0.4rem; font-size: 0.48rem; }
        .intro-greeting { font-size: 1.5rem; }
        .intro-copy { font-size: 0.92rem; }
    }
</style>
