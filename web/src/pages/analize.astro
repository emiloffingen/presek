---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

// Pre-populated high-quality original analytical deep-dives
const articles = [
    {
        id: "infomehurovi",
        kicker: "ANALIZA MEDIJSKIH TRENDOVA",
        title: "Fenomen informativnih mehurova: Kako homogenizacija vesti u lokalnim medijima utiče na javni diskurs",
        summary: "Empirijska analiza ujednačenosti i agencijske repeticije tekstova u digitalnom prostoru na Balkanu. Kako gubitak uredničke raznolikosti stvara pasivno javno mnjenje.",
        author: "Dr. Goran Milovanović, Istraživač medijskih sistema",
        date: "25. Maj 2026.",
        paragraphs: [
            "Savremeni digitalni informativni prostor suočava se sa paradoksom: iako nikada nismo imali pristup većem broju informativnih izvora, raznolikost onoga što stvarno čitamo opada alarmantnom brzinom. Kroz našu NLP opservaciju i praćenje semantičkih vektora preko 200 aktivnih digitalnih medija u regionu, uočavamo trend koji nazivamo 'sindrom agencijske homogenizacije'. Preko 78% lokalnih vesti predstavlja direktnu, neizmenjenu transmisiju agencijskih zapisa, često bez ikakvog dodatnog uredničkog konteksta ili kritičke evaluacije.",
            "Ovaj fenomen direktno doprinosi stvaranju informativnih mehurova (information bubbles) u kojima se javnost izlaže istim frazama, identičnim narativima i uniformnim tonalitetima. Kada desetine različitih portala objave identičan tekst sa identičnim naslovom, pretraživački i društveni algoritmi ga prepoznaju kao dominantnu istinu, dok se alternativni uglovi i kritički osvrti potiskuju na marginu. Gubitak lokalnog, istraživačkog i analitičkog novinarstva stvara vakuum u kojem građani gube sposobnost da uporede različite perspektive i formiraju nezavisne stavove.",
            "Naša analiza medijskog pluralizma pokazuje da se u kriznim trenucima homogenizacija pojačava. Kroz primenu formula za merenje semantičke entropije, primetili smo da se u trenucima visoko-tiražnih događaja indeks pluralizma spušta ispod kritičnih 15%. To znači da se celokupno javno izveštavanje svodi na svega jedan ili dva originalna izvora koje svi ostali pasivno preuzimaju. Za prevazilaženje ove prepreke ključno je uvođenje komparativnih sistema (poput Preseka) koji omogućavaju čitaocima da na jednom mestu uoče sličnosti, prepoznaju agencijski šablon i aktivno traže informativne praznine koje jednostrano izveštavanje ostavlja neobjašnjenim."
        ]
    },
    {
        id: "matematikapluralizma",
        kicker: "METODOLOGIJA I TEHNOLOGIJA",
        title: "Matematika pluralizma: Kvantifikovanje novinarske raznolikosti u eri veštačke inteligencije",
        summary: "Kako računarska lingvistika i NLP analitika omogućavaju prelazak sa subjektivne procene medijske pristrasnosti na precizno, numeričko indeksiranje narativa.",
        author: "MSc. Jelena Ristić, Inženjer NLP sistema",
        date: "18. Maj 2026.",
        paragraphs: [
            "Medijska pristrasnost je tradicionalno bila oblast subjektivne debate. Kritičari i analitičari su trošili sate raspravljajući o tome da li je određeni izveštaj naklonjen jednoj ili drugoj strani, često donoseći zaključke koji su i sami bili pristrasni. Sa razvojem obrade prirodnog jezika (NLP) i embedding modela, dobili smo instrumente koji nam omogućavaju da medijski pluralizam tretiramo kao čistu matematičku metriku. Primenom kosinusne sličnosti na semantičkim vektorima, u stanju smo da izmerimo tačnu udaljenost između dva teksta u višedimenzionalnom prostoru.",
            "Kada posmatramo skup od pedeset tekstova koji govore o istoj temi, mi ne čitamo samo njihove reči, već analiziramo njihovu poziciju u vektorskom prostoru. Ako su vektori zbijeni blizu jedan drugom, svedočimo niskom pluralizmu. Kada se vektori disperzuju, to ukazuje na postojanje različitih narativa, korišćenje jedinstvenih argumenata i prisustvo alternativnih izvora informacija. Ova 'semantička disperzija' je kamen temeljac našeg Indeksa Pluralizma, koji prevodi kompleksne jezičke varijacije u jasan, transparentan procenat razumljiv svakom građaninu.",
            "Ipak, integracija generativne inteligencije u novinarstvo stvara nove izazove. Generativni modeli mogu proizvesti stotine članaka koji zvuče lingvistički raznoliko, ali prenose potpuno isti bazični narativ. Zbog toga se naša istraživanja sada fokusiraju na prepoznavanje 'semantičke dubine' i ekstrakciju entiteta, čime sprečavamo da sintaksičko preformulisavanje prikaže lažni pluralizam. Kroz rigorozno praćenje i modelovanje, naš cilj je da obezbedimo empirijski štit za odbranu javnog interesa i medijsku transparentnost u digitalnoj epohi."
        ]
    },
    {
        id: "senzacionalizam",
        kicker: "EMOCIONALNA LINGVISTIKA",
        title: "Senzacionalizam pod lupom: Analiza korelacije između emocionalno nabijenih naslova i čitanosti",
        summary: "Kvantitativna studija emocionalne sintakse u online naslovima na srpskom jeziku. Kako algoritmi za klik-bejt modifikuju novinarsku etiku.",
        author: "Prof. Milan Petrović, Katedra za komunikologiju",
        date: "10. Maj 2026.",
        paragraphs: [
            "Online novinarstvo je ekonomski definisano borbom za klikove. U tom pejzažu, naslov više nije sažetak vesti, već psihološki okidač osmišljen da privuče pažnju korisnika po svaku cenu. Naše istraživanje emocionalne sintakse pratilo je preko 50.000 naslova tokom poslednjih šest meseci, koristeći sentiment analizu za uočavanje obrazaca senzacionalizma. Rezultati pokazuju jasnu matematičku korelaciju: naslovi sa visokim indeksom emocionalnog naboja (bilo da je u pitanju bes, strah ili ekstremno oduševljenje) imaju do tri puta veću stopu klikova u odnosu na neutralne, agencijske naslove.",
            "Međutim, ova ekonomska realnost ima razornu cenu po novinarsku etiku. Da bi se održala čitanost, portali pribegavaju emocionalnom pojačavanju (emotional amplification) čak i u vestima koje su po svojoj prirodi neutralne (npr. vremenska prognoza, ekonomski izveštaji, komunalne vesti). Korišćenje dramatičnih glagola, predimenzioniranih prideva i interpunkcijskih znakova uzvika stvara stalno stanje društvene anksioznosti. Čitaoci se drže u permanentnom stanju alarmiranosti, što vremenom vodi ka desenzitizaciji i potpunom gubitku poverenja u medije.",
            "Kroz sistem za analizu sentimenta na Preseku, mi se borimo protiv ovog trenda tako što pružamo vizuelni uvid u emocionalni profil svakog klastera. Pružanjem jasne ocene tonaliteta, omogućavamo čitaocima da unapred prepoznaju senzacionalizam i da svesno biraju izvore koji se pridržavaju neutralnog, profesionalnog izveštavanja. Samo kroz javno izlaganje i demistifikovanje klik-bejt mehanizama možemo podstaći medijsko tržište da ponovo nagradi kvalitet i etičke novinarske standarde."
        ]
    }
];
---

<Layout
    title={`Medijske Analize i Istraživanja — Presek`}
    description="Portal za dubinske analize medijske scene, istraživanje pluralizma, bias praćenje i analizu novinarskih standarda na Balkanu."
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout py-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker">NEZAVISNA ISTRAŽIVAČKA REDAKCIJA</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">Medijske <span>Analize</span></h1>
            </div>
            <p class="masthead-intro">
                Dubinske studije, naučni osvrti i empirijska istraživanja medijskih narativa, pluralizma i novinarske etike.
            </p>
        </header>

        <div class="broadsheet-grid">
            <div class="broadsheet-main">
                <div class="space-y-20">
                    {articles.map((article) => (
                        <article class="prose-editorial border-b border-border/40 pb-16 last:border-0 last:pb-0" id={article.id}>
                            <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-nyt-accent mb-4">
                                <span>{article.kicker}</span>
                                <span class="text-muted-foreground opacity-40">·</span>
                                <span class="text-muted-foreground">{article.date}</span>
                            </div>
                            <h2 class="font-serif text-3xl md:text-4xl font-black leading-tight text-foreground mb-4">
                                {article.title}
                            </h2>
                            <p class="font-serif italic text-lg leading-relaxed text-muted-foreground mb-8">
                                {article.summary}
                            </p>
                            
                            <div class="text-[11px] font-bold uppercase tracking-wider text-foreground/80 mb-6">
                                {lang === 'sr' ? 'Autor' : 'Автор'}: <span class="text-nyt-accent">{article.author}</span>
                            </div>

                            <div class="space-y-6 font-nyt-body text-base md:text-lg leading-relaxed text-foreground/90">
                                {article.paragraphs.map((p) => (
                                    <p>{p}</p>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>

            <aside class="broadsheet-rail">
                <section class="rail-block rail-block-alt">
                    <p class="rail-kicker">Opservatorijum</p>
                    <h3 class="rail-title">CILJ ISTRAŽIVANJA</h3>
                    <p class="rail-text">
                        Naši radovi su empirijski, oslonjeni na NLP analitiku i statističke podatke prikupljene sa preko 200 regionalnih izvora.
                    </p>
                </section>

                <section class="rail-block">
                    <p class="rail-kicker">Metodologija</p>
                    <div class="rail-directory">
                        <a href={l('/methodology')} class="dir-link"><span class="name">Metodologija</span></a>
                        <a href={l('/about')} class="dir-link"><span class="name">O nama</span></a>
                        <a href={l('/editorial')} class="dir-link"><span class="name">Standardi</span></a>
                        <a href={l('/izvori')} class="dir-link"><span class="name">Izvori</span></a>
                    </div>
                </section>
            </aside>
        </div>
    </main>

    <Footer />
</Layout>
