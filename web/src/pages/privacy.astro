---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<Layout title={t('legal.privacy.title')} description={t('legal.privacy.description')}>
    <NYTHeader />
    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)]">
        <header class="editorial-masthead mb-12">
            <div class="masthead-top">
                <span class="masthead-kicker ui-label">{t('legal.privacy.kicker')}</span>
            </div>
            <div class="masthead-main">
                <h1 class="masthead-title">{t('legal.privacy.heading_prefix')} <span>{t('legal.privacy.heading_span')}</span></h1>
            </div>
            <p class="masthead-intro">{t('legal.privacy.intro')}</p>
        </header>

        <div class="editorial-broadsheet-grid">
            <div class="editorial-broadsheet-main">
                <article class="prose-editorial">
                    <p class="first-paragraph">{t('legal.privacy.lead')}</p>

                    <h2 class="section-title-italic">{t('legal.privacy.section1_title')}</h2>
                    <p>{t('legal.privacy.section1_body')}</p>

                    <h2 class="section-title-italic">{t('legal.privacy.section2_title')}</h2>
                    <p>{t('legal.privacy.section2_body1')}</p>
                    <p>{t('legal.privacy.section2_body2')}</p>
                    <p>{t('legal.privacy.section2_body3')}</p>
                    <ul class="editorial-list">
                        <li>
                            <strong>{t('legal.privacy.section2_list1_strong')}</strong>
                            {t('legal.privacy.section2_list1_text')}
                            <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="underline hover:text-nyt-accent">{t('legal.privacy.section2_list1_link')}</a>.
                        </li>
                        <li>
                            <strong>{t('legal.privacy.section2_list2_strong')}</strong>
                            {t('legal.privacy.section2_list2_text')}
                            <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="underline hover:text-nyt-accent">{t('legal.privacy.section2_list2_link')}</a>.
                        </li>
                    </ul>

                    <h2 class="section-title-italic">{t('legal.privacy.section3_title')}</h2>
                    <p>{t('legal.privacy.section3_body')}</p>

                    <h2 class="section-title-italic">{t('legal.privacy.section4_title')}</h2>
                    <p>{t('legal.privacy.section4_body')}</p>
                </article>
            </div>

            <aside class="editorial-broadsheet-rail">
                <details class="editorial-rail-context">
                    <summary class="editorial-rail-context-summary">
                        <span class="ui-label">{t('legal.privacy.rail_context')}</span>
                        <span class="editorial-rail-context-hint ui-label-min text-muted-foreground">{t('editorial.rail_open')}</span>
                    </summary>
                    <div class="editorial-rail-context-body">
                        <section class="editorial-rail-block editorial-rail-block-alt">
                            <p class="editorial-rail-kicker">{t('legal.privacy.rail_security_kicker')}</p>
                            <h3 class="editorial-rail-title">{t('legal.privacy.rail_security_title')}</h3>
                            <p class="editorial-rail-text">{t('legal.privacy.rail_security_text')}</p>
                        </section>

                        <div class="editorial-rail-meta">
                            <p class="ui-label-min text-muted-foreground mb-4 opacity-70">{t('legal.privacy.rail_updated_label')}</p>
                            <p class="text-xs">{t('legal.privacy.rail_updated_date')}</p>
                        </div>
                    </div>
                </details>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .editorial-list { list-style: none; padding: 0; margin-top: 1.5rem; }
    .editorial-list li { margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
    .editorial-list li::before { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); font-weight: 900; }
</style>
