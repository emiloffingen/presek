---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import AdBookingForm from '../components/marketing/AdBookingForm.tsx';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const status = Astro.url.searchParams.get('status');
const campaignId = Astro.url.searchParams.get('campaign_id');
---

<Layout
  title={lang === 'mk' ? 'Маркетинг и реклами — Presek' : 'Marketing i oglašavanje — Presek'}
  description={lang === 'mk' ? 'Самостојно објавување реклами и банери на Presek.' : 'Samostalno objavljivanje reklama i banera na Preseku.'}
>
  <NYTHeader />
  
  <main class="site-layout broadsheet-layout py-[var(--page-py)] marketing-page-scope">
    {status === 'success' && (
      <div class="max-w-4xl mx-auto mb-8 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 p-6 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4 shadow-lg shadow-emerald-500/5">
        <div>
          <h3 class="font-extrabold text-lg mb-1">
            {lang === 'mk' ? 'Резервацијата е успешна!' : 'Rezervacija je uspešna!'}
          </h3>
          <p class="text-sm opacity-90">
            {lang === 'mk' 
              ? 'Вашата уплата е потврдена и кампањата е активирана.' 
              : 'Vaša uplata je potvrđena i kampanja je aktivirana.'}
          </p>
          {campaignId && (
            <span class="text-xxs font-mono text-emerald-500/70 block mt-2">
              Campaign ID: {campaignId}
            </span>
          )}
        </div>
        <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 text-xl font-bold">✓</div>
      </div>
    )}

    {status === 'cancel' && (
      <div class="max-w-4xl mx-auto mb-8 bg-amber-500/10 border border-amber-500/20 text-amber-400 p-6 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4 shadow-lg shadow-amber-500/5">
        <div>
          <h3 class="font-extrabold text-lg mb-1">
            {lang === 'mk' ? 'Плаќањето е откажано' : 'Plaćanje je otkazano'}
          </h3>
          <p class="text-sm opacity-90">
            {lang === 'mk'
              ? 'Резервацијата на рекламниот простор беше прекината. Ве молиме обидете се повторно.'
              : 'Rezervacija reklamnog prostora je prekinuta. Molimo pokušajte ponovo.'}
          </p>
        </div>
        <div class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-400 shrink-0 text-xl font-bold">!</div>
      </div>
    )}

    {/* Price comparison / marketing section */}
    <section class="max-w-6xl mx-auto mb-16 grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-slate-950/20 rounded-3xl p-8 md:p-12 border border-slate-900">
      <div>
        <h2 class="text-3xl font-extrabold text-slate-100 mb-6 font-serif tracking-tight">
          {lang === 'mk' ? 'Најповолно рекламирање на пазарот' : 'Najpovoljnije oglašavanje na tržištu'}
        </h2>
        <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-6">
          {lang === 'mk' 
            ? 'Пресек нуди револуционерен систем за автоматско купување на огласен простор. Нашите цени се точно 50% пониски во споредба со традиционалните медиумски портали и агрегатори, нудејќи ви максимален поврат на инвестицијата со целосна контрола над буџетот.' 
            : 'Presek nudi revolucionarni sistem za automatsku kupovinu oglasnog prostora. Naše cene su tačno 50% niže u poređenju sa tradicionalnim medijskim portalima i agregatorima, nudeći vam maksimalan povrat investicije uz potpunu kontrolu nad budžetom.'}
        </p>

        <div class="space-y-4">
          <div class="flex justify-between items-center border-b border-slate-900 pb-3">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{lang === 'mk' ? 'Позиција' : 'Pozicija'}</span>
            <div class="flex gap-6 text-xs font-semibold text-slate-400 uppercase tracking-wider">
              <span>{lang === 'mk' ? 'Стандардна цена' : 'Standardna cena'}</span>
              <span class="text-indigo-400">Presek (-50%)</span>
            </div>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-200 font-bold">Top Banner (990x80/990x150)</span>
            <div class="flex gap-10 font-mono">
              <span class="text-slate-500 line-through">{lang === 'mk' ? '120 MKD' : '234 RSD'}</span>
              <span class="text-emerald-400 font-bold">{lang === 'mk' ? '60 MKD' : '117 RSD'}</span>
            </div>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-200 font-bold">Sidebar (300x250/300x600)</span>
            <div class="flex gap-10 font-mono">
              <span class="text-slate-500 line-through">{lang === 'mk' ? '150 MKD' : '292 RSD'}</span>
              <span class="text-emerald-400 font-bold">{lang === 'mk' ? '75 MKD' : '146 RSD'}</span>
            </div>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-200 font-bold">Mobile Content (300x250)</span>
            <div class="flex gap-10 font-mono">
              <span class="text-slate-500 line-through">{lang === 'mk' ? '250 MKD' : '468 RSD'}</span>
              <span class="text-emerald-400 font-bold">{lang === 'mk' ? '125 MKD' : '234 RSD'}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-indigo-900/20 to-indigo-950/40 p-8 rounded-2xl border border-indigo-900/30 text-center relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl"></div>
        <div class="relative z-10 space-y-4">
          <div class="w-16 h-16 bg-indigo-500/10 rounded-full flex items-center justify-center mx-auto text-indigo-400 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-100">
            {lang === 'mk' ? 'Плаќајте безбедно со Stripe' : 'Plaćajte bezbedno uz Stripe'}
          </h3>
          <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
            {lang === 'mk'
              ? 'Вашите трансакции се 100% безбедни преку Stripe Checkout. Кампањата започнува автоматски на избраниот почетен датум.'
              : 'Vaše transakcije su 100% bezbedne preko Stripe Checkout-a. Kampanja počinje automatski na izabrani početni datum.'}
          </p>
          <ul class="text-left text-xs text-slate-400 space-y-2 max-w-xs mx-auto pt-2">
            <li class="flex items-center gap-2">
              <span class="text-indigo-400">•</span>
              <span>{lang === 'mk' ? 'Минимален износ за кошничка: 10 EUR (~600 ден.)' : 'Minimalni iznos za korpu: 10 EUR (~1.170 RSD)'}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-indigo-400">•</span>
              <span>{lang === 'mk' ? 'Минимално 2,000 импресии на ден' : 'Minimalno 2,000 impresija po danu'}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-indigo-400">•</span>
              <span>{lang === 'mk' ? 'Прикачување слики до 150KB' : 'Otpremanje slika do 150KB'}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* Booking Form component */}
    <AdBookingForm client:load lang={lang} />
  </main>

  <Footer />
</Layout>
