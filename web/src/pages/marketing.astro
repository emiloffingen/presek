---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import AdBookingForm from '../components/marketing/AdBookingForm.tsx';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const status = Astro.url.searchParams.get('status');
const campaignId = Astro.url.searchParams.get('campaign_id');
const checkoutEnabled = process.env.STRIPE_CHECKOUT_ENABLED === 'true';
---

<Layout
  title={lang === 'mk' ? 'Маркетинг и реклами — Presek' : 'Marketing i oglašavanje — Presek'}
  description={lang === 'mk' ? 'Самостојно објавување реклами и банери на Presek.' : 'Samostalno objavljivanje reklama i banera na Preseku.'}
>
  <NYTHeader />
  
  <main class="site-layout broadsheet-layout py-[var(--page-py)] marketing-page-scope">
    {status === 'success' && (
      <div class="max-w-4xl mx-auto mb-8 bg-emerald-50 border border-emerald-200 dark:bg-emerald-950/20 dark:border-emerald-800/30 text-emerald-800 dark:text-emerald-400 p-6 rounded-none flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
        <div>
          <h3 class="font-bold text-lg mb-1 font-serif">
            {lang === 'mk' ? 'Резервацијата е успешна!' : 'Rezervacija je uspešna!'}
          </h3>
          <p class="text-sm opacity-90 font-sans">
            {lang === 'mk' 
              ? 'Вашата уплата е потврдена и кампањата е активирана.' 
              : 'Vaša uplata je potvrđena i kampanja je aktivirana.'}
          </p>
          {campaignId && (
            <span class="text-xxs font-mono text-emerald-700 dark:text-emerald-500/70 block mt-2">
              Campaign ID: {campaignId}
            </span>
          )}
        </div>
        <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-700 dark:text-emerald-400 shrink-0 text-xl font-bold">✓</div>
      </div>
    )}

    {status === 'cancel' && (
      <div class="max-w-4xl mx-auto mb-8 bg-amber-50 border border-amber-200 dark:bg-amber-950/20 dark:border-amber-800/30 text-amber-800 dark:text-amber-400 p-6 rounded-none flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
        <div>
          <h3 class="font-bold text-lg mb-1 font-serif">
            {lang === 'mk' ? 'Плаќањето е откажано' : 'Plaćanje je otkazano'}
          </h3>
          <p class="text-sm opacity-90 font-sans">
            {lang === 'mk'
              ? 'Резервацијата на рекламниот простор беше прекината. Ве молиме обидете се повторно.'
              : 'Rezervacija reklamnog prostora je prekinuta. Molimo pokušajte ponovo.'}
          </p>
        </div>
        <div class="w-12 h-12 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-700 dark:text-amber-400 shrink-0 text-xl font-bold">!</div>
      </div>
    )}

    {/* Price comparison / marketing section */}
    <section class="max-w-6xl mx-auto mb-16 grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-card rounded-none p-8 md:p-12 border border-border">
      <div>
        <h2 class="text-3xl font-black text-foreground mb-6 font-serif tracking-tight">
          {lang === 'mk' ? 'Професионално дигитално огласување' : 'Profesionalno digitalno oglašavanje'}
        </h2>
        <p class="text-muted-foreground text-sm md:text-base leading-relaxed mb-6 font-sans">
          {lang === 'mk' 
            ? 'Пресек нуди напредна платформа за самостојно и директно закупување на огласен простор. Нашите позиции се дизајнирани за максимална видливост, обезбедувајќи одличен поврат на инвестицијата, прецизна статистика во реално време и транспарентни тарифи за прикажување.' 
            : 'Presek nudi naprednu platformu za samostalno i direktno zakupljivanje oglasnog prostora. Naše pozicije su dizajnirane za maksimalnu vidljivost, obezbeđujući odličan povrat investicije, preciznu statistiku u realnom vremenu i transparentne tarife za prikazivanje.'}
        </p>

        <div class="space-y-4 font-sans">
          <div class="flex justify-between items-center border-b border-border pb-3">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">{lang === 'mk' ? 'Позиција и димензии' : 'Pozicija i dimenzije'}</span>
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">{lang === 'mk' ? 'Цена по импресија' : 'Cena po impresiji'}</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-foreground font-bold">Top Billboard (990x90 / 990x150)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono">{lang === 'mk' ? '60 MKD' : '117 RSD'}</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-foreground font-bold">Companion Sidebar (300x250 / 300x600)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono">{lang === 'mk' ? '75 MKD' : '146 RSD'}</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-foreground font-bold">Inline Mobile Content (300x250)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono">{lang === 'mk' ? '125 MKD' : '234 RSD'}</span>
          </div>
        </div>
      </div>

      <div class="bg-[var(--presek-mark-soft)] p-8 rounded-none border border-[var(--presek-mark-line)] text-center relative overflow-hidden">
        <div class="relative z-10 space-y-4">
          <div class="w-16 h-16 bg-white/70 dark:bg-black/30 rounded-full flex items-center justify-center mx-auto text-[var(--presek-mark)] mb-2 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-foreground font-serif">
             {checkoutEnabled ? 'Плаќајте безбедно' : 'Плаќањата моментално не се достапни'}
          </h3>
          <p class="text-muted-foreground text-xs md:text-sm leading-relaxed font-sans">
             {lang === 'mk'
               ? checkoutEnabled
                 ? 'Плаќањето се обработува преку безбеден платежен систем. Кампањата започнува автоматски на избраниот почетен датум.'
                 : 'Системот за резервирање рекламни позиции наскоро повторно ќе биде достапен.'
              : 'Vaše transakcije su 100% bezbedne preko Stripe Checkout-a. Kampanja počinje automatski na izabrani početni datum.'}
          </p>
          <ul class="text-left text-xs text-muted-foreground space-y-2 max-w-xs mx-auto pt-2 font-sans">
            <li class="flex items-center gap-2">
              <span class="text-[var(--presek-mark)]">•</span>
              <span>{lang === 'mk' ? 'Минимален износ за кошничка: 10 EUR (~600 ден.)' : 'Minimalni iznos za korpu: 10 EUR (~1.170 RSD)'}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[var(--presek-mark)]">•</span>
              <span>{lang === 'mk' ? 'Минимално 2,000 импресии на ден' : 'Minimalno 2,000 impresija po danu'}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[var(--presek-mark)]">•</span>
              <span>{lang === 'mk' ? 'Прикачување слики до 150KB' : 'Otpremanje slika do 150KB'}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* Booking Form component */}
     {checkoutEnabled ? (
       <AdBookingForm client:load lang={lang} />
     ) : (
       <div class="max-w-4xl mx-auto border border-[var(--presek-mark-line)] bg-[var(--presek-mark-soft)] p-8 text-center">
         <p class="text-xs font-black uppercase tracking-[0.18em] text-[var(--presek-mark)] mb-3">Наскоро</p>
         <h2 class="text-2xl font-black font-serif mb-3">Рекламирањето е привремено паузирано</h2>
         <p class="text-sm text-muted-foreground max-w-xl mx-auto">Следете ја оваа страница за повторно отворање на резервациите.</p>
       </div>
     )}
  </main>

  <Footer />
</Layout>
