---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ArchiveFeedIsland from '../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../components/ArchiveHeatmapIsland.tsx';
import '../styles/archive-premium.css';

import { apiBaseUrl } from '../lib/apiBase';
import { sanitizeHtml } from '../lib/sanitize';
import { CalendarDays, ChevronRight, Hash, Building2, Sparkles, Search, Activity } from 'lucide-react';

import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';
import TinyAdzRailAd from '../components/TinyAdzRailAd.astro';
import TinyAdzInlinedAd from '../components/TinyAdzInlinedAd.astro';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const q = Astro.url.searchParams.get('q') || '';
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive: any = { clusters: [], total: 0, sources: 0, date, page, page_size: 50, has_more: false, total_clusters: 0, top_sources: [], top_topics: [] };
let briefingData: { briefing?: string | null } = { briefing: null };
let onThisDay: any = {};
let error = null;

try {
  const archiveUrl = new URL(`${API_URL}/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('lang', lang);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (q) archiveUrl.searchParams.set('q', q);
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);

  const [res, briefRes, otdRes] = await Promise.all([
    fetch(archiveUrl),
    fetch(`${API_URL}/archive/daily-briefing?date=${date}&lang=${lang}`),
    fetch(`${API_URL}/archive/on-this-day?date=${date}&lang=${lang}`)
  ]);

  if (res.ok) archive = await res.json();
  if (briefRes.ok) briefingData = await briefRes.json();
  if (otdRes.ok) onThisDay = await otdRes.json();

  if (!res.ok) {
    error = t('home.error');
    Astro.response.status = 500;
  }
} catch (err) {
  error = t('home.error');
  Astro.response.status = 500;
}

const buildFilterHref = (kind: 'source' | 'topic' | 'q', value: string) => {
  const params = new URLSearchParams({ date });
  if (kind === 'source') { if (value) params.set('source', value); if (topic) params.set('topic', topic); if (q) params.set('q', q); }
  else if (kind === 'topic') { if (source) params.set('source', source); if (value) params.set('topic', value); if (q) params.set('q', q); }
  else { if (source) params.set('source', source); if (topic) params.set('topic', topic); if (value) params.set('q', value); }
  return `${localePath('/archive', lang, hostHeader)}?${params.toString()}`;
};

const formattedDisplayDate = new Date(archive.date).toLocaleDateString(lang === 'mk' ? 'mk-MK' : 'sr-RS', { day: 'numeric', month: 'long', year: 'numeric' });

const briefingItems: string[] = briefingData.briefing ? briefingData.briefing.split(/\s*[•·]\s*/) : [];

function formatBriefingItem(item: string) {
    if (!item) return '';
    const bolded = item.replace(/\*\*(.*?)\*\*/g, '<strong class="font-black text-foreground not-italic">$1</strong>');
    return sanitizeHtml(bolded);
}
---

<Layout title={`${t('nav.archive')} — Presek`} description={t('archive.description')}>
  <NYTHeader />

  <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)] archive-page-scope">
    <header class="editorial-masthead mb-10 border-t border-foreground pt-4">
        <div class="masthead-top mb-6 flex justify-between items-center">
            <span class="masthead-kicker ui-kicker ui-kicker--accent">{t('archive.memory')}</span>
            <div class="masthead-meta-compact hidden md:flex items-center gap-[var(--grid-gap)] ui-label-min text-muted-foreground opacity-60">
                <span class="flex items-center gap-[var(--grid-gap)]"><CalendarDays size={12} /> {formattedDisplayDate}</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.total_clusters} {t('archive.tema')}</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.sources} {t('archive.redakcija')}</span>
            </div>
        </div>

        <div class="masthead-main flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-8 animate-rise">
            <div class="max-w-3xl">
                <h1 class="masthead-title font-serif text-4xl md:text-6xl font-black leading-[0.95] tracking-tighter mb-4">{t('nav.archive')} <span class="text-presek-mark italic font-light">{t('archive.edition')}</span></h1>
                <p class="font-serif text-xl italic text-muted-foreground leading-snug max-w-2xl">
                    {t('archive.masthead_desc')}
                </p>
            </div>
            <div class="archive-premium-deck w-full md:w-auto">
                <div class="archive-deck-stat">
                    <span class="block text-2xl font-black tabular-nums">{archive.total.toLocaleString(lang === 'mk' ? 'mk-MK' : 'sr-RS')}</span>
                    <span class="ui-label-min text-muted-foreground">{t('archive.objava')}</span>
                </div>
                <div class="archive-deck-stat">
                    <span class="block text-2xl font-black tabular-nums">{archive.sources}</span>
                    <span class="ui-label-min text-muted-foreground">{t('archive.redakcija')}</span>
                </div>
                <div class="archive-deck-stat accent-total-themes">
                    <span class="block text-2xl font-black tabular-nums text-presek-mark">{archive.total_clusters}</span>
                    <span class="ui-label-min text-presek-mark/70">{t('archive.tema')}</span>
                </div>
            </div>
        </div>

        {briefingItems.length > 0 && (
            <details class="archive-briefing-details mb-10 group">
                <summary class="archive-briefing-summary list-none cursor-pointer">
                    <div class="flex items-center gap-[var(--grid-gap)]">
                        <Sparkles size={14} className="text-presek-mark" />
                        <span class="ui-kicker ui-kicker--accent">{t('archive.briefing_kicker')}</span>
                    </div>
                    <span class="ui-label-min text-presek-mark group-open:hidden">{t('archive.briefing_open')} ↓</span>
                    <span class="ui-label-min text-presek-mark hidden group-open:inline">{t('archive.briefing_close')} ↑</span>
                </summary>
                <div class="archive-briefing-glow-panel archive-briefing-glow-panel--expanded shadow-editorial">
                <ul class="space-y-4">
                    {briefingItems.map((item: string) => (
                        <li class="font-nyt-body text-lg md:text-xl leading-relaxed italic text-foreground/80 relative pl-6">
                            <span class="absolute left-0 top-3 w-1.5 h-1.5 rounded-full bg-presek-mark/40"></span>
                            <span set:html={formatBriefingItem(item)}></span>
                        </li>
                    ))}
                </ul>
                </div>
            </details>
        )}

        <div class="archive-sticky-navbar">
            <div class="flex flex-col md:flex-row justify-between items-center gap-[var(--grid-gap)]">
                <div class="flex items-center gap-[var(--grid-gap)] flex-wrap">
                    <form method="get" class="date-select-form">
                        <div class="relative group">
                            <input
                                type="date"
                                name="date"
                                value={date}
                                onchange="this.form.submit()"
                                class="archive-date-input"
                            />
                            <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none opacity-40 group-hover:opacity-100 transition-opacity">
                                <CalendarDays size={14} />
                            </div>
                        </div>
                    </form>

                    <div class="flex items-center gap-1">
                        <a
                            href={`${localePath('/archive', lang, hostHeader)}?date=${new Date(new Date(date).getTime() - 86400000).toISOString().split('T')[0]}`}
                            class="archive-nav-btn"
                        >
                            ← {t('archive.previous')}
                        </a>
                        {new Date(date) < new Date(new Date().toISOString().split('T')[0]) && (
                            <a
                                  href={`${localePath('/archive', lang, hostHeader)}?date=${new Date(new Date(date).getTime() + 86400000).toISOString().split('T')[0]}`}
                                  class="archive-nav-btn"
                            >
                                {t('archive.next')} →
                            </a>
                        )}
                    </div>
                </div>

                <form method="get" class="w-full md:w-80">
                    <input type="hidden" name="date" value={date} />
                    <div class="relative">
                        <input
                            type="text"
                            name="q"
                            value={q}
                            placeholder={t('archive.search_placeholder')}
                            class="archive-search-input"
                        />
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none opacity-40">
                            <Search size={18} />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </header>

    <details class="archive-pulse-deck-toggle mb-10 group">
        <summary class="list-none p-6 bg-secondary/5 cursor-pointer flex justify-between items-center group-open:bg-secondary/10">
            <div class="flex items-center gap-[var(--grid-gap)]">
                <div class="p-2 bg-presek-mark/10 rounded-lg text-presek-mark">
                    <Activity size={18} />
                </div>
                <div>
                    <span class="block ui-kicker">{t('cluster.media_pulse')}</span>
                    <span class="text-xs text-muted-foreground">{t('archive.heatmap_desc')}</span>
                </div>
            </div>
            <div class="flex items-center gap-[var(--grid-gap)] ui-label-min text-presek-mark">
                <span class="group-open:hidden">{t('archive.open_overview')} ↓</span>
                <span class="hidden group-open:inline">{t('archive.close_overview')} ↑</span>
            </div>
        </summary>
        <div class="p-8 border-t border-border bg-card/80">
            <ArchiveHeatmapIsland client:visible selectedDate={date} lang={lang} />
        </div>
    </details>

    <div class="broadsheet-grid">
        <section class="broadsheet-main">
            {q || source || topic ? (
                <div class="active-filters mb-12 flex items-center gap-[var(--grid-gap)] p-4 bg-presek-mark/[0.03] border border-presek-mark/10 rounded-lg">
                    <span class="ui-label-min text-muted-foreground">{t('archive.active_filter')}</span>
                    <div class="flex flex-wrap gap-[var(--grid-gap)]">
                        {q && <span class="px-3 py-1 bg-foreground text-background rounded-full ui-label-min flex items-center gap-[var(--grid-gap)]">🔍 {q} <a href={buildFilterHref('q', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                        {source && <span class="px-3 py-1 bg-foreground text-background rounded-full ui-label-min flex items-center gap-[var(--grid-gap)]">🏢 {source} <a href={buildFilterHref('source', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                        {topic && <span class="px-3 py-1 bg-foreground text-background rounded-full ui-label-min flex items-center gap-[var(--grid-gap)]"># {topic} <a href={buildFilterHref('topic', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                    </div>
                    <a href={`${localePath('/archive', lang, hostHeader)}?date=${date}`} class="ml-auto ui-label-min text-presek-mark underline decoration-2 underline-offset-4">{t('archive.clear')}</a>
                </div>
            ) : null}

            <TinyAdzInlinedAd class="page-inline-ad archive-inline-ad mb-10" />

            <div class="archive-feed-list">
                {error ? (
                    <div class="py-24 text-center border-2 border-dashed border-border rounded-2xl">
                        <p class="font-serif text-2xl italic text-muted-foreground">{error}</p>
                    </div>
                ) : archive.clusters.length > 0 ? (
                    <ArchiveFeedIsland client:visible initialClusters={archive.clusters} initialHasMore={archive.has_more} pageSize={archive.page_size || 50} date={date} q={q} source={source} topic={topic} lang={lang} />
                ) : (
                    <div class="py-32 text-center border-2 border-dashed border-border rounded-2xl">
                        <h2 class="font-serif text-3xl font-black italic mb-4">{t('archive.empty')}</h2>
                        <p class="font-nyt-body text-muted-foreground">{t('archive.try_other_filters')}</p>
                        <a href={localePath('/archive', lang, hostHeader)} class="mt-8 inline-block px-8 py-3 bg-foreground text-background ui-label-min hover:bg-presek-mark transition-all">{t('archive.back_today')}</a>
                    </div>
                )}
            </div>
        </section>

        <aside class="broadsheet-rail pl-4">
            <TinyAdzRailAd />

            <div class="rail-nav-block mb-12">
                <a href={localePath('/archive', lang, hostHeader)} class="group flex items-center justify-between p-4 bg-foreground text-background rounded-sm transition-all hover:bg-presek-mark shadow-lg shadow-black/5 hover:-translate-y-1">
                    <span class="ui-label">{t('archive.back_today')}</span>
                    <ChevronRight size={16} />
                </a>
            </div>

            <details class="archive-rail-context">
                <summary class="archive-rail-context-summary">
                    <span class="ui-kicker">{t('archive.context_filters')}</span>
                    <span class="archive-rail-context-hint ui-kicker text-muted-foreground">{t('archive.open')}</span>
                </summary>
                <div class="archive-rail-context-body">
                    {onThisDay && onThisDay.cluster_id && (
                        <div class="archive-otd-card mb-12">
                            <div class="absolute top-0 right-0 p-4 opacity-10">
                                <CalendarDays size={64} />
                            </div>
                            <span class="block ui-kicker ui-kicker--accent mb-4">{t('archive.on_this_day')}</span>
                            <h3 class="font-serif text-2xl font-black leading-tight mb-4 tracking-tight">
                                {t('archive.years_ago').replace('{n}', onThisDay.years_ago)}
                            </h3>
                            <div class="otd-content group">
                                {onThisDay.image && (
                                    <div class="mb-4 overflow-hidden rounded-lg shadow-sm">
                                        <img src={onThisDay.image} alt="" class="w-full aspect-video object-cover transition-transform group-hover:scale-105 duration-700" />
                                    </div>
                                )}
                                <a href={localePath(`/cluster/${onThisDay.cluster_id}`, lang, hostHeader)} class="block group">
                                    <h4 class="font-serif font-black text-lg leading-tight group-hover:text-presek-mark transition-colors mb-3">{onThisDay.title}</h4>
                                </a>
                                <p class="font-nyt-body text-sm leading-relaxed text-muted-foreground line-clamp-4 italic">"{onThisDay.summary}"</p>
                            </div>
                        </div>
                    )}

                    <div class="rail-directory-module mb-12">
                        <h3 class="ui-kicker text-foreground mb-6 pb-2 border-b-2 border-foreground">{t('archive.focus_topics')}</h3>
                        <div class="flex flex-col gap-1">
                            {archive.top_topics?.slice(0, 15).map((item: any) => (
                                <a href={buildFilterHref('topic', item.topic)} class="archive-sidebar-item group">
                                    <span class="font-serif font-bold text-base group-hover:text-presek-mark transition-colors">{item.topic}</span>
                                    <span class="archive-sidebar-count">{item.n}</span>
                                </a>
                            ))}
                        </div>
                    </div>

                    <div class="rail-directory-module">
                        <h3 class="ui-kicker text-foreground mb-6 pb-2 border-b-2 border-foreground">{t('archive.leading_channels')}</h3>
                        <div class="flex flex-col gap-1">
                            {archive.top_sources?.slice(0, 15).map((item: any) => (
                                <a href={buildFilterHref('source', item.source)} class="archive-sidebar-item group">
                                    <span class="font-serif font-bold text-base group-hover:text-presek-mark transition-colors flex items-center gap-[var(--grid-gap)]">
                                        <Building2 size={12} className="opacity-30 group-hover:opacity-100 transition-opacity" />
                                        {item.source}
                                    </span>
                                    <span class="archive-sidebar-count">{item.n}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </details>
        </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
    .broadsheet-layout { background: var(--background); }
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }

    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: calc(var(--header-height) + 1.5rem); align-self: start; }
    }

    .masthead-title span { font-style: italic; font-weight: 300; }

    .archive-feed-list { position: relative; }
    .archive-feed-list::before {
        content: '';
        position: absolute;
        left: -4rem;
        top: 0;
        bottom: 0;
        width: 1px;
        background: linear-gradient(to bottom, var(--border), transparent);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        opacity: 0;
        position: absolute;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    @media (max-width: 639.98px) {
        .broadsheet-grid {
            gap: 1.5rem;
        }

        .editorial-masthead {
            margin-bottom: 1.5rem !important;
            padding-top: 0.85rem;
        }

        .masthead-top {
            margin-bottom: 1rem !important;
            align-items: flex-start !important;
        }

        .masthead-kicker {
            letter-spacing: 0.1em !important;
        }

        .masthead-main {
            gap: 1rem !important;
            margin-bottom: 1rem !important;
        }

        .masthead-title {
            margin-bottom: 0.55rem !important;
            font-size: 2.35rem !important;
            line-height: 0.94 !important;
        }

        .masthead-main p.font-serif {
            font-size: 1rem !important;
            line-height: 1.45 !important;
        }

        .masthead-data-deck {
            gap: 0 !important;
        }

        .deck-stat {
            padding: 0.85rem !important;
        }

        .deck-stat span.block.text-2xl {
            font-size: 1.25rem !important;
        }

        .deck-stat .ui-label-min {
            letter-spacing: 0.08em !important;
        }

        .daily-briefing-highlight {
            margin-bottom: 1.25rem !important;
            padding: 1rem !important;
        }

        .daily-briefing-highlight .flex.items-center {
            margin-bottom: 0.75rem !important;
            gap: 0.45rem !important;
        }

        .daily-briefing-highlight ul {
            gap: 0.7rem !important;
        }

        .daily-briefing-highlight li {
            padding-left: 1rem !important;
            font-size: 0.96rem !important;
            line-height: 1.45 !important;
        }

        .daily-briefing-highlight li span.absolute {
            top: 0.75rem !important;
            width: 0.32rem !important;
            height: 0.32rem !important;
        }

        .archive-nav-bar {
            margin-bottom: 1.25rem !important;
            padding: 0.75rem 0 !important;
        }

        .archive-nav-bar > div {
            align-items: stretch !important;
            gap: 0.75rem !important;
        }

        .archive-nav-bar .flex.items-center.flex-wrap {
            gap: 0.6rem !important;
            justify-content: space-between;
        }

        .date-select-form,
        .date-select-form .relative {
            width: 100%;
        }

        .date-select-form input[type="date"] {
            width: 100%;
            padding: 0.75rem 0.9rem !important;
            font-size: var(--text-ui-kicker) !important;
            letter-spacing: 0.06em !important;
        }

        .archive-nav-bar .flex.items-center.gap-1 {
            width: 100%;
            gap: 0.45rem !important;
        }

        .archive-nav-bar .flex.items-center.gap-1 a {
            flex: 1 1 0;
            justify-content: center;
            padding: 0.75rem 0.55rem !important;
            font-size: var(--text-ui-min) !important;
            letter-spacing: 0.06em !important;
            text-align: center;
        }

        .archive-nav-bar form.w-full input[type="text"] {
            font-size: 1rem !important;
            padding-top: 0.7rem !important;
            padding-bottom: 0.7rem !important;
        }

        .archive-pulse-toggle {
            margin-bottom: 1.5rem !important;
            border-radius: 0px !important;
        }

        .archive-pulse-toggle summary {
            padding: 0.9rem !important;
            align-items: flex-start !important;
            gap: 0.75rem !important;
        }

        .archive-pulse-toggle summary .p-2 {
            padding: 0.45rem !important;
        }

        .archive-pulse-toggle summary .text-\[11px\] {
            font-size: 0.58rem !important;
            letter-spacing: 0.12em !important;
        }

        .archive-pulse-toggle summary .text-xs {
            font-size: 0.72rem !important;
        }

        .archive-pulse-toggle summary .text-\[10px\] {
            font-size: 0.56rem !important;
            letter-spacing: 0.1em !important;
        }

        .archive-pulse-toggle > div.p-8 {
            padding: 0.85rem !important;
        }

        .active-filters {
            margin-bottom: 1rem !important;
            padding: 0.85rem !important;
            align-items: flex-start !important;
            gap: 0.6rem !important;
            flex-direction: column;
        }

        .active-filters > div {
            gap: 0.45rem !important;
        }

        .active-filters span.px-3 {
            padding: 0.3rem 0.55rem !important;
            letter-spacing: 0.06em !important;
        }

        .active-filters .ml-auto {
            margin-left: 0 !important;
            letter-spacing: 0.06em !important;
        }

        .broadsheet-rail {
            padding-left: 0 !important;
        }

        .rail-nav-block,
        .rail-module,
        .rail-directory-module {
            margin-bottom: 1rem !important;
        }

        .rail-nav-block a {
            padding: 0.9rem !important;
        }

        .rail-nav-block span {
            letter-spacing: 0.08em !important;
        }

        .rail-module {
            padding: 1rem !important;
            border-radius: 0px !important;
        }

        .rail-module h3 {
            font-size: 1.3rem !important;
            margin-bottom: 0.75rem !important;
        }

        .rail-module h4 {
            font-size: 1rem !important;
            margin-bottom: 0.55rem !important;
        }

        .rail-directory-module h3 {
            margin-bottom: 0.8rem !important;
            letter-spacing: 0.08em !important;
        }

        .rail-directory-module a {
            padding-top: 0.55rem !important;
            padding-bottom: 0.55rem !important;
        }

        .rail-directory-module a span.font-serif {
            font-size: 0.95rem !important;
        }
    }
</style>
