---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import ArchiveFeedIsland from '../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../components/ArchiveHeatmapIsland.tsx';
import { apiBaseUrl } from '../lib/apiBase';
import { CalendarDays, Info, ChevronRight, Hash, Building2 } from 'lucide-react';

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive = {
  clusters: [],
  total: 0,
  sources: 0,
  date,
  page,
  page_size: 50,
  has_more: false,
  total_clusters: 0,
  top_sources: [],
  top_topics: [],
};
let error = null;

function normalizeArchivePayload(data: any) {
  return {
    clusters: Array.isArray(data?.clusters) ? data.clusters : [],
    total: Number(data?.total ?? 0),
    sources: Number(data?.sources ?? 0),
    date: data?.date || date,
    source: data?.source || source,
    topic: data?.topic || topic,
    page: Number(data?.page ?? page),
    page_size: Number(data?.page_size ?? 50),
    has_more: Boolean(data?.has_more),
    total_clusters: Number(data?.total_clusters ?? 0),
    top_sources: Array.isArray(data?.top_sources) ? data.top_sources : [],
    top_topics: Array.isArray(data?.top_topics) ? data.top_topics : [],
  };
}

try {
  const archiveUrl = new URL(`${API_URL}/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);

  const res = await fetch(archiveUrl);
  if (res.ok) {
    archive = normalizeArchivePayload(await res.json());
  } else {
    error = 'Архивата моментално не е достапна.';
  }
} catch (err) {
  console.error(err);
  error = 'Грешка при вчитување на архивата.';
}

function buildFilterHref(kind: 'source' | 'topic', value: string) {
  const params = new URLSearchParams({ date });
  if (kind === 'source') {
    if (value && value !== source) params.set('source', value);
    if (topic) params.set('topic', topic);
  } else {
    if (source) params.set('source', source);
    if (value && value !== topic) params.set('topic', value);
  }
  return `/archive?${params.toString()}`;
}

function buildClearHref() {
  return `/archive?${new URLSearchParams({ date }).toString()}`;
}

const formattedDisplayDate = new Date(archive.date).toLocaleDateString('mk-MK', { 
    day: 'numeric', 
    month: 'long', 
    year: 'numeric' 
});
---

<Layout title="Архива" description="Дневен преглед на медиумската покриеност — пребарувајте по датум, извор и тема за да видите што доминирало во вестите.">
  <NYTHeader />
  
  <main class="site-layout archive-page-shell py-8 md:py-16">
    {/* ── Section 1: The Index Masthead ──────────────────────── */}
    <header class="archive-masthead motion-rise">
        <div class="masthead-main">
            <span class="nyt-section-label text-nyt-accent tracking-[0.25em] mb-4 block">Медиумска Меморија</span>
            <h1 class="archive-main-headline">Архива на <span class="italic font-serif">Изданија</span></h1>
            
            <div class="masthead-controls mt-8">
                <form method="get" class="inline-date-picker">
                    <div class="date-selector-frame">
                        <CalendarDays size={16} className="text-nyt-accent" />
                        <span class="dateline-label hidden sm:inline">Издание за:</span>
                        <input type="date" name="date" value={date} class="archive-dateline-input" onchange="this.form.submit()" />
                        <button type="submit" class="dateline-submit sm:hidden">Оди</button>
                    </div>
                    {source && <input type="hidden" name="source" value={source} />}
                    {topic && <input type="hidden" name="topic" value={topic} />}
                </form>
            </div>
        </div>

        <div class="masthead-data-box hidden lg:grid">
            <div class="data-box-row">
                <span class="data-label">Вкупно Објави</span>
                <strong class="data-value">{archive.total.toLocaleString('mk-MK')}</strong>
            </div>
            <div class="data-box-row">
                <span class="data-label">Активни Редакции</span>
                <strong class="data-value">{archive.sources.toLocaleString('mk-MK')}</strong>
            </div>
            <div class="data-box-row border-none">
                <span class="data-label">Групирани Теми</span>
                <strong class="data-value">{archive.total_clusters.toLocaleString('mk-MK')}</strong>
            </div>
        </div>
    </header>

    {/* ── Section 2: The Time Machine (Heatmap) ────────────────── */}
    <div class="archive-timeline-wrap mt-12 mb-16 motion-rise motion-delay-1">
        <div class="timeline-header flex justify-between items-baseline mb-6 border-b border-border pb-4">
            <h2 class="nyt-section-label !text-foreground">Интензитет на циклусот</h2>
            <span class="text-[10px] font-bold text-muted-foreground uppercase">Преглед на 90 дена</span>
        </div>
        <ArchiveHeatmapIsland client:load />
    </div>

    {/* ── Section 3: The Front Page Grid ──────────────────────── */}
    <div class:list={[
        "archive-content-grid motion-rise motion-delay-2",
        (source || topic) ? "is-filtered" : ""
    ]}>
        
        {/* Main Feed Column */}
        <section class="archive-feed-col">
            <div class="feed-editorial-header mb-12">
                <div class="flex items-center gap-4 mb-4">
                    <span class="h-px flex-1 bg-foreground"></span>
                    <h2 class="font-serif italic font-bold text-2xl px-4">{formattedDisplayDate}</h2>
                    <span class="h-px flex-1 bg-foreground"></span>
                </div>

                {(!error && (source || topic)) && (
                    <div class="active-filters-bar flex flex-wrap items-center gap-3 bg-secondary/30 p-4 border border-border">
                        <span class="text-[10px] font-black uppercase tracking-widest">Активен Филтер:</span>
                        {source && (
                            <span class="filter-stark-badge">
                                <Building2 size={10} /> {source}
                                <a href={buildFilterHref('source', '')} class="close-btn">×</a>
                            </span>
                        )}
                        {topic && (
                            <span class="filter-stark-badge">
                                <Hash size={10} /> {topic}
                                <a href={buildFilterHref('topic', '')} class="close-btn">×</a>
                            </span>
                        )}
                        <a href={buildClearHref()} class="clear-all-link">Исчисти сè</a>
                    </div>
                )}
            </div>

            <div class="feed-results">
                {error ? (
                    <div class="archive-error-panel">
                        <p>{error}</p>
                    </div>
                ) : archive.clusters.length > 0 ? (
                    <ArchiveFeedIsland
                        client:load
                        initialClusters={archive.clusters.map((c: any) => ({
                            cluster_id: c.cluster_id,
                            is_breaking: c.is_breaking,
                            representative_image: c.representative_image,
                            articles: (c.articles || []).map((a: any, idx: number) => {
                                const trim = (s: any) => (typeof s === 'string' && s.length > 280 ? s.slice(0, 280) : s);
                                const sig = a.source_signal ? {
                                    role_label: a.source_signal.role_label,
                                    trust_label: a.source_signal.trust_label,
                                } : undefined;
                                if (idx === 0) {
                                    return {
                                        source: a.source,
                                        title: a.title,
                                        summary: trim(a.summary),
                                        description: trim(a.description),
                                        category: a.category,
                                        created_at: a.created_at,
                                        image_url: a.image_url,
                                        image_caption: a.image_caption,
                                        is_fact_check: a.is_fact_check,
                                        source_signal: sig,
                                    };
                                }
                                return {
                                    source: a.source,
                                    title: a.title,
                                    image_url: a.image_url,
                                    is_fact_check: a.is_fact_check,
                                };
                            }),
                        }))}
                        initialHasMore={archive.has_more}
                        date={date}
                        source={source}
                        topic={topic}
                        pageSize={50}
                    />
                ) : (
                    <div class="archive-empty-state">
                        <div class="p-12 border-2 border-dashed border-border text-center">
                            <p class="font-serif italic text-muted-foreground text-xl">Нема пронајдени вести за овој датум со избраните филтри.</p>
                        </div>
                    </div>
                )}
            </div>
        </section>

        {/* Rail Column (Directories) */}
        {!(source || topic) && (
            <aside class="archive-rail-col">
            <div class="rail-module sticky top-24">
                <div class="rail-section mb-10">
                    <h3 class="rail-title"><Hash size={14} /> Индекс на Теми</h3>
                    {!error && archive.top_topics?.length > 0 ? (
                        <div class="directory-list">
                            {archive.top_topics.slice(0, 15).map((item: any) => (
                                <a href={buildFilterHref('topic', item.topic)} class={`directory-item ${topic === item.topic ? 'is-active' : ''}`}>
                                    <span class="dir-label">{item.topic}</span>
                                    <span class="dir-count">{item.n}</span>
                                    <ChevronRight size={10} className="dir-arrow" />
                                </a>
                            ))}
                        </div>
                    ) : (
                        <p class="text-xs italic text-muted-foreground">Нема податоци за теми.</p>
                    )}
                </div>

                <div class="rail-section">
                    <h3 class="rail-title"><Building2 size={14} /> Активни Редакции</h3>
                    {!error && archive.top_sources?.length > 0 ? (
                        <div class="directory-list">
                            {archive.top_sources.slice(0, 15).map((item: any) => (
                                <a href={buildFilterHref('source', item.source)} class={`directory-item ${source === item.source ? 'is-active' : ''}`}>
                                    <span class="dir-label">{item.source}</span>
                                    <span class="dir-count">{item.n}</span>
                                    <ChevronRight size={10} className="dir-arrow" />
                                </a>
                            ))}
                        </div>
                    ) : (
                        <p class="text-xs italic text-muted-foreground">Нема податоци за извори.</p>
                    )}
                </div>

                <div class="rail-footer mt-12 pt-8 border-t border-border opacity-60">
                    <p class="text-[10px] font-black uppercase tracking-widest mb-4">Методологија</p>
                    <p class="text-xs leading-relaxed font-nyt-body">
                        Архивата ги содржи сите кластерирани вести обработени од системот. Податоците се рефрешираат на секои 15 минути.
                    </p>
                </div>
            </div>
        </aside>
        )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
    /* ── Masthead ─────────────────────────────────────── */
    .archive-page-shell {
        max-width: none;
        width: 100%;
        margin-inline: auto;
        padding-inline: clamp(1rem, 2vw, 2rem);
    }

    .archive-masthead {
        display: grid;
        width: 100%;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: end;
        border-bottom: 4px double var(--foreground);
        padding-bottom: 3rem;
    }

    @media (min-width: 1024px) {
        .archive-masthead {
            grid-template-columns: 1fr auto;
        }
    }

    .archive-main-headline {
        font-family: var(--font-serif);
        font-size: clamp(2.5rem, 8vw, 5.5rem);
        line-height: 0.92;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .inline-date-picker {
        display: inline-block;
    }

    .date-selector-frame {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 1.25rem;
        border: 1px solid var(--foreground);
        background: var(--background);
        transition: border-color 0.2s;
    }

    .date-selector-frame:focus-within {
        border-color: var(--nyt-accent);
    }

    .dateline-label {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .archive-dateline-input {
        background: transparent;
        border: 0;
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--foreground);
        outline: none;
        cursor: pointer;
    }

    .dateline-submit {
        background: var(--foreground);
        color: var(--background);
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        padding: 0.4rem 0.75rem;
        border: 0;
    }

    /* ── Weather Box (Data Box) ───────────────────────── */
    .masthead-data-box {
        border: 1px solid var(--foreground);
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        min-width: 320px;
    }

    .data-box-row {
        border-right: 1px solid var(--border);
        padding-right: 1.5rem;
    }

    .data-label {
        display: block;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted-foreground);
        margin-bottom: 0.35rem;
    }

    .data-value {
        font-family: var(--font-serif);
        font-size: 1.65rem;
        line-height: 1;
        font-weight: 900;
    }

    /* ── Grid Layout ──────────────────────────────────── */
    .archive-content-grid {
        display: grid;
        width: 100%;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: start;
    }

    .archive-content-grid > * {
        min-width: 0;
        width: 100%;
    }

    .archive-feed-col,
    .archive-rail-col,
    .archive-feed-container {
        min-width: 0;
        width: 100%;
    }

    @media (min-width: 960px) {
        .archive-content-grid:not(.is-filtered) {
            grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
            gap: 3rem;
        }

        .archive-content-grid.is-filtered {
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
        }
    }

    @media (min-width: 1280px) {
        .archive-content-grid:not(.is-filtered) {
            gap: 4.5rem;
        }
    }

    /* ── Filters ──────────────────────────────────────── */
    .filter-stark-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        background: var(--foreground);
        color: var(--background);
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .filter-stark-badge .close-btn {
        margin-left: 0.25rem;
        opacity: 0.6;
        font-size: 1.1rem;
        line-height: 1;
        transition: opacity 0.2s;
    }

    .filter-stark-badge .close-btn:hover {
        opacity: 1;
    }

    .clear-all-link {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: underline;
        text-underline-offset: 4px;
        color: var(--nyt-accent);
    }

    /* ── Directory Lists ─────────────────────────────── */
    .rail-title {
        font-family: var(--font-sans);
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding-bottom: 0.8rem;
        border-bottom: 2px solid var(--foreground);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .directory-list {
        display: flex;
        flex-direction: column;
    }

    .directory-item {
        display: flex;
        align-items: center;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: var(--foreground);
        group: true;
        transition: background 0.15s;
    }

    .directory-item:hover {
        padding-left: 0.5rem;
        color: var(--nyt-accent);
    }

    .directory-item.is-active {
        font-weight: 900;
        color: var(--nyt-accent);
    }

    .dir-label {
        flex: 1;
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 600;
    }

    .dir-count {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 900;
        background: var(--secondary);
        padding: 0.15rem 0.45rem;
        margin-right: 0.75rem;
    }

    .dir-arrow {
        opacity: 0;
        transform: translateX(-5px);
        transition: all 0.2s;
    }

    .directory-item:hover .dir-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    /* ── Empty & Error states ────────────────────────── */
    .archive-error-panel {
        padding: 4rem;
        background: var(--nyt-red)/5;
        border: 1px dashed var(--nyt-red);
        text-align: center;
        font-family: var(--font-serif);
        italic: true;
        color: var(--nyt-red);
    }
</style>
