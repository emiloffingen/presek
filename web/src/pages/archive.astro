---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import ArchiveFeedIsland from '../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../components/ArchiveHeatmapIsland.tsx';
import { apiBaseUrl } from '../lib/apiBase';
import { CalendarDays, Info } from 'lucide-react';

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
// We still support direct page access, but we'll default to 0 for the island to start from
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive = {
  clusters: [],
  total: 0,
  sources: 0,
  date,
  page,
  page_size: 50,
  has_more: false,
  total_clusters: 0,
  top_sources: [],
  top_topics: [],
};
let error = null;

function normalizeArchivePayload(data: any) {
  return {
    clusters: Array.isArray(data?.clusters) ? data.clusters : [],
    total: Number(data?.total ?? 0),
    sources: Number(data?.sources ?? 0),
    date: data?.date || date,
    source: data?.source || source,
    topic: data?.topic || topic,
    page: Number(data?.page ?? page),
    page_size: Number(data?.page_size ?? 50),
    has_more: Boolean(data?.has_more),
    total_clusters: Number(data?.total_clusters ?? 0),
    top_sources: Array.isArray(data?.top_sources) ? data.top_sources : [],
    top_topics: Array.isArray(data?.top_topics) ? data.top_topics : [],
  };
}

try {
  const archiveUrl = new URL(`${API_URL}/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);

  const res = await fetch(archiveUrl);
  if (res.ok) {
    archive = normalizeArchivePayload(await res.json());
  } else {
    error = 'Архивата моментално не е достапна.';
  }
} catch (err) {
  console.error(err);
  error = 'Грешка при вчитување на архивата.';
}

function buildFilterHref(kind: 'source' | 'topic', value: string) {
  const params = new URLSearchParams({ date });
  if (kind === 'source') {
    if (value && value !== source) params.set('source', value);
    if (topic) params.set('topic', topic);
  } else {
    if (source) params.set('source', source);
    if (value && value !== topic) params.set('topic', value);
  }
  return `/archive?${params.toString()}`;
}

function buildClearHref() {
  return `/archive?${new URLSearchParams({ date }).toString()}`;
}
---

<Layout title="Архива" description="Дневен преглед на медиумската покриеност — пребарувајте по датум, извор и тема за да видите што доминирало во вестите.">
  <NYTHeader />
  <main class="site-layout py-12">
    <div class="archive-shell editorial-shell">
      <header class="archive-header editorial-header motion-rise">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
          <div class="flex-1">
            <span class="page-kicker">Медиумска Меморија</span>
            <h1 class="archive-headline editorial-headline">
              Архива на вести
            </h1>
            <p class="archive-intro editorial-intro">
              Вратете се на кој било ден и видете што доминирало во покривањето: теми, извори и дневната слика.
            </p>
          </div>

          <div class="archive-search-box editorial-panel-strong w-full md:w-auto">
            <form method="get" class="flex flex-col gap-4">
              <div class="space-y-1.5">
                <label class="nyt-section-label text-muted-foreground flex items-center gap-1.5">
                  <CalendarDays size={12} /> Избери датум
                </label>
                <div class="archive-input-container">
                  <input type="date" name="date" value={date} class="archive-date-input" />
                  <button type="submit" class="archive-submit-btn">
                    Прикажи
                  </button>
                </div>
              </div>
              {source && <input type="hidden" name="source" value={source} />}
              {topic && <input type="hidden" name="topic" value={topic} />}
            </form>
          </div>
        </div>
      </header>

      <div class="archive-dashboard mb-12 motion-rise motion-delay-1">
        <ArchiveHeatmapIsland client:load />
      </div>

      <div class="archive-grid editorial-page-grid">
        <div class="archive-main motion-rise motion-delay-1">
          {!error && (
            <div class="archive-stats-row mb-8">
              <div class="archive-stat-card editorial-panel">
                <span class="nyt-section-label text-muted-foreground">Вкупно вести</span>
                <span class="archive-stat-value">{archive.total.toLocaleString('mk-MK')}</span>
              </div>
              <div class="archive-stat-card editorial-panel">
                <span class="nyt-section-label text-muted-foreground">Активни извори</span>
                <span class="archive-stat-value">{archive.sources.toLocaleString('mk-MK')}</span>
              </div>
              <div class="archive-stat-card editorial-panel">
                <span class="nyt-section-label text-muted-foreground">Групирани теми</span>
                <span class="archive-stat-value">{archive.total_clusters.toLocaleString('mk-MK')}</span>
              </div>
              <div class="archive-stat-card editorial-panel-strong">
                <span class="nyt-section-label text-muted-foreground">Преглед за</span>
                <span class="archive-stat-value font-serif italic text-nyt-accent">{new Date(archive.date).toLocaleDateString('mk-MK', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </div>
            </div>
          )}

          {!error && (source || topic) && (
            <div class="archive-active-filters mb-6 flex items-center gap-3">
              <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Филтри:</span>
              <div class="flex flex-wrap gap-2">
                {source && (
                  <span class="filter-badge">
                    Извор: {source}
                    <a href={buildFilterHref('source', '')} class="ml-1.5 hover:text-nyt-red">×</a>
                  </span>
                )}
                {topic && (
                  <span class="filter-badge">
                    Тема: {topic}
                    <a href={buildFilterHref('topic', '')} class="ml-1.5 hover:text-nyt-red">×</a>
                  </span>
                )}
                <a href={buildClearHref()} class="text-[10px] font-bold text-nyt-accent uppercase underline underline-offset-4 ml-2">Исчисти сè</a>
              </div>
            </div>
          )}

          <div class="archive-results">
            {error ? (
              <div class="archive-empty-state">
                <p>{error}</p>
              </div>
            ) : archive.clusters.length > 0 ? (
              <ArchiveFeedIsland
                client:load
                initialClusters={archive.clusters.map((c: any) => ({
                  cluster_id: c.cluster_id,
                  is_breaking: c.is_breaking,
                  representative_image: c.representative_image,
                  articles: (c.articles || []).map((a: any, idx: number) => {
                    const trim = (s: any) => (typeof s === 'string' && s.length > 280 ? s.slice(0, 280) : s);
                    const sig = a.source_signal ? {
                      role_label: a.source_signal.role_label,
                      trust_label: a.source_signal.trust_label,
                    } : undefined;
                    if (idx === 0) {
                      return {
                        source: a.source,
                        title: a.title,
                        summary: trim(a.summary),
                        description: trim(a.description),
                        category: a.category,
                        created_at: a.created_at,
                        image_url: a.image_url,
                        image_caption: a.image_caption,
                        is_fact_check: a.is_fact_check,
                        source_signal: sig,
                      };
                    }
                    return {
                      source: a.source,
                      title: a.title,
                      image_url: a.image_url,
                      is_fact_check: a.is_fact_check,
                    };
                  }),
                }))}
                initialHasMore={archive.has_more}
                date={date}
                source={source}
                topic={topic}
                pageSize={50}
              />
            ) : (
              <div class="archive-empty-state">
                <p>Нема пронајдени вести за овој датум со избраните филтри.</p>
              </div>
            )}
          </div>
        </div>

        <aside class="archive-rail motion-rise motion-delay-2">
          <div class="rail-card editorial-panel">
            <h2 class="rail-card-title editorial-panel-title flex items-center gap-2"><Info size={14} /> Како Да Ја Користите</h2>
            <p class="rail-copy">
              Архивата не е само листа на стари објави, туку начин брзо да ја вратите медиумската слика наназад. Изберете датум за да видите како се развивале сториите.
            </p>
          </div>

          {!error && archive.top_topics?.length > 0 && (
            <div class="rail-card editorial-panel">
              <h2 class="rail-card-title editorial-panel-title">Доминантни Теми</h2>
              <div class="filter-list">
                {archive.top_topics.slice(0, 15).map((item: any) => (
                  <a href={buildFilterHref('topic', item.topic)} class={`filter-item ${topic === item.topic ? 'is-active' : ''}`}>
                    <span class="filter-label">{item.topic}</span>
                    <span class="filter-count">{item.n}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {!error && archive.top_sources?.length > 0 && (
            <div class="rail-card editorial-panel">
              <h2 class="rail-card-title editorial-panel-title">Најактивни Извори</h2>
              <div class="filter-list">
                {archive.top_sources.slice(0, 15).map((item: any) => (
                  <a href={buildFilterHref('source', item.source)} class={`filter-item ${source === item.source ? 'is-active' : ''}`}>
                    <span class="filter-label">{item.source}</span>
                    <span class="filter-count">{item.n}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .archive-headline {
    font-size: clamp(2.5rem, 2rem + 2.5vw, 4.8rem);
    line-height: 0.95;
    margin-bottom: 0.5rem;
  }

  .archive-intro {
    max-width: 44rem;
  }

  .archive-input-container {
    display: flex;
    align-items: stretch;
    background: var(--background);
    border: 1px solid var(--border);
    padding: 0.25rem;
  }

  .archive-date-input {
    background: transparent;
    border: 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--foreground);
    outline: none;
  }

  .archive-submit-btn {
    background: var(--nyt-accent);
    color: white;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0 1rem;
    border: 0;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .archive-submit-btn:hover {
    background: color-mix(in srgb, var(--nyt-accent) 85%, black);
  }

  .archive-stats-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .archive-stats-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .archive-stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .archive-stat-value {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    line-height: 1;
    font-weight: 900;
  }

  .filter-badge {
    display: inline-flex;
    align-items: center;
    background: var(--nyt-accent);
    color: white;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
  }

  .archive-empty-state {
    padding: 6rem 2rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 95%, var(--surface-soft) 5%);
    text-align: center;
    font-family: var(--font-nyt-body);
    font-style: italic;
    color: var(--muted-foreground);
  }

  .filter-list {
    display: flex;
    flex-direction: column;
  }

  .filter-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    transition: color 200ms ease;
  }

  .filter-item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .filter-item:hover,
  .filter-item.is-active {
    color: var(--nyt-accent);
  }

  .filter-count {
    font-size: 0.7rem;
    font-weight: 900;
    color: var(--muted-foreground);
    background: var(--secondary);
    padding: 0.15rem 0.4rem;
    border-radius: 10px;
  }

  .rail-copy {
    font-family: var(--font-nyt-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--secondary-foreground);
  }

  @media (min-width: 960px) {
    .archive-grid {
      grid-template-columns: 1fr 20rem;
      gap: 3rem;
    }
  }
</style>
