---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import ArchiveFeedIsland from '../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../components/ArchiveHeatmapIsland.tsx';
import { apiBaseUrl } from '../lib/apiBase';
import { CalendarDays, ChevronRight, Hash, Building2 } from 'lucide-react';

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive = { clusters: [], total: 0, sources: 0, date, page, page_size: 50, has_more: false, total_clusters: 0, top_sources: [], top_topics: [] };
let error = null;

try {
  const archiveUrl = new URL(`${API_URL}/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);
  const res = await fetch(archiveUrl);
  if (res.ok) archive = await res.json();
  else error = 'Архивата моментално не е достапна.';
} catch (err) {
  error = 'Грешка при вчитување на архивата.';
}

const buildFilterHref = (kind: 'source' | 'topic', value: string) => {
  const params = new URLSearchParams({ date });
  if (kind === 'source') { if (value) params.set('source', value); if (topic) params.set('topic', topic); }
  else { if (source) params.set('source', source); if (value) params.set('topic', value); }
  return `/archive?${params.toString()}`;
};

const formattedDisplayDate = new Date(archive.date).toLocaleDateString('mk-MK', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Архива — Пресек" description="Пребарувајте низ историјата на македонските медиуми.">
  <NYTHeader />
  
  <main class="site-layout broadsheet-layout py-[var(--page-py)]">
    <header class="editorial-masthead mb-12">
        <div class="masthead-top">
            <span class="masthead-kicker">МЕДИУМСКА МЕМОРИЈА</span>
        </div>
        <div class="masthead-main">
            <h1 class="masthead-title">Архива на <span>Изданија</span></h1>
            <div class="masthead-data-bar">
                <div class="m-stat"><span>Објави</span><strong>{archive.total.toLocaleString('mk-MK')}</strong></div>
                <div class="m-stat"><span>Редакции</span><strong>{archive.sources}</strong></div>
                <div class="m-stat"><span>Теми</span><strong>{archive.total_clusters}</strong></div>
            </div>
        </div>

        <div class="archive-controls mt-10">
            <form method="get" class="date-form">
                <div class="date-input-wrap">
                    <CalendarDays size={16} />
                    <input type="date" name="date" value={date} onchange="this.form.submit()" />
                </div>
                <p class="date-display-label">{formattedDisplayDate}</p>
            </form>
        </div>
    </header>

    <details class="archive-heatmap-toggle mb-12">
        <summary>Интензитет на циклусот <span>Отвори преглед ↓</span></summary>
        <div class="heatmap-panel pt-8">
            <ArchiveHeatmapIsland client:load />
        </div>
    </details>

    <div class="broadsheet-grid">
        <section class="broadsheet-main">
            {source || topic ? (
                <div class="filter-status-bar mb-8">
                    <span class="label">АКТИВЕН ФИЛТЕР:</span>
                    <div class="chips">
                        {source && <span class="chip">🏢 {source} <a href={buildFilterHref('source', '')}>×</a></span>}
                        {topic && <span class="chip"># {topic} <a href={buildFilterHref('topic', '')}>×</a></span>}
                    </div>
                    <a href={`/archive?date=${date}`} class="clear">Исчисти сè</a>
                </div>
            ) : null}

            <div class="archive-results">
                {error ? (
                    <div class="empty-state"><p>{error}</p></div>
                ) : archive.clusters.length > 0 ? (
                    <ArchiveFeedIsland client:load initialClusters={archive.clusters} initialHasMore={archive.has_more} date={date} source={source} topic={topic} />
                ) : (
                    <div class="empty-state">
                        <h2>Нема пронајдени вести.</h2>
                        <p>Пробајте со друг датум или исчистете ги филтрите.</p>
                    </div>
                )}
            </div>
        </section>

        <aside class="broadsheet-rail">
            <div class="rail-block rail-block-featured">
                <p class="rail-kicker">Индекс</p>
                <h3 class="rail-title">ТЕМИ</h3>
                <div class="rail-directory">
                    {archive.top_topics?.slice(0, 12).map((item: any) => (
                        <a href={buildFilterHref('topic', item.topic)} class="dir-link">
                            <span class="name">{item.topic}</span>
                            <span class="val">{item.n}</span>
                        </a>
                    ))}
                </div>
            </div>

            <div class="rail-block">
                <p class="rail-kicker">Канали</p>
                <h3 class="rail-title">РЕДАКЦИИ</h3>
                <div class="rail-directory">
                    {archive.top_sources?.slice(0, 12).map((item: any) => (
                        <a href={buildFilterHref('source', item.source)} class="dir-link">
                            <span class="name">{item.source}</span>
                            <span class="val">{item.n}</span>
                        </a>
                    ))}
                </div>
            </div>
        </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
    /* ── Masthead ────────────────────────────────────── */
    .editorial-masthead { border-bottom: 4px solid var(--foreground); padding-bottom: 2rem; }
    .masthead-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-accent); }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 0.9; margin: 1.5rem 0; letter-spacing: -0.02em; }
    .masthead-title span { font-weight: 400; italic: true; }
    
    .masthead-main { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 2rem; }
    .masthead-data-bar { display: flex; gap: 2rem; }
    .m-stat span { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 900; text-transform: uppercase; color: var(--muted-foreground); display: block; margin-bottom: 0.2rem; }
    .m-stat strong { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 900; }

    .date-form { display: flex; align-items: center; gap: 1.5rem; }
    .date-input-wrap { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1rem; border: 1px solid var(--foreground); }
    .date-input-wrap input { background: transparent; border: 0; font-family: var(--font-serif); font-size: 1rem; font-weight: 800; outline: none; }
    .date-display-label { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 900; italic: true; }

    /* ── Heatmap Toggle ──────────────────────────────── */
    .archive-heatmap-toggle { border: 1px solid var(--border); background: var(--secondary); }
    .archive-heatmap-toggle summary { list-style: none; padding: 1rem 1.5rem; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 900; text-transform: uppercase; cursor: pointer; display: flex; justify-content: space-between; }
    .archive-heatmap-toggle summary span { color: var(--nyt-accent); }

    /* ── Broadsheet Grid ────────────────────────────── */
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: minmax(0, 1fr) 300px; }
        .broadsheet-main { border-right: 1px solid var(--border); padding-right: 3rem; }
        .broadsheet-rail { position: sticky; top: 8rem; align-self: start; }
    }

    /* ── Filter Bar ──────────────────────────────────── */
    .filter-status-bar { display: flex; align-items: center; gap: 1rem; padding: 1rem; border: 1px solid var(--foreground); }
    .filter-status-bar .label { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; }
    .filter-status-bar .chips { display: flex; gap: 0.5rem; }
    .filter-status-bar .chip { padding: 0.25rem 0.5rem; background: var(--foreground); color: var(--background); font-family: var(--font-sans); font-size: 0.65rem; font-weight: 800; display: flex; align-items: center; gap: 0.4rem; }
    .filter-status-bar .chip a { color: inherit; text-decoration: none; font-size: 1rem; line-height: 1; }
    .filter-status-bar .clear { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-decoration: underline; color: var(--nyt-accent); }

    /* ── Rail ────────────────────────────────────────── */
    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-featured { padding: 1.5rem; background: var(--secondary); }
    .rail-kicker { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); text-transform: uppercase; margin-bottom: 0.5rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .rail-directory { display: flex; flex-direction: column; }
    .dir-link { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; }
    .dir-link:last-child { border-bottom: none; }
    .dir-link .name { font-family: var(--font-serif); font-size: 0.95rem; font-weight: 700; }
    .dir-link .val { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; background: var(--border); padding: 2px 6px; }
    .dir-link:hover .name { color: var(--nyt-accent); text-decoration: underline; }

    .empty-state { text-align: center; padding: 5rem 1rem; border: 1px dashed var(--border); }
</style>
