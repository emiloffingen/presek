---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import ArchiveFeedIsland from '../components/ArchiveFeedIsland.tsx';
import ArchiveHeatmapIsland from '../components/ArchiveHeatmapIsland.tsx';

import { apiBaseUrl } from '../lib/apiBase';
import { sanitizeHtml } from '../lib/sanitize';
import { CalendarDays, ChevronRight, Hash, Building2, Sparkles, Search, Activity } from 'lucide-react';

import { getLangFromUrl, useTranslations } from '../i18n/utils';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const isMK = lang === 'mk';

const date = Astro.url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const q = Astro.url.searchParams.get('q') || '';
const source = Astro.url.searchParams.get('source') || '';
const topic = Astro.url.searchParams.get('topic') || '';
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') || '0', 10) || 0);
const API_URL = apiBaseUrl();

let archive: any = { clusters: [], total: 0, sources: 0, date, page, page_size: 50, has_more: false, total_clusters: 0, top_sources: [], top_topics: [] };
let briefingData: { briefing?: string | null } = { briefing: null };
let onThisDay: any = {};
let error = null;

try {
  const archiveUrl = new URL(`${API_URL}/archive`);
  archiveUrl.searchParams.set('date', date);
  archiveUrl.searchParams.set('lang', lang);
  archiveUrl.searchParams.set('page', String(page));
  archiveUrl.searchParams.set('page_size', '50');
  if (q) archiveUrl.searchParams.set('q', q);
  if (source) archiveUrl.searchParams.set('source', source);
  if (topic) archiveUrl.searchParams.set('topic', topic);

  const [res, briefRes, otdRes] = await Promise.all([
    fetch(archiveUrl),
    fetch(`${API_URL}/archive/daily-briefing?date=${date}&lang=${lang}`),
    fetch(`${API_URL}/archive/on-this-day?date=${date}&lang=${lang}`)
  ]);

  if (res.ok) archive = await res.json();
  if (briefRes.ok) briefingData = await briefRes.json();
  if (otdRes.ok) onThisDay = await otdRes.json();

  if (!res.ok) {
    error = t('home.error');
    Astro.response.status = 500;
  }
} catch (err) {
  error = t('home.error');
  Astro.response.status = 500;
}

const buildFilterHref = (kind: 'source' | 'topic' | 'q', value: string) => {
  const params = new URLSearchParams({ date });
  if (kind === 'source') { if (value) params.set('source', value); if (topic) params.set('topic', topic); if (q) params.set('q', q); }
  else if (kind === 'topic') { if (source) params.set('source', source); if (value) params.set('topic', value); if (q) params.set('q', q); }
  else { if (source) params.set('source', source); if (topic) params.set('topic', topic); if (value) params.set('q', value); }
  const prefix = isMK ? '/mk' : '';
  return `${prefix}/archive?${params.toString()}`;
};

const formattedDisplayDate = new Date(archive.date).toLocaleDateString(isMK ? 'mk-MK' : 'sr-RS', { day: 'numeric', month: 'long', year: 'numeric' });

const briefingItems: string[] = briefingData.briefing ? briefingData.briefing.split(/\s*[•·]\s*/) : [];

function formatBriefingItem(item: string) {
    if (!item) return '';
    const bolded = item.replace(/\*\*(.*?)\*\*/g, '<strong class="font-black text-foreground not-italic">$1</strong>');
    return sanitizeHtml(bolded);
}
---

<Layout title={`${t('nav.archive')} — Presek`} description={t('archive.description')}>
  <NYTHeader />

  <main class="site-layout broadsheet-layout pt-32 pb-[var(--page-py)]">
    <header class="editorial-masthead mb-16 border-t border-foreground pt-4">
        <div class="masthead-top mb-8 flex justify-between items-center">
            <span class="masthead-kicker font-sans text-[10px] font-black uppercase tracking-[0.25em] text-nyt-accent">{t('archive.memory')}</span>
            <div class="masthead-meta-compact hidden md:flex items-center gap-[var(--grid-gap)] font-sans text-[10px] font-black uppercase tracking-widest text-muted-foreground opacity-60">
                <span class="flex items-center gap-[var(--grid-gap)]"><CalendarDays size={12} /> {formattedDisplayDate}</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.total_clusters} {t('archive.tema')}</span>
                <span class="w-1 h-1 rounded-full bg-border"></span>
                <span>{archive.sources} {t('archive.redakcija')}</span>
            </div>
        </div>

        <div class="masthead-main flex flex-col md:flex-row justify-between items-start md:items-end gap-12 mb-12">
            <div class="max-w-3xl">
                <h1 class="masthead-title font-serif text-5xl md:text-7xl font-black leading-[0.9] tracking-tighter mb-4">{t('nav.archive')} <span class="text-nyt-accent italic font-light">{isMK ? 'Изданија' : 'Izdanja'}</span></h1>
                <p class="font-serif text-xl italic text-muted-foreground leading-snug max-w-2xl">
                    {t('archive.masthead_desc')}
                </p>
            </div>
            <div class="masthead-data-deck grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--grid-gap)] border border-border/60 bg-secondary/10 overflow-hidden rounded-sm w-full md:w-auto">
                <div class="deck-stat p-6 border-r border-border/60 text-center">
                    <span class="block text-2xl font-black tabular-nums">{archive.total.toLocaleString(isMK ? 'mk-MK' : 'sr-RS')}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">{t('archive.objava')}</span>
                </div>
                <div class="deck-stat p-6 border-r border-border/60 text-center">
                    <span class="block text-2xl font-black tabular-nums">{archive.sources}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">{t('archive.redakcija')}</span>
                </div>
                <div class="deck-stat p-6 bg-nyt-accent/5 text-center">
                    <span class="block text-2xl font-black tabular-nums text-nyt-accent">{archive.total_clusters}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest text-nyt-accent/70">{t('archive.tema')}</span>
                </div>
            </div>
        </div>

        {briefingItems.length > 0 && (
            <div class="daily-briefing-highlight mb-16 p-8 bg-background border-l-4 border-nyt-accent shadow-editorial">
                <div class="flex items-center gap-[var(--grid-gap)] mb-6">
                    <Sparkles size={14} className="text-nyt-accent" />
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-nyt-accent">{t('archive.briefing_kicker')}</span>
                </div>
                <ul class="space-y-4">
                    {briefingItems.map((item: string) => (
                        <li class="font-nyt-body text-lg md:text-xl leading-relaxed italic text-foreground/80 relative pl-6">
                            <span class="absolute left-0 top-3 w-1.5 h-1.5 rounded-full bg-nyt-accent/40"></span>
                            <span set:html={formatBriefingItem(item)}></span>
                        </li>
                    ))}
                </ul>
            </div>
        )}

        <div class="archive-nav-bar sticky top-[72px] z-30 bg-background/80 backdrop-blur-xl border-y border-border py-4 mb-16">
            <div class="flex flex-col md:flex-row justify-between items-center gap-[var(--grid-gap)]">
                <div class="flex items-center gap-[var(--grid-gap)] flex-wrap">
                    <form method="get" class="date-select-form">
                        <div class="relative group">
                            <input
                                type="date"
                                name="date"
                                value={date}
                                onchange="this.form.submit()"
                                class="bg-secondary/40 border border-border px-4 py-2 rounded font-sans text-xs font-black uppercase tracking-widest outline-none focus:border-nyt-accent transition-all cursor-pointer"
                            />
                            <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none opacity-40 group-hover:opacity-100 transition-opacity">
                                <CalendarDays size={14} />
                            </div>
                        </div>
                    </form>

                    <div class="flex items-center gap-1">
                        <a
                            href={`${isMK ? '/mk' : ''}/archive?date=${new Date(new Date(date).getTime() - 86400000).toISOString().split('T')[0]}`}
                            class="px-4 py-2 bg-secondary/50 border border-border/60 rounded font-sans text-[10px] font-black uppercase tracking-widest hover:bg-foreground hover:text-background transition-all"
                        >
                            ← {isMK ? 'ПРЕТХОДЕН' : 'PRETHODNI'}
                        </a>
                        {new Date(date) < new Date(new Date().toISOString().split('T')[0]) && (
                            <a
                                href={`${isMK ? '/mk' : ''}/archive?date=${new Date(new Date(date).getTime() + 86400000).toISOString().split('T')[0]}`}
                                class="px-4 py-2 bg-secondary/50 border border-border/60 rounded font-sans text-[10px] font-black uppercase tracking-widest hover:bg-foreground hover:text-background transition-all"
                            >
                                {isMK ? 'СЛЕДЕН' : 'SLEDEĆI'} →
                            </a>
                        )}
                    </div>
                </div>

                <form method="get" class="w-full md:w-80">
                    <input type="hidden" name="date" value={date} />
                    <div class="relative">
                        <input
                            type="text"
                            name="q"
                            value={q}
                            placeholder={isMK ? "Пребарај го овој ден..." : "Pretraži ovaj dan..."}
                            class="w-full bg-secondary/20 border-b-2 border-border py-2 pl-2 pr-10 font-serif font-bold text-lg outline-none focus:border-nyt-accent placeholder:italic placeholder:font-normal placeholder:opacity-40 transition-all"
                        />
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none opacity-40">
                            <Search size={18} />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </header>

    <details class="archive-pulse-toggle mb-20 group border border-border rounded-xl overflow-hidden shadow-sm transition-all hover:shadow-md">
        <summary class="list-none p-6 bg-secondary/5 cursor-pointer flex justify-between items-center group-open:bg-secondary/10">
            <div class="flex items-center gap-[var(--grid-gap)]">
                <div class="p-2 bg-nyt-accent/10 rounded-lg text-nyt-accent">
                    <Activity size={18} />
                </div>
                <div>
                    <span class="block font-sans text-[11px] font-black uppercase tracking-widest">{t('cluster.media_pulse')}</span>
                    <span class="text-xs text-muted-foreground">{isMK ? 'Интензитет на известување и тематски циклуси' : 'Intenzitet izveštavanja i tematski ciklusi'}</span>
                </div>
            </div>
            <div class="flex items-center gap-[var(--grid-gap)] font-sans text-[10px] font-black uppercase tracking-widest text-nyt-accent">
                <span class="group-open:hidden">{isMK ? 'ОТВОРИ ПРЕГЛЕД' : 'OTVORI PREGLED'} ↓</span>
                <span class="hidden group-open:inline">{isMK ? 'ЗАТВОРИ ПРЕГЛЕД' : 'ZATVORI PREGLED'} ↑</span>
            </div>
        </summary>
        <div class="p-8 border-t border-border bg-white dark:bg-zinc-950/50">
            <ArchiveHeatmapIsland client:visible selectedDate={date} lang={lang} />
        </div>
    </details>

    <div class="broadsheet-grid">
        <section class="broadsheet-main">
            {q || source || topic ? (
                <div class="active-filters mb-12 flex items-center gap-[var(--grid-gap)] p-4 bg-nyt-accent/[0.03] border border-nyt-accent/10 rounded-lg">
                    <span class="font-sans text-[10px] font-black uppercase tracking-widest text-muted-foreground">{t('archive.active_filter')}</span>
                    <div class="flex flex-wrap gap-[var(--grid-gap)]">
                        {q && <span class="px-3 py-1 bg-foreground text-background rounded-full font-sans text-[10px] font-black uppercase tracking-widest flex items-center gap-[var(--grid-gap)]">🔍 {q} <a href={buildFilterHref('q', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                        {source && <span class="px-3 py-1 bg-foreground text-background rounded-full font-sans text-[10px] font-black uppercase tracking-widest flex items-center gap-[var(--grid-gap)]">🏢 {source} <a href={buildFilterHref('source', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                        {topic && <span class="px-3 py-1 bg-foreground text-background rounded-full font-sans text-[10px] font-black uppercase tracking-widest flex items-center gap-[var(--grid-gap)]"># {topic} <a href={buildFilterHref('topic', '')} class="ml-1 opacity-60 hover:opacity-100">×</a></span>}
                    </div>
                    <a href={`${isMK ? '/mk' : ''}/archive?date=${date}`} class="ml-auto font-sans text-[10px] font-black uppercase tracking-widest text-nyt-accent underline decoration-2 underline-offset-4">{t('archive.clear')}</a>
                </div>
            ) : null}

            <div class="archive-feed-wrapper">
                {error ? (
                    <div class="py-24 text-center border-2 border-dashed border-border rounded-2xl">
                        <p class="font-serif text-2xl italic text-muted-foreground">{error}</p>
                    </div>
                ) : archive.clusters.length > 0 ? (
                    <ArchiveFeedIsland client:visible initialClusters={archive.clusters} initialHasMore={archive.has_more} pageSize={archive.page_size || 50} date={date} q={q} source={source} topic={topic} lang={lang} />
                ) : (
                    <div class="py-32 text-center border-2 border-dashed border-border rounded-2xl">
                        <h2 class="font-serif text-3xl font-black italic mb-4">{t('archive.empty')}</h2>
                        <p class="font-nyt-body text-muted-foreground">{isMK ? 'Пробајте со друг датум или прилагодете ги филтрите за пребарување.' : 'Probajte sa drugim datumom ili prilagodite filtere pretrage.'}</p>
                        <a href={isMK ? "/mk/archive" : "/archive"} class="mt-8 inline-block px-8 py-3 bg-foreground text-background font-sans text-[10px] font-black uppercase tracking-widest hover:bg-nyt-accent transition-all">{t('archive.back_today')}</a>
                    </div>
                )}
            </div>
        </section>

        <aside class="broadsheet-rail pl-4">
            <div class="rail-nav-block mb-12">
                <a href={isMK ? "/mk/archive" : "/archive"} class="group flex items-center justify-between p-4 bg-foreground text-background rounded-sm transition-all hover:bg-nyt-accent shadow-lg shadow-black/5 hover:-translate-y-1">
                    <span class="font-sans text-[11px] font-black uppercase tracking-widest">{t('archive.back_today')}</span>
                    <ChevronRight size={16} />
                </a>
            </div>

            {onThisDay && onThisDay.cluster_id && (
                <div class="rail-module mb-12 p-6 bg-secondary/10 border border-border/40 rounded-xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <CalendarDays size={64} />
                    </div>
                    <span class="block font-sans text-[10px] font-black uppercase tracking-[0.2em] text-nyt-accent mb-4">{t('archive.on_this_day')}</span>
                    <h3 class="font-serif text-2xl font-black leading-tight mb-4 tracking-tight">
                        {t('archive.years_ago').replace('{n}', onThisDay.years_ago)}
                    </h3>
                    <div class="otd-content group">
                        {onThisDay.image && (
                            <div class="mb-4 overflow-hidden rounded-lg shadow-sm">
                                <img src={onThisDay.image} alt="" class="w-full aspect-video object-cover transition-transform group-hover:scale-105 duration-700" />
                            </div>
                        )}
                        <a href={isMK ? `/mk/cluster/${onThisDay.cluster_id}` : `/cluster/${onThisDay.cluster_id}`} class="block group">
                            <h4 class="font-serif font-black text-lg leading-tight group-hover:text-nyt-accent transition-colors mb-3">{onThisDay.title}</h4>
                        </a>
                        <p class="font-nyt-body text-sm leading-relaxed text-muted-foreground line-clamp-4 italic">"{onThisDay.summary}"</p>
                    </div>
                </div>
            )}

            <div class="rail-directory-module mb-12">
                <h3 class="font-sans text-[11px] font-black uppercase tracking-[0.2em] text-foreground mb-6 pb-2 border-b-2 border-foreground">{t('archive.focus_topics')}</h3>
                <div class="flex flex-col gap-1">
                    {archive.top_topics?.slice(0, 15).map((item: any) => (
                        <a href={buildFilterHref('topic', item.topic)} class="group flex items-center justify-between py-2 border-b border-border/40 hover:bg-secondary/20 transition-all px-1">
                            <span class="font-serif font-bold text-base group-hover:text-nyt-accent transition-colors">{item.topic}</span>
                            <span class="font-sans text-[10px] font-black text-muted-foreground bg-secondary/50 px-1.5 py-0.5 rounded">{item.n}</span>
                        </a>
                    ))}
                </div>
            </div>

            <div class="rail-directory-module">
                <h3 class="font-sans text-[11px] font-black uppercase tracking-[0.2em] text-foreground mb-6 pb-2 border-b-2 border-foreground">{t('archive.leading_channels')}</h3>
                <div class="flex flex-col gap-1">
                    {archive.top_sources?.slice(0, 15).map((item: any) => (
                        <a href={buildFilterHref('source', item.source)} class="group flex items-center justify-between py-2 border-b border-border/40 hover:bg-secondary/20 transition-all px-1">
                            <span class="font-serif font-bold text-base group-hover:text-nyt-accent transition-colors flex items-center gap-[var(--grid-gap)]">
                                <Building2 size={12} className="opacity-30 group-hover:opacity-100 transition-opacity" />
                                {item.source}
                            </span>
                            <span class="font-sans text-[10px] font-black text-muted-foreground bg-secondary/50 px-1.5 py-0.5 rounded">{item.n}</span>
                        </a>
                    ))}
                </div>
            </div>
        </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
    .broadsheet-layout { background: var(--background); }
    .broadsheet-grid { display: grid; grid-template-columns: 1fr; gap: 4rem; }

    @media (min-width: 1024px) {
        .broadsheet-grid { grid-template-columns: 1fr; }
        .broadsheet-main { border-right: none; padding-right: 0; }
        .broadsheet-rail {   align-self: start; }
    }

    .masthead-title span { font-style: italic; font-weight: 300; }

    .archive-feed-list { position: relative; }
    .archive-feed-list::before {
        content: '';
        position: absolute;
        left: -4rem;
        top: 0;
        bottom: 0;
        width: 1px;
        background: linear-gradient(to bottom, var(--border), transparent);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        opacity: 0;
        position: absolute;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    @media (max-width: 639.98px) {
        .broadsheet-grid {
            gap: 1.5rem;
        }

        .editorial-masthead {
            margin-bottom: 1.5rem !important;
            padding-top: 0.85rem;
        }

        .masthead-top {
            margin-bottom: 1rem !important;
            align-items: flex-start !important;
        }

        .masthead-kicker {
            font-size: 0.52rem !important;
            letter-spacing: 0.14em !important;
        }

        .masthead-main {
            gap: 1rem !important;
            margin-bottom: 1rem !important;
        }

        .masthead-title {
            margin-bottom: 0.55rem !important;
            font-size: 2.35rem !important;
            line-height: 0.94 !important;
        }

        .masthead-main p.font-serif {
            font-size: 1rem !important;
            line-height: 1.45 !important;
        }

        .masthead-data-deck {
            gap: 0 !important;
        }

        .deck-stat {
            padding: 0.85rem !important;
        }

        .deck-stat span.block.text-2xl {
            font-size: 1.25rem !important;
        }

        .deck-stat span.text-\[9px\] {
            font-size: 0.5rem !important;
            letter-spacing: 0.12em !important;
        }

        .daily-briefing-highlight {
            margin-bottom: 1.25rem !important;
            padding: 1rem !important;
        }

        .daily-briefing-highlight .flex.items-center {
            margin-bottom: 0.75rem !important;
            gap: 0.45rem !important;
        }

        .daily-briefing-highlight ul {
            gap: 0.7rem !important;
        }

        .daily-briefing-highlight li {
            padding-left: 1rem !important;
            font-size: 0.96rem !important;
            line-height: 1.45 !important;
        }

        .daily-briefing-highlight li span.absolute {
            top: 0.75rem !important;
            width: 0.32rem !important;
            height: 0.32rem !important;
        }

        .archive-nav-bar {
            margin-bottom: 1.25rem !important;
            padding: 0.75rem 0 !important;
        }

        .archive-nav-bar > div {
            align-items: stretch !important;
            gap: 0.75rem !important;
        }

        .archive-nav-bar .flex.items-center.flex-wrap {
            gap: 0.6rem !important;
            justify-content: space-between;
        }

        .date-select-form,
        .date-select-form .relative {
            width: 100%;
        }

        .date-select-form input[type="date"] {
            width: 100%;
            padding: 0.75rem 0.9rem !important;
            font-size: 0.68rem !important;
            letter-spacing: 0.08em !important;
        }

        .archive-nav-bar .flex.items-center.gap-1 {
            width: 100%;
            gap: 0.45rem !important;
        }

        .archive-nav-bar .flex.items-center.gap-1 a {
            flex: 1 1 0;
            justify-content: center;
            padding: 0.75rem 0.55rem !important;
            font-size: 0.58rem !important;
            letter-spacing: 0.08em !important;
            text-align: center;
        }

        .archive-nav-bar form.w-full input[type="text"] {
            font-size: 1rem !important;
            padding-top: 0.7rem !important;
            padding-bottom: 0.7rem !important;
        }

        .archive-pulse-toggle {
            margin-bottom: 1.5rem !important;
            border-radius: 0.5rem !important;
        }

        .archive-pulse-toggle summary {
            padding: 0.9rem !important;
            align-items: flex-start !important;
            gap: 0.75rem !important;
        }

        .archive-pulse-toggle summary .p-2 {
            padding: 0.45rem !important;
        }

        .archive-pulse-toggle summary .text-\[11px\] {
            font-size: 0.58rem !important;
            letter-spacing: 0.12em !important;
        }

        .archive-pulse-toggle summary .text-xs {
            font-size: 0.72rem !important;
        }

        .archive-pulse-toggle summary .text-\[10px\] {
            font-size: 0.56rem !important;
            letter-spacing: 0.1em !important;
        }

        .archive-pulse-toggle > div.p-8 {
            padding: 0.85rem !important;
        }

        .active-filters {
            margin-bottom: 1rem !important;
            padding: 0.85rem !important;
            align-items: flex-start !important;
            gap: 0.6rem !important;
            flex-direction: column;
        }

        .active-filters > div {
            gap: 0.45rem !important;
        }

        .active-filters span.px-3 {
            padding: 0.3rem 0.55rem !important;
            font-size: 0.56rem !important;
            letter-spacing: 0.08em !important;
        }

        .active-filters .ml-auto {
            margin-left: 0 !important;
            font-size: 0.58rem !important;
            letter-spacing: 0.08em !important;
        }

        .broadsheet-rail {
            padding-left: 0 !important;
        }

        .rail-nav-block,
        .rail-module,
        .rail-directory-module {
            margin-bottom: 1rem !important;
        }

        .rail-nav-block a {
            padding: 0.9rem !important;
