---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ForYouPageIsland from '../components/ForYouPageIsland.tsx';
import { ErrorBoundary } from '../components/ui/ErrorBoundary.tsx';
import { apiBaseUrl } from '../lib/apiBase';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/for-you-premium.css';
import TinyAdzInlinedAd from '../components/TinyAdzInlinedAd.astro';
import TinyAdzRailAd from '../components/TinyAdzRailAd.astro';
import { shouldShowTinyAdzInlinedAds } from '../lib/tinyadz';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const API_URL = apiBaseUrl();
const showRailAd = shouldShowTinyAdzInlinedAds(lang, hostHeader || Astro.url.hostname);

// Fetch latest clusters to provide as potential local matches
let initialClusters = [];
let initialError: string | null = null;
try {
    const res = await fetch(`${API_URL}/news?page_size=32&lang=${lang}`);
    if (res.ok) {
        const data = await res.json();
        initialClusters = data.clusters || [];
    } else {
        initialError = lang === 'sr' ? "Ne možemo da učitamo početne preporuke u ovom trenutku." : "Не можеме да ги вчитаме почетните препораки во овој момент.";
    }
} catch (e) {
    console.error("ForYou page fetch error:", e);
    initialError = lang === 'sr' ? "Ne možemo da učitamo početne preporuke u ovom trenutku." : "Не можеме да ги вчитаме почетните препораки во овој момент.";
}
---

<Layout
    title={`${t('nav.for_you')} — Presek`}
    description={t('layout.filtered_description')}
    robots="noindex, follow"
>
    <NYTHeader />
    <main class="site-layout broadsheet-layout page-content-top pb-[var(--page-py)]">
        <Breadcrumbs items={[{ label: t('nav.for_you') }]} />

        <header class="for-you-page-header motion-rise">
            <div class="flex items-center gap-[var(--grid-gap)] mb-4">
                <div class="w-10 h-[1px] bg-nyt-accent"></div>
                <span class="page-kicker ui-label !mb-0">{t('nav.for_you')}</span>
            </div>
            <h1 class="for-you-page-title editorial-headline italic">{lang === 'mk' ? 'Ваш' : 'Vaš'} <span>{lang === 'mk' ? 'личен пресек' : 'lični presek'}</span></h1>
            <p class="for-you-page-lede editorial-intro max-w-3xl mt-6 text-[var(--text-lg)] text-muted-foreground">
                {lang === 'mk'
                    ? 'Вести подредени според темите, изворите и неодамнешното читање — без профил или лозинка.'
                    : 'Vesti poređane prema temama, izvorima i nedavnom čitanju — bez profila ili lozinke.'}
            </p>
        </header>

        <div class="broadsheet-grid mt-8 md:mt-10">
            <div class="broadsheet-main">
                <TinyAdzInlinedAd class="page-inline-ad mb-10" />
                <ErrorBoundary client:idle lang={lang}>
                    <ForYouPageIsland client:idle initialClusters={initialClusters} initialError={initialError} lang={lang} />
                </ErrorBoundary>
            </div>
            {showRailAd && (
                <aside class="broadsheet-rail ad-only-rail pl-4">
                    <TinyAdzRailAd />
                </aside>
            )}
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .for-you-page-header {
        max-width: 900px;
    }

    .for-you-page-title {
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 0.95;
    }

    .for-you-page-title span {
        font-weight: 400;
    }

    .motion-rise {
        animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes rise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .broadsheet-rail {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + 1.5rem);
    }
</style>
