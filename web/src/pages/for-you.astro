---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ForYouPageIsland from '../components/ForYouPageIsland.tsx';
import { ErrorBoundary } from '../components/ui/ErrorBoundary.tsx';
import { apiBaseUrl } from '../lib/apiBase';

const API_URL = apiBaseUrl();

// Fetch latest clusters to provide as potential local matches
let initialClusters = [];
let initialError: string | null = null;
try {
    const res = await fetch(`${API_URL}/news?page_size=100`);
    if (res.ok) {
        const data = await res.json();
        initialClusters = data.clusters || [];
    } else {
        initialError = "Ne mozeme da im vcitame pocetnite preporaki vo momentov.";
        Astro.response.status = 500;
    }
} catch (e) {
    console.error("ForYou page fetch error:", e);
    initialError = "Ne mozeme da im vcitame pocetnite preporaki vo momentov.";
    Astro.response.status = 500;
}
---

<Layout 
    title="Za Vas" 
    description="Vasiot licen pregled na vesti, prilagoden spored temite i izvorite sto im sledite."
>
    <NYTHeader />
    <main class="site-layout py-[var(--page-py)]">
        <Breadcrumbs items={[{ label: "Za Vas" }]} />
        <ErrorBoundary client:load>
            <ForYouPageIsland client:load initialClusters={initialClusters} initialError={initialError} />
        </ErrorBoundary>
    </main>
    <Footer />
</Layout>
