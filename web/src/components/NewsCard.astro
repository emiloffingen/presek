---
interface Props {
	cluster: any;
	isLead?: boolean;
}

const { cluster, isLead = false } = Astro.props;
const main = cluster.articles[0];
const sourceCount = cluster.articles.length;
const significanceLabel =
	sourceCount >= 6 ? 'Широко покриено' :
	sourceCount >= 4 ? 'Следена тема' :
	cluster.is_breaking ? 'Итен развој' :
	'Во тек';

// Handle image proxy
const thumb = cluster.representative_image || cluster.articles.find((a: any) => a.image_url)?.image_url;
const thumbSrc = thumb ? `/proxy?url=${encodeURIComponent(thumb)}` : null;

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", { "lead-story": isLead }]}>
	<div class="article-body">
		<div class="article-meta">
			<span class="source-label">{main.source}</span>
			{cluster.is_breaking && <span class="breaking-label">LIVE</span>}
			<span class="significance-label">{significanceLabel}</span>
		</div>

		<a href={`/cluster/${cluster.cluster_id}`} class="headline-link group">
			<h2 class:list={["headline", isLead ? "text-3xl md:text-4xl" : "text-xl"]}>
				{main.title}
			</h2>
		</a>

		<p class="why-it-matters">
			{sourceCount >= 6
				? `Темата се развива низ ${sourceCount} извори со пошироко медиумско покривање.`
				: sourceCount >= 4
				? `Повеќе редакции ја следат приказната и додаваат нови детали.`
				: `Клучен развој што вреди да се следи додека приказната се развива.`}
		</p>

		{main.description && (
			<p class="summary">
				{main.description.length > (isLead ? 250 : 140) 
					? main.description.substring(0, isLead ? 250 : 140) + "..." 
					: main.description}
			</p>
		)}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines">
                {cluster.articles.slice(1, 4).map((sub: any) => (
                    <li>
                        <a href={`/cluster/${cluster.cluster_id}`}>
                            {sub.title}
                        </a>
                    </li>
                ))}
            </ul>
        )}

		<div class="footer-meta">
			<span>{getTimeStr(main.created_at)}</span>
			<span class="dot">·</span>
			<span>{cluster.articles.length} извори</span>
		</div>
	</div>

	{thumbSrc && (
		<div class="image-wrap">
			<a href={`/cluster/${cluster.cluster_id}`}>
				<img 
					src={thumbSrc} 
					alt={main.title} 
					class="article-image max-h-64 md:max-h-none object-cover" 
					loading={isLead ? "eager" : "lazy"}
                    onerror="this.onerror=null; this.src='/img/placeholder.svg';"
				/>
			</a>
            {isLead && main.image_caption && (
                <p class="image-caption">{main.image_caption}</p>
            )}
		</div>
	)}
</article>

<style>
	.nyt-article {
		display: flex;
		flex-direction: column-reverse;
		gap: 1rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

    @media (min-width: 768px) {
        .lead-story {
            flex-direction: row;
            gap: 2rem;
            align-items: flex-start;
        }
        .lead-story .article-body {
            flex: 1;
        }
        .lead-story .image-wrap {
            flex: 1.5;
        }
    }

	.headline {
		font-family: var(--font-serif);
		line-height: 1.04;
		letter-spacing: -0.022em;
		margin-bottom: 0.55rem;
		color: var(--foreground);
        font-weight: 800;
        text-wrap: balance;
	}

    .headline-link:hover .headline {
        color: var(--color-nyt-gray-600);
    }

	.summary {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.62;
		color: var(--secondary-foreground);
		margin-bottom: 1rem;
        text-wrap: pretty;
	}

	.why-it-matters {
		margin: 0 0 0.8rem;
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.article-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
        color: var(--foreground);
	}

    .breaking-label {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 900;
        color: var(--nyt-red);
        border: 1px solid var(--nyt-red);
        padding: 0 4px;
    }

	.significance-label {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.footer-meta {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		color: var(--muted-foreground);
		font-weight: 500;
	}

    .image-wrap {
        width: 100%;
    }

	.article-image {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

    .image-caption {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        color: var(--muted-foreground);
        margin-top: 0.4rem;
        text-align: right;
    }

    .sub-headlines {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
        border-top: 1px solid var(--border);
        padding-top: 1rem;
    }

    .sub-headlines li {
        margin-bottom: 0.75rem;
        position: relative;
        padding-left: 1rem;
    }

    .sub-headlines li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5rem;
        width: 4px;
        height: 4px;
        background: var(--border);
        border-radius: 50%;
    }

    .sub-headlines a {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--foreground);
        text-decoration: none;
    }

    .sub-headlines a:hover {
        text-decoration: underline;
    }
</style>
