		position: relative;
		z-index: 1;
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.72);
	}

	.article-image-placeholder-title {
		margin: 0.32rem 0 0;
		position: relative;
		z-index: 1;
		max-width: 18ch;
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.16;
		color: rgba(255,255,255,0.92);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.is-error-fallback {
		background:
			linear-gradient(145deg, rgba(34, 16, 18, 0.96), rgba(96, 36, 43, 0.94) 54%, rgba(181, 90, 79, 0.82) 130%);
	}

	.image-wrap-fallback {
        aspect-ratio: 1.4 / 1;
		padding: 0.4rem;
		border: 1px solid color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
		background:
			radial-gradient(circle at top right, color-mix(in srgb, var(--secondary) 30%, transparent 70%), transparent 34%),
			linear-gradient(160deg, color-mix(in srgb, var(--background) 88%, #efe5d8 12%), color-mix(in srgb, var(--background) 76%, var(--secondary) 24%));
