---
/* Cache-bust marker for NewsCard stylesheet hashing. */
import { chooseClusterImage } from '../utils/imageSelection';
import { cleanAndDecode, isMostlyCyrillic } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { ShieldCheck } from 'lucide-react';
import type { NewsCluster, Article } from '../types';

interface Props {
	cluster: NewsCluster;
	isLead?: boolean;
	variant?: 'standard' | 'featured' | 'compact' | 'wire';
}

const { cluster, isLead = false, variant = 'standard' } = Astro.props;
const main = cluster.articles?.[0];
if (!main) return;
const sourceSignal = main?.source_signal || {};
const totalSources = cluster.articles.length;
const showTrustBadge = totalSources >= 2 && Boolean(sourceSignal.trust_label);
const showSignificanceLabel = cluster.is_breaking || totalSources >= 3;
const significanceLabel =
	totalSources >= 6 ? 'Широко покриено' :
	totalSources >= 4 ? 'Следена тема' :
	cluster.is_breaking ? 'Итен развој' :
	'Во тек';

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;

const displayTitle = cleanAndDecode(main.title);
const titleIsCyrillic = isMostlyCyrillic(displayTitle);

const uniqueSources = new Set(cluster.articles.map(a => a.source)).size;

function getCardSummary(article: Article, lead = false) {
	let text = article?.summary || article?.description || '';
	
	// Safety check for JSON leakage - can be raw or double-escaped from DB
	const trimmed = typeof text === 'string' ? text.trim() : '';
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			// If it contains &quot;, it's already been through an escaping cycle
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) text = parsed.summary;
				else if (parsed.text) text = parsed.text;
			}
		} catch (e) {
			// Not valid JSON
		}
	}
	
	text = cleanAndDecode(text);
	if (!text) return '';
	const limit = lead ? 250 : 170;
	return text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
}

const displaySummary = getCardSummary(main, isLead);
const summaryIsCyrillic = isMostlyCyrillic(displaySummary);

function getWhyItMatters() {
	if (sourceSignal.role_label && totalSources >= 4) {
		return `${sourceSignal.role_label}. Темата веќе се потврдува и се проширува низ повеќе редакции.`;
	}
	if (sourceSignal.role_label && totalSources >= 2) {
		return `${sourceSignal.role_label}. Следете ја за нови потврди и реакции.`;
	}
	if (totalSources >= 6) {
		return `Развој со широко медиумско покривање од ${totalSources} извори.`;
	}
	if (totalSources >= 4) {
		return 'Повеќе редакции веќе додаваат нови детали.';
	}
	if (totalSources >= 2) {
		return 'Приказна што почнува да добива потврди и поширок контекст.';
	}
	return 'Приказна што вреди да се следи.';
}


const whyItMatters = getWhyItMatters();

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", `variant-${variant}`, { "lead-story": isLead }]} data-cluster={JSON.stringify(cluster)}>
	<div class="article-body">
		<div class="article-meta">
			<span class="source-label">{main.source}</span>
			{showTrustBadge && <span class={`source-trust-badge source-trust-${sourceSignal.trust_label === 'Висока доверба' ? 'high' : sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>{sourceSignal.trust_label}</span>}
			{cluster.is_breaking && <span class="breaking-label">Во живо</span>}
			{cluster.articles.some(a => a.is_fact_check) && (
				<span class="fact-check-badge">
					<ShieldCheck size={10} /> ФАКТ-ЧЕК
				</span>
			)}
			{showSignificanceLabel && <span class="significance-label">{significanceLabel}</span>}
		</div>

		<a href={`/cluster/${cluster.cluster_id}`} class="headline-link group">
			<h2 class:list={["headline", isLead ? "headline-lead" : "headline-standard", { "headline-cyrillic": titleIsCyrillic }]} set:html={sanitizeHtml(displayTitle)}>
			</h2>
		</a>

		{!isLead && variant === 'compact' ? null : (
			<div class="card-content-stack">
				<p class="why-it-matters">
					{whyItMatters}
				</p>

				{displaySummary && (
					<p class:list={["summary", { "summary-cyrillic": summaryIsCyrillic }]} set:html={sanitizeHtml(displaySummary)}>
					</p>
				)}
			</div>
		)}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines">
                {cluster.articles.slice(1).filter(a => !a.is_redundant).slice(0, 3).map((sub: Article) => (
                    <li>
                        <a href={`/cluster/${cluster.cluster_id}`} set:html={sanitizeHtml(cleanAndDecode(sub.title))}>
                        </a>
                    </li>
                ))}
            </ul>
        )}


		<div class="footer-meta">
			<span>{getTimeStr(main.created_at)}</span>
			<span class="dot">·</span>
			<span>{uniqueSources} {uniqueSources === 1 ? 'извор' : 'извори'}</span>
			{totalSources > uniqueSources && <span class="text-muted-foreground ml-1">({totalSources} вкупно)</span>}
		</div>
		</div>

		{thumbSrc && (
		<div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]}>
			<a href={`/cluster/${cluster.cluster_id}`} class="block h-full">
				{isFallbackArt ? (
					<div class="article-image-placeholder">
						<div class="article-image-placeholder-topline">
							<p class="article-image-placeholder-label">Пресек Избор</p>
							<p class="article-image-placeholder-chip">{uniqueSources} {uniqueSources === 1 ? 'извор' : 'извори'}</p>
						</div>
						<h3>{main?.category || 'Вести'}</h3>
						<p class="article-image-placeholder-source">{main.source}</p>
						<p class:list={["article-image-placeholder-title", { "article-image-placeholder-title-cyrillic": titleIsCyrillic }]}>{displayTitle}</p>
					</div>
				) : (
					<img
						src={thumbSrc}
						alt={displayTitle}
						width="700"
						height="500"
						class="article-image"
						transition:name={`cluster-image-${cluster.cluster_id}`}
						loading={isLead ? "eager" : "lazy"}
						decoding="async"
						fetchpriority={isLead ? "high" : "auto"}
						onload="this.classList.add('is-loaded')"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="article-image-placeholder is-error-fallback" style="display: none;">
						<div class="article-image-placeholder-topline">
							<p class="article-image-placeholder-label">Пресек Избор</p>
							<p class="article-image-placeholder-chip">Без визуел</p>
						</div>
						<p class="article-image-placeholder-source">{main.source}</p>
						<p class:list={["article-image-placeholder-title", { "article-image-placeholder-title-cyrillic": titleIsCyrillic }]}>{displayTitle}</p>
					</div>
				)}
			</a>
            {isLead && main.image_caption && (
                <p class="image-caption">{main.image_caption}</p>
            )}
		</div>
	)}
</article>

<style>
	.nyt-article {
		--news-card-cache-bust-20260414: 1;
	}
</style>
