    }

	.summary {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.62;
		color: var(--secondary-foreground);
		margin-bottom: 1rem;
        text-wrap: pretty;
		display: -webkit-box;
		-webkit-line-clamp: 4;
