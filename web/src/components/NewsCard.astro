---
import { chooseClusterImage } from '../utils/imageSelection';
import { cleanAndDecode } from '../utils/textUtils';
import { ShieldCheck } from 'lucide-react';

interface Props {
	cluster: any;
	isLead?: boolean;
}

const { cluster, isLead = false } = Astro.props;
const main = cluster.articles[0];
const sourceSignal = main?.source_signal || {};
const sourceCount = cluster.articles.length;
const significanceLabel =
	sourceCount >= 6 ? 'Широко покриено' :
	sourceCount >= 4 ? 'Следена тема' :
	cluster.is_breaking ? 'Итен развој' :
	'Во тек';

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;

const displayTitle = cleanAndDecode(main.title);

function getCardSummary(article: any, lead = false) {
	let text = article?.summary || article?.description || '';
	
	// Safety check for JSON leakage - can be raw or double-escaped from DB
	const trimmed = typeof text === 'string' ? text.trim() : '';
	if (trimmed.startsWith('{') || trimmed.startsWith('&lt;%') || trimmed.includes('&quot;summary&quot;')) {
		try {
			// If it contains &quot;, it's already been through an escaping cycle
			const toParse = trimmed.includes('&quot;') ? cleanAndDecode(trimmed) : trimmed;
			if (toParse.startsWith('{')) {
				const parsed = JSON.parse(toParse);
				if (parsed.summary) text = parsed.summary;
				else if (parsed.text) text = parsed.text;
			}
		} catch (e) {
			// Not valid JSON
		}
	}
	
	text = cleanAndDecode(text);
	if (!text) return '';
	const limit = lead ? 250 : 170;
	return text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
}

const displaySummary = getCardSummary(main, isLead);

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", { "lead-story": isLead }]}>
	<div class="article-body">
		<div class="article-meta">
			<span class="source-label">{main.source}</span>
			{sourceSignal.trust_label && <span class={`source-trust-badge source-trust-${sourceSignal.trust_label === 'Висока доверба' ? 'high' : sourceSignal.trust_label === 'Потврден извор' ? 'medium' : 'low'}`}>{sourceSignal.trust_label}</span>}
			{cluster.is_breaking && <span class="breaking-label">Во живо</span>}
			{cluster.has_fact_check && (
				<span class="fact-check-badge">
					<ShieldCheck size={10} /> ФАКТ-ЧЕК
				</span>
			)}
			<span class="significance-label">{significanceLabel}</span>
		</div>

		<a href={`/cluster/${cluster.cluster_id}`} class="headline-link group">
			<h2 class:list={["headline", isLead ? "headline-lead" : "headline-standard"]} set:html={displayTitle}>
			</h2>
		</a>

		<p class="why-it-matters">
			{sourceSignal.role_label
				? `${sourceSignal.role_label}. ${sourceCount >= 4 ? 'Повеќе редакции веќе ја потврдуваат или прошируваат темата.' : 'Следете ја приказната за нови потврди и реакции.'}`
				: sourceCount >= 6
				? `Темата се развива низ ${sourceCount} извори со пошироко медиумско покривање.`
				: sourceCount >= 4
				? `Повеќе редакции ја следат приказната и додаваат нови детали.`
				: `Клучен развој што вреди да се следи додека приказната се развива.`}
		</p>

		{displaySummary && (
			<p class="summary" set:html={displaySummary}>
			</p>
		)}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines">
                {cluster.articles.slice(1, 4).map((sub: any) => (
                    <li>
                        <a href={`/cluster/${cluster.cluster_id}`} set:html={cleanAndDecode(sub.title)}>
                        </a>
                    </li>
                ))}
            </ul>
        )}

		<div class="footer-meta">
			<span>{getTimeStr(main.created_at)}</span>
			<span class="dot">·</span>
			<span>{cluster.articles.length} извори</span>
		</div>
	</div>

	{thumbSrc && (
		<div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]}>
			<a href={`/cluster/${cluster.cluster_id}`} class="block h-full">
				{isFallbackArt ? (
					<div class="article-image-placeholder">
						<p class="article-image-placeholder-label">Пресек Преглед</p>
						<h3>{cluster.articles[0].category || 'Вести'}</h3>
					</div>
				) : (
					<img
						src={thumbSrc}
						alt={displayTitle}
						width="700"
						height="500"
						class="article-image"
						loading={isLead ? "eager" : "lazy"}
						decoding="async"
						fetchpriority={isLead ? "high" : "auto"}
						onload="this.classList.add('is-loaded')"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="article-image-placeholder is-error-fallback" style="display: none;">
						<p class="article-image-placeholder-label">Сликата не е достапна</p>
						<span class="text-xs opacity-60 uppercase font-bold tracking-tighter">Пресек</span>
					</div>
				)}
			</a>
            {isLead && main.image_caption && (
                <p class="image-caption">{main.image_caption}</p>
            )}
		</div>
	)}
</article>

<style>
	.nyt-article {
		display: flex;
		flex-direction: column-reverse;
		gap: 1rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.nyt-article:not(.lead-story) {
		height: 100%;
	}

	.article-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

    @media (min-width: 768px) {
        .lead-story {
            flex-direction: row;
            gap: 2rem;
            align-items: flex-start;
        }
        .lead-story .article-body {
            flex: 1;
        }
        .lead-story .image-wrap {
            flex: 1.5;
        }
    }

	.headline {
		font-family: var(--font-serif);
		line-height: 1.04;
		letter-spacing: -0.022em;
		margin-bottom: 0.55rem;
		color: var(--foreground);
        font-weight: 760;
        text-wrap: balance;
	}

	.headline-lead {
		font-size: clamp(2.15rem, 1.8rem + 1.4vw, 2.7rem);
		line-height: 1.02;
	}

	.headline-standard {
		font-size: 1.18rem;
		line-height: 1.08;
	}

    .headline-link:hover .headline {
        color: var(--link-hover);
    }

	.summary {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.62;
		color: var(--secondary-foreground);
		margin-bottom: 1rem;
        text-wrap: pretty;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.nyt-article:not(.lead-story) .summary {
		-webkit-line-clamp: 3;
	}

	.why-it-matters {
		margin: 0 0 0.8rem;
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}

	.article-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
        color: var(--foreground);
	}

	.source-trust-badge {
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 900;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		padding: 0.08rem 0.32rem;
		border: 1px solid var(--border);
        background: color-mix(in srgb, var(--card) 82%, var(--surface-soft) 18%);
	}

	.source-trust-high {
		color: var(--nyt-accent);
		border-color: color-mix(in srgb, var(--nyt-accent) 34%, var(--border) 66%);
	}

	.source-trust-medium {
		color: color-mix(in srgb, var(--foreground) 82%, var(--muted-foreground) 18%);
	}

	.source-trust-low {
		color: var(--muted-foreground);
	}

    .breaking-label {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 900;
        color: var(--nyt-red);
        border: 1px solid var(--nyt-red);
        padding: 0 4px;
        background: color-mix(in srgb, var(--card) 82%, var(--surface-soft) 18%);
    }

	.fact-check-badge {
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		color: #059669;
		border: 1px solid #059669;
		padding: 0 4px;
		display: inline-flex;
		align-items: center;
		gap: 2px;
		background: #f0fdf4;
	}

	.significance-label {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.footer-meta {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		color: var(--muted-foreground);
		font-weight: 500;
		margin-top: auto;
	}

    .image-wrap {
        width: 100%;
		position: relative;
        aspect-ratio: 1.4 / 1;
        overflow: hidden;
    }

	.article-image {
		width: 100%;
        height: 100%;
		object-fit: cover;
		object-position: center top;
		border: 1px solid var(--border);
	}

	.article-image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 1rem;
		background: 
			radial-gradient(circle at top right, color-mix(in srgb, var(--nyt-accent) 8%, transparent), transparent 40%),
			linear-gradient(135deg, var(--secondary) 0%, color-mix(in srgb, var(--background) 80%, var(--secondary) 20%) 100%);
		border: 1px solid var(--border);
	}

	.article-image-placeholder-label {
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--nyt-accent);
		margin-bottom: 0.4rem;
	}

	.article-image-placeholder h3 {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.1;
		color: var(--foreground);
		max-width: 12ch;
		margin: 0;
	}

	.is-error-fallback {
		background: var(--muted);
	}

	.image-wrap-fallback {
        aspect-ratio: 1.4 / 1;
		padding: 0.35rem;
		border: 1px solid color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
		background:
			radial-gradient(circle at top right, color-mix(in srgb, var(--secondary) 36%, transparent 64%), transparent 34%),
			linear-gradient(160deg, color-mix(in srgb, var(--background) 90%, #f6eee5 10%), color-mix(in srgb, var(--background) 80%, var(--secondary) 20%));
	}

	.article-image-fallback {
		aspect-ratio: 8 / 5;
		object-fit: cover;
		background: color-mix(in srgb, var(--background) 80%, #f4ede3 20%);
	}

	.fallback-badge {
		position: absolute;
		left: 0.7rem;
		top: 0.7rem;
		padding: 0.22rem 0.42rem;
		border: 1px solid color-mix(in srgb, var(--border) 64%, var(--foreground) 36%);
		background: color-mix(in srgb, var(--background) 95%, transparent 5%);
		font-family: var(--font-sans);
		font-size: 0.54rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--foreground) 82%, var(--muted-foreground) 18%);
		opacity: 0.88;
	}

    .image-caption {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        color: var(--muted-foreground);
        margin-top: 0.4rem;
        text-align: right;
    }

    .sub-headlines {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
        border-top: 1px solid var(--border);
        padding-top: 1rem;
    }

    .sub-headlines li {
        margin-bottom: 0.75rem;
        position: relative;
        padding-left: 1rem;
    }

    .sub-headlines li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5rem;
        width: 4px;
        height: 4px;
        background: var(--border);
        border-radius: 50%;
    }

    .sub-headlines a {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--foreground);
        text-decoration: none;
    }

    .sub-headlines a:hover {
        text-decoration: underline;
    }

	@media (min-width: 768px) {
		.headline-lead {
			font-size: 2.25rem;
			line-height: 0.98;
		}
	}

	@media (max-width: 767px) {
		.nyt-article:not(.lead-story) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) clamp(6.4rem, 28vw, 7.6rem);
			align-items: start;
			gap: 0.95rem;
			padding-bottom: 1.1rem;
		}

		.nyt-article:not(.lead-story) .article-body {
			grid-column: 1;
			grid-row: 1;
		}

		.nyt-article:not(.lead-story) .image-wrap {
			grid-column: 2;
			grid-row: 1;
		}

		.nyt-article:not(.lead-story) .article-image,
		.nyt-article:not(.lead-story) .article-image-fallback {
			aspect-ratio: 1 / 1;
			height: auto;
			max-height: 7.75rem;
		}

		.nyt-article:not(.lead-story) .headline-standard {
			font-size: 1.1rem;
			line-height: 1.1;
			margin-bottom: 0.4rem;
		}

		.nyt-article:not(.lead-story) .article-meta {
			margin-bottom: 0.4rem;
			gap: 0.35rem 0.45rem;
		}

		.nyt-article:not(.lead-story) .why-it-matters {
			display: none;
		}

		.nyt-article:not(.lead-story) .summary {
			font-size: 0.92rem;
			line-height: 1.52;
			-webkit-line-clamp: 3;
			margin-bottom: 0.6rem;
		}

		.nyt-article:not(.lead-story) .footer-meta {
			font-size: 0.64rem;
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}

		.nyt-article:not(.lead-story) .fallback-badge {
			left: 0.45rem;
			top: 0.45rem;
			padding: 0.16rem 0.28rem;
			font-size: 0.46rem;
		}
	}

	@media (max-width: 640px) {
		.article-image {
			aspect-ratio: 16 / 10;
			max-height: 14rem;
			object-fit: cover;
		}

		.article-image-fallback {
			max-height: none;
		}
	}
</style>
