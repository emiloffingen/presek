    }

	.fact-check-badge {
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		color: #059669;
		border: 1px solid #059669;
		padding: 0 4px;
		display: inline-flex;
		align-items: center;
		gap: 2px;
		background: #f0fdf4;
	}

	.significance-label {
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.footer-meta {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		color: var(--muted-foreground);
		font-weight: 500;
		margin-top: auto;
	}

    .image-wrap {
        width: 100%;
		position: relative;
        aspect-ratio: 1.4 / 1;
        overflow: hidden;
    }

	.nyt-article.variant-wire:not(.lead-story) .image-wrap {
		width: clamp(5.2rem, 20vw, 6.4rem);
		aspect-ratio: 1 / 1;
	}

	.article-image {
		width: 100%;
        height: 100%;
		object-fit: cover;
		object-position: center top;
		border: 1px solid var(--border);
	}

	.article-image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		text-align: left;
		padding: 1.1rem;
		position: relative;
		overflow: hidden;
		background: 
			linear-gradient(145deg, rgba(8, 14, 28, 0.96), rgba(20, 45, 84, 0.92) 54%, rgba(198, 133, 64, 0.78) 130%);
		border: 1px solid color-mix(in srgb, var(--border) 68%, rgba(255,255,255,0.2) 32%);
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.1),
			0 18px 40px rgba(8, 14, 28, 0.18);
	}

	.article-image-placeholder::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at top left, rgba(255,255,255,0.18), transparent 32%),
			linear-gradient(180deg, transparent 0%, rgba(7, 12, 22, 0.06) 42%, rgba(7, 12, 22, 0.34) 100%);
		pointer-events: none;
	}

	.article-image-placeholder::after {
		content: "";
		position: absolute;
		inset: auto 0 0 auto;
		width: 72%;
		height: 72%;
		background:
			repeating-linear-gradient(
				135deg,
				rgba(255,255,255,0.08) 0,
				rgba(255,255,255,0.08) 1px,
				transparent 1px,
				transparent 12px
			);
		opacity: 0.42;
		mask-image: linear-gradient(180deg, transparent, rgba(0,0,0,0.9));
		pointer-events: none;
	}

	.article-image-placeholder-topline {
		position: relative;
		z-index: 1;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
	}

	.article-image-placeholder-label {
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.82);
		margin: 0;
	}

	.article-image-placeholder-chip {
		margin: 0;
		padding: 0.28rem 0.5rem 0.24rem;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.54rem;
		font-weight: 800;
		letter-spacing: 0.08em;
