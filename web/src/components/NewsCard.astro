---
interface Props {
	cluster: any;
	isLead?: boolean;
}

const { cluster, isLead = false } = Astro.props;
const main = cluster.articles[0];

// Handle image proxy
const thumb = cluster.representative_image || cluster.articles.find((a: any) => a.image_url)?.image_url;
const thumbSrc = thumb ? `/proxy?url=${encodeURIComponent(thumb)}` : null;

// Simple relative time for SSR
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' });
    } catch {
        return '';
    }
}
---

<article class:list={["news-cluster", { "lead-story": isLead }]}>
	{thumbSrc && (
		<div class="cluster-thumb-wrap">
			<a href={`/cluster/${cluster.cluster_id}`}>
				<img 
					src={thumbSrc} 
					alt={main.title} 
					class="cluster-thumb" 
					loading={isLead ? "eager" : "lazy"}
				/>
			</a>
		</div>
	)}

	<div class="cluster-main">
		<div class="cluster-meta">
			<span class="text-accent">{main.source}</span>
			<span class="dot">·</span>
			<span>{getTimeStr(main.created_at)}</span>
			{cluster.is_breaking && (
				<span class="breaking-dot">● LIVE</span>
			)}
		</div>

		<a href={`/cluster/${cluster.cluster_id}`} class="headline-link">
			<h2 class:list={["cluster-headline", isLead ? "text-lead" : "text-standard"]}>
				{main.title}
			</h2>
		</a>

		{main.description && (
			<p class="cluster-excerpt">
				{main.description.length > (isLead ? 200 : 120) 
					? main.description.substring(0, isLead ? 200 : 120) + "..." 
					: main.description}
			</p>
		)}

		{isLead && cluster.articles.length > 1 && (
			<div class="lead-sub-headlines">
				{cluster.articles.slice(1, 4).map((sub: any) => (
					<div class="sub-h-item">
						<span class="sub-source">{sub.source}:</span>
						<a href={`/cluster/${cluster.cluster_id}`} class="sub-link">
							{sub.title}
						</a>
					</div>
				))}
			</div>
		)}

		<div class="cluster-meta footer-meta">
			<span>{cluster.articles.length} извори анализирани</span>
		</div>
	</div>
</article>

<style>
	.news-cluster {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
	}

	.cluster-thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-cover: cover;
		border-radius: 2px;
		filter: grayscale(20%);
		transition: filter 0.3s ease;
	}

	.news-cluster:hover .cluster-thumb {
		filter: grayscale(0%);
	}

	.cluster-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.text-accent {
		color: var(--accent-color);
	}

	.breaking-dot {
		color: var(--accent-color);
		margin-left: 0.25rem;
	}

	.headline-link {
		text-decoration: none;
		color: var(--text-primary);
	}

	.cluster-headline {
		margin: 0;
		line-height: 1.2;
		font-weight: 800;
	}

	.text-lead {
		font-size: 2rem;
	}

	.text-standard {
		font-size: 1.25rem;
	}

	.cluster-excerpt {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-secondary);
		margin: 0;
	}

	.lead-sub-headlines {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.sub-h-item {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
	}

	.sub-source {
		font-size: 0.65rem;
		font-weight: 900;
		text-transform: uppercase;
		color: var(--text-muted);
		flex-shrink: 0;
	}

	.sub-link {
		font-family: var(--nyt-font-serif);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--text-primary);
		text-decoration: none;
		line-height: 1.3;
	}

	.footer-meta {
		margin-top: auto;
		padding-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.text-lead {
			font-size: 1.5rem;
		}
	}
</style>
