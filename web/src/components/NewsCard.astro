---
/* Cache-bust marker for NewsCard stylesheet hashing. */
import { chooseClusterImage } from '../utils/imageSelection';
import { getDisplayTitle, getDisplaySummary, isMostlyCyrillic, highlightScores, slugify, getDesignCardContext, transliterate, cleanAndDecode } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { Clock, Layers, ShieldCheck, Globe, Sparkles, Zap, AlertCircle, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import type { NewsCluster, Article } from '../types';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	cluster: NewsCluster;
	isLead?: boolean;
	variant?: 'standard' | 'featured' | 'compact' | 'wire';
    bentoSpan?: '1x1' | '2x1' | '2x2';
    lang?: string;
}

const { cluster, isLead = false, variant = 'standard', bentoSpan, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

const main = cluster.articles?.[0];
if (!main) return;
const sourceSignal = main?.source_signal || {};
const totalSources = cluster.articles.length;
const showTrustBadge = totalSources >= 2 && Boolean(sourceSignal.trust_label);
const showSignificanceLabel = cluster.is_breaking || totalSources >= 3;
const significanceLabel =
	totalSources >= 6 ? t('news.breaking') :
	totalSources >= 4 ? t('news.tracked') :
	cluster.is_breaking ? t('news.urgent') :
	t('news.ongoing');

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;
const tintColor = cluster.dominant_color || '#1e40af';
const rawLeadTitle = cluster.synthetic_headline || getDisplayTitle(main);

let displayTitle = highlightScores(cluster.synthetic_headline || getDisplayTitle(main));
if (lang === 'sr' && isMostlyCyrillic(displayTitle)) {
    displayTitle = highlightScores(transliterate(cluster.synthetic_headline || getDisplayTitle(main)));
}
const titleIsCyrillic = isMostlyCyrillic(displayTitle);

const clusterSlug = slugify(cluster.synthetic_headline || getDisplayTitle(main));
const clusterUrl = `${l('/cluster/')}${cluster.cluster_id}-${clusterSlug}`;

const uniqueSources = new Set(cluster.articles.map(a => a.source)).size;

const cardContext = getDesignCardContext(cluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent = 
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const slimCluster = {
	cluster_id: cluster.cluster_id,
	is_breaking: cluster.is_breaking,
	topics: cluster.topics,
	tags: cluster.tags,
	homepage_score: cluster.homepage_score,
	articles: cluster.articles.map((a, i) => (i === 0 ? {
		source: a.source,
		category: a.category,
		topic: a.topic,
	} : { source: a.source })),
};

function getCardSummary(article: Article, lead = false) {
	const text = getDisplaySummary(article);
	if (!text) return '';
	const limit = lead ? 300 : 180;
	const truncated = text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
	return highlightScores(truncated);
}

let displaySummary = cluster.synthetic_standfirst || getCardSummary(main, isLead);
if (lang === 'sr' && isMostlyCyrillic(displaySummary)) {
    displaySummary = highlightScores(transliterate(cleanAndDecode(cluster.synthetic_standfirst || getCardSummary(main, isLead))));
}
const summaryIsCyrillic = isMostlyCyrillic(displaySummary);

const hasSynthesis = cluster.has_synthesis;

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr.replace("Z", ""));
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        return date.toLocaleTimeString(lang === 'sr' ? 'sr-RS' : 'mk-MK', { 
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Belgrade'
        });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", `variant-${variant}`, { "lead-story": isLead, "premium-spotlight": showTrustBadge, "has-image": !!thumbSrc }, bentoSpan ? `bento-${bentoSpan}` : ""]} data-cluster={JSON.stringify(slimCluster)}>
	<div class="article-body flex flex-col justify-between h-full">
        <div class="flex-grow">
            <div class="article-meta-v2">
                <div class="kicker-group">
                    <span class="kicker">{main.source}</span>
                    {showTrustBadge && sourceSignal.trust_label === 'Visoko poverenje' && (
                        <ShieldCheck size={10} className="text-blue-500" title="Proveren izvor" />
                    )}
                    {main.is_global && (
                        <Globe size={10} className="text-emerald-500" title="Globalna vest" />
                    )}
                </div>
                <div class="meta-right">
                    {showSignificanceLabel && (
                        <span class:list={["significance-badge", { "is-breaking": cluster.is_breaking }]} aria-label={`Status: ${significanceLabel}`}>
                            {significanceLabel}
                        </span>
                    )}
                    <span class="time-stamp" aria-label="Vreme objave">{getTimeStr(main.ingested_at || main.created_at)}</span>
                </div>
            </div>


            <a href={clusterUrl} class="headline-link group" onmouseenter={`fetch('${clusterUrl}', { priority: 'low' })`}>
                <h2 class:list={["headline", isLead ? "headline-lead" : (variant === 'compact' || variant === 'wire' ? "headline-compact" : "headline-standard"), { "headline-cyrillic": titleIsCyrillic }]} set:html={sanitizeHtml(displayTitle)}>
                </h2>
            </a>

            <div class="middle-content-wrap">
                {hasSynthesis && (
                    <span class="editorial-byline" aria-label="Sinteza vesti">
                        <Sparkles size={11} className="inline-block mr-1 text-nyt-accent" aria-hidden="true" />
                        {t('news.synthesis')}
                    </span>
                )}

                {!isLead && variant === 'compact' ? null : (
                    <div class="card-content-stack">
                        {displaySummary && (
                            <div class="summary-container" tabindex="0" role="button" aria-expanded="false" aria-label="Klikni za prikaz celog rezimea">
                                <p class:list={["summary", { "summary-cyrillic": summaryIsCyrillic }]} set:html={sanitizeHtml(displaySummary)}></p>
                            </div>
                        )}
                    </div>
                )}

                {isLead && cluster.articles.length > 1 && (
                    <ul class="sub-headlines" aria-label="Povezane vesti">
                        {cluster.articles.slice(1).filter(a => !a.is_redundant).slice(0, 3).map((sub: Article) => (
                            <li>
                                <a href={clusterUrl} set:html={sanitizeHtml(getDisplayTitle(sub, '', lang))}>
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>

		<div class="footer-meta mt-auto pt-2 flex items-center gap-4">
			<span class="flex items-center gap-1" aria-label="Vreme">
		<Clock size={11} className="opacity-70" aria-hidden="true" />
		{getTimeStr(main.ingested_at || main.created_at)}
		</span>
			<span class="flex items-center gap-1" aria-label="Broj izvora">
		<Layers size={11} className="opacity-70" aria-hidden="true" />
		{uniqueSources} {uniqueSources === 1 ? t('news.source') : t('news.sources')}
		{totalSources > uniqueSources && <span class="text-muted-foreground ml-0.5" aria-label="Ukupno članaka">({totalSources})</span>}
		</span>
		</div>

		</div>

		{thumbSrc && (
		<div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]}>
			<a href={clusterUrl} class="block h-full">
				{isFallbackArt ? (
					<div class="article-image-placeholder design-card" style={`--placeholder-bg: ${tintColor};`}>
                        <div class="design-card-pattern"></div>
                        <div class="design-card-ribbon">
                            <span>{cardLabel}</span>
                        </div>
                        <div class="design-card-main">
                            <div class="design-card-icon-wrap">
                                <IconComponent size={32} strokeWidth={1.5} className="text-white/90" />
                            </div>
                            <h3 class:list={[{ "headline-cyrillic": titleIsCyrillic }]}>{rawLeadTitle}</h3>
                            <p class="design-card-sub">{cardSub}</p>
                        </div>
                        <div class="design-card-footer">
                            <span class="design-card-cta">{t('news.go_to_article')} <ArrowRight size={12} className="ml-1" /></span>
                        </div>
					</div>
				) : (
					<div class="relative w-full h-full">
						<img
							src={thumbSrc}
                            srcset={`${thumbSrc.replace('w=720', 'w=360')} 360w, ${thumbSrc} 720w, ${thumbSrc.replace('w=720', 'w=1200')} 1200w`}
                            sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
							alt={displayTitle}
							width="700"
							height="500"
							class="article-image"
							{...(isLead ? { 'transition:name': `cluster-image-${cluster.cluster_id}` } : {})}
							loading={isLead ? "eager" : "lazy"}
							decoding="async"
							fetchpriority={isLead ? "high" : "auto"}
							onload="this.classList.add('is-loaded')"
							onerror="this.style.opacity='0'; this.nextElementSibling.style.display='grid'; this.closest('.nyt-article').classList.remove('has-image');"
						/>
						<div class="article-image-placeholder design-card is-error-fallback absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
							<div class="design-card-pattern opacity-5"></div>
							<div class="design-card-main p-4 flex items-center justify-center h-full">
								<Newspaper size={24} className="text-white/20" />
							</div>
						</div>
					</div>
				)}
			</a>
            {isFallbackArt && (
                <span class="fallback-badge-icon" title="Presek grafika">
                    <Palette size={14} />
                </span>
            )}
            {isLead && main.image_caption && (
                <p class="image-caption">{main.image_caption}</p>
            )}
		</div>
		)}
		</article>
<style>
	.nyt-article {
		--news-card-cache-bust-20260424: 1;
		min-width: 0;
		max-width: 100%;
        padding-bottom: 0.75rem;
	}

	.headline-link {
	    display: block;
	    min-width: 0;
	    max-width: 100%;
	    transition: transform 0.3s var(--ease-editorial);
	}

	@media (hover: hover) {
        .headline-link:hover {
            transform: translateX(4px);
        }

        .headline-link:hover .headline {
            color: var(--nyt-accent);
        }
    }

    .nyt-article:active {
        transform: scale(0.99);
        transition: transform 0.1s ease;
    }

    /* --- Premium Meta Styles --- */
    .article-meta-v2 {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
    }

    .kicker-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .meta-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-left: auto;
    }

    .significance-badge {
        font-family: var(--font-sans);
        font-size: 0.55rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted-foreground);
        padding: 0.15rem 0.4rem;
        background: var(--secondary);
        border-radius: 2px;
        opacity: 0.8;
        white-space: normal;
        word-break: break-word;
        line-height: 1.2;
    }

    .significance-badge.is-breaking {
        color: white;
        background: var(--nyt-red, #d0021b);
        opacity: 1;
    }

    .time-stamp {
        font-family: var(--font-sans);
        font-size: 0.55rem;
        font-weight: 800;
        color: var(--muted-foreground);
        opacity: 0.5;
        letter-spacing: 0.02em;
    }

    .editorial-byline {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--nyt-accent);
        margin-bottom: 0.75rem;
        padding: 0.2rem 0.6rem;
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border-radius: 4px;
        width: fit-content;
    }

    .why-it-matters {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        line-height: 1.5;
        color: var(--muted-foreground);
        margin-bottom: 0.85rem;
        padding-left: 0.75rem;
        border-left: 3px solid color-mix(in srgb, var(--nyt-accent) 30%, var(--border));
        font-style: italic;
    }

    .why-it-matters .label {
        font-weight: 900;
        font-style: normal;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        color: var(--foreground);
        margin-right: 0.4rem;
        opacity: 0.8;
    }
    .intel-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.15rem 0.45rem;
        border-radius: 2px;
    }

    .badge-balanced {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }
    .dark .badge-balanced {
        background: #064e3b20;
        color: #34d399;
        border-color: #064e3b;
    }

    .badge-research {
        color: var(--nyt-accent);
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
    }

    .badge-pulse {
        color: #9333ea;
        background: #faf5ff;
        border: 1px solid #f3e8ff;
    }
    .dark .badge-pulse {
        background: #581c8720;
        color: #c084fc;
        border-color: #581c87;
    }

    .fallback-badge-icon {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        padding: 0.35rem;
        border-radius: 4px;
        backdrop-filter: blur(4px);
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .summary-container {
        max-height: 4.5em; /* Approximately 3 lines */
        overflow: hidden;
        transition: max-height 0.6s var(--ease-editorial), opacity 0.4s ease;
        position: relative;
        cursor: pointer;
    }
    .article-body:hover .summary-container,
    .summary-container:focus-within {
        max-height: 32em; /* Expand to show full summary */
        z-index: 10;
    }
    .summary-container:not(:hover):not(:focus-within) {
        max-height: 4.5em;
    }

    /* --- World-Class Design Card (Fallback) --- */
    .article-image-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        align-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
        background: 
            linear-gradient(165deg, 
                color-mix(in srgb, var(--placeholder-bg, #070c16) 100%, #1a1a1a) 0%, 
                color-mix(in srgb, var(--placeholder-bg, #070c16) 80%, black) 100%
            );
        border: 1px solid color-mix(in srgb, var(--placeholder-bg, var(--border)) 40%, var(--border));
        transition: transform 0.6s var(--ease-editorial);
    }
    .nyt-article:hover .article-image-placeholder {
        transform: scale(1.02);
    }

    .design-card-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.12;
        background-image: 
            radial-gradient(circle at 2px 2px, rgba(255,255,255,0.2) 1px, transparent 0),
            linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 24px 24px, 120px 120px, 120px 120px;
        z-index: 0;
    }

    .design-card-ribbon {
        position: absolute;
        top: 0;
        left: 0;
        background: var(--nyt-accent);
        color: white;
        padding: 0.45rem 1.25rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 950;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        z-index: 3;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        min-width: max-content;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .design-card-main {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.25rem;
    }

    .design-card-icon-wrap {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        backdrop-filter: blur(4px);
    }

    .design-card h3 {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 950;
        line-height: 1.1;
        color: white;
        margin: 0;
        text-wrap: balance;
        letter-spacing: -0.01em;
    }

    .design-card-sub {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: rgba(255,255,255,0.5);
        margin: 0;
    }

    .design-card-footer {
        position: absolute;
        bottom: 0.75rem;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        z-index: 2;
    }

    .design-card-cta {
        font-family: var(--font-sans);
        font-size: 0.48rem;
        font-weight: 950;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.7);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.3s ease;
    }

    .nyt-article:hover .design-card-cta {
        color: white;
        transform: translateY(-2px);
    }

	@media (min-width: 768px) {
		.headline-lead {
			font-size: 2.25rem;
			line-height: 0.98;
		}
        /* New styles for standard card headlines on larger screens */
        .headline-standard,
        .headline-compact,
        .headline-wire {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
	}

	@media (max-width: 767px) {
		.headline-lead {
			font-size: 1.5rem;
			line-height: 1.05;
			margin-bottom: 0.6rem;
		}

		.nyt-article:not(.lead-story) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) clamp(6.4rem, 28vw, 7.6rem);
			align-items: start;
			gap: 0.95rem;
			padding-bottom: 1.1rem;
		}

		.nyt-article:not(.has-image) {
			grid-template-columns: 1fr !important;
		}

		.nyt-article:not(.has-image) .image-wrap {
			display: none !important;
		}

		.nyt-article:not(.lead-story) .article-body {
			grid-column: 1;
			grid-row: 1 / span 4;
			min-width: 0;
			max-width: 100%;
            display: grid;
            grid-template-rows: subgrid;
		}

		.nyt-article:not(.lead-story) .image-wrap {
			grid-column: 2;
			grid-row: 1 / span 4;
            height: 100%;
		}

		.nyt-article:not(.lead-story) .article-image,
		.nyt-article:not(.lead-story) .article-image-fallback {
			aspect-ratio: 1 / 1;
			height: auto;
			max-height: 7.75rem;
		}

		.nyt-article:not(.lead-story) .headline-standard,
		.nyt-article:not(.lead-story) .headline-compact,
		.nyt-article:not(.lead-story) .headline-wire {
			font-size: 1.1rem;
			line-height: 1.35;
			margin-bottom: 0.4rem;
            letter-spacing: 0.025em;
            padding-bottom: 0.25rem;
		}

		.nyt-article:not(.lead-story) .article-meta {
			margin-bottom: 0.4rem;
			gap: 0.35rem 0.45rem;
		}

		.nyt-article:not(.lead-story) .why-it-matters {
			display: none;
		}

		.nyt-article:not(.lead-story) .summary {
			font-size: 0.92rem;
			line-height: 1.52;
			-webkit-line-clamp: 2;
			margin-bottom: 0.6rem;
		}

        .nyt-article.variant-standard .summary,
        .nyt-article.variant-compact .summary,
        .nyt-article.variant-wire .summary {
            display: -webkit-box;
        }

		.nyt-article:not(.lead-story) .footer-meta {
			font-size: 0.68rem;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}

		.nyt-article:not(.lead-story) .fallback-badge-icon {
			left: 0.45rem;
			top: 0.45rem;
			padding: 0.16rem 0.28rem;
		}
	}

	@media (max-width: 640px) {
		.article-image {
			aspect-ratio: 16 / 10;
			max-height: 14rem;
			object-fit: cover;
		}

		.article-image-fallback {
			max-height: none;
		}
	}
</style>
