---
/* Cache-bust marker for NewsCard stylesheet hashing. */
import { chooseClusterImage } from '../utils/imageSelection';
import { getDisplayTitle, getDisplaySummary, isMostlyCyrillic, highlightScores, slugify, getDesignCardContext, transliterate, cleanAndDecode } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { Clock, Layers, ShieldCheck, Globe, Zap, AlertCircle, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import type { NewsCluster, Article } from '../types';
import type { ui } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	cluster: NewsCluster;
	isLead?: boolean;
	variant?: 'standard' | 'featured' | 'compact' | 'wire';
    bentoSpan?: '1x1' | '2x1' | '2x2';
    lang?: string;
}

const { cluster, isLead = false, variant = 'standard', bentoSpan, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = (propLang === 'mk' || propLang === 'sr' ? propLang : urlLang) as keyof typeof ui;
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

const main = cluster.articles?.[0];
if (!main) return;
const sourceSignal = main?.source_signal || {};
const totalSources = Number((cluster as any).sources_count || (cluster as any).source_count || cluster.articles.length);
const showTrustBadge = totalSources >= 2 && Boolean(sourceSignal.trust_label);
const showSignificanceLabel = cluster.is_breaking || totalSources >= 3;
const significanceLabel =
	totalSources >= 6 ? t('news.breaking') :
	totalSources >= 4 ? t('news.tracked') :
	cluster.is_breaking ? t('news.urgent') :
	t('news.ongoing');

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;
const fallbackImageUrl = selectedImage.fallbackUrl;
const tintColor = cluster.dominant_color || '#1e40af';
const rawLeadTitle = cluster.synthetic_headline || getDisplayTitle(main);

let displayTitle = highlightScores(cluster.synthetic_headline || getDisplayTitle(main));
if (lang === 'sr' && isMostlyCyrillic(displayTitle)) {
    displayTitle = highlightScores(transliterate(cluster.synthetic_headline || getDisplayTitle(main)));
}
const titleIsCyrillic = isMostlyCyrillic(displayTitle);

const clusterSlug = slugify(cluster.synthetic_headline || getDisplayTitle(main));
const clusterUrl = `${l('/cluster/')}${cluster.cluster_id}-${clusterSlug}`;

const uniqueSources = Number((cluster as any).sources_count || (cluster as any).source_count || new Set(cluster.articles.map(a => a.source)).size);
const cardSignals = [
    cluster.pluralism_score != null ? `${t('cluster.media_pluralism')} ${cluster.pluralism_score}%` : '',
    cluster.pulse_score != null ? `PULSE ${cluster.pulse_score}%` : '',
    cluster.topics?.[0] || main.topic || main.category || '',
].filter(Boolean).slice(0, 2);

const cardContext = getDesignCardContext(cluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent =
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const slimCluster = {
	cluster_id: cluster.cluster_id,
	is_breaking: cluster.is_breaking,
	topics: cluster.topics,
	tags: cluster.tags,
	homepage_score: cluster.homepage_score,
	articles: cluster.articles.map((a, i) => (i === 0 ? {
		source: a.source,
		category: a.category,
		topic: a.topic,
	} : { source: a.source })),
};

function getCardSummary(article: Article, lead = false) {
	const text = getDisplaySummary(article);
	if (!text) return '';
	const limit = lead ? 300 : 180;
	const truncated = text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
	return highlightScores(truncated);
}

let displaySummary = getCardSummary(main, isLead);
if (lang === 'sr' && isMostlyCyrillic(displaySummary)) {
    displaySummary = highlightScores(transliterate(cleanAndDecode(displaySummary)));
}
const summaryIsCyrillic = isMostlyCyrillic(displaySummary);

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr.replace("Z", ""));
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        return date.toLocaleTimeString(lang === 'sr' ? 'sr-RS' : 'mk-MK', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Belgrade'
        });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", "premium-spotlight", `variant-${variant}`, { "lead-story": isLead, "has-image": !!thumbSrc }, bentoSpan ? `bento-${bentoSpan}` : ""]} data-cluster={JSON.stringify(slimCluster)} data-testid="article-card">
	<div class="article-body">
        <div class="article-meta-v2">
            <div class="kicker-group">
                <span class="kicker">{main.source}</span>
                {cluster.is_breaking && (
                    <span class="significance-badge is-breaking">{t('news.breaking').toUpperCase()}</span>
                )}
            </div>
        </div>

        <a href={clusterUrl} class="headline-link group" data-testid="cluster-link" onmouseenter={`fetch('${clusterUrl}', { priority: 'low' })`}>
            <h2 class:list={["headline", isLead ? "headline-lead" : (variant === 'compact' || variant === 'wire' ? "headline-compact" : "headline-standard"), { "headline-cyrillic": titleIsCyrillic }]} set:html={sanitizeHtml(displayTitle)}>
            </h2>
        </a>

        {displaySummary && (
            <div class="card-content-stack">
                <p class:list={["summary", { "summary-cyrillic": summaryIsCyrillic }]} set:html={sanitizeHtml(displaySummary)}></p>
            </div>
        )}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines" aria-label="Povezane vesti">
                {cluster.articles.slice(1).filter(a => !a.is_redundant).slice(0, 3).map((sub: Article) => (
                    <li>
                        <a href={clusterUrl} set:html={sanitizeHtml(getDisplayTitle(sub, '', lang))}>
                        </a>
                    </li>
                ))}
            </ul>
        )}

        {cardSignals.length > 0 && variant !== 'wire' && (
            <div class="cluster-signal-row" aria-label={lang === 'sr' ? 'Signali klastera' : 'Сигнали на кластерот'}>
                {cardSignals.map((signal) => (
                    <span>{signal}</span>
                ))}
            </div>
        )}

        <div class="article-footer-meta mt-auto">
            <span class="time-stamp">{getTimeStr(main.ingested_at || main.created_at)}</span>
            <span class="meta-dot">·</span>
            <span class="source-count">{uniqueSources} {uniqueSources === 1 ? t('news.source') : t('news.sources')}</span>
        </div>
    </div>

    {thumbSrc && (
    <div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]} data-image-state={isFallbackArt ? 'fallback' : 'loading'} style={!isFallbackArt ? `--placeholder-bg: ${tintColor}` : undefined}>
        <a href={clusterUrl} class="block h-full" data-testid="cluster-link">
            {isFallbackArt ? (
                <div class="article-image-placeholder design-card topic-fallback-card" style={`--placeholder-bg: ${tintColor};`}>
                    <img
                        src={fallbackImageUrl}
                        alt=""
                        width="1200"
                        height="760"
                        class="article-image article-image-fallback is-loaded"
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="topic-fallback-scrim"></div>
                    <div class="design-card-ribbon">
                        <span>{cardLabel}</span>
                    </div>
                </div>
            ) : (
                <div class="runtime-image-container relative w-full h-full">
                    <img
                        src={thumbSrc}
                        srcset={`${thumbSrc.replace('w=720', 'w=360')} 360w, ${thumbSrc} 720w, ${thumbSrc.replace('w=720', 'w=1200')} 1200w`}
                        sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                        alt={displayTitle}
                        width="700"
                        height="500"
                        class="article-image"
                        {...(isLead ? { 'transition:name': `cluster-image-${cluster.cluster_id}` } : {})}
                        loading={isLead ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={isLead ? "high" : "auto"}
                        data-fallback-url={fallbackImageUrl}
                    />
                    <div class="topic-fallback-scrim runtime-fallback-only"></div>
                    <div class="design-card-ribbon runtime-fallback-only">
                        <span>{cardLabel}</span>
                    </div>
                </div>
            )}
        </a>
        {isLead && main.image_caption && (
            <p class="image-caption">{main.image_caption}</p>
        )}
    </div>
    )}
</article>

<style>
	.nyt-article {
		min-width: 0;
		max-width: 100%;
        padding: clamp(0.85rem, 1.5vw, 1.05rem) 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 0;
        background: transparent;
        border: 0;
        border-top: 1px solid color-mix(in srgb, var(--foreground) 18%, var(--border));
        box-shadow: none;
        transition: transform 0.28s var(--ease-editorial), border-color 0.28s var(--ease-editorial), box-shadow 0.28s var(--ease-editorial), background-color 0.28s var(--ease-editorial);
	}

    .nyt-article:hover {
        transform: translateY(-1px);
        border-color: color-mix(in srgb, var(--nyt-accent) 62%, var(--border));
        box-shadow: none;
    }

    :global(.dark) .nyt-article {
        background: transparent;
        box-shadow: none;
    }

    @media (hover: hover) {
        .nyt-article:not(.lead-story):hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--nyt-accent) 45%, var(--border));
            box-shadow: none;
            background: color-mix(in srgb, var(--background) 96%, var(--nyt-accent) 4%);
            z-index: 10;
        }
    }

    .article-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0;
        min-width: 0;
    }

    .card-content-stack {
        flex-grow: 1;
    }

	.headline-link {
	    display: block;
	    min-width: 0;
	    max-width: 100%;
	    text-decoration: none;
        min-height: 3.75rem;
	}

    .headline-link h2 {
        display: -webkit-box;
        width: fit-content;
        max-width: 100%;
        background-image: linear-gradient(var(--nyt-accent), var(--nyt-accent));
        background-position: 0 100%;
        background-repeat: no-repeat;
        background-size: 0% 2px;
        transition: background-size 0.4s var(--ease-editorial), color 0.3s ease;
    }

	@media (hover: hover) {
        .nyt-article:hover .headline-link h2,
        .headline-link:hover h2 {
            background-size: 100% 2px;
            color: var(--nyt-accent);
            text-decoration: none !important;
        }
    }

    /* --- Premium Meta Styles --- */
    .article-meta-v2 {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.42rem;
        min-height: 1.35rem;
    }

    .kicker-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.45rem;
        min-width: 0;
    }

    .kicker {
        font-family: var(--font-ui-condensed);
        font-size: 0.66rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--foreground);
        max-width: 14rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .significance-badge {
        font-family: var(--font-ui-condensed);
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--nyt-red);
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--nyt-red);
        line-height: 1;
    }

    .significance-badge.is-breaking {
        color: white;
        background: var(--nyt-red);
    }

    .article-footer-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        font-family: var(--font-ui);
        font-size: 0.66rem;
        font-weight: 600;
        color: color-mix(in srgb, var(--foreground) 68%, var(--muted-foreground));
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.5rem;
    }

    .meta-dot { opacity: 0.4; }

    .cluster-signal-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: 0.5rem;
    }

    .cluster-signal-row span {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        border-radius: var(--radius-sm, 0px);
        padding: 0.2rem 0.5rem;
        font-family: var(--font-ui);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--foreground) 64%, var(--muted-foreground));
        background: color-mix(in srgb, var(--secondary) 45%, var(--background));
        line-height: 1.2;
        transition: all 0.3s var(--ease-editorial);
    }

    .nyt-article:hover .cluster-signal-row span {
        border-color: color-mix(in srgb, var(--nyt-accent) 25%, var(--border));
        color: var(--foreground);
    }

    .summary {
        font-family: var(--font-nyt-body);
        font-size: 0.94rem;
        line-height: 1.52;
        color: color-mix(in srgb, var(--foreground) 72%, var(--secondary-foreground));
        margin-top: 0.3rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.72rem;
    }

    .sub-headlines {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        padding-top: 0.75rem;
    }

    .sub-headlines li {
        margin-bottom: 0.55rem;
        position: relative;
        padding-left: 1.15rem;
        transition: all 0.3s var(--ease-editorial);
    }

    .sub-headlines li::before {
        content: "■";
        position: absolute;
        left: 0;
        top: 0.45rem;
        font-size: 0.4rem;
        color: color-mix(in srgb, var(--border) 80%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sub-headlines li:hover {
        transform: translateX(4px);
    }

    .sub-headlines li:hover::before {
        color: var(--nyt-accent);
        transform: scale(1.25) rotate(45deg);
    }

    .sub-headlines a {
        font-family: var(--font-serif);
        font-size: 0.98rem;
        font-weight: 900;
        line-height: 1.25;
        color: var(--foreground);
        text-decoration: none;
    }

    .sub-headlines a:hover {
        text-decoration: underline;
    }

    .image-wrap {
        position: relative;
        aspect-ratio: 3 / 2;
        border-radius: 0 !important;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--surface-soft) 86%, var(--background)), color-mix(in srgb, var(--secondary) 72%, var(--background))),
            var(--secondary);
        box-shadow: none;
        transition: border-color 0.4s var(--ease-editorial);
    }

    .image-wrap::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
            linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--foreground) 5%, transparent) 42%, transparent 72%),
            repeating-linear-gradient(0deg, color-mix(in srgb, var(--border) 30%, transparent) 0 1px, transparent 1px 14px);
        opacity: 0.75;
        transform: translateX(-100%);
        animation: card-image-sheen 1.8s ease-in-out infinite;
    }

    .image-wrap[data-image-state="ready"]::before,
    .image-wrap[data-image-state="fallback"]::before {
        display: none;
    }

    @keyframes card-image-sheen {
        0% { transform: translateX(-100%); }
        55%, 100% { transform: translateX(100%); }
    }

    .article-image {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.5s ease, transform 0.8s var(--ease-editorial), filter 0.8s ease;
    }

    .article-image.is-loaded {
        opacity: 1;
    }

    .nyt-article:hover .article-image.is-loaded {
        transform: scale(1.04);
        filter: brightness(0.95);
    }

    .article-image-placeholder {
        position: relative;
        z-index: 1;
        transition: transform 0.8s var(--ease-editorial);
    }

    .topic-fallback-card {
        isolation: isolate;
    }

    .topic-fallback-card .article-image-fallback {
        position: absolute;
        inset: 0;
        z-index: 0;
        filter: saturate(0.95) contrast(1.02);
    }

    .topic-fallback-scrim {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
            linear-gradient(180deg, rgba(4, 8, 16, 0.08) 0%, rgba(4, 8, 16, 0.58) 100%),
            linear-gradient(90deg, rgba(4, 8, 16, 0.42), rgba(4, 8, 16, 0.08));
    }

    /* Runtime image fallback custom styles */
    .runtime-image-container {
        transition: transform 0.8s var(--ease-editorial);
    }

    .runtime-fallback-only {
        display: none;
    }

    .image-wrap[data-image-state="fallback"] .runtime-fallback-only {
        display: block !important;
    }

    .image-wrap[data-image-state="fallback"] .runtime-image-container {
        background: linear-gradient(135deg, color-mix(in srgb, var(--placeholder-bg, #070c16) 100%, black) 0%, color-mix(in srgb, var(--placeholder-bg, #132a4f) 60%, black) 100%) !important;
        position: relative;
        width: 100%;
        height: 100%;
        display: block;
        isolation: isolate;
    }

    .image-wrap[data-image-state="fallback"] .runtime-image-container .article-image-fallback {
        position: absolute;
        inset: 0;
        z-index: 0;
        filter: saturate(0.95) contrast(1.02);
        object-fit: contain;
        padding: 1.5rem;
    }

    .nyt-article:hover .article-image-placeholder,
    .nyt-article:hover .image-wrap[data-image-state="fallback"] .runtime-image-container {
        transform: scale(1.04);
    }

    .image-caption {
        font-family: var(--font-ui);
        font-size: 0.6rem;
        font-weight: 700;
        font-style: italic;
        color: var(--muted-foreground);
        margin-top: 0.35rem;
        text-align: right;
    }

	@media (min-width: 768px) {
        .nyt-article:not(.lead-story) {
            flex-direction: column-reverse;
        }
        .lead-story {
            flex-direction: row;
            gap: 2rem;
        }
	}

	@media (max-width: 640px) {
        .nyt-article {
            padding: 0.72rem;
            border-radius: 0;
        }

        .nyt-article:not(.lead-story) {
            display: grid;
            grid-template-columns: minmax(0, 1fr) clamp(5.35rem, 27vw, 6.7rem);
            gap: 0.68rem;
            align-items: start;
        }

        .nyt-article:not(.lead-story) .article-body {
            grid-column: 1;
            grid-row: 1;
        }

        .nyt-article:not(.lead-story) .image-wrap {
            grid-column: 2;
            grid-row: 1;
            aspect-ratio: 1 / 1;
            max-height: none;
        }

        .nyt-article:not(.lead-story) .article-image {
            aspect-ratio: 1 / 1;
            max-height: none;
        }

        .nyt-article.variant-featured:not(.lead-story) .headline-link {
            min-height: 0;
        }

        .nyt-article.variant-featured:not(.lead-story) .headline-standard {
            font-size: 1.12rem;
            line-height: 1.12;
            letter-spacing: -0.012em;
        }

        .nyt-article.variant-featured:not(.lead-story) .summary {
            min-height: 0;
            -webkit-line-clamp: 2;
        }

		.article-meta-v2 {
			min-height: 0;
		}

		.nyt-article.variant-compact,
		.nyt-article.variant-wire {
			padding-bottom: 0.45rem;
		}

		.nyt-article.variant-compact .article-meta-v2,
		.nyt-article.variant-wire .article-meta-v2 {
			margin-bottom: 0.3rem;
		}

		.nyt-article.variant-compact .headline-link,
		.nyt-article.variant-wire .headline-link {
			min-height: 0;
		}

		.nyt-article.variant-compact .headline-compact,
		.nyt-article.variant-wire .headline-compact {
			font-size: 1.04rem;
			line-height: 1.1;
			letter-spacing: -0.015em;
		}

		.nyt-article.variant-compact .summary,
		.nyt-article.variant-wire .summary {
			font-size: 0.82rem;
			line-height: 1.35;
			margin-top: 0.2rem;
			min-height: 0;
			-webkit-line-clamp: 2;
		}

		.nyt-article.variant-compact .cluster-signal-row,
		.nyt-article.variant-wire .cluster-signal-row {
			gap: 0.25rem;
			margin-top: 0.35rem;
		}

		.nyt-article.variant-compact .cluster-signal-row span,
		.nyt-article.variant-wire .cluster-signal-row span {
			padding: 0.14rem 0.32rem;
			font-size: 0.5rem;
		}

		.nyt-article.variant-compact .article-footer-meta,
		.nyt-article.variant-wire .article-footer-meta {
			gap: 0.3rem;
			font-size: 0.54rem;
			margin-top: 0.28rem;
		}

		.nyt-article.variant-compact .kicker,
		.nyt-article.variant-wire .kicker {
			font-size: 0.56rem;
			letter-spacing: 0.08em;
		}

		.nyt-article.variant-compact .image-wrap,
		.nyt-article.variant-wire .image-wrap {
			border-width: 1px;
			aspect-ratio: 1 / 1;
			max-height: none;
		}

		.nyt-article.variant-compact .article-image,
		.nyt-article.variant-wire .article-image {
			aspect-ratio: 1 / 1;
			max-height: none;
			object-position: center;
		}

		.nyt-article.variant-compact .article-image-placeholder,
		.nyt-article.variant-wire .article-image-placeholder {
			padding: 0.7rem;
