---
/* Cache-bust marker for NewsCard stylesheet hashing. */
import { chooseClusterImage } from '../utils/imageSelection';
import { getDisplayTitle, getDisplaySummary, isMostlyCyrillic, highlightScores } from '../utils/textUtils';
import { sanitizeHtml } from '../lib/sanitize';
import { ShieldCheck, Globe, CheckCircle2, Sparkles } from 'lucide-react';
import type { NewsCluster, Article } from '../types';

interface Props {
	cluster: NewsCluster;
	isLead?: boolean;
	variant?: 'standard' | 'featured' | 'compact' | 'wire';
}

const { cluster, isLead = false, variant = 'standard' } = Astro.props;
const main = cluster.articles?.[0];
if (!main) return;
const sourceSignal = main?.source_signal || {};
const totalSources = cluster.articles.length;
const showTrustBadge = totalSources >= 2 && Boolean(sourceSignal.trust_label);
const showSignificanceLabel = cluster.is_breaking || totalSources >= 3;
const significanceLabel =
	totalSources >= 6 ? 'Ударна' :
	totalSources >= 4 ? 'Следена' :
	cluster.is_breaking ? 'Итен развој' :
	'Во тек';

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;
const tintColor = cluster.dominant_color || '#1e40af';
const rawLeadTitle = cluster.synthetic_headline || getDisplayTitle(main);

const displayTitle = highlightScores(cluster.synthetic_headline || getDisplayTitle(main));
const titleIsCyrillic = isMostlyCyrillic(displayTitle);

const uniqueSources = new Set(cluster.articles.map(a => a.source)).size;

const slimCluster = {
	cluster_id: cluster.cluster_id,
	is_breaking: cluster.is_breaking,
	topics: cluster.topics,
	tags: cluster.tags,
	homepage_score: cluster.homepage_score,
	articles: cluster.articles.map((a, i) => (i === 0 ? {
		source: a.source,
		category: a.category,
		topic: a.topic,
	} : { source: a.source })),
};

function getCardSummary(article: Article, lead = false) {
	const text = getDisplaySummary(article);
	if (!text) return '';
	const limit = lead ? 300 : 180;
	const truncated = text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
	return highlightScores(truncated);
}

const displaySummary = cluster.synthetic_standfirst || getCardSummary(main, isLead);
const summaryIsCyrillic = isMostlyCyrillic(displaySummary);

const hasSynthesis = cluster.has_synthesis;

function getWhyItMatters() {
	if (cluster.articles.some(a => a.is_fact_check)) {
		return 'Приказна со активна системска верификација и детална деконструкција на наводите.';
	}
	if (cluster.is_breaking && totalSources >= 4) {
		return 'Итен развој со висок интензитет кој веќе добива сеопфатно медиумско внимание.';
	}
	if (sourceSignal.role_label && totalSources >= 4) {
		return `${sourceSignal.role_label}. Приказната се зацврстува низ повеќе независни линии на известување.`;
	}
	if (sourceSignal.role_label && totalSources >= 2) {
		return `${sourceSignal.role_label}. Темата се проширува со нови потврди и официјални реакции.`;
	}
	if (totalSources >= 6) {
		return `Развој со изразена медиумска тежина поддржана од ${totalSources} различни извори.`;
	}
	if (totalSources >= 4) {
		return 'Повеќе редакции веќе додаваат нови слоеви на информации и специфичен контекст.';
	}
	if (totalSources >= 2) {
		return 'Приказна која брзо добива системска потврда и поширок општествен одглас.';
	}
	return 'Развој со потенцијал за дополнителна тематска еволуција.';
}



const whyItMatters = getWhyItMatters();

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'ШТОТУКУ';
        if (diffMins < 60) return `ПРЕД ${diffMins} МИН`;

        return date.toLocaleTimeString('mk-MK', { 
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Skopje'
        });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", `variant-${variant}`, { "lead-story": isLead }]} data-cluster={JSON.stringify(slimCluster)}>
	<div class="article-body">
		<div class="article-meta">
			<span class="source-label">
				{main.source}
				{showTrustBadge && sourceSignal.trust_label === 'Висока доверба' && (
					<span title="Висока доверба">
						<ShieldCheck size={12} className="inline-block ml-1 text-blue-600 dark:text-blue-400" />
					</span>
				)}
				</span>

				{main.is_global && (
				<span class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-500">
					<Globe size={11} /> МЕЃУНАРОДЕН КОНТЕКСТ
				</span>
				)}

				{main.coverage_balance?.label && (
				<span class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-green-700 dark:text-green-500">
					<CheckCircle2 size={11} /> {main.coverage_balance.label}
				</span>
				)}

				{cluster.is_breaking && (
				<span class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-red-600 dark:text-red-500">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
					</span>
					ВО ЖИВО
				</span>
			)}

			{cluster.articles.some(a => a.is_fact_check) && (
				<span class="bg-amber-50 text-amber-800 dark:bg-amber-900/20 dark:text-amber-300 px-1.5 py-0.5 rounded text-[10px] font-bold border border-amber-200/50 flex items-center gap-1">
					ФАКТ-ЧЕК
				</span>
			)}

			{hasSynthesis && (
				<span class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-nyt-accent" title="Системска синтеза достапна">
					<Zap size={11} className="fill-nyt-accent/20" fill="currentColor" /> СИНТЕЗА
				</span>
			)}

			{showSignificanceLabel && !cluster.is_breaking && (
				<span class="significance-dot-label" title={significanceLabel}>
					<span class:list={["h-1.5 w-1.5 rounded-full", totalSources >= 6 ? "bg-purple-500" : "bg-blue-400"]}></span>
					{totalSources >= 6 ? 'Ударна' : 'Следена'}
				</span>
			)}
		</div>


		<a href={`/cluster/${cluster.cluster_id}`} class="headline-link group">
			<h2 class:list={["headline", isLead ? "headline-lead" : "headline-standard", { "headline-cyrillic": titleIsCyrillic }]} set:html={sanitizeHtml(displayTitle)}>
			</h2>
		</a>

		{hasSynthesis && (
			<span class="editorial-byline">
				Системска синтеза на Пресек
			</span>
		)}

		{!isLead && variant === 'compact' ? null : (
			<div class="card-content-stack">
				<p class="why-it-matters">
					{whyItMatters}
				</p>

				{displaySummary && (
					<p class:list={["summary", { "summary-cyrillic": summaryIsCyrillic }]} set:html={sanitizeHtml(displaySummary)}>
					</p>
				)}
			</div>
		)}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines">
                {cluster.articles.slice(1).filter(a => !a.is_redundant).slice(0, 3).map((sub: Article) => (
                    <li>
                        <a href={`/cluster/${cluster.cluster_id}`} set:html={sanitizeHtml(getDisplayTitle(sub))}>
                        </a>
                    </li>
                ))}
            </ul>
        )}


		<div class="footer-meta">
			<span>{getTimeStr(main.ingested_at || main.created_at)}</span>
			<span class="dot">·</span>
			<span>{uniqueSources} {uniqueSources === 1 ? 'извор' : 'извори'}</span>
			{totalSources > uniqueSources && <span class="text-muted-foreground ml-1">({totalSources} вкупно)</span>}
		</div>
		</div>

		{thumbSrc && (
		<div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]}>
			<a href={`/cluster/${cluster.cluster_id}`} class="block h-full">
				{isFallbackArt ? (
					<div class="article-image-placeholder" style={`--placeholder-bg: ${tintColor};`}>
                        <div class="article-image-placeholder-bg-text" set:html={sanitizeHtml(rawLeadTitle)}></div>
						<div class="article-image-placeholder-topline">
							<p class="article-image-placeholder-label">ПРЕСЕК.мк Избор</p>
							<p class="article-image-placeholder-chip">{uniqueSources} {uniqueSources === 1 ? 'извор' : 'извори'}</p>
						</div>
                        <div class="article-image-placeholder-content">
						    <h3>{main?.category || 'Вести'}</h3>
						    <p class="article-image-placeholder-source">{main.source}</p>
                        </div>
					</div>
				) : (
					<img
						src={thumbSrc}
						alt={displayTitle}
						width="700"
						height="500"
						class="article-image"
						{...(isLead ? { 'transition:name': `cluster-image-${cluster.cluster_id}` } : {})}
						loading={isLead ? "eager" : "lazy"}
						decoding="async"
						fetchpriority={isLead ? "high" : "auto"}
						onload="this.classList.add('is-loaded')"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="article-image-placeholder is-error-fallback" style="display: none;">
						<div class="article-image-placeholder-topline">
							<p class="article-image-placeholder-label">ПРЕСЕК.мк Избор</p>
							<p class="article-image-placeholder-chip">Без визуел</p>
						</div>
						<p class="article-image-placeholder-source">{main.source}</p>
					</div>
				)}
			</a>
            {isLead && main.image_caption && (
                <p class="image-caption">{main.image_caption}</p>
            )}
		</div>
	)}
</article>

<style>
	.nyt-article {
		--news-card-cache-bust-20260424: 1;
	}

    .article-image-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        align-content: space-between;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        background: 
            linear-gradient(135deg, 
                color-mix(in srgb, var(--placeholder-bg, #070c16) 100%, black) 0%, 
                color-mix(in srgb, var(--placeholder-bg, #132a4f) 60%, black) 100%
            );
    }

    .article-image-placeholder-bg-text {
        position: absolute;
        inset: -10%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-serif);
        font-size: 8rem;
        font-weight: 900;
        line-height: 0.8;
        color: white;
        opacity: 0.04;
        filter: blur(2px);
        pointer-events: none;
        user-select: none;
        z-index: 0;
        text-align: center;
        word-break: break-all;
    }

    .article-image-placeholder::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top left, rgba(255,255,255,0.12), transparent 40%),
            linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.4) 100%);
        pointer-events: none;
        z-index: 1;
    }

    .article-image-placeholder-topline {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .article-image-placeholder-content {
        position: relative;
        z-index: 2;
    }
</style>
