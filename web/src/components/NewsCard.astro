    }

    .sub-headlines li {
        margin-bottom: 0.75rem;
        position: relative;
        padding-left: 1rem;
    }

    .sub-headlines li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5rem;
        width: 4px;
        height: 4px;
        background: var(--border);
        border-radius: 50%;
    }

    .sub-headlines a {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--foreground);
        text-decoration: none;
    }

    .sub-headlines a:hover {
        text-decoration: underline;
    }

	@media (min-width: 768px) {
		.headline-lead {
			font-size: 2.25rem;
			line-height: 0.98;
		}
	}

	@media (max-width: 767px) {
		.nyt-article:not(.lead-story) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) clamp(6.4rem, 28vw, 7.6rem);
			align-items: start;
			gap: 0.95rem;
			padding-bottom: 1.1rem;
		}

		.nyt-article:not(.lead-story) .article-body {
			grid-column: 1;
			grid-row: 1;
		}

		.nyt-article:not(.lead-story) .image-wrap {
			grid-column: 2;
			grid-row: 1;
		}

		.nyt-article:not(.lead-story) .article-image,
		.nyt-article:not(.lead-story) .article-image-fallback {
			aspect-ratio: 1 / 1;
			height: auto;
