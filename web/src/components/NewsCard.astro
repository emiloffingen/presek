		font-size: 0.54rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--foreground) 82%, var(--muted-foreground) 18%);
		opacity: 0.88;
	}

    .image-caption {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        color: var(--muted-foreground);
        margin-top: 0.4rem;
        text-align: right;
    }

    .sub-headlines {
        list-style: none;
