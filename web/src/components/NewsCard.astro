---
/* Cache-bust marker for NewsCard stylesheet hashing. */
import { chooseClusterImage } from '../utils/imageSelection';
import { getDisplayTitle, getDisplaySummary, isMostlyCyrillic, highlightScores, slugify, getDesignCardContext, transliterate, cleanAndDecode, normalizeEntityOrTag } from '../utils/textUtils';
import { getVisibleCardSignals } from '../lib/signalBadges';
import { sanitizeHtml } from '../lib/sanitize';
import { Clock, Layers, ShieldCheck, Globe, Zap, AlertCircle, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import type { NewsCluster, Article } from '../types';
import type { ui } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';
import TrustChip from './TrustChip.astro';
import { buildCompactPluralismMeta } from '../lib/trustSignals';
import { isStubFeedCluster } from '../lib/unifiedFeed';

interface Props {
	cluster: NewsCluster;
	isLead?: boolean;
	variant?: 'standard' | 'featured' | 'compact' | 'wire';
    bentoSpan?: '1x1' | '2x1' | '2x2';
    lang?: string;
}

const { cluster, isLead = false, variant = 'standard', bentoSpan, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = (propLang === 'mk' || propLang === 'sr' ? propLang : urlLang) as keyof typeof ui;
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);

const main = cluster.articles?.[0];
if (!main) return;
const sourceSignal = main?.source_signal || {};
const totalSources = Number((cluster as any).sources_count || (cluster as any).source_count || cluster.articles.length);
const showTrustBadge = totalSources >= 2 && Boolean(sourceSignal.trust_label);
const showSignificanceLabel = cluster.is_breaking || totalSources >= 3;
const significanceLabel =
	totalSources >= 6 ? t('news.breaking') :
	totalSources >= 4 ? t('news.tracked') :
	cluster.is_breaking ? t('news.urgent') :
	t('news.ongoing');

const selectedImage = chooseClusterImage(cluster, isLead ? 'hero' : 'card', lang as 'sr' | 'mk');
const thumbSrc = selectedImage.proxiedUrl;
const isFallbackArt = selectedImage.isWeak;
const fallbackImageUrl = selectedImage.fallbackUrl;
const showMedia = Boolean(thumbSrc) && !(isFallbackArt && (variant === 'compact' || variant === 'wire'));
const mediaSrc = thumbSrc || '';
const tintColor = cluster.dominant_color || '#1e40af';
const rawLeadTitle = cluster.synthetic_headline || getDisplayTitle(main);

let displayTitle = highlightScores(cluster.synthetic_headline || getDisplayTitle(main));
if (lang === 'sr' && isMostlyCyrillic(displayTitle)) {
    displayTitle = highlightScores(transliterate(cluster.synthetic_headline || getDisplayTitle(main)));
}
const titleIsCyrillic = isMostlyCyrillic(displayTitle);

const clusterSlug = slugify(cluster.synthetic_headline || getDisplayTitle(main));
const clusterUrl = `${l('/cluster/')}${cluster.cluster_id}-${clusterSlug}`;

const uniqueSources = Number((cluster as any).sources_count || (cluster as any).source_count || new Set(cluster.articles.map(a => a.source)).size);
const signalBadges = getVisibleCardSignals({
    pluralismScore: cluster.pluralism_score,
    pulseScore: cluster.pulse_score,
    isBreaking: cluster.is_breaking,
    topic: cluster.topics?.[0] || main.topic || main.category || '',
});
const localizedTopic = normalizeEntityOrTag(
    cluster.topics?.[0] || main.topic || main.category || '',
    lang,
);
const cardSignals = signalBadges.map((badge) => {
    if (badge.key === 'pluralism-conflict' && cluster.pluralism_score != null) {
        return `${t('signal.different_angles')} ${cluster.pluralism_score}%`;
    }
    if (badge.key === 'pluralism-consensus') {
        return t('signal.same_story');
    }
    if (badge.key === 'pulse-hot' && cluster.pulse_score != null) {
        return `${t('signal.trending')} ${cluster.pulse_score}%`;
    }
    if (badge.key === 'breaking') {
        return t('signal.breaking');
    }
    if (badge.key === 'topic') {
        return localizedTopic;
    }
    return '';
}).filter(Boolean);
const synthesisFreshness = (cluster.synthesis_freshness || {}) as {
    is_stale?: boolean;
    latest_article_at?: string | null;
    new_article_count?: number;
    reasons?: string[];
    synthesis_updated_at?: string | null;
};
const isPendingSynthesis = (synthesisFreshness.reasons || []).includes('missing_synthesis');
const trustIsStale = Boolean(synthesisFreshness.is_stale) && !isPendingSynthesis;
const isStubCard = isStubFeedCluster(cluster) && variant !== 'featured' && !isLead;
const conflictHeadlines = (cluster.pluralism_score ?? 0) >= 55
    ? Array.from(new Set(cluster.articles.slice(0, 3).map((article) => getDisplayTitle(article)).filter(Boolean)))
    : [];
const showConflictPreview = conflictHeadlines.length >= 2;
const hasPluralismConflict = (cluster.pluralism_score ?? 0) >= 55;
const compactPluralismMeta = (variant === 'compact' || variant === 'wire')
    ? buildCompactPluralismMeta({
        sourcesCount: uniqueSources,
        pluralismScore: cluster.pluralism_score,
        isStale: trustIsStale,
        hasVerification: Boolean(cluster.has_fact_check),
        quietFreshness: isPendingSynthesis,
        isPendingSynthesis,
    }, lang as 'sr' | 'mk')
    : null;

const cardContext = getDesignCardContext(cluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent =
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const slimCluster = {
	cluster_id: cluster.cluster_id,
	is_breaking: cluster.is_breaking,
	topics: cluster.topics,
	tags: cluster.tags,
	homepage_score: cluster.homepage_score,
	articles: cluster.articles.map((a, i) => (i === 0 ? {
		source: a.source,
		category: a.category,
		topic: a.topic,
	} : { source: a.source })),
};

function getCardSummary(article: Article, lead = false) {
	const text = getDisplaySummary(article);
	if (!text) return '';
	const limit = lead ? 300 : 180;
	const truncated = text.length > limit ? `${text.slice(0, limit).trimEnd()}...` : text;
	return highlightScores(truncated);
}

let displaySummary = getCardSummary(main, isLead);
if (lang === 'sr' && isMostlyCyrillic(displaySummary)) {
    displaySummary = highlightScores(transliterate(cleanAndDecode(displaySummary)));
}
const summaryIsCyrillic = isMostlyCyrillic(displaySummary);

// Relative time format
function getTimeStr(dateStr: string) {
    try {
        const date = new Date(dateStr.replace("Z", ""));
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        return date.toLocaleTimeString(lang === 'sr' ? 'sr-RS' : 'mk-MK', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Belgrade'
        });
    } catch {
        return '';
    }
}
---

<article class:list={["nyt-article", "premium-spotlight", `variant-${variant}`, { "lead-story": isLead, "has-image": showMedia, "has-useful-image": showMedia && !isFallbackArt, "has-editorial-fallback": showMedia && isFallbackArt, "card-pluralism-conflict": hasPluralismConflict, "feed-card-stub": isStubCard }, bentoSpan ? `bento-${bentoSpan}` : ""]} data-cluster={JSON.stringify(slimCluster)} data-testid="article-card">
	<div class="article-body">
        <div class="article-meta-v2">
            <div class="kicker-group">
                <span class="kicker">{main.source}</span>
                {cluster.is_breaking && (
                    <span class="significance-badge is-breaking">{t('news.breaking').toUpperCase()}</span>
                )}
            </div>
        </div>

        <a href={clusterUrl} class="headline-link group" data-testid="cluster-link" onmouseenter={`fetch('${clusterUrl}', { priority: 'low' })`}>
            <h2 class:list={["headline", isLead ? "headline-lead" : (variant === 'compact' || variant === 'wire' ? "headline-compact" : "headline-standard"), { "headline-cyrillic": titleIsCyrillic }]} set:html={sanitizeHtml(displayTitle)}>
            </h2>
        </a>

        {displaySummary && (
            <div class="card-content-stack">
                <p class:list={["summary", { "summary-cyrillic": summaryIsCyrillic }]} set:html={sanitizeHtml(displaySummary)}></p>
            </div>
        )}

        {isLead && cluster.articles.length > 1 && (
            <ul class="sub-headlines" aria-label={t('news.related_stories')}>
                {cluster.articles.slice(1).filter(a => !a.is_redundant).slice(0, 3).map((sub: Article) => (
                    <li>
                        <a href={clusterUrl} set:html={sanitizeHtml(getDisplayTitle(sub, '', lang))}>
                        </a>
                    </li>
                ))}
            </ul>
        )}

        {variant !== 'wire' && (
            <div class="cluster-trust-row">
                <TrustChip
                    sourcesCount={uniqueSources}
                    pluralismScore={cluster.pluralism_score}
                    isStale={trustIsStale}
                    hasVerification={Boolean(cluster.has_fact_check)}
                    quietFreshness={isPendingSynthesis}
                    isPendingSynthesis={isPendingSynthesis}
                    showExplainer={isLead}
                    lang={lang}
                />
            </div>
        )}

        {cardSignals.length > 0 && variant !== 'wire' && variant !== 'compact' && (
            <div class="cluster-signal-row" aria-label={lang === 'sr' ? 'Signali klastera' : 'Сигнали на кластерот'}>
                <span>{cardSignals[0]}</span>
            </div>
        )}

        {showConflictPreview && (
            <div class="conflict-headline-preview" aria-label={t('pulse.conflict_angles')}>
                <p class="conflict-headline-kicker">{t('pulse.conflict_angles')}</p>
                {conflictHeadlines.slice(0, 2).map((headline) => (
                    <p class="conflict-headline-variant">
                        <strong>{t('pulse.conflict_headline')}:</strong> {headline}
                    </p>
                ))}
            </div>
        )}

        <div class="article-footer-meta mt-auto">
            <span class="time-stamp">{getTimeStr(main.ingested_at || main.created_at)}</span>
            {compactPluralismMeta ? (
                <>
                    <span class="meta-dot">·</span>
                    <span class:list={["pluralism-meta", { "pluralism-meta--conflict": hasPluralismConflict }]}>
                        {compactPluralismMeta}
                    </span>
                </>
            ) : (
                <>
                    <span class="meta-dot">·</span>
                    <span class="source-count">{uniqueSources} {uniqueSources === 1 ? t('news.source') : t('news.sources')}</span>
                </>
            )}
        </div>
    </div>

    {showMedia && (
    <div class:list={["image-wrap", { "image-wrap-fallback": isFallbackArt }]} data-image-state={isFallbackArt ? 'fallback' : 'loading'} style={!isFallbackArt ? `--placeholder-bg: ${tintColor}` : undefined}>
        <a href={clusterUrl} class="block h-full" data-testid="cluster-link" tabindex="-1" aria-hidden="true">
            {isFallbackArt ? (
                isLead ? (
                    <div class:list={["article-image-placeholder topic-fallback-card", { "article-image-placeholder-title-cyrillic": titleIsCyrillic }]} style={`--placeholder-bg: ${tintColor}`}>
                        <div class="article-image-placeholder-topline">
                            <p class="article-image-placeholder-label">{cardLabel || main.category || t('news.ongoing')}</p>
                            <span class="article-image-placeholder-chip">{cardSub || `${uniqueSources} ${uniqueSources === 1 ? t('news.source') : t('news.sources')}`}</span>
                        </div>
                        <IconComponent size={28} strokeWidth={1.8} className="article-image-placeholder-icon" aria-hidden="true" />
                        <h3 set:html={sanitizeHtml(displayTitle)}></h3>
                        <p class="article-image-placeholder-source">{main.source}</p>
                    </div>
                ) : (
                    <div class="article-image-placeholder topic-fallback-card topic-fallback-card--proxy-only" style={`--placeholder-bg: ${tintColor}`}>
                        <img
                            src={fallbackImageUrl}
                            alt=""
                            width="720"
                            height="500"
                            class="article-image article-image-fallback is-loaded"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                )
            ) : (
                <div class="runtime-image-container relative w-full h-full">
                    <img
                        src={mediaSrc}
                        srcset={`${mediaSrc.replace('w=720', 'w=360')} 360w, ${mediaSrc} 720w, ${mediaSrc.replace('w=720', 'w=1200')} 1200w`}
                        sizes="(max-width: 640px) 7.25rem, (max-width: 1280px) 50vw, 33vw"
                        alt={displayTitle}
                        width="700"
                        height="500"
                        class="article-image"
                        {...(isLead ? { 'transition:name': `cluster-image-${cluster.cluster_id}` } : {})}
                        loading={isLead ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={isLead ? "high" : "auto"}
                        data-fallback-url={fallbackImageUrl}
                    />
                </div>
            )}
        </a>
        {isLead && main.image_caption && (
            <p class="image-caption">{main.image_caption}</p>
        )}
    </div>
    )}
</article>

<style>
	.nyt-article {
		min-width: 0;
		max-width: 100%;
        padding: clamp(0.78rem, 1.15vw, 1rem) 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 0;
        background: transparent;
        border: 0;
        border-top: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
        box-shadow: none;
        transition: transform 0.28s var(--ease-editorial), border-color 0.28s var(--ease-editorial), box-shadow 0.28s var(--ease-editorial), background-color 0.28s var(--ease-editorial);
	}

    .nyt-article.variant-featured {
        padding: clamp(0.9rem, 1.35vw, 1.15rem);
        border: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--background) 96%, var(--nyt-accent) 4%), var(--background));
    }

    .nyt-article:hover {
        transform: translateY(-1px);
        border-color: color-mix(in srgb, var(--nyt-accent) 62%, var(--border));
        box-shadow: none;
    }

    :global(.dark) .nyt-article {
        background: transparent;
        box-shadow: none;
    }

    @media (hover: hover) {
        .nyt-article:not(.lead-story):hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--nyt-accent) 45%, var(--border));
            box-shadow: none;
            background: color-mix(in srgb, var(--background) 97%, var(--nyt-accent) 3%);
            z-index: 10;
        }
    }

    .article-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0;
        min-width: 0;
    }

    .card-content-stack {
        flex-grow: 1;
    }

	.headline-link {
	    display: block;
	    min-width: 0;
	    max-width: 100%;
	    text-decoration: none;
        min-height: 3.35rem;
	}

    .headline-link h2 {
        display: -webkit-box;
        width: fit-content;
        max-width: 100%;
        background-image: linear-gradient(var(--nyt-accent), var(--nyt-accent));
        background-position: 0 100%;
        background-repeat: no-repeat;
        background-size: 0% 2px;
        transition: background-size 0.4s var(--ease-editorial), color 0.3s ease;
    }

	@media (hover: hover) {
        .nyt-article:hover .headline-link h2,
        .headline-link:hover h2 {
            background-size: 100% 2px;
            color: var(--nyt-accent);
            text-decoration: none !important;
        }
    }

    /* --- Premium Meta Styles --- */
    .article-meta-v2 {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.28rem;
        min-height: 1.15rem;
    }

    .kicker-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.45rem;
        min-width: 0;
    }

    .kicker {
        font-family: var(--font-ui-condensed);
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.075em;
        color: color-mix(in srgb, var(--foreground) 74%, var(--muted-foreground));
        max-width: 14rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .significance-badge {
        font-family: var(--font-ui-condensed);
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--nyt-red);
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--nyt-red);
        line-height: 1;
    }

    .significance-badge.is-breaking {
        color: white;
        background: var(--nyt-red);
    }

    .article-footer-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        font-family: var(--font-ui);
        font-size: 0.6rem;
        font-weight: 600;
        color: color-mix(in srgb, var(--foreground) 58%, var(--muted-foreground));
        text-transform: uppercase;
        letter-spacing: 0.035em;
        margin-top: 0.46rem;
    }

    .meta-dot { opacity: 0.4; }

    .cluster-trust-row {
        margin-top: 0.38rem;
    }

    .cluster-signal-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.28rem;
        margin-top: 0.42rem;
    }

    .cluster-signal-row span {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        border-radius: var(--radius-sm, 0px);
        padding: 0.18rem 0.42rem;
        font-family: var(--font-ui);
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.035em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--foreground) 64%, var(--muted-foreground));
        background: color-mix(in srgb, var(--secondary) 45%, var(--background));
        line-height: 1.2;
        transition: all 0.3s var(--ease-editorial);
    }

    .nyt-article:hover .cluster-signal-row span {
        border-color: color-mix(in srgb, var(--nyt-accent) 25%, var(--border));
        color: var(--foreground);
    }

    .summary {
        font-family: var(--font-nyt-body);
        font-size: 0.88rem;
        line-height: 1.44;
        color: color-mix(in srgb, var(--foreground) 78%, var(--secondary-foreground));
        margin-top: 0.24rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.2rem;
    }

    .sub-headlines {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        padding-top: 0.75rem;
    }

    .sub-headlines li {
        margin-bottom: 0.55rem;
        position: relative;
        padding-left: 1.15rem;
        transition: all 0.3s var(--ease-editorial);
    }

    .sub-headlines li::before {
        content: "■";
        position: absolute;
        left: 0;
        top: 0.45rem;
        font-size: 0.4rem;
        color: color-mix(in srgb, var(--border) 80%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sub-headlines li:hover {
        transform: translateX(4px);
    }

    .sub-headlines li:hover::before {
        color: var(--nyt-accent);
        transform: scale(1.25) rotate(45deg);
    }

    .sub-headlines a {
        font-family: var(--font-serif);
        font-size: 0.98rem;
        font-weight: 900;
        line-height: 1.25;
        color: var(--foreground);
        text-decoration: none;
    }

    .sub-headlines a:hover {
        text-decoration: underline;
    }

    .image-wrap {
        position: relative;
        aspect-ratio: 3 / 2;
        border-radius: 0 !important;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--foreground) 10%, var(--border));
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--surface-soft) 86%, var(--background)), color-mix(in srgb, var(--secondary) 72%, var(--background))),
            var(--secondary);
        box-shadow: none;
        transition: border-color 0.4s var(--ease-editorial);
        margin-bottom: 0.72rem;
    }

    .image-wrap::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
            linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--foreground) 5%, transparent) 42%, transparent 72%),
            repeating-linear-gradient(0deg, color-mix(in srgb, var(--border) 30%, transparent) 0 1px, transparent 1px 14px);
        opacity: 0.75;
        transform: translateX(-100%);
        animation: card-image-sheen 1.8s ease-in-out infinite;
    }

    .image-wrap[data-image-state="ready"]::before,
    .image-wrap[data-image-state="fallback"]::before,
    .image-wrap[data-image-state="failed"]::before {
        display: none;
    }

    .nyt-article.image-failed .image-wrap,
    .image-wrap[data-image-state="failed"] {
        display: none;
    }

    @keyframes card-image-sheen {
        0% { transform: translateX(-100%); }
        55%, 100% { transform: translateX(100%); }
    }

    .article-image {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.5s ease, transform 0.8s var(--ease-editorial), filter 0.8s ease;
    }

    .article-image.is-loaded {
        opacity: 1;
    }

    .nyt-article:hover .article-image.is-loaded {
        transform: scale(1.025);
        filter: brightness(0.95);
    }

    .article-image-placeholder {
        position: relative;
        z-index: 1;
        transition: transform 0.8s var(--ease-editorial);
    }

    .topic-fallback-card {
        isolation: isolate;
        min-height: 100%;
        background:
            radial-gradient(circle at 16% 12%, color-mix(in srgb, var(--placeholder-bg, #1e40af) 10%, transparent), transparent 34%),
            linear-gradient(145deg, color-mix(in srgb, var(--background) 92%, var(--placeholder-bg, #1e40af) 8%), color-mix(in srgb, var(--secondary) 82%, var(--placeholder-bg, #1e40af) 18%));
    }

    .article-image-placeholder-icon {
        position: relative;
        z-index: 1;
        margin-bottom: 0.5rem;
        color: color-mix(in srgb, var(--muted-foreground) 74%, var(--placeholder-bg, #1e40af));
    }

    .topic-fallback-scrim {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
            linear-gradient(180deg, rgba(4, 8, 16, 0.08) 0%, rgba(4, 8, 16, 0.58) 100%),
            linear-gradient(90deg, rgba(4, 8, 16, 0.42), rgba(4, 8, 16, 0.08));
    }

    /* Runtime image fallback custom styles */
    .runtime-image-container {
        transition: transform 0.8s var(--ease-editorial);
    }

    .runtime-fallback-only {
        display: none;
    }

    .image-wrap[data-image-state="fallback"] .runtime-fallback-only {
