---
interface Props {
    placement?: 'in-article' | 'under-article' | 'sidebar';
    class?: string;
}

const { placement = 'under-article', class: className } = Astro.props;

let desktopId = '2006214';
let mobileId = '2006241';

if (placement === 'in-article') {
    desktopId = '2006251';
    mobileId = '2006251';
} else if (placement === 'sidebar') {
    desktopId = '2006255';
    mobileId = '2006272';
}

const containerId = `ads-${placement}-${Math.random().toString(36).substring(2, 7)}`;
---

<div id={containerId} class:list={[className, { "my-8": !className }]}>
    <!-- Desktop Widget -->
    <div class="adskeeper-desktop hidden md:block">
        <div data-type="_mgwidget" class="ad-slot" data-widget-id={desktopId}></div>
    </div>
    
    <!-- Mobile Widget -->
    <div class="adskeeper-mobile block md:hidden">
        <div data-type="_mgwidget" class="ad-slot" data-widget-id={mobileId}></div>
    </div>

    <script is:inline data-astro-rerun define:vars={{ containerId }}>
        (function(w, q) {
            const container = document.getElementById(containerId);
            if (container) {
                const isDark = document.documentElement.classList.contains('dark');
                const theme = isDark ? 'dark' : 'light';
                container.querySelectorAll('.ad-slot').forEach(el => {
                    el.setAttribute('data-color-theme', theme);
                });
            }
            w[q] = w[q] || [];
            w[q].push(["_mgc.load"]);
        })(window, "_mgq");
    </script>
</div>
