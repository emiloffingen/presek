---
import { hilltopZoneInvokerSrc, type HilltopZone } from '../lib/hilltopads';

interface Props {
  zone: HilltopZone;
}

const { zone } = Astro.props;
const invokerSrc = hilltopZoneInvokerSrc(zone);
if (!invokerSrc) return;

const globalKey = `__PRESEK_HILLTOP_${zone.toUpperCase()}_LOADED__`;
---

<script is:inline define:vars={{ invokerSrc, globalKey, zone }}>
	(function loadHilltopZone() {
		if (window[globalKey]) return;
		window[globalKey] = true;

		(function (settings) {
			const d = document;
			const s = d.createElement('script');
			const l = d.scripts[d.scripts.length - 1];
			s.settings = settings || {};
			s.src = invokerSrc;
			s.async = true;
			s.referrerPolicy = 'no-referrer-when-downgrade';
			s.setAttribute('data-hilltop-zone', zone);
			l.parentNode.insertBefore(s, l);
		})({});
	})();
</script>
