---
import { Calendar } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface DateItem {
  day: string;
}

interface Props {
  historicalDates?: DateItem[];
  currentDate?: string;
}

const { historicalDates = [], currentDate = '' } = Astro.props;
if (!historicalDates.length) return;

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const isMK = lang === 'mk';
const t = useTranslations(lang);
const l = (path: string) => localePath(path, isMK ? 'mk' : 'sr', hostHeader);
---

<nav class="briefing-date-nav" aria-label={t('briefing.previous_editions')}>
  <div class="briefing-date-nav-head">
    <Calendar size={14} />
    <span>{t('briefing.previous_editions')}</span>
  </div>
  <div class="briefing-date-nav-scroll">
    {historicalDates.map((item) => {
      const day = item.day;
      const active = currentDate === day;
      const label = new Date(day).toLocaleDateString(isMK ? 'mk-MK' : 'sr-RS', {
        weekday: 'short',
        day: 'numeric',
        month: 'short',
      });
      return (
        <a
          href={`${l('/briefing')}?date=${day}`}
          class:list={['briefing-date-pill', { 'is-active': active }]}
          aria-current={active ? 'page' : undefined}
        >
          {label}
        </a>
      );
    })}
  </div>
</nav>

<style>
  .briefing-date-nav {
    margin-bottom: 1.25rem;
    padding: 0.85rem 0 0.35rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .briefing-date-nav-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .briefing-date-nav-scroll {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    scrollbar-width: thin;
  }

  .briefing-date-pill {
    flex: 0 0 auto;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .briefing-date-pill.is-active {
    background: var(--nyt-accent);
    border-color: var(--nyt-accent);
    color: white;
  }

  @media (min-width: 1100px) {
    .briefing-date-nav {
      display: none;
    }
  }
</style>
