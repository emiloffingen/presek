---
interface Props {
	stats: any;
	metadata?: any;
	lang?: string;
}

import { useTranslations } from '../../i18n/utils';

const { stats, metadata, lang = 'sr' } = Astro.props;
const isMK = lang === 'mk';
const t = useTranslations(lang as any);

const totalFeeds = stats?.total_feeds || 0;
const last24h = stats?.last_24h || 0;
const pluralism = metadata?.stats?.pluralism_score || stats?.intelligence?.pluralism?.pluralism_pct || 0;
const intlShare = metadata?.stats?.intl_share || stats?.intelligence?.international_share_pct || 0;

const items = [
	{
		label: isMK ? 'Редакции' : 'Redakcije',
		value: totalFeeds,
	},
	{
		label: isMK ? 'Извештаи' : 'Izveštaji',
		value: last24h,
		suffix: '/ 24h',
	},
	{
		label: isMK ? 'Плурализам' : 'Pluralizam',
		value: `${pluralism}%`,
		accent: 'pluralism',
	},
	{
		label: isMK ? 'Интерн. удел' : 'Intern. udeo',
		value: `${intlShare}%`,
		accent: 'intl',
	},
];

const dateline = isMK
	? `${last24h} извештаи од ${totalFeeds} редакции · ${pluralism}% плурализам · ${intlShare}% интернационално`
	: `${last24h} izveštaja iz ${totalFeeds} redakcija · ${pluralism}% pluralizam · ${intlShare}% internacionalno`;
---

<aside class="briefing-stats-strip" aria-label={isMK ? 'Дневни метрики' : 'Dnevne metrike'}>
	<p class="briefing-stats-strip__dateline">{dateline}</p>
	<div class="briefing-stats-strip__grid">
		{items.map((item) => (
			<div class:list={['briefing-stats-strip__item', item.accent && `is-${item.accent}`]}>
				<span class="briefing-stats-strip__label">{item.label}</span>
				<span class="briefing-stats-strip__value">
					{item.value}
					{item.suffix && <span class="briefing-stats-strip__suffix">{item.suffix}</span>}
				</span>
			</div>
		))}
	</div>
	<p class="briefing-stats-strip__trust">
		<strong>{t('briefing.trust_note_label')}:</strong> {t('briefing.trust_note')}
	</p>
</aside>
