---
interface Props {
	stats: any;
	metadata?: any;
	lang?: string;
}

import { useTranslations } from '../../i18n/utils';

const { stats, metadata, lang = 'sr' } = Astro.props;
const t = useTranslations(lang as any);

const totalFeeds = stats?.total_feeds || 0;
const last24h = stats?.last_24h || 0;
const pluralism = metadata?.stats?.pluralism_score || stats?.intelligence?.pluralism?.pluralism_pct || 0;
const intlShare = metadata?.stats?.intl_share || stats?.intelligence?.international_share_pct || 0;

const items = [
	{
		label: t('briefing.stats_newsrooms'),
		value: totalFeeds,
	},
	{
		label: t('briefing.stats_reports'),
		value: last24h,
		suffix: '/ 24h',
	},
	{
		label: t('briefing.stats_pluralism_label'),
		value: `${pluralism}%`,
		accent: 'pluralism',
	},
	{
		label: t('briefing.stats_intl_share'),
		value: `${intlShare}%`,
		accent: 'intl',
	},
];

const dateline = t('briefing.stats_dateline', {
	last24h,
	totalFeeds,
	pluralism,
	intlShare,
});
---

<aside class="briefing-stats-strip" aria-label={t('briefing.stats_aria')}>
	<p class="briefing-stats-strip__dateline">{dateline}</p>
	<div class="briefing-premium-deck">
		{items.map((item) => (
			<div class:list={[
				'briefing-deck-item',
				item.accent === 'pluralism' && 'accent-pluralism',
				item.accent === 'intl' && 'accent-intl'
			]}>
				<span class="briefing-deck-label">{item.label}</span>
				<div class="flex items-baseline gap-1 mt-2.5">
					<span class="text-3xl font-serif font-black tracking-tight">{item.value}</span>
					{item.suffix && <span class="text-[10px] font-sans font-bold text-muted-foreground tracking-normal uppercase select-none">{item.suffix}</span>}
				</div>
			</div>
		))}
	</div>
	<p class="briefing-stats-strip__trust">
		<strong>{t('briefing.trust_note_label')}:</strong> {t('briefing.trust_note')}
	</p>
</aside>
