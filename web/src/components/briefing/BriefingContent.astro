---
interface Props {
	formattedBriefing: string;
}

const { formattedBriefing } = Astro.props;
---

<article class="briefing-content-container">
	<div class="briefing-body" set:html={formattedBriefing}></div>
</article>

<style is:global>
    .briefing-content-container { max-width: 720px; margin: 0 auto; }
    .briefing-body { font-family: var(--font-nyt-body); font-size: 1.25rem; line-height: 1.6; color: var(--foreground); }
    .briefing-section-title { font-family: var(--font-serif); font-size: 2.2rem; font-weight: 900; margin: 4rem 0 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
    .briefing-paragraph { margin-bottom: 1.75rem; text-align: justify; hyphens: auto; }
    .briefing-kicker { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; text-transform: uppercase; color: var(--nyt-accent); letter-spacing: 0.1em; margin-right: 0.5rem; }
    .briefing-item-title { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 850; margin: 2rem 0 1rem; color: var(--foreground); }
    .briefing-ul { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 1rem; }
    .briefing-li { position: relative; padding-left: 2rem; font-size: 1.2rem; margin-bottom: 1rem; }
    .briefing-li::before { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); font-weight: 900; }
    .briefing-divider { height: 1px; background: var(--border); margin: 4rem 0; position: relative; }
    .briefing-divider::after { content: "❈"; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--background); padding: 0 1rem; font-size: 1.2rem; color: var(--border); }
    .briefing-inline-badge { display: inline-flex; align-items: center; background: var(--nyt-accent); color: white; font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; padding: 0.1rem 0.4rem; border-radius: 2px; margin-left: 0.5rem; text-decoration: none; vertical-align: middle; transition: opacity 0.2s; }
    .briefing-inline-badge:hover { opacity: 0.8; }
</style>
