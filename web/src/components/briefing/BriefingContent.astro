---
interface Props {
	formattedBriefing: string;
}

const { formattedBriefing } = Astro.props;
---

<article class="briefing-content-container">
	<div class="briefing-body" set:html={formattedBriefing}></div>
</article>

<style is:global>
    .briefing-content-container { max-width: 800px; margin: 0 auto; width: 100%; box-sizing: border-box; padding: 0 1rem; }
    .briefing-body { font-family: var(--font-serif); font-size: clamp(1.2rem, 2.2vw, 1.45rem); line-height: 1.7; color: var(--foreground); }
    .briefing-section-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; margin: 4.5rem 0 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--foreground); letter-spacing: -0.02em; }
    .briefing-paragraph { margin-bottom: 2rem; text-align: left; hyphens: auto; word-wrap: break-word; overflow: hidden; }
    .briefing-paragraph.drop-cap::first-letter { float: left; font-family: var(--font-serif); font-size: clamp(3.5rem, 8vw, 4.2rem); line-height: 0.8; margin-top: 0.1em; margin-right: 0.12em; padding-top: 0.05em; padding-left: 4px; font-weight: 900; color: var(--foreground); }
    .briefing-pull-quote { font-family: var(--font-serif); font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 800; font-style: italic; color: var(--nyt-accent); border-left: 6px solid var(--nyt-accent); padding: 1.5rem 2.5rem; margin: 3.5rem 0; line-height: 1.3; letter-spacing: -0.01em; position: relative; }
    .briefing-pull-quote::before { content: "“"; position: absolute; left: 0.5rem; top: 0; font-size: 5rem; opacity: 0.15; font-family: serif; }
    .briefing-kicker { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 950; text-transform: uppercase; color: var(--nyt-accent); letter-spacing: 0.15em; margin-right: 0.75rem; }
    .briefing-item-title { font-family: var(--font-serif); font-size: clamp(1.5rem, 3.5vw, 1.85rem); font-weight: 850; margin: 3rem 0 1.25rem; color: var(--foreground); line-height: 1.2; }
    .briefing-ul { list-style: none; padding: 0; margin: 0 0 3rem; display: flex; flex-direction: column; gap: 1.25rem; }
    .briefing-li { position: relative; padding-left: 2rem; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.5; }
    .briefing-li::before { content: "—"; position: absolute; left: 0; color: var(--nyt-accent); font-weight: 950; font-size: 1.4rem; }
    .briefing-inline-badge { display: inline-flex; align-items: center; background: color-mix(in srgb, var(--nyt-accent) 15%, transparent); border: 1px solid var(--nyt-accent); color: var(--nyt-accent); font-family: var(--font-sans); font-size: 0.52rem; font-weight: 950; padding: 0.2rem 0.6rem; border-radius: 99px; margin-left: 0.75rem; text-decoration: none; vertical-align: middle; transition: all 0.2s; white-space: nowrap; letter-spacing: 0.05em; }
    .briefing-inline-badge:hover { background: var(--nyt-accent); color: white; transform: translateY(-1px); }
</style>
