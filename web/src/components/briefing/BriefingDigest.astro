---
const { homeData } = Astro.props;
---

{homeData && homeData.trending && (
    <section class="mt-16 pt-12 border-t border-border">
        <h3 class="font-sans font-black uppercase tracking-widest text-xs mb-8 text-nyt-accent">Дневен Дигест</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {homeData.trending.slice(0, 4).map((c: any) => (
                <a href={`/cluster/${c.cluster_id}`} class="block p-4 border border-border hover:border-nyt-accent transition-all">
                    <p class="font-sans text-[10px] font-black uppercase text-muted-foreground mb-1">Во тренд</p>
                    <h4 class="font-serif font-bold text-sm leading-tight">{c.synthetic_headline || c.articles?.[0]?.title}</h4>
                </a>
            ))}
        </div>
    </section>
)}
