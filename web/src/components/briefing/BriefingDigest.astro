---
const { homeData } = Astro.props;
---

{homeData && homeData.trending && (
    <section class="mt-8">
        <h3 class="font-sans font-black uppercase tracking-widest text-xs mb-6 text-nyt-accent">Актуелни Фокусни Теми</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {homeData.trending.slice(0, 6).map((c: any) => (
                <a href={`/cluster/${c.cluster_id}`} class="block p-6 bg-secondary/50 border border-border hover:border-nyt-accent transition-all group">
                    <p class="font-sans text-[10px] font-black uppercase text-nyt-accent mb-3 tracking-widest">Во тренд</p>
                    <h4 class="font-serif font-black text-xl leading-tight group-hover:underline decoration-2 underline-offset-4 decoration-nyt-accent/30">{c.synthetic_headline || c.articles?.[0]?.title}</h4>
                    {c.summary && <p class="font-serif text-sm mt-3 text-muted-foreground line-clamp-3">{c.summary}</p>}
                </a>
            ))}
        </div>
    </section>
)}
