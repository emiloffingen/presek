---
import { Zap, Activity, Users, MapPin, Calendar } from 'lucide-react';
import NewsletterIsland from '../NewsletterIsland.tsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';

interface Props {
	stats: any;
	health: any;
	leadCluster: any;
	briefing?: any;
	historicalDates?: any[];
}

const { stats, health, leadCluster, briefing, historicalDates = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isMK = lang === 'mk';
const t = useTranslations(lang);

function getTimeStr(dateStr: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr.replace("Z", ""));
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));
        const diffHours = Math.floor(diffMins / 60);

        if (diffMins < 1) return t('news.just_now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;
        if (diffHours < 24) {
            const label = diffHours === 1 ? t('news.hour') : t('news.hours');
            return `${t('news.ago')} ${diffHours} ${label}`;
        }

        return date.toLocaleDateString(lang === 'sr' ? 'sr-RS' : 'mk-MK', { day: 'numeric', month: 'short' }).toUpperCase();
    } catch {
        return '';
    }
}

const l = (path: string) => localePath(path, isMK ? 'mk' : 'sr', hostHeader);
---

<aside class="briefing-sidebar">
	<section class="sidebar-module p-6 bg-secondary/10 border border-border rounded-xl mb-6 shadow-sm">
			<NewsletterIsland lang={lang} client:visible />
		</section>

		{historicalDates.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-[var(--grid-gap)] mb-6 pb-2 border-b border-border">
					<Calendar size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">{t('briefing.previous_editions')}</h4>
				</div>
				<div class="grid grid-cols-2 gap-[var(--grid-gap)]">
					{historicalDates.map((d: any) => (
						<a
							href={`${l('/briefing')}?date=${d.day}`}
							class={`text-[10px] font-black uppercase tracking-tighter hover:bg-secondary transition-all px-3 py-2 border border-border rounded flex items-center justify-center text-center ${briefing?.date === d.day ? 'bg-nyt-accent text-white border-nyt-accent' : 'text-muted-foreground bg-card'}`}
						>
							{new Date(d.day).toLocaleDateString(isMK ? 'mk-MK' : 'sr-RS', { day: 'numeric', month: 'short' })}
						</a>
					))}
				</div>
			</section>
		)}

		{stats?.intelligence?.pluralism && (
			<section class="sidebar-module">
				<div class="flex items-center gap-[var(--grid-gap)] mb-6 pb-2 border-b border-border">
					<Activity size={14} className="text-emerald-600" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">{t('briefing.system_balance')}</h4>
				</div>
				<div class="space-y-6">
					<div>
						<div class="flex justify-between text-[9px] font-black uppercase mb-2 opacity-60">
							<span>{t('briefing.media_pluralism')}</span>
							<span class="text-emerald-600">{stats.intelligence.pluralism.pluralism_pct}%</span>
						</div>
						<div class="h-1 bg-secondary rounded-full overflow-hidden">
							<div class="h-full bg-emerald-500" style={`width: ${stats.intelligence.pluralism.pluralism_pct}%`}></div>
						</div>
					</div>
					<div>
						<div class="flex justify-between text-[9px] font-black uppercase mb-2 opacity-60">
							<span>{t('briefing.high_consensus')}</span>
							<span class="text-blue-600">{stats.intelligence.pluralism.high_consensus_pct}%</span>
						</div>
						<div class="h-1 bg-secondary rounded-full overflow-hidden">
							<div class="h-full bg-blue-500" style={`width: ${stats.intelligence.pluralism.high_consensus_pct}%`}></div>
						</div>
					</div>
				</div>
			</section>
		)}

		{briefing?.subjects?.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-[var(--grid-gap)] mb-6 pb-2 border-b border-border">
					<Users size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">{t('briefing.key_actors')}</h4>
				</div>
				<div class="flex flex-col gap-[var(--grid-gap)]">
					{briefing.subjects.map((subject: any) => (
						<a href={l(`/subjekt/${encodeURIComponent(subject.name)}`)} class="flex justify-between items-center text-sm font-serif group">
							<span class="group-hover:text-nyt-accent transition-colors">{subject.name}</span>
							<span class="text-[10px] font-sans font-black text-muted-foreground opacity-40">+{subject.total_mentions}</span>
						</a>
					))}
				</div>
			</section>
		)}

		{briefing?.locations?.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-[var(--grid-gap)] mb-6 pb-2 border-b border-border">
					<MapPin size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">{t('briefing.focus_locations')}</h4>
				</div>
				<div class="flex flex-wrap gap-[var(--grid-gap)]">
					{briefing.locations.map((loc: any) => (
						<span class="px-2 py-1 bg-secondary border border-border text-secondary-foreground text-[10px] font-sans font-black uppercase tracking-wider">
							{loc.name}
						</span>
					))}
				</div>
			</section>
		)}

		{leadCluster && (
			<section class="sidebar-module">
				<div class="flex items-center gap-[var(--grid-gap)] mb-6 pb-2 border-b border-border">
					<Zap size={14} className="text-nyt-accent" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">{t('briefing.trending_now')}</h4>
				</div>
				<a href={l(`/cluster/${leadCluster.cluster_id}`)} class="group block">
					<p class="font-serif font-bold text-sm leading-snug group-hover:text-nyt-accent transition-colors">
						{leadCluster.articles?.[0]?.title}
					</p>
					<span class="block mt-3 text-[9px] font-black uppercase text-muted-foreground opacity-60">
						{leadCluster.articles?.[0]?.source} · {getTimeStr(leadCluster.articles?.[0]?.created_at || leadCluster.articles?.[0]?.ingested_at)}
					</span>
				</a>
			</section>
		)}
	</div>
</aside>

<style>
    .briefing-sidebar { display: flex; flex-direction: column; gap: 2rem; }
    .sidebar-module { border-top: 1px solid var(--border); padding-top: 1.5rem; }
    .sidebar-module:first-child { border-top: none; padding-top: 0; }

    @media (max-width: 639.98px) {
        .briefing-sidebar {
            gap: 1.25rem;
        }

        .sidebar-module {
            padding-top: 1rem;
        }

        .sidebar-module :global(.p-6) {
            padding: 1rem;
        }

        .sidebar-module :global(.mb-6) {
            margin-bottom: 0.9rem;
        }

        .sidebar-module :global(.space-y-6 > *) + :global(*) {
            margin-top: 1rem;
        }
    }
</style>
