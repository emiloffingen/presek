---
import { Timer, Activity } from 'lucide-react';
import { useTranslations } from '../../i18n/utils';

interface Props {
	currentDate: string;
	dispatchIcon: any;
	stats: any;
	readingTime?: number;
    lang?: string;
    metadata?: any;
    date?: string;
}

const { currentDate, dispatchIcon: DispatchIcon, stats, readingTime = 5, lang = 'sr', metadata, date } = Astro.props;
const t = useTranslations(lang as any);
const isMK = lang === 'mk';
---

<header class="briefing-masthead motion-rise animate-rise">

	<div class="masthead-main mb-12">
		<div class="masthead-branding mb-8">
			<h1 class="masthead-title uppercase tracking-tighter">
                {t('briefing.report_title')} <span class="text-nyt-accent italic-serif lowercase">{t('briefing.report_subtitle')}</span>
            </h1>
            <div class="masthead-subline mt-2 flex items-center justify-center gap-[var(--grid-gap)]">
                <div class="h-px w-12 bg-border"></div>
                <span class="font-sans text-[10px] font-black uppercase tracking-[0.4em] text-muted-foreground">
                    {t('briefing.synthesis_geo')}
                </span>
                <div class="h-px w-12 bg-border"></div>
            </div>
		</div>
		<div class="masthead-date-bar py-4 border-y border-foreground/10">
			<p class="font-serif font-black text-2xl md:text-3xl tracking-tight italic">{currentDate}</p>
		</div>

        <!-- Glassmorphic Audio Briefing Player -->
        {date && (
            <div class="briefing-audio-player mt-6" data-date={date} data-lang={lang}>
                <button class="audio-play-btn" aria-label="Slušaj brifing">
                    <svg class="play-icon w-4 h-4 fill-current ml-0.5" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                    <svg class="pause-icon w-4 h-4 fill-current hidden" viewBox="0 0 24 24">
                        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                    </svg>
                    <svg class="loading-spinner w-4 h-4 hidden animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
                <div class="audio-info-wrap">
                    <span class="audio-title">{isMK ? 'Слушај го аудио брифингот' : 'Slušaj audio brifing'}</span>
                    <div class="audio-progress-bar">
                        <div class="audio-progress-fill" style="width: 0%"></div>
                    </div>
                </div>
                <span class="audio-duration">0:00</span>
                <audio class="hidden briefing-audio-element" preload="none"></audio>
            </div>
        )}
	</div>

	<div class="briefing-premium-deck">
		<div class="briefing-deck-item">
            <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-3">{isMK ? 'РЕДАКЦИИ' : 'REDAKCIJE'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums">{stats?.total_feeds || 0}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-nyt-accent"></span>
            </div>
        </div>
		<div class="briefing-deck-item">
            <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-3">{isMK ? 'ИЗВЕШТАИ' : 'IZVEŠTAJI'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums">{stats?.last_24h || 0}</span>
                <span class="text-[10px] font-bold text-muted-foreground">/ 24h</span>
            </div>
        </div>
		<div class="briefing-deck-item accent-pluralism">
            <span class="text-[9px] font-black uppercase tracking-widest text-emerald-600 mb-3">{isMK ? 'ПЛУРАЛИЗАМ' : 'PLURALIZAM'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums text-emerald-600">{metadata?.stats?.pluralism_score || stats?.intelligence?.pluralism?.pluralism_pct || 0}%</span>
                <Activity size={14} className="text-emerald-500" />
            </div>
        </div>
        <div class="briefing-deck-item accent-intl">
            <span class="text-[9px] font-black uppercase tracking-widest text-nyt-accent mb-3">{isMK ? 'ИНТЕРН. УДЕЛ' : 'INTERN. UDEO'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums text-nyt-accent">{metadata?.stats?.intl_share || stats?.intelligence?.international_share_pct || 0}%</span>
                <Timer size={14} className="text-nyt-accent" />
            </div>
        </div>
	</div>
</header>

<style>
    .briefing-masthead { margin-bottom: 3rem; }



    .masthead-main { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2rem, 6vw, 4.5rem); font-weight: 950; line-height: 0.9; letter-spacing: -0.04em; margin: 0; }
    .italic-serif { font-style: italic; font-weight: 400; color: var(--nyt-accent); }
    .masthead-date-bar { width: 100%; text-align: center; margin-top: 1rem; }

    .signature-tag { font-family: var(--font-mono); }

    @media (max-width: 768px) {
        .hide-mobile { display: none; }
    }

    @media (max-width: 639.98px) {
        .briefing-masthead { margin-bottom: 1.75rem; }
        .masthead-main {
            margin-bottom: 1.75rem;
        }
        .masthead-branding {
            margin-bottom: 1.25rem;
        }
        .masthead-title {
            font-size: clamp(1.7rem, 10vw, 2.5rem);
            line-height: 0.94;
        }
        .masthead-subline {
            margin-top: 0.4rem;
            gap: 0.45rem;
        }
        .masthead-subline .h-px {
            width: 1.6rem;
        }
        .masthead-subline span {
            font-size: 0.5rem;
            letter-spacing: 0.22em;
        }
        .masthead-date-bar {
            margin-top: 0.5rem;
            padding: 0.8rem 0;
        }
        .masthead-date-bar p {
            font-size: 1.35rem;
            line-height: 1.15;
        }
        .masthead-deck {
            margin-bottom: 2rem;
        }
        .deck-item {
            padding: 0.9rem 0.85rem;
        }
        .deck-item > span:first-child {
            margin-bottom: 0.45rem;
            font-size: 0.48rem;
            letter-spacing: 0.16em;
        }
        .deck-item span.text-3xl {
            font-size: 1.45rem;
        }
        .deck-item div > span:last-child {
            font-size: 0.52rem;
        }
    }

    /* ── Briefing Audio Player Styling ── */
    .briefing-audio-player {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.03);
        max-width: 28rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        margin: 1.5rem auto 0;
        text-align: left;
    }
    
    :global(.dark) .briefing-audio-player {
        background: rgba(0, 0, 0, 0.2);
        border-color: rgba(255, 255, 255, 0.05);
    }
    
    .briefing-audio-player:hover {
        border-color: color-mix(in srgb, var(--nyt-accent) 40%, transparent);
        box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
        background: rgba(255, 255, 255, 0.6);
    }
    
    :global(.dark) .briefing-audio-player:hover {
        background: rgba(0, 0, 0, 0.3);
    }

    .audio-play-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--nyt-accent);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(197, 160, 89, 0.3);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .audio-play-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 15px rgba(197, 160, 89, 0.45);
        background: color-mix(in srgb, var(--nyt-accent) 90%, black);
    }

    .audio-play-btn:active {
        transform: scale(0.95);
    }

    .play-icon {
        font-size: 0.8rem;
        margin-left: 2px;
    }

    .pause-icon {
        font-size: 0.75rem;
    }

    .audio-info-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .audio-title {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--foreground);
    }

    .audio-progress-bar {
        height: 4px;
        background: color-mix(in srgb, var(--foreground) 10%, transparent);
        border-radius: 2px;
        overflow: hidden;
        cursor: pointer;
        position: relative;
    }

    .audio-progress-fill {
        height: 100%;
        background: var(--nyt-accent);
        border-radius: 2px;
        transition: width 0.1s linear;
    }

    .audio-duration {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--muted-foreground);
        min-width: 2.2rem;
        text-align: right;
    }

    .loading-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.briefing-audio-player').forEach(player => {
            const playBtn = player.querySelector('.audio-play-btn');
            if (!playBtn) return;

            const playIcon = player.querySelector('.play-icon');
            const pauseIcon = player.querySelector('.pause-icon');
            const spinner = player.querySelector('.loading-spinner');
            const progressFill = player.querySelector('.audio-progress-fill');
            const progressBar = player.querySelector('.audio-progress-bar');
            const durationLabel = player.querySelector('.audio-duration');
            const audio = player.querySelector('.briefing-audio-element');

            const date = player.getAttribute('data-date');
            const lang = player.getAttribute('data-lang');

            let isLoaded = false;
            let isLoading = false;

            async function loadAndPlay() {
                if (isLoading) return;
                isLoading = true;

                // Show spinner
                playIcon.classList.add('hidden');
                pauseIcon.classList.add('hidden');
                spinner.classList.remove('hidden');

                try {
                    const apiBase = window.location.origin;
                    const response = await fetch(`${apiBase}/api/intelligence/briefing/audio?date=${date}&lang=${lang}`);
                    const data = await response.json();

                    if (data.status === 'success' && data.audio_url) {
                        audio.src = data.audio_url.startsWith('http') ? data.audio_url : `${apiBase}${data.audio_url}`;
                        await audio.play();
                        isLoaded = true;
                        
                        // Show pause icon
                        spinner.classList.add('hidden');
                        pauseIcon.classList.remove('hidden');
                    } else {
                        console.error('Audio briefing synthesis failed:', data);
                        alert(lang === 'mk' ? 'Грешка при преземање на аудиото.' : 'Greška prilikom preuzimanja audio zapisa.');
                        resetPlayerState();
                    }
                } catch (err) {
                    console.error('Failed to load audio briefing:', err);
                    resetPlayerState();
                } finally {
                    isLoading = false;
                }
            }

            function resetPlayerState() {
                playIcon.classList.remove('hidden');
                pauseIcon.classList.add('hidden');
                spinner.classList.add('hidden');
            }

            playBtn.addEventListener('click', async () => {
                if (!isLoaded) {
                    await loadAndPlay();
                } else {
                    if (audio.paused) {
                        await audio.play();
                        playIcon.classList.add('hidden');
                        pauseIcon.classList.remove('hidden');
                    } else {
                        audio.pause();
                        playIcon.classList.remove('hidden');
                        pauseIcon.classList.add('hidden');
                    }
                }
            });

            // Time updates
            audio.addEventListener('timeupdate', () => {
                if (!audio.duration) return;
                const pct = (audio.currentTime / audio.duration) * 100;
                progressFill.style.width = `${pct}%`;

                // Format time
                const mins = Math.floor(audio.currentTime / 60);
                const secs = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
                durationLabel.textContent = `${mins}:${secs}`;
            });

            audio.addEventListener('loadedmetadata', () => {
                const mins = Math.floor(audio.duration / 60);
                const secs = Math.floor(audio.duration % 60).toString().padStart(2, '0');
                durationLabel.textContent = `${mins}:${secs}`;
            });

            audio.addEventListener('ended', () => {
                progressFill.style.width = '0%';
                resetPlayerState();
            });

            // Click on progress bar to seek
            progressBar.addEventListener('click', (e) => {
                if (!isLoaded || !audio.duration) return;
                const rect = progressBar.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                const width = rect.width;
                const pct = clickX / width;
                audio.currentTime = pct * audio.duration;
            });
        });
    });
</script>
