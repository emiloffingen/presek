---
import { Timer, Activity, ShieldCheck, Cpu } from 'lucide-react';
import { useTranslations } from '../../i18n/utils';

interface Props {
	currentDate: string;
	dispatchIcon: any;
	stats: any;
	readingTime?: number;
    metadata?: any;
    lang?: string;
}

const { currentDate, dispatchIcon: DispatchIcon, stats, readingTime = 5, metadata, lang = 'sr' } = Astro.props;
const t = useTranslations(lang as any);
const isMK = lang === 'mk';

const systemSignature = metadata?.system_signature || 'Presek v2.1-CC';
const modelName = metadata?.model || 'Gemma 2 / Mistral';
---

<header class="briefing-masthead motion-rise animate-rise">
    {/* 1. REPORT STATUS BAR */}
    <div class="briefing-status-deck mb-8">
        <div class="briefing-status-inner">
            <div class="briefing-status-item">
                <div class="briefing-pulse-emerald"></div>
                <span class="briefing-status-label">{t('footer.system_signal')}</span>
                <span class="briefing-status-value">{t('footer.active')}</span>
            </div>
            <div class="briefing-status-item divider-left">
                <Cpu size={10} className="text-muted-foreground" />
                <span class="briefing-status-label">{isMK ? 'AI МОДЕЛ' : 'AI MODEL'}</span>
                <span class="briefing-status-value">{modelName}</span>
            </div>
            <div class="briefing-status-item divider-left hide-mobile">
                <ShieldCheck size={10} className="text-emerald-500" />
                <span class="briefing-status-label">{isMK ? 'ВЕРИФИКАЦИЈА' : 'VERIFIKACIJA'}</span>
                <span class="briefing-status-value text-emerald-500">{isMK ? 'ПОТВРДЕНО' : 'POTVRĐENO'}</span>
            </div>
            <div class="briefing-status-item ml-auto briefing-signature-tag hide-mobile">
                <span class="briefing-status-value tabular-nums opacity-60 font-mono">{systemSignature}</span>
            </div>
        </div>
    </div>

	<div class="masthead-main mb-12">
		<div class="masthead-branding mb-8">
			<h1 class="masthead-title uppercase tracking-tighter">
                {t('briefing.report_title')} <span class="text-nyt-accent italic-serif lowercase">{t('briefing.report_subtitle')}</span>
            </h1>
            <div class="masthead-subline mt-2 flex items-center justify-center gap-[var(--grid-gap)]">
                <div class="h-px w-12 bg-border"></div>
                <span class="font-sans text-[10px] font-black uppercase tracking-[0.4em] text-muted-foreground">
                    {t('briefing.synthesis_geo')}
                </span>
                <div class="h-px w-12 bg-border"></div>
            </div>
		</div>
		<div class="masthead-date-bar py-4 border-y border-foreground/10">
			<p class="font-serif font-black text-2xl md:text-3xl tracking-tight italic">{currentDate}</p>
		</div>
	</div>

	<div class="briefing-premium-deck">
		<div class="briefing-deck-item">
            <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-3">{isMK ? 'РЕДАКЦИИ' : 'REDAKCIJE'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums">{stats?.total_feeds || 0}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-nyt-accent"></span>
            </div>
        </div>
		<div class="briefing-deck-item">
            <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-3">{isMK ? 'ИЗВЕШТАИ' : 'IZVEŠTAJI'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums">{stats?.last_24h || 0}</span>
                <span class="text-[10px] font-bold text-muted-foreground">/ 24h</span>
            </div>
        </div>
		<div class="briefing-deck-item accent-pluralism">
            <span class="text-[9px] font-black uppercase tracking-widest text-emerald-600 mb-3">{isMK ? 'ПЛУРАЛИЗАМ' : 'PLURALIZAM'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums text-emerald-600">{metadata?.stats?.pluralism_score || stats?.intelligence?.pluralism?.pluralism_pct || 0}%</span>
                <Activity size={14} className="text-emerald-500" />
            </div>
        </div>
        <div class="briefing-deck-item accent-intl">
            <span class="text-[9px] font-black uppercase tracking-widest text-nyt-accent mb-3">{isMK ? 'ИНТЕРН. УДЕЛ' : 'INTERN. UDEO'}</span>
            <div class="flex items-baseline gap-[var(--grid-gap)]">
                <span class="text-3xl font-black tabular-nums text-nyt-accent">{metadata?.stats?.intl_share || stats?.intelligence?.international_share_pct || 0}%</span>
                <Timer size={14} className="text-nyt-accent" />
            </div>
        </div>
	</div>
</header>

<style>
    .briefing-masthead { margin-bottom: 3rem; }

    /* ── Report Status Bar ──────────────────────────── */
    .report-status-bar {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 0.6rem 1.25rem;
        border-radius: 99px;
    }
    .status-inner { display: flex; align-items: center; gap: 1.5rem; }
    .status-item { display: flex; align-items: center; gap: 0.5rem; }
    .divider-left { border-left: 1px solid var(--border); padding-left: 1.5rem; }
    .status-label { font-size: 0.55rem; font-weight: 900; letter-spacing: 0.1em; color: var(--muted-foreground); text-transform: uppercase; }
    .status-value { font-size: 0.6rem; font-weight: 850; letter-spacing: 0.05em; color: var(--foreground); }

    .pulse-indicator { width: 6px; height: 6px; border-radius: 50%; }
    .pulse-emerald { background: #10b981; box-shadow: 0 0 8px #10b981; animation: pulse-glow 2s infinite; }

    @keyframes pulse-glow {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    .masthead-main { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .masthead-title { font-family: var(--font-serif); font-size: clamp(2rem, 6vw, 4.5rem); font-weight: 950; line-height: 0.9; letter-spacing: -0.04em; margin: 0; }
    .italic-serif { font-style: italic; font-weight: 400; color: var(--nyt-accent); }
    .masthead-date-bar { width: 100%; text-align: center; margin-top: 1rem; }

    .signature-tag { font-family: var(--font-mono); }

    @media (max-width: 768px) {
        .report-status-bar { border-radius: 0px; }
        .status-inner { flex-wrap: wrap; gap: 0.75rem; }
        .divider-left { border: none; padding-left: 0; }
        .hide-mobile { display: none; }
        .signature-tag { width: 100%; border-top: 1px solid var(--border); padding-top: 0.5rem; margin-top: 0.25rem; }
    }

    @media (max-width: 639.98px) {
        .briefing-masthead { margin-bottom: 1.75rem; }
        .report-status-bar {
            margin-bottom: 1.25rem;
            padding: 0.55rem 0.85rem;
        }
        .status-inner {
            gap: 0.5rem 0.85rem;
        }
        .status-label {
            font-size: 0.48rem;
            letter-spacing: 0.08em;
        }
        .status-value {
            font-size: 0.52rem;
        }
        .masthead-main {
            margin-bottom: 1.75rem;
        }
        .masthead-branding {
            margin-bottom: 1.25rem;
        }
        .masthead-title {
            font-size: clamp(1.7rem, 10vw, 2.5rem);
            line-height: 0.94;
        }
        .masthead-subline {
            margin-top: 0.4rem;
            gap: 0.45rem;
        }
        .masthead-subline .h-px {
            width: 1.6rem;
        }
        .masthead-subline span {
            font-size: 0.5rem;
            letter-spacing: 0.22em;
        }
        .masthead-date-bar {
            margin-top: 0.5rem;
            padding: 0.8rem 0;
        }
        .masthead-date-bar p {
            font-size: 1.35rem;
            line-height: 1.15;
        }
        .masthead-deck {
            margin-bottom: 2rem;
        }
        .deck-item {
            padding: 0.9rem 0.85rem;
        }
        .deck-item > span:first-child {
            margin-bottom: 0.45rem;
            font-size: 0.48rem;
            letter-spacing: 0.16em;
        }
        .deck-item span.text-3xl {
            font-size: 1.45rem;
        }
        .deck-item div > span:last-child {
            font-size: 0.52rem;
        }
    }
</style>
