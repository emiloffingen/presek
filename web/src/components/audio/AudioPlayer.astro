---
// AudioPlayer.astro - reusable cluster audio player
import { Loader2, Pause, Play, RotateCcw, RotateCw } from 'lucide-react';
import { useTranslations } from '../../i18n/utils';

interface Props {
    clusterId?: string;
    lang: string;
    initialAudioUrl?: string;
    title?: string;
    compact?: boolean;
}

const { clusterId, lang, initialAudioUrl, title, compact = false } = Astro.props;
const t = useTranslations(lang as 'sr' | 'mk');
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const params = new URLSearchParams();
params.set('lang', lang);

const apiEndpoint = `${apiBase}/api/cluster/${clusterId}/audio?${params.toString()}`;

const labels = {
    title: title || t('cluster.audio.synthesis_title'),
    idle: t('cluster.audio.idle'),
    loading: t('cluster.audio.loading'),
    playing: t('cluster.audio.playing'),
    paused: t('cluster.audio.paused'),
    error: t('cluster.audio.error'),
    play: t('cluster.audio.play'),
    pause: t('cluster.audio.pause'),
    rewind: t('cluster.audio.rewind'),
    forward: t('cluster.audio.forward'),
};
---

<div
    class:list={['presek-audio-player', { 'is-compact': compact }]}
    data-cluster-id={clusterId}
    data-lang={lang}
    data-api-endpoint={apiEndpoint}
    data-state="idle"
    data-audio-bound="false"
    data-kicker={t('cluster.audio.kicker')}
>
    <div class="audio-main-row">
        <button class="audio-play-toggle" type="button" aria-label={labels.play} title={labels.play}>
            <Play className="audio-icon audio-icon-play" />
            <Pause className="audio-icon audio-icon-pause" />
            <Loader2 className="audio-icon audio-icon-loading" />
        </button>

        <div class="audio-copy">
            <div class="audio-title-row">
                <span class="audio-title">{labels.title}</span>
                <span class="audio-state">{labels.idle}</span>
            </div>
            <button class="audio-progress" type="button" aria-label={t('cluster.audio.seek')}>
                <span class="audio-progress-buffer"></span>
                <span class="audio-progress-fill"></span>
            </button>
        </div>

        <span class="audio-time">
            <span class="audio-current">0:00</span>
            <span class="audio-separator">/</span>
            <span class="audio-duration">0:00</span>
        </span>
    </div>

    <div class="audio-controls-row" aria-label={t('cluster.audio.controls')}>
        <button class="audio-skip" type="button" data-skip="-10" aria-label={labels.rewind} title={labels.rewind}>
            <RotateCcw size={13} />
            <span>10</span>
        </button>
        <button class="audio-speed" type="button" aria-label={t('cluster.audio.speed')} title="1x">1x</button>
        <button class="audio-skip" type="button" data-skip="10" aria-label={labels.forward} title={labels.forward}>
            <span>10</span>
            <RotateCw size={13} />
        </button>
    </div>

    <audio class="audio-element" preload="metadata" src={initialAudioUrl || undefined}></audio>
</div>

<style>
    .presek-audio-player {
        --audio-accent: var(--cluster-accent, var(--nyt-accent));
        position: relative;
        display: grid;
        gap: 0.65rem;
        width: min(100%, 34rem);
        padding: 0.85rem 0;
        border-top: 2px solid var(--foreground);
        border-bottom: 1px solid var(--border);
        background: transparent;
        box-shadow: none;
        color: var(--foreground);
    }

    .presek-audio-player::before {
        content: attr(data-kicker);
        position: absolute;
        top: -0.65rem;
        left: 0;
        padding-right: 0.5rem;
        background: var(--background);
        color: var(--audio-accent);
        font-family: var(--font-sans);
        font-size: 0.52rem;
        font-weight: 950;
        letter-spacing: 0.18em;
        line-height: 1;
    }

    .presek-audio-player.is-compact {
        width: 100%;
        padding: 0.65rem 0;
        gap: 0.45rem;
        border-top-width: 1px;
    }

    .audio-main-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.8rem;
    }

    .audio-play-toggle {
        width: 2.25rem;
        height: 2.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0;
        background: transparent;
        color: var(--foreground);
        border: 1px solid var(--foreground);
        transition: color 0.16s var(--ease-editorial), border-color 0.16s var(--ease-editorial), background-color 0.16s var(--ease-editorial);
    }

    .presek-audio-player.is-compact .audio-play-toggle {
        width: 1.8rem;
        height: 1.8rem;
    }

    .audio-play-toggle:hover {
        background: var(--foreground);
        color: var(--background);
        border-color: var(--foreground);
    }

    .audio-play-toggle:disabled {
        cursor: wait;
        opacity: 0.82;
    }

    .audio-icon {
        width: 0.95rem;
        height: 0.95rem;
    }

    .audio-icon-pause,
    .audio-icon-loading,
    .presek-audio-player[data-state="playing"] .audio-icon-play,
    .presek-audio-player[data-state="loading"] .audio-icon-play {
        display: none;
    }

    .presek-audio-player[data-state="playing"] .audio-icon-pause,
    .presek-audio-player[data-state="loading"] .audio-icon-loading {
        display: block;
    }

    .presek-audio-player[data-state="loading"] .audio-icon-loading {
        animation: audio-spin 0.8s linear infinite;
    }

    .audio-copy {
        min-width: 0;
        display: grid;
        gap: 0.48rem;
    }

    .audio-title-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
    }

    .audio-title {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 950;
        letter-spacing: 0;
        line-height: 1;
    }

    .audio-state {
        flex: none;
        font-family: var(--font-sans);
        font-size: 0.56rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted-foreground);
    }

    .audio-progress {
        position: relative;
        height: 0.32rem;
        width: 100%;
        overflow: hidden;
        border-radius: 0;
        background: color-mix(in srgb, var(--foreground) 12%, transparent);
        cursor: pointer;
    }

    .audio-progress-buffer,
    .audio-progress-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0%;
        border-radius: 0;
    }

    .audio-progress-buffer {
        background: color-mix(in srgb, var(--foreground) 18%, transparent);
    }

    .audio-progress-fill {
        background: var(--audio-accent);
    }

    .audio-time {
        display: inline-flex;
        align-items: center;
        gap: 0.18rem;
        min-width: 4.9rem;
        justify-content: flex-end;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 950;
        color: var(--muted-foreground);
        font-variant-numeric: tabular-nums;
    }

    .audio-controls-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0;
        border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
        padding-top: 0.45rem;
    }

    .audio-skip,
    .audio-speed {
        height: 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        border: 0;
        border-left: 1px solid var(--border);
        background: transparent;
        color: var(--muted-foreground);
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        line-height: 1;
        padding: 0 0.55rem;
        text-transform: uppercase;
    }

    .audio-speed {
        min-width: 2.2rem;
    }

    .audio-skip:hover,
    .audio-speed:hover {
        border-color: var(--audio-accent);
        color: var(--audio-accent);
    }

    .audio-element {
        display: none;
    }

    .presek-audio-player[data-state="error"] {
        border-top-color: var(--nyt-red);
    }

    .presek-audio-player[data-state="error"] .audio-state {
        color: var(--nyt-red);
    }

    @media (max-width: 640px) {
        .presek-audio-player {
            padding: 0.75rem 0;
        }

        .audio-main-row {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .audio-time {
            grid-column: 2;
            justify-content: flex-start;
            min-width: 0;
        }

        .audio-title-row {
            display: grid;
            gap: 0.1rem;
        }
    }

    @keyframes audio-spin {
        to { transform: rotate(360deg); }
    }
</style>
