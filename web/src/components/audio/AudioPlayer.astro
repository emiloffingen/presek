---
// AudioPlayer.astro - Reusable audio player component
import { Play, Pause, Volume2, VolumeX } from 'lucide-react';

interface Props {
    clusterId?: string;
    briefingDate?: string;
    lang: string;
    type: 'cluster' | 'briefing';
    initialAudioUrl?: string;
}

const { clusterId, briefingDate, lang, type, initialAudioUrl } = Astro.props;
const isMK = lang === 'mk';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';

// Determine which API endpoint to use based on type
const apiEndpoint = type === 'cluster' 
    ? `${apiBase}/api/cluster/${clusterId}/audio?lang=${lang}`
    : `${apiBase}/intelligence/briefing/audio${briefingDate ? `?date=${briefingDate}&lang=${lang}` : `?lang=${lang}`}`;

const playIcon = isMK ? 'Слушај аудио синтеза' : 'Slušaj audio sintezu';
const pauseIcon = isMK ? 'Паузирај аудио' : 'Pauziraj audio';
const loadingText = isMK ? 'Подготвувам аудио...' : 'Pripremam audio...';
---

<div
    class="audio-player-wrapper flex items-center gap-3"
    data-type={type}
    data-cluster-id={clusterId}
    data-briefing-date={briefingDate}
    data-lang={lang}
    data-api-endpoint={apiEndpoint}
    data-audio-bound="false"
>
    <button class="audio-play-btn flex items-center justify-center bg-nyt-accent/10 hover:bg-nyt-accent/25 border border-nyt-accent/20 rounded-full w-8 h-8 transition-all cursor-pointer" 
            type="button"
            aria-label={playIcon} 
            title={playIcon}>
        <Play className="audio-icon audio-icon-play w-4 h-4 text-nyt-accent" />
        <Pause className="audio-icon audio-icon-pause w-4 h-4 text-nyt-accent" />
    </button>
    
    <span class="audio-status-text text-[11px] text-nyt-accent font-sans font-black uppercase tracking-widest transition-all duration-300 opacity-0 max-w-0 overflow-hidden whitespace-nowrap">{loadingText}</span>
    
    <audio class="hidden audio-element" preload="none" src={initialAudioUrl || undefined}></audio>
</div>

<style>
    .audio-player-wrapper {
        position: relative;
    }
    
    .audio-play-btn {
        flex-shrink: 0;
    }
    
    .audio-status-text {
        transition: all 0.3s ease;
    }
    
    .audio-player-wrapper[data-audio-bound="true"] .audio-status-text {
        opacity: 1;
        max-width: 200px;
    }
    
    .audio-play-btn.playing {
        background-color: rgba(var(--nyt-accent-rgb), 0.25);
        border-color: rgba(var(--nyt-accent-rgb), 0.5);
    }
    
    .audio-icon-pause,
    .audio-play-btn.playing .audio-icon-play {
        display: none;
    }

    .audio-play-btn.playing .audio-icon-pause {
        display: block;
    }
</style>

<script is:inline>
    function initAudioPlayers() {
        document.querySelectorAll('.audio-player-wrapper').forEach((wrapper) => {
            if (!wrapper || wrapper.dataset.audioBound === 'true') return;

            const playBtn = wrapper.querySelector('.audio-play-btn');
            const statusText = wrapper.querySelector('.audio-status-text');
            const audio = wrapper.querySelector('.audio-element');
            if (!playBtn || !statusText || !audio) return;

            wrapper.dataset.audioBound = 'true';

            let isPlaying = false;
            let isLoading = false;
            let errorMessage = '';

            function playLabel() {
                return wrapper.dataset.lang === 'mk' ? 'Слушај аудио синтеза' : 'Slušaj audio sintezu';
            }

            function pauseLabel() {
                return wrapper.dataset.lang === 'mk' ? 'Паузирај аудио' : 'Pauziraj audio';
            }

            function updateUI() {
                if (isLoading) {
                    errorMessage = '';
                    statusText.textContent = wrapper.dataset.lang === 'mk' ? 'Подготвувам аудио...' : 'Pripremam audio...';
                    statusText.classList.remove('text-red-500');
                    playBtn.disabled = true;
                    playBtn.classList.remove('playing');
                    return;
                }

                playBtn.disabled = false;

                if (isPlaying) {
                    errorMessage = '';
                    statusText.textContent = wrapper.dataset.lang === 'mk' ? 'Се пушта' : 'Se pušta';
                    statusText.classList.remove('text-red-500');
                    playBtn.classList.add('playing');
                    playBtn.setAttribute('aria-label', pauseLabel());
                    playBtn.setAttribute('title', pauseLabel());
                    return;
                }

                playBtn.classList.remove('playing');
                playBtn.setAttribute('aria-label', playLabel());
                playBtn.setAttribute('title', playLabel());

                if (errorMessage) {
                    statusText.textContent = errorMessage;
                    statusText.classList.add('text-red-500');
                } else {
                    statusText.textContent = '';
                    statusText.classList.remove('text-red-500');
                }
            }

            async function loadAndPlayAudio() {
                if (isLoading || isPlaying) return;

                try {
                    isLoading = true;
                    updateUI();

                    if (audio.currentSrc || audio.getAttribute('src')) {
                        await audio.play();
                        isPlaying = true;
                        return;
                    }

                    const response = await fetch(wrapper.dataset.apiEndpoint);
                    const data = await response.json();

                    if (data.status === 'success' && data.audio_url) {
                        audio.src = data.audio_url.startsWith('http')
                            ? data.audio_url
                            : new URL(data.audio_url, new URL(wrapper.dataset.apiEndpoint, window.location.href).origin).href;
                        await audio.play();
                        isPlaying = true;
                    } else {
                        throw new Error(data.message || 'Unknown error');
                    }
                } catch (err) {
                    console.error('Failed to load audio:', err);
                    errorMessage = wrapper.dataset.lang === 'mk' ? 'Грешка при вчитување на аудиото.' : 'Greška pri učitavanju audio zapisa.';
                    isPlaying = false;
                } finally {
                    isLoading = false;
                    updateUI();
                }
            }

            playBtn.addEventListener('click', async function() {
                if (isLoading) return;

                if (isPlaying) {
                    audio.pause();
                    isPlaying = false;
                } else {
                    await loadAndPlayAudio();
                }

                updateUI();
            });

            audio.addEventListener('ended', () => {
                isPlaying = false;
                updateUI();
            });

            audio.addEventListener('pause', () => {
                if (isPlaying) {
                    isPlaying = false;
                    updateUI();
                }
            });

            audio.addEventListener('play', () => {
                if (!isPlaying) {
                    isPlaying = true;
                    updateUI();
                }
            });

            audio.addEventListener('error', () => {
                errorMessage = wrapper.dataset.lang === 'mk' ? 'Грешка при пуштање на аудиото.' : 'Greška pri puštanju audio zapisa.';
                isPlaying = false;
                isLoading = false;
                updateUI();
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initAudioPlayers);
    document.addEventListener('astro:page-load', initAudioPlayers);
</script>
