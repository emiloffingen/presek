---
interface Props {
    mode?: 'full' | 'emblem' | 'logo';
    class?: string;
}

const { mode = 'full', class: className } = Astro.props;
---

<div class:list={["presek-branding", mode, className]}>
    {(mode === 'full' || mode === 'emblem') && (
        <div class="emblem-container">
            <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="presek-emblem-svg">
                <g class="ink-color">
                    <rect x="5" y="5" width="90" height="90" rx="0" stroke="currentColor" stroke-width="6" fill="none" class="outer-box" />
                    <rect x="15" y="15" width="70" height="70" rx="0" stroke="currentColor" stroke-width="1.5" fill="none" class="inner-box" />
                    <text x="50" y="80" font-family="var(--font-serif)" font-weight="950" font-size="78" text-anchor="middle" fill="currentColor">П</text>
                </g>
            </svg>
            <div class="pulse-ring"></div>
        </div>
    )}

    {(mode === 'full' || mode === 'logo') && (
        <svg width="180" height="45" viewBox="0 0 500 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="presek-logo-svg">
            <g class="ink-color">
                <text x="250" y="70" font-family="var(--font-serif)" font-weight="950" font-size="82" letter-spacing="-2" text-anchor="middle" fill="currentColor">ПРЕСЕК.мк</text>
                <line x1="50" y1="92" x2="450" y2="92" stroke="currentColor" stroke-width="3" />
                <line x1="50" y1="98" x2="450" y2="98" stroke="currentColor" stroke-width="1.5" />
                <text x="250" y="116" font-family="var(--font-sans)" font-weight="900" font-size="12" letter-spacing="6" text-anchor="middle" fill="currentColor" opacity="0.8">ИНФОРМАТИВЕН ДИГИТАЛЕН АГРЕГАТОР</text>
            </g>
        </svg>
    )}
</div>

<style>
    .presek-branding {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        color: var(--foreground);
    }

    .emblem-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .presek-emblem-svg {
        position: relative;
        z-index: 2;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .presek-logo-svg {
        height: auto;
    }

    /* --- LIVE PULSE EFFECT --- */
    .pulse-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border: 2px solid var(--nyt-accent);
        opacity: 0;
        z-index: 1;
        animation: logo-pulse 4s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    }

    @keyframes logo-pulse {
        0% { transform: scale(0.8); opacity: 0; }
        50% { opacity: 0.25; }
        100% { transform: scale(1.6); opacity: 0; }
    }

    /* --- HOVER DYNAMICS --- */
    .presek-branding:hover .presek-emblem-svg {
        transform: scale(1.1) rotate(-2deg);
        color: var(--nyt-accent);
    }

    .presek-branding:hover .presek-logo-svg {
        transform: translateX(2px);
    }

    /* --- DARK MODE ADJUSTMENTS --- */
    :global(.dark) .presek-branding {
        color: color-mix(in srgb, var(--foreground) 90%, white 10%);
    }

    /* --- SIZE VARIANTS --- */
    .presek-branding.footer-mode .presek-emblem-svg { width: 50px; height: 50px; }
    .presek-branding.footer-mode .presek-logo-svg { width: 240px; }
</style>
