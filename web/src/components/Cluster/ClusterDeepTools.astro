---
import StorylineHistoryIsland from '../StorylineHistoryIsland.tsx';
import ClusterHistoryIsland from '../ClusterHistoryIsland.tsx';

interface Props {
  clusterId: string;
  apiUrl: string;
  lang: string;
  t: (key: string) => string;
}

const { clusterId, apiUrl, lang, t } = Astro.props;
---

<section class="editorial-section cluster-deep-tools mb-16">
  <details class="cluster-deep-tools-details">
    <summary class="cluster-deep-tools-summary">
      <span class="cluster-deep-tools-title">{t('cluster.deep_synthesis')}</span>
      <span class="cluster-deep-tools-hint">
        {lang === 'sr' ? 'Vremenska linija i istorija klastera' : 'Временска линија и историја на кластерот'}
      </span>
    </summary>
    <div class="cluster-deep-tools-body">
      <StorylineHistoryIsland client:visible clusterId={clusterId} apiUrl={apiUrl} lang={lang} />
      <ClusterHistoryIsland client:visible clusterId={clusterId} lang={lang} />
    </div>
  </details>
</section>
