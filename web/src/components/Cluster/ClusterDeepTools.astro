---
import StorylineHistoryIsland from '../StorylineHistoryIsland.tsx';
import ClusterHistoryIsland from '../ClusterHistoryIsland.tsx';
import ClusterResearchQA from './ClusterResearchQA.astro';

interface Perspective {
  angle?: string;
  content?: string;
}

interface Props {
  clusterId: string;
  apiUrl: string;
  lang: string;
  t: (key: string) => string;
  keyFacts?: string[];
  perspectives?: Perspective[];
  synthesisBullets?: string[];
  generatedArticle?: string | null;
}

const {
  clusterId,
  apiUrl,
  lang,
  t,
  keyFacts = [],
  perspectives = [],
  synthesisBullets = [],
  generatedArticle = '',
} = Astro.props;
---

<section class="editorial-section cluster-deep-tools mb-16">
  <ClusterResearchQA
    lang={lang as 'sr' | 'mk'}
    keyFacts={keyFacts}
    perspectives={perspectives}
    synthesisBullets={synthesisBullets}
    generatedArticle={generatedArticle}
  />

  <details class="cluster-deep-tools-details mt-10">
    <summary class="cluster-deep-tools-summary">
      <span class="cluster-deep-tools-title">{t('cluster.deep_synthesis')}</span>
      <span class="cluster-deep-tools-hint">
        {t('cluster.deep_synthesis_hint')}
      </span>
    </summary>
    <div class="cluster-deep-tools-body">
      <StorylineHistoryIsland client:visible clusterId={clusterId} apiUrl={apiUrl} lang={lang} />
      <ClusterHistoryIsland client:visible clusterId={clusterId} lang={lang} />
    </div>
  </details>
</section>
