---
import { cleanAndDecode } from '../../utils/textUtils';

interface Props {
	citationSources: any[];
	lang?: 'sr' | 'mk';
}

const { citationSources, lang = 'sr' } = Astro.props;
const heading = lang === 'mk' ? 'Поврзани извори' : 'Povezani izvori';
---

<footer class="narrative-citations mt-12 p-8 bg-secondary/10 border border-border/40 rounded-lg">
	<h4 class="citation-heading">{heading}</h4>
	<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-[var(--grid-gap)]">
		{citationSources.map((art: any) => (
			<div class="citation-card group">
				<p class="citation-source">{art.source}</p>
				<a href={art.link} target="_blank" rel="noopener noreferrer" class="citation-link">
					{cleanAndDecode(art.title)}
				</a>
			</div>
		))}
	</div>
</footer>

<style>
	.citation-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.citation-source {
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 950;
		text-transform: uppercase;
		color: var(--muted-foreground);
		margin-bottom: 0.25rem;
		letter-spacing: 0.05em;
	}
	.citation-link {
		font-family: var(--font-serif);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--foreground);
		text-decoration: none;
		display: block;
		text-wrap: pretty;
	}

    .citation-heading {
        margin: 0 0 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 950;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }
	.citation-link:hover {
		color: var(--nyt-accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
</style>
