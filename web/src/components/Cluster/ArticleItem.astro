---
import { Link2 } from 'lucide-react';
import { sanitizeHtml } from '../../lib/sanitize';

interface Props {
	article: any;
}

const { article: a } = Astro.props;
---

<div class={`article-editorial-row tone-${a.relationship.tone}`} data-article-link={encodeURIComponent(a.link || '')}>
	<div class="row-header">
		<div class="row-source-info">
			<span class="source-name">{a.source}</span>
			<span class={`tone-badge tone-${a.relationship.tone}`}>{a.relationship.label}</span>
			{a.sourceSignal?.trust_label && (
				<span class={`trust-badge trust-${a.sourceSignal.trust_label === 'Висока доверба' ? 'high' : a.sourceSignal.trust_label === 'Потвреден извор' ? 'medium' : 'low'}`}>
					{a.sourceSignal.trust_label}
				</span>
			)}
		</div>
		<div class="row-time">
			<span class="exact">{a.exactTime}</span>
			<span class="relative">{a.relativeTime}</span>
		</div>
	</div>
	<a href={a.link} target="_blank" rel="noopener noreferrer" class="row-title-link">
		<h3 class="row-title" set:html={sanitizeHtml(a.title)}></h3>
	</a>
	<p class="row-snippet" set:html={sanitizeHtml(a.description)}></p>
	<div class="row-footer">
		<a href={a.link} target="_blank" rel="noopener noreferrer" class="read-original">
			Оригинална објава <Link2 size={12} />
		</a>
	</div>
</div>

<style>
	.article-editorial-row {
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--border);
		transition: background-color 0.2s ease;
	}

	.article-editorial-row:last-child {
		border-bottom: none;
	}

	.row-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.75rem;
	}

	.row-source-info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.source-name {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tone-badge {
		font-family: var(--font-sans);
		font-size: 0.55rem;
		font-weight: 900;
		padding: 1px 6px;
		border-radius: 2px;
		text-transform: uppercase;
	}

	.tone-badge.tone-positive { background: color-mix(in srgb, var(--nyt-accent) 10%, transparent); color: var(--nyt-accent); }
	.tone-badge.tone-negative { background: color-mix(in srgb, var(--nyt-red) 10%, transparent); color: var(--nyt-red); }
	.tone-badge.tone-neutral { background: var(--secondary); color: var(--muted-foreground); }

	.trust-badge {
		font-family: var(--font-sans);
		font-size: 0.55rem;
		font-weight: 900;
		padding: 1px 6px;
		border-radius: 2px;
		text-transform: uppercase;
	}

	.trust-badge.trust-high { background: #10b981; color: white; }
	.trust-badge.trust-medium { background: #3b82f6; color: white; }
	.trust-badge.trust-low { background: #6b7280; color: white; }

	.row-time {
		display: flex;
		gap: 0.5rem;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 800;
		color: var(--muted-foreground);
	}

	.row-title-link {
		text-decoration: none;
		color: inherit;
		display: block;
		margin-bottom: 0.5rem;
	}

	.row-title {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--foreground);
	}

	.row-title-link:hover .row-title {
		color: var(--nyt-accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.row-snippet {
		font-family: var(--font-nyt-body);
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
		margin-bottom: 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row-footer {
		display: flex;
		justify-content: flex-end;
	}

	.read-original {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		color: var(--nyt-accent);
		text-transform: uppercase;
		text-decoration: none;
	}

	.read-original:hover {
		text-decoration: underline;
	}
</style>
