---
import { ShieldCheck, ExternalLink, FileText, ChevronDown } from 'lucide-react';
import { deShout, cleanAndDecode } from '../../utils/textUtils';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
	article: any;
	rowId?: string;
}

const { article: a, rowId } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const isMk = lang === 'mk';
const t = useTranslations(lang);

// Clean text function to strip HTML tags and unwanted artifacts
function cleanText(text: string) {
    if (!text) return '';
    // Strip HTML tags
    let clean = text.replace(/<[^>]*>?/gm, '');
    // Clean and decode entities
    clean = cleanAndDecode(clean);
    // De-shout
    clean = deShout(clean);
    return clean;
}

const articleRef = a.id || (a.link ? a.link.hashCode() : rowId);
const displayTitle = cleanText(a.title);
const displaySnippet = cleanText(a.description || a.summary);
const objectiveTitle = isMk ? 'Висок степен на фактичко известување' : 'Visok stepen faktičkog izveštavanja';
const readOriginalLabel = isMk ? 'ПРОЧИТАЈ НА' : 'PROČITAJ NA';
const showFullTextLabel = t('cluster.fulltext.show');
const hideFullTextLabel = t('cluster.fulltext.hide');
const fulltextLoading = t('cluster.fulltext.loading');
const fulltextError = t('cluster.fulltext.error');
const fulltextUnavailable = t('cluster.fulltext.unavailable');
const sourceLabel = t('cluster.fulltext.source_label');
const openOriginalLabel = t('cluster.fulltext.open_original');
const copyrightNotice = t('cluster.fulltext.copyright', { source: a.source });
---

<div id={rowId} class={`article-editorial-row tone-${a.relationship.tone} timeline-item min-w-0`} data-article-link={encodeURIComponent(a.link || '')} role="article" aria-labelledby={`article-title-${articleRef || 'article'}`}>
	<div class="timeline-dot" role="presentation"></div>
    <div class="row-header">
		<div class="row-source-info">
			<span class="source-name">{a.source}</span>
			<span class={`tone-badge tone-${a.relationship.tone}`} aria-label={t('article.relationship_type', { type: a.relationship.label })}>
				{a.relationship.label}
			</span>

            {a.quality.isObjective && (
                <span class="quality-badge badge-obj" title={objectiveTitle} aria-label={objectiveTitle}>
                    <ShieldCheck size={10} />
                </span>
            )}
		</div>
		<div class="row-time">
			<time datetime={a.published_at || a.ingested_at}>{a.relativeTime}</time>
		</div>
	</div>
	<a href={a.link} target="_blank" rel="noopener noreferrer" class="row-title-link" aria-describedby={`article-source-${articleRef}`}>
		<h3 id={`article-title-${articleRef}`} class="row-title min-w-0 break-words whitespace-normal">{displayTitle}</h3>
	</a>
	{displaySnippet && (
        <p class="row-snippet min-w-0 break-words whitespace-normal">{displaySnippet}</p>
    )}
	<div class="row-footer">
        <a href={a.link} target="_blank" rel="noopener noreferrer" class="read-original" id={`article-source-${articleRef}`}>
            {readOriginalLabel} {a.source} <ExternalLink size={10} aria-hidden="true" />
        </a>
	</div>

    {a.id && (
        <div
            class="fulltext-wrap"
            data-article-id={a.id}
            data-loading={fulltextLoading}
            data-error={fulltextError}
            data-unavailable={fulltextUnavailable}
        >
            <button
                type="button"
                class="fulltext-toggle"
                aria-expanded="false"
                aria-controls={`fulltext-panel-${articleRef}`}
                data-show-label={showFullTextLabel}
                data-hide-label={hideFullTextLabel}
            >
                <FileText size={13} aria-hidden="true" />
                <span class="fulltext-toggle-label">{showFullTextLabel}</span>
                <ChevronDown size={13} className="fulltext-chevron" aria-hidden="true" />
            </button>
            <div class="fulltext-panel" id={`fulltext-panel-${articleRef}`} hidden>
                <div class="fulltext-head">
                    <span class="fulltext-source">{sourceLabel} <strong>{a.source}</strong></span>
                    <a href={a.link} target="_blank" rel="noopener noreferrer" class="fulltext-original">
                        {openOriginalLabel} <ExternalLink size={10} aria-hidden="true" />
                    </a>
                </div>
                <div class="fulltext-body" data-loaded="false" lang="mk"></div>
                <p class="fulltext-copyright">{copyrightNotice}</p>
            </div>
        </div>
    )}
</div>


<style>
	.article-editorial-row {
		padding: 1.75rem 0 1.75rem 3rem;
		border-bottom: 1px solid var(--border);
		border-left: 3px solid transparent;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
	}

	.article-editorial-row:hover {
		background-color: color-mix(in srgb, var(--cluster-accent, var(--nyt-accent)) 3%, var(--background));
		border-left-color: var(--cluster-accent, var(--nyt-accent));
	}

    .timeline-dot {
        position: absolute;
        left: 0.5rem;
        top: 2.1rem;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border);
        border: 2px solid var(--background);
        z-index: 1;
        transition: transform 0.2s ease;
    }

    .article-editorial-row:hover .timeline-dot {
        transform: scale(1.2);
        background: var(--cluster-accent, var(--nyt-accent));
    }

    .article-editorial-row.tone-latest .timeline-dot { background: var(--editorial-positive); }
    .article-editorial-row.tone-origin .timeline-dot { background: var(--muted-foreground); }
    .article-editorial-row.tone-deep .timeline-dot { background: var(--nyt-accent); }

	.article-editorial-row:last-child {
		border-bottom: none;
	}

	.row-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.85rem;
	}

	.row-source-info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
        flex-wrap: wrap;
	}

	.source-name {
		font-family: var(--font-sans);
		font-size: 0.64rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
        color: var(--foreground);
	}

	.tone-badge {
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 800;
		padding: 2px 6px;
		border-radius: 0px;
		text-transform: uppercase;
        letter-spacing: 0.05em;
	}

    .tone-badge.tone-latest {
        background: color-mix(in srgb, var(--editorial-positive) 12%, transparent);
        color: var(--editorial-positive);
    }
	.tone-badge.tone-origin {
        background: color-mix(in srgb, var(--muted-foreground) 12%, transparent);
        color: var(--muted-foreground);
    }
    .tone-badge.tone-deep {
        background: color-mix(in srgb, var(--nyt-accent) 12%, transparent);
        color: var(--nyt-accent);
    }
    .tone-badge.tone-neutral { background: var(--secondary); color: var(--secondary-foreground); }

    /* Quality Badges */
    .quality-badge {
        display: flex;
        align-items: center;
        color: var(--editorial-positive);
        opacity: 0.8;
    }

	.row-time {
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 700;
		color: var(--muted-foreground);
        text-transform: uppercase;
        letter-spacing: 0.05em;
	}

	.row-title-link {
		text-decoration: none;
		color: inherit;
		display: block;
		margin-bottom: 0.75rem;
	}

	.row-title {
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.38rem);
		font-weight: 800;
		line-height: 1.3;
		color: var(--foreground);
        letter-spacing: -0.01em;
	}

	.row-title-link:hover .row-title {
		color: var(--cluster-accent, var(--nyt-accent));
	}

	.row-snippet {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.58;
		color: var(--secondary-foreground);
		margin-bottom: 1.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
        opacity: 0.85;
	}

	.row-footer {
		display: flex;
		justify-content: flex-start;
	}

	.read-original {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		color: var(--muted-foreground);
		text-transform: uppercase;
		text-decoration: none;
        letter-spacing: 0.1em;
        transition: color 0.2s ease;
	}

	.read-original:hover {
		color: var(--cluster-accent, var(--nyt-accent));
	}

	/* Full original text (transparency mode) */
	.fulltext-wrap {
		margin-top: 0.9rem;
	}

	.fulltext-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		border: 1px solid var(--border);
		color: var(--foreground);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.4rem 0.7rem;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}

	.fulltext-toggle:hover {
		border-color: var(--cluster-accent, var(--nyt-accent));
		color: var(--cluster-accent, var(--nyt-accent));
	}

	.fulltext-toggle[aria-expanded="true"] .fulltext-chevron {
		transform: rotate(180deg);
	}

	.fulltext-chevron {
		transition: transform 0.2s ease;
	}

	.fulltext-panel {
		margin-top: 1rem;
		padding: 1.1rem 1.2rem;
		border-left: 2px solid var(--cluster-accent, var(--nyt-accent));
		background: color-mix(in srgb, var(--foreground) 3%, transparent);
	}

	.fulltext-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
	}

	.fulltext-source {
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted-foreground);
	}

	.fulltext-source strong {
		color: var(--foreground);
	}

	.fulltext-original {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--cluster-accent, var(--nyt-accent));
		text-decoration: none;
	}

	.fulltext-original:hover {
		text-decoration: underline;
	}

	.fulltext-body {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--foreground);
	}

	.fulltext-body p {
		margin: 0 0 0.85rem;
	}

	.fulltext-body p:last-child {
		margin-bottom: 0;
	}

	.fulltext-copyright {
		margin-top: 1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.6rem;
		line-height: 1.5;
		color: var(--muted-foreground);
	}
</style>
