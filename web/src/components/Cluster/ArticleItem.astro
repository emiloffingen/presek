---
import { Link2, ShieldCheck, ExternalLink } from 'lucide-react';
import { sanitizeHtml } from '../../lib/sanitize';
import { deShout, cleanAndDecode } from '../../utils/textUtils';

interface Props {
	article: any;
}

const { article: a } = Astro.props;

// Clean text function to strip HTML tags and unwanted artifacts
function cleanText(text: string) {
    if (!text) return '';
    // Strip HTML tags
    let clean = text.replace(/<[^>]*>?/gm, '');
    // Clean and decode entities
    clean = cleanAndDecode(clean);
    // De-shout
    clean = deShout(clean);
    return clean;
}

const displayTitle = cleanText(a.title);
const displaySnippet = cleanText(a.description || a.summary);
---

<div class={`article-editorial-row tone-${a.relationship.tone} timeline-item min-w-0`} data-article-link={encodeURIComponent(a.link || '')}>
	<div class="timeline-dot"></div>
    <div class="row-header">
		<div class="row-source-info">
			<span class="source-name">{a.source}</span>
			<span class={`tone-badge tone-${a.relationship.tone}`}>{a.relationship.label}</span>

            {a.quality.isObjective && (
                <span class="quality-badge badge-obj" title="Visok stepen na fakticko izvestuvanje">
                    <ShieldCheck size={10} />
                </span>
            )}
		</div>
		<div class="row-time">
			<span class="relative">{a.relativeTime}</span>
		</div>
	</div>
	<a href={a.link} target="_blank" rel="noopener noreferrer" class="row-title-link">
		<h3 class="row-title min-w-0 break-words whitespace-normal">{displayTitle}</h3>
	</a>
	{displaySnippet && (
        <p class="row-snippet min-w-0 break-words whitespace-normal">{displaySnippet}</p>
    )}
	<div class="row-footer">
		<a href={a.link} target="_blank" rel="noopener noreferrer" class="read-original">
			PROČITAJ NA {a.source} <ExternalLink size={10} />
		</a>
	</div>
</div>

<style>
	.article-editorial-row {
		padding: 1.75rem 0 1.75rem 3rem;
		border-bottom: 1px solid var(--border);
		transition: all 0.2s ease;
        position: relative;
	}

    .article-editorial-row:hover {
        background-color: var(--secondary)/5;
    }

    .timeline-dot {
        position: absolute;
        left: 0.5rem;
        top: 2.1rem;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border);
        border: 2px solid var(--background);
        z-index: 1;
        transition: transform 0.2s ease;
    }

    .article-editorial-row:hover .timeline-dot {
        transform: scale(1.2);
        background: var(--nyt-accent);
    }

    .article-editorial-row.tone-latest .timeline-dot { background: #10b981; }
    .article-editorial-row.tone-origin .timeline-dot { background: #64748b; }
    .article-editorial-row.tone-deep .timeline-dot { background: #6366f1; }

	.article-editorial-row:last-child {
		border-bottom: none;
	}

	.row-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.85rem;
	}

	.row-source-info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
        flex-wrap: wrap;
	}

	.source-name {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
        color: var(--foreground);
	}

	.tone-badge {
		font-family: var(--font-sans);
		font-size: 0.55rem;
		font-weight: 800;
		padding: 2px 6px;
		border-radius: 0px;
		text-transform: uppercase;
        letter-spacing: 0.05em;
	}

    .tone-badge.tone-latest { background: #dcfce7; color: #166534; }
	.tone-badge.tone-origin { background: #f1f5f9; color: #475569; }
    .tone-badge.tone-deep { background: #e0e7ff; color: #3730a3; }
    .tone-badge.tone-neutral { background: var(--secondary); color: var(--secondary-foreground); }

    /* Quality Badges */
    .quality-badge {
        display: flex;
        align-items: center;
        color: #10b981;
        opacity: 0.8;
    }

	.row-time {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 700;
		color: var(--muted-foreground);
        text-transform: uppercase;
        letter-spacing: 0.05em;
	}

	.row-title-link {
		text-decoration: none;
		color: inherit;
		display: block;
		margin-bottom: 0.75rem;
	}

	.row-title {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.3;
		color: var(--foreground);
        letter-spacing: -0.01em;
	}

	.row-title-link:hover .row-title {
		color: var(--nyt-accent);
	}

	.row-snippet {
		font-family: var(--font-nyt-body);
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--secondary-foreground);
		margin-bottom: 1.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
        opacity: 0.85;
	}

	.row-footer {
		display: flex;
		justify-content: flex-start;
	}

	.read-original {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		color: var(--muted-foreground);
		text-transform: uppercase;
		text-decoration: none;
        letter-spacing: 0.1em;
        transition: color 0.2s ease;
	}

	.read-original:hover {
		color: var(--nyt-accent);
	}
</style>
