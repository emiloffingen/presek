---
import { Newspaper } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
	leadVisual: any;
	dominantColor?: string;
	displayHeadline: string;
	id: string;
	category: string;
	sourcePreview: string[];
	articlesCount: number;
}

const { leadVisual, dominantColor, displayHeadline, id, category, sourcePreview, articlesCount } = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const fallbackImageUrl = leadVisual?.fallbackUrl || leadVisual?.src || '';
---

<div class="hero-visual-area">
	{leadVisual?.src ? (
		<div class:list={["hero-visual-card shadow-editorial", leadVisual.isWeak ? "is-weak is-proxy-fallback" : ""]}>
			{dominantColor && !leadVisual.isWeak && (
				<div class="hero-visual-aura" style={`background-color: ${dominantColor};`}></div>
			)}

			<img
				src={leadVisual.src}
				alt=""
				class="hero-main-image"
				transition:name={`cluster-image-${id}`}
				loading="eager"
				decoding="async"
				data-fallback-url={fallbackImageUrl}
			/>
			<div class="hero-caption py-3 px-4 bg-background/80 backdrop-blur-sm border-t border-border/40 uppercase font-bold tracking-widest text-muted-foreground">
				{t('cluster.hero_caption')} · {articlesCount} {t('cluster.newsrooms_analyzed')}
			</div>
		</div>
	) : (
		<div class="hero-fallback-plain p-12 bg-secondary/20 border border-border/40 text-center">
			<Newspaper size={48} className="mx-auto mb-4 opacity-20" />
			<p class="font-serif italic text-muted-foreground">{t('cluster.no_image')}</p>
		</div>
	)}
</div>

<style>
	.hero-visual-card {
		position: relative;
		border: 1px solid var(--border);
		background: var(--card);
		overflow: hidden;
		min-height: 300px;
		display: flex;
		flex-direction: column;
	}

	.hero-visual-aura {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0.15;
		filter: blur(80px);
		z-index: 0;
		pointer-events: none;
	}

	.hero-main-image {
		width: 100%;
		height: auto;
		aspect-ratio: 3/2;
		object-fit: cover;
		display: block;
		position: relative;
		z-index: 1;
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	:global(.hero-main-image.is-loaded) {
		opacity: 1;
	}

	.hero-visual-card.is-proxy-fallback .hero-main-image {
		object-fit: contain;
		background: #111827;
	}

    .hero-caption {
        font-family: var(--font-sans);
        font-size: 0.62rem;
    }
</style>
