---
import { BookOpen, ListChecks, Layers, ShieldCheck } from 'lucide-react';

interface Props {
  primaryNarrativeLabel: string;
  showKeyFacts: boolean;
  showAnalysis: boolean;
  t: (key: string) => string;
}

const { primaryNarrativeLabel, showKeyFacts, showAnalysis, t } = Astro.props;
---

<nav class="reader-actions cluster-reading-nav" aria-label={t('cluster.reading_nav_aria')}>
  <a href="#cluster-synthesis"><BookOpen size={14} /> {primaryNarrativeLabel}</a>
  {showKeyFacts && (
    <a href="#cluster-key-facts"><Layers size={14} /> {t('cluster.nav_key_facts')}</a>
  )}
  <a href="#cluster-sources"><ListChecks size={14} /> {t('cluster.nav_sources')}</a>
  {showAnalysis && (
    <a href="#cluster-analysis"><ShieldCheck size={14} /> {t('cluster.nav_analysis')}</a>
  )}
</nav>

<style>
  .cluster-reading-nav {
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .cluster-reading-nav a {
      flex: 1 1 calc(50% - 0.25rem);
      min-width: 0;
    }
  }
</style>
