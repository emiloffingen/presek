---
import { cleanAndDecode, parseFootnotes } from '../../utils/textUtils';
import { sanitizeHtml } from '../../lib/sanitize';

interface Props {
	hasStrongLeadNarrative: boolean;
	generatedArticle: string | null;
	synthesisItems: any[];
	hasCitationSources: boolean;
}

const { hasStrongLeadNarrative, generatedArticle, synthesisItems, hasCitationSources } = Astro.props;

function renderSynthesisHtml(text: string) {
	if (!text) return '';
	let clean = cleanAndDecode(text);
	if (!clean) return '';

	// 1. Strip residual AI placeholders
	clean = clean.replace(/\[ПРЕТХОДЕН КОНТЕКСТ\]/gi, '');

	// 2. Handle Markdown Bold: **text** -> <strong>text</strong>
	clean = clean.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

	// 3. Handle Markdown Italics: *text* -> <em>text</em>
	clean = clean.replace(/\*(.*?)\*/g, '<em>$1</em>');

    // 4. Handle Parenthetical Citations: (Извор: Име) or (Име) -> <span class="citation-badge">Име</span>
    // We target common news source patterns (capitalised, 1-3 words)
    clean = clean.replace(/\((?:Извор:\s*)?([A-ZА-Ш][a-zа-ш0-9\s\.]{2,20})\)/g, (match, name) => {
        return `<span class="citation-badge">${name.trim()}</span>`;
    });

	if (hasCitationSources) return sanitizeHtml(parseFootnotes(clean));
	return sanitizeHtml(clean.replace(/\[(\d+)\]/g, '').replace(/\s{2,}/g, ' ').trim());
}
---

<div class="editorial-narrative prose-editorial">
	{hasStrongLeadNarrative && generatedArticle ? (
		<div class="narrative-body font-serif">
			{generatedArticle.split('\n').filter((p: string) => p.trim()).map((paragraph: string, idx: number) => (
				<p class:list={["narrative-p", idx === 0 ? "drop-cap" : ""]} set:html={renderSynthesisHtml(paragraph)}></p>
			))}
		</div>
	) : (
		<div class="synthesis-list">
			{synthesisItems.map(item => (
				<div class="synthesis-item">
					{item.source && <span class="source-tag">[{item.source}]</span>}
					<span class="synthesis-text" set:html={renderSynthesisHtml(item.content)}></span>
				</div>
			))}
		</div>
	)}
</div>

<style>
	.editorial-narrative {
		margin-bottom: 3rem;
	}

	.narrative-p {
		font-family: var(--font-nyt-body);
		font-size: clamp(1.05rem, 4vw, 1.15rem);
		line-height: 1.75;
		color: var(--secondary-foreground);
		margin-bottom: 1.5rem;
		text-align: left;
	}

	.narrative-p.drop-cap::first-letter {
		float: left;
		font-family: var(--font-serif);
		font-size: clamp(3.5rem, 12vw, 4.8rem);
		line-height: 0.85;
		padding-top: 4px;
		padding-right: 12px;
		padding-left: 3px;
		font-weight: 900;
		color: var(--foreground);
	}


    @media (max-width: 640px) {
        .narrative-p {
            text-align: left;
        }
    }

	.synthesis-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.synthesis-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		font-family: var(--font-nyt-body);
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--secondary-foreground);
	}

	.source-tag {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		color: var(--nyt-accent);
		white-space: nowrap;
		margin-top: 0.2rem;
	}

	:global(.citation-badge) {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		padding: 0 0.4rem;
		background: var(--secondary);
		color: var(--muted-foreground);
		border-radius: 2px;
		vertical-align: middle;
		margin: 0 0.2rem;
		text-transform: uppercase;
	}
</style>
