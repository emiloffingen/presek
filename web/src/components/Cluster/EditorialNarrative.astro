---
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';

interface Props {
	hasStrongLeadNarrative: boolean;
	generatedArticle: string | null;
	synthesisItems: any[];
	hasCitationSources: boolean;
    keyFacts?: string[];
}

const { hasStrongLeadNarrative, generatedArticle, synthesisItems, hasCitationSources, keyFacts } = Astro.props;

const renderSynthesisHtml = (text: string) => sharedRenderSynthesisHtml(text, hasCitationSources);
---

<div class="editorial-narrative prose-editorial">
	{hasStrongLeadNarrative && generatedArticle ? (
		<div class="narrative-body font-serif is-collapsible is-collapsed" id="narrative-body">
			{generatedArticle.split('\n').filter((p: string) => p.trim()).map((paragraph: string, idx: number) => (
				<p class:list={["narrative-p", idx === 0 ? "drop-cap" : ""]} set:html={renderSynthesisHtml(paragraph)}></p>
			))}
		</div>
        <button class="narrative-toggle" id="narrative-toggle" onclick="document.getElementById('narrative-body').classList.remove('is-collapsed'); this.style.display='none';">Прочитај повеќе</button>
	) : (
		<div class="synthesis-list">
			{synthesisItems.map(item => (
				<div class="synthesis-item">
					{item.source && <span class="source-tag">[{item.source}]</span>}
					<span class="synthesis-text" set:html={renderSynthesisHtml(item.content)}></span>
				</div>
			))}
		</div>
	)}

    {keyFacts && keyFacts.length > 0 && (
        <div class="narrative-facts-box mt-12 p-8 bg-secondary/30 border-l-4 border-nyt-accent rounded-r-sm">
            <h4 class="text-[10px] font-black uppercase tracking-widest text-nyt-accent mb-6">КЛУЧНИ ФАКТИ</h4>
            <ul class="space-y-4">
                {keyFacts.map((fact: string) => (
                    <li class="flex items-start gap-3">
                        <span class="text-nyt-accent mt-1">•</span>
                        <p class="font-serif text-[1.05rem] leading-snug text-foreground/90" set:html={renderSynthesisHtml(fact)}></p>
                    </li>
                ))}
            </ul>
        </div>
    )}
</div>

<style>
	.editorial-narrative {
		margin-bottom: 3rem;
        position: relative;
	}

    .narrative-body.is-collapsible {
        max-height: 800px;
        overflow: hidden;
        transition: max-height 0.6s cubic-bezier(0.2, 0, 0, 1);
    }
    
    .narrative-body.is-collapsed {
        mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }

    .narrative-toggle {
        display: none;
        margin-top: 1rem;
        width: 100%;
        padding: 0.75rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 900;
        text-transform: uppercase;
        color: var(--nyt-accent);
        background: var(--secondary);
        border: 1px solid var(--border);
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .narrative-toggle { display: block; }
    }

	.narrative-p {
		font-family: var(--font-nyt-body);
		font-size: clamp(1.05rem, 4vw, 1.15rem);
		line-height: 1.75;
		color: var(--secondary-foreground);
		margin-bottom: 1.5rem;
		text-align: left;
	}

	.narrative-p.drop-cap::first-letter {
		float: left;
		font-family: var(--font-serif);
		font-size: clamp(3.5rem, 12vw, 4.8rem);
		line-height: 0.85;
		padding-top: 4px;
		padding-right: 12px;
		padding-left: 3px;
		font-weight: 900;
		color: var(--foreground);
	}

    @media (max-width: 640px) {
        .narrative-p {
            text-align: left;
        }
    }

	.synthesis-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.synthesis-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		font-family: var(--font-nyt-body);
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--secondary-foreground);
	}

	.source-tag {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		color: var(--nyt-accent);
		white-space: nowrap;
		margin-top: 0.2rem;
	}

	:global(.citation-badge) {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		padding: 0.1rem 0.5rem;
		background: color-mix(in srgb, var(--nyt-accent) 10%, var(--secondary) 90%);
		color: var(--nyt-accent);
		border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
		border-radius: 4px;
		vertical-align: middle;
		margin: 0 0.25rem;
		text-transform: uppercase;
        cursor: help;
        transition: all 0.2s;
	}
    :global(.citation-badge:hover) {
        background: var(--nyt-accent);
        color: white;
    }
</style>
