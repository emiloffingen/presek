---
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';
import { getLangFromUrl } from '../../i18n/utils';

interface Props {
	hasStrongLeadNarrative: boolean;
	generatedArticle: string | null;
	synthesisItems: any[];
	hasCitationSources: boolean;
    keyFacts?: string[];
    entities?: string[];
}

const { hasStrongLeadNarrative, generatedArticle, synthesisItems, hasCitationSources, entities = [] } = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);

const cleanNarrativeParagraph = (text: string) => String(text || '')
    .replace(/\s+/g, ' ')
    .replace(/([A-Za-zА-Яа-яЁёЃѓЌќЉљЊњЏџČĆŽŠĐčćžšđ])\(/g, '$1 (')
    .replace(/\)([A-Za-zА-Яа-яЁёЃѓЌќЉљЊњЏџČĆŽŠĐčćžšđ])/g, ') $1')
    .replace(/([.!?]){2,}/g, '$1')
    .replace(/\s+([,.;:!?])/g, '$1')
    .trim();

const narrativeParagraphs = String(generatedArticle || '')
    .split('\n')
    .map((paragraph: string) => cleanNarrativeParagraph(paragraph))
    .filter(Boolean);

const renderSynthesisHtml = (text: string) => {
    let html = sharedRenderSynthesisHtml(text, hasCitationSources);
    // Wrap identified entities in a span
    entities.forEach(entity => {
        const safeEntity = String(entity || '').trim();
        if (!safeEntity) return;
        const escapedPattern = safeEntity.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const safeAttr = safeEntity
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        const regex = new RegExp(`(?<=^|[^\\p{L}\\p{N}_])${escapedPattern}(?=$|[^\\p{L}\\p{N}_])`, 'gu');
        html = html.replace(regex, `<span class="inline-entity" data-entity="${safeAttr}">$&</span>`);
    });
    return html;
};
---

<div class="editorial-narrative prose-editorial">
	{generatedArticle ? (
		<div class="narrative-body font-serif">
			{narrativeParagraphs.map((paragraph: string, idx: number) => (
				<p class:list={["narrative-p", idx === 0 ? "drop-cap" : ""]} set:html={renderSynthesisHtml(paragraph)}></p>
			))}
		</div>
	) : (
		<div class="empty-narrative-fallback italic text-muted-foreground font-serif">
            {lang === 'sr'
                ? 'Detaljna sinteza za ovaj razvoj je u procesu konsolidacije. Molimo pogledajte kratak pregled iznad.'
                : 'Деталната синтеза за овој развој е во процес на консолидација. Ве молиме погледнете го краткиот преглед погоре.'
            }
        </div>
	)}
</div>

<script>
    import { createPopper } from '@popperjs/core';

    document.addEventListener('astro:page-load', () => {
        const pageLang = document.documentElement.lang || 'sr';
        const isSr = pageLang.startsWith('sr');
        const activeLang = isSr ? 'sr' : 'mk';
        const entities = document.querySelectorAll('.inline-entity');
        entities.forEach(entity => {
            const name = entity.getAttribute('data-entity');
            if (!name) return;

                let popperInstance: ReturnType<typeof createPopper> | null = null;
                let tooltip: HTMLDivElement | null = null;

            entity.addEventListener('mouseenter', async () => {
                // Create tooltip element
                tooltip = document.createElement('div');
                tooltip.className = 'entity-tooltip';
                const loadingText = isSr ? `Učitavam kontekst za ${name}...` : `Вчитувам контекст за ${name}...`;
                const shell = document.createElement('div');
                shell.className = 'p-4 bg-background border border-border shadow-xl rounded-lg w-64 text-sm';
                const row = document.createElement('div');
                row.className = 'flex items-center gap-[var(--grid-gap)]';
                const dot = document.createElement('div');
                dot.className = 'w-2 h-2 rounded-full bg-nyt-accent animate-pulse';
                row.append(dot, document.createTextNode(` ${loadingText}`));
                shell.appendChild(row);
                tooltip.replaceChildren(shell);
                document.body.appendChild(tooltip);

                popperInstance = createPopper(entity as HTMLElement, tooltip, {
                    placement: 'top',
                    modifiers: [{ name: 'offset', options: { offset: [0, 8] } }]
                });

                // Fetch real data
                const res = await fetch(`/api/entity-graph/${encodeURIComponent(name)}?lang=${activeLang}`);
                const json = await res.json();
                if (json.status === 'success') {
                    const noDetailsText = isSr ? 'Nema dostupnih detalja.' : 'Нема достапни детали.';
                    const content = document.createElement('div');
                    content.className = 'p-4 bg-background border border-border shadow-xl rounded-lg w-64 text-sm font-sans';
                    const title = document.createElement('h4');
                    title.className = 'font-bold text-base mb-1';
                    title.textContent = name;
                    const summary = document.createElement('p');
                    summary.className = 'text-[11px] text-muted-foreground';
                    summary.textContent = json.data?.summary || noDetailsText;
                    content.append(title, summary);
                    tooltip.replaceChildren(content);
                }
            });

            entity.addEventListener('mouseleave', () => {
                if (popperInstance) {
                    popperInstance.destroy();
                    popperInstance = null;
                }
                if (tooltip) {
                    tooltip.remove();
                    tooltip = null;
                }
            });
        });
    });
</script>

<style>
    .inline-entity {
        text-decoration: underline;
        text-decoration-style: dotted;
        text-underline-offset: 4px;
        cursor: help;
        color: var(--nyt-accent);
    }

    .entity-tooltip {
        z-index: 1000;
    }

	.narrative-p {
		font-family: var(--font-nyt-body);
		font-size: clamp(1.15rem, 4.5vw, 1.3rem);
		line-height: 1.85;
		color: var(--foreground);
		margin-bottom: 2rem;
		text-align: left;
        letter-spacing: 0;
	}

	.narrative-p.drop-cap::first-letter {
		float: left;
		font-family: var(--font-serif);
		font-size: clamp(4.5rem, 12vw, 5.8rem);
		line-height: 0.82;
		padding-top: 4px;
		padding-right: 12px;
		padding-left: 2px;
		font-weight: 950;
		color: var(--nyt-accent);
        text-shadow: 1px 1px 0 var(--background), 3px 3px 0 color-mix(in srgb, var(--nyt-accent) 15%, transparent);
	}

    .narrative-facts-box {
        margin-top: 4rem;
        padding: 2rem;
        background: color-mix(in srgb, var(--nyt-accent) 4%, var(--background));
        border-left: 4px solid var(--nyt-accent);
        border-radius: 0 4px 4px 0;
        box-shadow: var(--shadow-editorial);
    }

	.synthesis-item {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		font-family: var(--font-nyt-body);
		font-size: 1.2rem;
		line-height: 1.65;
		color: var(--foreground);
	}

	.source-tag {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 950;
		color: var(--nyt-accent);
		white-space: nowrap;
		margin-top: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
	}

	:global(.citation-badge) {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		padding: 0.1rem 0.5rem;
		background: color-mix(in srgb, var(--nyt-accent) 10%, var(--secondary) 90%);
		color: var(--nyt-accent);
		border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
		border-radius: 0px;
		vertical-align: middle;
		margin: 0 0.25rem;
		text-transform: uppercase;
        cursor: help;
        transition: all 0.2s;
	}
    :global(.citation-badge:hover) {
        background: var(--nyt-accent);
        color: white;
    }
</style>
