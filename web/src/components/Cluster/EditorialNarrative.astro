---
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';
import { getLangFromUrl } from '../../i18n/utils';

interface Props {
	hasStrongLeadNarrative: boolean;
	generatedArticle: string | null;
	synthesisItems: any[];
	hasCitationSources: boolean;
    keyFacts?: string[];
    entities?: string[];
}

const { hasStrongLeadNarrative, generatedArticle, synthesisItems, hasCitationSources, entities = [] } = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);

const cleanNarrativeParagraph = (text: string) => String(text || '')
    .replace(/\s+/g, ' ')
    .replace(/([A-Za-zА-Яа-яЁёЃѓЌќЉљЊњЏџČĆŽŠĐčćžšđ])\(/g, '$1 (')
    .replace(/\)([A-Za-zА-Яа-яЁёЃѓЌќЉљЊњЏџČĆŽŠĐčćžšđ])/g, ') $1')
    .replace(/([.!?]){2,}/g, '$1')
    .replace(/\s+([,.;:!?])/g, '$1')
    .trim();

const narrativeParagraphs = String(generatedArticle || '')
    .split('\n')
    .map((paragraph: string) => cleanNarrativeParagraph(paragraph))
    .filter(Boolean);

const renderSynthesisHtml = (text: string) => {
    let html = sharedRenderSynthesisHtml(text, hasCitationSources);
    if (!entities || entities.length === 0) return html;

    const patterns: { regex: RegExp; entity: string; length: number }[] = [];
    const seenAliases = new Set<string>();

    entities.forEach(entity => {
        const safeEntity = String(entity || '').trim();
        if (!safeEntity) return;

        // 1. Full name pattern with Slavic suffixes
        const escapedFull = safeEntity.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const fullPattern = `(?<=^|[^\\p{L}\\p{N}_])(${escapedFull}(?:от|ов|он|та|то|те|а|у|ом|ем|е|ог|ски|и|има|ама)?)(?=$|[^\\p{L}\\p{N}_])`;
        patterns.push({
            regex: new RegExp(fullPattern, 'gu'),
            entity: safeEntity,
            length: safeEntity.length
        });

        // 2. Surname alias pattern (if multi-word)
        const parts = safeEntity.split(/\s+/);
        if (parts.length > 1) {
            const surname = parts[parts.length - 1];
            // Ensure surname is reasonable (length >= 3 and starts with capital letter)
            if (surname.length >= 3 && /^[A-ZА-ЯЁЃЌЉЊЏČĆŽŠĐ]/.test(surname)) {
                const escapedSurname = surname.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const aliasKey = surname.toLowerCase();
                if (!seenAliases.has(aliasKey)) {
                    seenAliases.add(aliasKey);
                    const surnamePattern = `(?<=^|[^\\p{L}\\p{N}_])(${escapedSurname}(?:от|ов|он|та|то|те|а|у|ом|ем|е|ог|ски|и|има|ама)?)(?=$|[^\\p{L}\\p{N}_])`;
                    patterns.push({
                        regex: new RegExp(surnamePattern, 'gu'),
                        entity: safeEntity, // Maps surname back to full entity!
                        length: surname.length
                    });
                }
            }
        }
    });

    // Sort patterns by length descending
    patterns.sort((a, b) => b.length - a.length);

    // Split HTML by tags to avoid replacing inside existing tags or attributes
    const tokens = html.split(/(<[^>]+>)/g);
    const replacements: string[] = [];

    // Process only plain text tokens (even indices)
    for (let i = 0; i < tokens.length; i += 2) {
        let textToken = tokens[i];
        if (!textToken) continue;

        patterns.forEach(pattern => {
            const safeAttr = pattern.entity
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            textToken = textToken.replace(pattern.regex, (match, p1) => {
                const idx = replacements.length;
                replacements.push(`<span class="inline-entity" data-entity="${safeAttr}">${p1}</span>`);
                return `\uFFF0${idx}\uFFF1`;
            });
        });
        tokens[i] = textToken;
    }

    // Reassemble HTML and substitute private-use character placeholders back with final markup
    let processedHtml = tokens.join('');
    for (let idx = 0; idx < replacements.length; idx++) {
        processedHtml = processedHtml.replace(`\uFFF0${idx}\uFFF1`, replacements[idx]);
    }

    return processedHtml;
};
---

<div class="editorial-narrative prose-editorial">
	{generatedArticle ? (
		<div class="narrative-body font-serif">
			{narrativeParagraphs.map((paragraph: string, idx: number) => (
				<p class:list={["narrative-p", idx === 0 ? "drop-cap" : ""]} set:html={renderSynthesisHtml(paragraph)}></p>
			))}
		</div>
	) : (
		<div class="empty-narrative-fallback italic text-muted-foreground font-serif">
            {lang === 'sr'
                ? 'Detaljna sinteza za ovaj razvoj je u procesu konsolidacije. Molimo pogledajte kratak pregled iznad.'
                : 'Деталната синтеза за овој развој е во процес на консолидација. Ве молиме погледнете го краткиот преглед погоре.'
            }
        </div>
	)}
</div>

<script>
    import { createPopper } from '@popperjs/core';

    document.addEventListener('astro:page-load', () => {
        const pageLang = document.documentElement.lang || 'sr';
        const isSr = pageLang.startsWith('sr');
        const activeLang = isSr ? 'sr' : 'mk';
        const entities = document.querySelectorAll('.inline-entity');
        entities.forEach(entity => {
            const name = entity.getAttribute('data-entity');
            if (!name) return;

            let popperInstance: ReturnType<typeof createPopper> | null = null;
            let tooltip: HTMLDivElement | null = null;

            entity.addEventListener('mouseenter', async () => {
                // Create tooltip element
                tooltip = document.createElement('div');
                tooltip.className = 'entity-tooltip';
                const loadingText = isSr ? `Učitavam kontekst za ${name}...` : `Вчитувам контекст за ${name}...`;
                tooltip.innerHTML = `
                    <div class="tooltip-card bg-background/95 dark:bg-zinc-900/95 backdrop-blur-md border border-border/80 shadow-2xl rounded-xl p-4 w-72 text-sm text-foreground flex items-center gap-3">
                        <div class="relative w-4 h-4 flex items-center justify-center">
                            <span class="absolute inline-flex h-full w-full rounded-full bg-nyt-accent opacity-75 animate-ping"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-nyt-accent"></span>
                        </div>
                        <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider animate-pulse">${loadingText}</span>
                    </div>
                `;
                document.body.appendChild(tooltip);

                popperInstance = createPopper(entity as HTMLElement, tooltip, {
                    placement: 'top',
                    modifiers: [{ name: 'offset', options: { offset: [0, 8] } }]
                });

                // Fetch real data
                try {
                    const res = await fetch(`/api/entity-graph/${encodeURIComponent(name)}?lang=${activeLang}`);
                    const json = await res.json();
                    if (json.status === 'success') {
                        const labelCard = isSr ? 'KONTEKST KARTICA' : 'КОНТЕКСТ КАРТИЧКА';
                        const labelLastSeen = isSr ? 'POSLEDNJI PUT VIĐENO' : 'ПОСЛЕДНО ВИДЕНО';
                        const labelProfile = isSr ? 'PROFIL' : 'ПРОФИЛ';
                        const noDetailsText = isSr ? 'Nema dostupnih detalja.' : 'Нема достапни детали.';

                        const bioSummary = json.data?.bio_summary || json.data?.summary || noDetailsText;
                        const score = json.data?.importance_score !== undefined ? json.data.importance_score : 1;
                        const lastSeenDate = json.data?.last_seen 
                            ? new Date(json.data.last_seen).toLocaleDateString(isSr ? 'sr-RS' : 'mk-MK') 
                            : (isSr ? 'Nije dostupno' : 'Не е достапно');

                        if (tooltip) {
                            tooltip.replaceChildren();
                            const card = document.createElement('div');
                            card.className = 'tooltip-card bg-background/95 dark:bg-zinc-900/95 backdrop-blur-md border border-border/80 shadow-2xl rounded-xl p-4 w-72 text-sm text-foreground';

                            const header = document.createElement('div');
                            header.className = 'flex justify-between items-start mb-2.5 pb-2 border-b border-border/60';

                            const kicker = document.createElement('span');
                            kicker.className = 'entity-tooltip-kicker text-nyt-accent';
                            kicker.textContent = labelCard;

                            const scoreWrap = document.createElement('div');
                            scoreWrap.className = 'flex items-center gap-1 bg-secondary/80 dark:bg-zinc-800/80 px-2 py-0.5 rounded-full border border-border/40';
                            const scoreEl = document.createElement('span');
                            scoreEl.className = 'entity-tooltip-score text-foreground';
                            scoreEl.textContent = String(score);
                            scoreWrap.appendChild(scoreEl);

                            header.append(kicker, scoreWrap);

                            const title = document.createElement('h4');
                            title.className = 'font-bold text-base mb-1 text-foreground tracking-tight';
                            title.textContent = name;

                            const summary = document.createElement('p');
                            summary.className = 'entity-tooltip-summary text-muted-foreground leading-relaxed mb-3 font-normal';
                            summary.textContent = bioSummary;

                            const footer = document.createElement('div');
                            footer.className = 'entity-tooltip-footer flex items-center justify-between pt-2.5 border-t border-border/60 text-muted-foreground';
                            const seen = document.createElement('span');
                            seen.className = 'uppercase font-medium';
                            seen.textContent = `${labelLastSeen}: ${lastSeenDate}`;

                            const profileLink = document.createElement('a');
                            profileLink.href = `/subjekt/${encodeURIComponent(name)}`;
                            profileLink.className = 'font-bold text-nyt-accent hover:underline flex items-center gap-0.5 uppercase';
                            profileLink.textContent = `${labelProfile} →`;

                            footer.append(seen, profileLink);
                            card.append(header, title, summary, footer);
                            tooltip.appendChild(card);
                            if (popperInstance) popperInstance.update();
                        }
                    }
                } catch (e) {
                    console.error("Error loading entity details:", e);
                }
            });

            entity.addEventListener('mouseleave', () => {
                if (popperInstance) {
                    popperInstance.destroy();
                    popperInstance = null;
                }
                if (tooltip) {
                    tooltip.remove();
                    tooltip = null;
                }
            });
        });
    });
</script>

<style>
    .inline-entity {
        text-decoration: underline;
        text-decoration-style: dotted;
        text-underline-offset: 4px;
        cursor: help;
        color: var(--nyt-accent);
        transition: all 0.2s ease;
        font-weight: 600;
    }
    .inline-entity:hover {
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        text-decoration-style: solid;
        border-radius: var(--radius-sm, 0px);
    }

    @keyframes tooltip-appear {
        from {
            opacity: 0;
            transform: scale(0.96) translateY(4px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .entity-tooltip {
        z-index: 1000;
        animation: tooltip-appear 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .tooltip-card {
        box-shadow: 
            0 4px 30px rgba(0, 0, 0, 0.03),
            0 10px 50px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }

    :global(.entity-tooltip-kicker),
    :global(.entity-tooltip-score),
    :global(.entity-tooltip-footer) {
        font-family: var(--font-sans);
    }

    :global(.entity-tooltip-kicker) {
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    :global(.entity-tooltip-score) {
        font-size: 0.6rem;
        font-weight: 850;
    }

    :global(.entity-tooltip-summary) {
        font-size: 0.75rem;
    }

    :global(.entity-tooltip-footer) {
        font-size: 0.58rem;
    }
    
    :global(.dark) .tooltip-card {
        box-shadow: 
            0 4px 30px rgba(0, 0, 0, 0.2),
            0 10px 50px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

	.narrative-p {
		font-family: var(--font-nyt-body);
		font-size: clamp(1.15rem, 4.5vw, 1.3rem);
		line-height: 1.85;
		color: var(--foreground);
		margin-bottom: 2rem;
		text-align: left;
        letter-spacing: 0;
	}

	.narrative-p.drop-cap::first-letter {
		float: left;
		font-family: var(--font-serif);
		font-size: clamp(4.5rem, 12vw, 5.8rem);
		line-height: 0.82;
		padding-top: 4px;
		padding-right: 12px;
		padding-left: 2px;
		font-weight: 950;
		color: var(--cluster-accent, var(--nyt-accent));
        text-shadow: 1px 1px 0 var(--background), 3px 3px 0 color-mix(in srgb, var(--cluster-accent, var(--nyt-accent)) 15%, transparent);
	}

    .narrative-facts-box {
        margin-top: 4rem;
        padding: 2rem;
        background: color-mix(in srgb, var(--cluster-accent, var(--nyt-accent)) 4%, var(--background));
        border-left: 4px solid var(--cluster-accent, var(--nyt-accent));
        border-radius: 0px;
        box-shadow: var(--shadow-editorial);
    }

    /* Styled blockquotes for editorial citations and contrasting viewpoints */
    .narrative-body blockquote {
        margin: 2.5rem 0;
        padding: 1.5rem 2rem 1.5rem 2.5rem;
        border-left: 4px solid var(--cluster-accent, var(--nyt-accent));
        background: color-mix(in srgb, var(--cluster-accent, var(--nyt-accent)) 4%, var(--background));
        font-family: var(--font-nyt-body);
        font-size: 1.25rem;
        font-style: italic;
        line-height: 1.8;
        color: var(--foreground);
        position: relative;
    }

    .narrative-body blockquote::before {
        content: "“";
        position: absolute;
        left: 0.6rem;
        top: -0.2rem;
        font-size: 3.5rem;
        font-family: var(--font-serif);
        color: var(--cluster-accent, var(--nyt-accent));
        opacity: 0.25;
        line-height: 1;
    }

	.synthesis-item {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		font-family: var(--font-nyt-body);
		font-size: 1.2rem;
		line-height: 1.65;
		color: var(--foreground);
	}

	.source-tag {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 950;
		color: var(--nyt-accent);
		white-space: nowrap;
		margin-top: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
	}

	:global(.citation-badge) {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		padding: 0.1rem 0.5rem;
		background: color-mix(in srgb, var(--nyt-accent) 10%, var(--secondary) 90%);
		color: var(--nyt-accent);
		border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
		border-radius: 0px;
		vertical-align: middle;
		margin: 0 0.25rem;
		text-transform: uppercase;
        cursor: help;
        transition: all 0.2s;
	}
    :global(.citation-badge:hover) {
        background: var(--nyt-accent);
        color: white;
    }

</style>
