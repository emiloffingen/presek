---
import { useTranslations } from '../../i18n/utils';
import { highlightFactText } from '../../lib/clusterBriefUtils';
import EditorialSectionLockup from '../editorial/EditorialSectionLockup.astro';

interface Props {
  facts: string[];
  lang: 'sr' | 'mk';
}

const { facts, lang } = Astro.props;
const t = useTranslations(lang);
const displayFacts = facts.slice(0, 5);
---

{displayFacts.length > 0 && (
  <section id="cluster-key-facts" class="cluster-key-facts-band mb-12 border-t border-border/40 pt-10">
    <div class="mb-8">
      <EditorialSectionLockup title={t('cluster.section_key_facts')} />
    </div>
    <ul class="cluster-key-facts-list space-y-3">
      {displayFacts.map((fact) => (
        <li class="font-sans text-[15px] md:text-[16px] font-medium leading-relaxed text-foreground/85 flex items-start gap-3">
          <span class="text-nyt-accent text-lg mt-[-2px] flex-shrink-0" aria-hidden="true">›</span>
          <span class="flex-1" set:html={highlightFactText(fact)}></span>
        </li>
      ))}
    </ul>
  </section>
)}
