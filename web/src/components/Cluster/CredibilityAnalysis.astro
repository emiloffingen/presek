---
import { ShieldCheck, TriangleAlert, Search } from 'lucide-react';
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import EditorialSectionLockup from '../editorial/EditorialSectionLockup.astro';

interface Props {
	hasFactcheck: boolean;
	verificationReport: any;
	perspectives: any[];
	hasCitationSources: boolean;
	showPerspectives?: boolean;
	consensusNote?: string | null;
	lang?: 'sr' | 'mk';
	pluralismScore?: number;
	toneAnalysis?: {
		sensationalism: number;
		objectivity: number;
		emotional_charge?: number;
	};
}

const {
	hasFactcheck,
	verificationReport,
	perspectives,
	hasCitationSources,
	showPerspectives = true,
	consensusNote = null,
	lang: propLang,
	pluralismScore,
	toneAnalysis,
} = Astro.props;

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = propLang || getLangFromUrl(effectiveUrl);
const t = useTranslations(lang);

const renderSynthesisHtml = (text: string) => sharedRenderSynthesisHtml(text);

function normalizePerspective(p: any) {
	const angle = String(p?.angle || '').trim();
	const content = String(p?.content || '').trim();
	const loweredAngle = angle.toLocaleLowerCase();
	const loweredContent = content.toLocaleLowerCase();
	const quoted = [...content.matchAll(/[„“"]([^„“"]+)[„“"]/g)].map((match) =>
		match[1].replace(/\s+/g, ' ').trim().toLocaleLowerCase()
	);

	if (
		(loweredAngle.includes('nijans') || loweredAngle.includes('нијанс')) &&
		quoted.length >= 2 &&
		quoted[0] === quoted[1]
	) {
		return {
			angle,
			content: t('cluster.credibility.perspective_nuance'),
		};
	}

	if (
		(loweredAngle.includes('otvoreno') || loweredAngle.includes('отворено')) &&
		(loweredContent.includes('ostaju nepotvr') || loweredContent.includes('остануваат непотв'))
	) {
		return {
			angle,
			content: t('cluster.credibility.perspective_open'),
		};
	}

	if (
		(loweredAngle.includes('konsenz') || loweredAngle.includes('консенз')) &&
		loweredContent.includes('potvrđuju istu osnovnu liniju')
	) {
		return {
			angle,
			content: lang === 'sr'
				? content.replace('potvrđuju istu osnovnu liniju događaja', 'se poklapaju oko osnovnog događaja, dok detalje treba čitati kroz njihove pojedinačne naslove i opise')
				: content,
		};
	}

	return { angle, content };
}

const displayPerspectives = perspectives
	.map(normalizePerspective)
	.filter((p) => p.angle && p.content);

const hasMetric = (value: unknown) => {
	const numeric = typeof value === 'number' ? value : Number(value);
	return Number.isFinite(numeric);
};

const clampPercent = (value: unknown) => {
	const numeric = typeof value === 'number' ? value : Number(value);
	return Math.min(100, Math.max(0, Math.round(numeric)));
};

const hasPluralismMetric = hasMetric(pluralismScore);
const hasObjectivityMetric = hasMetric(toneAnalysis?.objectivity);
const shouldShowSignalCard = hasPluralismMetric || hasObjectivityMetric;
const objectivityPercent = hasObjectivityMetric ? clampPercent(Number(toneAnalysis?.objectivity) * 100) : null;
const pluralismPercent = hasPluralismMetric ? clampPercent(pluralismScore) : null;
const pluralismLabel = pluralismPercent === null ? '' : pluralismPercent >= 70
	? t('cluster.credibility.pluralism_high')
	: pluralismPercent >= 45
		? t('cluster.credibility.pluralism_mid')
		: t('cluster.credibility.pluralism_low');
const objectivityLabel = objectivityPercent === null ? '' : objectivityPercent >= 70
	? t('cluster.credibility.objectivity_high')
	: objectivityPercent >= 45
		? t('cluster.credibility.objectivity_mid')
		: t('cluster.credibility.objectivity_low');
const signalSummary = pluralismLabel && objectivityLabel
	? t('cluster.credibility.signal_summary_both')
		.replace('{pluralism}', pluralismLabel)
		.replace('{objectivity}', objectivityLabel)
	: pluralismLabel
		? t('cluster.credibility.signal_summary_pluralism').replace('{pluralism}', pluralismLabel)
		: t('cluster.credibility.signal_summary_objectivity').replace('{objectivity}', objectivityLabel);
---

<section class="editorial-section analysis-section mb-10 border-t-2 border-foreground pt-6">
	<div class="mb-5">
		<EditorialSectionLockup title={t('cluster.section_pluralism')} />
	</div>

	{hasFactcheck && (
		<div class="factcheck-container mb-6">
			<div class="factcheck-grid-v2">
				<div class="factcheck-col agreements">
					<header class="col-header">
						<ShieldCheck size={15} className="fact-icon-positive" />
						<h3>{t('cluster.factcheck.confirmed')}</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.agreements.map((item: string) => (
							<li class="fact-item green" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				<div class="factcheck-col conflicts">
					<header class="col-header">
						<TriangleAlert size={15} className="text-nyt-red" />
						<h3>{t('cluster.factcheck.conflicts')}</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.conflicts.map((item: string) => (
							<li class="fact-item red" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				{verificationReport.missing_info && verificationReport.missing_info.length > 0 && (
					<div class="factcheck-col missing-info mt-3 col-span-full border-t border-border pt-3">
						<header class="col-header">
							<Search size={15} className="fact-icon-watch" />
							<h3>{t('cluster.factcheck.context')}</h3>
						</header>
						<p class="fact-omission-label">{t('cluster.factcheck.omission')}</p>
						<ul class="fact-list">
							{verificationReport.missing_info.map((item: string) => (
								<li class="fact-item amber" set:html={renderSynthesisHtml(item)}></li>
							))}
						</ul>
					</div>
				)}
			</div>

			{verificationReport.context && (
				<div class="factcheck-context p-4 bg-muted/30 border border-border/40 mt-4 italic text-sm text-muted-foreground">
					<p set:html={renderSynthesisHtml(verificationReport.context)}></p>
				</div>
			)}
		</div>
	)}

	{(showPerspectives ? displayPerspectives.length > 0 : Boolean(consensusNote)) && (
		<div class="perspectives-area mt-10">
            <div class="analysis-bento-grid">
                {shouldShowSignalCard && (
                <div class="media-signal-card">
                    <div class="signal-header">
                        <h5 class="signal-label">{t('cluster.credibility.signal_discourse')}</h5>
                        <p class="signal-summary">{signalSummary}</p>
                    </div>
                    <div class="signal-metrics">
                        {pluralismPercent !== null && (
                        <div class="signal-metric">
                            <div class="signal-metric-head">
                                <span>{t('cluster.credibility.pluralism_sources')}</span>
                                <strong>{pluralismPercent}%</strong>
                            </div>
                            <div class="signal-bar" aria-hidden="true">
                                <div class="signal-bar-fill pluralism" style={`width: ${pluralismPercent}%`}></div>
                            </div>
                            <p>{t('cluster.credibility.pluralism_sources_desc')}</p>
                        </div>
                        )}
                        {objectivityPercent !== null && (
                        <div class="signal-metric">
                            <div class="signal-metric-head">
                                <span>{t('cluster.credibility.objectivity_processing')}</span>
                                <strong>{objectivityPercent}%</strong>
                            </div>
                            <div class="signal-bar" aria-hidden="true">
                                <div class="signal-bar-fill objectivity" style={`width: ${objectivityPercent}%`}></div>
                            </div>
                            <p>{t('cluster.credibility.objectivity_processing_desc')}</p>
                        </div>
                        )}
                    </div>
                </div>
                )}

                <!-- Perspectives Cards -->
                <div class="perspectives-list-card">
                    {showPerspectives ? (
                        <>
                            <h4 class="perspectives-label">{t('cluster.factcheck.diversity')}</h4>
                            <div class="perspective-grid-v2">
                                {displayPerspectives.map((p: any) => (
                                    <div class="editorial-angle-card">
                                        <h5 class="angle-title" set:html={renderSynthesisHtml(p.angle)}></h5>
                                        <p class="angle-content" set:html={renderSynthesisHtml(p.content)}></p>
                                    </div>
                                ))}
                            </div>
                        </>
                    ) : consensusNote ? (
                        <div class="consensus-note-card">
                            <h4 class="perspectives-label">{t('cluster.credibility.source_coverage')}</h4>
                            <p class="consensus-note-copy">{consensusNote}</p>
                        </div>
                    ) : null}
                </div>
            </div>
		</div>
	)}
</section>

<style>
	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.section-label {
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--foreground);
		white-space: nowrap;
	}

	.section-divider {
		flex: 1;
		height: 1px;
		background: var(--border);
	}

	.factcheck-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 768px) {
		.factcheck-grid-v2 {
			grid-template-columns: 1fr 1fr;
			gap: 1.25rem;
		}
	}

	.factcheck-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.col-header {
		display: flex;
		align-items: center;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid var(--foreground);
	}

	.col-header h3 {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 950;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-left: 0.5rem;
	}

	.fact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.fact-item {
		font-family: var(--font-nyt-body);
		font-size: 0.94rem;
		line-height: 1.44;
		color: var(--secondary-foreground);
		position: relative;
		padding-left: 1rem;
	}

	.fact-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5rem;
		width: 4px;
		height: 4px;
		border-radius: 50%;
	}

	.fact-item.green::before {
		background: var(--editorial-positive);
	}

	.fact-item.red::before {
		background: var(--nyt-red);
	}

	.fact-item.amber::before {
		background: var(--editorial-watch);
	}

    .fact-icon-positive {
        color: var(--editorial-positive);
    }

    .fact-icon-watch {
        color: var(--editorial-watch);
    }

    .fact-omission-label,
    .perspectives-label {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--foreground) 62%, var(--muted-foreground));
    }

    .fact-omission-label {
        margin: 0 0 0.5rem;
    }

    .perspectives-label {
        margin: 0 0 1rem;
    }

    .consensus-note-card {
        padding: 1rem 1.1rem;
        border: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
        background: color-mix(in srgb, var(--secondary) 28%, var(--background));
    }

    .consensus-note-copy {
        margin: 0;
        font-family: var(--font-nyt-body);
        font-size: 0.95rem;
        line-height: 1.55;
        color: color-mix(in srgb, var(--foreground) 78%, var(--secondary-foreground));
    }

	.perspectives-area {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.perspective-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	@media (min-width: 768px) {
		.perspective-grid-v2 {
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		}
	}

	.editorial-angle-card {
		padding: 1rem;
		background: color-mix(in srgb, var(--secondary) 30%, var(--card));
		border: 1px solid var(--border);
		border-radius: var(--radius-md, 0px);
		box-shadow: var(--shadow-sm);
		transition: transform 0.3s var(--ease-editorial), border-color 0.3s var(--ease-editorial), box-shadow 0.3s var(--ease-editorial);
	}
	.editorial-angle-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--nyt-accent) 30%, var(--border));
		box-shadow: var(--shadow-md);
	}

	.angle-title {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 950;
		text-transform: uppercase;
		margin-bottom: 0.45rem;
		color: var(--nyt-accent);
	}

	.angle-content {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--secondary-foreground);
	}

	/* ── Media signal & perspectives grid ── */
    .analysis-bento-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 1024px) {
        .analysis-bento-grid {
            grid-template-columns: minmax(260px, 320px) 1fr;
            align-items: start;
        }
    }

    .media-signal-card {
        padding: 1rem;
        background: color-mix(in srgb, var(--secondary) 26%, var(--card));
        border: 1px solid var(--border);
        border-radius: var(--radius-md, 0px);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .signal-header {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--border);
    }

    .signal-label {
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 950;
        text-transform: uppercase;
        color: var(--nyt-accent);
        margin: 0;
        letter-spacing: 0.08em;
    }

    .signal-summary {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        line-height: 1.44;
        color: var(--secondary-foreground);
        margin: 0;
    }

    .signal-metrics {
        display: flex;
        flex-direction: column;
        gap: 0.95rem;
    }

    .signal-metric {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .signal-metric-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        font-family: var(--font-sans);
    }

    .signal-metric-head span {
        font-size: 0.68rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted-foreground);
    }

    .signal-metric-head strong {
        font-size: 1.25rem;
        font-weight: 950;
        color: var(--foreground);
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .signal-bar {
        height: 0.45rem;
        width: 100%;
        overflow: hidden;
        background: color-mix(in srgb, var(--border) 45%, transparent);
        border-radius: 999px;
    }

    .signal-bar-fill {
        height: 100%;
        border-radius: inherit;
    }

    .signal-bar-fill.pluralism {
        background: linear-gradient(90deg, var(--nyt-accent), var(--editorial-positive));
    }

    .signal-bar-fill.objectivity {
        background: linear-gradient(90deg, var(--nyt-red), var(--nyt-accent));
    }

    .signal-metric p {
        margin: 0;
        font-family: var(--font-sans);
        font-size: 0.76rem;
        line-height: 1.35;
        color: var(--muted-foreground);
    }
</style>
