---
import { ShieldCheck, TriangleAlert, Search } from 'lucide-react';
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
	hasFactcheck: boolean;
	verificationReport: any;
	perspectives: any[];
	hasCitationSources: boolean;
	lang?: 'sr' | 'mk';
	pluralismScore?: number;
	toneAnalysis?: {
		sensationalism: number;
		objectivity: number;
		emotional_charge?: number;
	};
}

const { hasFactcheck, verificationReport, perspectives, hasCitationSources, lang: propLang, pluralismScore, toneAnalysis } = Astro.props;

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = propLang || getLangFromUrl(effectiveUrl);
const t = useTranslations(lang);

const renderSynthesisHtml = (text: string) => sharedRenderSynthesisHtml(text, hasCitationSources);

function normalizePerspective(p: any) {
	const angle = String(p?.angle || '').trim();
	const content = String(p?.content || '').trim();
	const loweredAngle = angle.toLocaleLowerCase();
	const loweredContent = content.toLocaleLowerCase();
	const quoted = [...content.matchAll(/[„“"]([^„“"]+)[„“"]/g)].map((match) =>
		match[1].replace(/\s+/g, ' ').trim().toLocaleLowerCase()
	);

	if (
		(loweredAngle.includes('nijans') || loweredAngle.includes('нијанс')) &&
		quoted.length >= 2 &&
		quoted[0] === quoted[1]
	) {
		return {
			angle,
			content: lang === 'sr'
				? 'Izvori ne nude bitno različite uglove; razlika je uglavnom u uredničkom naslovu i izboru detalja za prvi plan.'
				: 'Изворите не нудат суштински различни агли; разликата е главно во уредничкиот наслов и изборот на детали за прв план.',
		};
	}

	if (
		(loweredAngle.includes('otvoreno') || loweredAngle.includes('отворено')) &&
		(loweredContent.includes('ostaju nepotvr') || loweredContent.includes('остануваат непотв'))
	) {
		return {
			angle,
			content: lang === 'sr'
				? 'Nije izdvojena konkretna sporna činjenica; otvoreno je samo kako će se priča razvijati kroz naredne dopune izvora.'
				: 'Не е издвоен конкретен спорен факт; отворено е само како ќе се развива приказната низ следните дополнувања од изворите.',
		};
	}

	if (
		(loweredAngle.includes('konsenz') || loweredAngle.includes('консенз')) &&
		loweredContent.includes('potvrđuju istu osnovnu liniju')
	) {
		return {
			angle,
			content: lang === 'sr'
				? content.replace('potvrđuju istu osnovnu liniju događaja', 'se poklapaju oko osnovnog događaja, dok detalje treba čitati kroz njihove pojedinačne naslove i opise')
				: content,
		};
	}

	return { angle, content };
}

const displayPerspectives = perspectives
	.map(normalizePerspective)
	.filter((p) => p.angle && p.content);
---

<section class="editorial-section analysis-section mb-10 border-t-2 border-foreground pt-6">
	<div class="section-eyebrow mb-5">
		<ShieldCheck size={16} className="text-foreground" />
		<h2 class="section-label">{t('cluster.media_pluralism')}</h2>
		<div class="section-divider"></div>
	</div>

	{hasFactcheck && (
		<div class="factcheck-container mb-6">
			<div class="factcheck-grid-v2">
				<div class="factcheck-col agreements">
					<header class="col-header">
						<ShieldCheck size={15} className="text-emerald-600" />
						<h3>{t('cluster.factcheck.confirmed')}</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.agreements.map((item: string) => (
							<li class="fact-item green" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				<div class="factcheck-col conflicts">
					<header class="col-header">
						<TriangleAlert size={15} className="text-nyt-red" />
						<h3>{t('cluster.factcheck.conflicts')}</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.conflicts.map((item: string) => (
							<li class="fact-item red" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				{verificationReport.missing_info && verificationReport.missing_info.length > 0 && (
					<div class="factcheck-col missing-info mt-3 col-span-full border-t border-border pt-3">
						<header class="col-header">
							<Search size={15} className="text-amber-500" />
							<h3>{t('cluster.factcheck.context')}</h3>
						</header>
						<p class="text-[10px] text-muted-foreground mb-2 font-sans uppercase font-bold tracking-wider">{t('cluster.factcheck.omission')}</p>
						<ul class="fact-list">
							{verificationReport.missing_info.map((item: string) => (
								<li class="fact-item amber" set:html={renderSynthesisHtml(item)}></li>
							))}
						</ul>
					</div>
				)}
			</div>

			{verificationReport.context && (
				<div class="factcheck-context p-4 bg-muted/30 border border-border/40 mt-4 italic text-sm text-muted-foreground">
					<p set:html={renderSynthesisHtml(verificationReport.context)}></p>
				</div>
			)}
		</div>
	)}

	{displayPerspectives.length > 0 && (
		<div class="perspectives-area mt-10">
            <div class="analysis-bento-grid">
                <!-- Bias Radar Compass -->
                <div class="bias-compass-card">
                    <h5 class="compass-label">{lang === 'sr' ? 'KOMPAS MEDIJSKOG DISKURSA' : 'КОМПАС НА МЕДИУМСКИОТ ДИСКУРС'}</h5>
                    <p class="compass-desc">{lang === 'sr' ? 'Vizuelni odnos pluralizma izvora i senzacionalizma uredničkih naslova.' : 'Визуелен однос на плурализмот на изворите и сензационализмот на уредничките наслови.'}</p>
                    
                    <div class="compass-canvas-container">
                        <svg class="compass-svg" viewBox="0 0 200 200">
                            <!-- Grid lines -->
                            <line x1="100" y1="15" x2="100" y2="185" class="compass-grid-axis" />
                            <line x1="15" y1="100" x2="185" y2="100" class="compass-grid-axis" />
                            <circle cx="100" cy="100" r="40" class="compass-grid-ring" />
                            <circle cx="100" cy="100" r="80" class="compass-grid-ring" />
                            
                            <!-- Labels -->
                            <text x="100" y="12" class="compass-text compass-text-top" text-anchor="middle">{lang === 'sr' ? 'Visok Pluralizam' : 'Висок Плурализам'}</text>
                            <text x="100" y="195" class="compass-text compass-text-bottom" text-anchor="middle">{lang === 'sr' ? 'Eho Komora' : 'Ехо Комора'}</text>
                            <text x="190" y="103" class="compass-text compass-text-right" text-anchor="start">{lang === 'sr' ? 'Objektivno' : 'Објективно'}</text>
                            <text x="10" y="103" class="compass-text compass-text-left" text-anchor="end">{lang === 'sr' ? 'Senzacionalistički' : 'Сензационалистички'}</text>
                            
                            <!-- Pulsating target coordinate point -->
                            <g class="compass-target-group">
                                <circle cx={20 + (toneAnalysis?.objectivity ?? 0.5) * 160} cy={20 + (1 - ((pluralismScore ?? 50) / 100)) * 160} r="8" class="compass-target-glow" style="transform-origin: center;" />
                                <circle cx={20 + (toneAnalysis?.objectivity ?? 0.5) * 160} cy={20 + (1 - ((pluralismScore ?? 50) / 100)) * 160} r="4" class="compass-target-point" />
                            </g>
                        </svg>
                    </div>
                </div>

                <!-- Perspectives Cards -->
                <div class="perspectives-list-card">
                    <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 text-muted-foreground/60">{t('cluster.factcheck.diversity')}</h4>
                    <div class="perspective-grid-v2">
                        {displayPerspectives.map((p: any) => (
                            <div class="editorial-angle-card">
                                <h5 class="angle-title" set:html={renderSynthesisHtml(p.angle)}></h5>
                                <p class="angle-content" set:html={renderSynthesisHtml(p.content)}></p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
		</div>
	)}
</section>

<style>
	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.section-label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 950;
		letter-spacing: 0.15em;
		color: var(--foreground);
		white-space: nowrap;
	}

	.section-divider {
		flex: 1;
		height: 1px;
		background: var(--border);
	}

	.factcheck-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 768px) {
		.factcheck-grid-v2 {
			grid-template-columns: 1fr 1fr;
			gap: 1.25rem;
		}
	}

	.factcheck-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.col-header {
		display: flex;
		align-items: center;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid var(--foreground);
	}

	.col-header h3 {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-left: 0.5rem;
	}

	.fact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.fact-item {
		font-family: var(--font-nyt-body);
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--secondary-foreground);
		position: relative;
		padding-left: 1rem;
	}

	.fact-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5rem;
		width: 4px;
		height: 4px;
		border-radius: 50%;
	}

	.fact-item.green::before {
		background: #10b981;
	}

	.fact-item.red::before {
		background: var(--nyt-red);
	}

	.fact-item.amber::before {
		background: #f59e0b;
	}

	.perspectives-area {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.perspective-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	@media (min-width: 768px) {
		.perspective-grid-v2 {
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		}
	}

	.editorial-angle-card {
		padding: 1rem;
		background: color-mix(in srgb, var(--secondary) 30%, var(--card));
		border: 1px solid var(--border);
		border-radius: 6px;
		box-shadow: var(--shadow-sm);
		transition: transform 0.3s var(--ease-editorial), border-color 0.3s var(--ease-editorial), box-shadow 0.3s var(--ease-editorial);
	}
	.editorial-angle-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--nyt-accent) 30%, var(--border));
		box-shadow: var(--shadow-md);
	}

	.angle-title {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		text-transform: uppercase;
		margin-bottom: 0.45rem;
		color: var(--nyt-accent);
	}

	.angle-content {
		font-family: var(--font-sans);
		font-size: 0.86rem;
		line-height: 1.35;
		color: var(--secondary-foreground);
	}

	/* ── Bias Compass & perspectives Grid ── */
    .analysis-bento-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 1024px) {
        .analysis-bento-grid {
            grid-template-columns: 260px 1fr;
            align-items: start;
        }
    }

    .bias-compass-card {
        padding: 1.25rem;
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: all 0.3s var(--ease-editorial);
    }

    .dark .bias-compass-card {
        background: rgba(0, 0, 0, 0.2);
        border-color: rgba(255, 255, 255, 0.05);
    }

    .bias-compass-card:hover {
        border-color: color-mix(in srgb, var(--nyt-accent) 30%, transparent);
        box-shadow: 0 8px 25px -4px rgba(0, 0, 0, 0.05);
    }

    .compass-label {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 950;
        text-transform: uppercase;
        color: var(--nyt-accent);
        margin: 0;
        letter-spacing: 0.05em;
    }

    .compass-desc {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        color: var(--muted-foreground);
        margin: 0 0 0.5rem 0;
        line-height: 1.3;
    }

    .compass-canvas-container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .compass-svg {
        width: 100%;
        max-width: 220px;
        height: auto;
        overflow: visible;
    }

    .compass-grid-axis {
        stroke: color-mix(in srgb, var(--border) 70%, transparent);
        stroke-width: 1px;
        stroke-dasharray: 2 2;
    }

    .compass-grid-ring {
        fill: none;
        stroke: color-mix(in srgb, var(--border) 40%, transparent);
        stroke-width: 1px;
    }

    .compass-text {
        font-family: var(--font-sans);
        font-size: 8px;
        font-weight: 750;
        fill: var(--muted-foreground);
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .compass-text-top {
        fill: #10b981;
    }

    .compass-text-bottom {
        fill: #3b82f6;
    }

    .compass-text-left {
        fill: var(--nyt-red);
    }

    .compass-text-right {
        fill: #10b981;
    }

    .compass-target-glow {
        fill: var(--nyt-accent);
        opacity: 0.25;
        animation: compass-pulse 2.5s infinite ease-in-out;
    }

    .compass-target-point {
        fill: var(--nyt-accent);
        stroke: var(--background);
        stroke-width: 1px;
    }

    @keyframes compass-pulse {
        0%, 100% {
            transform: scale(0.9);
            opacity: 0.2;
        }
        50% {
            transform: scale(1.6);
            opacity: 0.45;
        }
    }
</style>
