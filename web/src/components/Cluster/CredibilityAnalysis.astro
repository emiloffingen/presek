---
import { ShieldCheck, TriangleAlert, Search } from 'lucide-react';
import { renderSynthesisHtml as sharedRenderSynthesisHtml } from '../../utils/renderSynthesisHtml';

interface Props {
	hasFactcheck: boolean;
	verificationReport: any;
	perspectives: any[];
	hasCitationSources: boolean;
}

const { hasFactcheck, verificationReport, perspectives, hasCitationSources } = Astro.props;

const renderSynthesisHtml = (text: string) => sharedRenderSynthesisHtml(text, hasCitationSources);
---

<section class="editorial-section analysis-section mb-16 border-t-4 border-foreground pt-12">
	<div class="section-eyebrow mb-10">
		<ShieldCheck size={18} className="text-foreground" />
		<h2 class="section-label">PLURALIZAM</h2>
		<div class="section-divider"></div>
	</div>

	{hasFactcheck && (
		<div class="factcheck-container mb-12">
			<div class="factcheck-grid-v2">
				<div class="factcheck-col agreements">
					<header class="col-header">
						<ShieldCheck size={18} className="text-emerald-600" />
						<h3>potvrdeni fakti</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.agreements.map((item: string) => (
							<li class="fact-item green" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				<div class="factcheck-col conflicts">
					<header class="col-header">
						<TriangleAlert size={18} className="text-nyt-red" />
						<h3>Razliki vo izvestaj</h3>
					</header>
					<ul class="fact-list">
						{verificationReport.conflicts.map((item: string) => (
							<li class="fact-item red" set:html={renderSynthesisHtml(item)}></li>
						))}
					</ul>
				</div>

				{verificationReport.missing_info && verificationReport.missing_info.length > 0 && (
					<div class="factcheck-col missing-info mt-6 col-span-full border-t border-border pt-4">
						<header class="col-header">
							<Search size={18} className="text-amber-500" />
							<h3>kontekst</h3>
						</header>
						<p class="text-xs text-muted-foreground mb-3 font-sans uppercase font-bold tracking-wider">Sto izostavuvaat odredeni izvori:</p>
						<ul class="fact-list">
							{verificationReport.missing_info.map((item: string) => (
								<li class="fact-item amber" set:html={renderSynthesisHtml(item)}></li>
							))}
						</ul>
					</div>
				)}
			</div>

			{verificationReport.context && (
				<div class="factcheck-context p-6 bg-muted/30 border border-border/40 mt-8 italic text-sm text-muted-foreground">
					<p set:html={renderSynthesisHtml(verificationReport.context)}></p>
				</div>
			)}
		</div>
	)}

	{perspectives.length > 0 && (
		<div class="perspectives-area">
			<h4 class="text-[11px] font-black uppercase tracking-widest text-center mb-8 text-muted-foreground/60">DIVERZITET</h4>
			<div class="perspective-grid-v2">
				{perspectives.map((p: any) => (
					<div class="editorial-angle-card">
						<h5 class="angle-title" set:html={renderSynthesisHtml(p.angle)}></h5>
						<p class="angle-content" set:html={renderSynthesisHtml(p.content)}></p>
					</div>
				))}
			</div>
		</div>
	)}
</section>

<style>
	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 950;
		letter-spacing: 0.15em;
		color: var(--foreground);
		white-space: nowrap;
	}

	.section-divider {
		flex: 1;
		height: 1px;
		background: var(--border);
	}

	.factcheck-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.factcheck-grid-v2 {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
	}

	.factcheck-col {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.col-header {
		display: flex;
		align-items: center;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--foreground);
	}

	.col-header h3 {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-left: 0.5rem;
	}

	.fact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.fact-item {
		font-family: var(--font-nyt-body);
		font-size: 1rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
		position: relative;
		padding-left: 1.5rem;
	}

	.fact-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5rem;
		width: 6px;
		height: 6px;
		border-radius: 50%;
	}

	.fact-item.green::before {
		background: #10b981;
	}

	.fact-item.red::before {
		background: var(--nyt-red);
	}

	.fact-item.amber::before {
		background: #f59e0b;
	}

	.perspectives-area {
		margin-top: 4rem;
		padding-top: 4rem;
		border-top: 1px solid var(--border);
	}

	.perspective-grid-v2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.perspective-grid-v2 {
			grid-template-columns: 1fr 1fr;
		}
	}

	.editorial-angle-card {
		padding: 2rem;
		background: var(--secondary);
		border-radius: 0px;
	}

	.angle-title {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 950;
		text-transform: uppercase;
		margin-bottom: 1rem;
		color: var(--nyt-accent);
	}

	.angle-content {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.5;
		font-italic: italic;
	}
</style>
