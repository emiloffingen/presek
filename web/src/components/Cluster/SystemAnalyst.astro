---
import { Zap } from 'lucide-react';
import { sanitizeHtml } from '../../lib/sanitize';

interface Props {
	pulseScore?: number;
	keyFacts: string[];
	analystEntities: string[];
}

const { pulseScore, keyFacts, analystEntities } = Astro.props;
---

<section class="editorial-section analyst-section mb-16 border-t-2 border-nyt-accent pt-10 bg-secondary/5 p-8 rounded-sm">
	<div class="section-eyebrow mb-8">
		<Zap size={18} className="text-nyt-accent" fill="currentColor" />
		<h2 class="section-label">СИСТЕМСКИ АНАЛИТИЧАР</h2>
		<div class="section-divider"></div>
		{pulseScore && (
			<div class="analyst-pulse-badge">
				<span>ПУЛС: {pulseScore}%</span>
				<div class="pulse-ring">
					<div class="pulse-ring-fill" style={`height: ${pulseScore}%`}></div>
				</div>
			</div>
		)}
	</div>

	<div class="analyst-facts-grid grid grid-cols-1 md:grid-cols-3 gap-8">
		{keyFacts.map((fact: string, idx: number) => (
			<div class="fact-card">
				<span class="fact-number">0{idx + 1}</span>
				<p class="fact-text font-serif text-lg leading-snug" set:html={sanitizeHtml(fact)}></p>
			</div>
		))}
	</div>
	
</section>

<style>
	.analyst-section {
		position: relative;
		overflow: hidden;
	}

	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 950;
		letter-spacing: 0.15em;
		color: var(--foreground);
		white-space: nowrap;
	}

	.section-divider {
		flex: 1;
		height: 1px;
		background: var(--border);
	}

	.analyst-pulse-badge {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-left: 1rem;
		border-left: 1px solid var(--border);
	}

	.analyst-pulse-badge span {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		color: var(--nyt-accent);
	}

	.pulse-ring {
		width: 14px;
		height: 24px;
		background: var(--secondary);
		border: 1px solid var(--border);
		position: relative;
		border-radius: 2px;
		overflow: hidden;
	}

	.pulse-ring-fill {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		background: var(--nyt-accent);
		transition: height 1s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.fact-card {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.fact-number {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 950;
		color: var(--nyt-accent);
		opacity: 0.4;
	}

	.fact-text {
		color: var(--foreground);
		text-wrap: pretty;
	}
</style>
