---
import { Globe } from 'lucide-react';
import { localePath } from '../../lib/localePaths';

interface Counterpart {
  cluster_id: string;
  lang: string;
  headline: string;
  storyline_title?: string;
}

interface Props {
  counterparts: Counterpart[];
  lang: 'sr' | 'mk';
  hostHeader?: string | null;
}

const { counterparts = [], lang, hostHeader = null } = Astro.props;
if (!counterparts.length) return;

const otherLang = lang === 'mk' ? 'sr' : 'mk';
const title =
  lang === 'mk'
    ? 'Иста тема во соседните медиуми'
    : 'Ista tema u susednim medijima';
const l = (path: string) => localePath(path, otherLang as 'sr' | 'mk', hostHeader);
---

<section class="cross-lingual-strip" aria-label={title}>
  <div class="cross-lingual-head">
    <Globe size={15} />
    <h3>{title}</h3>
    <span>{otherLang === 'mk' ? 'PRESEK.MK' : 'PRESEK.RS'}</span>
  </div>
  <ul>
    {counterparts.map((item) => (
      <li>
        <a href={l(`/cluster/${item.cluster_id}`)}>
          <strong>{item.headline}</strong>
          {item.storyline_title ? <span>{item.storyline_title}</span> : null}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .cross-lingual-strip {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0 0.5rem;
    margin-top: 1.5rem;
  }
  .cross-lingual-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    color: var(--nyt-accent);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cross-lingual-head h3 {
    margin: 0;
    font: inherit;
    color: var(--foreground);
  }
  .cross-lingual-head span {
    margin-left: auto;
    color: var(--muted-foreground);
  }
  .cross-lingual-strip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .cross-lingual-strip a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    color: inherit;
  }
  .cross-lingual-strip a:hover strong {
    color: var(--nyt-accent);
    text-decoration: underline;
  }
  .cross-lingual-strip strong {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.25;
  }
  .cross-lingual-strip span {
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }
</style>
