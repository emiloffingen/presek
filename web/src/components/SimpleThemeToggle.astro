---
// Generate a unique ID for the SVG mask to support multiple switcher instances cleanly
const maskId = `moon-mask-${Math.random().toString(36).substring(2, 9)}`;
---
<!--
  Simple Theme Toggle - Vanilla JS version
  More reliable than React-based solution
-->

<button
  type="button"
  class="header-utility-button theme-toggle-button simple-theme-toggle-btn flex items-center justify-center transition-all duration-300 group relative text-muted-foreground hover:text-foreground h-9 w-9 shrink-0 hover:bg-secondary active:scale-95 overflow-hidden"
  aria-label="Toggle theme"
>
  <svg
    class="theme-toggle-svg w-5 h-5 transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <mask id={maskId}>
      <rect x="0" y="0" width="24" height="24" fill="white" />
      <circle class="moon-mask-circle" cx="30" cy="0" r="8" fill="black" />
    </mask>
    <circle class="sun-body" cx="12" cy="12" r="5" mask={`url(#${maskId})`} fill="currentColor" />
    <g class="sun-rays" stroke="currentColor" stroke-width="2">
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </g>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const htmlElement = document.documentElement;
    const toggles = document.querySelectorAll('.simple-theme-toggle-btn');
    if (toggles.length === 0) return;

    // Check for saved theme preference
    let savedTheme = null;
    try {
      savedTheme = localStorage.getItem('theme');
    } catch (e) {
      console.warn('localStorage not accessible:', e);
    }
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    
    // Apply saved theme or system preference
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      htmlElement.classList.add('dark');
      htmlElement.classList.remove('light');
    } else {
      htmlElement.classList.remove('dark');
      htmlElement.classList.add('light');
    }
    
    // Toggle theme on click for all toggles on the page
    toggles.forEach(toggleButton => {
      if (toggleButton.getAttribute('data-has-listener') === 'true') return;
      toggleButton.setAttribute('data-has-listener', 'true');

      toggleButton.addEventListener('click', function() {
        const isDark = htmlElement.classList.contains('dark');
        if (isDark) {
          htmlElement.classList.remove('dark');
          htmlElement.classList.add('light');
          try {
            localStorage.setItem('theme', 'light');
          } catch (e) {}
        } else {
          htmlElement.classList.add('dark');
          htmlElement.classList.remove('light');
          try {
            localStorage.setItem('theme', 'dark');
          } catch (e) {}
        }
      });
    });
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  .theme-toggle-svg {
    transform: rotate(0deg);
  }
  
  .theme-toggle-svg .sun-body {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), r 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
    r: 5px;
  }
  
  .theme-toggle-svg .moon-mask-circle {
    transition: cx 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), cy 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), r 0.5s ease;
    cx: 30;
    cy: 0;
  }
  
  .theme-toggle-svg .sun-rays {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
    transform-origin: center;
    opacity: 1;
    transform: scale(1);
  }
  
  /* Dark mode styles using global modifier for container element */
  :global(.dark) .theme-toggle-svg {
    transform: rotate(40deg);
  }
  
  :global(.dark) .theme-toggle-svg .sun-body {
    r: 9px;
  }
  
  :global(.dark) .theme-toggle-svg .moon-mask-circle {
    cx: 18;
    cy: 6;
  }
  
  :global(.dark) .theme-toggle-svg .sun-rays {
    transform: scale(0);
    opacity: 0;
  }
</style>