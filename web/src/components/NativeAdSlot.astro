---
import { apiBaseUrl } from '../lib/apiBase';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath } from '../lib/localePaths';
import { SLOT_META, PROMO_PERCENT, localCpm, type AdSlotId } from '../lib/adPricing';

interface Props {
  slotId: AdSlotId;
  class?: string;
}

const { slotId, class: className = '' } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const marketingUrl = localePath('/marketing', lang, hostHeader);

let activeAd: { id: string; image_url: string; target_url: string } | null = null;
try {
  const res = await fetch(`${apiBaseUrl()}/marketing/ads/active`);
  if (res.ok) {
    const data = await res.json();
    const ads = data.ads?.[slotId] || [];
    if (ads.length > 0) {
      // Pick a random active ad for the slot.
      activeAd = ads[Math.floor(Math.random() * ads.length)];
    }
  }
} catch (e) {
  console.error(`[NativeAdSlot] Error fetching active ads for ${slotId}:`, e);
}

const meta = SLOT_META[slotId];
const isMk = lang === 'mk';
const local = localCpm(meta.eur, lang);

const adLabel = isMk ? 'Реклама' : 'Oglas';
const kicker = isMk ? 'Слободен рекламен простор' : 'Slobodan reklamni prostor';
const title = isMk ? 'Купете го овој рекламен простор' : 'Kupite ovaj reklamni prostor';
const desc = isMk
  ? 'Автоматизиран самопослужен систем. Резервирајте, платете онлајн и следете ги резултатите во реално време.'
  : 'Automatizovan samouslužni sistem. Rezervišite, platite onlajn i pratite rezultate u realnom vremenu.';
const unit = isMk ? 'за 1.000 прикажувања' : 'za 1.000 prikazivanja';
const cta = isMk ? 'Рекламирај се' : 'Oglašavaj se';
---

{activeAd ? (
  <div
    class={`native-ad native-ad--active native-ad--${slotId} ${className}`}
    data-ad-id={activeAd.id}
    style={`min-height:${meta.minHeight}`}
  >
    <span class="native-ad__label">{adLabel}</span>
    <a
      href={activeAd.target_url}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="native-ad__link ad-link"
      data-ad-id={activeAd.id}
    >
      <img src={activeAd.image_url} alt={adLabel} class="native-ad__image" loading="lazy" decoding="async" />
    </a>
  </div>
) : slotId === 'top_banner' ? (
  <aside
    class={`native-ad native-ad--empty native-ad--${slotId} ${className}`}
    style={`min-height:${meta.minHeight}`}
    aria-label={kicker}
  >
    <div class="native-ad__main">
      <div class="native-ad__head">
        <span class="native-ad__kicker">{kicker}</span>
        <span class="native-ad__format">{meta.size}</span>
      </div>
      <h3 class="native-ad__title">{title}</h3>
      <p class="native-ad__desc">{desc}</p>
    </div>
    <div class="native-ad__foot">
      <div class="native-ad__pricing">
        <span class="native-ad__price-now">€{meta.eur.toFixed(2)}</span>
        <span class="native-ad__price-was">€{meta.baseEur.toFixed(2)}</span>
        <span class="native-ad__promo">−{PROMO_PERCENT}%</span>
        <span class="native-ad__price-unit">{unit} · ~{local.amount} {local.currency}</span>
      </div>
      <a href={marketingUrl} class="native-ad__cta">
        <span>{cta}</span>
        <span class="native-ad__cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </aside>
) : null}

<script>
  import { buildCsrfHeadersAsync } from '../lib/personalization';

  // Client-side tracking
  document.addEventListener('DOMContentLoaded', () => {
    const trackAdEvent = async (adId: string, event: 'impression' | 'click') => {
      try {
        const headers = await buildCsrfHeadersAsync();
        await fetch(`/api/marketing/ads/${adId}/${event}`, {
          method: 'POST',
          headers,
          credentials: 'same-origin',
        });
      } catch (err) {
        console.error(`Failed to log ad ${event}:`, err);
      }
    };

    // 1. Impression Tracking (IAB viewability: at least 50% visible for 1 continuous second)
    const activeAds = document.querySelectorAll('.native-ad--active');
    const VIEWABLE_RATIO = 0.5;
    const VIEWABLE_MS = 1000;
    const pendingViews = new Map<Element, number>();

    const impressionObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        const adContainer = entry.target;
        const adId = adContainer.getAttribute('data-ad-id');
        if (!adId) return;
        if (entry.isIntersecting && entry.intersectionRatio >= VIEWABLE_RATIO) {
          if (pendingViews.has(adContainer)) return;
          pendingViews.set(adContainer, window.setTimeout(() => {
            pendingViews.delete(adContainer);
            void trackAdEvent(adId, 'impression');
            // Unobserve to avoid double logging impressions on scroll
            observer.unobserve(adContainer);
          }, VIEWABLE_MS));
        } else {
          const timer = pendingViews.get(adContainer);
          if (timer !== undefined) {
            window.clearTimeout(timer);
            pendingViews.delete(adContainer);
          }
        }
      });
    }, { root: null, threshold: [0, VIEWABLE_RATIO] });

    activeAds.forEach(ad => {
      impressionObserver.observe(ad);
    });

    // 2. Click Tracking
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const adLink = target.closest('.ad-link');
      if (adLink) {
        const adId = adLink.getAttribute('data-ad-id');
        if (adId) {
          void trackAdEvent(adId, 'click');
        }
      }
    });
  });
</script>

<style>
  .native-ad {
    position: relative;
    width: 100%;
    margin: 1.5rem auto;
    box-sizing: border-box;
  }

  .native-ad--top_banner {
    max-width: 990px;
  }

  .native-ad--sidebar,
  .native-ad--mobile_content {
    max-width: 300px;
  }

  /* Active creative */
  .native-ad--active {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .native-ad__label {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 2px 7px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--background);
    background: var(--foreground);
    opacity: 0.8;
  }

  .native-ad__link {
    display: block;
    width: 100%;
    height: 100%;
    text-align: center;
  }

  .native-ad__image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    margin: 0 auto;
  }

  /* House / empty slot */
  .native-ad--empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .native-ad--empty:hover {
    border-color: var(--foreground);
    background: var(--surface-strong);
  }

  .native-ad__main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .native-ad__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .native-ad__kicker {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--presek-mark, var(--muted-foreground));
  }

  .native-ad__format {
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    color: var(--muted-foreground);
    opacity: 0.7;
    white-space: nowrap;
  }

  .native-ad__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--foreground);
  }

  .native-ad__desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .native-ad__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .native-ad__pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .native-ad__price-now {
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--foreground);
  }

  .native-ad__price-was {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    text-decoration: line-through;
    opacity: 0.7;
  }

  .native-ad__promo {
    padding: 1px 5px;
    font-size: 0.62rem;
    font-weight: 800;
    color: #fff;
    background: var(--presek-mark, #b91c1c);
  }

  .native-ad__price-unit {
    width: 100%;
    font-size: 0.66rem;
    color: var(--muted-foreground);
  }

  .native-ad__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem;
    font-size: 0.75rem;
    font-weight: 800;
    white-space: nowrap;
    text-decoration: none;
    color: var(--primary-foreground);
    background: var(--primary);
    border: 1px solid var(--primary);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .native-ad__cta:hover {
    background: transparent;
    color: var(--primary);
  }

  .native-ad__cta-arrow {
    transition: transform 0.2s ease;
  }

  .native-ad__cta:hover .native-ad__cta-arrow {
    transform: translateX(3px);
  }

  /* Top banner runs horizontally on wide screens */
  .native-ad--top_banner.native-ad--empty {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
  }

  .native-ad--top_banner .native-ad__main {
    flex: 1 1 auto;
  }

  .native-ad--top_banner .native-ad__foot {
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 0;
    text-align: right;
  }

  .native-ad--top_banner .native-ad__pricing {
    justify-content: flex-end;
  }

  /* Unsold house ad: a slim strip at every width, not a block of promo copy. */
  .native-ad--top_banner.native-ad--empty {
    min-height: 0 !important;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
  }
  .native-ad--top_banner .native-ad__desc,
  .native-ad--top_banner .native-ad__format,
  .native-ad--top_banner .native-ad__price-was,
  .native-ad--top_banner .native-ad__price-unit,
  .native-ad--top_banner .native-ad__promo {
    display: none;
  }
  .native-ad--top_banner .native-ad__title {
    font-size: 0.95rem;
    line-height: 1.25;
    margin: 0.1rem 0 0;
  }
  .native-ad--top_banner .native-ad__foot {
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
  }
  .native-ad--top_banner .native-ad__cta {
    width: auto;
    min-height: 2.5rem;
    padding-inline: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .native-ad--top_banner .native-ad__foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .native-ad--top_banner .native-ad__pricing {
      justify-content: flex-start;
    }

    .native-ad__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
