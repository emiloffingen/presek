---
import { apiBaseUrl } from '../lib/apiBase';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath } from '../lib/localePaths';

interface Props {
  slotId: 'top_banner' | 'sidebar' | 'mobile_content';
  class?: string;
}

const { slotId, class: className = '' } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const marketingUrl = localePath('/marketing', lang, hostHeader);

let activeAd = null;
try {
  const res = await fetch(`${apiBaseUrl()}/marketing/ads/active`);
  if (res.ok) {
    const data = await res.json();
    const ads = data.ads?.[slotId] || [];
    if (ads.length > 0) {
      // Pick a random active ad for the slot
      activeAd = ads[Math.floor(Math.random() * ads.length)];
    }
  }
} catch (e) {
  console.error(`[NativeAdSlot] Error fetching active ads for ${slotId}:`, e);
}

// CPM rates and sizes for fallback metadata
const meta = {
  top_banner: {
    price: 1.00,
    priceMkd: 60,
    size: '990x80 / 990x150',
    minHeight: '120px'
  },
  sidebar: {
    price: 1.25,
    priceMkd: 75,
    size: '300x250 / 300x600',
    minHeight: '250px'
  },
  mobile_content: {
    price: 2.00,
    priceMkd: 125,
    size: '300x250',
    minHeight: '250px'
  }
}[slotId];

const isMk = lang === 'mk';
const title = isMk ? 'Купете го овој рекламен простор' : 'Kupite ovaj reklamni prostor';
const desc = isMk 
  ? 'Автоматизиран самопослужен систем за реклами со Stripe плаќање.' 
  : 'Automatski samouslužni sistem za reklame sa Stripe plaćanjem.';
const rsdPrice = Math.round(meta.price * 117);
const priceStr = isMk 
  ? `Од €${meta.price.toFixed(2)} / 1000 импресии (~${meta.priceMkd} ден.)` 
  : `Od €${meta.price.toFixed(2)} / 1000 impresija (~${rsdPrice} RSD)`;
const btnText = isMk ? 'Рекламирај се' : 'Oglašavaj se';
---

{activeAd ? (
  <div 
    class={`native-ad-slot active-ad-container ${slotId} ${className}`} 
    data-ad-id={activeAd.id}
    style={`min-height: ${meta.minHeight}`}
  >
    <div class="ad-badge">{isMk ? 'Реклама' : 'Oglas'}</div>
    <a 
      href={activeAd.target_url} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="ad-link"
      data-ad-id={activeAd.id}
    >
      <img src={activeAd.image_url} alt="Advertisement" class="ad-image" />
    </a>
  </div>
) : (
  <div class={`native-ad-slot fallback-ad-card ${slotId} ${className}`} style={`min-height: ${meta.minHeight}`}>
    <div class="fallback-content">
      <div class="fallback-text-side">
        <div class="fallback-kicker-wrap">
          <span class="pulse-indicator"></span>
          <div class="fallback-kicker">{isMk ? 'СЛОБОДЕН РЕКЛАМЕН ПРОСТОР' : 'SLOBODAN REKLAMNI PROSTOR'} ({meta.size})</div>
        </div>
        <h4 class="fallback-title">{title}</h4>
        <p class="fallback-desc">{desc}</p>
      </div>
      <div class="fallback-footer">
        <span class="fallback-price">{priceStr}</span>
        <a href={marketingUrl} class="fallback-btn">
          <span>{btnText}</span>
          <span class="btn-arrow">➔</span>
        </a>
      </div>
    </div>
  </div>
)}

<script>
  // Client-side tracking
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Impression Tracking
    const activeAds = document.querySelectorAll('.active-ad-container');
    const observerOptions = {
      root: null,
      threshold: 0.1 // Trigger when 10% visible
    };

    const impressionObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const adContainer = entry.target;
          const adId = adContainer.getAttribute('data-ad-id');
          if (adId) {
            fetch(`/api/marketing/ads/${adId}/impression`, { method: 'POST' })
              .catch(err => console.error('Failed to log impression:', err));
            // Unobserve to avoid double logging impressions on scroll
            observer.unobserve(adContainer);
          }
        }
      });
    }, observerOptions);

    activeAds.forEach(ad => {
      impressionObserver.observe(ad);
    });

    // 2. Click Tracking
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const adLink = target.closest('.ad-link');
      if (adLink) {
        const adId = adLink.getAttribute('data-ad-id');
        if (adId) {
          fetch(`/api/marketing/ads/${adId}/click`, { method: 'POST' })
            .catch(err => console.error('Failed to log click:', err));
        }
      }
    });
  });
</script>

<style>
  .native-ad-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 1.5rem auto;
    overflow: hidden;
    border-radius: 0px;
    box-sizing: border-box;
    transition: all 0.3s var(--ease-editorial);
  }

  /* Active Ad Styling */
  .active-ad-container {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border);
  }
  
  :global(.dark) .active-ad-container {
    background: rgba(255, 255, 255, 0.02);
  }

  .ad-badge {
    position: absolute;
    top: 6px;
    left: 8px;
    background: var(--foreground);
    color: var(--background);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 0px;
    pointer-events: none;
    z-index: 10;
    letter-spacing: 0.05em;
  }

  .ad-link {
    display: block;
    width: 100%;
    height: 100%;
    text-align: center;
  }

  .ad-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    margin: 0 auto;
    display: block;
    border-radius: 0px;
  }

  /* Fallback Card Aesthetics */
  .fallback-ad-card {
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    box-shadow: none;
    color: var(--foreground);
    padding: 1.5rem;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .fallback-ad-card:hover {
    border-color: var(--foreground);
    background-color: var(--surface-strong);
  }

  .fallback-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.5rem;
  }

  .fallback-kicker-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    background: var(--nyt-red);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--nyt-red);
    animation: indicator-pulsing 1.8s infinite ease-in-out;
  }

  @keyframes indicator-pulsing {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 8px var(--nyt-red); }
  }

  .fallback-kicker {
    font-size: 10px;
    font-weight: 800;
    color: var(--nyt-gray-500);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .fallback-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    color: var(--foreground);
  }

  .fallback-desc {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    opacity: 0.85;
    margin: 0;
    line-height: 1.35;
  }

  .fallback-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .fallback-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--nyt-red);
    font-family: var(--font-mono, monospace);
  }

  .fallback-btn {
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.55rem 1.15rem;
    border-radius: 0px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.25s var(--transition-base);
    border: 1px solid var(--primary);
    box-shadow: none;
  }

  .fallback-btn:hover {
    background-color: transparent;
    color: var(--primary);
    border-color: var(--primary);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .fallback-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Responsive Adjustments based on Slot type */
  .top_banner {
    max-width: 990px;
    margin-inline: auto;
  }

  .top_banner .fallback-content {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .top_banner .fallback-text-side {
    display: flex;
    flex-direction: column;
    text-align: left;
    gap: 0.15rem;
  }

  .top_banner .fallback-footer {
    margin-top: 0;
    flex-shrink: 0;
    gap: 1.5rem;
  }

  .sidebar {
    max-width: 300px;
    flex-direction: column;
  }

  .mobile_content {
    max-width: 300px;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .top_banner {
      min-height: 120px !important;
      padding: 1rem;
    }
    .top_banner .fallback-content {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .top_banner .fallback-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.5rem;
    }
    .fallback-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .fallback-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
