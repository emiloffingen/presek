---
/**
 * AdUnit.astro
 * Standardized Adsterra top banner with editorial labeling.
 */
interface Props {
	slot?: string;
	format?: "auto" | "fluid" | "rectangle";
	className?: string;
}

const { 
    slot = "default", 
    format = "auto", 
    className = "" 
} = Astro.props;
void slot;
void format;
---

<div class={`ad-container my-12 overflow-hidden flex flex-col items-center ${className}`}>
    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-muted-foreground/40 mb-3">ОГЛАС</span>
    <div class="adsterra-top-banner w-full bg-muted/5 border border-border/40 rounded-lg min-h-[90px] flex items-center justify-center overflow-hidden">
        <script is:inline>
            atOptions = {
                'key' : '7fc6fdd34e30aa1a598c4d35b0b073b2',
                'format' : 'iframe',
                'height' : 90,
                'width' : 728,
                'params' : {}
            };
        </script>
        <script is:inline src="https://www.highperformanceformat.com/7fc6fdd34e30aa1a598c4d35b0b073b2/invoke.js"></script>
    </div>
</div>

<style>
    .adsterra-top-banner :global(iframe) {
        max-width: 100%;
    }
</style>
