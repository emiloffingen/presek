---
import NativeAdSlot from './NativeAdSlot.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<NativeAdSlot slotId="sidebar" class={`page-rail-ad ${className || ''}`} />

<style>
  :global(.page-rail-ad) {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1179px) {
    :global(.page-rail-ad) {
      display: none;
    }
  }
</style>
