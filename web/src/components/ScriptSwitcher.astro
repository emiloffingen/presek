---
import { getLangFromUrl } from '../i18n/utils';

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = getLangFromUrl(effectiveUrl);
const initialToggleLabel = lang === 'mk' ? 'LAT/CYR' : 'CYR/LAT';
---

<button type="button" class="script-toggle-btn" data-script-toggle>
    {initialToggleLabel}
</button>

<script>
    import { cyrToLat, latToCyr } from '../utils/textUtils';

    const GLOBAL_KEY = '__presekScriptSwitcher';

    type ScriptState = {
        isCyrillic: boolean;
        isServerCyrillic: boolean;
    };

    function shouldSkipSubtree(node: Node): boolean {
        if (node.nodeType !== Node.ELEMENT_NODE) return false;
        const el = node as Element;
        if (['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(el.tagName)) return true;
        if (el.tagName === 'ASTRO-ISLAND') return true;
        if (el.closest('astro-island')) return true;
        if (el.closest('[data-no-script-convert]')) return true;
        if (el.closest('.header-sticky-wrapper')) return true;
        return false;
    }

    function convertText(node: Node, toCyrillic: boolean) {
        if (node.nodeType === Node.ELEMENT_NODE && shouldSkipSubtree(node)) {
            return;
        }

        if (node.nodeType === Node.TEXT_NODE) {
            if (node.textContent?.trim().length) {
                node.textContent = toCyrillic
                    ? latToCyr(node.textContent)
                    : cyrToLat(node.textContent);
            }
            return;
        }

        if (node.nodeType === Node.ELEMENT_NODE) {
            node.childNodes.forEach((child) => convertText(child, toCyrillic));
        }
    }

    function traverseBody(toCyrillic: boolean) {
        const main = document.querySelector('main');
        if (main) {
            convertText(main, toCyrillic);
            return;
        }
        convertText(document.body, toCyrillic);
    }

    function syncToggleLabels(state: ScriptState) {
        document.querySelectorAll<HTMLButtonElement>('[data-script-toggle]').forEach((toggle) => {
            toggle.textContent = state.isCyrillic ? 'LAT/CYR' : 'CYR/LAT';
        });
    }

    function applyScriptState(state: ScriptState, convertDom: boolean) {
        if (state.isCyrillic) {
            document.body.classList.add('script-cyrillic');
        } else {
            document.body.classList.remove('script-cyrillic');
        }
        try {
            localStorage.setItem('scriptPreference', state.isCyrillic ? 'cyrillic' : 'latin');
        } catch (e) {}
        syncToggleLabels(state);
        if (convertDom) {
            traverseBody(state.isCyrillic);
        }
    }

    function readState(): ScriptState {
        const initialLang = document.documentElement.lang || 'sr';
        const isServerCyrillic = initialLang.startsWith('mk');
        let savedPreference = null;
        try {
            savedPreference = localStorage.getItem('scriptPreference');
        } catch (e) {}
        const isCyrillic = savedPreference ? savedPreference === 'cyrillic' : isServerCyrillic;
        return { isCyrillic, isServerCyrillic };
    }

    function bindToggles(state: ScriptState) {
        document.querySelectorAll<HTMLButtonElement>('[data-script-toggle]').forEach((toggle) => {
            if (toggle.dataset.bound === '1') return;
            toggle.dataset.bound = '1';
            toggle.addEventListener('click', () => {
                state.isCyrillic = !state.isCyrillic;
                applyScriptState(state, true);
            });
        });
    }

    function initScriptSwitcher() {
        const root = window as typeof window & { [GLOBAL_KEY]?: { state: ScriptState } };
        if (!root[GLOBAL_KEY]) {
            root[GLOBAL_KEY] = { state: readState() };
        } else {
            root[GLOBAL_KEY].state = readState();
        }

        const { state } = root[GLOBAL_KEY];
        applyScriptState(state, state.isCyrillic !== state.isServerCyrillic);
        bindToggles(state);
    }

    initScriptSwitcher();
    document.addEventListener('astro:page-load', initScriptSwitcher);
</script>
