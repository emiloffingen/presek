---
import Branding from './Branding.astro';
---
<footer class="editorial-footer site-layout">
    <div class="footer-top-border"></div>
    
    <div class="footer-main">
        <div class="footer-branding">
            <a href="/" class="brand-link">
                <Branding class="footer-mode" />
            </a>
            <p class="brand-ethos">
                Пресек е дигитален сервис за медиумска транспарентност и јавен увид. Нашата мисија е да ја вратиме јасноста во информативниот простор преку мапирање на перспективите, со цел да овозможиме објективна слика низ објективот на плурализмот.
            </p>
        </div>

        <nav class="footer-directory">
            <div class="dir-group">
                <h4 class="dir-title">Едиторијал</h4>
                <a href="/about">Мисија</a>
                <a href="/editorial">Стандарди</a>
                <a href="/pulse">Медиумски Пулс</a>
                <a href="/support" class="support-link">Поддржи го Пресек</a>
            </div>
            <div class="dir-group">
                <h4 class="dir-title">Директориум</h4>
                <a href="/izvori">Медиумски извори</a>
                <a href="/archive">Архива</a>
                <a href="/briefing">Дневен Брифинг</a>
                <a href="/contact">Кореспонденција</a>
            </div>
            <div class="dir-group">
                <h4 class="dir-title">Правно</h4>
                <a href="/privacy">Приватност</a>
                <a href="/terms">Услови</a>
                <a href="/cookies">Колачиња</a>
            </div>
        </nav>
    </div>

    <div class="footer-legal">
        <p class="copyright">© 2026 ПРЕСЕК.мк. Сите права се задржани. Податоците се генерирани преку јавно достапни извори.</p>
        <div class="legal-links">
            <a href="#top" class="scroll-top">На почеток ↑</a>
        </div>
    </div>
</footer>

<style>
    .editorial-footer {
        padding-top: 5rem;
        padding-bottom: 6rem;
        margin-top: 8rem;
    }

    .footer-top-border {
        height: 1px;
        background: var(--border);
        margin-bottom: 5rem;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 6rem;
        align-items: start;
    }

    .brand-ethos {
        font-family: var(--font-nyt-body);
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted-foreground);
        max-width: 35rem;
        text-wrap: pretty;
        opacity: 0.9;
    }

    .footer-directory {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
    }

    .dir-title {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--foreground);
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
    }

    .dir-group a {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--muted-foreground);
        text-decoration: none;
        transition: all 0.2s ease;
        width: fit-content;
        letter-spacing: 0.01em;
    }

    .dir-group a:hover {
        color: var(--nyt-accent);
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .footer-legal {
        margin-top: 5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 2rem;
    }

    .copyright {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--muted-foreground);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .scroll-top {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--foreground);
        text-decoration: none;
    }

    @media (max-width: 1024px) {
        .footer-main { grid-template-columns: 1fr; gap: 3rem; }
        .footer-directory { gap: 1.5rem; }
    }

    @media (max-width: 640px) {
        .editorial-footer { padding-top: 2rem; margin-top: 3rem; }
        .footer-main { gap: 2.5rem; }
        .footer-directory { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
        .footer-legal { flex-direction: column; gap: 1rem; align-items: flex-start; }
    }
</style>
