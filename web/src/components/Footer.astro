---
import Branding from './Branding.astro';
import { Activity, Globe, ShieldCheck, Mail, ArrowUpRight, Zap } from 'lucide-react';
---
<footer class="editorial-footer site-layout">
    <div class="footer-top-border"></div>
    
    <div class="footer-main">
        <div class="footer-branding">
            <a href="/" class="brand-link mb-8">
                <Branding mode="full" class="footer-logo-premium" />
            </a>
            <p class="brand-ethos font-serif italic text-xl md:text-2xl leading-relaxed text-muted-foreground/90 mb-10">
                "Пресек е дигитален сервис за медиумска транспарентност и јавен увид. Нашата мисија е да ја вратиме јасноста во информативниот простор преку мапирање на перспективите, со цел да овозможиме објективна слика низ објективот на плурализмот."
            </p>
            
            <div class="footer-system-pulse p-5 bg-secondary/10 border border-border/40 rounded-xl max-w-md">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <div class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </div>
                        <span class="font-sans text-[10px] font-black uppercase tracking-[0.2em] text-foreground">СИСТЕМСКИ СИГНАЛ</span>
                    </div>
                    <span class="font-sans text-[9px] font-black text-emerald-500 uppercase tracking-widest">АКТИВЕН</span>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="flex items-center gap-2">
                        <Zap size={14} className="text-nyt-accent" />
                        <span class="text-[10px] font-bold text-muted-foreground">AI СИНТЕЗА: OK</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Globe size={14} className="text-nyt-accent" />
                        <span class="text-[10px] font-bold text-muted-foreground">ИНГЕСТИЈА: 24/7</span>
                    </div>
                </div>
            </div>
        </div>

        <nav class="footer-directory">
            <div class="dir-group">
                <h4 class="dir-title">Едиторијал</h4>
                <div class="dir-links-stack">
                    <a href="/about">Мисија <ArrowUpRight size={10} className="opacity-0 group-hover:opacity-100 transition-opacity" /></a>
                    <a href="/editorial">Стандарди</a>
                    <a href="/pulse">Медиумски Пулс</a>
                    <a href="/izvori">Медиумски извори</a>
                </div>
            </div>
            <div class="dir-group">
                <h4 class="dir-title">Ресурси</h4>
                <div class="dir-links-stack">
                    <a href="/archive">Архива на изданија</a>
                    <a href="/briefing">Дневен Брифинг</a>
                    <a href="/settings">Персонализација</a>
                    <a href="/support" class="font-black text-nyt-accent">Поддржи го Пресек</a>
                </div>
            </div>
            <div class="dir-group">
                <h4 class="dir-title">Контакт</h4>
                <div class="dir-links-stack">
                    <a href="/contact" class="flex items-center gap-2"><Mail size={12} /> Кореспонденција</a>
                    <a href="/privacy">Приватност</a>
                    <a href="/terms">Услови за користење</a>
                </div>
            </div>
        </nav>
    </div>

    <div class="footer-legal">
        <div class="legal-left">
            <p class="copyright mb-2">© {new Date().getFullYear()} ПРЕСЕК.МК · ПРВА ДИГИТАЛНА НОВИНСКА АГЕНЦИЈА ЗА СИНТЕЗА</p>
            <p class="legal-note font-sans text-[9px] text-muted-foreground uppercase tracking-widest opacity-60">
                ПОДАТОЦИТЕ СЕ ГЕНЕРИРАНИ ПРЕКУ ЈАВНО ДОСТАПНИ ИЗВОРИ. СИСТЕМОТ КОРИСТИ ВЕШТАЧКА ИНТЕЛИГЕНЦИЈА ЗА АНАЛИЗА.
            </p>
        </div>
        <div class="legal-right">
            <a href="#top" class="scroll-top-premium">
                <span class="font-black">НА ПОЧЕТОК</span>
                <div class="p-2 bg-foreground text-background rounded-full">
                    <ArrowUpRight size={14} className="-rotate-45" />
                </div>
            </a>
        </div>
    </div>
</footer>

<style>
    .editorial-footer {
        padding-top: 6rem;
        padding-bottom: 8rem;
        margin-top: 12rem;
        border-top: 1px solid var(--border);
    }

    .footer-top-border {
        height: 6px;
        border-top: 1px solid var(--foreground);
        border-bottom: 3px solid var(--foreground);
        margin-bottom: 6rem;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 8rem;
        align-items: start;
    }

    .brand-link { display: block; width: fit-content; }

    .brand-ethos {
        max-width: 42rem;
        text-wrap: balance;
    }

    .footer-directory {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4rem;
    }

    .dir-group {
        display: flex;
        flex-direction: column;
    }

    .dir-title {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--foreground);
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--foreground);
    }

    .dir-links-stack {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .dir-group a {
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 850;
        color: var(--muted-foreground);
        text-decoration: none;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        width: fit-content;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dir-group a:hover {
        color: var(--foreground);
        transform: translateX(6px);
    }

    .footer-legal {
        margin-top: 8rem;
        padding-top: 3rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .copyright {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 950;
        color: var(--foreground);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .scroll-top-premium {
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: var(--foreground);
        font-family: var(--font-sans);
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        transition: all 0.3s ease;
    }

    .scroll-top-premium:hover {
        opacity: 0.7;
        transform: translateY(-4px);
    }

    @media (max-width: 1200px) {
        .footer-main { grid-template-columns: 1fr; gap: 5rem; }
        .brand-ethos { max-width: 100%; }
    }

    @media (max-width: 768px) {
        .footer-directory { grid-template-columns: 1fr; gap: 3rem; }
        .dir-title { margin-bottom: 1.5rem; }
        .footer-legal { flex-direction: column; gap: 3rem; align-items: flex-start; }
        .legal-right { width: 100%; display: flex; justify-content: flex-end; }
    }
</style>
