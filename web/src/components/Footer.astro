---
import Branding from './Branding.astro';
import { Activity, Globe, ShieldCheck, Mail, ArrowUpRight, Zap } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath, homePath } from '../lib/localePaths';

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const { hideSystemPulse = false } = Astro.props;

const l = (path: string) => localePath(path, lang, hostHeader);
---
<footer class="editorial-footer site-layout">
    <div class="footer-precision-rules">
        <div class="rule-thick"></div>
        <div class="rule-thin"></div>
    </div>

    <div class="feed-section-container">
        <div class="footer-main">
            <div class="footer-left-col">
                <div class="footer-brand-wrap mb-8">
                    <a href={l('/')} class="brand-link">
                        <Branding mode="full" class="footer-logo-premium" />
                    </a>
                    <p class="brand-ethos font-serif italic text-base leading-relaxed text-foreground mt-4 max-w-xl">
                        {t('footer.ethos')}
                    </p>
                </div>

            </div>

            <nav class="footer-directory">
                <div class="dir-group">
                    <h4 class="dir-title">{t('nav.editorial')}</h4>
                    <div class="dir-links-stack">
                        <a href={l('/about')}>{t('nav.mission')}</a>
                        <a href={l('/editorial')}>{t('nav.standards')}</a>
                        <a href={l('/methodology')}>{t('nav.methodology')}</a>
                        <a href={l('/analize')}>{t('nav.analize')}</a>
                        <a href={l('/pulse')}>{t('nav.pulse')}</a>
                        <a href={l('/izvori')}>{t('nav.sources')}</a>
                    </div>
                </div>
                <div class="dir-group">
                    <h4 class="dir-title">{t('nav.resources')}</h4>
                    <div class="dir-links-stack">
                        <a href={l('/archive')}>{t('nav.archive')}</a>
                        <a href={l('/briefing')}>{t('nav.briefing')}</a>
                        <a href={l('/for-you')}>{t('nav.for_you')}</a>
                        <a href={l('/settings')}>{t('nav.personalization')}</a>
                        <a href={l('/marketing')}>{t('nav.marketing')}</a>
                        <a href={l('/support')} class="font-black text-nyt-accent">{t('nav.support')}</a>
                    </div>
                </div>
                <div class="dir-group">
                    <h4 class="dir-title">{t('nav.contact')}</h4>
                    <div class="dir-links-stack">
                        <a href={l('/contact')}>{t('nav.contact')}</a>
                        <a href={l('/privacy')}>{t('nav.privacy')}</a>
                        <a href={l('/cookies')}>{t('nav.cookies')}</a>
                        <a href={l('/terms')}>{t('nav.terms')}</a>
                    </div>
                </div>
            </nav>
        </div>
    </div>

    <div class="footer-legal">
        <div class="legal-left">
            <p class="copyright mb-3">© {new Date().getFullYear()} PRESEK.{lang === 'mk' ? 'MK' : 'RS'} · {t('footer.copyright_suffix')}</p>
            <p class="legal-note font-sans text-[9px] text-muted-foreground uppercase tracking-widest opacity-80 max-w-3xl">
                {t('footer.legal_note')}
            </p>
        </div>
        <div class="legal-right">
            <a href="#top" class="scroll-top-premium">
                <span class="font-black">{t('nav.top')}</span>
                <div class="p-2 bg-foreground text-background">
                    <ArrowUpRight size={13} className="-rotate-45" />
                </div>
            </a>
        </div>
    </div>
</footer>

<style>
    .editorial-footer {
        padding-top: 4rem;
        padding-bottom: 4rem;
        margin-top: 4rem;
    }

    .footer-precision-rules {
        margin-bottom: 4rem;
    }
    .rule-thick {
        height: 4px;
        background: linear-gradient(90deg, var(--foreground) 0%, color-mix(in srgb, var(--foreground) 40%, var(--background)) 75%, transparent 100%);
        margin-bottom: 3px;
        border-radius: var(--radius-sm, 0px);
    }
    .rule-thin {
        height: 1px;
        background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: start;
    }

    .footer-left-col {
        padding-right: 2rem;
        border-right: 1px solid var(--border);
    }

    .footer-directory {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    @media (min-width: 1024px) {
        .footer-main {
            grid-template-columns: repeat(6, 1fr);
            gap: 4rem;
        }
        .footer-left-col {
            grid-column: span 2;
        }
        .footer-directory {
            grid-column: span 4;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            padding-left: 2rem;
        }
    }

    .brand-link { display: block; width: fit-content; }

    .dir-group {
        display: flex;
        flex-direction: column;
    }

    .dir-title {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--foreground);
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
    }

    .dir-links-stack {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .dir-group a {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 850;
        color: var(--muted-foreground);
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        width: fit-content;
        letter-spacing: 0.01em;
        position: relative;
    }

    .dir-group a:hover {
        color: var(--foreground);
        transform: translateX(6px);
    }

    .footer-system-pulse {
        background: linear-gradient(135deg, rgba(254, 252, 246, 0.75) 0%, rgba(246, 240, 228, 0.7) 100%);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
        border-radius: var(--radius-lg, 0px);
        box-shadow: 0 4px 20px -2px color-mix(in srgb, var(--background) 30%, rgba(0, 0, 0, 0.08)),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 6%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    :global(.dark) .footer-system-pulse {
        background: linear-gradient(135deg, rgba(22, 26, 41, 0.7) 0%, rgba(15, 18, 29, 0.65) 100%);
        border-color: color-mix(in srgb, var(--border) 80%, transparent);
        box-shadow: 0 8px 30px 0 rgba(0, 0, 0, 0.3),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
    }

    .footer-system-pulse:hover {
        border-color: color-mix(in srgb, var(--nyt-accent) 35%, var(--border));
        box-shadow: 0 12px 30px -4px color-mix(in srgb, var(--background) 40%, rgba(0, 0, 0, 0.16)),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 10%, transparent),
                    0 0 25px -4px color-mix(in srgb, var(--nyt-accent) 6%, transparent);
        transform: translateY(-2px);
    }

    .footer-legal {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .copyright {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 950;
        color: var(--foreground);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-indicator { width: 6px; height: 6px; border-radius: 50%; }
    .pulse-emerald { background: #10b981; box-shadow: 0 0 6px #10b981; animation: footer-pulse 2s infinite; }

    @keyframes footer-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.1); }
    }

    .scroll-top-premium {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--foreground);
        font-family: var(--font-sans);
        font-size: 0.55rem;
        letter-spacing: 0.15em;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .scroll-top-premium div {
        border-radius: 9999px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .scroll-top-premium:hover {
        color: var(--nyt-accent);
        transform: translateY(-3px);
    }

    .scroll-top-premium:hover div {
        background: var(--nyt-accent);
        color: white;
        transform: rotate(45deg) scale(1.1);
        box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--nyt-accent) 40%, transparent);
    }

    @media (max-width: 1024px) {
        .footer-main { grid-template-columns: 1fr; gap: 3rem; }
        .footer-directory { gap: 1.5rem; }
    }

    @media (max-width: 640px) {
        .editorial-footer { padding-top: 2.5rem; margin-top: 2.5rem; }
        .footer-top-border { margin-bottom: 2.5rem; }
        .footer-directory { grid-template-columns: repeat(2, 1fr); }
        .dir-group:last-child { grid-column: span 2; }
        .footer-legal { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    }
</style>
