---
import TinyAdzInlinedAd from './TinyAdzInlinedAd.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<TinyAdzInlinedAd class:list={['page-rail-ad', className]} />

<style>
  :global(.page-rail-ad) {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1179px) {
    :global(.page-rail-ad) {
      display: none;
    }
  }
</style>
