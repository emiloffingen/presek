---
const adKey = String(import.meta.env.PUBLIC_TOP_AD_KEY || '7fc6fdd34e30aa1a598c4d35b0b073b2').trim();
const adsEnabled = String(import.meta.env.PUBLIC_ENABLE_ADS ?? '1') !== '0' && Boolean(adKey);
---

{adsEnabled && (
  <aside class="top-ad-slot" aria-label="Advertisement">
    <span class="top-ad-label">Оглас</span>
    <div class="top-ad-creative">
      <script is:inline define:vars={{ adKey }}>
        window.atOptions = {
          key: adKey,
          format: 'iframe',
          height: 90,
          width: 728,
          params: {}
        };
      </script>
      <script type="text/javascript" src={`https://www.highperformanceformat.com/${adKey}/invoke.js`}></script>
    </div>
  </aside>
)}

<style>
  .top-ad-slot {
    display: none;
  }

  @media (min-width: 768px) {
    .top-ad-slot {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(100%, 760px);
      min-height: 112px;
      margin: 1rem auto 0.25rem;
      padding: 0 1rem;
      overflow: hidden;
    }

    .top-ad-label {
      margin-bottom: 0.35rem;
      font-family: var(--font-sans);
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    .top-ad-creative {
      width: 728px;
      height: 90px;
      max-width: 100%;
      overflow: hidden;
    }
  }
</style>
