---
import { buildTrustChip } from '../lib/trustSignals';
import { useTranslations } from '../i18n/utils';

interface Props {
  sourcesCount: number;
  pluralismScore?: number | null;
  isStale?: boolean;
  hasVerification?: boolean;
  lang?: 'sr' | 'mk';
  /** Feed cards: badge only. Cluster/detail views can opt into the popover. */
  showExplainer?: boolean;
  quietFreshness?: boolean;
  isPendingSynthesis?: boolean;
  isProvisional?: boolean;
  needsUpgrade?: boolean;
}

const {
  sourcesCount,
  pluralismScore = null,
  isStale = false,
  hasVerification = false,
  lang = 'sr',
  showExplainer = false,
  quietFreshness = false,
  isPendingSynthesis = false,
  isProvisional = false,
  needsUpgrade = false,
} = Astro.props;

const t = useTranslations(lang);

const trust = buildTrustChip(
  { sourcesCount, pluralismScore, isStale, hasVerification, quietFreshness, isPendingSynthesis, isProvisional, needsUpgrade },
  lang,
);

const pluralismLine = trust.pluralismScore == null
  ? null
  : trust.pluralismScore >= 55
    ? t('trust.plural_high', { score: trust.pluralismScore })
    : trust.pluralismScore <= 15
      ? t('trust.plural_low', { score: trust.pluralismScore })
      : t('trust.plural_mid', { score: trust.pluralismScore });
const freshnessLine = !isStale || quietFreshness ? null : t('trust.stale');
const verificationLine = hasVerification ? t('trust.verification') : null;
const explainerLines = [
  t('trust.sources_line', { count: trust.sourcesCount }),
  pluralismLine,
  freshnessLine,
  verificationLine,
].filter(Boolean);
---

{showExplainer && explainerLines.length > 0 ? (
  <details class={`trust-chip trust-chip--${trust.tier} trust-chip--explainer`}>
    <summary class="trust-chip-summary">
      <span class="trust-chip-score">{trust.score}</span>
      <span class="trust-chip-label">{trust.label}</span>
      <span class="trust-chip-meta">
        {trust.sourcesCount} {t('trust.sources_abbr')}
        {trust.pluralismScore != null ? ` · ${trust.pluralismScore}%` : ''}
      </span>
    </summary>
    <div class="trust-chip-popover" role="note">
      <span class="trust-chip-popover-eyebrow">{t('trust.explainer_title')}</span>
      <div class="trust-chip-scoreline">
        <span class="trust-chip-scoreline-value">{trust.score}</span>
        <span class="trust-chip-scoreline-max">/100</span>
        <span class="trust-chip-scoreline-tier">{trust.label}</span>
      </div>
      <div class="trust-chip-breakdown">
        {trust.breakdown.map((item) => (
          <div class="trust-chip-breakdown-row">
            <span class="trust-chip-breakdown-label">{item.label}</span>
            <span class="trust-chip-breakdown-track" aria-hidden="true">
              <span class="trust-chip-breakdown-fill" style={`width:${(item.points / item.max) * 100}%`}></span>
            </span>
            <span class="trust-chip-breakdown-points">{item.points}</span>
          </div>
        ))}
      </div>
      {explainerLines.length > 0 && (
        <div class="trust-chip-notes">
          {explainerLines.map((line) => <span>{line}</span>)}
        </div>
      )}
      <span class="trust-chip-capped">{t('trust.capped')}</span>
    </div>
  </details>
) : (
  <span class={`trust-chip trust-chip--${trust.tier}`} title={trust.detail}>
    <span class="trust-chip-score">{trust.score}</span>
    <span class="trust-chip-label">{trust.label}</span>
    <span class="trust-chip-meta">
      {trust.sourcesCount} {t('trust.sources_abbr')}
      {trust.pluralismScore != null ? ` · ${trust.pluralismScore}%` : ''}
    </span>
  </span>
)}

<style>
  .trust-chip,
  .trust-chip-summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--secondary) 55%, transparent);
    font-family: var(--font-sans);
    line-height: 1;
    max-width: 100%;
    list-style: none;
    cursor: default;
  }
  .trust-chip-summary::-webkit-details-marker {
    display: none;
  }
  .trust-chip--explainer .trust-chip-summary {
    cursor: pointer;
  }
  /* Bridge the gap between chip and popover so the pointer can cross it
     without losing :hover (the popover is a child, so hovering it keeps
     the ancestor :hover active — only the empty gap breaks it). */
  .trust-chip--explainer .trust-chip-summary::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 0.7rem;
  }
  .trust-chip--explainer:focus-visible,
  .trust-chip-summary:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--nyt-accent) 70%, transparent);
    outline-offset: 2px;
  }
  .trust-chip-score {
    font-size: 0.64rem;
    font-weight: 900;
    color: var(--nyt-accent);
    font-variant-numeric: tabular-nums;
  }
  .trust-chip-label {
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--foreground);
  }
  .trust-chip-meta {
    font-size: 0.56rem;
    font-weight: 700;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .trust-chip--early { border-color: color-mix(in srgb, var(--muted-foreground) 35%, transparent); }
  .trust-chip--consensus { border-color: color-mix(in srgb, #10b981 35%, transparent); }
  .trust-chip--plural { border-color: color-mix(in srgb, #f59e0b 35%, transparent); }
  .trust-chip--verified { border-color: color-mix(in srgb, var(--nyt-accent) 35%, transparent); }
  .trust-chip-popover {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.45rem);
    z-index: 40;
    display: grid;
    gap: 0.25rem;
    width: min(18rem, 84vw);
    max-height: min(60vh, 24rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.7rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--popover, var(--background)) 96%, transparent);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.25rem);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .trust-chip-popover-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .trust-chip-scoreline {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-top: 0.15rem;
  }
  .trust-chip-scoreline-value {
    font-size: 1.6rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--nyt-accent);
    line-height: 1;
  }
  .trust-chip-scoreline-max {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }
  .trust-chip-scoreline-tier {
    margin-left: auto;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nyt-accent) 12%, transparent);
    color: var(--nyt-accent);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .trust-chip-breakdown {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .trust-chip-breakdown-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, 1fr) 2fr 1.6rem;
    align-items: center;
    gap: 0.5rem;
  }
  .trust-chip-breakdown-label {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .trust-chip-breakdown-track {
    height: 0.32rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
    overflow: hidden;
  }
  .trust-chip-breakdown-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--nyt-accent), color-mix(in srgb, var(--nyt-accent) 55%, #10b981));
  }
  .trust-chip-breakdown-points {
    font-size: 0.66rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    text-align: right;
  }
  .trust-chip-notes {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 8%, transparent);
    font-size: 0.64rem;
    color: var(--muted-foreground);
  }
  .trust-chip-capped {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.58rem;
    color: var(--muted-foreground);
    opacity: 0.8;
  }
  @media (hover: hover) {
    .trust-chip--explainer:hover .trust-chip-popover,
    .trust-chip--explainer[open] .trust-chip-popover {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
  @media (hover: none) {
    .trust-chip--explainer[open] .trust-chip-popover {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
</style>
