---
import { ClientRouter } from 'astro:transitions';
import { safeJsonForScript } from '../../lib/safeJson';
import sourceSerif400Url from '@fontsource/source-serif-4/files/source-serif-4-cyrillic-400-normal.woff2?url';
import notoSerif900Url from '@fontsource/noto-serif/files/noto-serif-cyrillic-900-normal.woff2?url';

interface Props {
  lang: 'sr' | 'mk';
  siteName: string;
  pageTitle: string;
  description: string;
  canonicalUrl: string;
  imageUrl: string;
  type: string;
  robots?: string;
  image: string;
  imageSrcset?: string;
  imageSizes?: string;
  schema?: object;
  organizationSchema: object;
  cspNonce: string;
  gtagId: string;
}

const {
  lang,
  siteName,
  pageTitle,
  description,
  canonicalUrl,
  imageUrl,
  type,
  robots,
  image,
  imageSrcset,
  imageSizes,
  schema,
  organizationSchema,
  cspNonce,
  gtagId,
} = Astro.props;

const ClientRouterAny = ClientRouter as any;
---

{/* charset must be within the first 1024 bytes of the document (HTML spec); keep it first. */}
<meta charset="UTF-8" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="preload" as="font" type="font/woff2" href={sourceSerif400Url} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={notoSerif900Url} crossorigin="anonymous" />
<script is:inline nonce={cspNonce} define:vars={{ gtagId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'wait_for_update': 500
  });
  gtag('js', new Date());
  gtag('config', gtagId, { 'anonymize_ip': true });

  // gtag.js is ~180 KB and ~350 ms of main-thread work, and it competes with the hero image and
  // CSS for bandwidth. The calls above queue on dataLayer, so the library can arrive late
  // without losing them: load it once the page is done, or on the first interaction.
  (function () {
    if (window.__gtagLoader) return; // view transitions re-run head scripts
    window.__gtagLoader = true;
    var started = false;
    function load() {
      if (started) return;
      started = true;
      var el = document.createElement('script');
      el.async = true;
      el.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gtagId);
      document.head.appendChild(el);
    }
    function whenIdle() {
      if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 4000 });
      else setTimeout(load, 2500);
    }
    ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (type) {
      window.addEventListener(type, load, { once: true, passive: true });
    });
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  })();
</script>
<script is:inline src="/js/presek-boot.js?v=2"></script>

<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=6" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/img/icons/presek-apple-touch.png?v=3" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={siteName} />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="mk-MK" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />

{image && !image.includes('presek_emblem') && (
  <link rel="preload" as="image" href={imageUrl} imagesrcset={imageSrcset} imagesizes={imageSrcset ? imageSizes : undefined} fetchpriority="high" />
)}

<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="mk_MK" />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@presek_mk" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<title>{pageTitle}</title>

<ClientRouterAny nonce={cspNonce} />

{schema && (
  <script type="application/ld+json" is:inline set:html={safeJsonForScript(schema)} nonce={cspNonce} />
)}
<script type="application/ld+json" is:inline set:html={safeJsonForScript(organizationSchema)} nonce={cspNonce} />
