---
import { ClientRouter } from 'astro:transitions';
import { safeJsonForScript } from '../../lib/safeJson';

interface Props {
  lang: 'sr' | 'mk';
  siteName: string;
  pageTitle: string;
  description: string;
  canonicalUrl: string;
  imageUrl: string;
  srHref: string;
  mkHref: string;
  type: string;
  robots?: string;
  image: string;
  schema?: object;
  organizationSchema: object;
  cspNonce: string;
  gtagId: string;
}

const {
  lang,
  siteName,
  pageTitle,
  description,
  canonicalUrl,
  imageUrl,
  srHref,
  mkHref,
  type,
  robots,
  image,
  schema,
  organizationSchema,
  cspNonce,
  gtagId,
} = Astro.props;

const ClientRouterAny = ClientRouter as any;
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`} nonce={cspNonce}></script>
<script is:inline nonce={cspNonce} define:vars={{ gtagId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'wait_for_update': 500
  });
  gtag('js', new Date());
  gtag('config', gtagId, { 'anonymize_ip': true });
</script>
<script is:inline src="/js/presek-boot.js?v=2"></script>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=4" />
<link rel="apple-touch-icon" href="/img/icons/presek-apple-touch.png?v=1" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={siteName} />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="sr-Latn-RS" href={srHref} />
<link rel="alternate" hreflang="mk-MK" href={mkHref} />
<link rel="alternate" hreflang="x-default" href={srHref} />

{image && !image.includes('presek_emblem') && (
  <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />
)}

<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'sr' ? 'sr_RS' : 'mk_MK'} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@presek_rs" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<title>{pageTitle}</title>

<ClientRouterAny nonce={cspNonce} />

{schema && (
  <script type="application/ld+json" is:inline set:html={safeJsonForScript(schema)} nonce={cspNonce} />
)}
<script type="application/ld+json" is:inline set:html={safeJsonForScript(organizationSchema)} nonce={cspNonce} />
