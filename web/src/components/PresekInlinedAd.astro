---
import NativeAdSlot from './NativeAdSlot.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const lang = getLangFromUrl(requestUrl, hostHeader);

// Exclude ad-free pages
const adFreePaths = ['/marketing', '/mk/marketing'];
const showAd = !adFreePaths.some(p => requestUrl.pathname.endsWith(p));
---

{showAd && <NativeAdSlot slotId="mobile_content" class={className} />}
