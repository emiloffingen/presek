---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
    stats: any;
    lang?: string;
}

const { stats } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = (Astro.props.lang || urlLang) as 'sr' | 'mk';
const t = useTranslations(lang);
const pulsePath = localePath('/pulse', lang, hostHeader);

if (!stats) return null;

const feeds = stats.total_feeds || 0;
const last24h = stats.last_24h || 0;
---

<p class="home-stats-teaser">
    <span>{feeds} {t('home.stats_media')}</span>
    <span class="home-stats-dot">·</span>
    <span>{last24h} {t('home.stats_posts_24h')}</span>
    <span class="home-stats-dot">·</span>
    <a href={pulsePath} class="home-stats-link">{t('home.stats_open_pulse')}</a>
</p>
