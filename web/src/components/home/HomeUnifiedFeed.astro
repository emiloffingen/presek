---
import NewsCard from '../NewsCard.astro';
import TinyAdzInlinedAd from '../TinyAdzInlinedAd.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { UnifiedFeedItem } from '../../lib/unifiedFeed';
import { countFeedBuckets } from '../../lib/unifiedFeed';

interface Props {
    items: UnifiedFeedItem[];
    lang?: string;
    adInsertAfter?: number;
}

const { items, lang: propLang, adInsertAfter = 0 } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = (propLang === 'mk' || propLang === 'sr' ? propLang : getLangFromUrl(Astro.url, hostHeader)) as 'sr' | 'mk';
const t = useTranslations(lang);
const counts = countFeedBuckets(items);
const filterItems = [
    { key: 'all', label: t('home.feed_summary_total'), value: counts.all },
    { key: 'developing', label: t('home.feed_summary_developing'), value: counts.developing },
    { key: 'global', label: t('home.feed_summary_global'), value: counts.global },
    { key: 'wire', label: t('home.feed_summary_wire'), value: counts.wire },
].filter((item) => item.key === 'all' || item.value > 0);

function getBentoSpan(cluster: UnifiedFeedItem['cluster']) {
    const count = Number((cluster as any).sources_count || (cluster as any).source_count || cluster.articles?.length || 0);
    const importanceScore = cluster.importance_score || 0;
    if (count >= 6 || importanceScore > 0.85) return '2x2';
    if (count >= 4 || importanceScore > 0.65) return '2x1';
    return '1x1';
}
---

{items.length > 0 && (
    <section class="home-unified-feed motion-rise" data-home-unified-feed data-active-feed-filter="all">
        <div class="home-unified-feed-header">
            <div class="home-unified-feed-toolbar">
                <h2 class="home-unified-feed-title">{t('home.feed_title')}</h2>
                <div class="home-feed-filter" role="tablist" aria-label={t('home.feed_filter_label')} data-home-feed-filter>
                    {filterItems.map((item) => (
                        <button
                            type="button"
                            role="tab"
                            class:list={['home-feed-filter-btn', `is-${item.key}`, { 'is-active': item.key === 'all' }]}
                            data-feed-filter={item.key}
                            aria-selected={item.key === 'all' ? 'true' : 'false'}
                        >
                            <span>{item.label}</span>
                            <span class="home-feed-filter-count">{item.value}</span>
                        </button>
                    ))}
                </div>
            </div>
        </div>

        <div class="home-unified-feed-grid">
            {items.map((item, idx) => {
                const span = item.variant === 'featured' ? getBentoSpan(item.cluster) : '1x1';
                const showMidFeedAd = adInsertAfter > 0 && idx === adInsertAfter;
                return (
                    <>
                        {showMidFeedAd && (
                            <div class="home-feed-ad-break">
                                <TinyAdzInlinedAd class="home-inline-ad home-inline-ad--mid-feed" />
                            </div>
                        )}
                    <div
                        class:list={[
                            'home-feed-item',
                            `home-feed-item--${item.variant}`,
                            item.variant === 'featured' ? `bento-${span}` : '',
                            { 'home-feed-item--synthesis': Boolean(item.cluster.has_synthesis) },
                        ]}
                        data-feed-bucket={item.bucket}
                        style={`animation-delay: ${idx * 0.05}s`}
                    >
                        {item.cluster.has_synthesis && (
                            <span class="home-feed-synthesis-badge ui-status">{t('home.feed_synthesis_badge')}</span>
                        )}
                        {item.variant === 'wire' ? (
                            <NewsCard cluster={item.cluster} variant="wire" lang={lang} />
                        ) : item.variant === 'featured' ? (
                            <NewsCard cluster={item.cluster} variant="featured" bentoSpan={span} lang={lang} />
                        ) : (
                            <NewsCard cluster={item.cluster} variant="compact" lang={lang} />
                        )}
                    </div>
                    </>
                );
            })}
        </div>
    </section>
)}

<script is:inline>
    (function bindHomeFeedFilter() {
        const applyFilter = (root, filter) => {
            const active = filter || 'all';
            root.setAttribute('data-active-feed-filter', active);
            root.querySelectorAll('[data-feed-filter]').forEach((button) => {
                const selected = button.getAttribute('data-feed-filter') === active;
                button.classList.toggle('is-active', selected);
                button.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
            root.querySelectorAll('[data-feed-bucket]').forEach((item) => {
                const bucket = item.getAttribute('data-feed-bucket');
                const visible = active === 'all' || bucket === active;
                item.classList.toggle('is-filtered-out', !visible);
                item.setAttribute('aria-hidden', visible ? 'false' : 'true');
            });
        };

        const bind = () => {
            document.querySelectorAll('[data-home-unified-feed]').forEach((root) => {
                const filterBar = root.querySelector('[data-home-feed-filter]');
                if (!filterBar || filterBar.dataset.bound) return;
                filterBar.dataset.bound = '1';
                filterBar.querySelectorAll('[data-feed-filter]').forEach((button) => {
                    button.addEventListener('click', () => {
                        applyFilter(root, button.getAttribute('data-feed-filter'));
                    });
                });
            });
        };

        bind();
        document.addEventListener('astro:page-load', bind);
    })();
</script>
