---
/**
 * SourceComparisonPanel — the transparency-first block under the lead story.
 *
 * Instead of presenting the lead as a single outlet's story, this shows WHICH
 * sources covered it and how their framing differs. Data comes entirely from
 * the cluster:
 *   - trust_summary  -> score / tier label / detail / sources_count
 *   - cluster.articles[].source + summary|description -> the per-source rows
 *   - reading_time   -> reading estimate
 *
 * Everything is optional; if a field is missing the row is simply omitted, so
 * the panel degrades gracefully instead of showing empty scaffolding.
 */
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { buildSourceRows, buildTrustView, hasComparisonContent } from '../../lib/sourceComparison';

interface Props {
    cluster: NewsCluster;
    lang?: string;
}

const { cluster, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = propLang || getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang as 'sr' | 'mk');

const sourceRows = buildSourceRows(cluster);
const trust = buildTrustView(cluster, sourceRows.length);
const score = trust.score;
const verdictLabel = trust.label;
const readingTime = Number(cluster.reading_time || 0);

const showPanel = hasComparisonContent(cluster);
const hasVerdict = Boolean(verdictLabel) && score !== null;
---

{showPanel && (
    <aside class="source-compare" aria-label={t('compare.heading')}>
        <div class="source-compare__head">
            <span>{t('compare.heading')}</span>
            <span class="source-compare__updated">{t('compare.updated')}</span>
        </div>

        {hasVerdict && (
            <div
                class={`source-compare__verdict source-compare__verdict--${trust.tier}`}
            >
                <span class="source-compare__score" aria-label={`${score} / 100`}>{score}</span>
                <span class="source-compare__label">
                    <span class="source-compare__label-text">{verdictLabel}</span>
                    <span class="source-compare__detail">
                        {`${trust.sourcesCount} ${t('compare.verdict_suffix')}${trust.detail ? ` · ${trust.detail}` : ''}`}
                    </span>
                </span>
            </div>
        )}

        {sourceRows.length > 0 && (
            <ul class="source-compare__sources">
                {sourceRows.map((row) => (
                    <li class="source-compare__row">
                        <span class="source-compare__source">{row.name}</span>
                        {row.framing && <span class="source-compare__framing">{row.framing}</span>}
                    </li>
                ))}
            </ul>
        )}

        <div class="source-compare__metrics">
            <div>
                <b>{trust.sourcesCount}</b>
                <span>{t('compare.sources')}</span>
            </div>
            {score !== null && (
                <div>
                    <b>{score}</b>
                    <span>{t('compare.trust')}</span>
                </div>
            )}
            {readingTime > 0 && (
                <div>
                    <b>{`${readingTime} ${t('compare.minutes_short')}`}</b>
                    <span>{t('compare.reading')}</span>
                </div>
            )}
        </div>
    </aside>
)}

<style>
    .source-compare {
        border: 1px solid var(--border);
        border-top: 3px solid var(--foreground);
        background: var(--card);
        padding: 0.85rem 1rem 0.95rem;
        font-family: var(--font-ui);
    }
    .source-compare__head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        font-size: 0.625rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin-bottom: 0.65rem;
    }
    .source-compare__updated {
        letter-spacing: 0;
        text-transform: none;
        font-size: 0.62rem;
        white-space: nowrap;
    }
    .source-compare__verdict {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        margin-bottom: 0.7rem;
    }
    .source-compare__score {
        flex: none;
        white-space: nowrap;
        overflow-wrap: normal;
        word-break: normal;
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1;
        color: #1c6b3f;
        font-variant-numeric: tabular-nums;
    }
    .source-compare__verdict--divergence .source-compare__score {
        color: #b23a34;
    }
    .source-compare__verdict--mixed .source-compare__score {
        color: #b8862b;
    }
    .source-compare__label {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        line-height: 1.3;
    }
    .source-compare__label-text {
        font-size: 0.82rem;
        font-weight: 700;
        color: #245c3a;
    }
    .source-compare__verdict--divergence .source-compare__label-text {
        color: #8f2f2a;
    }
    .source-compare__verdict--mixed .source-compare__label-text {
        color: #8a6416;
    }
    .source-compare__detail {
        font-size: 0.72rem;
        font-weight: 400;
        color: var(--muted-foreground);
    }
    .source-compare__sources {
        list-style: none;
        margin: 0.15rem 0 0;
        padding: 0;
    }
    .source-compare__row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.34rem 0;
        border-top: 1px dotted var(--border);
        font-size: 0.78rem;
    }
    .source-compare__source {
        font-weight: 700;
        white-space: nowrap;
        flex: 0 0 auto;
    }
    .source-compare__framing {
        color: var(--muted-foreground);
        text-align: right;
        font-size: 0.72rem;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
    .source-compare__metrics {
        display: flex;
        margin-top: 0.7rem;
        border-top: 1px solid var(--border);
        padding-top: 0.6rem;
    }
    .source-compare__metrics > div {
        flex: 1;
        text-align: center;
        border-right: 1px solid var(--border);
        padding: 0 0.25rem;
    }
    .source-compare__metrics > div:last-child {
        border-right: 0;
    }
    .source-compare__metrics b {
        display: block;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }
    .source-compare__metrics span {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.58rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }
</style>
