---
import '../../styles/home-live-strip.css';
import { Activity, ChevronRight } from 'lucide-react';
import { getDisplayTitle } from '../../utils/textUtils';
import { useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';
import type { ui } from '../../i18n/ui';

interface Props {
    articles: any[];
    getTimeStr: (date: string) => string;
    lang: keyof typeof ui;
}

const { articles, getTimeStr, lang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
const expandLabel = lang === 'sr' ? 'Prikaži' : 'Прикажи';

const wireItems = articles.map((article: any) => ({
    href: l(`/cluster/${article.cluster_id}`),
    time: getTimeStr(article.ingested_at || article.created_at),
    source: article.source || '',
    title: getDisplayTitle(article),
}));
const wireTeaser = wireItems[0]?.title || '';
---

{articles.length > 0 && (
    <details class="home-live-details" data-live-strip>
        <summary class="home-live-summary" aria-label={t('home.wire_title')}>
            <span class="home-live-summary-label">
                <Activity size={13} />
                <span class="home-live-summary-copy">
                    <span class="home-live-summary-title">{t('home.wire_title')}</span>
                    {wireTeaser && <span class="home-live-summary-teaser">{lang === 'sr' ? 'Prvo:' : 'Прво:'} {wireTeaser}</span>}
                </span>
            </span>
            <span class="home-live-summary-meta">
                <span class="home-live-count">{articles.length}</span>
                <span class="home-live-expand">{expandLabel}</span>
            </span>
        </summary>
        <section class="home-live-strip" aria-label={t('home.wire_title')}>
            <div class="home-live-head">
                <span>
                    <Activity size={13} />
                    {t('home.wire_title')}
                </span>
                <a href={l('/archive')}>
                    {t('rail.all_news')} <ChevronRight size={11} />
                </a>
            </div>
            <div class="home-live-items hide-scrollbar" data-live-mount></div>
        </section>
    </details>
)}

<script is:inline define:vars={{ wireItems }}>
    (() => {
        const root = document.querySelector('[data-live-strip]');
        if (!root || !Array.isArray(wireItems) || wireItems.length === 0) return;

        const mount = root.querySelector('[data-live-mount]');
        if (!mount) return;

        const paint = () => {
            if (mount.dataset.ready === '1') return;
            mount.dataset.ready = '1';
            const frag = document.createDocumentFragment();

            for (const item of wireItems) {
                const link = document.createElement('a');
                link.href = item.href;
                link.className = 'home-live-item';

                const meta = document.createElement('div');
                meta.className = 'home-live-meta';

                const time = document.createElement('span');
                time.textContent = item.time || '';

                const source = document.createElement('strong');
                source.textContent = item.source || '';

                meta.append(time, source);

                const title = document.createElement('p');
                title.textContent = item.title || '';

                link.append(meta, title);
                frag.appendChild(link);
            }

            mount.appendChild(frag);
        };

        const maybePaint = () => {
            if (root.open) paint();
        };

        root.addEventListener('toggle', maybePaint);

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    maybePaint();
                    observer.disconnect();
                }
            }, { rootMargin: '160px' });
            observer.observe(root);
        }
    })();
</script>
