---
import '../../styles/home-live-strip.css';
import { Activity, ChevronRight } from 'lucide-react';
import { getDisplayTitle } from '../../utils/textUtils';
import { useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';
import type { ui } from '../../i18n/ui';

interface Props {
    articles: any[];
    getTimeStr: (date: string) => string;
    lang: keyof typeof ui;
}

const { articles, getTimeStr, lang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
const expandLabel = lang === 'sr' ? 'Otvori' : 'Отвори';
---

{articles.length > 0 && (
    <details class="home-live-details">
        <summary class="home-live-summary" aria-label={t('home.wire_title')}>
            <span class="home-live-summary-label">
                <Activity size={13} />
                {t('home.wire_title')}
            </span>
            <span class="home-live-summary-meta">
                <span class="home-live-count">{articles.length}</span>
                <span class="home-live-expand">{expandLabel}</span>
            </span>
        </summary>
        <section class="home-live-strip" aria-label={t('home.wire_title')}>
            <div class="home-live-head">
                <span>
                    <Activity size={13} />
                    {t('home.wire_title')}
                </span>
                <a href={l('/archive')}>
                    {t('rail.all_news')} <ChevronRight size={11} />
                </a>
            </div>
            <div class="home-live-items hide-scrollbar">
                {articles.map((article: any) => (
                    <a href={l(`/cluster/${article.cluster_id}`)} class="home-live-item">
                        <div class="home-live-meta">
                            <span>{getTimeStr(article.ingested_at || article.created_at)}</span>
                            <strong>{article.source}</strong>
                        </div>
                        <p>{getDisplayTitle(article)}</p>
                    </a>
                ))}
            </div>
        </section>
    </details>
)}
