---
import { sanitizeHtml } from '../../lib/sanitize';

interface Props {
    content: string;
    date: string;
}

const { content, date } = Astro.props;

// Parse the content if it's markdown or has specific sections
function parseBriefing(text: string) {
    if (!text) return null;

    // Split by ## sections
    const sections = text.split(/(?=## )/);
    const parsed: Record<string, { lines: string[], isKey?: boolean }> = {};

    let currentSection = 'intro';

    sections.forEach(section => {
        const lines = section.trim().split('\n');
        const titleLine = lines[0];

        if (titleLine.startsWith('## ')) {
            const sectionName = titleLine.replace('## ', '').trim();
            const isKey = sectionName.toLowerCase().includes('klucno') || sectionName.toLowerCase().includes('puls');
            parsed[sectionName] = {
                lines: lines.slice(1).map(l => l.trim()).filter(Boolean),
                isKey
            };
        } else {
            if (!parsed['intro']) parsed['intro'] = { lines: [] };
            parsed['intro'].lines.push(...lines.map(l => l.trim()).filter(Boolean));
        }
    });

    return parsed;
}

const briefingData = parseBriefing(content);

function formatDate(dateStr: string) {
    try {
        const d = new Date(dateStr.replace("Z", ""));
        return d.toLocaleDateString('sr-RS', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    } catch {
        return dateStr;
    }
}
---

{content && (
    <section class="editorial-briefing motion-rise">
        <div class="briefing-header">
            <div class="kicker briefing-kicker">
                <span class="live-dot"></span>
                {Astro.url.pathname.includes('/mk') ? 'Уреднички брифинг' : 'Urednički brifing'}
            </div>
            <h2 class="briefing-date">{formatDate(date)}</h2>
            
            <!-- Glassmorphic Audio Briefing Player -->
            <div class="briefing-audio-player mt-6" data-date={date} data-lang={Astro.url.pathname.includes('/mk') ? 'mk' : 'sr'}>
                <button class="audio-play-btn" aria-label="Slušaj brifing">
                    <span class="play-icon">▶</span>
                    <span class="pause-icon hidden">❚❚</span>
                    <span class="loading-spinner hidden"></span>
                </button>
                <div class="audio-info-wrap">
                    <span class="audio-title">{Astro.url.pathname.includes('/mk') ? 'Слушај го аудио брифингот (АИ Глас)' : 'Slušaj audio brifing (AI Glas)'}</span>
                    <div class="audio-progress-bar">
                        <div class="audio-progress-fill" style="width: 0%"></div>
                    </div>
                </div>
                <span class="audio-duration">0:00</span>
                <audio class="hidden briefing-audio-element" preload="none"></audio>
            </div>
        </div>

        <div class="briefing-content">
            {briefingData && Object.entries(briefingData).map(([section, data]) => (
                <div class:list={["briefing-section", { "is-key-section": data.isKey }]}>
                    <span class="section-label">{section}</span>
                    <div class="section-body mt-4">
                        {data.lines.map(line => {
                            if (line.startsWith('### ')) {
                                return <h4 class="story-title" set:html={sanitizeHtml(line.replace('### ', ''))}></h4>;
                            }
                            if (line.startsWith('- ') || line.startsWith('• ')) {
                                return <div class="story-detail-wrap">
                                    <span class="detail-bullet"></span>
                                    <p class="story-detail" set:html={sanitizeHtml(line.substring(2))}></p>
                                </div>;
                            }
                            return <p class="briefing-text" set:html={sanitizeHtml(line)}></p>;
                        })}
                    </div>
                </div>
            ))}
        </div>

        <div class="briefing-footer">
            <p>Generisano uz pomoć Presek Sistemska Sinteza • Bazirano na današnje vodeće klastere</p>
        </div>
    </section>
)}

<style>
    .editorial-briefing {
        margin-bottom: 3.5rem;
        padding: clamp(1.5rem, 4vw, 3rem);
        background: linear-gradient(135deg, rgba(254, 252, 246, 0.96) 0%, rgba(246, 240, 228, 0.93) 100%);
        background-image: radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--nyt-accent) 4%, transparent), transparent 60%);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
        border-radius: 16px;
        position: relative;
        box-shadow: 0 10px 40px -8px color-mix(in srgb, var(--background) 50%, rgba(0, 0, 0, 0.12)), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 8%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
    }

    .editorial-briefing::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 5px;
        background: linear-gradient(180deg, var(--nyt-accent) 0%, color-mix(in srgb, var(--nyt-accent) 45%, var(--foreground)) 100%);
    }

    .editorial-briefing:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--nyt-accent) 35%, var(--border));
        box-shadow: 0 20px 50px -12px color-mix(in srgb, var(--background) 60%, rgba(0, 0, 0, 0.22)), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 12%, transparent), 
                    0 0 30px -5px color-mix(in srgb, var(--nyt-accent) 8%, transparent);
    }

    .dark .editorial-briefing {
        background: linear-gradient(135deg, rgba(22, 26, 41, 0.9) 0%, rgba(15, 18, 29, 0.85) 100%);
        background-image: radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--nyt-accent) 5%, transparent), transparent 70%);
        box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.4), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 6%, transparent);
    }

    .briefing-header {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-bottom: 2.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        padding-bottom: 1.25rem;
    }

    .briefing-kicker {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.5rem;
    }

    .live-dot {
        width: 9px;
        height: 9px;
        background-color: var(--nyt-accent);
        border-radius: 50%;
        display: inline-block;
        position: relative;
        box-shadow: 0 0 12px 2px color-mix(in srgb, var(--nyt-accent) 50%, transparent);
    }

    .live-dot::after {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        border-radius: 50%;
        border: 1px solid var(--nyt-accent);
        opacity: 0.8;
        animation: double-ping-ring 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    @keyframes double-ping-ring {
        0% {
            transform: scale(0.9);
            opacity: 0.9;
        }
        100% {
            transform: scale(2.2);
            opacity: 0;
        }
    }

    .briefing-date {
        font-family: var(--font-serif);
        font-size: var(--text-3xl);
        font-weight: 900;
        font-style: italic;
        margin: 0;
        letter-spacing: -0.01em;
        background: linear-gradient(135deg, var(--foreground) 75%, var(--nyt-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .briefing-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
    }

    @media (min-width: 768px) {
        .briefing-content {
            grid-template-columns: repeat(2, 1fr);
        }

        .is-key-section {
            grid-column: span 2;
            background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--nyt-accent) 6%, transparent), transparent 75%);
            border: 1px solid color-mix(in srgb, var(--nyt-accent) 15%, transparent);
            border-radius: 12px;
            padding: 1.75rem 2.25rem 2.25rem;
            box-shadow: inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
            transition: all 0.3s var(--ease-editorial);
        }

        .is-key-section:hover {
            background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--nyt-accent) 10%, transparent), transparent 70%);
            border-color: color-mix(in srgb, var(--nyt-accent) 30%, transparent);
            transform: translateY(-1px);
        }
    }

    .section-label {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--nyt-accent);
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
        border-radius: 4px;
        transition: all 0.3s var(--ease-editorial);
    }

    .is-key-section .section-label {
        border-color: color-mix(in srgb, var(--nyt-accent) 40%, transparent);
        background: color-mix(in srgb, var(--nyt-accent) 12%, transparent);
    }

    .briefing-text {
        font-family: var(--font-nyt-body);
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--foreground);
        margin: 0 0 1.25rem 0;
    }

    .story-title {
        font-family: var(--font-serif);
        font-size: 1.45rem;
        font-weight: 900;
        line-height: 1.2;
        margin: 1.5rem 0 0.85rem 0;
        color: var(--foreground);
        letter-spacing: -0.02em;
    }

    .story-detail-wrap {
        display: flex;
        gap: 0.95rem;
        margin-bottom: 1.15rem;
        position: relative;
        padding-left: 0.25rem;
        transition: all 0.3s var(--ease-editorial);
    }

    .story-detail-wrap:hover {
        transform: translateX(4px);
    }

    .detail-bullet {
        width: 6px;
        height: 6px;
        background: var(--nyt-accent);
        transform: rotate(45deg);
        margin-top: 0.65rem;
        flex-shrink: 0;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-detail-wrap:hover .detail-bullet {
        transform: rotate(135deg) scale(1.25);
        background: var(--foreground);
        box-shadow: 0 0 8px color-mix(in srgb, var(--foreground) 30%, transparent);
    }

    .story-detail {
        font-family: var(--font-nyt-body);
        font-size: 0.98rem;
        line-height: 1.6;
        color: var(--secondary-foreground);
        margin: 0;
        transition: color 0.3s var(--ease-editorial);
    }

    .story-detail-wrap:hover .story-detail {
        color: var(--foreground);
    }

    .briefing-footer {
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted-foreground);
        opacity: 0.6;
    }

    @media (max-width: 640px) {
        .editorial-briefing { 
            padding: 1.5rem; 
        }
        .editorial-briefing::before {
            width: 4px;
        }
        .briefing-header { margin-bottom: 2rem; }
        .briefing-content { gap: 2rem; }
        .story-title { font-size: 1.25rem; }
        .briefing-date { font-size: 1.75rem; }
    }

    /* ── Briefing Audio Player Styling ── */
    .briefing-audio-player {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.03);
        max-width: 28rem;
        transition: all 0.3s var(--ease-editorial);
    }
    
    .dark .briefing-audio-player {
        background: rgba(0, 0, 0, 0.2);
        border-color: rgba(255, 255, 255, 0.05);
    }
    
    .briefing-audio-player:hover {
        border-color: color-mix(in srgb, var(--nyt-accent) 40%, transparent);
        box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
        background: rgba(255, 255, 255, 0.6);
    }
    
    .dark .briefing-audio-player:hover {
        background: rgba(0, 0, 0, 0.3);
    }

    .audio-play-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--nyt-accent);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(197, 160, 89, 0.3);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .audio-play-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 15px rgba(197, 160, 89, 0.45);
        background: color-mix(in srgb, var(--nyt-accent) 90%, black);
    }

    .audio-play-btn:active {
        transform: scale(0.95);
    }

    .play-icon {
        font-size: 0.8rem;
        margin-left: 2px;
    }

    .pause-icon {
        font-size: 0.75rem;
    }

    .audio-info-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .audio-title {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--foreground);
    }

    .audio-progress-bar {
        height: 4px;
        background: color-mix(in srgb, var(--foreground) 10%, transparent);
        border-radius: 2px;
        overflow: hidden;
        cursor: pointer;
        position: relative;
    }

    .audio-progress-fill {
        height: 100%;
        background: var(--nyt-accent);
        border-radius: 2px;
        transition: width 0.1s linear;
    }

    .audio-duration {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--muted-foreground);
        min-width: 2.2rem;
        text-align: right;
    }

    .loading-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const player = document.querySelector('.briefing-audio-player');
        if (!player) return;

        const playBtn = player.querySelector('.audio-play-btn');
        const playIcon = player.querySelector('.play-icon');
        const pauseIcon = player.querySelector('.pause-icon');
        const spinner = player.querySelector('.loading-spinner');
        const progressFill = player.querySelector('.audio-progress-fill');
        const progressBar = player.querySelector('.audio-progress-bar');
        const durationLabel = player.querySelector('.audio-duration');
        const audio = player.querySelector('.briefing-audio-element');

        const date = player.getAttribute('data-date');
        const lang = player.getAttribute('data-lang');

        let isLoaded = false;
        let isLoading = false;

        async function loadAndPlay() {
            if (isLoading) return;
            isLoading = true;

            // Show spinner
            playIcon.classList.add('hidden');
            pauseIcon.classList.add('hidden');
            spinner.classList.remove('hidden');

            try {
                const apiBase = window.location.origin;
                const response = await fetch(`${apiBase}/api/intelligence/briefing/audio?date=${date}&lang=${lang}`);
                const data = await response.json();

                if (data.status === 'success' && data.audio_url) {
                    audio.src = data.audio_url.startsWith('http') ? data.audio_url : `${apiBase}${data.audio_url}`;
                    await audio.play();
                    isLoaded = true;
                    
                    // Show pause icon
                    spinner.classList.add('hidden');
                    pauseIcon.classList.remove('hidden');
                } else {
                    console.error('Audio briefing synthesis failed:', data);
                    alert(lang === 'mk' ? 'Грешка при преземање на аудиото.' : 'Greška prilikom preuzimanja audio zapisa.');
                    resetPlayerState();
                }
            } catch (err) {
                console.error('Failed to load audio briefing:', err);
                resetPlayerState();
            } finally {
                isLoading = false;
            }
        }

        function resetPlayerState() {
            playIcon.classList.remove('hidden');
            pauseIcon.classList.add('hidden');
            spinner.classList.add('hidden');
        }

        playBtn.addEventListener('click', async () => {
            if (!isLoaded) {
                await loadAndPlay();
            } else {
                if (audio.paused) {
                    await audio.play();
                    playIcon.classList.add('hidden');
                    pauseIcon.classList.remove('hidden');
                } else {
                    audio.pause();
                    playIcon.classList.remove('hidden');
                    pauseIcon.classList.add('hidden');
                }
            }
        });

        // Time updates
        audio.addEventListener('timeupdate', () => {
            if (!audio.duration) return;
            const pct = (audio.currentTime / audio.duration) * 100;
            progressFill.style.width = `${pct}%`;

            // Format time
            const mins = Math.floor(audio.currentTime / 60);
            const secs = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
            durationLabel.textContent = `${mins}:${secs}`;
        });

        audio.addEventListener('loadedmetadata', () => {
            const mins = Math.floor(audio.duration / 60);
            const secs = Math.floor(audio.duration % 60).toString().padStart(2, '0');
            durationLabel.textContent = `${mins}:${secs}`;
        });

        audio.addEventListener('ended', () => {
            progressFill.style.width = '0%';
            resetPlayerState();
        });

        // Click on progress bar to seek
        progressBar.addEventListener('click', (e) => {
            if (!isLoaded || !audio.duration) return;
            const rect = progressBar.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const width = rect.width;
            const pct = clickX / width;
            audio.currentTime = pct * audio.duration;
        });
    });
</script>
</style>
