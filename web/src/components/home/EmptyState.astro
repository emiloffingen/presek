---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';

interface Props {
	trending: any[];
}

const { trending } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
---

<div class="home-empty-state">
	<p class="home-empty-kicker">{t('home.empty_kicker')}</p>
	<h2 class="home-empty-title">{t('home.empty_title')}</h2>
	<p class="home-empty-copy">{t('home.empty_desc')}</p>
	{trending.length > 0 && (
		<div class="home-empty-trends">
			{trending.slice(0, 8).map((trend: any) => (
				<a href={l(`/?q=${encodeURIComponent(trend.word)}`)} class="home-empty-trend-link">
					{trend.word}
				</a>
			))}
		</div>
	)}
	<a href={homePath(lang, hostHeader)} class="home-empty-reset">
		{lang === 'sr' ? 'Vrati se na naslovnu' : 'Врати се на насловна'}
	</a>
</div>
