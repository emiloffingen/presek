---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
	trending: any[];
}

const { trending } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
---

<div class="empty-state">
	<p class="empty-kicker">{t('home.empty_kicker')}</p>
	<h2 class="section-heading">{t('home.empty_title')}</h2>
	<p class="empty-copy">{t('home.empty_desc')}</p>
	<div class="trend-links">
		{trending.slice(0, 8).map((t: any) => (
			<a href={l(`/?q=${encodeURIComponent(t.word)}`)}>{t.word}</a>
		))}
	</div>
</div>

<style>
    .empty-state { text-align: center; padding: var(--grid-gap); border: 1px dashed var(--border); margin: var(--grid-gap) 0; }
    .empty-kicker { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; color: var(--nyt-accent); margin-bottom: 1rem; }
    .empty-state .section-heading { font-family: var(--font-serif); font-size: 1.75rem; margin-bottom: 1rem; }
    .trend-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1.5rem; }
    .trend-links a { font-family: var(--font-serif); font-weight: 700; font-style: italic; font-size: 1.1rem; text-decoration: underline; color: var(--foreground); }
</style>
