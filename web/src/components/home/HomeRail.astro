---
import { Activity, TrendingUp } from 'lucide-react';
import NationalMoodIsland from '../NationalMoodIsland.tsx';
import HomeRailSuggestionsIsland from '../HomeRailSuggestionsIsland.tsx';
import NewsletterIsland from '../NewsletterIsland.tsx';
import { getDisplayTitle } from '../../utils/textUtils';


interface Props {
	railWireArticles: any[];
	briefing: any;
	stats: any;
	focusEntities: any[];
	getTimeStr: (dateStr: string) => string;
	getBriefingSnippet: (content: string) => string;
}

const { railWireArticles, briefing, stats, focusEntities, getTimeStr, getBriefingSnippet } = Astro.props;
---

<aside class="broadsheet-rail">

	<section class="rail-block rail-priority-block">
		<p class="rail-kicker">Redakcijski desk</p>
		<div class="rail-head-red">
			<Activity size={12} strokeWidth={3} />
			<h3>POSLEDNJE NA TRACI</h3>
		</div>
		<div class="rail-wire-list">
			{railWireArticles.slice(0, 10).map((art: any) => (
				<a href={`/cluster/${art.cluster_id}`} class="rail-wire-item">
					<p>{getDisplayTitle(art)}</p>
					<div class="rail-wire-meta">{art.source} <span>·</span> {getTimeStr(art.ingested_at || art.created_at)}</div>
				</a>
			))}
		</div>
		<a href="/pulse" class="rail-cta-plain">SVE vesti</a>
	</section>

	{briefing && briefing.content && (
		<section class="rail-block rail-block-alt rail-priority-block">
			<p class="rail-kicker">Brifing</p>
			<h3 class="rail-title">KLJUČNO ZA danas</h3>
			<p class="rail-brief-text">
				{getBriefingSnippet(briefing.content)}
			</p>
			<a href="/briefing" class="rail-cta">CELOKUPAN PREGLED <TrendingUp size={10} /></a>
		</section>
	)}

	<NationalMoodIsland client:visible />

	<HomeRailSuggestionsIsland client:visible />

	<NewsletterIsland client:visible />

	{stats?.quote_of_the_day && (
		<section class="rail-block">
			<p class="rail-kicker">Citat dana</p>
			<blockquote class="rail-quote-block">
				<p>„{stats.quote_of_the_day.quote}“</p>
				<cite>
					<span>POVEZANA priča</span>
					<a href={`/cluster/${stats.quote_of_the_day.cluster_id}`}>
						{stats.quote_of_the_day.title}
					</a>
				</cite>
			</blockquote>
		</section>
	)}
	
	<section class="rail-block rail-block-quiet">
		<p class="rail-kicker">Teme u fokusu</p>
		<div class="rail-tag-cloud">
			{focusEntities.map((ent: any) => (
				<a href={`/subjekt/${encodeURIComponent(ent.name)}`}>
					{ent.display_name || ent.name}
				</a>
			))}
		</div>
	</section>
</aside>

<style>
    .broadsheet-rail { position: sticky; top: 7rem; align-self: start; height: auto; }

    .rail-block { margin-bottom: 2.5rem; }
    .rail-block-alt { padding: 1.5rem; background: var(--secondary); border-radius: 2px; }
    .rail-block-quiet { opacity: 0.85; }
    .rail-priority-block { padding: 1.25rem 1.4rem; border: 1px solid var(--border); background: color-mix(in srgb, var(--background) 95%, #efe5d6 5%); }
    
    .rail-head-red { display: flex; align-items: center; gap: 0.6rem; color: var(--nyt-red); margin-bottom: 1.5rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--nyt-red); }
    .rail-head-red h3 { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 950; letter-spacing: 0.12em; }
    
    .rail-wire-item { display: block; padding: 1rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--foreground); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .rail-wire-item:last-child { border-bottom: none; }
    .rail-wire-item p { font-family: var(--font-serif); font-size: 0.92rem; font-weight: 800; line-height: 1.35; margin-bottom: 0.4rem; transition: color 0.2s ease; }
    .rail-wire-meta { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.04em; }
    .rail-wire-meta span { opacity: 0.5; margin: 0 0.3rem; }
    .rail-wire-item:hover { transform: translateX(4px); }
    .rail-wire-item:hover p { color: var(--nyt-accent); text-decoration: none; }

    .rail-kicker { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 900; text-transform: uppercase; color: var(--nyt-accent); letter-spacing: 0.12em; margin-bottom: 0.6rem; }
    .rail-title { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 950; letter-spacing: 0.06em; margin-bottom: 0.85rem; }
    .rail-brief-text { font-family: var(--font-serif); font-size: 0.94rem; line-height: 1.6; color: var(--secondary-foreground); font-style: italic; margin-bottom: 1.15rem; }
    .rail-cta { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.68rem; font-weight: 900; color: var(--nyt-accent); text-decoration: none; border-bottom: 1px solid transparent; letter-spacing: 0.05em; }
    .rail-cta:hover { border-bottom-color: var(--nyt-accent); }
    .rail-cta-plain { display: block; text-align: center; padding: 0.6rem; font-family: var(--font-sans); font-size: 0.68rem; font-weight: 900; color: var(--muted-foreground); text-decoration: none; letter-spacing: 0.05em; }

    .rail-quote-block p { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; font-style: italic; line-height: 1.5; margin-bottom: 1.25rem; }
    .rail-quote-block cite { display: block; border-top: 1px solid var(--border); padding-top: 0.85rem; font-style: normal; }
    .rail-quote-block cite span { font-family: var(--font-sans); font-size: 0.62rem; font-weight: 800; text-transform: uppercase; display: block; color: var(--muted-foreground); margin-bottom: 0.35rem; letter-spacing: 0.08em; }
    .rail-quote-block cite a { font-family: var(--font-serif); font-size: 0.72rem; font-weight: 800; color: var(--foreground); text-decoration: none; line-height: 1.2; display: block; }
    .rail-quote-block cite a:hover { color: var(--nyt-accent); }

    .rail-tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .rail-tag-cloud a { padding: 0.35rem 0.55rem; border: 1px solid var(--border); font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase; color: var(--foreground); text-decoration: none; transition: all 0.2s; white-space: nowrap; }
    .rail-tag-cloud a:hover { background: var(--foreground); color: var(--background); }
</style>
