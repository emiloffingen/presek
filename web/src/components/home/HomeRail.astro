---
import NationalMoodIsland from '../NationalMoodIsland.tsx';
import HomeRailSuggestionsIsland from '../HomeRailSuggestionsIsland.tsx';
import SourceMapIsland from '../SourceMapIsland.tsx';
import NewsletterIsland from '../NewsletterIsland.tsx';
import { getDisplayTitle } from '../../utils/textUtils';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';


interface Props {
	briefing: any;
	stats: any;
	getTimeStr: (dateStr: string) => string;
	getBriefingSnippet: (content: string) => string;
}

const { briefing, stats, getTimeStr, getBriefingSnippet } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
---

<aside class="broadsheet-rail">

	{briefing && briefing.content && (
		<section class="rail-block rail-briefing-block">
			<h3 class="rail-section-title">{t('nav.briefing')}</h3>
			<p class="rail-brief-text">
				{getBriefingSnippet(briefing.content)}
			</p>
		</section>
	)}

	<NationalMoodIsland lang={lang} client:visible />

	<SourceMapIsland lang={lang} client:visible />

	<HomeRailSuggestionsIsland lang={lang} client:visible />

	<NewsletterIsland lang={lang} client:visible />

	{stats?.quote_of_the_day && (
		<section class="rail-block">
			<h3 class="rail-section-title">{t('cluster.quote_of_day')}</h3>
			<blockquote class="rail-quote-block">
				<p>„{stats.quote_of_the_day.quote}“</p>
				<cite>
					<span>{t('rail.related_story')}</span>
					<a href={l(`/cluster/${stats.quote_of_the_day.cluster_id}`)}>
						{stats.quote_of_the_day.title}
					</a>
				</cite>
			</blockquote>
		</section>
	)}

</aside>

<style>
    .rail-inlined-ad {
        grid-column: 1 / -1;
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

    .broadsheet-rail {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-top: 6rem;
        border-top: 1px solid var(--foreground);
        padding-top: 3rem;
        width: 100%;
    }

    @media (min-width: 768px) {
        .broadsheet-rail {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .broadsheet-rail {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 1440px) {
        .broadsheet-rail {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    /* When inside a sidebar, stack vertically with dividers */
    :global(.broadsheet-sidebar) .broadsheet-rail {
        grid-template-columns: 1fr !important;
        border-top: none;
        margin-top: 0;
        padding-top: 0;
    }

    :global(.broadsheet-sidebar) .broadsheet-rail > :global(*) {
        border-right: none !important;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

    :global(.broadsheet-sidebar) .broadsheet-rail > :global(*:last-child) {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    @media (min-width: 1180px) {
        .broadsheet-rail {
            grid-template-columns: 1fr !important;
            border-top: none;
            margin-top: 0;
            padding-top: 0;
        }

        .broadsheet-rail > * {
            border-right: none !important;
            border-bottom: 1px solid var(--border) !important;
            padding-right: 0 !important;
            padding-bottom: 1.5rem !important;
            margin-bottom: 1.5rem !important;
        }

        .broadsheet-rail > *:last-child {
            border-bottom: none !important;
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }

        .rail-block {
            border-right: none !important;
            border-bottom: 1px solid var(--border) !important;
            padding-right: 0 !important;
            padding-bottom: 1.5rem !important;
            margin-bottom: 1.5rem !important;
        }

        .rail-block:last-child {
            border-bottom: none !important;
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }
    }

    .rail-block { margin-bottom: 0; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
    @media (min-width: 768px) {
        .rail-block { border-bottom: none; border-right: 1px solid var(--border); padding-right: 2rem; padding-bottom: 0; }
        .rail-block:last-child { border-right: none; padding-right: 0; }
    }
    .rail-block-quiet { opacity: 0.85; }

    .rail-section-title {
        font-family: var(--font-ui);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--foreground);
        margin-bottom: 1rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--foreground);
    }

    .rail-head-red { display: flex; align-items: center; gap: 0.6rem; color: var(--nyt-red); margin-bottom: 1.25rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--nyt-red); }
    .rail-head-red h3 { font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

    .rail-wire-item { display: block; padding: 0.85rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--foreground); }
    .rail-wire-item:last-child { border-bottom: none; }
    .rail-wire-item p {
        font-family: var(--font-serif);
        font-size: 0.9rem;
        font-weight: 850;
        line-height: 1.3;
        margin-bottom: 0.35rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .rail-wire-meta { font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.04em; }
    .rail-wire-meta span { opacity: 0.5; margin: 0 0.2rem; }
    .rail-wire-item:hover p { color: var(--nyt-accent); text-decoration: underline; }

    .rail-brief-text { font-family: var(--font-sans); font-size: 0.92rem; line-height: 1.5; color: var(--secondary-foreground); font-style: normal; margin-bottom: 1rem; }
    .rail-cta { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 700; color: var(--nyt-accent); text-decoration: none; letter-spacing: 0.05em; }
    .rail-cta:hover { text-decoration: underline; }
    .rail-cta-plain { display: block; text-align: center; padding: 0.5rem; font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; color: var(--muted-foreground); text-decoration: none; letter-spacing: 0.05em; opacity: 0.7; }
    .rail-cta-plain:hover { opacity: 1; text-decoration: underline; }

    .rail-quote-block p { font-family: var(--font-sans); font-size: 1.05rem; font-weight: 700; font-style: normal; line-height: 1.45; margin-bottom: 1rem; color: var(--foreground); }
    .rail-quote-block cite { display: block; border-top: 1px solid var(--border); padding-top: 0.75rem; font-style: normal; }
    .rail-quote-block cite span { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; display: block; color: var(--muted-foreground); margin-bottom: 0.3rem; letter-spacing: 0.08em; }
    .rail-quote-block cite a { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 850; color: var(--foreground); text-decoration: none; line-height: 1.2; display: block; }
    .rail-quote-block cite a:hover { color: var(--nyt-accent); text-decoration: underline; }

    .rail-tag-cloud { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; padding-top: 0.75rem; }
    .rail-tag-cloud a { padding: 0.35rem 0.75rem; border: 1px solid var(--border); font-family: var(--font-sans); font-size: 0.58rem; font-weight: 900; text-transform: uppercase; color: var(--foreground); text-decoration: none; white-space: nowrap; border-radius: 0px; background: color-mix(in srgb, var(--secondary) 30%, transparent); transition: all 0.2s ease; }
    .rail-tag-cloud a:hover { background: var(--foreground); color: var(--background); border-color: var(--foreground); transform: translateY(-1px); }

    @media (max-width: 768px) {
        .rail-briefing-block {
            display: none;
        }
    }
</style>
