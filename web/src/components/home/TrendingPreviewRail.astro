---
import { TrendingUp } from 'lucide-react';
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';
import { useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
    clusters: NewsCluster[];
    lang: keyof typeof ui;
}

const { clusters, lang } = Astro.props;
const t = useTranslations(lang);
---

{clusters.length > 0 && (
    <div class="trending-strip">
        <div class="trending-strip-header">
            <span class="trending-label">
                <TrendingUp size={14} />
                {t('home.trending') || 'Trending'}
            </span>
            <span class="trending-hint">
                {t('home.trending_hint')}
            </span>
        </div>
        <div class="trending-row hide-scrollbar" aria-label={t('home.trending')}>
            {clusters.map((cluster: NewsCluster, index: number) => (
                <div class="trending-card">
                    <span class="trend-rank">{String(index + 1).padStart(2, '0')}</span>
                    <NewsCard cluster={cluster} variant="compact" lang={lang} />
                </div>
            ))}
        </div>
    </div>
)}

<style>
    .trending-strip {
        border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        margin-bottom: 1.5rem;
        padding: 0 0 0.75rem;
        max-width: 100%;
    }

    .trending-strip-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0 0.25rem;
    }

    .trending-row {
        display: flex;
        align-items: stretch;
        gap: 1.15rem;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        padding: 0.75rem 0 1.25rem;
        scroll-snap-type: x proximity;
        -webkit-overflow-scrolling: touch;
    }

    .trending-label {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 0.5rem;
        color: var(--nyt-red);
        font-family: var(--font-sans);
        font-size: 0.56rem;
        font-weight: 950;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .trending-hint {
        color: var(--muted-foreground);
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .trending-card {
        position: relative;
        flex: 0 0 auto;
        width: min(78vw, 18.5rem);
        scroll-snap-align: start;
        background: linear-gradient(135deg, rgba(254, 252, 246, 0.75) 0%, rgba(246, 240, 228, 0.7) 100%);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
        border-radius: 12px;
        padding: 1.95rem 0.95rem 0.95rem;
        box-shadow: 0 4px 20px -2px color-mix(in srgb, var(--background) 30%, rgba(0, 0, 0, 0.08)), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 6%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .dark .trending-card {
        background: linear-gradient(135deg, rgba(22, 26, 41, 0.7) 0%, rgba(15, 18, 29, 0.65) 100%);
        box-shadow: 0 4px 20px -3px rgba(0, 0, 0, 0.3), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
    }

    .trend-rank {
        position: absolute;
        top: 0.72rem;
        right: 0.95rem;
        font-family: var(--font-serif);
        font-size: 1.65rem;
        font-weight: 950;
        line-height: 0.8;
        color: color-mix(in srgb, var(--foreground) 10%, transparent);
        pointer-events: none;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .trending-card:hover {
        border-color: color-mix(in srgb, var(--nyt-red) 45%, var(--border));
        box-shadow: 0 12px 30px -4px color-mix(in srgb, var(--background) 50%, rgba(0, 0, 0, 0.18)), 
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 10%, transparent), 
                    0 0 25px -4px color-mix(in srgb, var(--nyt-red) 8%, transparent);
        transform: translateY(-3px);
    }

    .trending-card:hover .trend-rank {
        color: color-mix(in srgb, var(--nyt-red) 35%, transparent);
        transform: translateY(-2px) scale(1.08);
    }

    .trending-card :global(.nyt-article) {
        height: 100%;
        padding-bottom: 0;
    }

    .trending-card :global(.image-wrap) {
        display: none;
    }

    .trending-card :global(.article-body) {
        justify-content: flex-start;
    }

    .trending-card :global(.headline-link) {
        min-height: 3.8rem;
    }

    .trending-card :global(.headline-compact) {
        font-size: 1.12rem;
        line-height: 1.15;
    }

    .trending-card :global(.summary) {
        min-height: 0;
        -webkit-line-clamp: 2;
    }

    @media (max-width: 639px) {
        .trending-strip {
            margin-bottom: 1.25rem;
            padding-bottom: 0.65rem;
        }

        .trending-strip-header {
            gap: 0.35rem;
            padding: 0.45rem 0 0.25rem;
            align-items: flex-start;
            flex-direction: column;
        }

        .trending-row {
            gap: 0.85rem;
            padding: 0.55rem 0 0.85rem;
        }

        .trending-card {
            width: min(82vw, 16.5rem);
            padding-top: 1.75rem;
        }
    }

    @media (max-width: 640px) {
        .trending-strip-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.35rem;
        }
    }
</style>
