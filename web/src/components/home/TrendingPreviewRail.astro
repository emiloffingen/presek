---
import '../../styles/trending-preview.css';
import { TrendingUp } from 'lucide-react';
import type { NewsCluster } from '../../types';
import { useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';
import { getDisplayTitle } from '../../utils/textUtils';
import type { ui } from '../../i18n/ui';

interface Props {
    clusters: NewsCluster[];
    lang: keyof typeof ui;
}

const { clusters, lang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
const expandLabel = lang === 'sr' ? 'Prikaži' : 'Прикажи';
const trendLabel = t('home.trending') || 'Trending';
const trendTeaser = clusters[0]?.synthetic_headline || clusters[0]?.articles?.[0]?.title || '';

const trendItems = clusters.map((cluster: NewsCluster) => {
    const article = cluster.articles?.[0];
    return {
        href: l(`/cluster/${cluster.cluster_id}`),
        title: getDisplayTitle(article, cluster.synthetic_headline || '', lang),
        source: article?.source || '',
        chip: trendLabel,
    };
});
---

{clusters.length > 0 && (
    <details class="trending-details" data-trending-strip>
        <summary class="trending-summary" aria-label={trendLabel}>
            <span class="trending-summary-label">
                <TrendingUp size={14} />
                <span class="trending-summary-copy">
                    <span class="trending-summary-title">{trendLabel}</span>
                    {trendTeaser && <span class="trending-summary-teaser">{lang === 'sr' ? 'Prvo:' : 'Прво:'} {trendTeaser}</span>}
                </span>
            </span>
            <span class="trending-summary-meta">
                <span class="trending-count">{clusters.length}</span>
                <span>{expandLabel}</span>
            </span>
        </summary>
        <div class="trending-strip">
            <div class="trending-row hide-scrollbar" data-trending-mount aria-label={trendLabel}></div>
        </div>
    </details>
)}

<script is:inline define:vars={{ trendItems }}>
    (() => {
        const root = document.querySelector('[data-trending-strip]');
        if (!root || !Array.isArray(trendItems) || trendItems.length === 0) return;

        const mount = root.querySelector('[data-trending-mount]');
        if (!mount) return;

        const paint = () => {
            if (mount.dataset.ready === '1') return;
            mount.dataset.ready = '1';
            const frag = document.createDocumentFragment();

            for (const item of trendItems) {
                const link = document.createElement('a');
                link.href = item.href;
                link.className = 'trending-card';

                const chip = document.createElement('span');
                chip.className = 'trend-chip';
                chip.textContent = item.chip || '';

                const title = document.createElement('h3');
                title.className = 'trending-card-title';
                title.textContent = item.title || '';

                const source = document.createElement('p');
                source.className = 'trending-card-source';
                source.textContent = item.source || '';

                link.append(chip, title, source);
                frag.appendChild(link);
            }

            mount.appendChild(frag);
        };

        const maybePaint = () => {
            if (root.open) paint();
        };

        root.addEventListener('toggle', maybePaint);

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    maybePaint();
                    observer.disconnect();
                }
            }, { rootMargin: '200px' });
            observer.observe(root);
        }
    })();
</script>
