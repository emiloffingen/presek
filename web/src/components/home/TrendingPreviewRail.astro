---
import '../../styles/trending-preview.css';
import { TrendingUp } from 'lucide-react';
import type { NewsCluster } from '../../types';
import { useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';
import { getDisplayTitle } from '../../utils/textUtils';
import type { ui } from '../../i18n/ui';

interface Props {
    clusters: NewsCluster[];
    lang: keyof typeof ui;
}

const { clusters, lang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);
const expandLabel = t('home.analysis_expand');
const trendLabel = t('home.trending');
const trendTeaser = clusters[0]?.synthetic_headline || clusters[0]?.articles?.[0]?.title || '';

const trendItems = clusters.map((cluster: NewsCluster) => {
    const article = cluster.articles?.[0];
    return {
        href: l(`/cluster/${cluster.cluster_id}`),
        title: getDisplayTitle(article, cluster.synthetic_headline || '', lang),
        source: article?.source || '',
        chip: trendLabel,
    };
});
---

{clusters.length > 0 && (
    <details class="trending-details" data-trending-strip>
        <summary class="trending-summary" aria-label={trendLabel}>
            <span class="trending-summary-label">
                <TrendingUp size={14} />
                <span class="trending-summary-copy">
                    <span class="trending-summary-title">{trendLabel}</span>
                    {trendTeaser && <span class="trending-summary-teaser">{t('home.analysis_teaser_lead')} {trendTeaser}</span>}
                </span>
            </span>
            <span class="trending-summary-meta">
                <span class="trending-count">{clusters.length}</span>
                <span>{expandLabel}</span>
            </span>
        </summary>
        <div class="trending-strip">
            <div class="trending-row hide-scrollbar" data-trending-mount aria-label={trendLabel}></div>
        </div>
    </details>
    <script type="application/json" id="presek-trending-data" set:html={JSON.stringify(trendItems)}></script>
)}
