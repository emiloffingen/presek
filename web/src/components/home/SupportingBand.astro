---
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
    supportingFeatured: NewsCluster[];
    supportingCompact: NewsCluster[];
    lang?: keyof typeof ui;
}

const { supportingFeatured, supportingCompact, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);

// Combine and sort by score for a true Bento experience
const allSupporting = [...supportingFeatured, ...supportingCompact];

function getBentoSpan(cluster: NewsCluster, index: number): '1x1' | '2x1' | '2x2' {
    const score = cluster.homepage_score || 0;
    
    // First item if high score gets hero treatment (use 2x1 to align heights perfectly)
    if (index === 0 && score > 0.7) return '2x1';
    
    // High scores get wide tiles
    if (score > 0.8) return '2x1';
    
    return '1x1';
}
---

<section class="supporting-band motion-rise motion-delay-2">
    <div class="feed-section-container">
        <div class="section-heading-row masthead-double-rule">
            <h2 class="section-heading">{t('home.supporting_title')}</h2>
            <p class="section-note mt-2 text-xs font-bold uppercase tracking-widest text-muted-foreground/80">{t('home.supporting_desc')}</p>
        </div>

        <div class="bento-box-grid">
            {allSupporting.map((cluster, index) => (
                <div class={`bento-item bento-${getBentoSpan(cluster, index)}`}>
                    <NewsCard 
                        cluster={cluster} 
                        variant={getBentoSpan(cluster, index) === '1x1' ? 'compact' : 'featured'} 
                        bentoSpan={getBentoSpan(cluster, index)}
                        lang={lang} 
                    />
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .supporting-band {
        margin-top: 0.75rem;
    }

    .feed-section-container {
        padding: 1.25rem 0.9rem;
    }

    .bento-item {
        height: 100%;
        transition: var(--transition-base);
    }

    @media (max-width: 640px) {
        .supporting-band {
            margin-top: 0.5rem;
        }

        .feed-section-container {
            padding: 0.85rem 0;
        }
    }
</style>
