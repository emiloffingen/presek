---
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
    supportingFeatured: NewsCluster[];
    supportingCompact: NewsCluster[];
    lang?: string;
}

const { supportingFeatured, supportingCompact, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);
---

<section class="supporting-band motion-rise motion-delay-2">
    <div class="section-heading-row masthead-double-rule">
        <h2 class="section-title">{t('home.supporting_title')}</h2>
        <p class="section-note">{t('home.supporting_desc')}</p>
    </div>
    <div class="supporting-featured-grid">
        {supportingFeatured.map((cluster: NewsCluster) => (
            <NewsCard cluster={cluster} variant="featured" lang={lang} />
        ))}
    </div>
    {supportingCompact.length > 0 && (
        <div class="supporting-compact-grid">
            {supportingCompact.map((cluster: NewsCluster) => (
                <NewsCard cluster={cluster} variant="compact" lang={lang} />
            ))}
        </div>
    )}
</section>
