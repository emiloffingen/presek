---
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';

interface Props {
    supportingFeatured: NewsCluster[];
    supportingCompact: NewsCluster[];
}

const { supportingFeatured, supportingCompact } = Astro.props;
---

<section class="supporting-band motion-rise motion-delay-2">
    <div class="section-heading-row masthead-double-rule">
        <h2 class="section-title">Odmah nakon toga</h2>
        <p class="section-note">Sledeći sloj priča koji širi dnevni kontekst.</p>
    </div>
    <div class="supporting-featured-grid">
        {supportingFeatured.map((cluster: NewsCluster) => (
            <NewsCard cluster={cluster} variant="featured" />
        ))}
    </div>
    {supportingCompact.length > 0 && (
        <div class="supporting-compact-grid">
            {supportingCompact.map((cluster: NewsCluster) => (
                <NewsCard cluster={cluster} variant="compact" />
            ))}
        </div>
    )}
</section>
