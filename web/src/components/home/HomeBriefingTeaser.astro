---
import { ArrowUpRight } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
	briefing: any;
	getBriefingSnippet: (content: string) => string;
}

const { briefing, getBriefingSnippet } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);

const snippet = briefing?.content ? getBriefingSnippet(briefing.content) : '';
const readMinutes = snippet
    ? Math.max(1, Math.ceil(snippet.trim().split(/\s+/).filter(Boolean).length / 180))
    : 0;
const dateLocale = lang === 'mk' ? 'mk-MK' : 'sr-Latn-RS';
const displayDate = briefing?.date
    ? new Intl.DateTimeFormat(dateLocale, {
        day: 'numeric',
        month: 'long',
        timeZone: 'Europe/Belgrade',
    }).format(new Date(briefing.date))
    : '';
---

{snippet && (
	<section class="presek-briefing-card home-briefing-teaser home-mobile-order-briefing" aria-label={t('nav.briefing')}>
		<div class="presek-briefing-card__head">
			<p class="type-kicker">{t('nav.briefing')}</p>
			<div class="presek-briefing-card__meta">
				{displayDate && <span class="presek-briefing-card__date">{displayDate}</span>}
				{readMinutes > 0 && (
					<span class="presek-briefing-card__read-time">
						{t('home.briefing_read_time', { minutes: readMinutes })}
					</span>
				)}
			</div>
		</div>
		<p class="presek-briefing-card__text">{snippet}</p>
		<a href={l('/briefing')} class="presek-briefing-card__cta">
			{t('rail.full_overview')} <ArrowUpRight size={12} strokeWidth={2.5} />
		</a>
	</section>
)}
