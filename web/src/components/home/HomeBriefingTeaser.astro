---
import { TrendingUp } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
	briefing: any;
	getBriefingSnippet: (content: string) => string;
}

const { briefing, getBriefingSnippet } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);

const snippet = briefing?.content ? getBriefingSnippet(briefing.content) : '';
---

{snippet && (
	<section class="home-briefing-teaser home-mobile-order-briefing" aria-label={t('nav.briefing')}>
		<p class="type-kicker">{t('nav.briefing')}</p>
		<p class="home-briefing-text">{snippet}</p>
		<a href={l('/briefing')} class="home-briefing-cta">
			{t('rail.full_overview')} <TrendingUp size={10} />
		</a>
	</section>
)}

<style>
	.home-briefing-teaser {
		display: none;
		margin: 0 0 1rem;
		padding: 1rem 0.95rem;
		border: 1px solid color-mix(in srgb, var(--nyt-accent) 18%, var(--border));
		border-left: 4px solid var(--nyt-accent);
		background: color-mix(in srgb, var(--nyt-accent) 5%, var(--background));
	}

	.home-briefing-teaser .type-kicker {
		margin-bottom: 0.45rem;
	}

	.home-briefing-text {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 0.92rem;
		line-height: 1.55;
		color: color-mix(in srgb, var(--foreground) 84%, var(--secondary-foreground));
	}

	.home-briefing-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.75rem;
		font-family: var(--font-ui);
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--nyt-accent);
		text-decoration: none;
	}

	.home-briefing-cta:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.home-briefing-teaser {
			display: block;
		}
	}
</style>
