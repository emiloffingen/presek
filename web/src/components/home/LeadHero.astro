---
import { sanitizeHtml } from '../../lib/sanitize';
import { getDisplayTitle, highlightScores } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
}

const { 
    leadCluster, 
    leadTitle, 
    leadTitleIsCyrillic, 
    leadSignal, 
    leadSummary, 
    leadSummaryIsCyrillic, 
    leadVisual,
    dominantColor,
    getTimeStr
} = Astro.props;

const tintColor = dominantColor || '#1e40af';
const primaryArticle = leadCluster.articles?.[0] || {};
const primaryDisplayTitle = getDisplayTitle(primaryArticle, 'Водечка приказна');
const relatedArticles = leadCluster.articles.slice(1, 4);
---

<section class="lead-hero motion-rise">
    <div class="lead-hero-tint" style={`--tint-color: ${tintColor};`}></div>
    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        alt={primaryDisplayTitle || leadTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <div class="lead-media-placeholder lead-media-placeholder-error" style="display: none;">
                        <div class="lead-media-topline">
                            <p class="lead-media-kicker">ПРЕСЕК.мк Преглед</p>
                            <p class="lead-media-chip">Без визуел</p>
                        </div>
                        <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="lead-media-placeholder-bg-text" set:html={sanitizeHtml(leadTitle)}></div>
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">ПРЕСЕК.мк Преглед</p>
                        <div class="lead-media-status">
                           {leadCluster.is_breaking && <Zap size={10} fill="currentColor" />}
                           <p class="lead-media-chip">{leadCluster.articles.length} извора</p>
                        </div>
                    </div>
                    <div class="lead-media-content">
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                        <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    </div>
                </div>
            )}
        </div>
    </a>
    <div class="lead-copy">
        <div class="lead-edition-bar">
            <span class="lead-edition-label">ВОДЕЧКИ НАРАТИВ</span>
            <span class="lead-edition-note">Консензус помеѓу {leadCluster.articles.length} редакции</span>
        </div>
        <div class="lead-kicker">
            <span class="source-label">{leadCluster.articles?.[0].source}</span>
            {leadCluster.is_breaking && <span class="live-pill">Ударна вест</span>}
        </div>
        <a href={`/cluster/${leadCluster.cluster_id}`} class="no-underline">
            <h1 class:list={["headline headline-lead", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(leadTitle)}></h1>
        </a>
        <p class="lead-signal">{leadSignal}</p>
        {leadSummary && (
            <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(leadSummary)}></p>
        )}

        {leadCluster.key_facts && leadCluster.key_facts.length > 0 && (
            <div class="lead-analyst-box">
                <div class="analyst-header">
                    <span class="analyst-label">ЛОКАЛЕН АНАЛИТИЧАР (Gemma 2)</span>
                    {leadCluster.pulse_score && (
                        <div class="pulse-indicator">
                            <span class="pulse-text">ПУЛС: {leadCluster.pulse_score}</span>
                            <div class="pulse-bar-bg">
                                <div class="pulse-bar-fill" style={`width: ${leadCluster.pulse_score}%`}></div>
                            </div>
                        </div>
                    )}
                    {leadCluster.pluralism_score !== undefined && (
                        <div class="pluralism-indicator ml-4">
                            <span class="pulse-text">ПЛУРАЛИЗАМ: {leadCluster.pluralism_score}</span>
                            <div class="pulse-bar-bg">
                                <div class="pulse-bar-fill bg-emerald-500" style={`width: ${leadCluster.pluralism_score}%`}></div>
                            </div>
                        </div>
                    )}
                </div>
                <ul class="analyst-facts">
                    {leadCluster.key_facts.map((fact: string) => (
                        <li set:html={sanitizeHtml(fact)}></li>
                    ))}
                </ul>
            </div>
        )}
        <div class="lead-meta">
            <span>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
            <span>·</span>
            <span>{leadCluster.articles.length} извора</span>
        </div>

        {relatedArticles.length > 0 && (
            <div class="lead-follow-strip">
                <p class="lead-follow-kicker">ДОПОЛНИТЕЛНИ ПЕРСПЕКТИВИ</p>
                <ul class="lead-related">
                    {relatedArticles.map((article: any, index: number) => (
                        <li>
                            <span class="lead-related-index">{String(index + 1).padStart(2, '0')}</span>
                            <a 
                                href={`/cluster/${leadCluster.cluster_id}`}
                                set:html={sanitizeHtml(highlightScores(getDisplayTitle(article)))}
                            >
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>

    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        srcset={`${leadVisual.proxiedUrl.replace('w=1200', 'w=600')} 600w, ${leadVisual.proxiedUrl} 1200w`}
                        sizes="(max-width: 768px) 100vw, 1200px"
                        alt={primaryDisplayTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <div class="lead-media-placeholder lead-media-placeholder-error" style="display: none;">
                        <div class="lead-media-topline">
                            <p class="lead-media-kicker">ПРЕСЕК.мк Преглед</p>
                            <p class="lead-media-chip">Без визуел</p>
                        </div>
                        <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="lead-media-placeholder-bg-text" set:html={sanitizeHtml(leadTitle)}></div>
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">ПРЕСЕК.мк Преглед</p>
                        <div class="lead-media-status">
                           {leadCluster.is_breaking && <Zap size={10} fill="currentColor" />}
                           <p class="lead-media-chip">{leadCluster.articles.length} извора</p>
                        </div>
                    </div>
                    <div class="lead-media-content">
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                        <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    </div>
                </div>
            )}
        </div>
    </a>
</section>

<style>
	.lead-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.8rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
	}

	.lead-hero-tint {
		position: absolute;
		top: -30%;
		left: -10%;
		width: 120%;
		height: 160%;
		background: 
            radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--tint-color) 8%, transparent), transparent 50%),
            radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--tint-color) 5%, transparent), transparent 50%);
		opacity: 0.15;
		filter: blur(100px);
		pointer-events: none;
		z-index: 0;
	}

	.dark .lead-hero-tint {
		opacity: 0.25;
		filter: blur(140px);
	}

	.lead-media-mobile {
		display: block;
	}

	.lead-media-desktop {
		display: none;
	}

	.lead-copy {
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	.lead-edition-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem 0.8rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
	}

	.lead-edition-label {
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 950;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--nyt-accent);
	}

	.lead-edition-note {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 88%, var(--foreground) 12%);
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.live-pill {
		border: 1px solid var(--nyt-red);
		color: var(--nyt-red);
		padding: 0.1rem 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
		max-width: 50ch;
		text-wrap: pretty;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.lead-summary-cyrillic {
		line-height: 1.64;
		max-width: 56ch;
	}

	.lead-signal {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 90%, var(--foreground) 10%);
	}

    .lead-analyst-box {
        margin-top: 1.2rem;
        padding: 1rem;
        background: color-mix(in srgb, var(--nyt-accent) 4%, var(--background) 96%);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 15%, var(--border) 85%);
        border-radius: 2px;
    }

    .dark .lead-analyst-box {
        background: color-mix(in srgb, var(--nyt-accent) 6%, var(--background) 94%);
    }

    .analyst-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    }

    .analyst-label {
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.1em;
        color: var(--nyt-accent);
    }

    .pulse-indicator {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .pluralism-indicator {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .pulse-text {
        font-family: var(--font-sans);
        font-size: 0.56rem;
        font-weight: 950;
        color: var(--foreground);
    }

    .pulse-bar-bg {
        width: 40px;
        height: 4px;
        background: var(--border);
        border-radius: 999px;
        overflow: hidden;
    }

    .pulse-bar-fill {
        height: 100%;
        background: var(--nyt-accent);
        border-radius: 999px;
    }

    .analyst-facts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .analyst-facts li {
        font-family: var(--font-nyt-body);
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--foreground);
        position: relative;
        padding-left: 1.25rem;
    }

    .analyst-facts li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--nyt-accent);
        font-weight: 900;
    }

	.lead-meta {
		margin-top: 0.45rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 88%, var(--foreground) 12%);
	}

	.lead-related {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.lead-related li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem;
		align-items: start;
		border-top: 1px solid var(--border);
        transition: background 0.2s ease;
	}

    .lead-related li:hover {
        background: color-mix(in srgb, var(--nyt-accent) 2%, transparent);
    }

	.lead-related a {
		display: block;
		padding: 0.7rem 0;
		font-family: var(--font-sans);
		font-size: 0.96rem;
		font-weight: 700;
		line-height: 1.28;
		color: var(--foreground);
		text-decoration: none;
	}

	.lead-related a:hover {
		color: var(--nyt-accent);
	}

	.lead-follow-strip {
		margin-top: 0.95rem;
		padding: 0.85rem 1rem 0;
		background: color-mix(in srgb, var(--background) 96%, #efe5d6 4%);
		border: 1px solid var(--border);
	}

	.lead-follow-kicker {
		margin: 0 0 0.2rem;
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 950;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.lead-related-index {
		padding-top: 0.84rem;
		font-family: var(--font-sans);
		font-size: 0.54rem;
		font-weight: 950;
		letter-spacing: 0.12em;
		color: var(--nyt-accent);
	}

	.lead-media-frame {
		position: relative;
		aspect-ratio: 3 / 2;
		width: 100%;
		border: 1px solid var(--border);
		overflow: hidden;
		background:
			radial-gradient(circle at top right, color-mix(in srgb, var(--nyt-accent) 8%, transparent), transparent 40%),
			linear-gradient(135deg, var(--secondary) 0%, color-mix(in srgb, var(--background) 84%, var(--secondary) 16%) 100%);
	}

	.lead-media-frame-fallback {
		padding: 0.4rem;
		border-color: color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
	}

	.lead-media-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 0.45s ease-out;
	}

	.lead-media-image.is-loaded {
		opacity: 1;
	}

	.lead-media-placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		align-content: space-between;
		padding: 2.25rem;
		position: relative;
		overflow: hidden;
		background: 
            linear-gradient(135deg, 
                color-mix(in srgb, var(--placeholder-bg, #070c16) 100%, black) 0%, 
                color-mix(in srgb, var(--placeholder-bg, #132a4f) 60%, black) 100%
            );
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.1),
			0 22px 48px rgba(8, 14, 28, 0.2);
	}

    .lead-media-placeholder-bg-text {
        position: absolute;
        inset: -10%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-serif);
        font-size: 15rem;
        font-weight: 900;
        line-height: 0.8;
        color: white;
        opacity: 0.04;
        filter: blur(2px);
        pointer-events: none;
        user-select: none;
        z-index: 0;
        text-align: center;
        word-break: break-all;
    }

	.lead-media-placeholder::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at top left, rgba(255,255,255,0.12), transparent 40%),
			linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.4) 100%);
		pointer-events: none;
        z-index: 1;
	}

	.lead-media-placeholder-error {
		align-content: center;
		text-align: center;
	}

	.lead-media-topline {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

    .lead-media-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
    }

    .lead-media-content {
        position: relative;
        z-index: 2;
    }

	.lead-media-kicker {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.82);
	}

	.lead-media-chip {
		position: relative;
		z-index: 1;
		margin: 0;
		padding: 0.32rem 0.58rem 0.28rem;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.88);
		background: rgba(255,255,255,0.12);
		border: 1px solid rgba(255,255,255,0.14);
		backdrop-filter: blur(8px);
	}

	.lead-media-placeholder h2 {
		position: relative;
		z-index: 1;
		margin: 0;
		font-size: clamp(1.4rem, 1.05rem + 1vw, 2rem);
		line-height: 1.04;
		max-width: 10ch;
		color: white;
	}

	.lead-media-fallback-source {
		position: relative;
		z-index: 1;
		margin: 0.1rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.72);
	}

	.lead-media-fallback-title {
		position: relative;
		z-index: 1;
		margin: 0;
		max-width: 18ch;
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.18;
		color: rgba(255,255,255,0.92);
	}

	.lead-media-fallback-title-cyrillic {
		line-height: 1.22;
		letter-spacing: -0.008em;
	}

	@media (min-width: 960px) {
		.lead-hero {
			grid-template-columns: minmax(0, 1.16fr) minmax(0, 1.04fr);
			align-items: start;
			gap: 1.35rem;
		}

		.lead-media-mobile {
			display: none;
		}

		.lead-media-desktop {
			display: block;
		}

		.lead-media-frame {
			height: 400px;
		}

		.lead-media img {
			aspect-ratio: 16 / 9;
			object-position: center;
		}
	}

	@media (min-width: 1280px) {
		/* Space for potential desktop-only tweaks */
	}

	@media (max-width: 639px) {
		.lead-hero {
			gap: 0.75rem;
		}

		.lead-copy {
			display: flex;
            flex-direction: column;
			gap: 0.4rem;
		}

		.lead-media-frame {
			aspect-ratio: 3 / 2;
			height: auto;
            max-height: none;
		}

		.lead-media-placeholder {
			padding: 1rem;
		}

		.lead-media-placeholder h2 {
			font-size: 1.25rem;
		}

		.lead-summary {
			font-size: 0.94rem;
			line-height: 1.5;
			-webkit-line-clamp: 3;
            margin-bottom: 0.5rem;
		}

		.lead-signal {
			font-size: 0.6rem;
		}

		.lead-meta {
			margin-top: 0.1rem;
			font-size: 0.65rem;
		}

		.lead-edition-bar {
			margin-bottom: 0.65rem;
			padding-bottom: 0.55rem;
		}

		.lead-follow-strip {
			margin-top: 0.65rem;
			padding: 0.75rem 0.8rem 0;
		}

		.lead-related li {
			gap: 0.55rem;
		}

		.lead-related a {
			padding: 0.6rem 0;
			font-size: 0.9rem;
		}

		.lead-related-index {
			padding-top: 0.72rem;
		}
	}
</style>
