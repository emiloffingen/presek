---
import { sanitizeHtml } from '../../lib/sanitize';
import { getDisplayTitle, highlightScores, getDesignCardContext, transliterate } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';
import { Zap, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
    filtered?: boolean;
    filterLabel?: string | null;
    lang?: string;
}

const {
    leadCluster,
    leadTitle,
    leadTitleIsCyrillic,
    leadSignal,
    leadSummary,
    leadSummaryIsCyrillic,
    leadVisual,
    dominantColor,
    getTimeStr,
    filtered = false,
    filterLabel = null,
    lang: propLang
} = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);

const tintColor = dominantColor || '#1e40af';
const primaryArticle = leadCluster.articles?.[0] || {};
const primaryDisplayTitle = getDisplayTitle(primaryArticle, t('lead.title_prefix'));
const relatedArticles = leadCluster.articles.slice(1, 4);
const mediaLabel = filterLabel || primaryArticle.topic || primaryArticle.category || t('lead.theme_fallback');

// Transliterate lead content if on Serbian site and content is Cyrillic
let finalLeadTitle = leadTitle;
if (lang === 'sr' && leadTitleIsCyrillic) {
    finalLeadTitle = highlightScores(transliterate(leadCluster.synthetic_headline || getDisplayTitle(primaryArticle, t('lead.title_prefix'))));
}

let finalLeadSummary = leadSummary;
if (lang === 'sr' && leadSummaryIsCyrillic) {
    finalLeadSummary = transliterate(leadSummary);
}

const cardContext = getDesignCardContext(leadCluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent =
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;
---

<section class:list={["lead-hero motion-rise", { "lead-hero-filtered": filtered }]}>
    <div class="lead-hero-tint" style={`--tint-color: ${tintColor};`}></div>
    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <Fragment>
                    <img
                        src={leadVisual.proxiedUrl}
                        alt={primaryDisplayTitle || leadTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.opacity='0'; this.parentElement.querySelector('.lead-media-placeholder-error').style.display='grid';"
                    />
                    <div class="lead-media-overlay">
                        <div class="overlay-content">
                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} class="text-white/10" />
                        </div>
                    </div>
                </Fragment>
            ) : (
                <div class="lead-media-placeholder design-card" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="design-card-pattern"></div>
                    <div class="design-card-ribbon">
                        <span>{cardLabel}</span>
                    </div>

                    <div class="design-card-main">
                        <div class="design-card-icon-wrap">
                            <IconComponent size={48} strokeWidth={1.5} class="text-white/90" />
                        </div>
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{finalLeadTitle}</h2>
                        <p class="design-card-sub">{cardSub}</p>
                    </div>

                    <div class="design-card-footer">
                        <span class="design-card-cta">{t('news.go_to_article')} <ArrowRight size={14} class="ml-1" /></span>
                    </div>
                </div>
            )}
        </div>
    </a>
    <div class="lead-copy">
        <div class="lead-edition-bar" role="note" aria-label={t('lead.narrative_kicker')}>
            <span class="lead-edition-label">{t('lead.narrative_kicker')}</span>
            <span class="lead-edition-note">
                {t('lead.consensus_prefix')} {leadCluster.articles.length} {
                    lang === 'sr'
                        ? (leadCluster.articles.length === 1 || (leadCluster.articles.length >= 2 && leadCluster.articles.length <= 4)
                            ? t('lead.consensus_suffix_1')
                            : t('lead.consensus_suffix_5plus'))
                        : (leadCluster.articles.length === 1
                            ? t('lead.consensus_suffix_1')
                            : t('lead.consensus_suffix_2plus'))
                }
            </span>
        </div>
        <div class="lead-kicker-v2 mb-4">
            <span class="source-badge" aria-label={t('lead.title_prefix')}>{leadCluster.articles?.[0].source}</span>
            <div class="flex items-center gap-[var(--grid-gap)]">
                {leadCluster.is_breaking && <span class="significance-badge is-breaking" aria-label={`${t('header.breaking')}: ${t('news.breaking')}`}>{t('news.breaking').toUpperCase()}</span>}
                {leadSignal && (
                    <span class="lead-status-badge" aria-label={`Signal: ${leadSignal}`}>
                        <span class="status-dot"></span>
                        <span>{leadSignal.toUpperCase()}</span>
                    </span>
                )}
                <span class="time-stamp-v2" aria-label={t('header.latest')}>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
            </div>
        </div>
        <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="no-underline group">
            <h1 class:list={["headline headline-lead transition-transform duration-500 group-hover:translate-x-1", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h1>
        </a>
        {finalLeadSummary && (
            <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(finalLeadSummary)}></p>
        )}

        {leadCluster.key_facts && leadCluster.key_facts.length > 0 && (
            <div class="lead-analyst-box" aria-label={t('lead.system_insight')}>
                <div class="analyst-header">
                    <div class="flex items-center gap-[var(--grid-gap)]">
                        <Zap size={14} class="text-nyt-accent fill-nyt-accent/20" aria-hidden="true" />
                        <span class="analyst-label">{t('lead.system_insight')}</span>
                    </div>
                    <div class="flex items-center gap-[var(--grid-gap)]">
                        {leadCluster.pulse_score && (
                            <div class="pulse-indicator" aria-label={`${t('nav.pulse')}: ${leadCluster.pulse_score}%`}>
                                <span class="pulse-text">{t('nav.pulse').toUpperCase()}</span>
                                <div class="pulse-bar-bg">
                                    <div class="pulse-bar-fill" style={`width: ${leadCluster.pulse_score}%`}></div>
                                </div>
                            </div>
                        )}
                        {leadCluster.pluralism_score !== undefined && (
                            <div class="pluralism-indicator hidden sm:flex" aria-label={`${t('lead.pluralism')}: ${leadCluster.pluralism_score}%`}>
                                <span class="pulse-text">{t('lead.pluralism')}</span>
                                <div class="pulse-bar-bg">
                                    <div class="pulse-bar-fill bg-emerald-500" style={`width: ${leadCluster.pluralism_score}%`}></div>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
                <ul class="analyst-facts">
                    {leadCluster.key_facts.map((fact: string) => (
                        <li set:html={sanitizeHtml(fact)}></li>
                    ))}
                </ul>
            </div>
        )}
        <div class="lead-meta border-t border-border/50 pt-4 mt-4 flex justify-between items-center">
            <div class="flex items-center gap-[var(--grid-gap)] text-[10px] font-bold uppercase tracking-tight text-muted-foreground">
                <span>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
                <span class="opacity-30">·</span>
                <span>{leadCluster.articles.length} {leadCluster.articles.length === 1 ? t('news.source') : t('news.sources')}</span>
            </div>
            <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="text-[10px] font-black uppercase tracking-widest text-nyt-accent hover:underline decoration-2 underline-offset-4">{t('lead.full_synthesis')}</a>
        </div>

        {relatedArticles.length > 0 && (
            <div class="lead-follow-strip">
                <p class="lead-follow-kicker">{t('lead.key_perspectives')}</p>
                <ul class="lead-related">
                    {relatedArticles.map((article: any) => (
                        <li>
                            <a
                                href={l(`/cluster/${leadCluster.cluster_id}`)}
                                set:html={sanitizeHtml(highlightScores(getDisplayTitle(article, '', lang)))}
                            >
                            </a>
                            <span class="text-[10px] font-bold text-muted-foreground uppercase opacity-60 ml-2 shrink-0">{article.source}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>

    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                                <Fragment>
                    <img
                        src={leadVisual.proxiedUrl}
                        srcset={`${leadVisual.proxiedUrl.replace('w=1200', 'w=600')} 600w, ${leadVisual.proxiedUrl} 1200w`}
                        sizes="(max-width: 768px) 100vw, 1200px"
                        alt={primaryDisplayTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.opacity='0'; this.parentElement.querySelector('.lead-media-placeholder-error').style.display='grid';"
                    />
                    <div class="lead-media-overlay">
                        <div class="overlay-content">
                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} class="text-white/10" />
                        </div>
                    </div>
                </Fragment>
            ) : (
                <div class="lead-media-placeholder" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="lead-media-placeholder-bg-text" set:html={sanitizeHtml(finalLeadTitle)}></div>
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">{t('lead.site_preview')}</p>
                        <div class="lead-media-status">
                           {leadCluster.is_breaking && <Zap size={10} fill="currentColor" />}
                           <p class="lead-media-chip">{leadCluster.articles.length} {leadCluster.articles.length === 1 ? t('news.source') : t('news.sources')}</p>
                        </div>
                    </div>
                    <div class="lead-media-content">
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{mediaLabel}</h2>
                        <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    </div>
                </div>
            )}
        </div>
    </a>
</section>

<style>
	.lead-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.8rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
	}

    .lead-kicker-v2 {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        align-items: flex-start;
    }
    @media (min-width: 640px) {
        .lead-kicker-v2 {
            flex-direction: row;
            align-items: center;
            flex-wrap: wrap;
        }
    }

    .source-badge {
        background: var(--foreground);
        color: var(--background);
        padding: 0.15rem 0.6rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 950;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border-radius: 0px;
        white-space: normal;
        word-break: break-word;
        line-height: 1.2;
    }

    .significance-badge {
        font-family: var(--font-sans);
        font-size: 0.55rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted-foreground);
        padding: 0.15rem 0.4rem;
        background: var(--secondary);
        border-radius: 0px;
        opacity: 0.8;
        white-space: normal;
        word-break: break-word;
        line-height: 1.2;
    }

    .significance-badge.is-breaking {
        color: white;
        background: var(--nyt-red, #d0021b);
        opacity: 1;
    }

    .lead-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 900;
        color: var(--nyt-accent);
        letter-spacing: 0.05em;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: var(--nyt-accent);
        border-radius: 50%;
    }

    .time-stamp-v2 {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 800;
        color: var(--muted-foreground);
        opacity: 0.8;
    }

	.lead-hero-tint {
		position: absolute;
		top: -30%;
		left: -10%;
		width: 120%;
		height: 160%;
		background:
            radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--tint-color) 8%, transparent), transparent 50%),
            radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--tint-color) 5%, transparent), transparent 50%);
		opacity: 0.15;
		filter: blur(100px);
		pointer-events: none;
		z-index: 0;
	}

	.dark .lead-hero-tint {
		opacity: 0.25;
		filter: blur(140px);
	}

	.lead-media-mobile {
		display: block;
	}

	.lead-media-desktop {
		display: none;
	}

	.lead-copy {
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	.lead-edition-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem 0.8rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
	}

	.lead-edition-label {
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 950;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--nyt-accent);
	}

	.lead-edition-note {
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 88%, var(--foreground) 12%);
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
		font-size: var(--text-lg);
		line-height: 1.6;
		color: var(--muted-foreground);
		max-width: 65ch;
		text-wrap: pretty;
		margin: 0;
	}

	.lead-summary-cyrillic {
		line-height: 1.65;
	}

    .lead-analyst-box {
        margin-top: 1.2rem;
        padding: 1.25rem;
        background: color-mix(in srgb, var(--nyt-accent) 4%, var(--background) 96%);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 15%, var(--border) 85%);
        border-radius: 0px;
    }

    .dark .lead-analyst-box {
        background: color-mix(in srgb, var(--nyt-accent) 6%, var(--background) 94%);
    }

    .analyst-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.85rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    }

    .analyst-label {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        letter-spacing: 0.15em;
        color: var(--nyt-accent);
        text-transform: uppercase;
    }

    .pulse-indicator, .pluralism-indicator {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .pulse-text {
        font-family: var(--font-sans);
        font-size: 0.56rem;
        font-weight: 950;
        color: var(--foreground);
    }

    .pulse-bar-bg {
        width: 40px;
        height: 4px;
        background: var(--border);
        border-radius: 999px;
        overflow: hidden;
    }

    .pulse-bar-fill {
        height: 100%;
        background: var(--nyt-accent);
        border-radius: 999px;
    }

    .analyst-facts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .analyst-facts li {
        font-family: var(--font-nyt-body);
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--foreground);
        position: relative;
        padding-left: 1.25rem;
    }

    .analyst-facts li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5rem;
        width: 4px;
        height: 4px;
        background: var(--nyt-accent);
        border-radius: 50%;
    }

	.lead-meta {
		margin-top: 0.45rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 88%, var(--foreground) 12%);
	}

	.lead-related {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.lead-related li {
		display: flex;
		gap: 0.4rem;
		align-items: center;
		border-top: 1px solid var(--border);
        transition: background 0.2s ease;
	}

    .lead-related li:hover {
        background: color-mix(in srgb, var(--nyt-accent) 2%, transparent);
    }

	.lead-related a {
		display: block;
		padding: 0.6rem 0;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--foreground);
		text-decoration: none;
        flex: 1;
	}

	.lead-related a:hover {
		color: var(--nyt-accent);
	}

	.lead-follow-strip {
		margin-top: 0.95rem;
		padding: 0.85rem 1rem 0;
		background: color-mix(in srgb, var(--background) 96%, #efe5d6 4%);
		border: 1px solid var(--border);
	}

	.lead-follow-kicker {
		margin: 0 0 0.2rem;
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 950;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.lead-media-frame {
		position: relative;
		aspect-ratio: 3 / 2;
		width: 100%;
		border: 1px solid var(--border);
		overflow: hidden;
		background:
			radial-gradient(circle at top right, color-mix(in srgb, var(--nyt-accent) 8%, transparent), transparent 40%),
			linear-gradient(135deg, var(--secondary) 0%, color-mix(in srgb, var(--background) 84%, var(--secondary) 16%) 100%);
	}

	.lead-media-frame-fallback {
		padding: 0.4rem;
		border-color: color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
	}

	.lead-media-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
        background-color: #171717; /* bg-neutral-900 */
		opacity: 0;
		transition: opacity 0.45s ease-out, transform 0.6s var(--ease-editorial);
        max-height: 70vh;
	}

    .lead-media-frame:hover .lead-media-image {
        transform: scale(1.04);
    }

	.lead-media-image.is-loaded {
		opacity: 1;
	}

    .lead-media-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 30%, transparent 60%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.5rem;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
        z-index: 2;
    }

    .lead-media-mobile .lead-media-overlay {
        opacity: 1;
    }

    .lead-media-desktop:hover .lead-media-overlay {
        opacity: 1;
    }

    .overlay-headline {
        color: white;
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: 900;
        line-height: 1.1;
        margin: 0;
        text-wrap: balance;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

	.lead-media-placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		align-content: center;
		padding: 4rem;
		position: relative;
		overflow: hidden;
		background:
            linear-gradient(135deg,
                color-mix(in srgb, var(--placeholder-bg, #070c16) 100%, black) 0%,
                color-mix(in srgb, var(--placeholder-bg, #132a4f) 60%, black) 100%
            );
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.1),
			0 22px 48px rgba(8, 14, 28, 0.2);
	}

    .design-card-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.1;
        background-image:
            radial-gradient(circle at 2px 2px, rgba(255,255,255,0.2) 1px, transparent 0),
            linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
