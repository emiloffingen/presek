---
import { sanitizeHtml } from '../../lib/sanitize';
import { cleanAndDecode } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
}

const { 
    leadCluster, 
    leadTitle, 
    leadTitleIsCyrillic, 
    leadSignal, 
    leadSummary, 
    leadSummaryIsCyrillic, 
    leadVisual,
    dominantColor,
    getTimeStr
} = Astro.props;

const tintColor = dominantColor || '#1e40af';
---

<section class="lead-hero motion-rise">
    <div class="lead-hero-tint" style={`--tint-color: ${tintColor};`}></div>
    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        alt={leadTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <div class="lead-media-placeholder lead-media-placeholder-error" style="display: none;">
                        <div class="lead-media-topline">
                            <p class="lead-media-kicker">Пресек Преглед</p>
                            <p class="lead-media-chip">Без визуел</p>
                        </div>
                        <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder">
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">Пресек Преглед</p>
                        <p class="lead-media-chip">{leadCluster.articles.length} извора</p>
                    </div>
                    <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    <p class:list={["lead-media-fallback-title", { "lead-media-fallback-title-cyrillic": leadTitleIsCyrillic }]}>{leadTitle}</p>
                </div>
            )}
        </div>
    </a>
    <div class="lead-copy">
        <div class="lead-kicker">
            <span class="source-label">{leadCluster.articles?.[0].source}</span>
            {leadCluster.is_breaking && <span class="live-pill">Во живо</span>}
        </div>
        <a href={`/cluster/${leadCluster.cluster_id}`} class="no-underline">
            <h1 class:list={["lead-headline", { "lead-headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(leadTitle)}></h1>
        </a>
        <p class="lead-signal">{leadSignal}</p>
        {leadSummary && (
            <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(leadSummary)}></p>
        )}
        <div class="lead-meta">
            <span>{getTimeStr(leadCluster.articles?.[0].created_at)}</span>
            <span>·</span>
            <span>{leadCluster.articles.length} извора</span>
        </div>

        {leadCluster.articles.length > 1 && (
            <ul class="lead-related">
                {leadCluster.articles.slice(1, 4).map((article: any) => (
                    <li class="border-b border-gray-200 dark:border-gray-800 last:border-0">
                        <a 
                            href={`/cluster/${leadCluster.cluster_id}`}
                            class="font-sans text-sm md:text-base font-semibold text-zinc-800 dark:text-zinc-200 block py-3 hover:text-nyt-accent transition-colors [&_*]:font-sans [&_*]:text-sm [&_*]:md:text-base [&_*]:text-zinc-800 [&_*]:dark:text-zinc-200"
                        >
                            {cleanAndDecode(article.title)}
                        </a>
                    </li>
                ))}
            </ul>
        )}
    </div>

    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        alt=""
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <div class="lead-media-placeholder lead-media-placeholder-error" style="display: none;">
                        <div class="lead-media-topline">
                            <p class="lead-media-kicker">Пресек Преглед</p>
                            <p class="lead-media-chip">Без визуел</p>
                        </div>
                        <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder">
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">Пресек Преглед</p>
                        <p class="lead-media-chip">{leadCluster.articles.length} извора</p>
                    </div>
                    <h2>{leadCluster.articles?.[0].category || 'Водечка тема'}</h2>
                    <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    <p class:list={["lead-media-fallback-title", { "lead-media-fallback-title-cyrillic": leadTitleIsCyrillic }]}>{leadTitle}</p>
                </div>
            )}
        </div>
    </a>
</section>

<style>
	.lead-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.8rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
	}

	.lead-hero-tint {
		position: absolute;
		top: -20%;
		right: -10%;
		width: 60%;
		height: 140%;
		background: radial-gradient(circle at center, var(--tint-color), transparent 70%);
		opacity: 0.04;
		filter: blur(80px);
		pointer-events: none;
		z-index: 0;
		transform: rotate(-15deg);
	}

	.dark .lead-hero-tint {
		opacity: 0.12;
		filter: blur(120px);
	}

	.lead-media-mobile {
		display: block;
	}

	.lead-media-desktop {
		display: none;
	}

	.lead-copy {
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	.source-label {
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.live-pill {
		border: 1px solid var(--nyt-red);
		color: var(--nyt-red);
		padding: 0.1rem 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lead-headline {
		font-size: clamp(2rem, 1.55rem + 1.1vw, 3rem);
		line-height: 0.95;
		letter-spacing: -0.024em;
		margin: 0.2rem 0 0.42rem;
		max-width: 15.5ch;
		text-wrap: balance;
		overflow-wrap: break-word;
		word-break: normal;
		hyphens: none;
	}

	.lead-headline-cyrillic {
		line-height: 1.03;
		letter-spacing: -0.018em;
		max-width: 14.5ch;
		text-wrap: pretty;
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
		max-width: 50ch;
		text-wrap: pretty;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.lead-summary-cyrillic {
		line-height: 1.64;
		max-width: 56ch;
	}

	.lead-signal {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 90%, var(--foreground) 10%);
	}

	.lead-meta {
		margin-top: 0.45rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted-foreground) 88%, var(--foreground) 12%);
	}

	.lead-related {
		list-style: none;
		padding: 0;
		margin: 0.65rem 0 0;
		border-top: 1px solid var(--border);
	}

	.lead-related li {
		border-bottom: 1px solid var(--border);
	}

	.lead-related a {
		display: block;
		padding: 0.75rem 0;
		font-family: var(--font-serif);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--foreground);
		text-decoration: none;
	}

	.lead-related a:hover {
		color: var(--nyt-accent);
	}

	.lead-media-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		width: 100%;
		height: 250px;
		border: 1px solid var(--border);
		overflow: hidden;
		background:
			radial-gradient(circle at top right, color-mix(in srgb, var(--nyt-accent) 8%, transparent), transparent 40%),
			linear-gradient(135deg, var(--secondary) 0%, color-mix(in srgb, var(--background) 84%, var(--secondary) 16%) 100%);
	}

	.lead-media-frame-fallback {
		padding: 0.4rem;
		border-color: color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
	}

	.lead-media-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 0.45s ease-out;
	}

	.lead-media-image.is-loaded {
		opacity: 1;
	}

	.lead-media-placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		align-content: end;
		gap: 0.55rem;
		padding: 1.25rem;
		position: relative;
		overflow: hidden;
		background:
			linear-gradient(155deg, rgba(7, 12, 22, 0.98), rgba(19, 42, 79, 0.94) 56%, rgba(203, 138, 70, 0.8) 128%);
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.1),
			0 22px 48px rgba(8, 14, 28, 0.16);
	}

	.lead-media-placeholder::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at top left, rgba(255,255,255,0.18), transparent 32%),
			linear-gradient(180deg, transparent 0%, rgba(7, 12, 22, 0.08) 45%, rgba(7, 12, 22, 0.34) 100%);
		pointer-events: none;
	}

	.lead-media-placeholder::after {
		content: "";
		position: absolute;
		right: 0;
		bottom: 0;
		width: 68%;
		height: 68%;
		background:
			repeating-linear-gradient(
				135deg,
				rgba(255,255,255,0.08) 0,
				rgba(255,255,255,0.08) 1px,
				transparent 1px,
				transparent 14px
			);
		opacity: 0.42;
		mask-image: linear-gradient(180deg, transparent, rgba(0,0,0,0.88));
		pointer-events: none;
	}

	.lead-media-placeholder-error {
		align-content: center;
		text-align: center;
	}

	.lead-media-topline {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.lead-media-kicker {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.82);
	}

	.lead-media-chip {
		position: relative;
		z-index: 1;
		margin: 0;
		padding: 0.32rem 0.58rem 0.28rem;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.56rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.88);
		background: rgba(255,255,255,0.12);
		border: 1px solid rgba(255,255,255,0.14);
		backdrop-filter: blur(8px);
	}

	.lead-media-placeholder h2 {
		position: relative;
		z-index: 1;
		margin: 0;
		font-size: clamp(1.4rem, 1.05rem + 1vw, 2rem);
		line-height: 1.04;
		max-width: 10ch;
		color: white;
	}

	.lead-media-fallback-source {
		position: relative;
		z-index: 1;
		margin: 0.1rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.72);
	}

	.lead-media-fallback-title {
		position: relative;
		z-index: 1;
		margin: 0;
		max-width: 18ch;
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.18;
		color: rgba(255,255,255,0.92);
	}

	.lead-media-fallback-title-cyrillic {
		line-height: 1.22;
		letter-spacing: -0.008em;
	}

	@media (min-width: 960px) {
		.lead-hero {
			grid-template-columns: minmax(0, 1.16fr) minmax(0, 1.04fr);
			align-items: start;
			gap: 1.35rem;
		}

		.lead-media-mobile {
			display: none;
		}

		.lead-media-desktop {
			display: block;
		}

		.lead-media-frame {
			height: 400px;
		}

		.lead-media img {
			aspect-ratio: 16 / 9;
			object-position: center;
		}

		.lead-headline {
			font-size: clamp(2.05rem, 1.65rem + 0.85vw, 2.7rem);
			max-width: 14.5ch;
		}
	}

	@media (min-width: 1280px) {
		.lead-headline {
			max-width: 12.5ch;
		}
	}

	@media (max-width: 639px) {
		.lead-hero {
			gap: 0.62rem;
		}

		.lead-copy {
			display: grid;
			gap: 0.45rem;
		}

		.lead-headline {
			font-size: clamp(1.68rem, 1.32rem + 0.86vw, 2.16rem);
			line-height: 0.96;
			margin: 0.06rem 0 0.14rem;
			max-width: none;
		}

		.lead-headline-cyrillic {
			line-height: 1.01;
		}

		.lead-media-frame {
			aspect-ratio: 16 / 9;
			height: 250px;
		}

		.lead-media-placeholder {
			padding: 0.8rem;
		}

		.lead-media-placeholder h2 {
			font-size: 1.05rem;
		}

		.lead-media-fallback-title {
			font-size: 0.9rem;
			max-width: 16ch;
		}

		.lead-summary {
			font-size: 0.9rem;
			line-height: 1.4;
			-webkit-line-clamp: 3;
		}

		.lead-signal {
			font-size: 0.58rem;
		}

		.lead-meta {
			margin-top: 0.2rem;
			font-size: 0.63rem;
		}

		.lead-related {
			margin-top: 0.15rem;
		}

		.lead-related a {
			padding: 0.46rem 0;
			font-size: 0.84rem;
		}
	}
</style>
