---
import { sanitizeHtml } from '../../lib/sanitize';
import { getDisplayTitle, highlightScores, getDesignCardContext, transliterate } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';
import { Zap, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';
import MeshGradient from './MeshGradient.astro';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
    filtered?: boolean;
    filterLabel?: string | null;
    lang?: string;
}

const {
    leadCluster,
    leadTitle,
    leadTitleIsCyrillic,
    leadSignal,
    leadSummary,
    leadSummaryIsCyrillic,
    leadVisual,
    dominantColor,
    getTimeStr,
    filtered = false,
    filterLabel = null,
    lang: propLang
} = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);

const tintColor = dominantColor || '#1e40af';
const primaryArticle = leadCluster.articles?.[0] || {};
const primaryDisplayTitle = getDisplayTitle(primaryArticle, t('lead.title_prefix'));
const relatedArticles = leadCluster.articles.slice(1, 4);
const mediaLabel = filterLabel || primaryArticle.topic || primaryArticle.category || t('lead.theme_fallback');

// Transliterate lead content if on Serbian site and content is Cyrillic
let finalLeadTitle = leadTitle;
if (lang === 'sr' && leadTitleIsCyrillic) {
    finalLeadTitle = highlightScores(transliterate(leadCluster.synthetic_headline || getDisplayTitle(primaryArticle, t('lead.title_prefix'))));
}

let finalLeadSummary = leadSummary;
if (lang === 'sr' && leadSummaryIsCyrillic) {
    finalLeadSummary = transliterate(leadSummary);
}

const cardContext = getDesignCardContext(leadCluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent =
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const l = (path: string) => localePath(path, lang, hostHeader);

const consensusSuffix = (() => {
    const count = Number((leadCluster as any).sources_count || (leadCluster as any).source_count || leadCluster.articles.length);
    if (lang === 'sr') {
        if (count === 1) return t('lead.consensus_suffix_1');
        if (count >= 2 && count <= 4) return t('lead.consensus_suffix_2_4');
        return t('lead.consensus_suffix_5plus');
    } else {
        if (count === 1) return t('lead.consensus_suffix_1');
        return t('lead.consensus_suffix_2_4');
    }
})();

const getProxiedUrl = (width: number) => {
    if (!leadVisual?.proxiedUrl) return '';
    try {
        const url = new URL(leadVisual.proxiedUrl, 'https://presek.mk');
        url.searchParams.set('w', width.toString());
        return url.pathname + url.search;
    } catch {
        return leadVisual.proxiedUrl;
    }
};

const leadSrcset = leadVisual?.proxiedUrl ? [400, 600, 800, 1000, 1200].map(w => `${getProxiedUrl(w)} ${w}w`).join(', ') : '';
const leadSizes = "(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 1200px";
const fallbackImageUrl = leadVisual?.fallbackUrl || '/img/fallbacks/news-general.svg';

---

<section class:list={["lead-hero", { "lead-hero-filtered": filtered }]} style={`--dominant-color: ${tintColor};`}>
    <MeshGradient color={tintColor} />
    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1" data-testid="cluster-link">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
	            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
	                <Fragment>
	                    <div class="lead-media-loading-shell" aria-hidden="true">
	                        <div class="lead-media-loading-kicker">{mediaLabel}</div>
	                        <h2 class:list={["lead-media-loading-title", { "headline-cyrillic": leadTitleIsCyrillic }]}>{finalLeadTitle}</h2>
	                    </div>
	                    <img
	                        src={leadVisual.proxiedUrl}
	                        srcset={leadSrcset}
	                        sizes={leadSizes}
	                        alt={primaryDisplayTitle || leadTitle}
	                        width="1200"
	                        height="1000"
	                        loading="eager"
	                        fetchpriority="high"
	                        decoding="async"
	                        class="lead-media-image"
	                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                            data-fallback-url={fallbackImageUrl}
	                    />
	                    <div class="lead-media-overlay">
	                        <div class="overlay-content">
	                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} className="text-white/10" />
                        </div>
                    </div>
                </Fragment>
            ) : (
                <div class="lead-media-placeholder design-card topic-fallback-card" style={`--placeholder-bg: ${tintColor};`}>
                    <img src={fallbackImageUrl} alt="" width="1200" height="760" class="article-image article-image-fallback is-loaded" loading="eager" decoding="async" />
                    <div class="topic-fallback-scrim"></div>
                    <div class="design-card-ribbon">
                        <span>{cardLabel}</span>
                    </div>
                </div>
            )}
        </div>
    </a>
    <div class="lead-copy">
        <div class="lead-edition-bar" role="note" aria-label={t('lead.narrative_kicker')}>
            <span class="lead-edition-label">{t('lead.narrative_kicker')}</span>
            <span class="lead-edition-note">
                {t('lead.consensus_prefix')} {Number((leadCluster as any).sources_count || (leadCluster as any).source_count || leadCluster.articles.length)} {consensusSuffix}
            </span>
        </div>
        <div class="lead-kicker-v2 mb-4">
            <span class="source-badge" aria-label={t('lead.title_prefix')}>{leadCluster.articles?.[0].source}</span>
            <div class="lead-kicker-meta flex items-center gap-[var(--grid-gap)]">
                {leadCluster.is_breaking && <span class="significance-badge is-breaking" aria-label={`${t('header.breaking')}: ${t('news.breaking')}`}>{t('news.breaking').toUpperCase()}</span>}
                {leadSignal && (
                    <span class="lead-status-badge" aria-label={`Signal: ${leadSignal}`}>
                        <div class="status-dot-wrap">
                            <span class="status-dot"></span>
                            <span class="status-dot-pulse"></span>
                        </div>
                        <span>{leadSignal.toUpperCase()}</span>
                    </span>
                )}
                <span class="time-stamp-v2" aria-label={t('header.latest')}>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
            </div>
        </div>
        <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="no-underline group" data-testid="cluster-link">
            <h1 class:list={["headline headline-lead transition-transform duration-500 group-hover:translate-x-1", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h1>
        </a>
        {finalLeadSummary && (
            <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(finalLeadSummary)}></p>
        )}

        {leadCluster.key_facts && leadCluster.key_facts.length > 0 && (
            <div class="editorial-insight-panel" aria-label={t('lead.system_insight')}>
                <div class="insight-header">
                    <span class="insight-label">{t('lead.system_insight').toUpperCase()}</span>
                    <div class="insight-meta">
                        {leadCluster.pulse_score && (
                            <span class="meta-tag">PULSE {leadCluster.pulse_score}%</span>
                        )}
                        {leadCluster.pluralism_score !== undefined && (
                            <span class="meta-tag">PLURALISM {leadCluster.pluralism_score}%</span>
                        )}
                    </div>
                </div>
                <div class="insight-body">
                    <ul class="insight-facts">
                        {leadCluster.key_facts.map((fact: string) => (
                            <li set:html={sanitizeHtml(fact)}></li>
                        ))}
                    </ul>
                </div>
            </div>
        )}
        <div class="lead-meta border-t border-border/50 pt-4 mt-4 flex justify-between items-center">
            <div class="lead-meta-primary flex items-center gap-[var(--grid-gap)] text-[10px] font-bold uppercase tracking-tight text-muted-foreground">
                <span>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
                <span class="opacity-30">·</span>
                <span>{leadCluster.articles.length} {leadCluster.articles.length === 1 ? t('news.source') : t('news.sources')}</span>
            </div>
            <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-meta-link text-[10px] font-black uppercase tracking-widest text-nyt-accent hover:underline decoration-2 underline-offset-4" data-testid="cluster-link">{t('lead.full_synthesis')}</a>
        </div>

        {relatedArticles.length > 0 && (
            <div class="lead-follow-strip">
                <p class="lead-follow-kicker">{t('lead.key_perspectives')}</p>
                <ul class="lead-related">
                    {relatedArticles.map((article: any) => (
                        <li>
                            <a
                                href={l(`/cluster/${leadCluster.cluster_id}`)}
                                data-testid="cluster-link"
                                set:html={sanitizeHtml(highlightScores(getDisplayTitle(article, '', lang)))}
                            >
                            </a>
                            <span class="text-[10px] font-bold text-muted-foreground uppercase opacity-60 ml-2 shrink-0">{article.source}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>

    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1" data-testid="cluster-link">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
	            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
	                <Fragment>
	                    <div class="lead-media-loading-shell" aria-hidden="true">
	                        <div class="lead-media-loading-kicker">{mediaLabel}</div>
	                        <h2 class:list={["lead-media-loading-title", { "headline-cyrillic": leadTitleIsCyrillic }]}>{finalLeadTitle}</h2>
	                    </div>
	                    <img
	                        src={leadVisual.proxiedUrl}
	                        srcset={leadSrcset}
	                        sizes={leadSizes}
	                        alt={primaryDisplayTitle}
                        width="1200"
                        height="1000"
	                        loading="eager"
	                        fetchpriority="high"
	                        decoding="async"
	                        class="lead-media-image"
                            data-fallback-url={fallbackImageUrl}
	                    />
	                    <div class="lead-media-overlay">
	                        <div class="overlay-content">
	                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} className="text-white/10" />
                        </div>
                    </div>
                </Fragment>
            ) : (
                <div class="lead-media-placeholder lead-media-editorial-card topic-fallback-card" style={`--placeholder-bg: ${tintColor};`}>
                    <img src={fallbackImageUrl} alt="" width="1200" height="760" class="article-image article-image-fallback is-loaded" loading="eager" decoding="async" />
                    <div class="topic-fallback-scrim"></div>
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">{mediaLabel}</p>
                        <div class="lead-media-status">
                           {leadCluster.is_breaking && <Zap size={10} fill="currentColor" />}
                           <p class="lead-media-chip">{leadCluster.articles.length} {leadCluster.articles.length === 1 ? t('news.source') : t('news.sources')}</p>
                        </div>
                    </div>
                    <div class="lead-media-source-row">
                        <span>{leadCluster.articles?.[0].source}</span>
                        <span>{t('lead.full_synthesis')} →</span>
                    </div>
                </div>
            )}
        </div>
    </a>
</section>

<style>
	.lead-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(0.75rem, 1.6vw, 1.25rem);
		padding-bottom: clamp(1rem, 2.2vw, 1.85rem);
		border-bottom: 2px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
		position: relative;
		overflow: hidden;
        margin-bottom: 1.25rem;
        background-image: radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--dominant-color, var(--nyt-accent)) 3%, transparent), transparent 80%);
        transition: background 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

    :global(.dark) .lead-hero {
        background-image: radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--dominant-color, var(--nyt-accent)) 8%, transparent), transparent 75%);
    }

    .lead-kicker-v2 {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        align-items: flex-start;
    }
    @media (min-width: 640px) {
        .lead-kicker-v2 {
            flex-direction: row;
            align-items: center;
            flex-wrap: wrap;
        }
    }

    .source-badge {
        background: var(--foreground);
        color: var(--background);
        padding: 0.15rem 0.6rem;
        font-family: var(--font-ui-condensed);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border-radius: 0px;
        line-height: 1.2;
    }

    .significance-badge.is-breaking {
        color: white;
        background: var(--nyt-red);
        opacity: 1;
    }

    .lead-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-ui);
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--nyt-accent);
        letter-spacing: 0.02em;
    }

    .status-dot-wrap {
        position: relative;
        width: 10px;
        height: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: var(--nyt-accent);
        border-radius: 50%;
        position: relative;
        z-index: 2;
    }

    .status-dot-pulse {
        position: absolute;
        width: 100%;
        height: 100%;
        background: var(--nyt-accent);
        border-radius: 50%;
        z-index: 1;
        opacity: 0.4;
        animation: organic-pulse 2s var(--ease-editorial) infinite;
    }

    @keyframes organic-pulse {
        0% { transform: scale(1); opacity: 0.4; }
        50% { transform: scale(2.5); opacity: 0; }
        100% { transform: scale(1); opacity: 0; }
    }

    .time-stamp-v2 {
        font-family: var(--font-ui);
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--muted-foreground);
        opacity: 0.8;
    }

	.lead-media-mobile { display: block; }
	.lead-media-desktop { display: none; }

		.lead-copy {
			display: flex;
			flex-direction: column;
			position: relative;
			z-index: 1;
		}

		.lead-copy .headline-lead {
			margin: 0 0 0.7rem;
			max-width: 19ch;
			color: var(--foreground);
			background: none;
			-webkit-background-clip: initial;
			background-clip: initial;
			-webkit-text-fill-color: currentColor;
			filter: none;
			opacity: 1;
			transform: none;
            transition: all 0.4s var(--ease-editorial);
		}

        .lead-copy .headline-lead:hover {
            color: color-mix(in srgb, var(--dominant-color) 25%, var(--foreground));
        }

	.lead-edition-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem 0.8rem;
		margin-bottom: 0.75rem;
		padding: 0.42rem 0.75rem;
        background: color-mix(in srgb, var(--secondary) 45%, var(--background));
        border: 1px solid color-mix(in srgb, var(--foreground) 12%, var(--border));
        border-radius: var(--radius-md, 0px);
        box-shadow: inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
	}

	.lead-edition-label {
		font-family: var(--font-ui-condensed);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--dominant-color, var(--nyt-accent));
	}

	.lead-edition-note {
		font-family: var(--font-ui);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--foreground) 64%, var(--muted-foreground));
	}

	.lead-summary {
		font-family: var(--font-nyt-body);
		font-size: var(--text-lg);
		line-height: 1.55;
		color: color-mix(in srgb, var(--foreground) 74%, var(--secondary-foreground));
		max-width: 65ch;
		text-wrap: pretty;
		margin: 0;
	}

	.lead-summary::first-letter {
		font-family: var(--font-serif-display);
		font-size: clamp(3.2rem, 5.5vw, 4rem);
		float: left;
		line-height: 0.82;
		margin: 0.15rem 0.65rem 0.1rem 0;
		font-weight: 900;
		color: var(--dominant-color, var(--nyt-accent));
		text-shadow: 1px 1px 0px var(--background), 2px 2px 0px color-mix(in srgb, var(--border) 40%, transparent);
	}

	.lead-summary-cyrillic {
		line-height: 1.65;
        letter-spacing: 0.01em;
	}

    .editorial-insight-panel {
        margin-top: 1.2rem;
        padding: 1rem 1.15rem;
        background: linear-gradient(135deg, color-mix(in srgb, var(--card) 95%, transparent), color-mix(in srgb, var(--secondary) 85%, transparent));
        background-image: radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--dominant-color) 8%, transparent), transparent 70%);
        border: 1px solid color-mix(in srgb, var(--foreground) 13%, var(--border));
        border-top: 3px solid var(--dominant-color);
        border-radius: var(--radius-lg, 0px);
        box-shadow: 0 8px 30px -4px color-mix(in srgb, var(--background) 40%, rgba(0, 0, 0, 0.08)),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 6%, transparent);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.dark) .editorial-insight-panel {
        background: linear-gradient(135deg, rgba(22, 26, 41, 0.75) 0%, rgba(15, 18, 29, 0.7) 100%);
        background-image: radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--dominant-color) 12%, transparent), transparent 65%);
        box-shadow: 0 12px 35px -8px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
    }

    .editorial-insight-panel:hover {
        border-color: color-mix(in srgb, var(--dominant-color) 45%, var(--border));
        border-top-color: var(--dominant-color);
        transform: translateY(-2px);
        box-shadow: 0 16px 40px -8px color-mix(in srgb, var(--background) 50%, rgba(0, 0, 0, 0.16)),
                    inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 10%, transparent),
                    0 0 25px -4px color-mix(in srgb, var(--dominant-color) 6%, transparent);
    }

    .insight-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.85rem;
    }

    .insight-label {
        font-family: var(--font-ui-condensed);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--dominant-color);
    }

    .insight-meta {
        display: flex;
        gap: 0.75rem;
    }

    .meta-tag {
        font-family: var(--font-ui);
        font-size: 0.64rem;
        font-weight: 700;
        color: var(--muted-foreground);
        letter-spacing: 0.02em;
    }

    .insight-facts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .insight-facts li {
        font-family: var(--font-serif);
        font-size: 0.94rem;
        line-height: 1.45;
        color: var(--foreground);
        position: relative;
        padding-left: 1.15rem;
        transition: all 0.3s var(--ease-editorial);
    }

    .insight-facts li::before {
        content: "■";
        position: absolute;
        left: 0;
        top: 0.15rem;
        color: var(--dominant-color);
        font-size: 0.5rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .insight-facts li:hover {
        color: var(--foreground);
        transform: translateX(4px);
    }

    .insight-facts li:hover::before {
        transform: scale(1.3) rotate(45deg);
        color: var(--foreground);
        text-shadow: 0 0 6px color-mix(in srgb, var(--dominant-color) 80%, transparent);
    }

	.lead-meta {
		margin-top: 0.35rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--foreground) 62%, var(--muted-foreground));
	}

	.lead-related {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.lead-related li {
		display: flex;
		gap: 0.4rem;
		align-items: center;
		border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        padding-left: 0.5rem;
        border-left: 2px solid transparent;
        transition: all 0.3s var(--ease-editorial);
	}

    .lead-related li:hover {
        background: color-mix(in srgb, var(--dominant-color) 4%, transparent);
        border-left-color: var(--dominant-color);
        padding-left: 0.75rem;
    }

	.lead-related a {
		display: block;
		padding: 0.65rem 0;
		font-family: var(--font-ui);
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--foreground);
		text-decoration: none;
        flex: 1;
        transition: color 0.3s var(--ease-editorial);
	}

	.lead-related a:hover {
