---
import { sanitizeHtml } from '../../lib/sanitize';
import { getDisplayTitle, highlightScores, getDesignCardContext, transliterate } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';
import { Zap, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';
import MeshGradient from './MeshGradient.astro';
import { buildEmergencyFallbackUrl } from '../../utils/imageSelection';
import StoryFreshnessBadge from '../StoryFreshnessBadge.astro';
import { formatStoryFreshness } from '../../utils/storyFreshness';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
    filtered?: boolean;
    filterLabel?: string | null;
    lang?: string;
    compact?: boolean;
    showHeroVisual?: boolean;
    pipelineBusy?: boolean;
}

const {
    leadCluster,
    leadTitle,
    leadTitleIsCyrillic,
    leadSignal,
    leadSummary,
    leadSummaryIsCyrillic,
    leadVisual,
    dominantColor,
    getTimeStr,
    filtered = false,
    filterLabel = null,
    lang: propLang,
    compact = false,
    showHeroVisual = true,
    pipelineBusy = false,
} = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = propLang || urlLang;
const t = useTranslations(lang);

const tintColor = dominantColor || '#1e40af';
const primaryArticle = leadCluster.articles?.[0] || {};
const leadFreshness = leadCluster.synthesis_freshness || {};
const leadMissingSynthesis = (leadFreshness.reasons || []).includes('missing_synthesis');
const leadFreshnessView = formatStoryFreshness(
    {
        lang: lang as 'sr' | 'mk',
        synthesisUpdatedAt: leadCluster.synthesis_updated_at || leadFreshness.synthesis_updated_at,
        latestArticleAt: leadFreshness.latest_article_at || leadCluster.articles?.[0]?.ingested_at || leadCluster.articles?.[0]?.created_at,
        isStale: Boolean(leadFreshness.is_stale) && !leadMissingSynthesis,
        newArticleCount: Number(leadFreshness.new_article_count || 0),
        pipelineBusy,
        missingSynthesis: leadMissingSynthesis,
    },
    t as (key: string, params?: Record<string, string | number>) => string,
);
const primaryDisplayTitle = getDisplayTitle(primaryArticle, t('lead.title_prefix'));
const relatedArticles = leadCluster.articles.slice(1, 4);
const mediaLabel = filterLabel || primaryArticle.topic || primaryArticle.category || t('lead.theme_fallback');

// Transliterate lead content if on Serbian site and content is Cyrillic
let finalLeadTitle = leadTitle;
if (lang === 'sr' && leadTitleIsCyrillic) {
    finalLeadTitle = highlightScores(transliterate(leadCluster.synthetic_headline || getDisplayTitle(primaryArticle, t('lead.title_prefix'))));
}

let finalLeadSummary = leadSummary;
if (lang === 'sr' && leadSummaryIsCyrillic) {
    finalLeadSummary = transliterate(leadSummary);
}

const cardContext = getDesignCardContext(leadCluster);
const cardLabel = cardContext.labelKey ? t(cardContext.labelKey as any) : '';
const cardSub = cardContext.subKey ? t(cardContext.subKey as any) : '';

const IconComponent =
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;

const l = (path: string) => localePath(path, lang, hostHeader);

const consensusSuffix = (() => {
    const count = Number((leadCluster as any).sources_count || (leadCluster as any).source_count || leadCluster.articles.length);
    if (lang === 'sr') {
        if (count === 1) return t('lead.consensus_suffix_1');
        if (count >= 2 && count <= 4) return t('lead.consensus_suffix_2_4');
        return t('lead.consensus_suffix_5plus');
    } else {
        if (count === 1) return t('lead.consensus_suffix_1');
        return t('lead.consensus_suffix_2_4');
    }
})();

const valueStripItems = [
    {
        label: t('lead.value_grouped'),
        detail: t('lead.value_grouped_detail'),
    },
    {
        label: t('lead.value_sources'),
        detail: t('lead.value_sources_detail', {
            count: Number((leadCluster as any).sources_count || (leadCluster as any).source_count || leadCluster.articles.length),
        }),
    },
    {
        label: t('lead.value_personal'),
        detail: t('lead.value_personal_detail'),
    },
];

const getProxiedUrl = (width: number) => {
    if (!leadVisual?.proxiedUrl) return '';
    try {
        const url = new URL(leadVisual.proxiedUrl, 'https://presek.mk');
        url.searchParams.set('w', width.toString());
        return url.pathname + url.search;
    } catch {
        return leadVisual.proxiedUrl;
    }
};

const leadSrcset = leadVisual?.proxiedUrl ? [400, 600, 800, 1000, 1200].map(w => `${getProxiedUrl(w)} ${w}w`).join(', ') : '';
const leadSizes = "(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 1200px";
const fallbackImageUrl = leadVisual?.fallbackUrl || buildEmergencyFallbackUrl(lang as 'sr' | 'mk');
const showLeadMedia = showHeroVisual && Boolean(leadVisual?.proxiedUrl);

---

<section class:list={["lead-hero", { "lead-hero-filtered": filtered, "lead-hero-compact": compact, "lead-hero-no-visual": !showHeroVisual }]} style={`--dominant-color: ${tintColor};`}>
    <MeshGradient color={tintColor} />
    {showHeroVisual && showLeadMedia && (
    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1" data-testid="cluster-link">
        <div class="lead-media-frame shadow-editorial">
	                <Fragment>
	                    <div class="lead-media-loading-shell" aria-hidden="true">
	                        <div class="lead-media-loading-kicker">{mediaLabel}</div>
	                        <h2 class:list={["lead-media-loading-title", { "headline-cyrillic": leadTitleIsCyrillic }]}>{finalLeadTitle}</h2>
	                    </div>
	                    <img
	                        src={leadVisual.proxiedUrl}
	                        srcset={leadSrcset}
	                        sizes={leadSizes}
	                        alt={primaryDisplayTitle || leadTitle}
	                        width="1200"
	                        height="1000"
	                        loading="eager"
	                        fetchpriority="high"
	                        decoding="async"
	                        class="lead-media-image"
	                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                            data-fallback-url={fallbackImageUrl}
	                    />
	                    <div class="lead-media-overlay">
	                        <div class="overlay-content">
	                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={42} className="text-current opacity-25" />
                            <p class="lead-media-kicker">{mediaLabel}</p>
                            <h2 class:list={["lead-media-fallback-title", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                            <p class="lead-media-source-row">{primaryArticle.source}</p>
                        </div>
                    </div>
                </Fragment>
        </div>
    </a>
    )}
    <div class="lead-copy">
        <div class="lead-edition-bar" role="note" aria-label={t('lead.narrative_kicker')}>
            <span class="lead-edition-label">{t('lead.narrative_kicker')}</span>
            <span class="lead-edition-note">
                {t('lead.consensus_prefix')} {Number((leadCluster as any).sources_count || (leadCluster as any).source_count || leadCluster.articles.length)} {consensusSuffix}
            </span>
        </div>
        <div class="lead-kicker-v2 mb-4">
            <span class="source-badge">{primaryArticle.source || filterLabel || primaryArticle.topic || primaryArticle.category || t('lead.theme_fallback')}</span>
            {leadCluster.has_synthesis && (
                <span class="lead-synthesis-badge ui-status">{t('home.feed_synthesis_badge')}</span>
            )}
            <div class="lead-kicker-meta flex items-center gap-[var(--grid-gap)]">
                {leadCluster.is_breaking && <span class="significance-badge is-breaking" aria-label={`${t('header.breaking')}: ${t('news.breaking')}`}>{t('news.breaking').toUpperCase()}</span>}
                {leadSignal && (
                    <span class="lead-status-badge" aria-label={lang === 'sr' ? `Signal: ${leadSignal}` : `Сигнал: ${leadSignal}`}>
                        <div class="status-dot-wrap">
                            <span class="status-dot"></span>
                            <span class="status-dot-pulse"></span>
                        </div>
                        <span>{leadSignal.toUpperCase()}</span>
                    </span>
                )}
                {!leadFreshnessView && (
                    <span class="time-stamp-v2" aria-label={t('header.latest')}>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
                )}
                <StoryFreshnessBadge
                    lang={lang as 'sr' | 'mk'}
                    synthesisUpdatedAt={leadCluster.synthesis_updated_at || leadFreshness.synthesis_updated_at}
                    latestArticleAt={leadFreshness.latest_article_at || leadCluster.articles?.[0]?.ingested_at || leadCluster.articles?.[0]?.created_at}
                    isStale={Boolean(leadFreshness.is_stale) && !leadMissingSynthesis}
                    newArticleCount={Number(leadFreshness.new_article_count || 0)}
                    pipelineBusy={pipelineBusy}
                    missingSynthesis={leadMissingSynthesis}
                />
            </div>
        </div>
        <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="no-underline group" data-testid="cluster-link">
            <h1 class:list={["headline headline-lead transition-transform duration-500 group-hover:translate-x-1", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h1>
        </a>
        {finalLeadSummary && (
            <div class="lead-summary-block">
                {compact && (
                    <p class="lead-why-kicker">{t('lead.why_it_matters')}</p>
                )}
                <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(finalLeadSummary)}></p>
            </div>
        )}

        {compact && (
            <div class="lead-entry-actions">
                <a
                    href={l(`/cluster/${leadCluster.cluster_id}`)}
                    class="lead-entry-primary"
                    data-testid="cluster-link"
                >
                    {t('lead.read_synthesis')}
                </a>
                <button type="button" class="lead-entry-secondary" data-scroll-home-feed>
                    {t('lead.browse_feed')}
                </button>
            </div>
        )}

        {!compact && leadCluster.key_facts && leadCluster.key_facts.length > 0 && (
            <div class="editorial-insight-panel" aria-label={t('lead.system_insight')}>
                <div class="insight-header">
                    <span class="insight-label">{t('lead.system_insight').toUpperCase()}</span>
                    <div class="insight-meta">
                        {leadCluster.pulse_score && (
                            <span class="meta-tag">{t('cluster.media_pulse')} {leadCluster.pulse_score}%</span>
                        )}
                        {leadCluster.pluralism_score !== undefined && (
                            <span class="meta-tag">{t('lead.pluralism')} {leadCluster.pluralism_score}%</span>
                        )}
                    </div>
                </div>
                <div class="insight-body">
                    <ul class="insight-facts">
                        {leadCluster.key_facts.map((fact: string) => (
                            <li set:html={sanitizeHtml(fact)}></li>
                        ))}
                    </ul>
                </div>
            </div>
        )}
        <div class="lead-meta border-t border-border/50 pt-4 mt-4 flex justify-between items-center">
            <div class="lead-meta-primary flex items-center gap-[var(--grid-gap)] text-[10px] font-bold uppercase tracking-tight text-muted-foreground">
                <span>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
                <span class="opacity-30">·</span>
                <span>{leadCluster.articles.length} {leadCluster.articles.length === 1 ? t('news.source') : t('news.sources')}</span>
            </div>
            <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-meta-link ui-kicker ui-kicker--accent" data-testid="cluster-link">{t('lead.full_synthesis')}</a>
        </div>

        <div class="lead-value-strip" aria-label={t('lead.value_label')}>
            {valueStripItems.map((item) => (
                <div class="lead-value-item">
                    <span class="lead-value-label">{item.label}</span>
                    <span class="lead-value-detail">{item.detail}</span>
                </div>
            ))}
            <a class="lead-value-action" href={l('/for-you')}>
                <span>{t('lead.value_action')}</span>
                <ArrowRight size={13} aria-hidden="true" />
            </a>
        </div>

        {!compact && relatedArticles.length > 0 && (
            <div class="lead-follow-strip">
                <p class="lead-follow-kicker">{t('lead.key_perspectives')}</p>
                <ul class="lead-related">
                    {relatedArticles.map((article: any) => (
                        <li>
                            <a
                                href={l(`/cluster/${leadCluster.cluster_id}`)}
                                data-testid="cluster-link"
                                set:html={sanitizeHtml(highlightScores(getDisplayTitle(article, '', lang)))}
                            >
                            </a>
                            <span class="text-[10px] font-bold text-muted-foreground uppercase opacity-60 ml-2 shrink-0">{article.source}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>

    {showHeroVisual && showLeadMedia && (
    <a href={l(`/cluster/${leadCluster.cluster_id}`)} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1" data-testid="cluster-link">
        <div class="lead-media-frame shadow-editorial">
	                <Fragment>
	                    <div class="lead-media-loading-shell" aria-hidden="true">
	                        <div class="lead-media-loading-kicker">{mediaLabel}</div>
	                        <h2 class:list={["lead-media-loading-title", { "headline-cyrillic": leadTitleIsCyrillic }]}>{finalLeadTitle}</h2>
	                    </div>
	                    <img
	                        src={leadVisual.proxiedUrl}
	                        srcset={leadSrcset}
	                        sizes={leadSizes}
	                        alt={primaryDisplayTitle}
                        width="1200"
                        height="1000"
	                        loading="eager"
	                        fetchpriority="high"
	                        decoding="async"
	                        class="lead-media-image"
                            data-fallback-url={fallbackImageUrl}
	                    />
	                    <div class="lead-media-overlay">
	                        <div class="overlay-content">
	                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={42} className="text-current opacity-25" />
                            <p class="lead-media-kicker">{mediaLabel}</p>
                            <h2 class:list={["lead-media-fallback-title", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(finalLeadTitle)}></h2>
                            <p class="lead-media-source-row">{primaryArticle.source}</p>
                        </div>
                    </div>
                </Fragment>
        </div>
    </a>
    )}
</section>

{compact && (
    <script is:inline>
        (function bindLeadFeedScroll() {
            const bind = () => {
                document.querySelectorAll('[data-scroll-home-feed]').forEach((button) => {
                    if (button.dataset.bound) return;
                    button.dataset.bound = '1';
                    button.addEventListener('click', () => {
                        const feed = document.getElementById('home-unified-feed') || document.querySelector('[data-testid="news-feed"] .home-mobile-order-feed');
                        feed?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        window.dispatchEvent(new CustomEvent('presek:scroll-to-feed'));
                    });
                });
            };
            bind();
            document.addEventListener('astro:page-load', bind);
        })();
    </script>
)}
