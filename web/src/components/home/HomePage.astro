---
/* Cache-bust marker for homepage stylesheet hashing. */
import '../../styles/home-page.css';
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../NYTHeader.astro';
import AnalysisBandsLazy from './AnalysisBandsLazy.astro';
import AnalizaSectionNav from './AnalizaSectionNav.astro';
import Footer from '../Footer.astro';

import ForYouIsland from '../ForYouIsland.tsx';
import LeadHero from './LeadHero.astro';
import SupportingBand from './SupportingBand.astro';
import SynthesisPicksSection from './SynthesisPicksSection.astro';
import DevelopmentsSection from './DevelopmentsSection.astro';
import HomeUnifiedFeed from './HomeUnifiedFeed.astro';
import HomePregledTeaser from './HomePregledTeaser.astro';
import HomeSynthesisTeaser from './HomeSynthesisTeaser.astro';
import TinyAdzInlinedAd from '../TinyAdzInlinedAd.astro';
import TinyAdzRailAd from '../TinyAdzRailAd.astro';
import { loadHomepageViewModel } from '../../lib/homepageViewModel';
import { getBriefingSnippet } from '../../lib/homepageData';
import FilterHeader from './FilterHeader.astro';
import HomeRail from './HomeRail.astro';
import EmptyState from './EmptyState.astro';
import HomeLiveStrip from './HomeLiveStrip.astro';
import HomeBriefingTeaser from './HomeBriefingTeaser.astro';
import TrendingPreviewRail from './TrendingPreviewRail.astro';
import DailyEditionBar from './DailyEditionBar.astro';
import HomeStartHere from './HomeStartHere.astro';
import LeadEvidenceChips from './LeadEvidenceChips.astro';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { apiBaseUrl } from '../../lib/apiBase';
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';
import { fetchJsonCached } from '../../lib/apiCache';

interface Props {
    variant?: 'feed' | 'pregled';
}

const { variant = 'feed' } = Astro.props;
const isPregled = variant === 'pregled';

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = getLangFromUrl(effectiveUrl);
const t = useTranslations(lang);
const translate = (key: string) => t(key as any);
const l = (path: string) => localePath(path, lang, hostHeader);

const API_URL = apiBaseUrl();

async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        const err: any = new Error(`Request failed: ${response.status} ${url}`);
        err.status = response.status;
        throw err;
    }
    return response.json();
}

const homepageVm = await loadHomepageViewModel({
    apiUrl: API_URL,
    lang: lang as 'sr' | 'mk',
    searchParams: Astro.url.searchParams,
    variant,
    fetchJson,
    fetchJsonCached,
    errorMessage: t('home.error'),
    t: translate,
    localePath: l,
});

const {
    homepageFlags,
    focusEntities,
    leadCluster,
    leadVisual,
    leadSummary,
    leadTitle,
    finalLeadSignal,
    leadTitleIsCyrillic,
    leadSummaryIsCyrillic,
    activeFilterLabel,
    pipelineBusy,
    hasPartialFeedContent,
    showEmptyState,
    supportingClusters,
    forYouClusters,
    feedClusters,
    wireClusters,
    excludedClusterIds,
    displayedTrendingClusters,
    supportingFeatured,
    supportingCompact,
    consensusClusters,
    perspectivesClusters,
    radarClusters,
    developmentsFeatured,
    developmentsCompact,
    topWireArticles,
    unifiedFeedItems,
    pluralismPct,
    showLeadHeroVisual,
    displayedSynthesisPicks,
    feedSynthesisTeaser,
    feedSynthesisMoreCount,
    analysisBands,
    leadEvidenceItems,
    leadStatus,
    perspectiveBandItems,
    radarBandItems,
    consensusBandItems,
    analysisBandLabels,
    perspectiveTeaser,
    radarTeaser,
    consensusTeaser,
    analizaNavItems,
    analysisOverviewItems,
    showAnalysisLayers,
    homepageState,
    filters,
    error,
    getTimeStr,
} = homepageVm;

const { category, topic, entity, subcategory, q, timespan, isHomepage } = filters;
const isSimpleHomepage = isHomepage && variant !== 'pregled' && (
  Astro.url.searchParams.get('simple') === '1'
  || Astro.url.searchParams.get('view') === 'simple'
);
const {
    clusters,
    globalClusters,
    trending,
    stats,
    briefing,
    pipeline,
} = homepageState;

if (homepageFlags.shouldSetErrorStatus) {
    Astro.response.status = 500;
}

---

<Layout
	title={isPregled
		? t('home.pregled_title')
		: q || entity || subcategory || category || topic || t('layout.title')}
	description={isPregled
		? t('home.pregled_deck')
		: q || entity || subcategory || category || topic
		? t('layout.filtered_description')
		: t('layout.home_description')}
    image={!isPregled ? (leadVisual?.proxiedUrl || undefined) : undefined}
>
    {isPregled && (
        <script is:inline>
            document.documentElement.dataset.homepageMode = 'analiza';
        </script>
    )}
    {isHomepage && !isPregled && (
        <script is:inline>
            document.documentElement.dataset.page = 'home';
        </script>
    )}
    <NYTHeader q={q} category={category} topic={topic} entity={entity} subcategory={subcategory} stats={stats} latestTickerItems={topWireArticles} />

	<main
		id="main-content"
		class:list={[
			'site-layout broadsheet-layout py-0 max-w-full',
			isPregled ? 'home-page-variant-pregled' : 'home-page-variant-feed',
		]}
		data-testid="news-feed"
		data-home-session-root
	>

		{/* Filtering Status */}
		{(q || category || topic || entity || subcategory) && (
			<FilterHeader q={q} category={category} topic={topic} entity={entity} subcategory={subcategory} />
		)}

		<div class="broadsheet-grid px-3 sm:px-4 md:px-8 xl:px-10">
			<div class="broadsheet-main home-mobile-feed">
                {!error && isHomepage && (
                    <div class="home-mobile-order-edition">
                        <DailyEditionBar lang={lang} />
                        {isPregled && (
                            <a href={l('/')} class="home-pregled-nav-link">{t('home.back_to_feed')}</a>
                        )}
                    </div>
                )}

                {isPregled && isHomepage && (
                    <header class="home-pregled-masthead home-mobile-order-lead">
                        <h1 class="home-pregled-title">{t('home.pregled_title')}</h1>
                        <p class="home-pregled-deck">{t('home.pregled_deck')}</p>
                        {analysisOverviewItems.length > 0 && (
                            <dl class="home-analysis-overview" aria-label={t('home.analysis_overview_label')}>
                                {analysisOverviewItems.map((item) => (
                                    <div class="home-analysis-overview-item">
                                        <dt>{item.label}</dt>
                                        <dd>{item.value}</dd>
                                        <p>{item.note}</p>
                                    </div>
                                ))}
                            </dl>
                        )}
                    </header>
                )}

                {isPregled && isHomepage && !error && (
                    <div class="section-wrapper home-inline-ad-slot home-inline-ad-slot--pregled-top">
                        <TinyAdzInlinedAd class="home-inline-ad" />
                    </div>
                )}

                {error && (
                    <div class="home-error-panel" role="alert">
                        <p class="home-error-kicker">{lang === 'sr' ? 'Greška' : 'Грешка'}</p>
                        <p class="home-error-copy">{error}</p>
                        {hasPartialFeedContent && (
                            <p class="home-error-note">{t('home.partial_error_note')}</p>
                        )}
                    </div>
                )}

                {isHomepage && (
                    <script is:inline>
                        (function initHomepageSession() {
                            const root = document.querySelector('[data-home-session-root]');
                            if (!root) return;
                            const visitKey = 'homepage-visit-count';
                            const expandedKey = 'homepage-analysis-expanded';
                            const visits = Number(localStorage.getItem(visitKey) || '0');
                            if (visits < 1) root.classList.add('home-first-session');
                            if (localStorage.getItem(expandedKey) === '1') {
                                root.classList.add('home-analysis-expanded');
                                root.querySelector('.home-edition-expand-panel')?.remove();
                            }
                            localStorage.setItem(visitKey, String(visits + 1));
                        })();
                    </script>
                )}

                {showEmptyState && (
                    <EmptyState trending={trending} errorMessage={error} />
                )}

                {!error && isHomepage && !isPregled && (
                    <div class={`homepage-simple-expand ${isSimpleHomepage ? '' : 'hidden'}`} data-simple-expand>
                        <p class="homepage-simple-expand-copy">
                            {lang === 'mk'
                                ? 'Го гледате поедноставениот преглед. Отворете ја целосната медиска анализа.'
                                : 'Gledate pojednostavljen pregled. Otvorite punu medijsku analizu.'}
                        </p>
                        <button type="button" class="homepage-simple-expand-btn" data-expand-analysis>
                            {lang === 'mk' ? 'Медиска анализа' : 'Medijska analiza'}
                        </button>
                    </div>
                )}

				{leadCluster && !isPregled && (
					<div class="section-wrapper lead-wrapper presek-hero-mark home-mobile-order-lead home-feed-only">
						<LeadHero
							leadCluster={leadCluster}
							leadTitle={leadTitle}
							leadTitleIsCyrillic={leadTitleIsCyrillic}
							leadSignal={finalLeadSignal}
							leadSummary={leadSummary}
							leadSummaryIsCyrillic={leadSummaryIsCyrillic}
							leadVisual={leadVisual}
							dominantColor={leadCluster.dominant_color}
							getTimeStr={getTimeStr}
							filtered={!isHomepage}
							filterLabel={activeFilterLabel}
                            lang={lang}
                            compact={isHomepage}
                            showHeroVisual={showLeadHeroVisual}
                            pipelineBusy={pipelineBusy}
						/>
                        {leadStatus && leadEvidenceItems.length > 0 && (
                            <LeadEvidenceChips
                                statusLabel={leadStatus.label}
                                statusNote={leadStatus.note}
                                tone={leadStatus.tone}
                                items={leadEvidenceItems}
                                lang={lang}
                            />
                        )}
					</div>
				)}

                {!error && isHomepage && briefing && !isPregled && (
                    <div class="section-wrapper home-mobile-order-briefing home-feed-only">
                        <HomeBriefingTeaser briefing={briefing} getBriefingSnippet={getBriefingSnippet} />
                    </div>
                )}

                {!error && isHomepage && !isPregled && !q && !category && !topic && !entity && !subcategory && (
                    <div class="home-mobile-order-start-here home-feed-only home-edition-collapsed">
                        <HomeStartHere lang={lang} />
                    </div>
                )}

                {!error && isHomepage && !isPregled && !isSimpleHomepage && (
                    <div class="section-wrapper home-mobile-order-pregled-teaser home-feed-only home-edition-collapsed">
                        <HomePregledTeaser lang={lang} pluralismPct={pluralismPct} stats={stats} />
                    </div>
                )}

                {!error && isHomepage && analizaNavItems.length > 0 && showAnalysisLayers && (
                    <div class="homepage-analiza-only">
                        <AnalizaSectionNav items={analizaNavItems} lang={lang} />
                    </div>
                )}

				{leadCluster && supportingClusters.length > 0 && !isPregled && (
					<div class="section-wrapper home-mobile-order-supporting home-feed-only home-edition-collapsed">
						<SupportingBand
							supportingFeatured={supportingFeatured}
							supportingCompact={supportingCompact}
                            lang={lang}
						/>
					</div>
				)}

                {!error && isHomepage && !isPregled && (
                    <div class="section-wrapper home-inline-ad-slot home-inline-ad-slot--rail-feed home-feed-only home-edition-collapsed">
                        <TinyAdzRailAd class="home-feed-rail-ad" />
                    </div>
                )}

				{isHomepage && displayedSynthesisPicks.length > 0 && showAnalysisLayers && (
					<div class="section-wrapper home-mobile-order-synthesis homepage-analiza-only">
						<SynthesisPicksSection
							synthesisPicks={displayedSynthesisPicks}
							lang={lang}
						/>
					</div>
				)}

				<div class={`home-mobile-order-analysis ${showAnalysisLayers ? 'homepage-analiza-only' : 'hidden'}`}>
				{/* ── UGAO GLEDANJA (PERSPECTIVE SPECTRUM) ── */}
				{isHomepage && analysisBands.perspectives && perspectivesClusters && perspectivesClusters.length > 0 && (
					<details class="section-wrapper analysis-band perspectives-section analysis-band-collapsible" data-perspectives-band>
						<summary class="analysis-band-summary">
							<span class="analysis-band-summary-main">
								<span class="analysis-band-kicker">{t('home.perspectives_title')}</span>
								<span class="analysis-band-title">{t('home.perspectives_subtitle')}</span>
								{perspectiveTeaser && (
									<span class="analysis-band-teaser">{t('home.analysis_teaser_lead')} {perspectiveTeaser}</span>
								)}
							</span>
							<span class="analysis-band-summary-meta">
								<span class="analysis-band-summary-count">{perspectivesClusters.length}</span>
								<span class="analysis-band-expand">{t('home.analysis_expand')}</span>
							</span>
						</summary>
						<div class="analysis-band-body">
						<div class="section-heading-row">
							<span class="type-kicker">{t('home.perspectives_title')}</span>
							<h2 class="type-section-title">{t('home.perspectives_subtitle')}</h2>
							<p class="type-section-deck">{t('home.perspectives_desc')}</p>
						</div>
						<div class="analysis-grid" data-perspectives-mount></div>
						</div>
					</details>
				)}

				{/* ── MEDIJSKI RADAR (FACT-CHECK RADAR) ── */}
				{isHomepage && analysisBands.radar && radarClusters && radarClusters.length > 0 && (
					<details class="section-wrapper analysis-band radar-section analysis-band-collapsible" data-radar-band>
						<summary class="analysis-band-summary">
							<span class="analysis-band-summary-main">
								<span class="analysis-band-kicker">{t('home.radar_title')}</span>
								<span class="analysis-band-title">{t('home.radar_subtitle')}</span>
								{radarTeaser && (
									<span class="analysis-band-teaser">{t('home.analysis_teaser_lead')} {radarTeaser}</span>
								)}
							</span>
							<span class="analysis-band-summary-meta">
								<span class="analysis-band-summary-count">{radarClusters.length}</span>
								<span class="analysis-band-expand">{t('home.analysis_expand')}</span>
							</span>
						</summary>
						<div class="analysis-band-body">
						<div class="section-heading-row">
							<span class="type-kicker text-red-500 dark:text-red-400">{t('home.radar_title')}</span>
							<h2 class="type-section-title">{t('home.radar_subtitle')}</h2>
							<p class="type-section-deck">{t('home.radar_desc')}</p>
						</div>
						<div class="analysis-grid" data-radar-mount></div>
						</div>
					</details>
				)}

                {/* THE BIG PICTURE (HIGH CONSENSUS) */}
                {isHomepage && analysisBands.consensus && consensusClusters.length > 0 && (
                    <details class="section-wrapper consensus-section analysis-band-collapsible bg-secondary/10 p-8 border-y border-border/40" data-consensus-band>
                            <summary class="analysis-band-summary">
                                <span class="analysis-band-summary-main">
                                    <span class="analysis-band-kicker">{t('home.consensus_title')}</span>
                                    <span class="analysis-band-title">{t('home.consensus_subtitle')}</span>
                                    {consensusTeaser && (
                                        <span class="analysis-band-teaser">{t('home.analysis_teaser_lead')} {consensusTeaser}</span>
                                    )}
                                </span>
                                <span class="analysis-band-summary-meta">
                                    <span class="analysis-band-summary-count">{consensusClusters.length}</span>
                                    <span class="analysis-band-expand">{t('home.analysis_expand')}</span>
                                </span>
                            </summary>
                            <div class="analysis-band-body">
                            <div class="section-heading-row mb-8">
                                <span class="type-kicker">{t('home.consensus_title')}</span>
                                <h2 class="type-section-title">{t('home.consensus_subtitle')}</h2>
                                <p class="type-section-deck">{t('home.consensus_desc')}</p>
                            </div>
                            <div class="consensus-carousel-wrap" data-consensus-wrap>
                                <button
                                    class="carousel-nav-btn prev-btn"
                                    type="button"
                                    data-consensus-prev
                                    aria-label={t('carousel.prev')}
                                >
                                    <ChevronLeft size={18} strokeWidth={2.5} />
                                </button>
                                <div class="consensus-grid hide-scrollbar" data-consensus-mount></div>
                                <button
                                    class="carousel-nav-btn next-btn"
                                    type="button"
                                    data-consensus-next
                                    aria-label={t('carousel.next')}
                                >
                                    <ChevronRight size={18} strokeWidth={2.5} />
                                </button>
                                <div class="carousel-fade-hint right sm:hidden"></div>
                            </div>
                            </div>
                    </details>
                )}

				</div>

                <div id="home-core-feed" class="home-mobile-order-feed home-feed-core home-feed-only">
                {!error && isHomepage && !isPregled && (developmentsFeatured.length > 0 || developmentsCompact.length > 0) && (
                    <div class="section-wrapper presek-section-mark">
                        <DevelopmentsSection
                            title={t('home.developing_title')}
                            note={t('home.developing_desc')}
                            developmentsFeatured={developmentsFeatured}
                            developmentsCompact={developmentsCompact}
                            tone="developing"
                        />
                    </div>
                )}
                {!error && isHomepage && !isPregled && wireClusters.length > 0 && (
                    <div class="section-wrapper presek-section-mark">
                        <DevelopmentsSection
                            title={t('home.wire_title')}
                            note={t('home.wire_desc')}
                            developmentsFeatured={wireClusters}
                            developmentsCompact={[]}
                            variant="wire"
                            tone="wire"
                        />
                    </div>
                )}
                </div>

                {!error && isHomepage && !isPregled && (
                    <div class="section-wrapper home-expand-analysis home-edition-expand-panel home-mobile-order-expand home-feed-only">
                        <p class="type-kicker home-expand-analysis-kicker">{t('home.mode_analiza')}</p>
                        <button type="button" class="home-expand-analysis-btn" data-expand-home-analysis>
                            {t('home.mode_open_analiza')}
                        </button>
                        <p class="home-expand-analysis-copy">
                            {t('home.mode_analiza_hint')}
                        </p>
                    </div>
                )}

                <div id="home-unified-feed" class="home-mobile-order-feed-extended homepage-analiza-only">
                {forYouClusters.length > 0 && (
					<div class="section-wrapper for-you-wrapper" data-for-you-band>
                        <p class="for-you-boundary-label">{t('home.for_you_boundary')}</p>
					    <ForYouIsland client:idle clusters={forYouClusters} excludeClusterIds={excludedClusterIds} lang={lang} />
                    </div>
				)}

                {isHomepage && unifiedFeedItems.length > 0 ? (
                    <div class="section-wrapper presek-section-mark">
                        <HomeUnifiedFeed items={unifiedFeedItems} lang={lang} adInsertAfter={5} />
                    </div>
                ) : (
                    globalClusters.length > 0 && (
                        <div class="section-wrapper presek-section-mark">
                            <DevelopmentsSection
                                title={t('home.global_title')}
                                note={t('home.global_desc')}
                                developmentsFeatured={globalClusters.slice(0, 2)}
                                developmentsCompact={globalClusters.slice(2)}
                                tone="global"
                            />
                        </div>
                    )
                )}

                </div>

                {!error && isHomepage && !isPregled && feedSynthesisTeaser && showAnalysisLayers && (
                    <div class="section-wrapper home-mobile-order-synthesis-teaser home-analiza-deferred home-feed-only">
                        <HomeSynthesisTeaser
                            cluster={feedSynthesisTeaser}
                            lang={lang}
                            moreCount={feedSynthesisMoreCount}
                        />
                    </div>
                )}

                {!error && isHomepage && showAnalysisLayers && (
                    <div class="home-mobile-order-trending home-analiza-deferred">
                        <TrendingPreviewRail clusters={displayedTrendingClusters} lang={lang} />
                    </div>
                )}

                {!error && isHomepage && showAnalysisLayers && (
                    <div class="home-mobile-order-live home-analiza-deferred">
                        <HomeLiveStrip articles={topWireArticles} getTimeStr={getTimeStr} lang={lang} />
                    </div>
                )}
			</div>
			{/* HomeRail rendered horizontally at the bottom of the main feed */}
			<div class={`w-full mt-16 pt-12 ${showAnalysisLayers ? 'homepage-analiza-only' : 'hidden'}`}>
				<div class="masthead-double-rule mb-12"></div>
				<HomeRail
					briefing={briefing}
					stats={stats}
					focusEntities={focusEntities}
					getTimeStr={getTimeStr}
					getBriefingSnippet={getBriefingSnippet}
				/>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

{isHomepage && showAnalysisLayers && (perspectiveBandItems.length > 0 || radarBandItems.length > 0 || consensusBandItems.length > 0) && (
	<AnalysisBandsLazy
		perspectiveItems={perspectiveBandItems}
		radarItems={radarBandItems}
		consensusItems={consensusBandItems}
		labels={analysisBandLabels}
	/>
)}

<script is:inline>
	(function autoSimpleHomepage() {
		try {
			const params = new URLSearchParams(window.location.search);
			if (params.get('simple') === '1' || params.get('view') === 'simple') return;
			const onboardRaw = localStorage.getItem('presek_onboarding_v1');
			const onboard = onboardRaw ? JSON.parse(onboardRaw) : null;
			const onboarded = Boolean(onboard && (onboard.dismissed || onboard.completedAt));
			const profileRaw = localStorage.getItem('presek_reader_profile_v1');
			const profile = profileRaw ? JSON.parse(profileRaw) : null;
			const hasSignals = Boolean(
				(profile?.followedTopics || []).length
				|| (profile?.followedSources || []).length
				|| (profile?.recentClusters || []).length
			);
			if (onboarded || hasSignals) return;
			document.documentElement.dataset.presekSimpleHome = '1';
			document.querySelectorAll('.homepage-analiza-only').forEach((node) => {
				node.classList.add('hidden');
			});
			document.querySelector('[data-simple-expand]')?.classList.remove('hidden');
		} catch (_) {}
	})();

	(function bindSimpleHomeExpand() {
		const expandBtn = document.querySelector('[data-expand-analysis]');
		if (!expandBtn) return;
		expandBtn.addEventListener('click', () => {
			document.documentElement.dataset.presekSimpleHome = '0';
			document.documentElement.classList.add('home-analysis-expanded');
			try {
				localStorage.setItem('presek_home_analysis_expanded_v1', '1');
			} catch (_) {}
			document.querySelectorAll('.homepage-analiza-only').forEach((node) => {
				node.classList.remove('hidden');
			});
			document.querySelector('[data-simple-expand]')?.classList.add('hidden');
			document.querySelector('.homepage-analiza-only')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	})();

	(function homeDetailsDefaults() {
		const DETAIL_SELECTORS = [
			'.home-mobile-stats-details',
			'[data-synthesis-band]',
			'[data-consensus-band]',
			'[data-perspectives-band]',
			'[data-radar-band]',
			'[data-trending-strip]',
			'[data-live-strip]',
		];

		const bindToggleMemory = () => {
			for (const selector of DETAIL_SELECTORS) {
				const details = document.querySelector(selector);
				if (!details || details.dataset.bound) continue;
				details.dataset.bound = '1';
				details.addEventListener('toggle', () => {
					details.dataset.userToggled = '1';
				});
			}
		};

		const applyStatsDefaults = () => {
			const details = document.querySelector('.home-mobile-stats-details');
			if (!details || details.dataset.userToggled) return;
			if (window.matchMedia('(min-width: 769px)').matches) {
				details.setAttribute('open', '');
			} else {
				details.removeAttribute('open');
			}
		};

		const applyAnalizaDefaults = () => {
			const isPregledView = document.querySelector('.home-page-variant-pregled');
			if (!isPregledView && document.documentElement.dataset.homepageMode !== 'analiza') return;
			const isDesktop = window.matchMedia('(min-width: 769px)').matches;

			const openUnlessToggled = (selector, forceOpen) => {
				const details = document.querySelector(selector);
				if (!details || details.dataset.userToggled) return;
				if (forceOpen || isDesktop) details.setAttribute('open', '');
			};

			openUnlessToggled('[data-synthesis-band]', true);
			if (isDesktop) {
				openUnlessToggled('[data-consensus-band]');
			}
		};

		const apply = () => {
			applyStatsDefaults();
			applyAnalizaDefaults();
		};

		const bind = () => {
			bindToggleMemory();
			apply();
		};

		bind();
		window.addEventListener('resize', apply, { passive: true });
		document.addEventListener('astro:page-load', bind);

	})();

	(function homeExpandAnalysis() {
		const bind = () => {
			const root = document.querySelector('[data-home-session-root]');
			const button = document.querySelector('[data-expand-home-analysis]');
			if (!root || !button || button.dataset.bound) return;
			button.dataset.bound = '1';
			button.addEventListener('click', () => {
				root.classList.add('home-analysis-expanded');
				root.classList.remove('home-first-session');
				localStorage.setItem('homepage-analysis-expanded', '1');
				const expandPanel = button.closest('.home-expand-analysis');
				if (expandPanel) expandPanel.remove();
				document.querySelector('.homepage-analiza-only')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		};
		bind();
		document.addEventListener('astro:page-load', bind);
	})();
</script>
