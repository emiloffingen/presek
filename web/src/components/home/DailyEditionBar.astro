---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
    lang?: string;
    modeLabel?: string | null;
    stats?: { total_feeds?: number; last_24h?: number } | null;
}

const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = (Astro.props.lang || urlLang) as 'sr' | 'mk';
const { modeLabel = null, stats = null } = Astro.props;
const t = useTranslations(lang);
const pulsePath = localePath('/pulse', lang, hostHeader);

const editionDate = new Intl.DateTimeFormat(lang === 'sr' ? 'sr-Latn-RS' : 'mk-MK', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Europe/Belgrade',
}).format(new Date());
---

<div class="daily-edition-bar" role="note">
    <span class="daily-edition-mark" aria-hidden="true"></span>
    <div class="daily-edition-copy">
        <span class="daily-edition-kicker">{t('home.edition_kicker')}</span>
        {modeLabel && <span class="daily-edition-mode">{modeLabel}</span>}
        <span class="daily-edition-date">{editionDate}</span>
        {stats && (
            <span class="daily-edition-coverage" aria-label={t('home.stats_open_pulse')}>
                <span>{stats.total_feeds || 0} {t('home.stats_media')}</span>
                <span aria-hidden="true">·</span>
                <span>{stats.last_24h || 0} {t('home.stats_posts_24h')}</span>
                <a href={pulsePath}>{t('home.stats_open_pulse')}</a>
            </span>
        )}
    </div>
</div>
