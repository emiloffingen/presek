---
import { ArrowUpRight, Compass, Newspaper, Sparkles, X } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
    lang?: string;
}

const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader);
const lang = (Astro.props.lang || urlLang) as 'sr' | 'mk';
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);

const steps = [
    {
        href: l('/briefing'),
        label: t('home.start_here_step1'),
        icon: Newspaper,
    },
    {
        href: `${l('/settings')}#profil`,
        label: t('home.start_here_step2'),
        icon: Sparkles,
    },
    {
        href: l('/for-you'),
        label: t('home.start_here_step3'),
        icon: Compass,
    },
];
---

<section
    class="home-start-here"
    data-home-start-here
    data-personalized-kicker={t('home.start_here_personalized_kicker')}
    data-personalized-title={t('home.start_here_personalized_title')}
    data-personalized-deck={t('home.start_here_personalized_deck')}
    data-metric-topics={t('home.start_here_metric_topics')}
    data-metric-sources={t('home.start_here_metric_sources')}
    data-metric-recent={t('home.start_here_metric_recent')}
    data-personalized-primary-label={t('home.start_here_personalized_primary')}
    data-personalized-primary-href={l('/for-you')}
    data-personalized-secondary-label={t('home.start_here_personalized_secondary')}
    data-personalized-secondary-href={`${l('/settings')}#profil`}
    data-personalized-hint={t('home.start_here_personalized_hint')}
    data-signal-label={t('home.start_here_signal_label')}
    data-signal-growing={t('home.start_here_signal_growing')}
    data-signal-good={t('home.start_here_signal_good')}
    data-signal-strong={t('home.start_here_signal_strong')}
    aria-label={t('home.start_here_label')}
>
    <div class="home-start-here-headbar">
        <button type="button" class="home-start-here-dismiss" data-home-start-dismiss aria-label={t('home.start_here_dismiss')}>
            <X size={14} />
        </button>
    </div>
    <details class="home-start-here-details">
        <summary class="home-start-here-summary">
            <div class="home-start-here-head">
                <div>
                    <p class="home-start-here-kicker" data-home-start-kicker>{t('home.start_here_kicker')}</p>
                    <h2 class="home-start-here-title" data-home-start-title>{t('home.start_here_title')}</h2>
                    <p class="home-start-here-deck" data-home-start-deck>{t('home.start_here_deck')}</p>
                </div>
                <span class="home-start-here-signal" data-home-start-signal hidden></span>
            </div>
            <p class="home-start-here-mobile-hint" data-home-start-hint>{t('home.start_here_expand')}</p>
        </summary>
        <div class="home-start-here-value-grid" aria-label={t('home.start_here_value_label')}>
            <div class="home-start-here-value" data-home-start-value>
                <span>{t('home.start_here_value_news')}</span>
                <strong>{t('home.start_here_value_news_desc')}</strong>
            </div>
            <div class="home-start-here-value" data-home-start-value>
                <span>{t('home.start_here_value_analysis')}</span>
                <strong>{t('home.start_here_value_analysis_desc')}</strong>
            </div>
            <div class="home-start-here-value" data-home-start-value>
                <span>{t('home.start_here_value_personal')}</span>
                <strong>{t('home.start_here_value_personal_desc')}</strong>
            </div>
        </div>
        <div class="home-start-here-actions">
            <a href={l('/briefing')} class="home-start-here-action home-start-here-action-primary" data-home-start-primary>
                <span>{t('home.start_here_primary')}</span>
                <ArrowUpRight size={13} aria-hidden="true" />
            </a>
            <a href={`${l('/settings')}#profil`} class="home-start-here-action home-start-here-action-secondary" data-home-start-secondary>
                <span>{t('home.start_here_secondary')}</span>
            </a>
        </div>
        <ol class="home-start-here-steps">
            {steps.map((step, index) => {
                const Icon = step.icon;
                return (
                    <li>
                        <a href={step.href} class="home-start-here-step">
                            <span class="home-start-here-step-index">{index + 1}</span>
                            <Icon size={15} aria-hidden="true" />
                            <span>{step.label}</span>
                            <ArrowUpRight size={13} className="home-start-here-step-arrow" aria-hidden="true" />
                        </a>
                    </li>
                );
            })}
        </ol>
    </details>
</section>

<script>
    const DISMISS_KEY = 'presek-start-here-dismissed';
    const PROFILE_KEY = 'presek_reader_profile_v1';

    function loadProfile() {
        try {
            const raw = localStorage.getItem(PROFILE_KEY);
            if (!raw) return false;
            return JSON.parse(raw);
        } catch {
            return false;
        }
    }

    type ReaderProfile = {
        recentClusters?: unknown[];
        followedTopics?: unknown[];
        followedSources?: unknown[];
    } | false;

    function getCount(profile: ReaderProfile, key: 'recentClusters' | 'followedTopics' | 'followedSources') {
        if (!profile) return 0;
        return Array.isArray(profile?.[key]) ? profile[key].length : 0;
    }

    function applyPersonalizedState(strip: HTMLElement, profile: ReaderProfile) {
        const topics = getCount(profile, 'followedTopics');
        const sources = getCount(profile, 'followedSources');
        const recent = getCount(profile, 'recentClusters');
        const hasSignal = Boolean(topics || sources || recent);
        if (!hasSignal) return false;

        strip.classList.add('is-personalized');
        const kicker = strip.querySelector('[data-home-start-kicker]');
        const title = strip.querySelector('[data-home-start-title]');
        const deck = strip.querySelector('[data-home-start-deck]');
        const hint = strip.querySelector('[data-home-start-hint]');
        if (kicker) kicker.textContent = strip.dataset.personalizedKicker || kicker.textContent;
        if (title) title.textContent = strip.dataset.personalizedTitle || title.textContent;
        if (deck) deck.textContent = strip.dataset.personalizedDeck || deck.textContent;
        if (hint) hint.textContent = strip.dataset.personalizedHint || hint.textContent;

        const primary = strip.querySelector<HTMLAnchorElement>('[data-home-start-primary]');
        const secondary = strip.querySelector<HTMLAnchorElement>('[data-home-start-secondary]');
        const primaryLabel = primary?.querySelector('span');
        const secondaryLabel = secondary?.querySelector('span');
        if (primary && strip.dataset.personalizedPrimaryHref) primary.href = strip.dataset.personalizedPrimaryHref;
        if (secondary && strip.dataset.personalizedSecondaryHref) secondary.href = strip.dataset.personalizedSecondaryHref;
        if (primaryLabel) primaryLabel.textContent = strip.dataset.personalizedPrimaryLabel || primaryLabel.textContent;
        if (secondaryLabel) secondaryLabel.textContent = strip.dataset.personalizedSecondaryLabel || secondaryLabel.textContent;

        const strength = Math.min(100, Math.round(topics * 12 + sources * 16 + recent * 2));
        const signal = strip.querySelector<HTMLElement>('[data-home-start-signal]');
        if (signal) {
            const strengthLabel = strength >= 70
                ? strip.dataset.signalStrong
                : strength >= 35
                    ? strip.dataset.signalGood
                    : strip.dataset.signalGrowing;
            signal.textContent = `${strip.dataset.signalLabel || ''} ${strengthLabel || ''}`.trim();
            signal.hidden = false;
            signal.dataset.strength = strength >= 70 ? 'strong' : strength >= 35 ? 'good' : 'growing';
        }

        const values = Array.from(strip.querySelectorAll<HTMLElement>('[data-home-start-value]'));
        const metrics: Array<[string | undefined, number]> = [
            [strip.dataset.metricTopics, topics],
            [strip.dataset.metricSources, sources],
            [strip.dataset.metricRecent, recent],
        ];
        values.forEach((node, index) => {
            const label = node.querySelector('span');
            const value = node.querySelector('strong');
            if (label) label.textContent = metrics[index]?.[0] || label.textContent;
            if (value) value.textContent = String(metrics[index]?.[1] || 0);
        });
        return true;
    }

    function initHomeStartHere() {
        const strip = document.querySelector<HTMLElement>('[data-home-start-here]');
        if (!strip) return;

        if (localStorage.getItem(DISMISS_KEY) === '1') {
            strip.remove();
            return;
        }

        const profile = loadProfile();
        applyPersonalizedState(strip, profile);

        const dismiss = strip.querySelector<HTMLButtonElement>('[data-home-start-dismiss]');
        if (!dismiss || dismiss.dataset.bound === '1') return;
        dismiss.dataset.bound = '1';
        dismiss.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            localStorage.setItem(DISMISS_KEY, '1');
            strip.remove();
        });

        const details = strip.querySelector<HTMLDetailsElement>('.home-start-here-details');
        if (details && window.matchMedia('(min-width: 769px)').matches) {
            details.open = true;
        }
    }

    initHomeStartHere();
    document.addEventListener('astro:page-load', initHomeStartHere);
    window.addEventListener('presek:reader-profile-updated', initHomeStartHere);
</script>
