---
import { useTranslations } from '../../i18n/utils';

interface NavItem {
    target: string;
    kicker: string;
    label: string;
    count: number;
}

interface Props {
    items: NavItem[];
    lang: 'sr' | 'mk';
}

const { items, lang } = Astro.props;
if (!items.length) return;

const t = useTranslations(lang);
const navLabel = t('home.analiza_nav_label');
const jumpLabel = lang === 'sr' ? 'Idi na odeljak' : 'Оди на оддел';
---

<nav class="analiza-section-nav homepage-analiza-only" aria-label={navLabel}>
    <p class="analiza-section-nav-label">{navLabel}</p>
    <div class="analiza-section-nav-chips hide-scrollbar" role="list">
        {items.map((item) => (
            <button
                type="button"
                class="analiza-nav-chip"
                role="listitem"
                data-analiza-target={item.target}
                aria-current="false"
                aria-label={`${jumpLabel}: ${item.label}`}
            >
                <span class="analiza-nav-kicker">{item.kicker}</span>
                <span class="analiza-nav-label">{item.label}</span>
                <span class="analiza-nav-count">{item.count}</span>
            </button>
        ))}
    </div>
</nav>

<script is:inline>
    (() => {
        const setActiveChip = (selector) => {
            document.querySelectorAll('[data-analiza-target]').forEach((button) => {
                const active = button.getAttribute('data-analiza-target') === selector;
                button.classList.toggle('is-active', active);
                button.setAttribute('aria-current', active ? 'true' : 'false');
            });
        };

        const scrollToBand = (selector) => {
            const target = document.querySelector(selector);
            if (!target) return;
            if (target.tagName === 'DETAILS') {
                target.open = true;
            }
            setActiveChip(selector);
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        const bind = () => {
            document.querySelectorAll('[data-analiza-target]').forEach((button) => {
                if (button.dataset.bound) return;
                button.dataset.bound = '1';
                button.addEventListener('click', () => {
                    scrollToBand(button.getAttribute('data-analiza-target'));
                });
            });

            const tracked = Array.from(document.querySelectorAll('[data-analiza-target]'))
                .map((button) => {
                    const selector = button.getAttribute('data-analiza-target');
                    const target = selector ? document.querySelector(selector) : null;
                    return target ? { selector, target } : null;
                })
                .filter(Boolean);

            if (!tracked.length) return;
            if (window.__presekAnalizaObserver) {
                window.__presekAnalizaObserver.disconnect();
            }
            const observer = new IntersectionObserver((entries) => {
                const visible = entries
                    .filter((entry) => entry.isIntersecting)
                    .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
                if (!visible) return;
                const match = tracked.find((item) => item.target === visible.target);
                if (match?.selector) setActiveChip(match.selector);
            }, {
                rootMargin: '-18% 0px -62% 0px',
                threshold: [0.08, 0.22, 0.4],
            });
            tracked.forEach((item) => observer.observe(item.target));
            window.__presekAnalizaObserver = observer;
        };

        bind();
        document.addEventListener('astro:page-load', bind);
    })();
</script>
