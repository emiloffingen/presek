---
import { ArrowRight, BarChart3 } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath } from '../../lib/localePaths';

interface Props {
    lang?: string;
    pluralismPct?: number | null;
    stats?: {
        total_feeds?: number;
        last_24h?: number;
    } | null;
}

const hostHeader = Astro.request?.headers.get('host');
const propLang = Astro.props.lang;
const lang = (propLang === 'mk' || propLang === 'sr' ? propLang : getLangFromUrl(Astro.url, hostHeader)) as 'sr' | 'mk';
const t = useTranslations(lang);
const pregledHref = localePath('/pregled', lang, hostHeader);
const pluralismPct = Astro.props.pluralismPct;
const stats = Astro.props.stats;
const feeds = stats?.total_feeds || 0;
const last24h = stats?.last_24h || 0;
---

<a href={pregledHref} class="home-pregled-teaser">
    <div class="home-pregled-teaser-icon" aria-hidden="true">
        <BarChart3 size={18} strokeWidth={2.25} />
    </div>
    <div class="home-pregled-teaser-copy">
        <p class="home-pregled-teaser-kicker">{t('home.pregled_cta_kicker')}</p>
        <h2 class="home-pregled-teaser-title">{t('home.pregled_cta_title')}</h2>
        <p class="home-pregled-teaser-deck">{t('home.pregled_cta_deck')}</p>
        <div class="home-pregled-teaser-proof" aria-label={t('home.pregled_cta_proof_label')}>
            <span>{t('home.pregled_cta_proof_pluralism')}</span>
            <span>{t('home.pregled_cta_proof_consensus')}</span>
            <span>{t('home.pregled_cta_proof_radar')}</span>
        </div>
        {(feeds > 0 || last24h > 0 || (typeof pluralismPct === 'number' && pluralismPct > 0)) && (
            <p class="home-pregled-teaser-stat">
                {feeds > 0 && <span>{feeds} {t('home.stats_media')}</span>}
                {feeds > 0 && last24h > 0 && <span class="home-pregled-teaser-dot">·</span>}
                {last24h > 0 && <span>{last24h} {t('home.stats_posts_24h')}</span>}
                {typeof pluralismPct === 'number' && pluralismPct > 0 && (
                    <>
                        {(feeds > 0 || last24h > 0) && <span class="home-pregled-teaser-dot">·</span>}
                        <span>{t('home.pregled_cta_stat').replace('{pct}', String(pluralismPct))}</span>
                    </>
                )}
            </p>
        )}
    </div>
    <span class="home-pregled-teaser-action">
        {t('home.pregled_cta_action')}
        <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" />
    </span>
</a>

<style>
    .home-pregled-teaser-stat {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
    }

    .home-pregled-teaser-dot {
        opacity: 0.45;
    }
</style>
