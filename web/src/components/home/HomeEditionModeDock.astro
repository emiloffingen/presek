---
import { useTranslations } from '../../i18n/utils';

interface Props {
    lang: 'sr' | 'mk';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="home-mode-dock" data-home-mode-dock role="navigation" aria-label={t('home.edition_mode_nav_label')}>
    <div class="home-mode-dock-inner">
        <button
            type="button"
            class="home-mode-dock-btn is-active"
            data-home-mode-daily
            aria-pressed="true"
        >
            {t('home.mode_daily_short')}
        </button>
    </div>
</div>
