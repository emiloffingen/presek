---
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { chooseClusterImage } from '../../utils/imageSelection';

interface Props {
    synthesisPicks: NewsCluster[];
    lang?: keyof typeof ui;
}

const { synthesisPicks, lang: propLang } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader || undefined);
const lang = propLang || urlLang;
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

function getSourceBadgeLabel(count: number) {
    if (lang === 'sr') {
        if (count === 1) return '1 MEDIJ';
        if (count >= 2 && count <= 4) return `${count} MEDIJA`;
        return `${count} MEDIJA`;
    } else {
        if (count === 1) return '1 МЕДИУМ';
        return `${count} МЕДИУМИ`;
    }
}
---

{synthesisPicks && synthesisPicks.length > 0 && (
    <section class="synthesis-picks-section motion-rise">
        <div class="feed-section-container">
            <div class="section-heading-row masthead-double-rule">
                <div class="heading-badge">
                    <span class="pulse-glowing-dot"></span>
                    <span class="badge-text">{lang === 'sr' ? 'SISTEMSKA SINTEZA' : 'СИСТЕМСКА СИНТЕЗА'}</span>
                </div>
                <h2 class="section-heading font-serif">{t('home.synthesis_picks_title')}</h2>
                <p class="section-note mt-2 text-xs font-bold uppercase tracking-widest text-muted-foreground/80">
                    {t('home.synthesis_picks_desc')}
                </p>
            </div>

            <div class="synthesis-grid">
                {synthesisPicks.map((cluster) => {
                    const artCount = cluster.articles?.length || 0;
                    const pluralismVal = cluster.pluralism_score || 50;
                    const imageObj = chooseClusterImage(cluster, 'card');
                    const visualImage = imageObj.proxiedUrl || imageObj.fallbackUrl || imageObj.staticFallbackUrl;
                    
                    // Distinct pluralism grade/color
                    let gaugeColor = "from-sky-500 to-indigo-600 dark:from-sky-400 dark:to-indigo-500";
                    let pluralismText = lang === 'sr' ? 'Umeren' : 'Умерен';
                    if (pluralismVal >= 75) {
                        gaugeColor = "from-purple-500 to-pink-600 dark:from-purple-400 dark:to-pink-500";
                        pluralismText = lang === 'sr' ? 'Visok' : 'Висок';
                    } else if (pluralismVal >= 60) {
                        gaugeColor = "from-teal-500 to-emerald-600 dark:from-teal-400 dark:to-emerald-500";
                        pluralismText = lang === 'sr' ? 'Stabilan' : 'Стабилен';
                    }

                    // Extract unique sources for tag-cloud
                    const sources = Array.from(new Set((cluster.articles || []).map(a => a.source).filter(Boolean))).slice(0, 5);

                    return (
                        <div class="synthesis-card-wrapper">
                            <div class="synthesis-card">
                                {visualImage && (
                                    <div class="card-image-wrapper">
                                        <img src={visualImage} alt={cluster.synthetic_headline || ''} class="card-image" loading="lazy" />
                                        <div class="card-image-overlay"></div>
                                        <div class="source-count-badge">
                                            {getSourceBadgeLabel(artCount)}
                                        </div>
                                    </div>
                                )}
                                
                                <div class="card-content">
                                    <div class="card-header-row">
                                        <span class="category-tag">
                                            {cluster.articles?.[0]?.category || 'Tema'}
                                        </span>
                                        <div class="synthesis-badge">
                                            <div class="soundwave-mini">
                                                <span class="bar bar-1"></span>
                                                <span class="bar bar-2"></span>
                                                <span class="bar bar-3"></span>
                                            </div>
                                            <span class="synthesis-badge-text">
                                                {lang === 'sr' ? 'SINTEZA' : 'СИНТЕЗА'}
                                            </span>
                                        </div>
                                    </div>

                                    <a href={l(`/cluster/${cluster.cluster_id}`)} class="block group/title">
                                        <h3 class="card-title font-serif">
                                            {cluster.synthetic_headline || cluster.articles?.[0]?.title}
                                        </h3>
                                    </a>

                                    <p class="card-description font-serif italic text-muted-foreground leading-relaxed">
                                        {cluster.synthetic_standfirst || cluster.articles?.[0]?.description || ''}
                                    </p>

                                    {/* Pluralism Metric */}
                                    <div class="pluralism-metric-box">
                                        <div class="metric-info">
                                            <span class="metric-label">{lang === 'sr' ? 'Medijski pluralizam:' : 'Медиумски плурализам:'}</span>
                                            <span class="metric-value font-black">{pluralismText} ({pluralismVal}%)</span>
                                        </div>
                                        <div class="metric-bar-container">
                                            <div class={`metric-bar-fill bg-gradient-to-r ${gaugeColor}`} style={`width: ${pluralismVal}%`}></div>
                                        </div>
                                    </div>

                                    {/* Compiled Sources Cloud */}
                                    {sources.length > 0 && (
                                        <div class="sources-cloud">
                                            <span class="sources-label">{lang === 'sr' ? 'Sinteza izvora:' : 'Синтеза на извори:'}</span>
                                            <div class="sources-tags">
                                                {sources.map(src => (
                                                    <span class="source-tag">{src}</span>
                                                ))}
                                                {cluster.articles && cluster.articles.length > 5 && (
                                                    <span class="source-tag-more">+{cluster.articles.length - 5}</span>
                                                )}
                                            </div>
                                        </div>
                                    )}
                                </div>

                                <div class="card-footer">
                                    <a href={l(`/cluster/${cluster.cluster_id}`)} class="read-synthesis-link">
                                        <span>{lang === 'sr' ? 'Otvori sintezu' : 'Отвори синтеза'}</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>
)}

<style>
    .synthesis-picks-section {
        margin-top: 5rem;
        margin-bottom: 5rem;
        position: relative;
    }

    .feed-section-container {
        padding: 3.5rem 2rem;
        background: linear-gradient(180deg, 
            color-mix(in srgb, var(--background) 96%, var(--nyt-accent)) 0%, 
            color-mix(in srgb, var(--background) 99%, var(--nyt-accent)) 100%);
        border-radius: 24px;
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.05);
    }

    :global(.dark) .feed-section-container {
        background: linear-gradient(180deg, 
            rgba(20, 24, 38, 0.4) 0%, 
            rgba(15, 18, 28, 0.2) 100%);
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.3);
    }

    .section-heading-row {
        text-align: center;
        margin-bottom: 3.5rem;
        position: relative;
        padding-bottom: 2rem;
    }

    .section-heading-row::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--nyt-accent), transparent);
    }

    .heading-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 20%, transparent);
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--nyt-accent) 10%, transparent);
    }

    .pulse-glowing-dot {
        width: 8px;
        height: 8px;
        background-color: var(--nyt-accent);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--nyt-accent);
        animation: pulse-glow 2s infinite;
    }

    @keyframes pulse-glow {
        0% { transform: scale(0.85); opacity: 0.6; }
        50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 14px var(--nyt-accent); }
        100% { transform: scale(0.85); opacity: 0.6; }
    }

    .badge-text {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        letter-spacing: 0.22em;
        color: var(--nyt-accent);
        text-transform: uppercase;
    }

    .section-heading {
        font-size: 2.5rem;
        font-weight: 950;
        letter-spacing: -0.03em;
        color: var(--foreground);
        line-height: 1.1;
    }

    .section-note {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.18em;
        color: var(--muted-foreground);
        text-transform: uppercase;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.5;
    }

    .synthesis-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 3rem;
        margin-top: 2rem;
    }

    @media (min-width: 768px) {
        .synthesis-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2.5rem;
        }
    }

    @media (min-width: 1200px) {
        .synthesis-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 3.5rem;
        }
    }

    .synthesis-card-wrapper {
        perspective: 1200px;
    }

    .synthesis-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: color-mix(in srgb, var(--background) 95%, var(--accent-color, #ffffff));
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), 
                    box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1), 
                    border-color 0.4s;
        box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.05);
    }

    :global(.dark) .synthesis-card {
        background: rgba(25, 29, 44, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 15px 35px -20px rgba(0, 0, 0, 0.4);
    }

    .synthesis-card:hover {
        transform: translateY(-8px) scale(1.01);
        border-color: color-mix(in srgb, var(--nyt-accent) 45%, transparent);
        box-shadow: 0 25px 50px -15px color-mix(in srgb, var(--nyt-accent) 8%, rgba(0, 0, 0, 0.12));
    }

    :global(.dark) .synthesis-card:hover {
        box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6), 
                    0 0 40px -10px rgba(158, 42, 43, 0.15);
    }

    .card-image-wrapper {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        background-color: color-mix(in srgb, var(--foreground) 5%, transparent);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .synthesis-card:hover .card-image {
        transform: scale(1.06);
    }

    .card-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.5) 100%);
    }

    .source-count-badge {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        background: rgba(15, 13, 12, 0.82);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #ffffff;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-md, 0px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    }

    .card-content {
        padding: 2rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .card-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .category-tag {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--nyt-accent);
    }

    .synthesis-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: color-mix(in srgb, var(--nyt-accent) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 25%, transparent);
        padding: 0.25rem 0.6rem;
        border-radius: var(--radius-md, 0px);
    }

    .synthesis-badge-text {
        font-family: var(--font-sans);
        font-size: 0.55rem;
        font-weight: 950;
        letter-spacing: 0.1em;
        color: var(--nyt-accent);
    }

    /* Soundwave Mini Animation */
    .soundwave-mini {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        width: 11px;
        height: 10px;
    }

    .soundwave-mini .bar {
        width: 2px;
        background-color: var(--nyt-accent);
        border-radius: 1px;
        animation: soundwave-bounce 0.8s infinite ease-in-out alternate;
    }

    .soundwave-mini .bar-1 { height: 30%; animation-delay: 0.1s; }
    .soundwave-mini .bar-2 { height: 60%; animation-delay: 0.3s; }
    .soundwave-mini .bar-3 { height: 40%; animation-delay: 0.2s; }

    @keyframes soundwave-bounce {
        0% { height: 25%; }
        100% { height: 100%; }
    }

    .card-title {
        font-size: 1.45rem;
        font-weight: 850;
        line-height: 1.25;
        color: var(--foreground);
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        transition: color 0.3s;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .synthesis-card:hover .card-title {
        color: var(--nyt-accent);
    }

    .card-description {
        font-size: 0.88rem;
        line-height: 1.6;
        margin-bottom: 1.75rem;
        color: var(--muted-foreground);
        opacity: 0.95;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .pluralism-metric-box {
        background: color-mix(in srgb, var(--foreground) 2%, transparent);
        border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        margin-top: auto;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .metric-info {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-sans);
        font-size: 0.68rem;
        margin-bottom: 0.5rem;
    }

    .metric-label {
        color: var(--muted-foreground);
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .metric-value {
        color: var(--foreground);
        font-weight: 900;
    }

    .metric-bar-container {
        width: 100%;
        height: 6px;
        background: color-mix(in srgb, var(--foreground) 8%, transparent);
        border-radius: 99px;
        overflow: hidden;
    }

    .metric-bar-fill {
        height: 100%;
        border-radius: 99px;
    }

    .sources-cloud {
        margin-bottom: 0.5rem;
    }

    .sources-label {
        display: block;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted-foreground);
        margin-bottom: 0.6rem;
    }

    .sources-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .source-tag {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 800;
        background: color-mix(in srgb, var(--foreground) 4%, transparent);
        color: var(--muted-foreground);
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-sm, 0px);
        border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
        transition: all 0.2s;
    }

    .synthesis-card:hover .source-tag {
        background: color-mix(in srgb, var(--foreground) 7%, transparent);
        color: var(--foreground);
    }

    .source-tag-more {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 900;
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        color: var(--nyt-accent);
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-sm, 0px);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 15%, transparent);
    }

    .card-footer {
        padding: 1.25rem 2rem 2rem;
        border-top: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
        background: color-mix(in srgb, var(--foreground) 1%, transparent);
    }

    .read-synthesis-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        background: color-mix(in srgb, var(--foreground) 4%, transparent);
        border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        padding: 0.75rem;
        border-radius: 10px;
        font-family: var(--font-sans);
        font-size: 0.82rem;
        font-weight: 900;
        color: var(--foreground);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .read-synthesis-link:hover {
        background: var(--nyt-accent);
        border-color: var(--nyt-accent);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 10px 20px -8px color-mix(in srgb, var(--nyt-accent) 40%, transparent);
    }

    .arrow-icon {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .read-synthesis-link:hover .arrow-icon {
        transform: translateX(4px);
    }
</style>
