---
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { localePath, homePath } from '../../lib/localePaths';
import type { ui } from '../../i18n/ui';
import { chooseClusterImage } from '../../utils/imageSelection';
import { getStoryPreviewText } from '../../utils/textUtils';
import { ArrowRight } from 'lucide-react';

interface Props {
    synthesisPicks: NewsCluster[];
    lang?: keyof typeof ui;
    defaultOpen?: boolean;
}

const { synthesisPicks, lang: propLang, defaultOpen = false } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const urlLang = getLangFromUrl(Astro.url, hostHeader || undefined);
const lang = propLang || urlLang;
const t = useTranslations(lang);
const l = (path: string) => localePath(path, lang, hostHeader);

function getSourceBadgeLabel(count: number) {
    if (count === 1) return t('home.synthesis_source_one');
    return t('home.synthesis_source_other', { count });
}

function getClusterUrl(cluster: NewsCluster) {
    return l(`/cluster/${cluster.cluster_id}`);
}

function getPluralismLabel(value: number) {
    if (value >= 75) return t('home.pluralism_high');
    if (value >= 60) return t('home.pluralism_stable');
    return t('home.pluralism_moderate');
}

const synthesisTeaser = synthesisPicks[0]?.synthetic_headline || synthesisPicks[0]?.articles?.[0]?.title || '';
---

{synthesisPicks && synthesisPicks.length > 0 && (
    <details class="synthesis-picks-details" data-synthesis-band open={defaultOpen || undefined}>
        <summary class="synthesis-picks-summary" aria-label={t('home.synthesis_picks_title')}>
            <span class="synthesis-picks-summary-label">
                <span class="badge-text">{t('home.synthesis_system_badge')}</span>
                <strong>{t('home.synthesis_picks_title')}</strong>
                {synthesisTeaser && (
                    <span class="synthesis-picks-teaser">{t('home.analysis_teaser_lead')} {synthesisTeaser}</span>
                )}
            </span>
            <span class="synthesis-picks-summary-meta">
                <span class="synthesis-picks-count">{synthesisPicks.length}</span>
                <span>{t('home.analysis_expand')}</span>
            </span>
        </summary>
    <section class="synthesis-picks-section">
        <div class="feed-section-container">
            <p class="section-note synthesis-picks-note">
                {t('home.synthesis_picks_desc')}
            </p>

            <div class="synthesis-grid">
                {synthesisPicks.map((cluster) => {
                    const artCount = cluster.articles?.length || 0;
                    const pluralismVal = cluster.pluralism_score || 50;
                    const imageObj = chooseClusterImage(cluster, 'card', lang as 'sr' | 'mk');
                    const visualImage = imageObj.proxiedUrl;
                    const fallbackImageUrl = imageObj.fallbackUrl;
                    const sourceNames = Array.from(new Set((cluster.articles || []).map(a => a.source).filter(Boolean))).slice(0, 2);
                    const primaryMeta = [
                        getSourceBadgeLabel(artCount),
                        getPluralismLabel(pluralismVal),
                    ].filter(Boolean).join(' / ');

                    return (
                        <article class:list={["synthesis-card", { "synthesis-card-text-first": !visualImage }]}>
                            <a href={getClusterUrl(cluster)} class="synthesis-card-link">
                                {visualImage && (
                                    <div class="card-image-wrapper">
                                        <img
                                            src={visualImage}
                                            alt={cluster.synthetic_headline || ''}
                                            class="card-image article-image"
                                            loading="lazy"
                                            decoding="async"
                                            width="640"
                                            height="427"
                                            data-fallback-url={fallbackImageUrl}
                                            onload="this.classList.add('is-loaded');"
                                        />
                                    </div>
                                )}

                                <div class="card-content">
                                    <div class="card-header-row">
                                        <span class="category-tag">
                                            {cluster.articles?.[0]?.category || 'Tema'}
                                        </span>
                                        <div class="synthesis-badges">
                                            <span class="synthesis-badge">{t('home.synthesis_badge_upper')}</span>
                                            {cluster.has_audio && (
                                                <span class="synthesis-audio-badge">{t('home.synthesis_audio_badge')}</span>
                                            )}
                                        </div>
                                    </div>

                                    <h3 class="card-title font-serif">
                                        {cluster.synthetic_headline || cluster.articles?.[0]?.title}
                                    </h3>

                                    <p class="card-description font-serif italic text-muted-foreground leading-relaxed">
                                        {getStoryPreviewText(cluster, cluster.articles?.[0], lang)}
                                    </p>

                                    <div class="card-meta-row">
                                        <span>{primaryMeta}</span>
                                        {sourceNames.length > 0 && <span>{sourceNames.join(' + ')}</span>}
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <span>{t('home.synthesis_teaser_action')}</span>
                                    <ArrowRight size={16} strokeWidth={2.5} />
                                </div>
                            </a>
                        </article>
                    );
                })}
            </div>
        </div>
    </section>
    </details>
)}

<style>
    .synthesis-picks-details {
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
    }

    .synthesis-picks-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 0;
        border-top: 2px solid color-mix(in srgb, var(--foreground) 14%, var(--border));
        border-bottom: 1px solid color-mix(in srgb, var(--foreground) 10%, var(--border));
        cursor: pointer;
        list-style: none;
    }

    .synthesis-picks-summary::-webkit-details-marker {
        display: none;
    }

    .synthesis-picks-summary-label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-align: left;
    }

    .synthesis-picks-summary-label strong {
        font-family: var(--font-serif);
        font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.85rem);
        line-height: 1.05;
        font-weight: 800;
    }

    .synthesis-picks-teaser {
        font-family: var(--font-serif);
        font-size: 0.82rem;
        line-height: 1.4;
        color: var(--muted-foreground);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .synthesis-picks-summary-meta {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-sans);
        font-size: 0.64rem;
        font-weight: 850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }

    .synthesis-picks-count {
        padding: 0.12rem 0.4rem;
        border: 1px solid var(--border);
    }

    .synthesis-picks-details:not([open]) .synthesis-picks-section {
        display: none;
    }

    .synthesis-picks-note {
        margin: 0 0 1.5rem;
    }

    .synthesis-picks-section {
        margin-top: 0;
        margin-bottom: 2rem;
        position: relative;
    }

    .feed-section-container {
        padding: 2.75rem 0 0;
        background: transparent;
        border-top: 2px solid color-mix(in srgb, var(--foreground) 14%, var(--border));
    }

    :global(.dark) .feed-section-container {
        background: transparent;
        border-color: color-mix(in srgb, var(--foreground) 12%, var(--border));
        box-shadow: none;
    }

    .section-heading-row {
        text-align: left;
        margin-bottom: 1.75rem;
        position: relative;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid color-mix(in srgb, var(--foreground) 10%, var(--border));
    }

    .heading-badge {
        display: inline-flex;
        align-items: center;
        margin-bottom: 0.65rem;
    }

    .synthesis-badges {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .synthesis-audio-badge {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--nyt-accent);
        border: 1px solid color-mix(in srgb, var(--nyt-accent) 35%, var(--border));
        padding: 0.15rem 0.45rem;
    }

    .badge-text {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.04em;
        color: var(--nyt-accent);
        text-transform: none;
    }

    .section-heading {
        font-size: clamp(2rem, 4vw, 3.1rem);
        font-weight: 950;
        letter-spacing: 0;
        color: var(--foreground);
        line-height: 1;
    }

    .section-note {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        font-weight: 750;
        letter-spacing: 0;
        color: var(--muted-foreground);
        text-transform: none;
        max-width: 42rem;
        margin-left: 0;
        margin-right: 0;
        line-height: 1.55;
    }

    .synthesis-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.25rem;
        margin-top: 1.5rem;
    }

    @media (min-width: 768px) {
        .synthesis-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.5rem;
        }
    }

    @media (min-width: 1200px) {
        .synthesis-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.75rem;
        }
    }

    .synthesis-card {
        min-width: 0;
        height: 100%;
        border: 1px solid color-mix(in srgb, var(--foreground) 11%, var(--border));
        background: color-mix(in srgb, var(--card) 96%, var(--background));
        box-shadow: inset 0 1px 0 color-mix(in srgb, var(--foreground) 4%, transparent);
        transition: transform 0.24s var(--ease-editorial), border-color 0.24s var(--ease-editorial), box-shadow 0.24s var(--ease-editorial);
    }

    .synthesis-card-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        color: inherit;
        text-decoration: none;
        overflow: hidden;
    }

    :global(.dark) .synthesis-card {
        background: color-mix(in srgb, var(--card) 92%, var(--background));
        border-color: color-mix(in srgb, var(--foreground) 10%, var(--border));
        box-shadow: none;
    }

    .synthesis-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--nyt-red) 38%, var(--border));
        box-shadow: var(--shadow-md);
    }

    .synthesis-card-text-first {
        border-left: 3px solid color-mix(in srgb, var(--nyt-red) 58%, var(--border));
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--nyt-red) 4%, transparent), transparent 42%),
            var(--card);
    }

    .synthesis-card-text-first .card-content {
        padding-top: 1.45rem;
    }

    :global(.dark) .synthesis-card:hover {
        box-shadow: 0 16px 34px -24px rgba(0, 0, 0, 0.7);
    }

    .card-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: color-mix(in srgb, var(--foreground) 5%, transparent);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.36s var(--ease-editorial);
    }

    .synthesis-card:hover .card-image {
        transform: scale(1.025);
    }

    .card-content {
        padding: 1.25rem 1.25rem 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .card-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.85rem;
    }

    .category-tag {
        font-family: var(--font-sans);
        font-size: 0.63rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--nyt-red);
    }

    .synthesis-badge {
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        color: color-mix(in srgb, var(--foreground) 52%, var(--muted-foreground));
    }

    .card-title {
        font-size: clamp(1.35rem, 2.2vw, 1.65rem);
        font-weight: 850;
        line-height: 1.16;
        color: var(--foreground);
        margin-bottom: 0.8rem;
        letter-spacing: 0;
        transition: color 0.3s;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .synthesis-card:hover .card-title {
        color: var(--nyt-red);
    }

    .card-description {
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        color: var(--muted-foreground);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-meta-row {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        gap: 0.85rem;
        font-family: var(--font-sans);
        font-size: 0.66rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        line-height: 1.35;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }

    .card-meta-row span:last-child {
        text-align: right;
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        padding: 0.95rem 1.25rem;
        border-top: 1px solid color-mix(in srgb, var(--foreground) 9%, var(--border));
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 900;
        color: color-mix(in srgb, var(--foreground) 78%, var(--muted-foreground));
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: color 0.24s var(--ease-editorial), background-color 0.24s var(--ease-editorial);
    }

    .synthesis-card:hover .card-footer {
        color: var(--nyt-red);
        background: color-mix(in srgb, var(--nyt-red) 5%, transparent);
    }

    .card-footer :global(svg) {
        flex: 0 0 auto;
        transition: transform 0.24s var(--ease-editorial);
    }

    .synthesis-card:hover .card-footer :global(svg) {
        transform: translateX(4px);
    }

    @media (max-width: 639px) {
        .synthesis-picks-section {
            margin-top: 3.25rem;
            margin-bottom: 3.5rem;
        }

        .feed-section-container {
            padding-top: 2rem;
        }

        .section-heading-row {
            margin-bottom: 1.25rem;
        }

        .card-content {
            padding: 1.05rem 1rem 0.9rem;
        }

        .card-meta-row {
            flex-direction: column;
            gap: 0.35rem;
        }

        .card-meta-row span:last-child {
            text-align: left;
        }
    }
</style>
