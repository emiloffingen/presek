---
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
    title: string;
    note: string;
    developmentsFeatured: NewsCluster[];
    developmentsCompact: NewsCluster[];
    variant?: "compact" | "wire";
    tone?: "default" | "global" | "developing" | "wire";
}

const { title, note, developmentsFeatured, developmentsCompact, variant = "compact", tone = "default" } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

function getBentoSpan(cluster: NewsCluster) {
    const count = Number((cluster as any).sources_count || (cluster as any).source_count || cluster.articles?.length || 0);
    const importanceScore = cluster.importance_score || 0;
    if (count >= 6 || importanceScore > 0.85) return '2x2';
    if (count >= 4 || importanceScore > 0.65) return '2x1';
    return '1x1';
}
---

<section class:list={["feed-section motion-rise motion-delay-3", `feed-tone-${tone}`]}>
    <div class="feed-section-container">
        <div class="editorial-divider">
            <span class="editorial-ornament">◆</span>
        </div>
        <div class="section-heading-row masthead-double-rule">
            <p class="section-kicker">
                {tone === 'global' ? t('home.tone_global') : tone === 'wire' ? t('home.tone_wire') : tone === 'developing' ? t('home.tone_developing') : t('home.tone_default')}
            </p>
            <h2 class="section-title">
                {variant === 'wire' && <span class="inline-block w-2.5 h-2.5 bg-nyt-red rounded-full mr-2 mb-0.5 animate-pulse" title={t('home.wire_live_updates')}></span>}
                {title}
            </h2>
            <p class="section-note">{note}</p>
        </div>
        {variant === "wire" ? (
            developmentsFeatured.length > 0 && (
                <div class="news-feed-grid wire-stack">
                    {developmentsFeatured.map((cluster: NewsCluster, idx: number) => (
                        <div class="developments-card bento-1x1" style={`animation-delay: ${idx * 0.06}s`}>
                            <NewsCard cluster={cluster} variant="wire" lang={lang} />
                        </div>
                    ))}
                </div>
            )
        ) : (
            <div class="bento-box-grid">
                {developmentsFeatured.map((cluster: NewsCluster, idx: number) => {
                    const span = getBentoSpan(cluster);
                    return (
                        <div class:list={["developments-card", `bento-${span}`]} style={`animation-delay: ${idx * 0.08}s`}>
                            <NewsCard cluster={cluster} variant="featured" bentoSpan={span} lang={lang} />
                        </div>
                    );
                })}
                {developmentsCompact.map((cluster: NewsCluster, idx: number) => (
                    <div class="developments-card bento-1x1" style={`animation-delay: ${(developmentsFeatured.length + idx) * 0.06}s`}>
                        <NewsCard cluster={cluster} variant="compact" lang={lang} />
                    </div>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .feed-section-container {
        padding: 2rem 1.5rem;
    }

    /* ── Editorial Divider ──────────────────────────── */
    .editorial-divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .editorial-divider::before,
    .editorial-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }
    .editorial-ornament {
        font-size: 0.45rem;
        color: var(--muted-foreground);
        opacity: 0.4;
    }

    /* ── Section Heading ────────────────────────────── */
    .feed-section .section-heading-row {
        margin-bottom: 1rem;
        position: relative;
    }

    /* ── Tone Variants ──────────────────────────────── */
    .feed-tone-global {
        background: color-mix(in srgb, #0f766e 3%, transparent);
        border-left: 4px solid #0f766e;
        border-top: 1px solid color-mix(in srgb, #0f766e 10%, transparent);
        border-bottom: 1px solid color-mix(in srgb, #0f766e 10%, transparent);
    }

    .feed-tone-developing {
        background: color-mix(in srgb, #9a3412 3%, transparent);
        border-left: 4px solid #9a3412;
        border-top: 1px solid color-mix(in srgb, #9a3412 10%, transparent);
        border-bottom: 1px solid color-mix(in srgb, #9a3412 10%, transparent);
    }

    .feed-tone-wire {
        border-left: 4px solid var(--nyt-red);
        border-top: 1px solid color-mix(in srgb, var(--nyt-red) 10%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--nyt-red) 10%, transparent);
    }

    /* ── Kickers ────────────────────────────────────── */
    .section-kicker {
        margin: 0 0 0.15rem;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--nyt-accent);
    }

    .feed-section .section-title {
        font-family: var(--font-serif);
        font-size: clamp(1.2rem, 1rem + 0.6vw, 1.8rem);
        font-weight: 900;
        font-style: italic;
        line-height: 1.05;
        margin-bottom: 0.25rem;
    }

    .feed-section .section-note {
        max-width: 42rem;
        font-family: var(--font-nyt-body);
        font-size: 0.85rem;
        font-weight: 400;
        letter-spacing: 0.01em;
        text-transform: none;
        line-height: 1.5;
        color: var(--muted-foreground);
    }

    .feed-tone-global .section-kicker { color: #0f766e; }
    .feed-tone-wire .section-kicker { color: var(--nyt-red); }
    .feed-tone-developing .section-kicker { color: #9a3412; }

    .feed-tone-global .editorial-ornament { color: #0f766e; opacity: 0.6; }
    .feed-tone-developing .editorial-ornament { color: #9a3412; opacity: 0.6; }
    .feed-tone-wire .editorial-ornament { color: var(--nyt-red); opacity: 0.6; }

    /* ── Card Entrance Animations ───────────────────── */
    .developments-card {
        opacity: 0;
        transform: translateY(8px);
        animation: cardReveal 0.5s var(--ease-editorial, ease) forwards;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .developments-card > * {
        flex-grow: 1;
        height: 100%;
    }

    @keyframes cardReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 640px) {
        .feed-section .section-heading-row {
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
        }

        .feed-section .section-title {
            font-size: 1.25rem;
        }

        .feed-section .section-note {
            font-size: 0.8rem;
            line-height: 1.4;
        }
    }
</style>
