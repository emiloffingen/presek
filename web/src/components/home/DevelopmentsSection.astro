---
import NewsCard from '../NewsCard.astro';
import type { NewsCluster } from '../../types';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
    title: string;
    note: string;
    developmentsFeatured: NewsCluster[];
    developmentsCompact: NewsCluster[];
    variant?: "compact" | "wire";
    tone?: "default" | "global" | "developing" | "wire";
}

const { title, note, developmentsFeatured, developmentsCompact, variant = "compact", tone = "default" } = Astro.props;
const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);

function getBentoSpan(cluster: NewsCluster) {
    const count = cluster.articles?.length || 0;
    if (count >= 6 || cluster.importance_score > 0.85) return '2x2';
    if (count >= 4 || cluster.importance_score > 0.65) return '2x1';
    return '1x1';
}
---

<section class:list={["feed-section motion-rise motion-delay-3", `feed-tone-${tone}`]}>
    <div class="section-heading-row masthead-double-rule">
        <p class="section-kicker">
            {tone === 'global' ? t('home.tone_global') : tone === 'wire' ? t('home.tone_wire') : tone === 'developing' ? t('home.tone_developing') : t('home.tone_default')}
        </p>
        <h2 class="section-title">
            {variant === 'wire' && <span class="inline-block w-2.5 h-2.5 bg-nyt-red rounded-full mr-2 mb-0.5 animate-pulse" title={t('home.wire_live_updates')}></span>}
            {title}
        </h2>
        <p class="section-note">{note}</p>
    </div>
    {variant === "wire" ? (
        developmentsFeatured.length > 0 && (
            <div class="news-feed-grid wire-stack">
                {developmentsFeatured.map((cluster: NewsCluster) => (
                    <NewsCard cluster={cluster} variant="wire" />
                ))}
            </div>
        )
    ) : (
        <Fragment>
            {developmentsFeatured.length > 0 && (
                <div class="bento-box-grid">
                    {developmentsFeatured.map((cluster: NewsCluster) => (
                        <NewsCard cluster={cluster} variant="featured" bentoSpan={getBentoSpan(cluster)} />
                    ))}
                </div>
            )}
            {developmentsCompact.length > 0 && (
                <div class="news-feed-grid news-feed-grid-compact mt-8">
                    {developmentsCompact.map((cluster: NewsCluster) => (
                        <NewsCard cluster={cluster} variant="compact" />
                    ))}
                </div>
            )}
        </Fragment>
    )}
</section>

<style>
    .feed-section .section-heading-row {
        margin-bottom: 1rem;
        position: relative;
    }

    .feed-tone-global {
        background: color-mix(in srgb, #0f766e 3%, transparent);
        padding: 1rem 0.5rem;
        border-y: 1px solid color-mix(in srgb, #0f766e 10%, transparent);
    }

    .feed-tone-developing {
        background: color-mix(in srgb, #9a3412 3%, transparent);
        padding: 1rem 0.5rem;
        border-y: 1px solid color-mix(in srgb, #9a3412 10%, transparent);
    }

    .section-kicker {
        margin: 0 0 0.15rem;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--nyt-accent);
    }

    .feed-section .section-title {
        font-family: var(--font-serif);
        font-size: clamp(1.2rem, 1rem + 0.6vw, 1.8rem);
        font-weight: 900;
        font-style: italic;
        line-height: 1.05;
        margin-bottom: 0.25rem;
    }

    .feed-section .section-note {
        max-width: 42rem;
        font-family: var(--font-nyt-body);
        font-size: 0.85rem;
        font-weight: 400;
        letter-spacing: 0.01em;
        text-transform: none;
        line-height: 1.5;
        color: var(--muted-foreground);
    }

    .feed-tone-global .section-kicker {
        color: #0f766e;
    }

    .feed-tone-wire .section-kicker {
        color: var(--nyt-red);
    }

    .feed-tone-developing .section-kicker {
        color: #9a3412;
    }

    @media (max-width: 640px) {
        .feed-section .section-heading-row {
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
        }

        .feed-section .section-title {
            font-size: 1.25rem;
        }

        .feed-section .section-note {
            font-size: 0.8rem;
            line-height: 1.4;
        }
    }
</style>
