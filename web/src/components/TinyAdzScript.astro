---
import { tinyAdzTestMode, TINYADZ_SCRIPT_URL } from '../lib/tinyadz';

interface Props {
  siteId: string;
  cspNonce: string;
}

const { siteId, cspNonce } = Astro.props;
const testMode = String(tinyAdzTestMode());
---

<script is:inline nonce={cspNonce} define:vars={{ siteId, testMode, scriptUrl: TINYADZ_SCRIPT_URL }}>
	(function loadTinyAdz() {
		const globalKey = '__PRESEK_TINYADZ_LOADED__';
		if (window[globalKey]) {
			if (window.$tam && typeof window.$tam.requestNextAd === 'function') {
				window.$tam.requestNextAd();
			}
			return;
		}
		window[globalKey] = true;

		const script = document.createElement('script');
		script.src = scriptUrl;
		script.async = true;
		script.setAttribute('site-id', siteId);
		script.setAttribute('data-site-id', siteId);
		script.setAttribute('data-test-mode', testMode);
		script.setAttribute('data-tinyadz-loader', 'presek');
		document.head.appendChild(script);
	})();

	document.addEventListener('astro:page-load', () => {
		if (window.$tam && typeof window.$tam.requestNextAd === 'function') {
			window.$tam.requestNextAd();
		}
	});
</script>
