---
// Performance-optimized image component with lazy loading and responsive srcset

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  className?: string;
  priority?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  className = '',
  priority = false,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px'
} = Astro.props;

// Generate srcset with width-based URL params
// Assumes the image server supports ?w=N query param for resizing
const srcsetWidths = [400, 800, 1200, 1600];
const srcset = srcsetWidths
  .map((w) => {
    const separator = src.includes('?') ? '&' : '?';
    return `${src}${separator}w=${w} ${w}w`;
  })
  .join(', ');

const loading = priority ? 'eager' : 'lazy';
const fetchPriority = priority ? 'high' : 'auto';
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  srcset={srcset}
  sizes={sizes}
  loading={loading}
  fetchpriority={fetchPriority}
  decoding="async"
/>

<style>
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>