---
import { formatStoryFreshness } from '../utils/storyFreshness';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'sr' | 'mk';
  synthesisUpdatedAt?: string | null;
  latestArticleAt?: string | null;
  isStale?: boolean;
  newArticleCount?: number;
  pipelineBusy?: boolean;
  missingSynthesis?: boolean;
  class?: string;
}

const {
  lang,
  synthesisUpdatedAt = null,
  latestArticleAt = null,
  isStale = false,
  newArticleCount = 0,
  pipelineBusy = false,
  missingSynthesis = false,
  class: className = '',
} = Astro.props;

const t = useTranslations(lang);
const freshness = formatStoryFreshness(
  {
    lang,
    synthesisUpdatedAt,
    latestArticleAt,
    isStale,
    newArticleCount,
    pipelineBusy,
    missingSynthesis,
  },
  t as (key: string, params?: Record<string, string | number>) => string,
);
---

{freshness && (
  <span
    class:list={[
      'story-freshness-badge inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest',
      freshness.tone === 'fresh' && 'border-nyt-accent/30 bg-nyt-accent/10 text-nyt-accent',
      freshness.tone === 'pending' && 'border-nyt-accent/30 bg-nyt-accent/10 text-nyt-accent',
      freshness.tone === 'aging' && 'border-border bg-muted/40 text-muted-foreground',
      freshness.tone === 'stale' && 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-300',
      className,
    ]}
    aria-label={freshness.ariaLabel}
  >
    {freshness.label}
  </span>
)}
