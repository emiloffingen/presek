---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import { Sparkles, BarChart3, Radio, ShieldCheck } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';
import { getEditionStr } from '../utils/textUtils';
import Branding from './Branding.astro';

interface Props {
    category?: string | null;
    topic?: string | null;
    entity?: string | null;
    subcategory?: string | null;
    q?: string | null;
    stats?: any | null;
}

const { category, topic, entity, subcategory, q, stats: propStats } = Astro.props;

const currentDate = new Intl.DateTimeFormat('mk-MK', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}).format(new Date());

const currentEdition = getEditionStr(new Date());

const API_URL = apiBaseUrl();

interface NavItem {
    label: string;
    href: string;
}

let navigationData: { breaking: NavItem[]; sections: any[] } = { breaking: [], sections: [] };
let stats = propStats;
let latestTickerItems: any[] = [];

try {
    const requests = [fetch(`${API_URL}/navigation`)];
    const shouldFetchStats = !stats || typeof stats.last_1h !== 'number' || typeof stats.total_feeds === 'undefined';
    if (shouldFetchStats) {
        requests.push(fetch(`${API_URL}/stats/summary`));
    }

    const results = await Promise.allSettled(requests);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (shouldFetchStats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }

    if (!navigationData.breaking.length) {
        const latestRes = await fetch(`${API_URL}/news?page_size=8&sort=recent`);
        if (latestRes.ok) {
            const latestData = await latestRes.json();
            latestTickerItems = (latestData?.clusters || []).map((cluster: any) => {
                const lead = Array.isArray(cluster?.articles) ? cluster.articles[0] : null;
                return {
                    label: cluster?.synthetic_headline || lead?.title || 'Најнова вест',
                    href: `/cluster/${cluster?.cluster_id}`,
                    type: cluster?.is_breaking ? 'breaking' : 'latest',
                    created_at: lead?.ingested_at || lead?.created_at || null,
                };
            }).filter((item: any) => item.href && item.label).slice(0, 6);
        }
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const hasBreaking = navigationData.breaking.length > 0;
const breakingItems = hasBreaking ? navigationData.breaking.slice(0, 5) : latestTickerItems;
const hasTicker = breakingItems.length > 0;
const visibleSections = (navigationData.sections || []).filter((section: any) => Array.isArray(section?.items) && section.items.length > 0);

// Idea A: Verification Counter Logic
const intel = stats?.intelligence;
const totalClusters = intel?.pluralism?.total_clusters || 0;
const highConsensusPct = intel?.pluralism?.high_consensus_pct || 0;
const pluralismPct = intel?.pluralism?.pluralism_pct || 0;
const hasDispatchStats = Boolean(stats && intel?.pluralism);

const confirmedFacts = Math.max(0, Math.round(totalClusters * (highConsensusPct / 100) * 4));
const activeConflicts = Math.max(0, Math.round(totalClusters * (1 - pluralismPct / 100) * 0.5));
const totalFeeds = stats?.total_feeds || 0;

function getRelativeTimeStr(dateStr?: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'ШТОТУКУ';
        if (diffMins < 60) return `${diffMins} МИН`;
        
        return date.toLocaleTimeString('mk-MK', { 
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Skopje' 
        });
    } catch {
        return '';
    }
}
---

<div class="header-sticky-wrapper" id="main-header">
    {hasTicker && (
    <div class="unified-dispatch-bar">
        <div class="dispatch-container site-layout">
            <div class="unified-ticker-track-wrap">
                <div class="unified-ticker-track">
                    <div class="ticker-content-segment">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                    {/* Duplicate for seamless looping */}
                    <div class="ticker-content-segment" aria-hidden="true">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </div>
    )}

    <header class="editorial-topbar site-layout">
        <div class="topbar-main">
            <div class="topbar-left-stack">
                <div class="search-entry">
                    <SearchIsland initialQuery={q} client:idle />
                </div>
                <div class="flex items-center gap-3">
                    <time class="topbar-date-display">{currentDate}</time>
                </div>
            </div>

            <div class="topbar-branding">
                <a href="/" class="brand-link">
                    <Branding mode="full" />
                </a>
            </div>

            <div class="topbar-actions">
                <div class="topbar-modes-rail">
                    <a href="/briefing" class={`mode-link ${Astro.url.pathname === '/briefing' ? 'is-active' : ''}`}>
                        <Radio size={11} strokeWidth={2.5} /> <span class="hidden sm:inline">Брифинг</span>
                    </a>
                    <a href="/archive" class={`mode-link ${Astro.url.pathname === '/archive' ? 'is-active' : ''}`}>
                        <Sparkles size={11} strokeWidth={2.5} /> <span class="hidden sm:inline">Архива</span>
                    </a>
                    <a href="/pulse" class={`mode-link ${Astro.url.pathname === '/pulse' ? 'is-active' : ''}`}>
                        <BarChart3 size={11} strokeWidth={2.5} /> <span class="hidden sm:inline">Пулс</span>
                    </a>
                    <a href="/for-you" class={`mode-link ${Astro.url.pathname === '/for-you' ? 'is-active' : ''}`}>За Вас</a>
                </div>
                
                <div class="topbar-util">
                    {stats?.last_1h && stats.last_1h > 0 && (
                        <div class="activity-chip" title="Нови вести во последен час">
                            <span class="activity-dot"></span>
                            +{stats.last_1h}
                        </div>
                    )}
                    <ThemeIsland client:load />
                </div>
            </div>
        </div>
    </header>

    <nav class="site-layout discovery-nav-v2" aria-label="Брза навигација">
        <div class="nav-rail-wrapper">
            <div class="nav-rail-scroll hide-scrollbar">
                <div class="nav-rail-content">
                    {visibleSections.map((section: any, idx) => {
                        const isCore = section.type === 'core' || idx === 0;
                        const isMagazine = section.type === 'magazine';
                        return (
                            <div class={`nav-rail-group ${isCore ? 'group-core' : isMagazine ? 'group-magazine' : 'group-dynamic'}`}>
                                <div class="group-header">
                                    <span class="group-label">{section.label}</span>
                                </div>
                                <div class="group-links">
                                    {section.items.map((item: any) => {
                                        const isActive = item.href.includes('category=')
                                            ? category === item.label
                                            : item.href.includes('topic=')
                                            ? topic === item.label
                                            : item.href.includes('entity=')
                                            ? entity === item.label || entity === item.label.replace('#', '')
                                            : item.href.includes('subcategory=')
                                            ? subcategory === item.label
                                            : Astro.url.pathname === item.href || Astro.url.pathname + '/' === item.href;
                                        return (
                                            <a href={item.href} class={`nav-rail-link ${isActive ? 'is-active' : ''} ${item.type === 'trending_tag' ? 'is-tag' : ''}`}>
                                                {item.type === 'trending_tag' && <span class="tag-prefix">#</span>}
                                                <span class="link-label">{item.label.replace('#', '')}</span>
                                                {item.count > 0 && <span class="link-count">{item.count}</span>}
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div class="nav-fade left"></div>
            <div class="nav-fade right"></div>
        </div>
    </nav>
</div>

<style>
    /* ── Unified Dispatch Ticker ────────────────────────── */
    .unified-dispatch-bar {
        background: var(--background);
        border-bottom: 1px solid var(--border);
        height: 1.6rem;
        display: flex;
        align-items: center;
        z-index: 101;
        overflow: hidden;
        max-width: 100%;
    }
    .dispatch-container {
        display: flex;
        align-items: center;
        height: 100%;
        min-width: 0;
        max-width: 100%;
    }
    .ticker-prefix {
        display: flex; align-items: center; gap: 0.35rem; 
        font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900;
        letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--muted-foreground);
        padding-right: 1rem; border-right: 1px solid var(--border);
        background: var(--background); z-index: 2;
        flex-shrink: 0;
        opacity: 0.85;
    }
    .unified-ticker-track-wrap { flex: 1 1 auto; overflow: hidden; position: relative; min-width: 0; opacity: 0.9; }
    .unified-ticker-track { display: flex; width: max-content; animation: unified-ticker-scroll 60s linear infinite; }
    @keyframes unified-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .unified-ticker-track:hover { animation-play-state: paused; }
    
    .ticker-content-segment { display: flex; align-items: center; gap: 2rem; padding-right: 2rem; flex-shrink: 0; white-space: nowrap; }
    .dispatch-stats-track { display: flex; align-items: center; gap: 0.5rem; min-width: 0; overflow: hidden; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.1em; }
    .stats-group { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.1em; }
    .dispatch-item { display: flex; align-items: center; gap: 0.35rem; color: var(--foreground); }
    .dispatch-data { color: var(--foreground); white-space: nowrap; }
    .dispatch-sep { opacity: 0.3; }

    .live-ticker-headline { font-family: var(--font-serif); font-size: 0.7rem; line-height: 1; font-weight: 700; color: var(--foreground); text-decoration: none; display: inline-flex; align-items: center; white-space: nowrap; }
    .ticker-time { font-family: var(--font-sans); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; margin-right: 0.5rem; background: var(--secondary); padding: 1px 4px; border-radius: 2px; }
    .ticker-title { line-height: 1.1; }

    /* ── Editorial Topbar ─────────────────────────────── */
    .header-sticky-wrapper {
        position: sticky; top: 0; z-index: 102; background: var(--background);
        border-bottom: 1px solid var(--border); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
    }
    .header-sticky-wrapper.header-hidden { transform: translateY(-100%); }

    .editorial-topbar { padding: 0.5rem 0 0.65rem; }
    .topbar-main { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; min-width: 0; max-width: 100%; }
    
    .topbar-left-stack { display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-start; min-width: 0; }
    .topbar-date-display { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.08em; }

    .topbar-branding { display: flex; justify-content: center; min-width: 0; max-width: 100%; }
    .brand-link { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; min-width: 0; max-width: 100%; }
    .brand-emblem { height: 1.55rem; }
    .brand-logo { height: 1.9rem; }

    .topbar-actions { display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-end; min-width: 0; }
    .topbar-modes-rail { display: flex; align-items: center; gap: 0.3rem; min-width: 0; }
    .mode-link {
        display: flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.5rem; border-radius: 4px;
        font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase;
        color: var(--foreground); text-decoration: none; transition: all 0.2s; border: 1px solid transparent;
    }
    .mode-link:hover { background: var(--secondary); }
    .mode-link.is-active { background: color-mix(in srgb, var(--nyt-accent) 6%, var(--background)); border-color: color-mix(in srgb, var(--nyt-accent) 25%, transparent); color: var(--nyt-accent); }

    .topbar-util { display: flex; align-items: center; gap: 0.75rem; }
    .activity-chip {
        display: flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.45rem; border: 1px solid var(--border);
        font-family: var(--font-sans); font-size: 0.58rem; font-weight: 850; color: var(--nyt-accent); border-radius: 4px;
    }
    .activity-dot { width: 4px; height: 5px; background: var(--nyt-accent); border-radius: 50%; }

    /* ── Discovery Navigation ────────────────────────── */
    .discovery-nav-v2 { border-top: 1px solid var(--border); background: var(--background); }
    .nav-rail-wrapper { position: relative; overflow: hidden; min-width: 0; }
    .nav-rail-scroll { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .nav-rail-content { display: flex; padding: 0.3rem 0; align-items: stretch; min-width: min-content; }
    .nav-rail-group { display: flex; align-items: center; padding: 0 1rem; border-right: 1px solid var(--border); gap: 0.65rem; }
    .nav-rail-group:last-child { border-right: none; }
    .group-header { opacity: 0.8; flex-shrink: 0; }
    .group-label { font-family: var(--font-sans); font-size: 0.52rem; font-weight: 900; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.08em; }
    .group-links { display: flex; align-items: center; gap: 0.25rem; }
    .nav-rail-link { display: flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.55rem; border-radius: 4px; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
    .nav-rail-link:hover { background: var(--secondary); }
    .nav-rail-link.is-active { background: var(--foreground); color: var(--background); }
    
    .group-core .link-label, .group-dynamic .link-label { font-family: var(--font-sans); font-size: 0.66rem; font-weight: 850; text-transform: uppercase; letter-spacing: 0.02em; }
    .group-magazine .link-label { font-family: var(--font-serif); font-size: 0.78rem; font-weight: 800; line-height: 1.15; }
    
    .link-count { font-size: 0.54rem; background: rgba(0,0,0,0.05); padding: 1px 4px; border-radius: 8px; opacity: 0.75; }
    .nav-fade { position: absolute; top: 0; bottom: 0; width: 30px; pointer-events: none; z-index: 5; }
    .nav-fade.left { left: 0; background: linear-gradient(to right, var(--background), transparent); opacity: 0; }
    .nav-fade.right { right: 0; background: linear-gradient(to left, var(--background), transparent); }

    @media (max-width: 960px) {
        .unified-dispatch-bar { height: 1.4rem; width: 100%; box-sizing: border-box; }
        .ticker-prefix { padding-right: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 0; }
        .ticker-label { font-family: var(--font-sans); font-size: 0.5rem; font-weight: 900; letter-spacing: 0.05em; color: var(--nyt-red); white-space: nowrap; }
        .ticker-content-segment { gap: 1rem; padding-right: 1rem; flex-shrink: 0; white-space: nowrap; }
        .editorial-topbar { padding: 0.25rem 0.5rem 0.35rem; width: 100%; box-sizing: border-box; }
        .topbar-main { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.4rem; width: 100%; min-width: 0; }
        .topbar-left-stack { order: 1; flex-direction: row; align-items: center; min-width: 0; flex-shrink: 1; }
        .topbar-date-display { display: none; }
        .topbar-branding { order: 2; flex: 1; justify-content: flex-start; min-width: 0; overflow: hidden; }
        .topbar-actions { order: 3; flex-direction: row; align-items: center; gap: 0.4rem; flex-shrink: 0; }
        .topbar-modes-rail { border: 0; padding: 0; }
        .mode-link { padding: 0.3rem 0.4rem; font-size: 0.55rem; }
        .brand-logo { height: 1.15rem; max-width: 100%; object-fit: contain; }
        .brand-emblem { height: 0.95rem; flex-shrink: 0; }
        .nav-rail-group { padding: 0 0.65rem; }
        .nav-rail-content { padding: 0.2rem 0; width: max-content; }
    }

    @media (max-width: 400px) {
        .mode-link span { display: none; }
        .mode-link { padding: 0.35rem; }
        .topbar-main { grid-template-columns: auto 1fr auto; }
        .topbar-util { gap: 0.35rem; }
    }
</style>

<script is:inline>
    (function() {
        const initHeaderControl = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const handleScroll = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 80) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 10) {
                    // Scrolling down - hide
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 20) {
                    // Scrolling up - show
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', handleScroll, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.nav-rail-scroll');
            const fadeLeft = document.querySelector('.nav-fade.left');
            const fadeRight = document.querySelector('.nav-fade.right');
            if (!navShell || !fadeLeft || !fadeRight) return;
            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 15 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 15 ? '1' : '0';
            };
            navShell.addEventListener('scroll', update, { passive: true });
            update();
        };

        initHeaderControl();
        initFades();
        document.addEventListener('astro:page-load', () => {
            initHeaderControl();
            initFades();
        });
    })();
</script>
