---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import { Sparkles, BarChart3, Radio, ShieldCheck } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';
import { getEditionStr } from '../utils/textUtils';
import Branding from './Branding.astro';

interface Props {
    category?: string | null;
    topic?: string | null;
    entity?: string | null;
    subcategory?: string | null;
    q?: string | null;
    stats?: any | null;
}

const { category, topic, entity, subcategory, q, stats: propStats } = Astro.props;

const currentDate = new Intl.DateTimeFormat('mk-MK', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}).format(new Date());

const currentEdition = getEditionStr(new Date());

const API_URL = apiBaseUrl();

interface NavItem {
    label: string;
    href: string;
}

let navigationData: { breaking: NavItem[]; sections: any[] } = { breaking: [], sections: [] };
let stats = propStats;
let latestTickerItems: any[] = [];

try {
    const requests = [fetch(`${API_URL}/navigation`)];
    const shouldFetchStats = !stats || typeof stats.last_1h !== 'number' || typeof stats.total_feeds === 'undefined';
    if (shouldFetchStats) {
        requests.push(fetch(`${API_URL}/stats/summary`));
    }

    const results = await Promise.allSettled(requests);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (shouldFetchStats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }

    if (!navigationData.breaking.length) {
        const latestRes = await fetch(`${API_URL}/news?page_size=8&sort=recent`);
        if (latestRes.ok) {
            const latestData = await latestRes.json();
            latestTickerItems = (latestData?.clusters || []).map((cluster: any) => {
                const lead = Array.isArray(cluster?.articles) ? cluster.articles[0] : null;
                return {
                    label: cluster?.synthetic_headline || lead?.title || 'Најнова вест',
                    href: `/cluster/${cluster?.cluster_id}`,
                    type: cluster?.is_breaking ? 'breaking' : 'latest',
                    created_at: lead?.ingested_at || lead?.created_at || null,
                };
            }).filter((item: any) => item.href && item.label).slice(0, 6);
        }
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const hasBreaking = navigationData.breaking.length > 0;
const breakingItems = hasBreaking ? navigationData.breaking.slice(0, 5) : latestTickerItems;
const hasTicker = breakingItems.length > 0;
const visibleSections = (navigationData.sections || []).filter((section: any) => Array.isArray(section?.items) && section.items.length > 0);

// Idea A: Verification Counter Logic
const intel = stats?.intelligence;
const totalClusters = intel?.pluralism?.total_clusters || 0;
const highConsensusPct = intel?.pluralism?.high_consensus_pct || 0;
const pluralismPct = intel?.pluralism?.pluralism_pct || 0;
const hasDispatchStats = Boolean(stats && intel?.pluralism);

const confirmedFacts = Math.max(0, Math.round(totalClusters * (highConsensusPct / 100) * 4));
const activeConflicts = Math.max(0, Math.round(totalClusters * (1 - pluralismPct / 100) * 0.5));
const totalFeeds = stats?.total_feeds || 0;

function getRelativeTimeStr(dateStr?: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'ШТОТУКУ';
        if (diffMins < 60) return `${diffMins} МИН`;
        
        return date.toLocaleTimeString('mk-MK', { 
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Skopje' 
        });
    } catch {
        return '';
    }
}
---

<div class="header-sticky-wrapper" id="main-header">
    {hasTicker && (
    <div class="unified-dispatch-bar">
        <div class="dispatch-container site-layout">
            <div class="ticker-prefix">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
                </span>
                <span class="ticker-label">ВО ЖИВО</span>
            </div>
            <div class="unified-ticker-track-wrap">
                <div class="unified-ticker-track">
                    <div class="ticker-content-segment">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                    {/* Duplicate for seamless looping */}
                    <div class="ticker-content-segment" aria-hidden="true">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </div>
    )}

    <header class="editorial-topbar site-layout">
        <div class="topbar-main">
            <div class="topbar-left-stack">
                <div class="search-entry">
                    <SearchIsland initialQuery={q} client:load />
                </div>
                <time class="topbar-date-display">{currentDate}</time>
            </div>

            <div class="topbar-branding">
                <a href="/" class="brand-link">
                    <Branding mode="full" />
                </a>
            </div>

            <div class="topbar-actions">
                <div class="topbar-modes-rail">
                    <a href="/briefing" class={`mode-link ${Astro.url.pathname === '/briefing' ? 'is-active' : ''}`}>
                        <Radio size={11} strokeWidth={3} /> <span>Брифинг</span>
                    </a>
                    <a href="/archive" class={`mode-link ${Astro.url.pathname === '/archive' ? 'is-active' : ''}`}>
                        <Sparkles size={11} strokeWidth={3} /> <span>Архива</span>
                    </a>
                    <a href="/pulse" class={`mode-link ${Astro.url.pathname === '/pulse' ? 'is-active' : ''}`}>
                        <BarChart3 size={11} strokeWidth={3} /> <span>Пулс</span>
                    </a>
                </div>
                
                <div class="topbar-util">
                    {stats?.last_1h && stats.last_1h > 0 && (
                        <div class="activity-chip" title="Нови вести во последен час">
                            <span class="activity-dot"></span>
                            +{stats.last_1h}
                        </div>
                    )}
                    <ThemeIsland client:idle />
                </div>
            </div>
        </div>
    </header>

    <nav class="site-layout discovery-nav-v2" aria-label="Брза навигација">
        <div class="nav-rail-wrapper">
            <div class="nav-rail-scroll hide-scrollbar">
                <div class="nav-rail-content">
                    {visibleSections.map((section: any, idx) => {
                        const isCore = section.type === 'core' || idx === 0;
                        const isMagazine = section.type === 'magazine';
                        return (
                            <div class={`nav-rail-group ${isCore ? 'group-core' : isMagazine ? 'group-magazine' : 'group-dynamic'}`}>
                                <div class="group-links">
                                    {section.items.map((item: any) => {
                                        const isActive = item.href.includes('category=')
                                            ? category === item.label
                                            : item.href.includes('topic=')
                                            ? topic === item.label
                                            : item.href.includes('entity=')
                                            ? entity === item.label || entity === item.label.replace('#', '')
                                            : item.href.includes('subcategory=')
                                            ? subcategory === item.label
                                            : Astro.url.pathname === item.href || Astro.url.pathname + '/' === item.href;
                                        return (
                                            <a href={item.href} class={`nav-rail-link ${isActive ? 'is-active' : ''} ${item.type === 'trending_tag' ? 'is-tag' : ''}`}>
                                                {item.type === 'trending_tag' && <span class="tag-prefix">#</span>}
                                                <span class="link-label">{item.label.replace('#', '')}</span>
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div class="nav-fade left"></div>
            <div class="nav-fade right"></div>
        </div>
    </nav>
</div>

<style>
    /* ── Unified Dispatch Ticker ────────────────────────── */
    .unified-dispatch-bar {
        background: var(--background);
        border-bottom: 1px solid var(--border);
        height: 1.8rem;
        display: flex;
        align-items: center;
        z-index: 101;
        overflow: hidden;
    }
    .dispatch-container { display: flex; align-items: center; height: 100%; }
    
    .ticker-prefix {
        display: flex; align-items: center; gap: 0.5rem; 
        padding: 0 1.25rem; border-right: 1px solid var(--border);
        background: var(--background); z-index: 2;
    }
    .ticker-label { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-red); }

    .unified-ticker-track-wrap { flex: 1; overflow: hidden; position: relative; }
    .unified-ticker-track { display: flex; width: max-content; animation: unified-ticker-scroll 80s linear infinite; }
    @keyframes unified-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .unified-ticker-track:hover { animation-play-state: paused; }
    
    .ticker-content-segment { display: flex; align-items: center; gap: 3rem; padding-right: 3rem; }

    .live-ticker-headline { font-family: var(--font-serif); font-size: 0.72rem; font-weight: 750; color: var(--foreground); text-decoration: none; display: flex; align-items: center; gap: 0.6rem; transition: color 0.2s; }
    .live-ticker-headline:hover { color: var(--nyt-accent); }
    .ticker-time { font-family: var(--font-sans); font-size: 0.58rem; font-weight: 950; color: var(--muted-foreground); opacity: 0.6; }

    /* ── Editorial Topbar ─────────────────────────────── */
    .header-sticky-wrapper {
        position: sticky; top: 0; z-index: 102; 
        background: color-mix(in srgb, var(--background) 85%, transparent);
        backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
        border-bottom: 1px solid var(--border); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .header-sticky-wrapper.header-hidden { transform: translateY(-100%); }

    .editorial-topbar { padding: 1rem 0; }
    .topbar-main { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
    
    .topbar-left-stack { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-start; }
    .search-entry { width: 100%; max-width: 240px; }
    .topbar-date-display { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 950; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.12em; opacity: 0.8; }

    .topbar-branding { display: flex; justify-content: center; }
    .brand-link { text-decoration: none; }

    .topbar-actions { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-end; }
    .topbar-modes-rail { display: flex; align-items: center; gap: 0.5rem; }
    .mode-link {
        display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.75rem; border-radius: 4px;
        font-family: var(--font-sans); font-size: 0.62rem; font-weight: 950; text-transform: uppercase;
        color: var(--foreground); text-decoration: none; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid transparent; letter-spacing: 0.05em;
    }
    .mode-link:hover { background: color-mix(in srgb, var(--nyt-accent) 5%, transparent); color: var(--nyt-accent); }
    .mode-link.is-active { background: var(--foreground); color: var(--background); }

    .topbar-util { display: flex; align-items: center; gap: 1rem; }
    .activity-chip {
        display: flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.6rem; 
        background: color-mix(in srgb, var(--nyt-accent) 10%, transparent);
        font-family: var(--font-sans); font-size: 0.6rem; font-weight: 950; color: var(--nyt-accent); border-radius: 2px;
    }
    .activity-dot { width: 5px; height: 5px; background: var(--nyt-accent); border-radius: 50%; box-shadow: 0 0 8px var(--nyt-accent); }

    /* ── Discovery Navigation ────────────────────────── */
    .discovery-nav-v2 { border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }
    .nav-rail-wrapper { position: relative; }
    .nav-rail-scroll { 
        overflow-x: auto; 
        -webkit-overflow-scrolling: touch; 
        display: flex; 
        align-items: center;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .nav-rail-scroll::-webkit-scrollbar { display: none; }
    .nav-rail-content { display: flex; align-items: center; min-width: max-content; padding: 0.5rem 0; }
    
    .nav-fade {
        position: absolute; top: 0; bottom: 0; width: 40px; pointer-events: none;
        z-index: 10; transition: opacity 0.3s ease; opacity: 0;
    }
    .nav-fade.left { left: 0; background: linear-gradient(to right, var(--background), transparent); }
    .nav-fade.right { right: 0; background: linear-gradient(to left, var(--background), transparent); }

    .nav-rail-group { border-right: 1px solid color-mix(in srgb, var(--border) 30%, transparent); padding: 0 1.2rem; display: flex; align-items: center; height: 100%; flex-shrink: 0; }
    .nav-rail-group:last-child { border-right: none; }
    
    .group-links { display: flex; align-items: center; gap: 0.35rem; }
    .nav-rail-link { 
        font-family: var(--font-sans); font-size: 0.68rem; font-weight: 850; padding: 0.3rem 0.6rem; 
        color: var(--muted-foreground); text-decoration: none; border-radius: 2px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); white-space: nowrap;
        border: 1px solid transparent;
    }
    .nav-rail-link:hover { background: var(--secondary); color: var(--foreground); }
    .nav-rail-link.is-active { background: var(--nyt-accent); color: white; border-color: var(--nyt-accent); }
    .nav-rail-link.is-tag { color: var(--nyt-accent); }
    .tag-prefix { opacity: 0.5; margin-right: 1px; }

    @media (max-width: 960px) {
        .editorial-topbar { padding: 0.5rem 0.75rem; }
        .topbar-main { grid-template-columns: auto 1fr auto; gap: 1rem; }
        .topbar-left-stack { order: 1; flex-direction: row; }
        .topbar-date-display { display: none; }
        .topbar-branding { order: 2; justify-content: flex-start; min-width: 0; }
        .topbar-actions { order: 3; flex-direction: row; }
        .mode-link span { display: none; }
        .search-entry { max-width: 180px; }
    }

    @media (max-width: 768px) {
        .topbar-main { gap: 0.75rem; }
        .search-entry { max-width: 140px; }
    }

    @media (max-width: 480px) {
        .editorial-topbar { padding: 0.4rem 0.5rem; }
        .topbar-main { gap: 0.5rem; }
        .search-entry { max-width: 120px; }
    }
</style>

<script is:inline>
    (function() {
        const initHeaderControl = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const handleScroll = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 80) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 10) {
                    // Scrolling down - hide
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 20) {
                    // Scrolling up - show
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', handleScroll, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.nav-rail-scroll');
            const fadeLeft = document.querySelector('.nav-fade.left');
            const fadeRight = document.querySelector('.nav-fade.right');
            if (!navShell || !fadeLeft || !fadeRight) return;
            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 15 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 15 ? '1' : '0';
            };
            navShell.addEventListener('scroll', update, { passive: true });
            update();
        };

        initHeaderControl();
        initFades();
        document.addEventListener('astro:page-load', () => {
            initHeaderControl();
            initFades();
        });
    })();
</script>
