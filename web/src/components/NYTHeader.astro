---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import { Sparkles, BarChart3, Radio } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
    stats?: {
        last_1h?: number;
        last_24h?: number;
    } | null;
}

const { category, topic, q, stats: propStats } = Astro.props;

const currentDate = new Intl.DateTimeFormat('mk-MK', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}).format(new Date());

const API_URL = apiBaseUrl();

interface NavItem {
    label: string;
    href: string;
}

let navigationData: { breaking: NavItem[]; sections: any[] } = { breaking: [], sections: [] };
let stats = propStats;

try {
    const promises = [fetch(`${API_URL}/navigation`)];
    if (!stats) promises.push(fetch(`${API_URL}/stats/summary`));
    const results = await Promise.allSettled(promises);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (!stats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const hasBreaking = navigationData.breaking.length > 0;
const breakingItems = navigationData.breaking.slice(0, 5);
const visibleSections = (navigationData.sections || []).filter((section: any) => Array.isArray(section?.items) && section.items.length > 0);
---

<div class="header-sticky-wrapper" id="main-header">
    {hasBreaking && (
        <div class="live-ticker" id="live-ticker">
            <div class="live-ticker-container site-layout">
                <span class="live-ticker-badge">
                    <Radio size={10} className="animate-pulse" />
                    ВО ЖИВО
                </span>
                <div class="live-ticker-track-wrap">
                    <div class="live-ticker-track">
                        {breakingItems.map((item) => (
                            <a href={item.href} data-astro-reload class="live-ticker-headline">
                                <span class="ticker-sep" aria-hidden="true">•</span>
                                {item.label}
                            </a>
                        ))}
                        {breakingItems.map((item) => (
                            <a href={item.href} data-astro-reload class="live-ticker-headline" aria-hidden="true">
                                <span class="ticker-sep" aria-hidden="true">•</span>
                                {item.label}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    )}

    <header class="editorial-topbar site-layout">
        <div class="topbar-main">
            <div class="topbar-left-stack">
                <div class="search-entry">
                    <SearchIsland initialQuery={q} client:idle />
                </div>
                <time class="topbar-date-display">{currentDate}</time>
            </div>

            <div class="topbar-branding">
                <a href="/" data-astro-reload class="brand-link">
                    <img src="/img/presek_emblem.svg?v=3" alt="" class="brand-emblem site-emblem" />
                    <img src="/logo.svg?v=3" alt="ПРЕСЕК.мк" class="brand-logo site-logo" />
                </a>
            </div>

            <div class="topbar-actions">
                <div class="topbar-modes-rail">
                    <a href="/briefing" data-astro-reload class={`mode-link ${Astro.url.pathname === '/briefing' ? 'is-active' : ''}`}>
                        <Sparkles size={11} strokeWidth={2.5} /> <span class="hidden sm:inline">Брифинг</span>
                    </a>
                    <a href="/pulse" data-astro-reload class={`mode-link ${Astro.url.pathname === '/pulse' ? 'is-active' : ''}`}>
                        <BarChart3 size={11} strokeWidth={2.5} /> <span class="hidden sm:inline">Пулс</span>
                    </a>
                    <a href="/for-you" data-astro-reload class={`mode-link ${Astro.url.pathname === '/for-you' ? 'is-active' : ''}`}>За Вас</a>
                </div>
                
                <div class="topbar-util">
                    {stats?.last_1h && stats.last_1h > 0 && (
                        <div class="activity-chip" title="Нови вести во последен час">
                            <span class="activity-dot"></span>
                            +{stats.last_1h}
                        </div>
                    )}
                    <ThemeIsland client:load />
                </div>
            </div>
        </div>
    </header>

    <nav class="site-layout discovery-nav-v2" aria-label="Брза навигација">
        <div class="nav-rail-wrapper">
            <div class="nav-rail-scroll hide-scrollbar">
                <div class="nav-rail-content">
                    {visibleSections.map((section: any, idx) => {
                        const isRegions = section.label.toLowerCase().includes('регион') || idx === 0;
                        return (
                            <div class={`nav-rail-group ${isRegions ? 'group-regions' : 'group-topics'}`} key={section.label}>
                                <div class="group-header">
                                    <span class="group-label">{section.label}</span>
                                </div>
                                <div class="group-links">
                                    {section.items.map((item: any) => {
                                        const isActive = item.href.includes('category=')
                                            ? category === item.label
                                            : item.href.includes('topic=')
                                            ? topic === item.label
                                            : Astro.url.pathname === item.href || Astro.url.pathname + '/' === item.href;
                                        return (
                                            <a href={item.href} data-astro-reload class={`nav-rail-link ${isActive ? 'is-active' : ''} ${item.type === 'trending_tag' ? 'is-tag' : ''}`}>
                                                {item.type === 'trending_tag' && <span class="tag-prefix">#</span>}
                                                <span class="link-label">{item.label.replace('#', '')}</span>
                                                {item.count > 0 && <span class="link-count">{item.count}</span>}
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div class="nav-fade left"></div>
            <div class="nav-fade right"></div>
        </div>
    </nav>
</div>

<style>
    /* ── Live Ticker ──────────────────────────────────── */
    .live-ticker {
        background: var(--nyt-red);
        color: #fff;
        height: 1.4rem;
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    .live-ticker-container { display: flex; align-items: center; width: 100%; gap: 0.75rem; }
    .live-ticker-badge {
        display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-sans); font-size: 0.52rem; font-weight: 900;
        letter-spacing: 0.1em; color: #fff; padding-right: 1rem; border-right: 1px solid rgba(255,255,255,0.25); white-space: nowrap;
    }
    .live-ticker-track-wrap { flex: 1; overflow: hidden; }
    .live-ticker-track { display: flex; width: max-content; animation: ticker-scroll 30s linear infinite; }
    @keyframes ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .live-ticker-headline { font-family: var(--font-serif); font-size: 0.64rem; font-weight: 700; color: #fff; text-decoration: none; display: flex; align-items: center; white-space: nowrap; }
    .ticker-sep { margin: 0 0.75rem; opacity: 0.4; }

    /* ── Editorial Topbar ─────────────────────────────── */
    .header-sticky-wrapper {
        position: sticky; top: 0; z-index: 100; background: var(--background);
        border-bottom: 1px solid var(--border); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .header-sticky-wrapper.header-hidden { transform: translateY(-100%); }

    .editorial-topbar { padding: 0.5rem 0 0.65rem; }
    .topbar-main { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
    
    .topbar-left-stack { display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-start; }
    .topbar-date-display { font-family: var(--font-sans); font-size: 0.58rem; font-weight: 800; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.04em; }

    .topbar-branding { display: flex; justify-content: center; }
    .brand-link { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
    .brand-emblem { height: 1.35rem; }
    .brand-logo { height: 1.65rem; }

    .topbar-actions { display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-end; }
    .topbar-modes-rail { display: flex; align-items: center; gap: 0.3rem; }
    .mode-link {
        display: flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.5rem; border-radius: 4px;
        font-family: var(--font-sans); font-size: 0.6rem; font-weight: 850; text-transform: uppercase;
        color: var(--foreground); text-decoration: none; transition: all 0.2s; border: 1px solid transparent;
    }
    .mode-link:hover { background: var(--secondary); }
    .mode-link.is-active { background: color-mix(in srgb, var(--nyt-accent) 6%, var(--background)); border-color: color-mix(in srgb, var(--nyt-accent) 25%, transparent); color: var(--nyt-accent); }

    .topbar-util { display: flex; align-items: center; gap: 0.75rem; }
    .activity-chip {
        display: flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.45rem; border: 1px solid var(--border);
        font-family: var(--font-sans); font-size: 0.58rem; font-weight: 850; color: var(--nyt-accent); border-radius: 4px;
    }
    .activity-dot { width: 4px; height: 5px; background: var(--nyt-accent); border-radius: 50%; }

    /* ── Discovery Navigation ────────────────────────── */
    .discovery-nav-v2 { border-top: 1px solid var(--border); background: var(--background); }
    .nav-rail-wrapper { position: relative; overflow: hidden; }
    .nav-rail-scroll { overflow-x: auto; scrollbar-width: none; }
    .nav-rail-content { display: flex; padding: 0.3rem 0; align-items: stretch; }
    .nav-rail-group { display: flex; align-items: center; padding: 0 1rem; border-right: 1px solid var(--border); gap: 0.65rem; }
    .nav-rail-group:last-child { border-right: none; }
    .group-header { opacity: 0.8; flex-shrink: 0; }
    .group-label { font-family: var(--font-sans); font-size: 0.52rem; font-weight: 900; text-transform: uppercase; color: var(--muted-foreground); letter-spacing: 0.08em; }
    .group-links { display: flex; align-items: center; gap: 0.25rem; }
    .nav-rail-link { display: flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.55rem; border-radius: 4px; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
    .nav-rail-link:hover { background: var(--secondary); }
    .nav-rail-link.is-active { background: var(--foreground); color: var(--background); }
    .group-regions .link-label { font-family: var(--font-sans); font-size: 0.66rem; font-weight: 850; text-transform: uppercase; letter-spacing: 0.02em; }
    .group-topics .link-label { font-family: var(--font-serif); font-size: 0.78rem; font-weight: 800; line-height: 1.15; }
    .link-count { font-size: 0.54rem; background: rgba(0,0,0,0.05); padding: 1px 4px; border-radius: 8px; opacity: 0.75; }
    .nav-fade { position: absolute; top: 0; bottom: 0; width: 30px; pointer-events: none; z-index: 5; }
    .nav-fade.left { left: 0; background: linear-gradient(to right, var(--background), transparent); opacity: 0; }
    .nav-fade.right { right: 0; background: linear-gradient(to left, var(--background), transparent); }

    @media (max-width: 960px) {
        .editorial-topbar { padding: 0.35rem 0 0.5rem; }
        .topbar-main { grid-template-columns: auto 1fr auto; gap: 0.5rem; }
        .topbar-left-stack { order: 1; flex-direction: row; align-items: center; }
        .topbar-date-display { display: none; }
        .topbar-branding { order: 2; flex: 1; justify-content: flex-start; }
        .topbar-actions { order: 3; flex-direction: row; align-items: center; gap: 0.5rem; }
        .topbar-modes-rail { border: 0; padding: 0; }
        .mode-link { padding: 0.3rem 0.4rem; }
        .brand-logo { height: 1.35rem; }
        .brand-emblem { height: 1.1rem; }
        .nav-rail-group { padding: 0 0.65rem; }
        .live-ticker-badge { padding-right: 0.5rem; font-size: 0.48rem; }
    }
</style>

<script is:inline>
    (function() {
        const initHeaderControl = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const handleScroll = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 80) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 10) {
                    // Scrolling down - hide
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 20) {
                    // Scrolling up - show
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', handleScroll, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.nav-rail-scroll');
            const fadeLeft = document.querySelector('.nav-fade.left');
            const fadeRight = document.querySelector('.nav-fade.right');
            if (!navShell || !fadeLeft || !fadeRight) return;
            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 15 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 15 ? '1' : '0';
            };
            navShell.addEventListener('scroll', update, { passive: true });
            update();
        };

        initHeaderControl();
        initFades();
        document.addEventListener('astro:page-load', () => {
            initHeaderControl();
            initFades();
        });
    })();
</script>
