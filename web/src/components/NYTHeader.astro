---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import type { TrendingWord } from '../types';
import { apiBaseUrl } from '../lib/apiBase';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
    stats?: {
        last_1h?: number;
        last_24h?: number;
    } | null;
}

const { category, topic, q, stats: propStats } = Astro.props;

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

const API_URL = apiBaseUrl();

let navigationData = { breaking: [], focus: [], sections: [] };
let stats = propStats;

try {
    const promises = [fetch(`${API_URL}/navigation`)];
    if (!stats) promises.push(fetch(`${API_URL}/stats/summary`));
    const results = await Promise.allSettled(promises);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (!stats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const telegramUrl = 'https://t.me/+lt4m-3TGQH9iZTAy';
---

<div class="header-sticky-wrapper" id="main-header">
    <header class="site-layout topbar">
        <div class="topbar-row">
            <div class="topbar-left">
                <div class="search-trigger-wrap">
                    <SearchIsland client:load />
                    <span class="search-hint hidden lg:inline">⌘K</span>
                </div>
                <span class="topbar-edition hidden md:inline-flex">
                    {stats?.last_1h && stats.last_1h > 0 ? (
                        <span class="live-update-badge">
                            <span class="pulse-dot"></span>
                            +{stats.last_1h} нови објави
                        </span>
                    ) : (
                        "ПРЕСЕК.мк"
                    )}
                </span>
            </div>

            <div class="topbar-center">
                <span class="nyt-section-label topbar-date">{currentDate}</span>
            </div>

            <div class="topbar-right">
                <div class="topbar-links flex items-center gap-4">
                    <a href="/briefing" class="nyt-section-label topbar-link">Брифинг</a>
                    <a href="/stats" class="nyt-section-label topbar-link">Пулс</a>
                    <a href={telegramUrl} class="nyt-section-label topbar-link topbar-link-accent" target="_blank" rel="noopener noreferrer">Телеграм</a>
                </div>
                <ThemeIsland client:load />
            </div>
        </div>
    </header>

    <div class="site-layout masthead">
        <div class="masthead-inner">
            <div class="masthead-brand">
                <a href="/" class="contents">
                    <img src="/img/presek_emblem.svg?v=3" alt="" class="site-emblem h-5 md:h-7" />
                </a>
                <a href="/" class="block">
                    <img src="/logo.svg?v=3" alt="ПРЕСЕК.мк" class="site-logo h-8 md:h-12 lg:h-14" />
                </a>
            </div>
        </div>
    </div>

    <nav class="site-layout masthead-nav" aria-label="Навигација">
        <div class="masthead-nav-container">
            <div class="masthead-nav-shell hide-scrollbar">
                <ul class="masthead-nav-list">
                    {navigationData.breaking.length > 0 && (
                        <>
                            <li class="masthead-nav-kicker-item">
                                <span class="masthead-nav-kicker">Во Живо</span>
                            </li>
                            {navigationData.breaking.map((item) => (
                                <li>
                                    <a href={item.href} class="masthead-nav-link nav-link-breaking">
                                        <span class="breaking-dot"></span>
                                        {item.label}
                                    </a>
                                </li>
                            ))}
                        </>
                    )}

                    {navigationData.focus.length > 0 && (
                        <>
                            <li class="masthead-nav-kicker-item">
                                <span class="masthead-nav-kicker kicker-focus">Фокус</span>
                            </li>
                            {navigationData.focus.map((item) => (
                                <li>
                                    <a href={item.href} class="masthead-nav-link nav-link-focus">
                                        {item.label}
                                    </a>
                                </li>
                            ))}
                        </>
                    )}

                    {navigationData.sections.length > 0 && (
                        <>
                            <li class="masthead-nav-kicker-item">
                                <span class="masthead-nav-kicker kicker-sections">Рубрики</span>
                            </li>
                            {navigationData.sections.map((item) => (
                                <li>
                                    <a href={item.href} class={`masthead-nav-link ${(category === item.label || topic === item.label) ? 'is-active' : ''}`}>
                                        {item.label}
                                    </a>
                                </li>
                            ))}
                        </>
                    )}
                </ul>
            </div>
            <div class="nav-fade-left"></div>
            <div class="nav-fade-right"></div>
        </div>
    </nav>
</div>

<style>
    .header-sticky-wrapper {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--background) 95%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .header-hidden {
        transform: translateY(-100%);
    }

    .topbar {
        padding: 0.35rem 0;
        border-bottom: 1px solid var(--border);
    }

    .topbar-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    .topbar-left, .topbar-center, .topbar-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .topbar-right { justify-content: flex-end; }
    .topbar-center { justify-content: center; }

    .topbar-date {
        color: var(--muted-foreground);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .topbar-link {
        color: var(--foreground);
        text-decoration: none;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.8;
    }

    .topbar-link:hover { opacity: 1; color: var(--nyt-accent); }
    .topbar-link-accent { color: var(--nyt-accent); opacity: 1; }

    .masthead {
        padding: 0.25rem 0;
        border-bottom: 4px double var(--foreground);
    }

    .masthead-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.15rem 0;
    }

    .masthead-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .masthead-nav {
        padding: 0.15rem 0;
        border-bottom: 1px solid var(--foreground);
    }

    .masthead-nav-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    .masthead-nav-shell {
        width: 100%;
        overflow-x: auto;
        padding: 0.2rem 0;
    }

    .masthead-nav-list {
        display: flex;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .masthead-nav-list li {
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .masthead-nav-list li + li:not(.masthead-nav-kicker-item)::before {
        content: "";
        width: 1px;
        height: 12px;
        background-color: var(--border);
        margin: 0 1rem;
    }

    .masthead-nav-kicker {
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        color: var(--nyt-red);
        margin-right: 1rem;
    }

    .kicker-focus { color: var(--foreground); }
    .kicker-sections { color: var(--muted-foreground); }

    .masthead-nav-link {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--foreground);
        text-decoration: none;
    }

    .masthead-nav-link:hover, .masthead-nav-link.is-active {
        color: var(--nyt-accent);
    }

    .nav-link-breaking { color: var(--nyt-red); font-weight: 900; }

    .breaking-dot, .pulse-dot {
        width: 6px;
        height: 6px;
        background-color: var(--nyt-red);
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
        animation: pulse-red 2s infinite;
    }

    @keyframes pulse-red {
        0% { transform: scale(0.95); opacity: 1; }
        70% { transform: scale(1.1); opacity: 0.7; }
        100% { transform: scale(0.95); opacity: 1; }
    }

    .nav-fade-left, .nav-fade-right {
        position: absolute;
        top: 0; bottom: 0; width: 30px; z-index: 2; pointer-events: none;
    }
    .nav-fade-left { left: 0; background: linear-gradient(to right, var(--background), transparent); opacity: 0; }
    .nav-fade-right { right: 0; background: linear-gradient(to left, var(--background), transparent); }

    @media (max-width: 768px) {
        .topbar-center { display: none; }
        .topbar-row { grid-template-columns: 1fr auto; }
        .topbar-edition { display: none; }
    }
</style>

<script is:inline>
    (function() {
        const initHeader = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const onScroll = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 100) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 50) {
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 50) {
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', onScroll, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.masthead-nav-shell');
            const fadeLeft = document.querySelector('.nav-fade-left');
            const fadeRight = document.querySelector('.nav-fade-right');
            if (!navShell || !fadeLeft || !fadeRight) return;

            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 10 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 10 ? '1' : '0';
            };
            navShell.addEventListener('scroll', update);
            window.addEventListener('resize', update);
            update();
        };

        initHeader();
        initFades();
        document.addEventListener('astro:page-load', () => { initHeader(); initFades(); });
    })();
</script>
