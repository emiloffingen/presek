<script is:inline>
    (function() {
        const initHeader = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const scrollThreshold = 100;
            const hideThreshold = 50;

            const updateHeader = () => {
                const currentScrollY = window.scrollY;
                const scrollDelta = currentScrollY - lastScrollY;

                // Always show at top
                if (currentScrollY < scrollThreshold) {
                    header.classList.remove('header-hidden');
                    lastScrollY = currentScrollY;
                    return;
                }

                // Hide on scroll down, show on scroll up
                if (scrollDelta > hideThreshold) {
                    header.classList.add('header-hidden');
                    lastScrollY = currentScrollY;
                } else if (scrollDelta < -hideThreshold) {
                    header.classList.remove('header-hidden');
                    lastScrollY = currentScrollY;
                }
            };

            let ticking = false;
            const onScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                    ticking = true;
                }
            };

            window.addEventListener('scroll', onScroll, { passive: true });
            
            // Cleanup function for possible future re-runs
            return () => window.removeEventListener('scroll', onScroll);
        };

        // Run on initial load
        initHeader();

        // Navigation fade logic
        const navShell = document.querySelector('.masthead-nav-shell');
        const fadeLeft = document.querySelector('.nav-fade-left');
        const fadeRight = document.querySelector('.nav-fade-right');

        if (navShell && fadeLeft && fadeRight) {
            const updateFades = () => {
                const scrollLeft = navShell.scrollLeft;
                const maxScroll = navShell.scrollWidth - navShell.clientWidth;
                
                fadeLeft.style.opacity = scrollLeft > 10 ? '1' : '0';
                fadeRight.style.opacity = scrollLeft < maxScroll - 10 ? '1' : '0';
            };

            navShell.addEventListener('scroll', updateFades);
            window.addEventListener('resize', updateFades);
            updateFades();
        }

        // Support Astro View Transitions if enabled later
        document.addEventListener('astro:page-load', () => {
            initHeader();
            // Re-init nav fades if needed
        });
    })();
</script>
