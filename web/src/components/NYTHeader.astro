---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import type { TrendingWord } from '../types';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
}

const { category, topic, q } = Astro.props;

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

const API_URL = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:5000/api";

let trendingItems: TrendingWord[] = [];

try {
    const response = await fetch(`${API_URL}/trending`);
    if (response.ok) {
        const data = await response.json();
        if (Array.isArray(data)) {
            trendingItems = data.slice(0, 8);
        }
    }
} catch {
    trendingItems = [];
}

const fallbackItems = [
    { word: "Македонија" },
    { word: "Балкан" },
    { word: "Европа" },
    { word: "Свет" },
    { word: "Економија" },
    { word: "Спорт" },
];

const headerItems = trendingItems.length > 0 ? trendingItems : fallbackItems;
---

<header class="site-layout topbar">
    <div class="topbar-row">
        <div class="topbar-left">
            <SearchIsland client:load />
            <span class="topbar-edition">Пресек Денешно Издание</span>
        </div>

        <div class="topbar-center">
            <span class="nyt-section-label topbar-date">{currentDate}</span>
        </div>

        <div class="topbar-right">
            <a href="/briefing" class="nyt-section-label topbar-link">Дневен Брифинг</a>
            <a href="/stats" class="nyt-section-label topbar-link">Медиумски Пулс</a>
            <ThemeIsland client:load />
        </div>
    </div>
</header>

<div class="site-layout masthead">
    <div class="masthead-inner">
        <div class="masthead-brand">
            <img src="/img/presek_emblem.svg?v=3" alt="Presek Emblem" class="site-emblem h-8 md:h-10 site-logo" />
            <a href="/" class="block">
                <img src="/logo.svg?v=3" alt="Presek" class="site-logo h-12 md:h-16 lg:h-20" />
            </a>
        </div>
        <div class="masthead-copy">
            <p class="masthead-sub">Подредено по значење, извори и контекст.</p>
        </div>
    </div>
</div>

<nav class="site-layout masthead-nav" aria-label="Популарно сега">
    <div class="masthead-nav-shell">
        <span class="masthead-nav-kicker">Во Фокус</span>
        <ul class="masthead-nav-list">
            {headerItems.map((item: any) => {
                const searchStr = new URLSearchParams({ q: item.word }).toString();
                const isActive = q === item.word;

                return (
                    <li>
                        <a href={`/?${searchStr}`} class={`masthead-nav-link ${isActive ? 'is-active' : ''}`}>
                            {item.word}
                        </a>
                    </li>
                );
            })}
        </ul>
    </div>
</nav>

<style>
    .topbar {
        padding-top: 0.95rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--border);
    }

    .topbar-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    .topbar-left,
    .topbar-center,
    .topbar-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .topbar-center {
        justify-content: center;
        min-width: 0;
    }

    .topbar-right {
        justify-content: flex-end;
    }

    .topbar-edition {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding-left: 0.85rem;
        position: relative;
        font-family: var(--font-sans);
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--foreground);
        white-space: nowrap;
    }

    .topbar-edition::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: var(--nyt-accent);
        transform: translateY(-50%);
    }

    .topbar-date {
        color: var(--muted-foreground);
        text-align: center;
        white-space: nowrap;
    }

    .topbar-link {
        color: var(--foreground);
        text-decoration: none;
        opacity: 0.9;
    }

    .topbar-link:hover {
        color: var(--nyt-accent);
    }

    .masthead {
        padding-top: 1.5rem;
        padding-bottom: 1.35rem;
        margin-bottom: 0.5rem;
        border-bottom: 4px double var(--nyt-black);
    }

    .masthead-inner {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        align-items: end;
        text-align: center;
    }

    .masthead-brand {
        display: flex;
        align-items: end;
        justify-content: center;
        gap: 0.6rem;
    }

    .masthead-copy {
        display: flex;
        justify-content: center;
    }

    .masthead-sub {
        font-family: var(--font-sans);
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin: 0;
        max-width: 34ch;
    }

    .masthead-nav {
        padding-top: 0.55rem;
        padding-bottom: 0.9rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--nyt-black);
    }

    .masthead-nav-shell {
        display: flex;
        align-items: center;
        gap: 1rem;
        overflow-x: auto;
        padding: 0.4rem 0;
    }

    .masthead-nav-kicker {
        flex: 0 0 auto;
        padding: 0.35rem 0.85rem 0.35rem 0;
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--nyt-red);
        white-space: nowrap;
        position: relative;
    }

    .masthead-nav-kicker::after {
        content: "";
        position: absolute;
        right: 0;
        top: 50%;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: var(--nyt-red);
        transform: translateY(-50%);
    }

    .masthead-nav-list {
        display: flex;
        justify-content: flex-start;
        gap: 0;
        list-style: none;
        padding: 0;
        margin: 0;
        min-width: max-content;
    }

    .masthead-nav-list li {
        display: flex;
        align-items: center;
    }

    .masthead-nav-list li + li::before {
        content: "/";
        margin: 0 0.7rem;
        color: var(--border-strong);
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 700;
    }

    .masthead-nav-link {
        display: inline-flex;
        align-items: center;
        padding: 0.18rem 0;
        font-family: var(--font-sans);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--foreground);
        white-space: nowrap;
        border-bottom: 1px solid transparent;
        transition: color 140ms ease, border-color 140ms ease;
    }

    .masthead-nav-link:hover,
    .masthead-nav-link.is-active {
        color: var(--nyt-red);
        border-color: currentColor;
    }

    @media (max-width: 720px) {
        .topbar-row {
            grid-template-columns: 1fr;
            gap: 0.65rem;
        }

        .topbar-left,
        .topbar-center,
        .topbar-right {
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .topbar-center {
            justify-content: flex-start;
            padding-top: 0.15rem;
            border-top: 1px solid var(--border);
        }

        .topbar-date {
            text-align: left;
        }

        .masthead-nav-shell {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.55rem;
        }

        .masthead-nav-kicker {
            padding-right: 0.85rem;
        }

        .masthead-nav-list {
            padding-bottom: 0.15rem;
        }
    }

    @media (min-width: 900px) {
        .masthead-inner {
            grid-template-columns: auto 1fr;
            text-align: left;
            gap: 2rem;
        }

        .masthead-brand {
            justify-content: flex-start;
        }

        .masthead-copy {
            justify-content: flex-start;
            padding-bottom: 0.2rem;
        }
    }
</style>
