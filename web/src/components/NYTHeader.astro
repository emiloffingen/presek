---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import { apiBaseUrl } from '../lib/apiBase';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
    stats?: {
        last_1h?: number;
        last_24h?: number;
    } | null;
}

const { category, topic, q, stats: propStats } = Astro.props;

const currentDate = new Intl.DateTimeFormat('mk-MK', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
}).format(new Date());

const API_URL = apiBaseUrl();

let navigationData = { breaking: [], focus: [], sections: [] };
let stats = propStats;

try {
    const promises = [fetch(`${API_URL}/navigation`)];
    if (!stats) promises.push(fetch(`${API_URL}/stats/summary`));
    const results = await Promise.allSettled(promises);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (!stats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const hasBreaking = navigationData.breaking.length > 0;
---

{/* ── Sticky header ───────────────────────────────────── */}
<div class="header-sticky-wrapper" id="main-header">
    {/* ── Live ticker ─────────────────────────────────────── */}
    {hasBreaking && (
        <div class="live-ticker" id="live-ticker">
            <div class="live-ticker-container site-layout">
                <span class="live-ticker-badge">
                    <span class="live-ticker-dot"></span>
                    Во живо
                </span>
                <div class="live-ticker-track-wrap">
                    <div class="live-ticker-track">
                        {navigationData.breaking.map((item) => (
                            <a href={item.href} data-astro-reload class="live-ticker-headline">
                                <span class="ticker-sep" aria-hidden="true">&bull;</span>
                                {item.label}
                            </a>
                        ))}
                        {navigationData.breaking.map((item) => (
                            <a href={item.href} data-astro-reload class="live-ticker-headline" aria-hidden="true">
                                <span class="ticker-sep" aria-hidden="true">&bull;</span>
                                {item.label}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    )}

    <header class="site-layout topbar">
        <div class="topbar-row">
            <div class="topbar-left">
                <div class="search-trigger-wrap">
                    <SearchIsland initialQuery={q} client:idle />
                    <kbd class="search-hint hidden lg:inline"></kbd>
                </div>
                <span class="topbar-date hidden md:inline">{currentDate}</span>
            </div>

            <div class="topbar-center">
                <a href="/" data-astro-reload class="topbar-brand-link">
                    <img src="/img/presek_emblem.svg?v=3" alt="" class="topbar-emblem site-emblem" />
                    <img src="/logo.svg?v=3" alt="ПРЕСЕК.мк" class="topbar-logo site-logo" />
                </a>
            </div>

            <div class="topbar-right">
                <div class="topbar-links hidden sm:flex">
                    <a href="/briefing" data-astro-reload class="topbar-link">Брифинг</a>
                    <a href="/stats" data-astro-reload class="topbar-link">Пулс</a>
                </div>
                <div class="flex items-center gap-3">
                    {stats?.last_1h && stats.last_1h > 0 && (
                        <span class="topbar-stat">
                            <span class="topbar-stat-dot"></span>
                            +{stats.last_1h}
                        </span>
                    )}
                    <ThemeIsland client:load />
                </div>
            </div>
        </div>
    </header>

    <nav class="site-layout masthead-nav" aria-label="Навигација">
        <div class="masthead-nav-container">
            <div class="masthead-nav-shell hide-scrollbar">
                <ul class="masthead-nav-list">
                    {navigationData.focus.map((item) => {
                        const isActive = item.href.includes('category=')
                            ? category === item.label
                            : q === item.label;
                        return (
                            <li>
                                <a href={item.href} data-astro-reload class={`masthead-nav-link ${isActive ? 'is-active' : ''}`}>
                                    {item.label}
                                </a>
                            </li>
                        );
                    })}
                    {navigationData.sections && navigationData.sections.length > 0 && (
                        <li class="nav-dropdown-wrap">
                            <button class="masthead-nav-link nav-more-btn">
                                Повеќе <span class="chevron">▼</span>
                            </button>
                            <div class="nav-dropdown">
                                {navigationData.sections.map((sec) => (
                                    <a href={sec.href} data-astro-reload class="nav-dropdown-item">
                                        {sec.label}
                                    </a>
                                ))}
                            </div>
                        </li>
                    )}
                </ul>
            </div>
            <div class="nav-fade-left"></div>
            <div class="nav-fade-right"></div>
        </div>
    </nav>
</div>

<style>
    /* ── Live Ticker ──────────────────────────────────── */
    .live-ticker {
        background: var(--nyt-red);
        color: #fff;
        overflow: hidden;
        position: relative;
        height: 1.75rem;
    }

    .live-ticker-container {
        display: flex;
        align-items: center;
        height: 100%;
        gap: 0;
    }

    .live-ticker-badge {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-sans);
        font-size: 0.58rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        white-space: nowrap;
        flex-shrink: 0;
        z-index: 2;
        padding-right: 0.75rem;
        background: var(--nyt-red);
    }

    .live-ticker-dot {
        width: 6px;
        height: 6px;
        background: #fff;
        border-radius: 50%;
        animation: ticker-pulse 1.5s ease-in-out infinite;
    }

    @keyframes ticker-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.7); }
    }

    .live-ticker-track-wrap {
        flex: 1;
        overflow: hidden;
        mask-image: linear-gradient(to right, transparent, black 0.5rem, black calc(100% - 1rem), transparent);
        display: flex;
        align-items: center;
    }

    .live-ticker-track {
        display: flex;
        flex-wrap: nowrap;
        white-space: nowrap;
        width: max-content;
        animation: ticker-scroll 25s linear infinite;
    }

    .live-ticker-track:hover {
        animation-play-state: paused;
    }

    @keyframes ticker-scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .live-ticker-headline {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-serif);
        font-size: 0.72rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        padding: 0 0.25rem;
        flex-shrink: 0;
    }

    .live-ticker-headline:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .ticker-sep {
        margin: 0 0.75rem;
        opacity: 0.5;
        font-size: 0.5rem;
    }

    /* ── Sticky Header ────────────────────────────────── */
    .header-sticky-wrapper {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--background) 95%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .header-hidden {
        transform: translateY(-100%);
    }

    /* ── Topbar ───────────────────────────────────────── */
    .topbar {
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border);
    }

    .topbar-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        position: relative;
    }

    .topbar-left, .topbar-right {
        flex: 0 0 auto;
        z-index: 1;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .topbar-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (max-width: 1024px) {
        .topbar-center {
            position: relative;
            left: 0;
            transform: none;
            flex: 1;
        }
    }

    .topbar-brand-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        pointer-events: auto;
    }

    .topbar-emblem {
        height: 1.2rem;
        flex-shrink: 0;
    }

    .topbar-logo {
        height: 1.45rem;
        flex-shrink: 0;
    }

    @media (max-width: 768px) {
        .topbar-logo, .topbar-emblem {
            display: none;
        }
        .topbar-brand-link::after {
            content: "ПРЕСЕК.мк";
            display: block;
            font-family: var(--font-serif);
            font-weight: 900;
            font-size: 1.2rem;
            letter-spacing: 0.05em;
            color: var(--foreground);
        }
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .topbar-date {
        font-family: var(--font-sans);
        color: var(--muted-foreground);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
    }

    .topbar-links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .topbar-link {
        color: var(--foreground);
        text-decoration: none;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.7;
        transition: opacity 0.15s;
    }

    .topbar-link:hover { opacity: 1; }

    .topbar-stat {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 700;
        color: var(--nyt-red);
        white-space: nowrap;
    }

    .topbar-stat-dot {
        width: 5px;
        height: 5px;
        background: var(--nyt-red);
        border-radius: 50%;
        animation: ticker-pulse 1.5s ease-in-out infinite;
    }

    /* ── Navigation Bar ───────────────────────────────── */
    .masthead-nav {
        padding: 0;
        border-bottom: 1px solid var(--foreground);
    }

    .masthead-nav-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    .masthead-nav-shell {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        padding: 0.35rem 0;
    }

    .masthead-nav-list {
        display: flex;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 0;
    }

    .masthead-nav-list li {
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .masthead-nav-list li + li::before {
        content: "";
        width: 1px;
        height: 12px;
        background-color: var(--border);
        margin: 0 0.85rem;
        flex-shrink: 0;
    }

    .masthead-nav-link {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--foreground);
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: color 0.15s;
    }

    .masthead-nav-link:hover,
    .masthead-nav-link.is-active {
        color: var(--nyt-accent);
    }

    /* ── Navigation Dropdown ─────────────────────────── */
    .nav-dropdown-wrap {
        position: relative;
    }

    .nav-more-btn {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .chevron {
        font-size: 0.5rem;
        transition: transform 0.2s;
        opacity: 0.6;
    }

    .nav-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 160px;
        background: var(--background);
        border: 1px solid var(--border);
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
        padding: 0.5rem;
        display: none;
        z-index: 1000;
        border-radius: 4px;
        margin-top: 0.5rem;
    }

    .nav-dropdown-wrap.is-open .nav-dropdown {
        display: block;
    }

    .nav-dropdown-wrap.is-open .chevron {
        transform: rotate(180deg);
    }

    .nav-dropdown-item {
        display: block;
        padding: 0.5rem 0.75rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--foreground);
        text-decoration: none;
        letter-spacing: 0.02em;
        border-radius: 3px;
        transition: background 0.15s;
    }

    .nav-dropdown-item:hover {
        background: var(--muted);
        color: var(--nyt-accent);
    }

    .nav-fade-left, .nav-fade-right {
        position: absolute;
        top: 0; bottom: 0; width: 30px; z-index: 2; pointer-events: none;
    }
    .nav-fade-left { left: 0; background: linear-gradient(to right, var(--background), transparent); opacity: 0; }
    .nav-fade-right { right: 0; background: linear-gradient(to left, var(--background), transparent); }

    @media (max-width: 640px) {
        .topbar-row { 
            grid-template-columns: auto 1fr auto; 
            gap: 0.5rem;
        }
        .topbar-logo { height: 1.1rem; }
    }

    @media (min-width: 1024px) {
        .topbar-logo { height: 1.6rem; }
        .topbar-emblem { 
            display: block;
            height: 1.25rem; 
        }
    }

    .search-trigger-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .search-hint {
        font-family: var(--font-sans);
        font-size: 0.6rem;
        font-weight: 600;
        color: var(--muted-foreground);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1rem 0.35rem;
        line-height: 1.4;
    }
</style>

<script is:inline>
    (function() {
        const initHeader = () => {
            if (window._presek_scrollHandler) window.removeEventListener('scroll', window._presek_scrollHandler);

            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            window._presek_scrollHandler = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 100) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 50) {
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 50) {
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', window._presek_scrollHandler, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.masthead-nav-shell');
            const fadeLeft = document.querySelector('.nav-fade-left');
            const fadeRight = document.querySelector('.nav-fade-right');
            if (!navShell || !fadeLeft || !fadeRight) return;

            if (window._presek_fadeResizeHandler) window.removeEventListener('resize', window._presek_fadeResizeHandler);

            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 10 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 10 ? '1' : '0';
            };
            window._presek_fadeResizeHandler = update;
            
            navShell.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update, { passive: true });
            update();
        };

        const initHints = () => {
            var isMac = /Mac|iPhone|iPad/.test(navigator.platform || '');
            document.querySelectorAll('.search-hint').forEach(function(el) {
                el.textContent = isMac ? '⌘K' : 'Ctrl+K';
            });
        };

        const initDropdown = () => {
            const wrap = document.querySelector('.nav-dropdown-wrap');
            const btn = document.querySelector('.nav-more-btn');
            if (!wrap || !btn) return;
            
            btn.onclick = (e) => {
                e.preventDefault();
                e.stopPropagation();
                wrap.classList.toggle('is-open');
            };

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (!wrap.contains(e.target)) {
                    wrap.classList.remove('is-open');
                }
            });
        };

        initHeader();
        initFades();
        initHints();
        initDropdown();
        document.addEventListener('astro:page-load', () => { initHeader(); initFades(); initHints(); initDropdown(); });
    })();
</script>
