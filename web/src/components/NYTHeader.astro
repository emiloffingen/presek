---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import type { TrendingWord } from '../types';
import { apiBaseUrl } from '../lib/apiBase';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
}

const { category, topic, q } = Astro.props;

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

const API_URL = apiBaseUrl();

let trendingItems: TrendingWord[] = [];

try {
    const response = await fetch(`${API_URL}/trending`);
    if (response.ok) {
        const data = await response.json();
        if (Array.isArray(data)) {
            trendingItems = data.slice(0, 8);
        }
    }
} catch {
    trendingItems = [];
}

const fallbackItems = [
    { word: "Македонија" },
    { word: "Балкан" },
    { word: "Европа" },
    { word: "Свет" },
    { word: "Економија" },
    { word: "Спорт" },
];

const headerItems = trendingItems.length > 0 ? trendingItems : fallbackItems;
const curatedTopics = ['Политика', 'Економија', 'Свет', 'Спорт', 'Технологија', 'Култура'];
const telegramUrl = 'https://t.me/+lt4m-3TGQH9iZTAy';
---

<div class="header-sticky-wrapper" id="main-header">
    <header class="site-layout topbar">
        <div class="topbar-row">
            <div class="topbar-left">
                <SearchIsland client:load />
                <span class="topbar-edition">Пресек Денешно Издание</span>
            </div>

            <div class="topbar-center">
                <span class="nyt-section-label topbar-date">{currentDate}</span>
            </div>

            <div class="topbar-right">
                <div class="topbar-links flex overflow-x-auto whitespace-nowrap hide-scrollbar md:flex-wrap">
                    <a href="/briefing" class="nyt-section-label topbar-link">
                        <span class="label-full">Дневен Брифинг</span>
                        <span class="label-short">Брифинг</span>
                    </a>
                    <a href="/settings" class="nyt-section-label topbar-link">
                        <span class="label-full">Поставки</span>
                        <span class="label-short">Поставки</span>
                    </a>
                    <a href="/stats" class="nyt-section-label topbar-link">
                        <span class="label-full">Медиумски Пулс</span>
                        <span class="label-short">Пулс</span>
                    </a>
                    <a href="/status" class="nyt-section-label topbar-link">
                        <span class="label-full">Статус</span>
                        <span class="label-short">Статус</span>
                    </a>
                    <a href={telegramUrl} class="nyt-section-label topbar-link topbar-link-accent" target="_blank" rel="noopener noreferrer">
                        <span class="label-full">Телеграм канал</span>
                        <span class="label-short">Телеграм</span>
                    </a>
                </div>
                <ThemeIsland client:load />
            </div>
        </div>
    </header>

    <div class="site-layout masthead">
        <div class="masthead-inner">
            <div class="masthead-brand">
                <img src="/img/presek_emblem.svg?v=3" alt="Presek Emblem" class="site-emblem h-6 md:h-10 site-logo" />
                <a href="/" class="block">
                    <img src="/logo.svg?v=3" alt="Presek" class="site-logo h-9 md:h-16 lg:h-20" />
                </a>
            </div>
            <div class="masthead-copy">
                <p class="masthead-sub">Подредено по значење, извори и контекст.</p>
            </div>
        </div>
    </div>

    <nav class="site-layout masthead-nav" aria-label="Популарно сега">
        <div class="masthead-nav-shell flex overflow-x-auto whitespace-nowrap hide-scrollbar md:flex-wrap items-center">
            <span class="masthead-nav-kicker">Во фокус</span>
            <ul class="masthead-nav-list flex-nowrap">
                {headerItems.map((item: any) => {
                    const searchStr = new URLSearchParams({ q: item.word }).toString();
                    const isActive = q === item.word;

                    return (
                        <li>
                            <a href={`/?${searchStr}`} class={`masthead-nav-link ${isActive ? 'is-active' : ''}`}>
                                {item.word}
                            </a>
                        </li>
                    );
                })}
            </ul>
            <span class="masthead-nav-kicker masthead-nav-kicker-secondary">Теми</span>
            <ul class="masthead-nav-list masthead-nav-list-topics flex-nowrap">
                {curatedTopics.map((item: string) => {
                    const isActive = topic === item || category === item;

                    return (
                        <li>
                            <a href={`/tema/${encodeURIComponent(item)}`} class={`masthead-nav-link ${isActive ? 'is-active' : ''}`}>
                                {item}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>
    </nav>
</div>

<style>
    .header-sticky-wrapper {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--background) 95%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .header-hidden {
        transform: translateY(-100%) !important;
    }

    /* Small adjustment to child components to remove individual borders if they conflict */
    .topbar {
        border-bottom: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    }
    
    .masthead-nav {
        margin-bottom: 0;
        border-bottom: 0;
    }

    .topbar {
        padding-top: 0.95rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--border);
    }

    .topbar-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    .topbar-left,
    .topbar-center,
    .topbar-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .topbar-center {
        justify-content: center;
        min-width: 0;
    }

    .topbar-right {
        justify-content: flex-end;
    }

    .topbar-links {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        justify-content: flex-end;
    }

    .topbar-edition {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding-left: 0.85rem;
        position: relative;
        font-family: var(--font-sans);
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--foreground);
        white-space: nowrap;
    }

    .topbar-edition::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: var(--nyt-accent);
        transform: translateY(-50%);
    }

    .topbar-date {
        color: var(--muted-foreground);
        text-align: center;
        white-space: nowrap;
    }

    .topbar-link {
        color: var(--foreground);
        text-decoration: none;
        opacity: 0.9;
        border-bottom: 1px solid transparent;
    }

    .topbar-link:hover {
        color: var(--nyt-accent);
        border-color: currentColor;
    }

    .topbar-link-accent {
        color: var(--nyt-accent);
    }

    .label-short {
        display: none;
    }

    .masthead {
        padding-top: 1.5rem;
        padding-bottom: 1.35rem;
        margin-bottom: 0.5rem;
        border-bottom: 4px double var(--nyt-black);
    }

    .masthead-inner {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        align-items: end;
        text-align: center;
    }

    .masthead-brand {
        display: flex;
        align-items: end;
        justify-content: center;
        gap: 0.6rem;
    }

    .masthead-copy {
        display: flex;
        justify-content: center;
    }

    .masthead-sub {
        font-family: var(--font-sans);
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        margin: 0;
        max-width: 34ch;
    }

    .masthead-nav {
        padding-top: 0.55rem;
        padding-bottom: 0.9rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--nyt-black);
    }

    .masthead-nav-shell {
        display: flex;
        align-items: center;
        gap: 1rem;
        overflow-x: auto;
        padding: 0.4rem 0;
    }

    .masthead-nav-kicker {
        flex: 0 0 auto;
        padding: 0.35rem 0.85rem 0.35rem 0;
        font-family: var(--font-sans);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--nyt-red);
        white-space: nowrap;
        position: relative;
    }

    .masthead-nav-kicker::after {
        content: "";
        position: absolute;
        right: 0;
        top: 50%;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: var(--nyt-red);
        transform: translateY(-50%);
    }

    .masthead-nav-kicker-secondary {
        color: var(--foreground);
    }

    .masthead-nav-kicker-secondary::after {
        background: var(--foreground);
    }

    .masthead-nav-list {
        display: flex;
        justify-content: flex-start;
        gap: 0;
        list-style: none;
        padding: 0;
        margin: 0;
        min-width: max-content;
    }

    .masthead-nav-list-topics {
        padding-left: 0.15rem;
    }

    .masthead-nav-list li {
        display: flex;
        align-items: center;
    }

    .masthead-nav-list li + li::before {
        content: "/";
        margin: 0 0.7rem;
        color: var(--border-strong);
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 700;
    }

    .masthead-nav-link {
        display: inline-flex;
        align-items: center;
        padding: 0.18rem 0;
        font-family: var(--font-sans);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--foreground);
        white-space: nowrap;
        border-bottom: 1px solid transparent;
        transition: color 140ms ease, border-color 140ms ease;
    }

    .masthead-nav-link:hover,
    .masthead-nav-link.is-active {
        color: var(--nyt-red);
        border-color: currentColor;
    }

    .masthead-nav-link.is-active {
        color: var(--nyt-accent);
    }

    @media (max-width: 720px) {
        .topbar {
            padding-top: 0.35rem;
            padding-bottom: 0.35rem;
        }

        .topbar-row {
            grid-template-columns: 1fr;
            gap: 0.25rem;
        }

        .topbar-left,
        .topbar-center,
        .topbar-right {
            flex-wrap: nowrap;
        }

        .topbar-left {
            justify-content: space-between;
        }

        .topbar-center {
            justify-content: flex-start;
            padding-top: 0.05rem;
            border-top: 1px solid var(--border);
        }

        .topbar-date {
            text-align: left;
        }

        .topbar-right {
            flex-direction: row;
            align-items: center;
            gap: 0.6rem;
            overflow: hidden;
        }

        .topbar-links {
            flex-wrap: nowrap;
            gap: 0.45rem;
            width: auto;
            justify-content: flex-start;
            padding-bottom: 0.2rem;
            margin-bottom: -0.2rem;
        }

        .topbar-link {
            justify-content: center;
            padding: 0.38rem 0.65rem;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: color-mix(in srgb, var(--card) 80%, var(--surface-soft) 20%);
            box-shadow: 0 0.3rem 0.8rem color-mix(in srgb, var(--foreground) 4%, transparent);
            text-align: center;
            line-height: 1;
            font-size: 0.62rem;
            flex: 0 0 auto;
        }

        .topbar-right :global(button) {
            align-self: center;
            flex: 0 0 auto;
        }

        .topbar-edition {
            display: none;
        }

        .label-full {
            display: none;
        }

        .label-short {
            display: inline;
        }

        .masthead {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            margin-bottom: 0.15rem;
        }

        .masthead-inner {
            gap: 0.2rem;
        }

        .masthead-brand {
            gap: 0.45rem;
        }

        .masthead-sub {
            font-size: 0.62rem;
            letter-spacing: 0.11em;
        }

        .masthead-nav {
            padding-top: 0.35rem;
            padding-bottom: 0.45rem;
            margin-bottom: 0.4rem;
        }

        .masthead-nav-shell {
            align-items: center;
            flex-direction: row;
            gap: 0.8rem;
            overflow-x: auto;
            padding: 0.2rem 0;
            margin-right: -1rem; /* Allow scroll to edge */
            padding-right: 1rem;
        }

        .masthead-nav-kicker {
            padding-right: 0.6rem;
            font-size: 0.62rem;
        }

        .masthead-nav-list {
            flex-wrap: nowrap;
            gap: 0.38rem;
            min-width: 0;
            width: auto;
            padding-bottom: 0;
        }

        .masthead-nav-list-topics {
            padding-left: 0;
        }

        .masthead-nav-list li + li::before,
        .masthead-nav-kicker::after {
            display: none;
        }

        .masthead-nav-link {
            padding: 0.35rem 0.6rem;
            border: 1px solid var(--border);
            border-radius: 999px;
            font-size: 0.64rem;
            line-height: 1;
            background: color-mix(in srgb, var(--card) 82%, var(--surface-soft) 18%);
            box-shadow: 0 0.3rem 0.8rem color-mix(in srgb, var(--foreground) 4%, transparent);
        }

        .masthead-nav-link.is-active {
            background: color-mix(in srgb, var(--nyt-accent) 16%, var(--card) 84%);
        }

        :global(.dark) .topbar-center {
            border-top-color: color-mix(in srgb, var(--border) 82%, var(--nyt-accent) 18%);
        }

        :global(.dark) .topbar-link {
            border-color: color-mix(in srgb, var(--border) 78%, var(--nyt-accent) 22%);
            background:
                linear-gradient(180deg, color-mix(in srgb, var(--card) 92%, var(--background) 8%), color-mix(in srgb, var(--card) 82%, var(--background) 18%));
            box-shadow:
                0 0.45rem 1rem color-mix(in srgb, black 20%, transparent),
                inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
        }

        :global(.dark) .masthead-nav-link {
            border-color: color-mix(in srgb, var(--border) 74%, var(--nyt-accent) 26%);
            background:
                linear-gradient(180deg, color-mix(in srgb, var(--card) 90%, var(--background) 10%), color-mix(in srgb, var(--card) 80%, var(--background) 20%));
            box-shadow:
                0 0.4rem 0.9rem color-mix(in srgb, black 18%, transparent),
                inset 0 1px 0 color-mix(in srgb, white 7%, transparent);
        }

        :global(.dark) .masthead-nav-link.is-active {
            color: color-mix(in srgb, var(--nyt-accent) 80%, white 20%);
            border-color: color-mix(in srgb, var(--nyt-accent) 58%, var(--border) 42%);
            background:
                linear-gradient(180deg, color-mix(in srgb, var(--nyt-accent) 28%, var(--card) 72%), color-mix(in srgb, var(--nyt-accent) 18%, var(--card) 82%));
        }
    }

    @media (min-width: 900px) {
        .masthead-inner {
            grid-template-columns: auto 1fr;
            text-align: left;
            gap: 2rem;
        }

        .masthead-brand {
            justify-content: flex-start;
        }

        .masthead-copy {
            justify-content: flex-start;
            padding-bottom: 0.2rem;
        }
    }
</style>

<script is:inline>
    (function() {
        const initHeader = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const scrollThreshold = 100;
            const hideThreshold = 50;

            const updateHeader = () => {
                const currentScrollY = window.scrollY;
                const scrollDelta = currentScrollY - lastScrollY;

                // Always show at top
                if (currentScrollY < scrollThreshold) {
                    header.classList.remove('header-hidden');
                    lastScrollY = currentScrollY;
                    return;
                }

                // Hide on scroll down, show on scroll up
                if (scrollDelta > hideThreshold) {
                    header.classList.add('header-hidden');
                    lastScrollY = currentScrollY;
                } else if (scrollDelta < -hideThreshold) {
                    header.classList.remove('header-hidden');
                    lastScrollY = currentScrollY;
                }
            };

            let ticking = false;
            const onScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                    ticking = true;
                }
            };

            window.addEventListener('scroll', onScroll, { passive: true });
            
            // Cleanup function for possible future re-runs
            return () => window.removeEventListener('scroll', onScroll);
        };

        // Run on initial load
        initHeader();

        // Support Astro View Transitions if enabled later
        document.addEventListener('astro:page-load', initHeader);
    })();
</script>
