---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import TextScaleIsland from './TextScaleIsland';
import ScriptSwitcher from './ScriptSwitcher.astro';
import { Sparkles, BarChart3, Radio, ShieldCheck, Compass, GitBranch, Calendar } from 'lucide-react';
import { apiBaseUrl } from '../lib/apiBase';
import { getEditionStr } from '../utils/textUtils';
import Branding from './Branding.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import gitStats from '../git_stats.json';

interface Props {
    category?: string | null;
    topic?: string | null;
    entity?: string | null;
    subcategory?: string | null;
    q?: string | null;
    stats?: any | null;
    latestTickerItems?: any[];
}

const { category, topic, entity, subcategory, q, stats: propStats, latestTickerItems: propLatestTickerItems = [] } = Astro.props;

const hostHeader = Astro.request?.headers.get('host');
const lang = getLangFromUrl(Astro.url, hostHeader);
const t = useTranslations(lang);
const l = (path: string) => lang === 'sr' ? path : `/mk${path}`;

const currentDate = new Intl.DateTimeFormat(lang === 'sr' ? 'sr-RS' : 'mk-MK', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'Europe/Skopje'
}).format(new Date());

const currentEditionKey = getEditionStr(new Date());
const currentEdition = currentEditionKey ? t(currentEditionKey as any) : '';

const API_URL = apiBaseUrl();

interface NavItem {
    label: string;
    href: string;
}

let navigationData: { breaking: NavItem[]; sections: any[] } = { breaking: [], sections: [] };
let stats = propStats;
let latestTickerItems: any[] = (Array.isArray(propLatestTickerItems) ? propLatestTickerItems : [])
    .map((article: any) => ({
        label: article?.display_title || article?.title || t('header.latest'),
        href: `${l('/cluster/')}${article?.cluster_id}`,
        type: 'latest',
        created_at: article?.ingested_at || article?.created_at || null,
    }))
    .filter((item: any) => item.href && item.label)
    .slice(0, 6);

try {
    const requests = [fetch(`${API_URL}/navigation?lang=${lang}`)];
    const shouldFetchStats = !stats || typeof stats.last_1h !== 'number' || typeof stats.total_feeds === 'undefined';
    if (shouldFetchStats) {
        requests.push(fetch(`${API_URL}/stats/summary?lang=${lang}`));
    }

    const results = await Promise.allSettled(requests);
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        navigationData = await results[0].value.json();
    }
    if (shouldFetchStats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }

    if (!navigationData.breaking.length && latestTickerItems.length === 0) {
        const latestRes = await fetch(`${API_URL}/news?page_size=8&sort=recent&lang=${lang}`);
        if (latestRes.ok) {
            const latestData = await latestRes.json();
            latestTickerItems = (latestData?.clusters || []).map((cluster: any) => {
                const lead = Array.isArray(cluster?.articles) ? cluster.articles[0] : null;
                return {
                    label: cluster?.synthetic_headline || lead?.title || t('header.latest'),
                    href: `${l('/cluster/')}${cluster?.cluster_id}`,
                    type: cluster?.is_breaking ? 'breaking' : 'latest',
                    created_at: lead?.ingested_at || lead?.created_at || null,
                };
            }).filter((item: any) => item.href && item.label).slice(0, 6);
        }
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const hasBreaking = navigationData.breaking.length > 0;
const breakingItems = hasBreaking ? navigationData.breaking.slice(0, 5) : latestTickerItems;
const hasTicker = breakingItems.length > 0;
const visibleSections = (navigationData.sections || []).filter((section: any) => Array.isArray(section?.items) && section.items.length > 0);

// Idea A: Verification Counter Logic
const intel = stats?.intelligence;
const totalClusters = intel?.pluralism?.total_clusters || 0;
const highConsensusPct = intel?.pluralism?.high_consensus_pct || 0;
const pluralismPct = intel?.pluralism?.pluralism_pct || 0;
const hasDispatchStats = Boolean(stats && intel?.pluralism);

const confirmedFacts = Math.max(0, Math.round(totalClusters * (highConsensusPct / 100) * 4));
const activeConflicts = Math.max(0, Math.round(totalClusters * (1 - pluralismPct / 100) * 0.5));
const totalFeeds = stats?.total_feeds || 0;

function getRelativeTimeStr(dateStr?: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr.replace("Z", ""));
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return t('news.now');
        if (diffMins < 60) return `${t('news.ago')} ${diffMins} ${t('news.min_short')}`;

        return date.toLocaleTimeString(lang === 'sr' ? 'sr-RS' : 'mk-MK', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Belgrade'
        });
    } catch {
        return '';
    }
}
---

<div class="header-sticky-wrapper" id="main-header">
    {hasTicker && (
    <div class="unified-dispatch-bar">
        <div class="dispatch-container site-layout">
            <div class="dispatch-stats">
                <span class="stat-badge" title={`${gitStats.commits} commits`}>
                    <GitBranch size={11} className="text-nyt-accent" />
                </span>
                <span class="stat-badge" title={`${gitStats.days} ${lang === 'mk' ? 'дена во живо' : 'dana uživo'}`}>
                    <Calendar size={11} className="text-nyt-accent" />
                </span>
            </div>

            <div class="ticker-prefix">
                <span class="relative flex h-2 w-2 live-glow-indicator">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600 live-indicator-dot"></span>
                </span>
                <span class="ticker-label">{t('header.live')}</span>
            </div>
            <div class="mobile-ticker-compact">
                {breakingItems[0] && (
                    <a href={breakingItems[0].href} class="mobile-live-ticker-headline">
                        {breakingItems[0].created_at && <span class="ticker-time">{getRelativeTimeStr(breakingItems[0].created_at)}</span>}
                        <span class="ticker-title">{breakingItems[0].label}</span>
                    </a>
                )}
            </div>
            <div class="unified-ticker-track-wrap">
                <div class="unified-ticker-track">
                    <div class="ticker-content-segment">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                    {/* Duplicate for seamless looping */}
                    <div class="ticker-content-segment" aria-hidden="true">
                        {breakingItems.map((item: any) => {
                            const relativeTime = getRelativeTimeStr(item.created_at);
                            return (
                                <a href={item.href} class="live-ticker-headline">
                                    {relativeTime && <span class="ticker-time">{relativeTime}</span>}
                                    <span class="ticker-title">{item.label}</span>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </div>
    )}

    <header class="editorial-topbar site-layout">
        <div class="topbar-main">
            <div class="topbar-left-stack">
                <div class="search-entry-wrap">
                    <SearchIsland initialQuery={q} client:idle lang={lang} />
                </div>
            </div>

            <div class="topbar-branding">
                <a href={l('/')} class="brand-link">
                    <Branding mode="full" />
                </a>
            </div>

            <div class="topbar-actions">
                <div class="topbar-util">
                    <a href={l('/for-you')} class="user-action-link">{t('nav.for_you') || 'FOR YOU'}</a>
                    <ScriptSwitcher />
                    <ThemeIsland client:idle lang={lang} />
                    <TextScaleIsland client:idle />
                </div>
            </div>
        </div>
    </header>

    <nav class="site-layout discovery-nav-v2" aria-label={t('header.quick_nav')}>
        <div class="nav-rail-wrapper">
            <div class="nav-rail-scroll hide-scrollbar">
                <div class="nav-rail-content">
                    {visibleSections.map((section: any, idx) => {
                        const isCore = section.type === 'core' || idx === 0;
                        const isMagazine = section.type === 'magazine';
                        return (
                            <div class={`nav-rail-group ${isCore ? 'group-core' : isMagazine ? 'group-magazine' : 'group-dynamic'}`}>
                                <div class="group-links">
                                    {section.items.map((item: any) => {
                                        const isActive = item.href.includes('category=')
                                            ? category === item.label
                                            : item.href.includes('topic=')
                                            ? topic === item.label
                                            : item.href.includes('entity=')
                                            ? entity === item.label || entity === item.label.replace('#', '')
                                            : item.href.includes('subcategory=')
                                            ? subcategory === item.label
                                            : Astro.url.pathname === item.href || Astro.url.pathname + '/' === item.href;
                                        return (
                                            <a href={l(item.href)} class={`nav-rail-link ${isActive ? 'is-active' : ''} ${item.type === 'trending_tag' ? 'is-tag' : ''}`}>
                                                {item.type === 'trending_tag' && <span class="tag-prefix">#</span>}
                                                <span class="link-label">{item.label.replace('#', '')}</span>
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div class="nav-fade left"></div>
            <div class="nav-fade right"></div>
        </div>
    </nav>
</div>

<style>
    /* ── Unified Dispatch Ticker ────────────────────────── */
    .unified-dispatch-bar {
        background: linear-gradient(90deg, color-mix(in srgb, var(--nyt-accent) 4%, transparent), transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        height: 1.8rem;
        display: flex;
        align-items: center;
        z-index: 101;
        overflow: hidden;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
    }
    .dispatch-stats {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-right: 0.75rem;
        padding-right: 0.75rem;
        border-right: 1px solid var(--border);
        height: 100%;
    }
    .stat-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted-foreground);
        cursor: help;
        transition: transform 0.2s ease, opacity 0.2s ease;
        opacity: 0.85;
    }
    .stat-badge:hover {
        transform: scale(1.1);
        opacity: 1;
    }
    .dispatch-container { display: flex; align-items: center; height: 100%; }

    .ticker-prefix {
        display: flex; align-items: center; gap: 0.5rem;
        padding: 0 1.25rem; border-right: 1px solid var(--border);
        background: color-mix(in srgb, var(--background) 90%, transparent); backdrop-filter: var(--glass-blur); z-index: 2;
    }
    .ticker-label { font-family: var(--font-sans); font-size: 0.55rem; font-weight: 950; letter-spacing: 0.15em; color: var(--nyt-red); }

    .unified-ticker-track-wrap { flex: 1; overflow: hidden; position: relative; padding-left: 1rem; padding-right: 1rem; }
    .unified-ticker-track { display: flex; width: max-content; animation: unified-ticker-scroll 80s linear infinite; }
    @keyframes unified-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .unified-ticker-track:hover { animation-play-state: paused; }
    .mobile-ticker-compact { display: none; }

    .ticker-content-segment { display: flex; align-items: center; gap: 3rem; padding-right: 3rem; }

    .live-ticker-headline { font-family: var(--font-serif); font-size: 0.72rem; font-weight: 750; color: var(--foreground); text-decoration: none; display: flex; align-items: center; gap: 0.6rem; transition: color 0.2s; }
    .live-ticker-headline:hover { color: var(--nyt-accent); }
    .ticker-time { font-family: var(--font-sans); font-size: 0.58rem; font-weight: 950; color: var(--muted-foreground); opacity: 0.6; }

    /* ── Editorial Topbar ─────────────────────────────── */
    .header-sticky-wrapper {
        position: sticky; top: 0; z-index: 102;
        background: color-mix(in srgb, var(--background) 88%, transparent);
        backdrop-filter: blur(28px) saturate(190%); -webkit-backdrop-filter: blur(28px) saturate(190%);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease;
        box-shadow: 0 4px 30px -10px rgba(0, 0, 0, 0.05),
                    inset 0 -1px 0 rgba(255, 255, 255, 0.15);
    }
    :global(.dark) .header-sticky-wrapper {
        background: color-mix(in srgb, var(--background) 82%, transparent);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        box-shadow: 0 8px 40px -12px rgba(0, 0, 0, 0.5), inset 0 -1px 0 rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.03);
    }
    .header-sticky-wrapper.header-hidden { transform: translateY(-100%); }

    .editorial-topbar { padding: 1rem 0; }
    .topbar-main { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }

    .topbar-left-stack { display: flex; align-items: center; gap: 1.5rem; }
    .search-entry-wrap { width: 140px; }

    .topbar-branding { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0.5rem 0; }
    .brand-link { text-decoration: none; }

    .topbar-actions { display: flex; align-items: center; justify-content: flex-end; }
    .user-action-link {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 955;
        letter-spacing: 0.06em;
        color: var(--foreground);
        text-decoration: none;
        padding: 0.4rem 0.95rem;
        border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
        border-radius: 9999px;
        background: color-mix(in srgb, var(--secondary) 30%, transparent);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: inset 0 1px 0px 0px color-mix(in srgb, var(--foreground) 4%, transparent);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .user-action-link:hover {
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border-color: color-mix(in srgb, var(--nyt-accent) 35%, transparent);
        color: var(--nyt-accent);
        transform: translateY(-1px);
        box-shadow: 0 4px 15px -3px color-mix(in srgb, var(--nyt-accent) 15%, transparent);
    }

    .topbar-util { display: flex; align-items: center; gap: 1rem; }
    .activity-chip {
        display: flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.5rem;
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        font-family: var(--font-sans); font-size: 0.58rem; font-weight: 950; color: var(--nyt-accent); border-radius: 0px;
    }
    .activity-dot { width: 5px; height: 5px; background: var(--nyt-accent); border-radius: 50%; box-shadow: 0 0 8px var(--nyt-accent); }

    /* ── Discovery Navigation ────────────────────────── */
    .discovery-nav-v2 { border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent); background: transparent; }
    .nav-rail-wrapper { position: relative; }
    .nav-rail-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        display: flex;
        align-items: center;
        scroll-snap-type: x proximity;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .nav-rail-scroll::-webkit-scrollbar { display: none; }
    .nav-rail-content { display: flex; align-items: center; min-width: max-content; padding: 0.35rem 0; }

    .nav-fade {
        position: absolute; top: 0; bottom: 0; width: 48px; pointer-events: none;
        z-index: 10; transition: opacity 0.3s ease; opacity: 0;
    }
    .nav-fade.left { left: 0; background: linear-gradient(to right, color-mix(in srgb, var(--background) 90%, transparent), transparent); }
    .nav-fade.right { right: 0; background: linear-gradient(to left, color-mix(in srgb, var(--background) 90%, transparent), transparent); }

    .nav-rail-group { border-right: 1px solid color-mix(in srgb, var(--border) 40%, transparent); padding: 0 1.25rem; display: flex; align-items: center; height: 100%; flex-shrink: 0; scroll-snap-align: start; }
    .nav-rail-group:last-child { border-right: none; }

    .group-links { display: flex; align-items: center; gap: 0.25rem; }
    .nav-rail-link {
        font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; padding: 0.35rem 0.85rem;
        color: var(--muted-foreground); text-decoration: none; border-radius: 6px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); white-space: nowrap;
        border: 1px solid transparent;
        position: relative;
    }
    .nav-rail-link:hover {
        background: color-mix(in srgb, var(--foreground) 5%, transparent);
        color: var(--foreground);
        transform: translateY(-1px);
    }
    .nav-rail-link.is-active {
        color: var(--nyt-accent);
        background: color-mix(in srgb, var(--nyt-accent) 8%, transparent);
        border-color: color-mix(in srgb, var(--nyt-accent) 25%, transparent);
    }
    .nav-rail-link.is-active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0.85rem;
        right: 0.85rem;
        height: 2px;
        background: var(--nyt-accent);
        border-radius: 9999px;
        box-shadow: 0 0 10px 1px var(--nyt-accent);
    }
    .live-indicator-dot {
        box-shadow: 0 0 8px var(--nyt-red);
    }
    .nav-rail-link.is-tag { color: var(--nyt-accent); }
    .tag-prefix { opacity: 0.5; margin-right: 1px; }

    @media (max-width: 960px) {
        .editorial-topbar { padding: 0.5rem 0.75rem; }
        .topbar-main { grid-template-columns: auto 1fr auto; gap: 1rem; }
        .topbar-left-stack { order: 1; flex-direction: row; gap: 0.75rem; }
        .topbar-date-display { display: none; }
        .topbar-branding { order: 2; justify-content: flex-start; min-width: 0; }
        .topbar-actions { order: 3; flex-direction: row; }
        .mode-link span { display: none; }
        .search-entry-wrap { width: 140px; }
    }

    @media (max-width: 768px) {
        .topbar-main { gap: 0.75rem; }
        .search-entry-wrap { width: 120px; }
        .nav-fade { width: 28px; }
        .nav-rail-content { padding: 0.25rem 0; }
        .nav-rail-group { padding: 0 0.75rem; }
        .nav-rail-link { font-size: 0.62rem; padding: 0.35rem 0.55rem; }
    }

    @media (max-width: 640px) {
        .dispatch-container { min-width: 0; }
        .unified-dispatch-bar {
            height: 2.15rem;
            background: color-mix(in srgb, var(--background) 94%, transparent);
        }
        .ticker-prefix {
            flex-shrink: 0;
            gap: 0.3rem;
            padding: 0 0.6rem 0 0.75rem;
            border-right: none;
        }
        .ticker-label {
            font-size: 0.46rem;
            letter-spacing: 0.1em;
            white-space: nowrap;
        }
        .unified-ticker-track-wrap {
            display: block;
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        .mobile-ticker-compact {
            display: none;
        }
        .live-ticker-headline {
            font-size: 0.75rem;
        }
        .ticker-time {
            font-size: 0.54rem;
        }
        .mobile-live-ticker-headline {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: 0.55rem;
            min-width: 0;
            max-width: 100%;
            color: var(--foreground);
            text-decoration: none;
            width: 100%;
        }
        .mobile-live-ticker-headline .ticker-title {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-family: var(--font-serif);
            font-size: 0.82rem;
            font-weight: 780;
            line-height: 1;
        }
        .mobile-live-ticker-headline .ticker-time {
            flex-shrink: 0;
            font-size: 0.5rem;
            font-weight: 900;
            letter-spacing: 0.03em;
            padding-right: 0.5rem;
            border-right: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
            opacity: 0.8;
        }
        .editorial-topbar { padding: 0.55rem 0.5rem; }
        .topbar-main {
            grid-template-columns: 3.25rem minmax(0, 1fr) 7.25rem;
            gap: 0.35rem;
        }
        .topbar-left-stack,
        .topbar-actions {
            min-width: 0;
        }
        .topbar-left-stack {
            justify-content: flex-start;
        }
        .topbar-branding {
            min-width: 0;
            align-items: center;
        }
        .topbar-actions {
            justify-content: flex-end;
        }
        .search-entry-wrap { width: 3rem; }
        .topbar-util {
            gap: 0.2rem;
            justify-content: flex-end;
        }
        .user-action-link {
            display: none;
        }
        :global(#script-toggle) {
            min-width: 3rem;
            padding: 0.2rem 0.35rem;
            font-size: 0.46rem;
            letter-spacing: 0.08em;
            line-height: 1;
            text-align: center;
            border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
            border-radius: 9999px;
            background: color-mix(in srgb, var(--secondary) 72%, transparent);
        }
        :global(#script-toggle:hover) {
            background: color-mix(in srgb, var(--secondary) 92%, transparent);
        }
        :global(.topbar-actions .header-utility-button) {
            height: 2rem;
            width: 2rem;
            padding: 0;
        }
        :global(.topbar-actions .header-utility-button svg) {
            width: 1rem;
            height: 1rem;
        }
        .nav-rail-wrapper { border-top: 1px solid color-mix(in srgb, var(--border) 28%, transparent); }
        .nav-rail-scroll { padding: 0 0.25rem; scroll-padding-left: 0.65rem; }
        .nav-rail-content { padding: 0.15rem 0; }
        .nav-rail-group {
            padding: 0 0.3rem;
            border-right: none;
        }
        .group-links { gap: 0.15rem; }
        .nav-rail-link {
            font-size: 0.56rem;
            padding: 0.42rem 0.48rem;
            color: color-mix(in srgb, var(--muted-foreground) 92%, var(--foreground) 8%);
        }
    }

    @media (max-width: 480px) {
        .editorial-topbar { padding: 0.4rem 0.5rem; }
        .topbar-main {
            grid-template-columns: 2.8rem minmax(0, 1fr) 5rem;
            gap: 0.25rem;
        }
        .search-entry-wrap { width: 2.75rem; }
        .topbar-util { gap: 0.15rem; }
        .user-action-link { display: none; }
        :global(#script-toggle) {
            min-width: 2.7rem;
            padding: 0.18rem 0.25rem;
            font-size: 0.42rem;
        }
        .ticker-prefix {
            padding-left: 0.55rem;
            padding-right: 0.45rem;
        }
        .ticker-label {
            font-size: 0.42rem;
            letter-spacing: 0.08em;
        }
        .mobile-ticker-compact {
            padding-right: 0.55rem;
        }
        .mobile-live-ticker-headline {
            gap: 0.4rem;
        }
        .mobile-live-ticker-headline .ticker-time {
            font-size: 0.46rem;
            padding-right: 0.35rem;
        }
        .mobile-live-ticker-headline .ticker-title {
            font-size: 0.76rem;
        }
        :global(.topbar-actions button[aria-label="Promeni tema"]) {
            height: 1.9rem;
            width: 1.9rem;
        }
        .nav-rail-scroll { padding: 0 0.1rem; }
        .nav-rail-link { font-size: 0.54rem; padding: 0.4rem 0.45rem; }
    }

    @media (max-width: 768px) {
    }
</style>

<script is:inline>
    (function() {
        const initHeaderControl = () => {
            let lastScrollY = window.scrollY;
            const header = document.getElementById('main-header');
            if (!header) return;

            const handleScroll = () => {
                const currentScrollY = window.scrollY;
                if (currentScrollY < 80) {
                    header.classList.remove('header-hidden');
                } else if (currentScrollY > lastScrollY + 10) {
                    // Scrolling down - hide
                    header.classList.add('header-hidden');
                } else if (currentScrollY < lastScrollY - 20) {
                    // Scrolling up - show
                    header.classList.remove('header-hidden');
                }
                lastScrollY = currentScrollY;
            };

            window.addEventListener('scroll', handleScroll, { passive: true });
        };

        const initFades = () => {
            const navShell = document.querySelector('.nav-rail-scroll');
            const fadeLeft = document.querySelector('.nav-fade.left');
            const fadeRight = document.querySelector('.nav-fade.right');
            if (!navShell || !fadeLeft || !fadeRight) return;
            const update = () => {
                fadeLeft.style.opacity = navShell.scrollLeft > 15 ? '1' : '0';
                fadeRight.style.opacity = navShell.scrollLeft < navShell.scrollWidth - navShell.clientWidth - 15 ? '1' : '0';
            };
            navShell.addEventListener('scroll', update, { passive: true });
            update();
        };

        initHeaderControl();
        initFades();
        document.addEventListener('astro:page-load', () => {
            initHeaderControl();
            initFades();
        });
    })();
</script>
