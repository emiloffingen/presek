---
import SearchIsland from './SearchIsland';
import ThemeIsland from './ThemeIsland';
import type { TrendingWord } from '../types';
import { apiBaseUrl } from '../lib/apiBase';

interface Props {
    category?: string | null;
    topic?: string | null;
    q?: string | null;
    stats?: {
        last_1h?: number;
        last_24h?: number;
    } | null;
}

const { category, topic, q, stats: propStats } = Astro.props;

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

const API_URL = apiBaseUrl();

let trendingItems: TrendingWord[] = [];
let stats = propStats;

// Parallel fetch for trending and stats (if missing)
try {
    const promises = [fetch(`${API_URL}/trending`)];
    if (!stats) promises.push(fetch(`${API_URL}/stats/summary`));
    
    const results = await Promise.allSettled(promises);
    
    // Process Trending
    if (results[0].status === 'fulfilled' && results[0].value.ok) {
        const data = await results[0].value.json();
        if (Array.isArray(data)) trendingItems = data.slice(0, 8);
    }
    
    // Process Stats (only if we fetched them)
    if (!stats && results[1]?.status === 'fulfilled' && results[1].value.ok) {
        stats = await results[1].value.json();
    }
} catch (e) {
    console.error('[Header] Fetch error:', e);
}

const headerItems = trendingItems.slice(0, 4);
const trendingWordSet = new Set(headerItems.map((item: any) => item.word));
const curatedTopics = ['Политика', 'Свет']
    .filter((item) => !trendingWordSet.has(item));
const navItems = [
    ...headerItems.map((item: any) => ({
        label: item.word,
        href: `/?${new URLSearchParams({ q: item.word }).toString()}`,
        isActive: q === item.word,
        trend: item.trend,
        isBreaking: item.is_breaking,
    })),
    ...curatedTopics.map((item: string) => ({
        label: item,
        href: `/tema/${encodeURIComponent(item)}`,
        isActive: topic === item || category === item,
        trend: '→',
        isBreaking: false,
    })),
].slice(0, 6);
const telegramUrl = 'https://t.me/+lt4m-3TGQH9iZTAy';
const liveCount = typeof stats?.last_1h === 'number' ? stats.last_1h : null;
const dayCount = typeof stats?.last_24h === 'number' ? stats.last_24h : null;
const leadTopic = navItems[0]?.label || topic || category || 'Македонија';
---

<div class="header-sticky-wrapper" id="main-header">
    <header class="site-layout topbar">
        <div class="topbar-row">
            <div class="topbar-left">
                <div class="search-trigger-wrap">
                    <SearchIsland client:load />
                    <span class="search-hint hidden lg:inline">⌘K</span>
                </div>
                <span class="topbar-edition">
                    {stats?.last_1h && stats.last_1h > 0 ? (
                        <span class="live-update-badge">
                            <span class="pulse-dot"></span>
                            +{stats.last_1h} нови објави овој час
                        </span>
                    ) : (
                        "ПРЕСЕК.мк Денешно Издание"
                    )}
                </span>
            </div>

            <div class="topbar-center">
                <span class="nyt-section-label topbar-date">{currentDate}</span>
            </div>

            <div class="topbar-right">
                <div class="topbar-links flex overflow-x-auto whitespace-nowrap hide-scrollbar md:flex-wrap">
                    <a href="/briefing" class="nyt-section-label topbar-link">
                        <span class="label-full">Дневен Брифинг</span>
                        <span class="label-short">Брифинг</span>
                    </a>
                    <a href="/stats" class="nyt-section-label topbar-link">
                        <span class="label-full">Медиумски Пулс</span>
                        <span class="label-short">Пулс</span>
                    </a>
                    <a href="/settings" class="nyt-section-label topbar-link topbar-link-quiet">
                        <span class="label-full">Поставки</span>
                        <span class="label-short">Поставки</span>
                    </a>
                    <a href={telegramUrl} class="nyt-section-label topbar-link topbar-link-accent topbar-link-external topbar-link-priority" target="_blank" rel="noopener noreferrer">
                        <span class="label-full">Телеграм канал</span>
                        <span class="label-short">Телеграм</span>
                    </a>
                </div>
                <ThemeIsland client:load />
            </div>
        </div>
    </header>

    <div class="site-layout masthead">
        <div class="masthead-inner">
            <div class="masthead-left hidden lg:flex">
                <div class="masthead-metric-group">
                    <span class="masthead-metric-label">Активност</span>
                    <div class="masthead-metric-value">
                        <strong>{liveCount && liveCount > 0 ? `+${liveCount}` : 'Живо'}</strong>
                        <span class="pulse-dot"></span>
                    </div>
                    <span class="masthead-metric-sub">нови објави овој час</span>
                </div>
            </div>

            <div class="masthead-center">
                <div class="masthead-brand">
                    <a href="/" class="contents">
                        <img src="/img/presek_emblem.svg?v=3" alt="Presek Emblem" class="site-emblem h-6 md:h-10 site-logo" />
                    </a>
                    <a href="/" class="block">
                        <img src="/logo.svg?v=3" alt="Presek" class="site-logo h-10 md:h-16 lg:h-20" />
                    </a>
                </div>
                <p class="masthead-sub">Вестите, групирани. Контекстот, јасен.</p>
            </div>

            <div class="masthead-right hidden lg:flex">
                <div class="masthead-metric-group text-right">
                    <span class="masthead-metric-label">Покриеност</span>
                    <div class="masthead-metric-value justify-end">
                        <strong>{dayCount && dayCount > 0 ? dayCount.toLocaleString('mk-MK') : leadTopic}</strong>
                    </div>
                    <span class="masthead-metric-sub">објави во последни 24ч</span>
                </div>
            </div>
        </div>
    </div>

    <nav class="site-layout masthead-nav" aria-label="Популарно сега">
        <div class="masthead-nav-container">
            <div class="masthead-nav-shell hide-scrollbar">
                {navItems.length > 0 && (
                    <ul class="masthead-nav-list">
                        <li class="masthead-nav-kicker-item">
                            <span class="masthead-nav-kicker">Актуелно</span>
                        </li>
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class={`masthead-nav-link ${item.isActive ? 'is-active' : ''}`}>
                                    {item.isBreaking && <span class="breaking-dot"></span>}
                                    {item.label}
                                    {item.trend !== '→' && <span class={`trend-indicator is-${item.trend === '↑' ? 'up' : 'down'}`}>{item.trend}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
            <div class="nav-fade-left"></div>
            <div class="nav-fade-right"></div>
        </div>
    </nav>
</div>

