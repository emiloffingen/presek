---
// Kept as the import every page uses; renders the 2026-10 broadsheet header.
import SiteHeader from './layout/SiteHeader.astro';

interface Props {
    category?: string | null;
    topic?: string | null;
    entity?: string | null;
    subcategory?: string | null;
    q?: string | null;
    stats?: any | null;
    latestTickerItems?: any[];
}

const { category, topic, entity, subcategory, q, stats } = Astro.props;
---

<SiteHeader category={category} topic={topic} entity={entity} subcategory={subcategory} q={q} stats={stats} />
