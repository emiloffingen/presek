---
// 🌐 PRESEK - Consolidated Multi-language Site (Serbian & Macedonian)
// This layout handles both presek.live (sr) and presek.mk (mk) via Astro i18n.

import '../styles/global.css';
import '../lib/transliterationInit.js';
import ConsentBanner from '../components/ConsentBanner';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
	schema?: object;
	robots?: string;
}

// Use Host header to determine the correct domain for multi-site support
const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = getLangFromUrl(effectiveUrl);
const t = useTranslations(lang);

const {
	title,
	description = lang === 'sr'
        ? "Presek je moderni srpski agregator vesti koji koristi naprednu jezičku obradu (NLP) za grupisanje i sumiranje najvažnijih događaja iz svih medija."
        : "Пресек е модерен македонски агрегатор на вести кој користи напредна јазична обработка (NLP) за групирање и сумирање на најважните настани од сите медиуми.",
	image = "/img/presek_emblem.png",
	canonical,
	type = "website",
	schema,
	robots,
} = Astro.props;

// Also update the default description for Macedonian site
const defaultDescription = lang === 'sr'
    ? "Presek je srpski informativni agregator koji sakuplja vesti iz svih medija, grupiše ih po temi i pokazuje kako različiti izvori izveštavaju o istom događaju."
    : "Пресек е македонски информативен агрегатор кој собира вести од сите медиуми, ги групира по тема и покажува како различни извори известуваат за истиот настан.";

const siteUrl = lang === 'sr' ? "https://presek.live" : "https://presek.mk";
const siteName = lang === 'sr' ? "PRESEK.rs" : "PRESEK.mk";
const pageTitle = title.includes("Presek") || title.includes("Пресек")
    ? title.replace(/Presek|Пресек/, siteName)
    : `${title} | ${siteName}`;

function buildCanonicalUrl(pathname: string): string {
	const base = new URL(siteUrl);
	const url = new URL(pathname, base);
	let clean = url.origin + url.pathname.replace(/\/+$/, "");
	if (clean === url.origin || clean === url.origin + "") return url.origin;
	return clean;
}

const canonicalUrl = canonical || buildCanonicalUrl(requestUrl.pathname);
const imageUrl = /^https?:\/\//i.test(image) ? image : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;

// Generate hreflang URLs for cross-domain SEO.
// Serbian routes live at root; Macedonian routes live under /mk even on presek.mk.
const alternatePath = requestUrl.pathname.replace(/^\/mk/, '').replace(/\/+$/, "");
const srHref = `https://presek.live${alternatePath || ""}`;
const mkHref = `https://presek.mk/mk${alternatePath || ""}`;
const normalizedHost = hostHeader.split(':')[0].toLowerCase();
const shouldLoadAdsense = lang === 'sr' && (normalizedHost === 'presek.live' || normalizedHost === 'www.presek.live');

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteUrl}/#organization`,
	"name": siteName,
	"url": siteUrl,
	"logo": {
		"@type": "ImageObject",
		"url": `${siteUrl}/img/presek_emblem.png`,
		"width": 512,
		"height": 512
	},
	"sameAs": [
		"https://twitter.com/presek_rs",
		"https://facebook.com/presek.rs",
		"https://instagram.com/presek.rs"
	]
};
---

<!doctype html>
<html lang={lang === 'sr' ? "sr-Latn" : "mk"}>
	<head>
		{/* Load Google Analytics immediately after <head> to satisfy verification bots. */}
		{lang === 'mk' ? (
			<Fragment set:html={`<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-YJZH9KK8X9"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-YJZH9KK8X9');
</script>`} />
		) : (
			<Fragment set:html={`<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-SV2R3LZJ5C"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-SV2R3LZJ5C');
</script>`} />
		)}
		<script is:inline>
			(function() {
				try {
					var savedScale = localStorage.getItem('text-scale') || '1';
					document.documentElement.style.setProperty('--text-scale', savedScale);
				} catch (e) {}
			})();
		</script>

		{shouldLoadAdsense && (
			<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1724921768403014" crossorigin="anonymous"></script>
		)}
		{shouldLoadAdsense && (
			<meta name="google-adsense-account" content="ca-pub-1724921768403014" />
		)}
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=4" />
		<link rel="apple-touch-icon" href="/img/icons/presek-apple-touch.png?v=1" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content={siteName} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description || defaultDescription} />
		{robots && <meta name="robots" content={robots} />}
		
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="sr-Latn-RS" href={srHref} />
		<link rel="alternate" hreflang="mk-MK" href={mkHref} />
		<link rel="alternate" hreflang="x-default" href={srHref} />

		{image && !image.includes('presek_emblem') && (
			<link rel="preload" as="image" href={imageUrl} fetchpriority="high" />
		)}

		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={lang === 'sr' ? "sr_RS" : "mk_MK"} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || defaultDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description || defaultDescription} />
		<meta name="twitter:image" content={imageUrl} />

		<title>{pageTitle}</title>

		<ClientRouter />

		{schema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		)}
		{/* News Organization Schema for Google News */}
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

		<script is:inline>
			/**
			 * Immediate theme sync to prevent flicker.
			 */
			function applyTheme() {
				const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = stored ? stored === 'dark' : (stored === null ? prefersDark : false);

				if (isDark) {
					document.documentElement.classList.add('dark');
                    document.documentElement.style.colorScheme = 'dark';
				} else {
					document.documentElement.classList.remove('dark');
                    document.documentElement.style.colorScheme = 'light';
				}

				// Update theme-color meta tags
				const lightMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: light)"]');
				const darkMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: dark)"]');
				var themeColor = isDark ? '#0b0d13' : '#fdfdfa';
				if (lightMeta) lightMeta.setAttribute('content', themeColor);
				if (darkMeta) darkMeta.setAttribute('content', themeColor);
			}

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
<style is:global>
    .noise-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        opacity: 0.012;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    .dark .noise-overlay {
        opacity: 0.02;
    }

    #loading-bar {
        background: var(--nyt-accent);
        height: 2px;
    }
</style>

	<body id="top" class:list={["antialiased min-h-screen bg-background text-foreground transition-colors duration-300 overflow-x-hidden w-full", { "script-latin": lang === 'sr', "script-cyrillic": lang === 'mk' }]}>
		<div class="noise-overlay" aria-hidden="true"></div>
		<div id="loading-bar" class="fixed top-0 left-0 z-[9999] transition-all duration-300 opacity-0 w-0"></div>
		<slot />
		<ConsentBanner client:idle />
		<script is:inline>
			// Handle Astro transitions loading state
			document.addEventListener('astro:before-preparation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '30%';
					bar.style.opacity = '1';
				}
			});

			document.addEventListener('astro:after-preparation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '100%';
					setTimeout(() => {
						bar.style.opacity = '0';
						setTimeout(() => { bar.style.width = '0'; }, 300);
					}, 200);
				}
			});
		</script>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(err => {
						console.warn('Service Worker registration failed:', err);
					});
				});

				// Network-aware dynamic background prefetching for instant PWA loading
				const dispatchPrefetch = () => {
					if (navigator.serviceWorker.controller) {
						const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
						if (conn) {
							if (conn.saveData || (conn.effectiveType && conn.effectiveType !== '4g')) {
								return; // Skip prefetch on slow connection or data-saver
							}
						}
						const clusterUrls = Array.from(document.querySelectorAll('a'))
							.map(a => a.getAttribute('href'))
							.filter(href => href && (href.startsWith('/cluster/') || href.startsWith('/mk/cluster/')))
							.map(href => new URL(href, window.location.origin).pathname);
						
						const uniqueUrls = [...new Set(clusterUrls)].slice(0, 8);
						if (uniqueUrls.length > 0) {
							navigator.serviceWorker.controller.postMessage({
								type: 'PREFETCH_URLS',
								urls: uniqueUrls
							});
						}
					}
				};

				// Trigger on initial page load and all subsequent Astro client-side page transitions
				const schedulePrefetch = () => {
					const idle = window.requestIdleCallback || ((cb) => window.setTimeout(cb, 1500));
					idle(dispatchPrefetch, { timeout: 4000 });
				};
				document.addEventListener('astro:page-load', schedulePrefetch);
			}

			// Parallax Effect for Hero Images
			function initParallax() {
				if (window.innerWidth < 1024) return;
				const parallaxEls = Array.from(document.querySelectorAll('.lead-media-image, .cluster-visual-image'));
				if (parallaxEls.length === 0) return;
				let ticking = false;
				const handleScroll = () => {
					if (ticking) return;
					ticking = true;
					window.requestAnimationFrame(() => {
						const scrolled = window.scrollY;
						for (const el of parallaxEls) {
							el.style.setProperty('--parallax-y', `${scrolled * 0.15}px`);
						}
						ticking = false;
					});
				};
				const parallaxWindow = /** @type {Window & { _presekParallaxHandler?: (event: Event) => void }} */ (window);
				if (parallaxWindow._presekParallaxHandler) {
					window.removeEventListener('scroll', parallaxWindow._presekParallaxHandler);
				}
				parallaxWindow._presekParallaxHandler = handleScroll;
				window.addEventListener('scroll', handleScroll, { passive: true });
			}
			initParallax();
			document.addEventListener('astro:page-load', initParallax);
		</script>

		<script is:inline>
			// Global Headline Reveal Animation
			const initHeadlineReveal = () => {
				const headlineWindow = /** @type {Window & { _presekHeadlineObserver?: IntersectionObserver }} */ (window);
				if (headlineWindow._presekHeadlineObserver) {
					headlineWindow._presekHeadlineObserver.disconnect();
				}
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
						}
					});
				}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

				document.querySelectorAll('.headline, .editorial-headline, .lead-media-frame').forEach(el => {
					observer.observe(el);
				});
				headlineWindow._presekHeadlineObserver = observer;
			};

			document.addEventListener('astro:page-load', initHeadlineReveal);
			initHeadlineReveal();

			// Interactive Spotlight Hover Effect
			const initSpotlight = () => {
					const targets = Array.from(document.querySelectorAll('.premium-spotlight'));
					if (targets.length === 0 || window.matchMedia('(pointer: coarse)').matches) return;
					/** @type {MouseEvent | null} */
					let pendingEvent = null;
					let ticking = false;
					/** @param {MouseEvent} e */
					const handleMouseMove = (e) => {
						pendingEvent = e;
						if (ticking) return;
						ticking = true;
						window.requestAnimationFrame(() => {
							if (!pendingEvent) return;
							for (const target of targets) {
								if (!(target instanceof HTMLElement)) continue;
								const rect = target.getBoundingClientRect();
								const x = pendingEvent.clientX - rect.left;
								const y = pendingEvent.clientY - rect.top;
								target.style.setProperty('--mouse-x', `${x}px`);
								target.style.setProperty('--mouse-y', `${y}px`);
							}
							ticking = false;
						});
					};
					const spotlightWindow = /** @type {Window & { _spotlightHandler?: (event: MouseEvent) => void }} */ (window);
					if (spotlightWindow._spotlightHandler) {
						window.removeEventListener('mousemove', spotlightWindow._spotlightHandler);
					}
					spotlightWindow._spotlightHandler = handleMouseMove;
					window.addEventListener('mousemove', handleMouseMove);
				};
			document.addEventListener('astro:page-load', initSpotlight);
			initSpotlight();
		</script>
		<script>
			// Global Image Loading and Fallback System (CSP-compliant, replacing inline onload/onerror)
			const handleImageLoad = (img: HTMLImageElement) => {
				img.classList.add('is-loaded');
				const imageWrap = img.closest('.image-wrap');
				if (imageWrap) {
					imageWrap.setAttribute('data-image-state', 'ready');
				}
				const leadFrame = img.closest('.lead-media-frame');
				if (leadFrame) {
					leadFrame.classList.add('media-ready');
				}
			};

			const handleImageError = (img: HTMLImageElement) => {
				if (img.classList.contains('article-image') && !img.classList.contains('article-image-fallback')) {
					img.removeAttribute('srcset');
					const fallbackUrl = img.getAttribute('data-fallback-url') || '/img/fallbacks/news-general.svg';
					img.src = fallbackUrl;
					img.classList.add('is-loaded', 'article-image-fallback');
					const imageWrap = img.closest('.image-wrap');
					if (imageWrap) {
						imageWrap.classList.add('image-wrap-fallback');
						imageWrap.setAttribute('data-image-state', 'fallback');
					}
				}
				if (img.classList.contains('lead-media-image') && !img.classList.contains('lead-media-fallback-image')) {
					img.removeAttribute('srcset');
					const fallbackUrl = img.getAttribute('data-fallback-url') || '/img/fallbacks/news-general.svg';
					img.src = fallbackUrl;
					img.classList.add('is-loaded', 'lead-media-fallback-image');
					const parent = img.parentElement;
					if (parent) {
						parent.classList.add('media-ready', 'lead-media-frame-fallback');
					}
				}
			};

			// Listen to events at document level using capturing phase (since load/error do not bubble)
			document.addEventListener('load', (event) => {
				const target = event.target as HTMLElement;
				if (target && target.tagName === 'IMG') {
					handleImageLoad(target as HTMLImageElement);
				}
			}, true);

			document.addEventListener('error', (event) => {
				const target = event.target as HTMLElement;
				if (target && target.tagName === 'IMG') {
					handleImageError(target as HTMLImageElement);
				}
			}, true);

			// Immediately check images that have already loaded or failed (handling cache/SSR fast loading)
			const checkAllImages = () => {
				document.querySelectorAll('img').forEach((img) => {
					if (img.complete) {
						if (img.naturalWidth === 0) {
							handleImageError(img);
						} else {
							handleImageLoad(img);
						}
					}
				});
			};

			// Run on initial script execution and on client-side page transitions
			checkAllImages();
			document.addEventListener('astro:page-load', checkAllImages);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--layout-cache-bust-20260409: 1;
	}

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        overflow-x: hidden;
        width: 100%;
        position: relative;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

	/* Broadstreet Aesthetic Adjustments */
	.dark .site-logo {		filter: invert(1) brightness(1.5);
	}
	.dark .site-emblem {
		filter: invert(1) brightness(1.5);
	}

    /* Ensure serif fonts are applied to all broadsheet text */
    .nyt-serif {
    font-family: var(--font-serif);
    }

    .nyt-sans {
    font-family: var(--font-sans);
    }

    h1, h2, h3, .headline, .editorial-headline {
    text-wrap: balance;
    letter-spacing: -0.015em;
    }

    p, .summary {
    text-wrap: pretty;
    }

    /* Local script readability polish */
    .script-latin {
    --font-serif: "Noto Serif", "Source Serif 4", Georgia, serif;
    --font-serif-display: "Noto Serif Display", "Noto Serif", Georgia, serif;
    --font-nyt-body: "Source Serif 4", "Noto Serif", Georgia, serif;
    --font-sans: "Manrope", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    --font-ui: "Manrope", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    --font-ui-condensed: "Manrope", "IBM Plex Sans Condensed", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    }

    .script-cyrillic {
    --font-serif: "Noto Serif", "Source Serif 4", Georgia, serif;
    --font-serif-display: "Noto Serif Display", "Noto Serif", Georgia, serif;
    --font-nyt-body: "Source Serif 4", "Noto Serif", Georgia, serif;
    --font-sans: "Manrope", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    --font-ui: "Manrope", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    --font-ui-condensed: "Manrope", "Noto Sans", "DejaVu Sans", Arial, sans-serif;
    line-height: 1.55;
    }

    .script-cyrillic h1, 
    .script-cyrillic h2, 
    .script-cyrillic h3, 
    .script-cyrillic .headline {
    letter-spacing: -0.01em; /* Cyrillic needs slightly more air than Latin */
    line-height: 1.15;
    }

    /* Skeleton Loading */    .skeleton {
        position: relative;
        overflow: hidden;
        background-color: var(--muted);
        border-radius: 0px;
    }

    .skeleton::after {
        content: "";
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.08),
            transparent
        );
        animation: shimmer 2s infinite;
    }

    .dark .skeleton::after {
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.05),
            transparent
        );
    }

    @keyframes shimmer {
        100% {
            transform: translateX(100%);
        }
    }

    /* Selection Color */
    ::selection {
        background-color: #326891;
        color: white;
    }

    /* --- CRITICAL MOBILE UI FIXES --- */
    html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        -webkit-text-size-adjust: 100%;
        position: relative;
        overflow-wrap: break-word;
        word-wrap: break-word;
    }

    * {
        box-sizing: border-box !important;
    }

    h1, h2, h3, h4, h5, h6, p, span, a {
        overflow-wrap: break-word;
    }

    @media (max-width: 480px) {
        .headline-lead {
            font-size: 1.85rem !important;
            line-height: 1.1 !important;
        }
        .editorial-headline {
            font-size: 1.75rem !important;
        }
    }

    img, video, canvas, svg, iframe {
        max-width: 100% !important;
        height: auto !important;
    }

    /* Prevent wide tables from breaking layout */
    table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    </style>
