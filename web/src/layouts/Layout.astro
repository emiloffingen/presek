---
import '../styles/global.css';
import ThemeIsland from '../components/ThemeIsland';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
}

const {
	title,
	description = "Пресек е македонска платформа за следење вести, споредба на извори и брз преглед на главните развои.",
	image = "/og-image.svg",
	canonical,
	type = "website",
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://presek.live").replace(/\/+$/, "");
const pageTitle = title.includes("Пресек") ? title : `${title} | Пресек`;
const canonicalPath = Astro.url?.pathname
	? `${Astro.url.pathname}${Astro.url.search || ""}`
	: "/";
const canonicalUrl = canonical || `${siteUrl}${canonicalPath}`;
const imageUrl = /^https?:\/\//i.test(image) ? image : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;
---

<!doctype html>
<html lang="mk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg?v=3" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="Пресек" />
		<meta property="og:locale" content="mk_MK" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<title>{pageTitle}</title>

		<script is:inline>
			// Immediate theme sync to prevent flicker
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="antialiased min-h-screen bg-background text-foreground transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	/* Broadstreet Aesthetic Adjustments */
	.dark .site-logo {
		filter: invert(1) brightness(1.5);
	}
	.dark .site-emblem {
		filter: invert(1) brightness(1.5);
	}
    
    /* Ensure serif fonts are applied to all broadsheet text */
    .nyt-serif {
        font-family: var(--font-serif);
    }
    
    .nyt-sans {
        font-family: var(--font-sans);
    }

    /* Selection Color */
    ::selection {
        background-color: #326891;
        color: white;
    }
</style>
