---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Presek - Македонска агрегација на вести со ЈИ синтеза" } = Astro.props;
---

<!doctype html>
<html lang="mk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		
		<!-- Google Fonts: Lora (Headlines) + Inter (Reading & UI) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

		<title>{title} | Пресек</title>

		<script is:inline>
			// Immediate theme sync to prevent flicker
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-primary text-primary antialiased transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #ffffff;
		--bg-secondary: #f7f7f8;
		--text-primary: #0f1117;
		--text-secondary: #3d4151;
		--text-muted: #6b7185;
		--border-color: #e4e4e8;
		--accent-color: #cc1a1a;
		--accent-hover: #a81414;
		--nyt-font-serif: 'Lora', serif;
		--nyt-font-sans: 'Inter', sans-serif;
	}

	.dark {
		--bg-primary: #0f1117;
		--bg-secondary: #1a1d27;
		--text-primary: #f1f5f9;
		--text-secondary: #cbd5e1;
		--text-muted: #94a3b8;
		--border-color: #2a2d3a;
		--accent-color: #ff4d4d;
		--accent-hover: #e82323;
	}

	html {
		font-family: var(--nyt-font-sans);
		background: var(--bg-primary);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
	}

	h1, h2, h3, h4, h5, h6, .font-serif {
		font-family: var(--nyt-font-serif);
	}

	/* Common Utility Classes for the Broadsheet look */
	.site-layout {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.rail-label {
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	.border-nyt {
		border-color: var(--border-color);
	}

	/* News Grid */
	.news-feed-grid {
		display: grid;
		grid-template-cols: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.news-feed-grid {
			grid-template-cols: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.news-feed-grid {
			grid-template-cols: repeat(3, 1fr);
		}
	}

	.lead-story {
		grid-column: 1 / -1;
	}

	@media (min-width: 1024px) {
		.lead-story {
			display: grid;
			grid-template-cols: repeat(12, 1fr);
			gap: 2rem;
		}
		.lead-story .cluster-thumb-wrap {
			grid-column: span 8;
		}
		.lead-story .cluster-main {
			grid-column: span 4;
		}
	}
</style>
