---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
	schema?: object;
	robots?: string;
}

const {
	title,
	description = "Пресек е модерен македонски агрегатор на вести кој користи напредна јазична обработка (NLP) за да ги групира и сумира најважните настани од сите медиуми.",
	image = "/static/img/presek_emblem.png",
	canonical,
	type = "website",
	schema,
	robots,
} = Astro.props;

const siteUrl = (Astro.site?.origin || import.meta.env.PUBLIC_SITE_URL || "https://presek.live").replace(/\/+$/, "");
const pageTitle = title.includes("Пресек") ? title.replace("Пресек", "ПРЕСЕК.мк") : `${title} | ПРЕСЕК.мк`;

/**
 * Build a strict canonical URL:
 * - Always absolute via new URL(pathname, Astro.site)
 * - Strip trailing slashes (trailingSlash: 'never' policy)
 * - Strip query parameters and hash fragments
 * - Home page resolves to bare origin (no trailing slash)
 */
function buildCanonicalUrl(pathname: string): string {
	const base = Astro.site || new URL("https://presek.live");
	const url = new URL(pathname, base);
	// Strip trailing slash for all paths except root
	let clean = url.origin + url.pathname.replace(/\/+$/, "");
	// Ensure root is just the origin
	if (clean === url.origin || clean === url.origin + "") return url.origin;
	return clean;
}

const canonicalUrl = canonical || buildCanonicalUrl(Astro.url.pathname);

const imageUrl = /^https?:\/\//i.test(image) ? image : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;
---

<!doctype html>
<html lang="mk">
	<head>
		<script async src="https://jsc.adskeeper.com/site/1093736.js" async></script>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-SV2R3LZJ5C"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-SV2R3LZJ5C');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=4" />
		<link rel="apple-touch-icon" href="/img/presek_emblem.png?v=4" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="ПРЕСЕК.мк" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="ПРЕСЕК.мк" />
		<meta property="og:locale" content="mk_MK" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		
		<title>{pageTitle}</title>

		<ClientRouter />

		{schema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		)}

		<script is:inline>
			/**
			 * Immediate theme sync to prevent flicker. 
			 * We encapsulate in a function so it can be re-run on 'astro:after-swap'.
			 */
			function applyTheme() {
				const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
				const isDark = stored ? stored === 'dark' : true;
				
				if (isDark) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}

				// Update theme-color meta tags
				const lightMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: light)"]');
				const darkMeta = document.querySelector('meta[name="theme-color"][media="(prefers-color-scheme: dark)"]');
				if (lightMeta) lightMeta.setAttribute('content', isDark ? '#000000' : '#fafafb');
				if (darkMeta) darkMeta.setAttribute('content', isDark ? '#000000' : '#1a1715');
			}

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body id="top" class="antialiased min-h-screen bg-background text-foreground transition-colors duration-300 overflow-x-hidden w-full">
		<div class="noise-overlay"></div>
		<div id="loading-bar" class="fixed top-0 left-0 h-[2px] bg-nyt-accent z-[9999] transition-all duration-300 opacity-0 w-0"></div>
		<slot />
		<ConsentBanner client:idle />
		<script>
			// Handle Astro transitions loading state
			document.addEventListener('astro:before-preparation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '30%';
					bar.style.opacity = '1';
				}
			});

			document.addEventListener('astro:after-preparation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '100%';
					setTimeout(() => {
						bar.style.opacity = '0';
						setTimeout(() => { bar.style.width = '0'; }, 300);
					}, 200);
				}
			});
		</script>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(err => {
						console.warn('Service Worker registration failed:', err);
					});
				});
			}

			// Parallax Effect for Hero Images
			function initParallax() {
				if (window.innerWidth < 1024) return;
				const handleScroll = () => {
					const scrolled = window.scrollY;
					document.querySelectorAll('.lead-media-image, .cluster-visual-image').forEach(el => {
						const speed = 0.15;
						el.style.setProperty('--parallax-y', `${scrolled * speed}px`);
					});
				};
				window.addEventListener('scroll', handleScroll, { passive: true });
			}
			initParallax();
			document.addEventListener('astro:page-load', initParallax);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--layout-cache-bust-20260409: 1;
	}

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        overflow-x: hidden;
        width: 100%;
        position: relative;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

	/* Broadstreet Aesthetic Adjustments */
	.dark .site-logo {		filter: invert(1) brightness(1.5);
	}
	.dark .site-emblem {
		filter: invert(1) brightness(1.5);
	}
    
    /* Ensure serif fonts are applied to all broadsheet text */
    .nyt-serif {
        font-family: var(--font-serif);
    }
    
    .nyt-sans {
        font-family: var(--font-sans);
    }

    /* Skeleton Loading */
    .skeleton {
        position: relative;
        overflow: hidden;
        background-color: var(--muted);
        border-radius: 4px;
    }

    .skeleton::after {
        content: "";
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.08),
            transparent
        );
        animation: shimmer 2s infinite;
    }

    .dark .skeleton::after {
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.05),
            transparent
        );
    }

    @keyframes shimmer {
        100% {
            transform: translateX(100%);
        }
    }

    /* Selection Color */
    ::selection {
        background-color: #326891;
        color: white;
    }

    /* --- CRITICAL MOBILE UI FIXES --- */
    html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        -webkit-text-size-adjust: 100%;
        position: relative;
    }

    * {
        box-sizing: border-box !important;
    }

    img, video, canvas, svg, iframe {
        max-width: 100% !important;
        height: auto !important;
    }

    /* Prevent wide tables from breaking layout */
    table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    </style>
