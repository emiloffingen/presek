---
import '../styles/global.css';
import ThemeIsland from '../components/ThemeIsland';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Presek - Македонска агрегација на вести со ЈИ синтеза" } = Astro.props;
---

<!doctype html>
<html lang="mk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | Пресек</title>

		<script is:inline>
			// Immediate theme sync to prevent flicker
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="antialiased min-h-screen bg-background text-foreground transition-colors duration-300">
		<ThemeIsland client:load fixed={true} />
		<slot />
	</body>
</html>

<style is:global>
	/* Broadstreet Aesthetic Adjustments */
	.dark .site-logo {
		filter: invert(1) brightness(1.5);
	}
	.dark .site-emblem {
		filter: invert(1) brightness(1.5);
	}
    
    /* Ensure serif fonts are applied to all broadsheet text */
    .nyt-serif {
        font-family: var(--font-serif);
    }
    
    .nyt-sans {
        font-family: var(--font-sans);
    }

    /* Selection Color */
    ::selection {
        background-color: #326891;
        color: white;
    }
</style>
