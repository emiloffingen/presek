---
// PRESEK.MK public layout.

import '../styles/global.css';
import LayoutBodyChrome from '../components/layout/LayoutBodyChrome.astro';
import LayoutHead from '../components/layout/LayoutHead.astro';

// Import skip link component
import SkipLink from '../components/layout/SkipLink.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import {
  buildOrganizationSchema,
  buildPageTitle,
  gtagIdForLang,
  resolveLayoutUrls,
  siteDisplayName,
} from '../lib/layoutMeta';
import { proxyBaseUrl } from '../lib/apiBase';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
	schema?: object;
	robots?: string;
}

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = getLangFromUrl(effectiveUrl);
import '../styles/fonts-mk.css';
import '../styles/theme-broadsheet.css';
const t = useTranslations(lang);

const {
	title,
	description = t('layout.default_description'),
	image = '/img/presek_emblem.png',
	canonical,
	type = 'website',
	schema,
	robots,
} = Astro.props;

const defaultDescription = t('layout.default_description');
const siteName = siteDisplayName(lang);
const pageTitle = buildPageTitle(title, lang);
const { canonicalUrl, imageUrl } = resolveLayoutUrls(
	requestUrl.pathname,
	lang,
	image,
	canonical,
);
const proxyBase = proxyBaseUrl();
const cspNonce = Astro.locals.cspNonce;
const gtagId = gtagIdForLang(lang);
const organizationSchema = buildOrganizationSchema(lang);
const metaDescription = description || defaultDescription;
const normalizedPath = requestUrl.pathname.replace(/\/$/, '') || '/';
const pageKind = normalizedPath === '/' || normalizedPath === '/mk' ? 'home' : 'default';

// Opt-in style direction for A/B testing: ?style=warm applies the warm palette
// (theme-warm.css) and persists via cookie; ?style=default clears it.
const styleParam = Astro.url.searchParams.get('style');
if (styleParam === 'warm' || styleParam === 'default') {
	Astro.cookies.set('presek_style', styleParam, {
		path: '/',
		maxAge: 60 * 60 * 24 * 30,
		sameSite: 'lax',
	});
}
const stylePref = styleParam || Astro.cookies.get('presek_style')?.value || '';
const isWarmTheme = stylePref === 'warm';
---

<!doctype html>
<html lang="mk" data-proxy-base={proxyBase} data-page={pageKind}>
	<head>
		<LayoutHead
			lang={lang}
			siteName={siteName}
			pageTitle={pageTitle}
			description={metaDescription}
			canonicalUrl={canonicalUrl}
			imageUrl={imageUrl}
			type={type}
			robots={robots}
			image={image}
			schema={schema}
			organizationSchema={organizationSchema}
			cspNonce={cspNonce}
			gtagId={gtagId}
		/>
	</head>
	<body
		id="top"
		class:list={[
			'antialiased min-h-screen bg-background text-foreground transition-colors duration-300 overflow-x-hidden w-full',
			{ 'script-cyrillic': true, 'theme-warm': isWarmTheme },
		]}
	>
		<SkipLink targetId="main-content" />
		<LayoutBodyChrome lang={lang} cspNonce={cspNonce}>
			<main id="main-content" class="focus-ring" tabindex="-1">
				<slot />
			</main>
		</LayoutBodyChrome>
	</body>
</html>
