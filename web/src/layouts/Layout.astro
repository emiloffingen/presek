---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Presek e modern agregator na vesti.",
} = Astro.props;

const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="sr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=4" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ff6600" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
    body {
        font-family: Verdana, Geneva, sans-serif;
        font-size: 10pt;
        color: #828282;
        background-color: white;
        margin: 0;
        padding: 0;
    }
    td { font-family: Verdana, Geneva, sans-serif; font-size: 10pt; }
    
    a:link { color: #000000; text-decoration: none; }
    a:visited { color: #828282; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .pagetop { font-family: Verdana, Geneva, sans-serif; font-size: 10pt; color: #222222; }
    .pagetop a:link, .pagetop a:visited { color: #000000; }
    
    .hnname { font-weight: bold; margin-right: 5px; }
    .hnname a:link, .hnname a:visited { color: #000000; text-decoration: none; }

    .rank { color: #828282; }
    .titleline { font-size: 10pt; }
    .titleline a:link { color: #000000; }
    .titleline a:visited { color: #828282; }
    
    .sitebit { font-size: 8pt; color: #828282; }
    .comhead { font-size: 8pt; color: #828282; }
    .comhead a:link, .comhead a:visited { color: #828282; }
    .comhead a:hover { text-decoration: underline; }

    .subtext { font-size: 7pt; color: #828282; }
    .subtext a:link, .subtext a:visited { color: #828282; }
    .subtext a:hover { text-decoration: underline; }

    .votearrow {
        width: 10px;
        height: 10px;
        border: 0px;
        margin: 3px 2px 6px;
        background: url('data:image/svg+xml;utf8,<svg width="10" height="10" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><polygon points="5,0 10,10 0,10" fill="%23828282" /></svg>') no-repeat;
    }

    .yclinks { font-size: 8pt; color: #828282; }
    .yclinks a:link, .yclinks a:visited { color: #828282; }
    .yclinks a:hover { text-decoration: underline; }

    input { font-family: monospace; font-size: 10pt; }
</style>
