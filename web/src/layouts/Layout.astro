---
// 🌐 PRESEK - Consolidated Multi-language Site (Serbian & Macedonian)
// This layout handles both presek.live (sr) and presek.mk (mk) via Astro i18n.

import '../styles/global.css';
import '../lib/transliterationInit.js';
import LayoutBodyChrome from '../components/layout/LayoutBodyChrome.astro';
import LayoutHead from '../components/layout/LayoutHead.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import {
  buildOrganizationSchema,
  buildPageTitle,
  gtagIdForLang,
  resolveLayoutUrls,
  siteDisplayName,
} from '../lib/layoutMeta';
import { proxyBaseUrl } from '../lib/apiBase';
import { shouldLoadTinyAdzScript, tinyAdzSiteId } from '../lib/tinyadz';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
	schema?: object;
	robots?: string;
}

const requestUrl = Astro.request ? new URL(Astro.request.url) : Astro.url;
const hostHeader = Astro.request?.headers.get('host') || requestUrl.hostname;
const effectiveUrl = new URL(requestUrl);
effectiveUrl.hostname = hostHeader;
const lang = getLangFromUrl(effectiveUrl);
import '../styles/fonts-sr.css';
import '../styles/fonts-mk.css';
const t = useTranslations(lang);

const {
	title,
	description = t('layout.default_description'),
	image = '/img/presek_emblem.png',
	canonical,
	type = 'website',
	schema,
	robots,
} = Astro.props;

const defaultDescription = t('layout.default_description');
const siteName = siteDisplayName(lang);
const pageTitle = buildPageTitle(title, lang);
const { canonicalUrl, imageUrl, srHref, mkHref } = resolveLayoutUrls(
	requestUrl.pathname,
	lang,
	image,
	canonical,
);
const loadTinyAdz = shouldLoadTinyAdzScript(lang, hostHeader);
const tinyAdzSite = loadTinyAdz ? tinyAdzSiteId(lang, hostHeader) : '';
const proxyBase = proxyBaseUrl();
const cspNonce = Astro.locals.cspNonce;
const gtagId = gtagIdForLang(lang);
const organizationSchema = buildOrganizationSchema(lang);
const metaDescription = description || defaultDescription;
const normalizedPath = requestUrl.pathname.replace(/\/$/, '') || '/';
const pageKind = normalizedPath === '/' || normalizedPath === '/mk' ? 'home' : 'default';
---

<!doctype html>
<html lang={lang === 'sr' ? 'sr-Latn' : 'mk'} data-proxy-base={proxyBase} data-page={pageKind}>
	<head>
		<LayoutHead
			lang={lang}
			siteName={siteName}
			pageTitle={pageTitle}
			description={metaDescription}
			canonicalUrl={canonicalUrl}
			imageUrl={imageUrl}
			srHref={srHref}
			mkHref={mkHref}
			type={type}
			robots={robots}
			image={image}
			schema={schema}
			organizationSchema={organizationSchema}
			cspNonce={cspNonce}
			gtagId={gtagId}
		/>
	</head>
	<body
		id="top"
		class:list={[
			'antialiased min-h-screen bg-background text-foreground transition-colors duration-300 overflow-x-hidden w-full',
			{ 'script-latin': lang === 'sr', 'script-cyrillic': lang === 'mk' },
		]}
	>
		<LayoutBodyChrome lang={lang} loadTinyAdz={loadTinyAdz} tinyAdzSite={tinyAdzSite}>
			<slot />
		</LayoutBodyChrome>
	</body>
</html>
