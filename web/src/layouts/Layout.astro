---
import '../styles/global.css';
import ThemeIsland from '../components/ThemeIsland';
import ConsentBanner from '../components/ConsentBanner';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
	schema?: object;
	robots?: string;
}

const {
	title,
	description = "Пресек е модерен македонски агрегатор на вести кој користи напредна јазична обработка (NLP) за да ги групира и сумира најважните настани од сите медиуми.",
	image = "/static/img/presek_emblem.png",
	canonical,
	type = "website",
	schema,
	robots,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://presek.live").replace(/\/+$/, "");
const pageTitle = title.includes("Пресек") ? title : `${title} | Пресек`;
const adSenseClient = String(import.meta.env.PUBLIC_ADSENSE_CLIENT || '').trim();
const shouldLoadAds = /^ca-pub-\d{10,}$/.test(adSenseClient) && adSenseClient !== 'ca-pub-0000000000000000';

// Canonical logic: 
// 1. If explicit canonical is passed, use it.
// 2. Otherwise, use the current pathname without query parameters (important for SEO/indexing).
// 3. Ensure home page is just the base domain.
const cleanPath = Astro.url?.pathname === "/" ? "" : Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = canonical || `${siteUrl}${cleanPath}`;

const imageUrl = /^https?:\/\//i.test(image) ? image : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;
---

<!doctype html>
<html lang="mk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Noto+Serif:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap"
		/>
		<link rel="icon" type="image/svg+xml" href="/img/presek_emblem.svg?v=4" />
		<link rel="apple-touch-icon" href="/img/presek_emblem.png?v=4" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#fafafb" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1a1715" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Пресек" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="Пресек" />
		<meta property="og:locale" content="mk_MK" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		
		{shouldLoadAds && (
			<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adSenseClient}`} crossorigin="anonymous"></script>
		)}
		
		<title>{pageTitle}</title>

		{schema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		)}

		<script is:inline>
			// Immediate theme sync to prevent flicker. We persist the
			// resolved theme so subsequent navigations stay stable even if
			// the OS preference changes mid-session.
			const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
			const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="antialiased min-h-screen bg-background text-foreground transition-colors duration-300">
		<slot />
		<ConsentBanner client:load />
	</body>
</html>

<style is:global>
	:root {
		--layout-cache-bust-20260409: 1;
	}

	/* Broadstreet Aesthetic Adjustments */
	.dark .site-logo {
		filter: invert(1) brightness(1.5);
	}
	.dark .site-emblem {
		filter: invert(1) brightness(1.5);
	}
    
    /* Ensure serif fonts are applied to all broadsheet text */
    .nyt-serif {
        font-family: var(--font-serif);
    }
    
    .nyt-sans {
        font-family: var(--font-sans);
    }

    /* Selection Color */
    ::selection {
        background-color: #326891;
        color: white;
    }
</style>
