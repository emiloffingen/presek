---
/* Hacker News-style cluster detail page */
import HNLayout from '../../../layouts/HNLayout.astro';
import { apiBaseUrl } from '@/lib/apiBase';
import type { NewsCluster } from '@/types';

const { slug } = Astro.params;
const API_URL = apiBaseUrl();

let cluster: NewsCluster | null = null;
let error = null;

async function fetchJson(url: string) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Request failed: ${response.status} ${url}`);
    }
    return response.json();
}

try {
    const result = await fetchJson(`${API_URL}/cluster/${slug}?lang=mk`);
    cluster = result;
} catch (err) {
    console.error('Error fetching cluster:', err);
    error = 'Error loading story';
}

const article = cluster?.articles?.[0] || {};
const otherArticles = cluster?.articles?.slice(1) || [];
const sourceCount = cluster?.articles?.length || 1;

function formatTime(dateStr: string) {
    try {
        const date = new Date(dateStr);
        return date.toLocaleString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Skopje'
        });
    } catch {
        return '';
    }
}

function getCommentCount(): number {
    return Math.floor(sourceCount * 3.5);
}

const commentCount = getCommentCount();
const timeStr = formatTime(article.published_at);
const displayTitle = article.title || 'No title';
const displaySummary = article.summary || article.description || '';
---

<HNLayout
    title={`${displayTitle} | Пресек.мк`}
    description={displaySummary}
>
    <!-- Top bar with navigation -->
    <div class="hn-topbar">
        <a href="/hn/">&lt; back</a> |
        <a href="/hn/">home</a> |
        <a href="/hn/new">new</a> |
        <a href="/hn/popular">popular</a>
    </div>

    {error && (
        <div style="color: var(--hn-orange); text-align: center; padding: 40px;">
            <h2>Error</h2>
            <p>{error}</p>
            <p><a href="/hn/">Back to home</a></p>
        </div>
    )}

    {cluster && (
        <>
            <!-- Story header -->
            <div style="padding: 10px 0;">
                <h1 class="hn-title" style="font-size: 24px; margin-bottom: 8px;">
                    {displayTitle}
                </h1>
                <div class="hn-meta" style="font-size: 13px;">
                    <span class="hn-score">{sourceCount * 10} points</span> by 
                    <a href="#">ПРЕСЕК_БОТ</a> 
                    <span>{timeStr}</span> | 
                    <a href="#">hide</a> | 
                    <a href="#">{commentCount} comments</a>
                </div>
            </div>

            <!-- Story content -->
            {displaySummary && (
                <div style="margin: 20px 0 30px 30px; line-height: 1.6;">
                    {displaySummary}
                </div>
            )}

            <!-- Sources list -->
            <div style="margin: 20px 0 30px 30px;">
                <p style="margin-bottom: 8px; font-weight: bold;">Sources ({sourceCount}):</p>
                <ul style="list-style: disc; margin-left: 20px; padding-left: 10px;">
                    {cluster.articles?.map((art, idx) => (
                        <li>
                            <a href={art.url || '#'}>{art.source} - {art.title}</a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Comments section -->
            <div style="margin-top: 30px;">
                <h3 style="font-size: 16px; margin-bottom: 10px;">
                    {commentCount} Comments
                </h3>
                
                <!-- Comment form -->
                <div style="margin-bottom: 20px;">
                    <form style="margin-bottom: 10px;">
                        <textarea 
                            style="width: 100%; max-width: 600px; min-height: 80px; padding: 8px; border: 1px solid var(--hn-border); font-family: monospace; font-size: 13px;"
                            placeholder="Add a comment..."
                        ></textarea>
                        <div style="margin-top: 5px;">
                            <a href="#" style="margin-right: 10px;">reply</a>
                            <a href="#" style="color: var(--hn-secondary);">formatting help</a>
                        </div>
                    </form>
                </div>

                <!-- Sample comments -->
                <div style="border-top: 1px solid var(--hn-border); padding-top: 10px;">
                    <div style="margin-bottom: 20px;">
                        <div class="hn-meta" style="margin-bottom: 4px;">
                            <a href="#">user123</a> 
                            <span>2 hours ago</span> | 
                            <a href="#">reply</a> | 
                            <a href="#">thread</a>
                        </div>
                        <p style="margin-left: 20px; line-height: 1.5;">
                            Ова е многу интересент развој. Благодарам што го споделивте ова на Пресек.мк!
                        </p>
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <div class="hn-meta" style="margin-bottom: 4px;">
                            <a href="#">newsreader</a> 
                            <span>1 hour ago</span> | 
                            <a href="#">reply</a> | 
                            <a href="#">thread</a>
                        </div>
                        <p style="margin-left: 20px; line-height: 1.5;">
                            I agree. It's important to stay informed about these issues.
                        </p>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <div class="hn-meta" style="margin-bottom: 4px;">
                            <a href="#">analyst</a> 
                            <span>30 minutes ago</span> | 
                            <a href="#">reply</a> | 
                            <a href="#">thread</a>
                        </div>
                        <p style="margin-left: 20px; line-height: 1.5;">
                            More context on this story can be found here: <a href="#">https://example.com</a>
                        </p>
                    </div>
                </div>
            </div>
        </>
    )}
</HNLayout>
