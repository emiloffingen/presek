---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import TopicFollowSuggestionsIsland from '../../components/TopicFollowSuggestionsIsland.tsx';

import { buildTopicConnections } from '../../lib/topicDiscovery.js';
import { apiBaseUrl } from '../../lib/apiBase';
import { cleanAndDecode, getDisplaySummary } from '../../utils/textUtils';
import { ArrowRight, Clock3, Newspaper, Sparkles } from 'lucide-react';

const rawTopicParam = Astro.params.topic || '';
const topic = (() => {
	try {
		return decodeURIComponent(rawTopicParam);
	} catch {
		return rawTopicParam;
	}
})()
	.replace(/\s+/g, ' ')
	.trim();

const API_URL = apiBaseUrl();
const topicQueryMap: Record<string, { primary: 'topic' | 'category'; secondary?: 'topic' | 'category' }> = {
	'Politika': { primary: 'topic', secondary: 'category' },
	'Ekonomija': { primary: 'topic', secondary: 'category' },
	'Svet': { primary: 'category', secondary: 'topic' },
	'Sport': { primary: 'topic', secondary: 'category' },
	'Tehnologija': { primary: 'topic', secondary: 'category' },
	'Zabava': { primary: 'topic', secondary: 'category' },
};

let clusters: any[] = [];
let detailMap = new Map<string, any>();
let error: string | null = null;

async function fetchJson(url: string) {
	const response = await fetch(url);
	if (!response.ok) {
		const err: any = new Error(`Request failed: ${response.status} ${url}`);
		err.status = response.status;
		throw err;
	}
	return response.json();
}

function cleanText(text?: string) {
	return cleanAndDecode(text);
}

function parseSynthesis(text?: string) {
	if (!text) return [];
	return String(cleanAndDecode(text))
		.replace(/\r/g, '')
		.split('\n')
		.map((line) => line.trim().replace(/^[-•]\s+/, ''))
		.filter(Boolean)
		.filter((line) => line.toLowerCase() !== 'clanci:')
		.map((line) => line.replace(/^\[[^\]]+\]:\s*/, '').trim())
		.filter(Boolean);
}

function normalizePerspectives(items: any[]) {
	if (!Array.isArray(items)) return [];
	return items
		.map((item) => {
			if (!item || typeof item !== 'object') return null;
			const angle = String(item.angle ?? item.label ?? 'перспектива').trim();
			const content = String(item.content ?? item.text ?? item.description ?? '').trim();
			if (!content) return null;
			return { angle: angle || 'перспектива', content };
		})
		.filter(Boolean);
}

function countValues(values: string[]) {
	const counts = new Map<string, number>();
	for (const value of values) {
		const clean = String(value || '').trim();
		if (!clean) continue;
		counts.set(clean, (counts.get(clean) || 0) + 1);
	}
	return Array.from(counts.entries()).sort((a, b) => b[1] - a[1]);
}

function buildNewsUrl(params: Record<string, string>) {
	const url = new URL(`${API_URL}/news`);
	url.searchParams.set('page_size', '24');
	url.searchParams.set('lang', 'mk');  // Ensure Macedonian language filtering
	for (const [key, value] of Object.entries(params)) {
		url.searchParams.set(key, value);
	}
	return url.toString();
}

try {
	const queryPlan = topicQueryMap[topic] || { primary: 'topic', secondary: 'category' };
	const primaryData = await fetchJson(buildNewsUrl({ [queryPlan.primary]: topic }));
	clusters = Array.isArray(primaryData?.clusters) ? primaryData.clusters : [];

	if (clusters.length === 0 && queryPlan.secondary && queryPlan.secondary !== queryPlan.primary) {
		const fallbackData = await fetchJson(buildNewsUrl({ [queryPlan.secondary]: topic }));
		clusters = Array.isArray(fallbackData?.clusters) ? fallbackData.clusters : [];
	}

	if (clusters.length > 0) {
		const ids = clusters.slice(0, 6).map((cluster: any) => cluster.cluster_id);
		const detailResults = await Promise.allSettled(
			ids.map((id: string) => fetchJson(`${API_URL}/cluster/${id}?lang=mk`))
		);

		detailResults.forEach((result, index) => {
			if (result.status === 'fulfilled' && result.value?.data) {
				detailMap.set(ids[index], result.value.data);
			}
		});
	}
} catch (e: any) {
	console.error(e);
	error = 'Темата моментално не е достапна.';
	Astro.response.status = e.status || 500;
}

const leadCluster = clusters[0] ?? null;
const supportingClusters = clusters.slice(1, 4);
const feedClusters = clusters.slice(4, 16);
const leadDetail = leadCluster ? detailMap.get(leadCluster.cluster_id) || null : null;
const featuredFeedClusters = feedClusters.slice(0, 4);
const compactFeedClusters = feedClusters.slice(4);

const totalReports = clusters.reduce((sum: number, cluster: any) => sum + (cluster?.articles?.length || 0), 0);
const uniqueSources = new Set(
	clusters.flatMap((cluster: any) => (cluster?.articles || []).map((article: any) => article?.source).filter(Boolean))
);
const breakingCount = clusters.filter((cluster: any) => cluster?.is_breaking).length;
const sourceRows = countValues(
	clusters.flatMap((cluster: any) => (cluster?.articles || []).map((article: any) => article?.source))
).slice(0, 6);

const tagRows = countValues(
	Array.from(detailMap.values()).flatMap((detail: any) => Array.isArray(detail?.tags) ? detail.tags : [])
)
	.filter(([name]) => name.toLowerCase() !== topic.toLowerCase())
	.slice(0, 8);

const topicConnections = buildTopicConnections(topic, clusters.slice(0, 10), Array.from(detailMap.values()), 5);
const topicFollowSuggestions = topicConnections.slice(0, 2).map((item: any) => ({
	topic: item.topic,
	reason: item.relationshipNote,
}));
const sourceFollowSuggestions = sourceRows.slice(0, 2).map(([name, count]) => ({
	source: name,
	reason: `${count} појавувања во активни кластери за оваа тема.`,
}));

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://presek.live').href.replace(/\/+$/, "");

const leadSummary =
	getDisplaySummary(leadCluster?.articles?.[0] || {}) ||
	'Најсилните кластери во оваа тема се подредени според тежина, доверба и развој.';

const keyAngles = normalizePerspectives(leadDetail?.perspectives || []).slice(0, 3);
const synthesisLines = parseSynthesis(leadDetail?.synthesis || '').slice(0, 3);
const relatedClusters = Array.isArray(leadDetail?.related) ? leadDetail.related.slice(0, 4) : [];

function topicIntro() {
	if (!clusters.length) return '';
	if (breakingCount >= 2) {
		return `Темата ${topic} денес се развива брзо, со ${clusters.length} активни кластери и ${uniqueSources.size} извори што додаваат нови детали.`;
	}
	if (clusters.length >= 6) {
		return `Темата ${topic} е широко присутна низ денешниот циклус, со ${clusters.length} кластери и ${totalReports} извештаи што се надоврзуваат еден на друг.`;
	}
	return `Темата ${topic} останува релевантна денес, со ${clusters.length} кластери и повеќе редакции што ја следат од различни агли.`;
}
---

<Layout 
	title={topic ? `${topic} | Тема` : 'Тема'} 
	description={`сè што е активно за темата ${topic} — кластери, извори, перспективи и развој.`}
	canonical={canonicalUrl}
>
	<NYTHeader topic={topic} />

	<main class="site-layout py-[var(--page-py)]">
		{(error || !clusters.length) && (
			<Breadcrumbs items={[{ label: "Теми", href: "/" }, { label: topic || "Тема" }]} />
		)}

		{error && (
			<div class="topic-empty">
				<div class="topic-empty-inner">
					<span class="topic-kicker">Тема</span>
					<h1 class="topic-empty-title">{topic || 'Тема'}</h1>
					<p>{error}</p>
					<div class="topic-empty-actions">
						<a href="/" class="topic-empty-link">Назад на почеток</a>
						<a href="/archive" class="topic-empty-link topic-empty-link-secondary">Отвори архива</a>
					</div>
				</div>
			</div>
		)}

		{!error && !clusters.length && (
			<div class="topic-empty">
				<div class="topic-empty-inner">
					<span class="topic-kicker">Тема</span>
					<h1 class="topic-empty-title">{topic}</h1>
					<p>Нема доволно активни кластери за оваа тема во овој момент.</p>
					<div class="topic-empty-actions">
						<a href="/" class="topic-empty-link">Почетна</a>
						<a href="/archive" class="topic-empty-link topic-empty-link-secondary">Побарај во архива</a>
					</div>
				</div>
			</div>
		)}

		{!error && clusters.length > 0 && (
			<>
				<header class="topic-hero">
					<div class="topic-hero-copy">
						<Breadcrumbs items={[{ label: topic }]} />
						<span class="topic-kicker">Тема</span>
						<h1 class="topic-headline">{topic}</h1>
						<div class="topic-actions">
							<PreferenceToggle client:visible kind="topic" value={topic} />
						</div>
						<p class="topic-intro">{topicIntro()}</p>
						<p class="topic-summary">{leadSummary}</p>

						<div class="topic-stats">
							<div>
								<span class="micro-label">кластери</span>
								<strong>{clusters.length}</strong>
							</div>
							<div>
								<span class="micro-label">извори</span>
								<strong>{uniqueSources.size}</strong>
							</div>
							<div>
								<span class="micro-label">Извештаи</span>
								<strong>{totalReports}</strong>
							</div>
							<div>
								<span class="micro-label">Во развој</span>
								<strong>{breakingCount}</strong>
							</div>
						</div>
					</div>

					<div class="topic-hero-side">
						<div class="topic-note-card">
							<p class="topic-note-label">Што го движи овој простор</p>
							<ul class="topic-note-list">
								{(synthesisLines.length > 0 ? synthesisLines : [leadSummary]).map((line: string) => (
									<li>{line}</li>
								))}
							</ul>
						</div>
						<TopicFollowSuggestionsIsland
							client:visible
							currentTopic={topic}
							relatedTopics={topicFollowSuggestions}
							strongSources={sourceFollowSuggestions}
						/>
					</div>
				</header>

				<div class="topic-layout">
					<div class="topic-main">
						{leadCluster && (
							<section class="topic-lead">
								<div class="section-heading-row">
									<h2 class="section-title">Водечка приказна</h2>
									<p class="section-note">кластер кој најмногу ја носи темата напред во овој момент.</p>
								</div>
								<NewsCard cluster={leadCluster} isLead={true} />
							</section>
						)}

						{keyAngles.length > 0 && (
							<section class="topic-angles">
								<div class="section-heading-row">
									<h2 class="section-title">Каде се разликува покривањето</h2>
									<p class="section-note">Главните агли што излегуваат од водечкиот кластер во темата.</p>
								</div>
								<div class="topic-angle-grid">
									{keyAngles.map((item: any) => (
										<div class="topic-angle-card">
											<h3>{item.angle}</h3>
											<p>{item.content}</p>
										</div>
									))}
								</div>
							</section>
						)}

						{supportingClusters.length > 0 && (
							<section class="topic-supporting">
								<div class="section-heading-row">
									<h2 class="section-title">Што се развива понатаму</h2>
									<p class="section-note">Придружни и следни кластери што ја прошируваат темата.</p>
								</div>
								<div class="topic-supporting-grid">
									{supportingClusters.map((cluster: any, index: number) => (
										<NewsCard cluster={cluster} variant={index === 0 ? 'featured' : 'compact'} />
									))}
								</div>
							</section>
						)}

						{feedClusters.length > 0 && (
							<section class="topic-feed">
								<div class="section-heading-row">
									<h2 class="section-title">Повеќе од оваа тема</h2>
									<p class="section-note">Останати активни кластери што вреди да останат во видното поле.</p>
								</div>
								{featuredFeedClusters.length > 0 && (
									<div class="topic-feed-grid topic-feed-grid-featured">
										{featuredFeedClusters.map((cluster: any) => (
											<NewsCard cluster={cluster} variant="featured" />
										))}
									</div>
								)}
								{compactFeedClusters.length > 0 && (
									<div class="topic-feed-grid topic-feed-grid-compact">
										{compactFeedClusters.map((cluster: any) => (
											<NewsCard cluster={cluster} variant="compact" />
										))}
									</div>
								)}
							</section>
						)}
					</div>

					<aside class="topic-rail">
						{tagRows.length > 0 && (
							<section class="rail-card">
								<h3 class="rail-card-title">Имиња и агли</h3>
								<div class="topic-chip-list">
									{tagRows.map(([name, count]) => (
										<a href={`/?q=${encodeURIComponent(name)}`} class="topic-chip">
											{name} <strong>{count}</strong>
										</a>
									))}
								</div>
							</section>
						)}

						{topicConnections.length > 0 && (
							<section class="rail-card">
								<h3 class="rail-card-title">Каде да одите понатаму</h3>
								<div class="topic-connection-list">
									{topicConnections.map((item: any) => (
										<a href={`/tema/${encodeURIComponent(item.topic)}`} class="topic-connection-card">
											<p class="topic-connection-kicker">{item.relationshipLabel}</p>
											<h4>{item.topic}</h4>
											<p class="topic-connection-copy">{item.relationshipNote}</p>
											{item.sampleTags?.length > 0 && (
												<p class="topic-connection-meta">{item.sampleTags.join(' · ')}</p>
											)}
										</a>
									))}
								</div>
							</section>
						)}

						{sourceRows.length > 0 && (
							<section class="rail-card">
								<h3 class="rail-card-title">извори што ја водат темата</h3>
								<div class="topic-source-list">
									{sourceRows.map(([name, count], index) => (
										<div class="topic-source-row">
											<span class="topic-source-rank">{String(index + 1).padStart(2, '0')}</span>
											<div>
												<p>{name}</p>
												<span>{count} појавувања во кластери</span>
											</div>
										</div>
									))}
								</div>
							</section>
						)}

						{relatedClusters.length > 0 && (
							<section class="rail-card">
								<h3 class="rail-card-title">Што да читате понатаму</h3>
								<div class="topic-related-list">
									{relatedClusters.map((item: any) => (
										<a href={`/cluster/${item.cluster_id}`} class="topic-related-link">
											{item.relationship_label && <span class="topic-related-kicker">{item.relationship_label}</span>}
											<strong>{item.title}</strong>
											{item.relationship_note && <p>{item.relationship_note}</p>}
											<span class="topic-related-cta">Отвори кластер <ArrowRight size={12} /></span>
										</a>
									))}
								</div>
							</section>
						)}

					</aside>
				</div>
			</>
		)}
	</main>

	<Footer />
</Layout>

<style>
... [KEEP ORIGINAL STYLES]
</style>
