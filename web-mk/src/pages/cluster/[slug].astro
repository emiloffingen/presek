---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareIsland from '../../components/ShareIsland.tsx';
import ReaderTracker from '../../components/ReaderTracker.tsx';
import PreferenceToggle from '../../components/PreferenceToggle.tsx';
import { MediaPulseRadar } from '../../components/MediaPulseRadar.tsx';
import ResearchIsland from '../../components/ResearchIsland.tsx';
import StorylineHistoryIsland from '../../components/StorylineHistoryIsland.tsx';
import ClusterHistoryIsland from '../../components/ClusterHistoryIsland.tsx';
import { SourceSpectrum } from '../../components/SourceSpectrum.tsx';
import SourceComparisonIsland from '../../components/SourceComparisonIsland.tsx';
import ClusterFollowSuggestionsIsland from '../../components/ClusterFollowSuggestionsIsland.tsx';
import NewsletterIsland from '../../components/NewsletterIsland.tsx';
import { apiBaseUrl } from '../../lib/apiBase';
import { cleanAndDecode, isMostlyCyrillic, getEditionStr, parseFootnotes, deShout, slugify } from '../../utils/textUtils';

function getRelativeTimeStr(dateStr: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));

        if (diffMins < 1) return 'JUST NOW';
        if (diffMins < 60) return `PRE ${diffMins} MIN`;
        
        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) return `PRE ${diffHours} ${diffHours === 1 ? 'ČAS' : 'ČASA'}`;

        const diffDays = Math.floor(diffHours / 24);
        return `PRE ${diffDays} ${diffDays === 1 ? 'DAN' : 'DANA'}`;
    } catch (e) {
        return '';
    }
}

import { sanitizeHtml } from '../../lib/sanitize';
import { Newspaper, Clock, Link2, Zap, Sparkles, ShieldCheck, TriangleAlert, BarChart3, Radio, Search } from 'lucide-react';
import EntityContextCard from '../../components/EntityContextCard.tsx';
import ClusterHeader from '../../components/Cluster/ClusterHeader.astro';
import HeroVisual from '../../components/Cluster/HeroVisual.astro';

import CitationSources from '../../components/CitationSources.astro';
import CredibilityAnalysis from '../../components/Cluster/CredibilityAnalysis.astro';
import ArticleItem from '../../components/Cluster/ArticleItem.astro';
import EditorialNarrative from '../../components/Cluster/EditorialNarrative.astro';
import type { Article, ClusterDetail } from '../../types';

const { slug } = Astro.params;
const API_URL = apiBaseUrl();

// Extract ID from slug (handles both legacy 8-char and new 12-char dashed IDs)
const idMatch = slug?.match(/^([0-9a-f]{8}-[0-9a-f]{3,4}|[0-9a-f]{8,12})/);
const id = idMatch ? idMatch[0] : slug?.split('-')[0];

let cluster: ClusterDetail | null = null;
let error = null;

try {
    const res = await fetch(`${API_URL}/cluster/${id}`);
    if (!res.ok) {
        if (res.status === 404) {
            error = 'Klaster nije pronađen.';
            Astro.response.status = 404;
        } else {
            error = 'Greška pri učitavanju podataka.';
            Astro.response.status = 500;
        }
    } else {
      const payload = await res.json();
      cluster = payload.data;
    }
    } catch (e) {
    Astro.response.status = 500;
    error = 'Neuspešno povezivanje sa serverom.';
}

const mainArticle = cluster?.articles?.[0];
const displayHeadline = cluster?.synthetic_headline || (mainArticle ? cleanAndDecode(mainArticle.title) : 'Detali za vesta');

// --- SEO Slug Enforcement ---
// If the current slug is just the ID or doesn't match the headline slug,
// we perform a 301 redirect to the "Correct" SEO URL.
const currentHeadlineSlug = slugify(displayHeadline);
const canonicalSlug = `${id}-${currentHeadlineSlug}`;

if (slug !== canonicalSlug && !error && cluster) {
    return Astro.redirect(`/cluster/${canonicalSlug}`, 301);
}

const headlineIsCyrillic = isMostlyCyrillic(displayHeadline);

const allSourcesNames: string[] = Array.from(new Set((cluster?.articles || []).map((a: Article) => a.source)));
const sourcePreview = allSourcesNames.slice(0, 5);
const hasCitationSources = false; // Feature disabled as per user request

const synthesisUpdatedAt = cluster?.synthesis_updated_at;
const synthesisFreshness = cluster?.synthesis_freshness || { is_stale: false };

const perspectives = cluster?.perspectives || [];
const verificationReport = cluster?.verification_report || null;
const generatedArticle = cluster?.generated_article || null;

type SynthesisItem = { source: string | null; content: string };

const synthesisItems: SynthesisItem[] = (cluster?.ai_summary_bullets?.length ? cluster.ai_summary_bullets : (cluster?.synthesis || '').split('\n'))
    .filter((line: string) => line.trim().length > 10)
    .map((line: string) => {
        const match = line.match(/^\[(.*?)\]\s*(.*)/);
        if (match) {
            return { source: match[1], content: cleanAndDecode(match[2]) };
        }
        return { source: null, content: cleanAndDecode(line) };
    });

const articleRows = (cluster?.articles || []).map((a: Article, idx: number, arr: Article[]) => {
    const d = new Date(a.created_at);
    const signal = a.source_signal || {};
    
    // 1. Dynamic Journalistic Role (Timeline)
    let relLabel = 'POVRZANA prica';
    let relTone = 'neutral';
    
    if (idx === arr.length - 1) {
        relLabel = 'INICIJALNA OBJAVA';
        relTone = 'origin';
    } else if (idx === 0 && !synthesisFreshness.is_stale) {
        relLabel = 'POSLEDEN razvoj';
        relTone = 'latest';
    } else if (signal.role_label) {
        relLabel = signal.role_label.toUpperCase();
        relTone = signal.role_tone || 'deep';
    } else if ((a.credibility || 0) > 1.2) {
        relLabel = 'PROSIREN izvestaj';
        relTone = 'deep';
    }

    // 2. Individual Quality Signals
    const isObjective = (a.credibility || 0) >= 1.4 || signal.trust_label === 'Visoko poverenje';
    const isSensational = (a.credibility || 0) < 0.8 && !isObjective;

    return {
        ...a,
        title: deShout(cleanAndDecode(a.title)),
        description: cleanAndDecode(a.description || a.summary || ''),
        exactTime: d.toLocaleTimeString('mk-MK', { hour: '2-digit', minute: '2-digit' }),
        relativeTime: getRelativeTimeStr(a.created_at),
        relationship: { tone: relTone, label: relLabel },
        quality: { isObjective, isSensational }
    };
});

const relatedClusters = cluster?.related || [];
const filteredRelated = relatedClusters.filter((c: { cluster_id: string }) => c.cluster_id !== id).slice(0, 5);

const adjacentTopic = cluster?.topics?.find((t: string) => t !== 'Makedonija') || cluster?.topics?.[0];

const canonicalUrl = `https://presek.live/cluster/${id}`;
const shareDescription = synthesisItems[0]?.content || mainArticle?.description || '';

function getLeadVisual(c: ClusterDetail | null) {
    if (!c) return null;
    const res = { src: '/img/placeholder.svg', rawUrl: '', isWeak: true };
    const main = c.articles?.[0];
    if (main?.image_url && main.image_url.startsWith('http')) {
        res.src = `/proxy?url=${encodeURIComponent(main.image_url)}&w=1200`;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    } else if (main?.image_url && main.image_url.startsWith('/static/generated/')) {
        res.src = main.image_url;
        res.rawUrl = main.image_url;
        res.isWeak = false;
    }
    return res;
}
const leadVisual = getLeadVisual(cluster);
const imageUrl = leadVisual && !leadVisual.isWeak ? leadVisual.src : '/img/presek_emblem.png';

const headerBriefItems = synthesisItems.map((item: SynthesisItem) => item.content).filter((line: string) => line.trim().length > 4).slice(0, 4);
const hasGeneratedNarrative = Boolean(generatedArticle && generatedArticle.trim());
const hasSublimat = synthesisItems.length > 0;
const hasFactcheck = Boolean(verificationReport && (verificationReport.agreements?.length > 0 || verificationReport.conflicts?.length > 0));
const hasStrongLeadNarrative = hasGeneratedNarrative && (cluster?.articles?.length || 0) >= 3;
const primaryNarrativeLabel = 'SINTEZA';
const primaryNarrativeEyebrow = 'REDAKCISKI PREGLED';

const sentimentData = cluster?.sentiment ? {
    sentiment: cluster.sentiment.sentiment || { score: 0, tone: 'neutralno' },
    tone_analysis: cluster.sentiment.tone_analysis || { sensationalism: 0, objectivity: 0, emotional_charge: 0 }
} : null;

// --- Momentum Kicker Logic ---
const conflictsCount = verificationReport?.conflicts?.length || 0;
const totalSourcesCount = cluster?.articles?.length || 0;
const isBreakingFlag = cluster?.articles?.some((a: Article) => a.is_breaking) || false;

let momentumKicker = { label: 'REDAKCISKI UVID', color: 'text-muted-foreground' };
if (isBreakingFlag && totalSourcesCount >= 4) {
    momentumKicker = { label: 'UDAREN NARATIV', color: 'text-nyt-red' };
} else if (conflictsCount >= 3) {
    momentumKicker = { label: 'KONTRADIKTOREN razvoj', color: 'text-amber-600' };
} else if (totalSourcesCount >= 6) {
    momentumKicker = { label: 'SEOPFATEN INTERES', color: 'text-emerald-700 dark:text-emerald-500' };
} else if (totalSourcesCount >= 2 && !synthesisFreshness.is_stale) {
    momentumKicker = { label: 'KONSOLIDIRAN PREGLED', color: 'text-blue-700 dark:text-blue-500' };
}

// --- SEO & Schema ---
// Prefer a high-res representative image or the lead article visual for social sharing.
// Generated SVG is used only as a last resort fallback.
const socialImageUrl = cluster?.representative_image || (leadVisual && !leadVisual.isWeak ? leadVisual.rawUrl : imageUrl);

const articleSchema = cluster ? {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": displayHeadline,
	"description": cluster.generated_article?.slice(0, 200) || cluster.synthesis?.slice(0, 200) || displayHeadline,
	"image": cluster.representative_image || (leadVisual?.rawUrl?.startsWith('http') ? leadVisual.rawUrl : "https://presek.live/static/img/presek_emblem.png"),
	"datePublished": cluster.articles?.[cluster.articles.length - 1]?.created_at,
	"dateModified": cluster.synthesis_updated_at || cluster.articles?.[0]?.created_at,
	"author": {
		"@type": "Organization",
		"name": "PRESEK.rs",
		"url": "https://presek.live"
	},
	"publisher": {
		"@type": "Organization",
		"name": "PRESEK.rs",
		"logo": {
			"@type": "ImageObject",
			"url": "https://presek.live/static/img/presek_emblem.png"
		}
	}
} : null;
---

<Layout 
	title={displayHeadline} 
	description={cluster?.generated_article?.slice(0, 160) || cluster?.synthesis?.slice(0, 160) || shareDescription}
	image={socialImageUrl}
	type="article"
	canonical={canonicalUrl}
	schema={articleSchema || undefined}
>
	<NYTHeader topic={cluster?.topics?.[0]} />

	<ReaderTracker 
        clusterId={id || ''} 
        title={displayHeadline}
        category={cluster?.articles?.[0]?.category}
        topic={cluster?.topics?.[0]}
        primarySource={cluster?.articles?.[0]?.source}
        sources={allSourcesNames}
        tags={cluster?.tags}
        client:idle 
    />

	<main class="site-layout py-[var(--page-py)]">
		<Breadcrumbs items={[
			{ label: cluster?.articles?.[0]?.category || 'vesti', href: cluster?.articles?.[0]?.category ? `/?category=${cluster.articles[0].category}` : '/' },
			{ label: adjacentTopic || 'Detali' }
		]} />

		{error ? (
			<div class="py-20 text-center">
				<h1 class="text-2xl font-serif mb-4">{error}</h1>
				<a href="/" class="text-nyt-accent hover:underline">Nazad na pocetna</a>
			</div>
		) : cluster && (
			<article class="cluster-article-container">
				{/* 1. THE LEDE */}
				<ClusterHeader 
					momentumKicker={momentumKicker}
					category={cluster.articles?.[0].category || 'vesti'}
					createdAt={cluster.articles?.[0].created_at}
					displayHeadline={displayHeadline}
					headlineIsCyrillic={headlineIsCyrillic}
					syntheticStandfirst={cluster.synthetic_standfirst || undefined}
					canonicalUrl={canonicalUrl}
					topics={cluster.topics || []}
					getRelativeTimeStr={getRelativeTimeStr}
				/>

				{/* 2. HERO GRID (Visual) */}
				<div class="hero-full mb-16">
					<HeroVisual 
						leadVisual={leadVisual}
						dominantColor={cluster.dominant_color || undefined}
						displayHeadline={displayHeadline}
						id={id || ''}
						category={cluster.articles?.[0].category || ''}
						sourcePreview={sourcePreview}
						articlesCount={cluster.articles?.length || 0}
					/>
				</div>
<div class="editorial-grid">
	{/* 3. MAIN COLUMN */}
	<div class="editorial-main-col">
{/* EXECUTIVE SUMMARY / BRIFING - Hidden when we have a full narrative centerpiece */}
		{(!hasGeneratedNarrative && (headerBriefItems.length > 0 || (cluster.key_facts && cluster.key_facts.length > 0))) && (
<div class="executive-summary mb-12 p-8 bg-secondary/15 border-l-4 border-nyt-accent">
...
                                <div class="flex items-center gap-2 mb-6">
                                    <Sparkles size={14} className="text-nyt-accent" />
                                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-nyt-accent">KRATOK PREGLED</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div>
                                        <h4 class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-4">KLUCNI POENTI</h4>
                                        <ul class="space-y-3">
                                            {headerBriefItems.map(item => (
                                                <li class="font-serif text-base md:text-lg leading-snug italic text-foreground/90 relative pl-5">
                                                    <span class="absolute left-0 top-2.5 w-1 h-1 rounded-full bg-nyt-accent/60"></span>
                                                    {item}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                    {cluster.key_facts && cluster.key_facts.length > 0 && (
                                        <div class="border-t md:border-t-0 md:border-l border-border/40 pt-6 md:pt-0 md:pl-8">
                                            <h4 class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-4">SISTEMSKI PODATOCI</h4>
                                            <ul class="space-y-3">
                                                {cluster.key_facts.map((fact: string) => (
                                                    <li class="font-sans text-[13px] font-bold leading-tight text-foreground/80 flex items-start gap-2">
                                                        <span class="text-nyt-accent">›</span>
                                                        {fact}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    )}
                                </div>
                            </div>
						)}

						{/* NARRATIVE SECTION */}
						{(hasGeneratedNarrative || synthesisItems.length > 0) && (
						<section class="editorial-section narrative-section mb-16">
							<div class="section-eyebrow mb-8">
								<Newspaper size={16} className="text-muted-foreground" />
								<h2 class="section-label">{primaryNarrativeLabel}</h2>
								<div class="section-divider"></div>
							</div>

							<EditorialNarrative 
								hasStrongLeadNarrative={hasStrongLeadNarrative}
								generatedArticle={generatedArticle}
								synthesisItems={synthesisItems}
								hasCitationSources={hasCitationSources}
							/>

                            {/* DATA RECAP / KEY POINTS (Moved to bottom of narrative) */}
                            {hasGeneratedNarrative && (headerBriefItems.length > 0 || (cluster.key_facts && cluster.key_facts.length > 0)) && (
                                <div class="narrative-recap mt-12 p-8 bg-secondary/10 border-t border-border/40">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                        {headerBriefItems.length > 0 && (
                                            <div>
                                                <h4 class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-4">KLUCNI POENTI</h4>
                                                <ul class="space-y-2">
                                                    {headerBriefItems.map(item => (
                                                        <li class="font-sans text-[13px] leading-snug text-foreground/80 flex items-start gap-2">
                                                            <span class="text-nyt-accent">•</span>
                                                            {item}
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        )}
                                        {cluster.key_facts && cluster.key_facts.length > 0 && (
                                            <div class="border-t md:border-t-0 md:border-l border-border/40 pt-6 md:pt-0 md:pl-8">
                                                <h4 class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-4">SISTEMSKI PODATOCI</h4>
                                                <ul class="space-y-2">
                                                    {cluster.key_facts.map((fact: string) => (
                                                        <li class="font-sans text-[12px] font-bold leading-tight text-foreground/70 flex items-start gap-2">
                                                            <span class="text-nyt-accent">›</span>
                                                            {fact}
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            )}

						</section>
						)}

						{/* ANALYSIS SECTION: Fact Check & Comparison */}
						{(hasFactcheck || perspectives.length > 0) && (
							<CredibilityAnalysis 
								hasFactcheck={hasFactcheck}
								verificationReport={verificationReport}
								perspectives={perspectives}
								hasCitationSources={hasCitationSources}
							/>
						)}

						{/* ALL SOURCES LIST */}
						<section class="editorial-section sources-section mb-16 border-t border-border/40 pt-12">
							<div class="section-eyebrow mb-8">
								<Newspaper size={18} className="text-muted-foreground" />
								<h2 class="section-label">IZVORNA DOKUMENTACIJA</h2>
								<div class="section-divider"></div>
							</div>

							<div class="editorial-article-list editorial-timeline">
								<div class="timeline-v-line"></div>
								{articleRows.map((a: any) => (
									<ArticleItem article={a} />
								))}
							</div>
						</section>

						{/* RELATED SECTION */}
						{filteredRelated.length > 0 && (
							<section class="editorial-section related-section mb-16 border-t border-border/40 pt-12">
								<div class="section-eyebrow mb-10">
									<Zap size={18} className="text-nyt-red" />
									<h2 class="section-label">POVRZANI SODRZINI</h2>
									<div class="section-divider"></div>
								</div>
								<div class="related-editorial-grid">
									{filteredRelated.map((rel: any) => {
                                        const relSlug = slugify(rel.title);
                                        const relUrl = `/cluster/${rel.cluster_id}-${relSlug}`;
                                        return (
                                            <a href={relUrl} class="related-editorial-card group">
                                                {rel.image_url && (
                                                    <div class="card-thumb">
                                                        <img src={`/proxy?url=${encodeURIComponent(rel.image_url)}&w=480`} alt="" loading="lazy" />
                                                    </div>
                                                )}
                                                <div class="card-body">
                                                    <span class="card-kicker">{rel.relationship_label || 'Srodna tema'}</span>
                                                    <h3 class="card-title">{deShout(cleanAndDecode(rel.title))}</h3>
                                                </div>
                                                </a>
                                                );
                                                })}
                                                </div>
                                                </section>
                                                )}

                                                {/* ADVANCED ANALYTICS */}
                                                    <section class="editorial-section advanced-tools mb-12 md:mb-16 bg-secondary/5 p-4 md:p-10 border-y border-border/40">							<div class="section-eyebrow mb-8 md:mb-10">
                                                <Radio size={18} className="text-muted-foreground" />
                                                <h2 class="section-label">DLABINSKA SINTEZA</h2>
                                                <div class="section-divider"></div>
                                                </div>
                                                <div class="space-y-12">
                                                <ResearchIsland client:visible clusterId={id || ''} initialHeadline={displayHeadline || ''} sources={allSourcesNames} />
                                                <StorylineHistoryIsland client:visible clusterId={id || ''} apiUrl={API_URL} />
                                                <ClusterHistoryIsland client:visible clusterId={id || ''} />
                                                </div>
                                                </section>

					</div>

					{/* 4. SIDEBAR COLUMN */}
					<aside class="editorial-sidebar-col">
						<div class="sticky-sidebar space-y-12">
                            {/* NEW: Data Anchors in Sidebar */}
                            {sentimentData && (
                                <div class="sidebar-module">
                                    <h4 class="sidebar-label">MEDIUMSKI PULS</h4>
                                    <div class="mt-4">
                                        <MediaPulseRadar data={sentimentData} client:visible />
                                    </div>
                                </div>
                            )}

                            <div class="sidebar-module">
                                <h4 class="sidebar-label">SPEKTAR NA izvori</h4>
                                <div class="mt-6">
                                    <SourceSpectrum articles={cluster.articles.map((a: Article) => ({ source: a.source })) as any} client:visible />
                                </div>
                            </div>

                            {allSourcesNames.length >= 2 && (
                                <div class="sidebar-module">
                                    <SourceComparisonIsland allSources={allSourcesNames} client:visible />
                                </div>
                            )}

							<NewsletterIsland client:visible />

							<ClusterFollowSuggestionsIsland 
								topic={cluster.topics?.[0] || ''} 
								source={cluster.articles?.[0]?.source || ''}
								adjacentTopic={adjacentTopic}
								client:visible 
							/>

							{cluster.pluralism_score != null && (
								<div class="sidebar-module p-6 bg-emerald-50/50 dark:bg-emerald-950/10 border border-emerald-200/50 rounded-sm">
									<h4 class="sidebar-label !border-emerald-500 !text-emerald-700 dark:!text-emerald-400">MEDIUMSKI PLURALIZAM</h4>
									<div class="mt-4">
										<div class="flex items-center justify-between mb-2">
											<span class="text-[10px] font-black uppercase">Raznovidnost</span>
											<span class="text-xs font-black">{cluster.pluralism_score}%</span>
										</div>
										<div class="h-1.5 w-full bg-emerald-200 dark:bg-emerald-900 rounded-full overflow-hidden">
											<div class="h-full bg-emerald-500" style={`width: ${cluster.pluralism_score}%`}></div>
										</div>
										{cluster.narrative_diversity?.verdict && (
											<p class="mt-3 text-[11px] font-medium leading-relaxed text-emerald-800 dark:text-emerald-300 italic">
												“{cluster.narrative_diversity.verdict}”
											</p>
										)}
									</div>
								</div>
							)}

							{cluster.analyst_entities && cluster.analyst_entities.length > 0 && (
								<div class="sidebar-module">
									<h4 class="sidebar-label">KLUCNI SUBJEKTI</h4>
									<div class="flex flex-col gap-3 mt-4">
											{cluster.analyst_entities.map((name: string) => (
											<EntityContextCard name={name} client:visible />
										))}
									</div>
								</div>
							)}
						</div>
					</aside>
				</div>
			</article>
		)}
	</main>

	<Footer />
</Layout>

<style>
	.cluster-article-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem;
        width: 100%;
        box-sizing: border-box;
	}

    @media (max-width: 640px) {
        .cluster-article-container {
            padding: 0 0.75rem;
        }
    }

	/* --- 1. THE LEDE --- */
	.editorial-lede {
		text-align: center;
		padding: 2rem 0.5rem 3.5rem;
	}

	.editorial-headline {
		font-family: var(--font-serif);
		font-size: clamp(1.75rem, 6.5vw, 4.2rem);
		font-weight: 950;
		line-height: 1.0;
		letter-spacing: -0.04em;
		color: var(--foreground);
		text-wrap: balance;
		max-width: 1000px;
		margin: 0 auto;
        word-wrap: break-word;
        overflow-wrap: break-word;
	}

	.editorial-headline.is-cyrillic {
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.editorial-standfirst {
		margin-left: auto;
		margin-right: auto;
