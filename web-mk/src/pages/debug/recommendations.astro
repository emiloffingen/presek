---
import Layout from '../../layouts/Layout.astro';
import NYTHeader from '../../components/NYTHeader.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRecommendationEvaluation } from '../../lib/recommendationEval.mjs';

const debugToken = String(import.meta.env.DEBUG_PAGE_TOKEN || '').trim();
const requestToken =
  Astro.request.headers.get('x-debug-token') ||
  '';
const isAuthorized = Boolean(debugToken) && requestToken === debugToken;

if (!isAuthorized) {
  Astro.response.status = 404;
}

let evaluation = null;
let error = '';

try {
  if (isAuthorized) {
  evaluation = await getRecommendationEvaluation();
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Не успеа вчитувањето на евалуацијата.';
}
---

<Layout title="Debug Recommendations" robots="noindex, nofollow">
  <NYTHeader />

  <main class="site-layout debug-shell">
    <Breadcrumbs items={[{ label: "Internal Debug" }, { label: "Recommendations" }]} />
    {!isAuthorized ? (
      <section class="debug-panel debug-error">
        <span class="page-kicker">Internal Debug</span>
        <h1 class="debug-title">Страницата не е јавно достапна</h1>
        <p class="debug-copy">Овој екран е ограничен на интерна употреба и бара валиден debug токен во барањето.</p>
      </section>
    ) : error ? (
      <section class="debug-panel debug-error">
        <span class="page-kicker">Internal Debug</span>
        <h1 class="debug-title">Грешка при евалуација</h1>
        <p class="debug-copy">{error}</p>
      </section>
    ) : evaluation && (
      <>
        <header class="debug-header">
          <span class="page-kicker">Internal Debug</span>
          <h1 class="debug-title">Евалуација на препораки</h1>
          <p class="debug-copy">
            Интерен преглед на пример-профили, активни препораки и рангирање врз основа на моменталните локални податоци.
          </p>
        </header>

        <section class="debug-summary-grid">
          <article class="debug-panel">
            <span class="debug-label">API</span>
            <strong>{evaluation.api_url}</strong>
          </article>
          <article class="debug-panel">
            <span class="debug-label">Clusters</span>
            <strong>{evaluation.cluster_count}</strong>
          </article>
          <article class="debug-panel">
            <span class="debug-label">Profiles</span>
            <strong>{evaluation.results.length}</strong>
          </article>
        </section>

        <aside class="debug-callout debug-panel">
          <h2 class="debug-section-title">Како да се чита</h2>
          <p class="debug-copy">
            Ова е работен преглед како различни профили добиваат персонализирани кластери и кои сигнали стигнуваат до home rail, for you и topic логиката.
          </p>
        </aside>

        <section class="debug-results">
          {evaluation.results.map((entry) => (
            <article class="debug-panel profile-panel">
              <div class="profile-head">
                <h2>{entry.profile}</h2>
                <span>{entry.personalized.length} персонализирани кластери</span>
              </div>

              <div class="debug-grid">
                <section>
                  <h3>Персонализирано</h3>
                  {entry.personalized.length > 0 ? (
                    <ul class="debug-list">
                      {entry.personalized.map((item) => (
                        <li>
                          <strong>{item.title}</strong>
                          <span>{item.reason}</span>
                          <code>{item.score}</code>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="debug-empty">Нема препораки.</p>
                  )}
                </section>

                <section>
                  <h3>Home Rail</h3>
                  <pre>{JSON.stringify(entry.home_rail, null, 2)}</pre>
                </section>

                <section>
                  <h3>For You</h3>
                  <pre>{JSON.stringify(entry.for_you, null, 2)}</pre>
                </section>

                <section>
                  <h3>Topic</h3>
                  <pre>{JSON.stringify(entry.topic, null, 2)}</pre>
                </section>
              </div>
            </article>
          ))}
        </section>
      </>
    )}
  </main>

  <Footer />
</Layout>

<style>
... [KEEP ORIGINAL STYLES]
</style>
