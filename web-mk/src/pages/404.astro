---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

Astro.response.status = 404;
---

<Layout title="404 — Страницата не е пронајдена" robots="noindex, nofollow">
	<NYTHeader />
	<main class="site-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: "Страницата не е пронајдена" }]} />

		<section class="not-found-shell">
			<div class="not-found-main">
				<span class="page-kicker">404</span>
				<h1 class="not-found-headline">Страницата не е пронајдена</h1>
				<p class="not-found-intro">
					Линкот што го отворивте не постои, е преместен или повеќе не е достапен. Најчесто ова се случува кога кластерот е стар, адресата е нецелосна или линкот е копиран погрешно.
				</p>

				<div class="not-found-actions">
					<a href="/" class="not-found-link not-found-link-primary">Почетна</a>
					<a href="/archive" class="not-found-link">Архива</a>
					<a href="/briefing" class="not-found-link">Брифинг</a>
				</div>
			</div>

			<aside class="not-found-rail">
				<div class="rail-card rail-card-accent">
					<h2 class="rail-card-title">Каде да одите</h2>
					<p class="rail-copy">
						Ако баравте конкретна вест или кластер, најдобро е да почнете од архивата. Ако само сакате брз преглед на денот, вратете се на почетната или отворете го брифингот.
					</p>
				</div>

				<div class="rail-card">
					<h2 class="rail-card-title">Брзи патеки</h2>
					<div class="not-found-list">
						<a href="/archive">Прелистај ден по ден</a>
						<a href="/izvori">Погледни ги изворите</a>
						<a href="/pulse">Спореди медиуми</a>
						<a href="/contact">Пријави скршен линк</a>
					</div>
				</div>
			</aside>
		</section>
	</main>
	<Footer />
</Layout>

<style>
... [KEEP ORIGINAL STYLES]
</style>
