---
import Layout from '../layouts/Layout.astro';
import NYTHeader from '../components/NYTHeader.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

Astro.response.status = 404;
---

<Layout title="404 — Stranicata ne e pronajdena" robots="noindex, nofollow">
	<NYTHeader />
	<main class="site-layout py-[var(--page-py)]">
		<Breadcrumbs items={[{ label: "Stranicata ne e pronajdena" }]} />

		<section class="not-found-shell">
			<div class="not-found-main">
				<span class="page-kicker">404</span>
				<h1 class="not-found-headline">Stranicata ne e pronajdena</h1>
				<p class="not-found-intro">
					Linkot sto ga otvorivte ne postoi, e premesten ili povece ne e dostapen. Najcesto ova se slucuva koga klasterot e star, adresata e necelosna ili linkot e kopiran pogresno.
				</p>

				<div class="not-found-actions">
					<a href="/" class="not-found-link not-found-link-primary">Pocetna</a>
					<a href="/archive" class="not-found-link">Arhiva</a>
					<a href="/briefing" class="not-found-link">Brifing</a>
				</div>
			</div>

			<aside class="not-found-rail">
				<div class="rail-card rail-card-accent">
					<h2 class="rail-card-title">Kade Da Odite</h2>
					<p class="rail-copy">
						Ako baravte konkretna vest ili klaster, najdobro e da pocnete od arhivata. Ako samo sakate brz pregled na denot, vratete se na pocetnata ili otvorete ga brifingot.
					</p>
				</div>

				<div class="rail-card">
					<h2 class="rail-card-title">Brzi Pateki</h2>
					<div class="not-found-list">
						<a href="/archive">Prelistaj den po den</a>
						<a href="/izvori">Pogledni im izvorite</a>
						<a href="/pulse">Sporedi mediumi</a>
						<a href="/contact">Prijavi skrsen link</a>
					</div>
				</div>
			</aside>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.not-found-shell {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		max-width: 76rem;
		margin: 0 auto;
	}

	.not-found-main,
	.rail-card {
		padding: 1.6rem;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--background) 88%, var(--secondary) 12%);
	}

	.not-found-headline {
		margin: 0 0 1rem;
		font-size: clamp(2.4rem, 1.9rem + 2vw, 4.8rem);
		line-height: 0.94;
	}

	.not-found-intro {
		max-width: 44rem;
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--secondary-foreground);
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.not-found-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1rem;
		border: 1px solid var(--foreground);
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--foreground);
	}

	.not-found-link:hover {
		background: var(--foreground);
		color: var(--background);
	}

	.not-found-link-primary {
		background: var(--foreground);
		color: var(--background);
	}

	.not-found-link-primary:hover {
		opacity: 0.9;
	}

	.not-found-rail {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.rail-card-title {
		margin: 0 0 0.85rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.rail-copy {
		margin: 0;
		font-family: var(--font-nyt-body);
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--secondary-foreground);
	}

	.not-found-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.not-found-list a {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--foreground);
	}

	.not-found-list a:hover {
		color: var(--nyt-accent);
	}

	.rail-card-accent {
		background: color-mix(in srgb, var(--nyt-accent) 10%, var(--background) 90%);
	}

	@media (min-width: 1024px) {
		.not-found-shell {
			grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.9fr);
			align-items: start;
		}

		.not-found-rail {
			position: sticky;
			top: calc(var(--header-height) + 1.5rem);
		}
	}

	@media (max-width: 640px) {
		.not-found-main,
		.rail-card {
			padding: 1.15rem;
		}

		.not-found-headline {
			font-size: clamp(2rem, 1.6rem + 5vw, 3rem);
		}

		.not-found-intro {
			font-size: 0.98rem;
		}

		.not-found-actions {
			gap: 0.55rem;
		}

		.not-found-link {
			width: 100%;
		}
	}
</style>
