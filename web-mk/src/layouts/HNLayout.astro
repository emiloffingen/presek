---
import Layout from './Layout.astro';
import type { NewsCluster } from '@/types';

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    type?: string;
    schema?: object;
    robots?: string;
    trending?: any[];
    focusEntities?: any[];
    stats?: any;
    globalClusters?: NewsCluster[];
}

const props = Astro.props;
---

<Layout 
    title={props.title}
    description={props.description}
    image={props.image}
    canonical={props.canonical}
    type={props.type}
    schema={props.schema}
    robots={props.robots}
>
    <div class="hn-layout">
        <header class="hn-header">
            <a href="/hn/" class="hn-logo">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--hn-background)" style="margin-right: 4px;">
                    <path d="M0 0v24h24V0H0zm12.8 14.4v5.2h-1.6v-5.2L7.6 7.6h1.8l2.6 5 2.6-5h1.8l-3.6 6.8z"/>
                </svg>
                Пресек.мк
            </a>
            <nav class="hn-nav">
                <a href="/hn/" class="hn-nav-link">home</a>
                <span class="hn-nav-separator">|</span>
                <a href="/hn/new" class="hn-nav-link">new</a>
                <span class="hn-nav-separator">|</span>
                <a href="/hn/popular" class="hn-nav-link">popular</a>
                <span class="hn-nav-separator">|</span>
                <a href="/hn/ask" class="hn-nav-link">ask</a>
                <span class="hn-nav-separator">|</span>
                <a href="/hn/show" class="hn-nav-link">show</a>
                <span class="hn-nav-separator">|</span>
                <a href="/hn/jobs" class="hn-nav-link">jobs</a>
            </nav>
            <span class="hn-user">
                <a href="/hn/login">login</a>
            </span>
        </header>
        
        <div class="hn-main">
            <slot />
        </div>
        
        <footer class="hn-footer">
            <p>
                <a href="/hn/about">About</a> | 
                <a href="/hn/help">Help</a> | 
                <a href="/hn/faq">FAQ</a> | 
                <a href="/hn/rules">Rules</a> | 
                <a href="/hn/privacy">Privacy</a> | 
                <a href="/hn/contact">Contact</a>
            </p>
            <p style="margin-top: 10px;">
                Пресек.мк - Македонски Хакер News Стил Агрегатор
            </p>
        </footer>
    </div>
</Layout>

<style is:global>
    /* Ensure HN theme overrides are applied */
    .hn-layout {
        background: var(--hn-background);
        color: var(--hn-foreground);
        min-height: 100vh;
    }
</style>
