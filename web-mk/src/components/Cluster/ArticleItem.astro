---
import { Link2, ShieldCheck, TriangleAlert } from 'lucide-react';
import { sanitizeHtml } from '../../lib/sanitize';

interface Props {
	article: any;
}

const { article: a } = Astro.props;
---

<div class={`article-editorial-row tone-${a.relationship.tone} timeline-item`} data-article-link={encodeURIComponent(a.link || '')}>
	<div class="timeline-dot"></div>
    <div class="row-header">
		<div class="row-source-info">
			<span class="source-name">{a.source}</span>
			<span class={`tone-badge tone-${a.relationship.tone}`}>{a.relationship.label}</span>
			
            {a.quality.isObjective && (
                <span class="quality-badge badge-obj" title="Visok stepen na fakticko izvestuvanje">
                    <ShieldCheck size={10} />
                </span>
            )}
		</div>
		<div class="row-time">
			<span class="exact">{a.exactTime}</span>
			<span class="relative">{a.relativeTime}</span>
		</div>
	</div>
	<a href={a.link} target="_blank" rel="noopener noreferrer" class="row-title-link">
		<h3 class="row-title" set:html={sanitizeHtml(a.title)}></h3>
	</a>
	<p class="row-snippet" set:html={sanitizeHtml(a.description)}></p>
	<div class="row-footer">
		<a href={a.link} target="_blank" rel="noopener noreferrer" class="read-original">
			Originalna objava <Link2 size={12} />
		</a>
	</div>
</div>

<style>
	.article-editorial-row {
		padding: 1.5rem 0 1.5rem 3rem;
		border-bottom: 1px solid var(--border);
		transition: background-color 0.2s ease;
        position: relative;
	}

    .timeline-dot {
        position: absolute;
        left: 0.45rem;
        top: 2rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--border);
        border: 2px solid var(--background);
        z-index: 1;
    }

    .article-editorial-row.tone-latest .timeline-dot { background: #10b981; }
    .article-editorial-row.tone-origin .timeline-dot { background: var(--nyt-accent); }
    .article-editorial-row.tone-deep .timeline-dot { background: #6366f1; }

	.article-editorial-row:last-child {
		border-bottom: none;
	}

	.row-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.75rem;
	}

	.row-source-info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
        flex-wrap: wrap;
	}

	.source-name {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tone-badge {
		font-family: var(--font-sans);
		font-size: 0.55rem;
		font-weight: 900;
		padding: 1px 6px;
		border-radius: 2px;
		text-transform: uppercase;
	}

    .tone-badge.tone-latest { background: #dcfce7; color: #166534; }
	.tone-badge.tone-origin { background: #f1f5f9; color: #475569; }
    .tone-badge.tone-deep { background: #e0e7ff; color: #3730a3; }
    .tone-badge.tone-neutral { background: #f8fafc; color: #64748b; }

    /* Quality Badges */
    .quality-badge {
        font-family: var(--font-sans);
        font-size: 0.5rem;
        font-weight: 950;
        display: flex;
        align-items: center;
        gap: 3px;
        padding: 1px 5px;
        border-radius: 2px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .badge-obj { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-sens { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

	.row-time {
		display: flex;
		gap: 0.5rem;
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 800;
		color: var(--muted-foreground);
	}

	.row-title-link {
		text-decoration: none;
		color: inherit;
		display: block;
		margin-bottom: 0.5rem;
	}

	.row-title {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--foreground);
	}

	.row-title-link:hover .row-title {
		color: var(--nyt-accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.row-snippet {
		font-family: var(--font-nyt-body);
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--secondary-foreground);
		margin-bottom: 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row-footer {
		display: flex;
		justify-content: flex-end;
	}

	.read-original {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 950;
		color: var(--nyt-accent);
		text-transform: uppercase;
		text-decoration: none;
	}

	.read-original:hover {
		text-decoration: underline;
	}
</style>
