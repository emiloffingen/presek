---
import { Zap, Activity, Users, MapPin } from 'lucide-react';
import NewsletterIsland from '../NewsletterIsland.tsx';

interface Props {
	stats: any;
	health: any;
	leadCluster: any;
	briefing?: any;
	historicalDates?: any[];
}

const { stats, health, leadCluster, briefing, historicalDates = [] } = Astro.props;

function getTimeStr(dateStr: string) {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffMins = Math.floor(diffMs / (1000 * 60));
        const diffHours = Math.floor(diffMins / 60);

        if (diffMins < 1) return 'JUST NOW';
        if (diffMins < 60) return `PRE ${diffMins} MIN`;
        if (diffHours < 24) return `PRE ${diffHours} ČASA`;
        
        return date.toLocaleDateString('sr-RS', { day: 'numeric', month: 'short' }).toUpperCase();
    } catch {
        return '';
    }
}
---

<aside class="briefing-sidebar">
	<section class="sidebar-module p-6 bg-secondary/30 border border-border rounded-sm mb-6">
			<NewsletterIsland client:visible />
		</section>

		{historicalDates.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
					<Activity size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">PRETHODNA IZDANJA</h4>
				</div>
				<div class="flex flex-col gap-2">
					{historicalDates.map((d: any) => (
						<a 
							href={`/briefing?date=${d.day}`} 
							class={`text-xs font-bold hover:text-nyt-accent transition-colors block py-1 ${briefing?.date === d.day ? 'text-nyt-accent' : 'text-muted-foreground'}`}
						>
							● {new Date(d.day).toLocaleDateString('mk-RS', { day: 'numeric', month: 'short' })}
						</a>
					))}
				</div>
			</section>
		)}

		{stats?.intelligence?.pluralism && (
			<section class="sidebar-module">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
					<Activity size={14} className="text-emerald-600" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">SISTEMSKA RAVNOTEŽA</h4>
				</div>
				<div class="space-y-6">
					<div>
						<div class="flex justify-between text-[10px] font-bold uppercase mb-2">
							<span>Medijski pluralizam</span>
							<span>{stats.intelligence.pluralism.pluralism_pct}%</span>
						</div>
						<div class="h-1 bg-secondary rounded-full overflow-hidden">
							<div class="h-full bg-emerald-500" style={`width: ${stats.intelligence.pluralism.pluralism_pct}%`}></div>
						</div>
					</div>
					<div>
						<div class="flex justify-between text-[10px] font-bold uppercase mb-2">
							<span>Visok konsenzus</span>
							<span>{stats.intelligence.pluralism.high_consensus_pct}%</span>
						</div>
						<div class="h-1 bg-secondary rounded-full overflow-hidden">
							<div class="h-full bg-blue-500" style={`width: ${stats.intelligence.pluralism.high_consensus_pct}%`}></div>
						</div>
					</div>
				</div>
			</section>
		)}

		{briefing?.subjects?.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
					<Users size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">KLJUČNI AKTERI danas</h4>
				</div>
				<div class="flex flex-col gap-3">
					{briefing.subjects.map((subject: any) => (
						<div class="flex justify-between items-center text-sm font-serif">
							<span>{subject.name}</span>
							<span class="text-xs font-sans font-black text-muted-foreground">+{subject.total_mentions}</span>
						</div>
					))}
				</div>
			</section>
		)}

		{briefing?.locations?.length > 0 && (
			<section class="sidebar-module">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
					<MapPin size={14} className="text-foreground" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">FOKUS LOKACIJE</h4>
				</div>
				<div class="flex flex-wrap gap-2">
					{briefing.locations.map((loc: any) => (
						<span class="px-2 py-1 bg-secondary text-secondary-foreground text-xs font-sans font-bold uppercase tracking-wider">
							{loc.name} <span class="opacity-50 ml-1">{loc.total_mentions}</span>
						</span>
					))}
				</div>
			</section>
		)}

		{leadCluster && (
			<section class="sidebar-module">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
					<Zap size={14} className="text-nyt-accent" />
					<h4 class="text-[10px] font-black uppercase tracking-widest">AKTUELNO SAD</h4>
				</div>
				<a href={`/cluster/${leadCluster.cluster_id}`} class="group block">
					<p class="font-serif font-bold text-sm leading-snug group-hover:text-nyt-accent transition-colors">
						{leadCluster.articles?.[0]?.title}
					</p>
					<span class="block mt-2 text-[9px] font-black uppercase text-muted-foreground">
						{leadCluster.articles?.[0]?.source} · {getTimeStr(leadCluster.articles?.[0]?.created_at || leadCluster.articles?.[0]?.ingested_at)}
					</span>
				</a>
			</section>
		)}
	</div>
</aside>

<style>
    .briefing-sidebar { display: flex; flex-direction: column; gap: 2rem; }
    .sidebar-module { border-top: 1px solid var(--border); padding-top: 1.5rem; }
    .sidebar-module:first-child { border-top: none; padding-top: 0; }
</style>
