---
import type { NewsCluster } from '@/types';

interface Props {
    cluster: NewsCluster;
    index: number;
}

const { cluster, index } = Astro.props;

const article = cluster.articles?.[0] || {};
const sourceCount = cluster.articles?.length || 1;
const timeStr = cluster.published_at || article.published_at || '';

function formatTime(dateStr: string) {
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
        const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        if (diffHours < 1) return 'now';
        if (diffHours < 24) return `${diffHours} hours ago`;
        if (diffDays < 7) return `${diffDays} days ago`;
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    } catch {
        return '';
    }
}

function getDomain(url: string): string {
    try {
        const domain = new URL(url).hostname;
        return domain.replace(/^www\./, '');
    } catch {
        return article.source || 'пресек.мк';
    }
}

function getScore(): number {
    return sourceCount * 10;
}

function getCommentCount(): number {
    return Math.floor(sourceCount * 2.5);
}

// Get flair based on cluster properties
function getFlair(cluster: NewsCluster): string | null {
    if (cluster.is_breaking) return 'BREAKING';
    if (sourceCount >= 10) return 'MEGA';
    if (sourceCount >= 5) return 'POPULAR';
    return null;
}

const domain = getDomain(article.url || '');
const score = getScore();
const commentCount = getCommentCount();
const timeAgo = formatTime(timeStr);
const flair = getFlair(cluster);
const displayTitle = article.title || cluster.title || 'No title';
---

<tr class="hn-post">
    <td class="hn-rank">{index + 1}.</td>
    <td class="hn-vote">
        <a href="#" class="hn-vote-arrow" aria-label="upvote">▲</a>
    </td>
    <td class="hn-title-col">
        <div class="hn-title">
            <a href={`/hn/cluster/${cluster.cluster_id}`}>{displayTitle}</a>
            {flair && <span class="hn-flair">[{flair}]</span>}
        </div>
        <div class="hn-meta">
            <span class="hn-score">{score} points</span> by 
            <a href="#">ПРЕСЕК_БОТ</a> 
            <span>{timeAgo}</span> | 
            <a href="#">hide</a> | 
            <a href={`/hn/cluster/${cluster.cluster_id}`}>{commentCount} comments</a>
        </div>
    </td>
</tr>

<script is:inline>
    // Simple vote functionality
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('.hn-vote-arrow').forEach(arrow => {
            arrow.addEventListener('click', (e) => {
                e.preventDefault();
                const row = e.target.closest('.hn-post');
                if (!row) return;
                
                const scoreEl = row.querySelector('.hn-score');
                if (!scoreEl) return;
                
                let currentScore = parseInt(scoreEl.textContent?.replace(/\D/g, '') || '0');
                currentScore += 1;
                scoreEl.textContent = `${currentScore} points`;
                
                // Change arrow color to orange after voting
                e.target.style.color = 'var(--hn-orange)';
            });
        });
    });
</script>

<style>
    .hn-vote-arrow {
        color: var(--hn-secondary);
        text-decoration: none;
        font-size: 10px;
        cursor: pointer;
    }
    
    .hn-vote-arrow:hover {
        color: var(--hn-orange);
    }
    
    .hn-flair {
        font-size: 10px;
        color: var(--hn-orange);
        font-weight: bold;
        margin-left: 4px;
    }
</style>
