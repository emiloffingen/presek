---
import { sanitizeHtml } from '../../lib/sanitize';
import { getDisplayTitle, highlightScores, getDesignCardContext } from '../../utils/textUtils';
import type { NewsCluster } from '../../types';
import { Zap, Palette, Building2, TrendingUp, Award, Cpu, Newspaper, ArrowRight } from 'lucide-react';

interface Props {
    leadCluster: NewsCluster;
    leadTitle: string;
    leadTitleIsCyrillic: boolean;
    leadSignal: string;
    leadSummary: string;
    leadSummaryIsCyrillic: boolean;
    leadVisual: any;
    dominantColor?: string | null;
    getTimeStr: (date: string) => string;
    filtered?: boolean;
    filterLabel?: string | null;
}

const { 
    leadCluster, 
    leadTitle, 
    leadTitleIsCyrillic, 
    leadSignal, 
    leadSummary, 
    leadSummaryIsCyrillic, 
    leadVisual,
    dominantColor,
    getTimeStr,
    filtered = false,
    filterLabel = null
} = Astro.props;

const tintColor = dominantColor || '#1e40af';
const primaryArticle = leadCluster.articles?.[0] || {};
const primaryDisplayTitle = getDisplayTitle(primaryArticle, 'Водечка приказна');
const relatedArticles = leadCluster.articles.slice(1, 4);
const mediaLabel = filterLabel || primaryArticle.topic || primaryArticle.category || 'Водечка тема';

const cardContext = getDesignCardContext(leadCluster);
const IconComponent = 
    cardContext.icon === 'palette' ? Palette :
    cardContext.icon === 'building-2' ? Building2 :
    cardContext.icon === 'trending-up' ? TrendingUp :
    cardContext.icon === 'award' ? Award :
    cardContext.icon === 'cpu' ? Cpu :
    Newspaper;
---

<section class:list={["lead-hero motion-rise", { "lead-hero-filtered": filtered }]}>
    <div class="lead-hero-tint" style={`--tint-color: ${tintColor};`}></div>
    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-mobile" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        alt={primaryDisplayTitle || leadTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        transition:name={`cluster-image-${leadCluster.cluster_id}`}
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.opacity='0'; this.parentElement.querySelector('.lead-media-placeholder-error').style.display='grid';"
                    />
                    <div class="lead-media-overlay">
                        <div class="overlay-content">
                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(leadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} class="text-white/10" />
                        </div>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder design-card" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="design-card-pattern"></div>
                    <div class="design-card-ribbon">
                        <span>{cardContext.label}</span>
                    </div>
                    
                    <div class="design-card-main">
                        <div class="design-card-icon-wrap">
                            <IconComponent size={48} strokeWidth={1.2} class="text-white/90" />
                        </div>
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{leadTitle}</h2>
                        <p class="design-card-sub">{cardContext.sub}</p>
                    </div>

                    <div class="design-card-footer">
                        <span class="design-card-cta">ОДИ ДО СТАТИЈАТА <ArrowRight size={14} class="ml-1" /></span>
                    </div>
                </div>
            )}
        </div>
    </a>
    <div class="lead-copy">
        <div class="lead-edition-bar">
            <span class="lead-edition-label">ВОДЕЧКИ НАРАТИВ</span>
            <span class="lead-edition-note">Консензус помеѓу {leadCluster.articles.length} {leadCluster.articles.length === 1 ? 'редакција' : 'редакции'}</span>
        </div>
        <div class="lead-kicker-v2 mb-4">
            <span class="source-badge">{leadCluster.articles?.[0].source}</span>
            <div class="flex items-center gap-2">
                {leadCluster.is_breaking && <span class="significance-badge is-breaking">УДАРНА</span>}
                {leadSignal && (
                    <span class="lead-status-badge">
                        <span class="status-dot"></span>
                        <span>{leadSignal.toUpperCase()}</span>
                    </span>
                )}
                <span class="time-stamp-v2">{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
            </div>
        </div>
        <a href={`/cluster/${leadCluster.cluster_id}`} class="no-underline">
            <h1 class:list={["headline headline-lead", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(leadTitle)}></h1>
        </a>
        {leadSummary && (
            <p class:list={["lead-summary", { "lead-summary-cyrillic": leadSummaryIsCyrillic }]} set:html={sanitizeHtml(leadSummary)}></p>
        )}

        {leadCluster.key_facts && leadCluster.key_facts.length > 0 && (
            <div class="lead-analyst-box">
                <div class="analyst-header">
                    <div class="flex items-center gap-2">
                        <zap size={14} class="text-nyt-accent fill-nyt-accent/20" />
                        <span class="analyst-label">СИСТЕМСКИ УВИД</span>
                    </div>
                    <div class="flex items-center gap-3">
                        {leadCluster.pulse_score && (
                            <div class="pulse-indicator">
                                <span class="pulse-text">ПУЛС: {leadCluster.pulse_score}</span>
                                <div class="pulse-bar-bg">
                                    <div class="pulse-bar-fill" style={`width: ${leadCluster.pulse_score}%`}></div>
                                </div>
                            </div>
                        )}
                        {leadCluster.pluralism_score !== undefined && (
                            <div class="pluralism-indicator hidden sm:flex">
                                <span class="pulse-text">ПЛУРАЛИЗАМ: {leadCluster.pluralism_score}</span>
                                <div class="pulse-bar-bg">
                                    <div class="pulse-bar-fill bg-emerald-500" style={`width: ${leadCluster.pluralism_score}%`}></div>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
                <ul class="analyst-facts">
                    {leadCluster.key_facts.map((fact: string) => (
                        <li set:html={sanitizeHtml(fact)}></li>
                    ))}
                </ul>
            </div>
        )}
        <div class="lead-meta border-t border-border/50 pt-4 mt-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span>{getTimeStr(leadCluster.articles?.[0].ingested_at || leadCluster.articles?.[0].created_at)}</span>
                <span class="opacity-30">·</span>
                <span>{leadCluster.articles.length} {leadCluster.articles.length === 1 ? 'извор' : 'извори'}</span>
            </div>
            <a href={`/cluster/${leadCluster.cluster_id}`} class="text-[10px] font-black uppercase tracking-widest text-nyt-accent hover:underline">Целосна синтеза →</a>
        </div>

        {relatedArticles.length > 0 && (
            <div class="lead-follow-strip">
                <p class="lead-follow-kicker">КЛУЧНИ ПЕРСПЕКТИВИ</p>
                <ul class="lead-related">
                    {relatedArticles.map((article: any) => (
                        <li>
                            <a 
                                href={`/cluster/${leadCluster.cluster_id}`}
                                set:html={sanitizeHtml(highlightScores(getDisplayTitle(article)))}
                            >
                            </a>
                            <span class="text-[10px] font-bold text-muted-foreground uppercase opacity-60 ml-2 shrink-0">{article.source}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>

    <a href={`/cluster/${leadCluster.cluster_id}`} class="lead-media lead-media-desktop" aria-hidden="true" tabindex="-1">
        <div class:list={["lead-media-frame shadow-editorial", { "lead-media-frame-fallback": leadVisual?.isWeak }]}>
            {leadVisual?.proxiedUrl && !leadVisual.isWeak ? (
                <>
                    <img
                        src={leadVisual.proxiedUrl}
                        srcset={`${leadVisual.proxiedUrl.replace('w=1200', 'w=600')} 600w, ${leadVisual.proxiedUrl} 1200w`}
                        sizes="(max-width: 768px) 100vw, 1200px"
                        alt={primaryDisplayTitle}
                        width="1200"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="lead-media-image"
                        onload="this.classList.add('is-loaded')"
                        onerror="this.style.opacity='0'; this.parentElement.querySelector('.lead-media-placeholder-error').style.display='grid';"
                    />
                    <div class="lead-media-overlay">
                        <div class="overlay-content">
                            <h2 class:list={["overlay-headline", { "headline-cyrillic": leadTitleIsCyrillic }]} set:html={sanitizeHtml(leadTitle)}></h2>
                        </div>
                    </div>
                    <div class="lead-media-placeholder lead-media-placeholder-error design-card absolute inset-0" style="display: none; --placeholder-bg: #27272a;">
                        <div class="design-card-pattern opacity-5"></div>
                        <div class="design-card-main p-8 flex items-center justify-center h-full">
                            <Newspaper size={48} class="text-white/10" />
                        </div>
                    </div>
                </>
            ) : (
                <div class="lead-media-placeholder" style={`--placeholder-bg: ${tintColor};`}>
                    <div class="lead-media-placeholder-bg-text" set:html={sanitizeHtml(leadTitle)}></div>
                    <div class="lead-media-topline">
                        <p class="lead-media-kicker">ПРЕСЕК.мк Преглед</p>
                        <div class="lead-media-status">
                           {leadCluster.is_breaking && <Zap size={10} fill="currentColor" />}
                           <p class="lead-media-chip">{leadCluster.articles.length} {leadCluster.articles.length === 1 ? 'извор' : 'извори'}</p>
                        </div>
                    </div>
                    <div class="lead-media-content">
                        <h2 class:list={[{ "headline-cyrillic": leadTitleIsCyrillic }]}>{mediaLabel}</h2>
                        <p class="lead-media-fallback-source">{leadCluster.articles?.[0].source}</p>
                    </div>
                </div>
            )}
        </div>
    </a>
</section>

