---
interface Props {
	trending: any[];
}

const { trending } = Astro.props;
---

<div class="empty-state">
	<p class="empty-kicker">TIHO NA TRACI</p>
	<h2>Nema novih vesti za ovu temu.</h2>
	<p class="empty-copy">Pokušajte sa opštijim pojmom ili pretražite nešto aktuelno:</p>
	<div class="trend-links">
		{trending.slice(0, 8).map((t: any) => (
			<a href={`/?q=${encodeURIComponent(t.word)}`}>{t.word}</a>
		))}
	</div>
</div>

<style>
    .empty-state { text-align: center; padding: 4rem 1rem; border: 1px dashed var(--border); margin: 2rem 0; }
    .empty-kicker { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 900; color: var(--nyt-accent); margin-bottom: 1rem; }
    .empty-state h2 { font-family: var(--font-serif); font-size: 1.75rem; margin-bottom: 1rem; }
    .trend-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1.5rem; }
    .trend-links a { font-family: var(--font-serif); font-weight: 700; font-style: italic; font-size: 1.1rem; text-decoration: underline; color: var(--foreground); }
</style>
