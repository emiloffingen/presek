---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import SearchIsland from '../components/SearchIsland';
import ThemeIsland from '../components/ThemeIsland';
import { Search, Menu, Moon, Sun, Zap, TrendingUp, BarChart3 } from 'lucide-react';

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5001/api";

// Get search params for SSR filtering
const { searchParams } = Astro.url;
const category = searchParams.get('category');
const topic = searchParams.get('topic');
const q = searchParams.get('q');

let clusters = [];
let trending = [];
let topEntities = [];
let error = null;

// Build the fetch URL with params
const newsUrl = new URL(`${API_URL}/news`);
newsUrl.searchParams.set('page_size', '30');
if (category) newsUrl.searchParams.set('category', category);
if (topic) newsUrl.searchParams.set('topic', topic);
if (q) newsUrl.searchParams.set('q', q);

try {
    const [newsRes, trendRes, entityRes] = await Promise.all([
        fetch(newsUrl.toString()),
        fetch(`${API_URL}/trending`),
        fetch(`${API_URL}/intelligence/top-entities?limit=10`)
    ]);
    
    if (newsRes.ok) {
        const newsData = await newsRes.json();
        clusters = newsData.clusters || [];
    } else {
        throw new Error("News fetch failed");
    }
    
    trending = await trendRes.json();
    topEntities = await entityRes.json();
} catch (e) {
    console.error("Fetch error:", e);
    error = "Грешка при вчитување на вестите.";
}

const currentDate = new Date().toLocaleDateString('mk-MK', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});

// Category list as requested: makedonija balkan evropa svet vlada ekonomija
const navItems = [
    { label: "Македонија", params: { category: "Македонија" } },
    { label: "Балкан", params: { category: "Балкан" } },
    { label: "Европа", params: { category: "Европа" } },
    { label: "Свет", params: { category: "Свет" } },
    { label: "Влада", params: { q: "Влада" } },
    { label: "Економија", params: { topic: "Економија" } },
    { label: "Спорт", params: { topic: "Спорт" } },
    { label: "Технологија", params: { topic: "Технологија" } },
];
---

<Layout title={q || category || topic || "Главни Вести"}>
	<!-- Top Utility Bar (Zero JS) -->
	<div class="utility-bar border-b border-nyt py-2 bg-primary">
		<div class="site-layout flex items-center justify-between">
			<div class="flex flex-col">
				<span class="font-black text-[0.65rem] uppercase tracking-wider text-primary">{currentDate}</span>
				<span class="text-[0.6rem] text-muted uppercase tracking-wider">Скопје, Македонија</span>
			</div>
			
			<div class="hidden md:flex gap-6 items-center">
				<a href="/briefing" class="font-black text-[0.65rem] uppercase tracking-wider text-primary hover:text-accent transition">Дневен Брифинг</a>
				<a href="/stats" class="font-black text-[0.65rem] uppercase tracking-wider text-primary hover:text-accent transition">Статистика</a>
			</div>
		</div>
	</div>

	<!-- Site Header -->
	<header class="site-layout py-8 border-b-4 border-double border-nyt mb-8">
		<div class="text-center relative">
			<button class="md:hidden absolute left-0 top-1/2 -translate-y-1/2 p-2">
				<Menu size={20} />
			</button>
			
			<a href="/" class="inline-block group">
				<div class="flex items-center gap-3">
					<img src="/img/presek_emblem.svg" alt="Presek Emblem" class="h-10 md:h-12 group-hover:rotate-12 transition-transform duration-500" />
					<img src="/logo.svg" alt="Presek" class="h-10 md:h-12" />
				</div>
			</a>

			<div class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center gap-2">
				<SearchIsland client:load />
				<ThemeIsland client:load />
			</div>
		</div>

		<nav class="hidden md:block mt-6">
			<div class="flex justify-center border-y border-nyt py-3 gap-6 flex-wrap">
				{navItems.map(item => {
					const searchStr = new URLSearchParams(item.params).toString();
					const isActive = (category === item.params.category && item.params.category) || 
					                 (topic === item.params.topic && item.params.topic) ||
									 (q === item.params.q && item.params.q);
					
					return (
						<a href={`/?${searchStr}`} class={`text-[10px] font-black uppercase tracking-widest hover:text-accent transition no-underline ${isActive ? 'text-accent border-b-2 border-accent' : 'text-muted'}`}>
							{item.label}
						</a>
					);
				})}
			</div>
		</nav>

		<!-- Entities in Focus -->
		<div class="mt-6 flex flex-wrap justify-center items-center gap-4">
			<span class="text-[9px] font-black uppercase tracking-tighter text-muted">Личности во фокус:</span>
			{topEntities.map((ent: any) => (
				<a href={`/?q=${encodeURIComponent(ent.name)}`} class="text-[10px] font-bold text-primary hover:text-accent no-underline border-b border-color transition-colors">
					{ent.name}
				</a>
			))}
		</div>
	</header>

	<main class="site-layout">
		{q && (
			<div class="mb-10 flex items-center gap-4">
				<h2 class="text-2xl font-serif font-bold text-primary">Пребарување: <span class="italic text-accent">"{q}"</span></h2>
				<a href="/" class="text-[10px] font-black uppercase tracking-widest text-muted hover:text-primary">Исчисти филтер</a>
			</div>
		)}
		
		{(category || topic) && (
			<div class="mb-10 flex items-center gap-4">
				<h2 class="text-2xl font-serif font-bold text-primary">Категорија: <span class="text-accent">{category || topic}</span></h2>
				<a href="/" class="text-[10px] font-black uppercase tracking-widest text-muted hover:text-primary">Исчисти филтер</a>
			</div>
		)}

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
			<!-- Main Feed (9 cols) -->
			<div class="lg:col-span-9">
				{error && (
					<div class="bg-secondary p-8 text-center border-t-2 border-accent mb-8">
						<p class="text-accent font-bold uppercase tracking-widest">{error}</p>
					</div>
				)}

				{!error && clusters.length === 0 && (
					<div class="bg-secondary p-12 text-center border-t-2 border-nyt mb-8">
						<p class="text-muted font-bold uppercase tracking-widest">Нема пронајдени вести за ова пребарување.</p>
					</div>
				)}

				<div class="news-feed-grid">
					{clusters.map((cluster, idx) => (
						<NewsCard 
							cluster={cluster} 
							isLead={idx === 0 && !q && !category && !topic}
						/>
					))}
				</div>
			</div>

			<!-- Sidebar (3 cols) -->
			<aside class="lg:col-span-3 space-y-10">
				<section class="border-t-2 border-primary pt-4">
					<h3 class="rail-label flex items-center gap-2">
						<TrendingUp size={14} /> ПОПУЛАРНО
					</h3>
					<div class="flex flex-wrap gap-2">
						{trending.slice(0, 15).map(item => (
							<a href={`/?q=${item.word}`} class="pill-lite">
								{item.word} {item.trend === '↑' && "↑"}
							</a>
						))}
					</div>
				</section>

				<section class="border-t-2 border-primary pt-4">
					<h3 class="rail-label flex items-center gap-2">
						<BarChart3 size={14} /> МЕДИУМСКИ ПУЛС
					</h3>
					<div class="bg-secondary p-4 rounded-sm">
						<p class="text-[10px] font-bold text-muted uppercase mb-1">ПОСЛЕДНИ 24 ЧАСА</p>
						<p class="text-2xl font-serif font-bold text-primary">{clusters.length > 5 ? '180+' : '--'}</p>
						<p class="text-[10px] font-bold text-muted uppercase">ОБЈАВЕНИ СТАТИИ</p>
					</div>
				</section>
			</aside>
		</div>
	</main>

	<footer class="site-layout mt-20 py-10 border-t border-nyt text-center">
		<img src="/logo.svg" alt="Presek" class="h-10 opacity-30 mx-auto mb-4 grayscale" />
		<p class="text-[10px] font-bold text-muted uppercase tracking-widest">
			© 2026 ПРЕСЕК - ИНТЕЛИГЕНТНА АГРЕГАЦИЈА НА ВЕСТИ
		</p>
	</footer>
</Layout>

<style>
	.pill-lite {
		font-size: 0.65rem;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--text-secondary);
		background: var(--bg-secondary);
		padding: 0.25rem 0.6rem;
		border-radius: 2px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.pill-lite:hover {
		background: var(--accent-color);
		color: white;
	}
</style>
