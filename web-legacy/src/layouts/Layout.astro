---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Presek - Македонска агрегација на вести со ЈИ синтеза" } = Astro.props;
---

<!doctype html>
<html lang="mk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		
		<!-- Google Fonts: Lora (Headlines) + Inter (Reading & UI) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

		<title>{title} | Пресек</title>

		<script is:inline>
			// Immediate theme sync to prevent flicker
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-primary text-primary antialiased transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #ffffff;
		--bg-secondary: #f7f7f8;
		--text-primary: #0f1117;
		--text-secondary: #3d4151;
		--text-muted: #6b7185;
		--border-color: #e4e4e8;
		--accent-color: #cc1a1a;
		--accent-hover: #a81414;
		--nyt-font-serif: 'Lora', serif;
		--nyt-font-sans: 'Inter', sans-serif;
	}

	.dark {
		--bg-primary: #0f1117;
		--bg-secondary: #1a1d27;
		--text-primary: #f1f5f9;
		--text-secondary: #cbd5e1;
		--text-muted: #94a3b8;
		--border-color: #2a2d3a;
		--accent-color: #ff4d4d;
		--accent-hover: #e82323;
	}

	html {
		font-family: var(--nyt-font-sans);
		background: var(--bg-primary);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
	}

	h1, h2, h3, h4, h5, h6, .font-serif {
		font-family: var(--nyt-font-serif);
	}

	/* Common Utility Classes for the Broadsheet look */
	.site-layout {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	.rail-label {
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	.border-nyt {
		border-color: var(--border-color);
	}

	/* Tailwind-like utilities for Zero-JS layout stability */
	.flex { display: flex; }
	.flex-col { flex-direction: column; }
	.items-center { align-items: center; }
	.items-start { align-items: flex-start; }
	.justify-between { justify-content: space-between; }
	.justify-center { justify-content: center; }
	.flex-wrap { flex-wrap: wrap; }
	.gap-1 { gap: 0.25rem; }
	.gap-2 { gap: 0.5rem; }
	.gap-3 { gap: 0.75rem; }
	.gap-4 { gap: 1rem; }
	.gap-6 { gap: 1.5rem; }
	.gap-8 { gap: 2rem; }
	.gap-10 { gap: 2.5rem; }
	.gap-12 { gap: 3rem; }
	
	.grid { display: grid; }
	.grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
	
	.text-center { text-align: center; }
	.text-xs { font-size: 0.75rem; }
	.text-sm { font-size: 0.875rem; }
	.text-base { font-size: 1rem; }
	.text-lg { font-size: 1.125rem; }
	.text-xl { font-size: 1.25rem; }
	.text-2xl { font-size: 1.5rem; }
	.text-4xl { font-size: 2.25rem; }
	.text-6xl { font-size: 3.75rem; }
	
	.font-bold { font-weight: 700; }
	.font-black { font-weight: 900; }
	
	.uppercase { text-transform: uppercase; }
	.italic { font-style: italic; }
	.tracking-widest { letter-spacing: 0.1em; }
	.tracking-wider { letter-spacing: 0.05em; }
	.tracking-tight { letter-spacing: -0.025em; }
	.tracking-tighter { letter-spacing: -0.05em; }
	
	.py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
	.py-3 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
	.py-6 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
	.py-8 { padding-top: 2rem; padding-bottom: 2rem; }
	.py-10 { padding-top: 2.5rem; padding-bottom: 2.5rem; }
	.py-12 { padding-top: 3rem; padding-bottom: 3rem; }
	
	.px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
	.py-0\.5 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
	
	.mb-1 { margin-bottom: 0.25rem; }
	.mb-2 { margin-bottom: 0.5rem; }
	.mb-3 { margin-bottom: 0.75rem; }
	.mb-4 { margin-bottom: 1rem; }
	.mb-6 { margin-bottom: 1.5rem; }
	.mb-8 { margin-bottom: 2rem; }
	.mb-10 { margin-bottom: 2.5rem; }
	.mb-12 { margin-bottom: 3rem; }
	.mb-16 { margin-bottom: 4rem; }
	.mt-6 { margin-top: 1.5rem; }
	.mt-12 { margin-top: 3rem; }
	.mt-20 { margin-top: 5rem; }
	
	.mx-auto { margin-left: auto; margin-right: auto; }
	
	.w-full { width: 100%; }
	.max-w-4xl { max-width: 56rem; }
	
	.border { border-width: 1px; border-style: solid; border-color: var(--border-color); }
	.border-b { border-bottom-width: 1px; border-bottom-style: solid; border-color: var(--border-color); }
	.border-b-2 { border-bottom-width: 2px; border-bottom-style: solid; border-color: var(--border-color); }
	.border-b-4 { border-bottom-width: 4px; border-bottom-style: solid; border-color: var(--border-color); }
	.border-t { border-top-width: 1px; border-top-style: solid; border-color: var(--border-color); }
	.border-t-2 { border-top-width: 2px; border-top-style: solid; border-color: var(--border-color); }
	.border-l-4 { border-left-width: 4px; border-left-style: solid; border-color: var(--border-color); }
	.border-y { border-top-width: 1px; border-bottom-width: 1px; border-style: solid; border-color: var(--border-color); }
	.border-double { border-style: double; }
	
	.bg-primary { background-color: var(--bg-primary); }
	.bg-secondary { background-color: var(--bg-secondary); }
	.bg-accent { background-color: var(--accent-color); }
	
	.text-primary { color: var(--text-primary); }
	.text-secondary { color: var(--text-secondary); }
	.text-muted { color: var(--text-muted); }
	.text-accent { color: var(--accent-color); }
	.text-white { color: #ffffff; }
	
	.no-underline { text-decoration: none; }
	.antialiased { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
	.opacity-30 { opacity: 0.3; }
	.opacity-50 { opacity: 0.5; }
	.grayscale { filter: grayscale(100%); }
	
	.relative { position: relative; }
	.absolute { position: absolute; }
	.top-1/2 { top: 50%; }
	.left-0 { left: 0; }
	.right-0 { right: 0; }
	.left-1/2 { left: 50%; }
	.-translate-y-1/2 { transform: translateY(-50%); }
	.-translate-x-1/2 { transform: translateX(-50%); }

	.leading-relaxed { line-height: 1.625; }
	.leading-tight { line-height: 1.25; }
	.leading-snug { line-height: 1.375; }

	.pl-8 { padding-left: 2rem; }

	@media (min-width: 768px) {
		.md\:flex { display: flex; }
		.md\:block { display: block; }
		.md\:hidden { display: none; }
		.md\:h-20 { height: 5rem; }
		.md\:text-6xl { font-size: 3.75rem; }
		.md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (min-width: 1024px) {
		.lg\:grid { display: grid; }
		.lg\:grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
		.lg\:col-span-12 { grid-column: span 12 / span 12; }
		.lg\:col-span-9 { grid-column: span 9 / span 9; }
		.lg\:col-span-8 { grid-column: span 8 / span 8; }
		.lg\:col-span-4 { grid-column: span 4 / span 4; }
		.lg\:col-span-3 { grid-column: span 3 / span 3; }
	}

	/* News Grid */
	.news-feed-grid {
		display: grid;
		grid-template-cols: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.news-feed-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.news-feed-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.lead-story {
		grid-column: 1 / -1 !important;
	}

	@media (min-width: 1024px) {
		.lead-story.news-cluster {
			display: grid !important;
			grid-template-columns: repeat(12, 1fr) !important;
			gap: 2rem !important;
			align-items: start !important;
		}
		.lead-story .cluster-thumb-wrap {
			grid-column: span 8 !important;
		}
		.lead-story .cluster-main {
			grid-column: span 4 !important;
			height: 100% !important;
			display: flex !important;
			flex-direction: column !important;
		}
	}
</style>
